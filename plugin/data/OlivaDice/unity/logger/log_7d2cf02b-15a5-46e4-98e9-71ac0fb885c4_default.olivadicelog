{"time": 1766343692, "type": "recv", "message_id": "1080361534", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那种事情谁记得啊.jpg）"}
{"time": 1766343716, "type": "recv", "message_id": "1277891315", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“谢谢诺亚了...”接过晚餐"}
{"time": 1766343755, "type": "recv", "message_id": "1914365100", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1047582503]\"再见，伊斯特小姐。\"妃花也学着你说了句再见，对方稍微打量了一下，点点头，转身离开。等到对方走远，妃花才凑上来低声开口询问，\"诶?伊芙认识她吗？\""}
