{"time": 1766251803, "type": "recv", "message_id": "1418470460", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(是吧)"}
