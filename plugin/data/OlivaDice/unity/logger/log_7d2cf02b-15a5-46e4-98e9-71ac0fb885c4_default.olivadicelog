{"time": 1766279119, "type": "recv", "message_id": "1410806696", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（说起来艾莉西雅去哪了）"}
