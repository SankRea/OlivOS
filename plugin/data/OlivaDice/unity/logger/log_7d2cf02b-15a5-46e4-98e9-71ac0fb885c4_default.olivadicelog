{"time": 1766471256, "type": "recv", "message_id": "1571870426", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(呼得我接近5.才睡着)"}
