{"time": 1766631092, "type": "recv", "message_id": "398952832", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（草，初雪的霜能盖在流沙上）"}
{"time": 1766631094, "type": "recv", "message_id": "1681825711", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（无敌了）"}
