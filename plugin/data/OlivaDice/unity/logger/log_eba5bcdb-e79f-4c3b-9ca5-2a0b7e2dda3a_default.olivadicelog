{"time": 1772457118, "type": "recv", "message_id": "1892916992", "deleted": false, "dect": {"host_id": null, "group_id": "1090333911", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "走去厨房，确定窗外没有异样后，开窗探头"}
