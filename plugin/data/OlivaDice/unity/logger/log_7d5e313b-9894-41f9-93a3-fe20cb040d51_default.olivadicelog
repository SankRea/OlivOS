{"time": 1770202477, "type": "recv", "message_id": "1233316814", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*敲了敲门，示意我们进来了"}
