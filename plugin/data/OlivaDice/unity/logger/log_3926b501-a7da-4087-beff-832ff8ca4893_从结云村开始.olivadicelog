{"time": 1751200287, "type": "recv", "message_id": "625029273", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我想起来伊神开荒的时候要过幸运，还不能重复过）"}
