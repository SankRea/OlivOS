{"time": 1751355108, "type": "recv", "message_id": "502572325", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（还有行动风格）"}
