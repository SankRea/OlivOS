{"time": 1751133149, "type": "recv", "message_id": "579087543", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我冰鱼龙啊)"}
