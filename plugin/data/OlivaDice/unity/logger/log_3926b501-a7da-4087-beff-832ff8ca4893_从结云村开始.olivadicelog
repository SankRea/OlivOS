{"time": 1751534732, "type": "recv", "message_id": "866492637", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "随后红红的眼睛看向你们"}
{"time": 1751534758, "type": "recv", "message_id": "2043202921", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“你...要干嘛”"}
{"time": 1751534817, "type": "recv", "message_id": "1669783360", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "被这家伙逗笑了，收起笔记本，\"海吗？嗯....你的梦很重要，可以的话一定要全部跟我讲。\"手搭在剑上"}
{"time": 1751535007, "type": "recv", "message_id": "1637002505", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“现在吗..”"}
