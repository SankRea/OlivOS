{"time": 1751343855, "type": "recv", "message_id": "1045489409", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好漂亮...”眼睛发光"}
