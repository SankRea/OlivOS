{"time": 1751293857, "type": "recv", "message_id": "703104171", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“哦，醒了”"}
{"time": 1751293887, "type": "recv", "message_id": "1626518764", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "吞口口水，过了一会才平息，从夏弥背上跳下来，这时已经在山路上，\"嗯...\"抖抖身子恢复精神，\"该问的话还没问完。\""}
{"time": 1751293906, "type": "recv", "message_id": "827165753", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"你到底是谁?\"尽管声音有些抖，对着露儿质问"}
{"time": 1751293917, "type": "recv", "message_id": "1923959441", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1355389631]你发现自己连人带甲被人单手拎在手上，而拎你的这个少女看起来不论是年龄还是体型都和你差不了太多，背上更是还趴着一个"}
{"time": 1751294000, "type": "recv", "message_id": "749150242", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“有...吃的吗...”"}
{"time": 1751294108, "type": "recv", "message_id": "1817060328", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "秀眉皱起，\"你是饿死鬼吗？\""}
{"time": 1751294153, "type": "recv", "message_id": "994227536", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "不知道自己做错了什么，但看到恩人这样说话，低头不敢回复"}
{"time": 1751294168, "type": "recv", "message_id": "1913653829", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "从包里拿出几块饼干，\"...\"想起自己一天没吃饭的事，\"好烦，马上到村子里，待会带你去集会吃。\""}
{"time": 1751294183, "type": "recv", "message_id": "639041192", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"你先把我的问题回答了。\"递给她饼干"}
{"time": 1751294336, "type": "recv", "message_id": "1674041548", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我...不知道...恩人什么腻思，我就是5啊”#吃饼干，边吃边回答，有点口齿不清"}
{"time": 1751294421, "type": "recv", "message_id": "1405464257", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "看向夏弥，转头继续问\"那你刚刚有什么异常吗？\""}
{"time": 1751294449, "type": "recv", "message_id": "1133719361", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“没感觉到，就那一下而已”*夏弥摇头"}
{"time": 1751294499, "type": "recv", "message_id": "745441083", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "看着她吃饼干，自己还饿肚子，感觉一阵无语，\"你是不是惹了那只熊\""}
{"time": 1751294538, "type": "recv", "message_id": "1132858565", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯....但我有点后悔”"}
{"time": 1751294578, "type": "recv", "message_id": "190923248", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“它没招惹我，我不该去找它的...”"}
{"time": 1751294584, "type": "recv", "message_id": "27944085", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"....你对它做了什么?\""}
{"time": 1751294617, "type": "recv", "message_id": "970759154", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我有点记得不清了....我只记得，我一直在跑.....”"}
{"time": 1751294715, "type": "recv", "message_id": "49775180", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“然后回过神来，那只熊就死了....”随着肚子逐渐被填饱，脑子也开始思考了“那...到底是什么”有点后怕，看看自己的左手“我..还是我吗”"}
{"time": 1751294744, "type": "recv", "message_id": "1941643691", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"然后?\"挑了挑眉毛，\"我看见了能量束，是你做的?\"伸手抬起她的左手"}
{"time": 1751294789, "type": "recv", "message_id": "1542774238", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "光洁如新（？）但是手套的掌心处有一个拳头大小的破洞"}
{"time": 1751294800, "type": "recv", "message_id": "1927466466", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那不就是全破了（））"}
{"time": 1751294926, "type": "recv", "message_id": "1896858659", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我....我不知道....那力量真的是我的吗...感觉好危险，如果...如果失控了怎么办...”"}
{"time": 1751294973, "type": "recv", "message_id": "744244422", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...闻所未闻..\""}
{"time": 1751294983, "type": "recv", "message_id": "1299773903", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"唉，你家里人知道吗？\""}
{"time": 1751295026, "type": "recv", "message_id": "1558607735", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“父亲从来没跟我说过这种事情....”"}
{"time": 1751295159, "type": "recv", "message_id": "2075164801", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...你害怕吗？\""}
{"time": 1751295197, "type": "recv", "message_id": "788043586", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯....万一，伤害到别人....”"}
{"time": 1751295216, "type": "recv", "message_id": "1247024493", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“算了，要不你们还是不要把我带回村子里了...”"}
{"time": 1751295349, "type": "recv", "message_id": "2065259863", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没什么。\"摸摸头"}
{"time": 1751295353, "type": "recv", "message_id": "1134940688", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(你多size)"}
{"time": 1751295414, "type": "recv", "message_id": "2064541983", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（40）"}
{"time": 1751295561, "type": "recv", "message_id": "237997851", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"你不是饿了吗？不想去集会所吃饭?\""}
{"time": 1751295697, "type": "recv", "message_id": "340725146", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“但是..万一”"}
{"time": 1751295703, "type": "recv", "message_id": "1882406013", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那力量失控了..”"}
