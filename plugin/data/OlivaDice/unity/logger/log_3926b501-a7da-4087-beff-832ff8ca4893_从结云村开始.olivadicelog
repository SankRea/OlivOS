{"time": 1751390237, "type": "recv", "message_id": "1184712686", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1552983747]（稍微等我想想）"}
