{"time": 1751388426, "type": "recv", "message_id": "1106370152", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我的话也说完了”他点点头，似乎是打算休息了"}
{"time": 1751388443, "type": "recv", "message_id": "222916522", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那晚安，您早些休息吧”"}
