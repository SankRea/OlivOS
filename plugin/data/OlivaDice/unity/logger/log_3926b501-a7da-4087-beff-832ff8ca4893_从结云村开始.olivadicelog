{"time": 1751554182, "type": "recv", "message_id": "1439805194", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=209451281]（我不知道怎么回（）"}
{"time": 1751554186, "type": "recv", "message_id": "237717378", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“走吧，saki”"}
