{"time": 1751375899, "type": "recv", "message_id": "1671328890", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（回复药是最不值钱的东西（）"}
