{"time": 1751299835, "type": "recv", "message_id": "1260619384", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(呃，我的意思是能做多少装备)"}
{"time": 1751299885, "type": "recv", "message_id": "307798537", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“...其实还好啦，就是战斗的时候，有些攻击没闪开，那位姐姐帮我躲开了”"}
{"time": 1751299898, "type": "recv", "message_id": "935292133", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（加点钱补点通用素材，有两套防具+一把武器的程度？）"}
