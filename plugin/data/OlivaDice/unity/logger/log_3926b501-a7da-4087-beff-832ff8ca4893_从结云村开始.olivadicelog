{"time": 1751513136, "type": "recv", "message_id": "908749941", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯，走吧，下来往哪去”"}
{"time": 1751513283, "type": "recv", "message_id": "1498980870", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"接着往东吧。\"起身伸个懒腰，\"做好准备哦，这种任务很枯燥的。\""}
