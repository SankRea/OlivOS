{"time": 1751288462, "type": "recv", "message_id": "1431684434", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（地狱燃烧射线）"}
