{"time": 1751265956, "type": "recv", "message_id": "1848866821", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1276297108]（过，难度8）"}
{"time": 1751265961, "type": "recv", "message_id": "1291959196", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(说起来零玉有什么用)"}
