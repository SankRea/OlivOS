{"time": 1753552522, "type": "recv", "message_id": "852418228", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "借着灯光，你注意到，镜子里的你脖子上没有御守"}
{"time": 1753552547, "type": "recv", "message_id": "821228848", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "突然，镜子里的你笑了，并且朝你伸出手。"}
{"time": 1753552564, "type": "recv", "message_id": "1659152489", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "一把抓住了你的手腕。"}
{"time": 1753552599, "type": "recv", "message_id": "822327449", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“该你进来坐坐了。”"}
{"time": 1753552617, "type": "recv", "message_id": "941333793", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "镜子里的你竟然…说话了。"}
{"time": 1753552645, "type": "recv", "message_id": "567522688", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "惊讶了一瞬，反应过来之后连连往后退，手上的盐整碗撒向它，声音有些抖，\"你..是谁?\""}
{"time": 1753552689, "type": "recv", "message_id": "776780781", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“我就是你啊。”"}
{"time": 1753552716, "type": "recv", "message_id": "409982013", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "随后，镜子里的你消失了。"}
{"time": 1753552740, "type": "recv", "message_id": "425716564", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"你不是...\"惊魂未定，仔细打量镜子"}
{"time": 1753552787, "type": "recv", "message_id": "1305482555", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "镜子映照出的，只有你身后的墙壁。"}
{"time": 1753552838, "type": "recv", "message_id": "1674786140", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我...我呢？\"后退几步，扬起手"}
{"time": 1753552858, "type": "recv", "message_id": "723811646", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "镜子映照的场景并无任何变化。"}
{"time": 1753552882, "type": "recv", "message_id": "531174119", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "低头看刚刚被抓住的手腕"}
{"time": 1753552886, "type": "recv", "message_id": "1121603569", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "但是你发现，你身上的御守似乎散发出淡淡微光。"}
{"time": 1753552896, "type": "recv", "message_id": "1985167018", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "这是你母亲给你的御守。"}
{"time": 1753552944, "type": "recv", "message_id": "1894529567", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...在发光...妈妈知道了吗？\"小心翼翼地准备退出阳台，回房间里"}
{"time": 1753552973, "type": "recv", "message_id": "753241047", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（话说你怎么不打电话试试）"}
