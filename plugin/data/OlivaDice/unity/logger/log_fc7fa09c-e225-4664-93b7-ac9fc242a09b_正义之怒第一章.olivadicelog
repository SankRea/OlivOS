{"time": 1763306189, "type": "recv", "message_id": "1785771747", "deleted": false, "dect": {"host_id": null, "group_id": "261292323", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "对真菌"}
