{"time": 1763306069, "type": "recv", "message_id": "866764445", "deleted": false, "dect": {"host_id": null, "group_id": "261292323", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "*过个潜行"}
