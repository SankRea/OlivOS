{"time": 1763306060, "type": "recv", "message_id": "736962344", "deleted": false, "dect": {"host_id": null, "group_id": "261292323", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“我们的动作需要非常轻，非常轻”"}
