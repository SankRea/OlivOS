{"time": 1773152201, "type": "recv", "message_id": "1044382772", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“要去支援吗”"}
{"time": 1773152212, "type": "recv", "message_id": "1763906350", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=255363183]（虽然我想说我不知道，但是也许确实该有个指挥）"}
