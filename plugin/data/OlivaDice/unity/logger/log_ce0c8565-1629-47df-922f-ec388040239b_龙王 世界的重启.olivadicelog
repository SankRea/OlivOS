{"time": 1772620196, "type": "recv", "message_id": "1642215508", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "#总之，继续深入洞穴吧"}
{"time": 1772620235, "type": "recv", "message_id": "839587926", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "你们在靠右手边的一处石台上，确实找到一个不算开阔的洞口。山洞里安静得很，不过一片漆黑，而且传出阵阵阴风"}
{"time": 1772620345, "type": "recv", "message_id": "1778652215", "deleted": true, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "#旋了旋腰间灯虫的盖子"}
