{"time": 1772468931, "type": "recv", "message_id": "1663125626", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“没啥事”"}
{"time": 1772468937, "type": "recv", "message_id": "355093177", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“就是想你了，来看看。”"}
{"time": 1772468946, "type": "recv", "message_id": "295133550", "deleted": true, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "#抱住她"}
