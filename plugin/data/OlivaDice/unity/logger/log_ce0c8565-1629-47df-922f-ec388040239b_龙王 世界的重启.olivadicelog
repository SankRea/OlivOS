{"time": 1772468628, "type": "recv", "message_id": "1536872570", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "何意味"}
