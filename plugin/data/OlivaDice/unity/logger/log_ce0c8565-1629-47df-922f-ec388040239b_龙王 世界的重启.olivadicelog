{"time": 1772464589, "type": "recv", "message_id": "1011608181", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "#交了任务之后咨询教官"}
{"time": 1772464612, "type": "recv", "message_id": "1015493240", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“师傅，我今天碰见一条痹毒龙”"}
{"time": 1772464618, "type": "recv", "message_id": "316684340", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“你会怎么对付?”"}
{"time": 1772464654, "type": "recv", "message_id": "307832431", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1011608181]任务报酬：800z"}
{"time": 1772464841, "type": "recv", "message_id": "1695627189", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=316684340]“痹毒龙？处理起来还挺麻烦的。”教官放下手里正在往车上搬的行李，顺便歇口气“解毒的药物自不必说，那家伙还灵活得很，尽量不要在有很多墙壁的地方和它战斗……和同伴一起战斗的话，只要挥洒汉方药粉尘，就能帮队友解除出血性毒素的影响了”"}
{"time": 1772464857, "type": "recv", "message_id": "1117186264", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“至于麻痹性的毒素……‘别被它咬到’”"}
{"time": 1772464896, "type": "recv", "message_id": "29057568", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“好，谢谢师傅指导”"}
{"time": 1772464942, "type": "recv", "message_id": "1147264523", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你不问问他为什么要搬行李吗.jpg）"}
{"time": 1772464945, "type": "recv", "message_id": "1629763357", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "【开阔地形，解毒药粉】"}
{"time": 1772464951, "type": "recv", "message_id": "581696674", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“咦，师傅”"}
