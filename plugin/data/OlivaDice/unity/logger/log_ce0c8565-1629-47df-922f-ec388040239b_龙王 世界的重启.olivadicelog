{"time": 1773112719, "type": "recv", "message_id": "998915597", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "正是那片湖景"}
{"time": 1773112864, "type": "recv", "message_id": "235979660", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "前往哨所的路上，塔莉娅和黑楼和几辆驮着怪物尸体的推车擦肩而过。凭借地利和工事的据守的确比主动出击简单不少，某种意义上村子还要感谢轰龙帮村子创收——如果它不会一时兴起创过来的话"}
{"time": 1773112889, "type": "recv", "message_id": "49497672", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "。rd+2 猛牛龙跑了多远.jpg"}
