{"time": 1772465161, "type": "recv", "message_id": "623708126", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "#皱起眉头"}
