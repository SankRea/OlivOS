{"time": 1773840793, "type": "recv", "message_id": "967227965", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“我没事，没事，我睡不着，她是我都挚友，我担心她”"}
