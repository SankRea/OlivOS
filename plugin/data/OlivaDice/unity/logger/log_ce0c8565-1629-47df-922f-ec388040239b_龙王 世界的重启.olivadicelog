{"time": 1773040664, "type": "recv", "message_id": "103449310", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“这算飞龙？”"}
