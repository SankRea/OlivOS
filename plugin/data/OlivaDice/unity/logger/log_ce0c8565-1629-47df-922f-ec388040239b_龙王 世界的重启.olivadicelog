{"time": 1772468764, "type": "recv", "message_id": "16384631", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(一想到我的猫比我有学问我就绷不住)"}
