{"time": 1755528124, "type": "recv", "message_id": "1916218974", "deleted": false, "dect": {"host_id": null, "group_id": "1029911714", "user_id": "970417396"}, "sender": {"id": "970417396", "name": "银翼"}, "message": "（）"}
{"time": 1755528134, "type": "recv", "message_id": "1667636136", "deleted": false, "dect": {"host_id": null, "group_id": "1029911714", "user_id": "970417396"}, "sender": {"id": "970417396", "name": "银翼"}, "message": "（怎么感觉像yln）"}
{"time": 1755528144, "type": "recv", "message_id": "49027469", "deleted": false, "dect": {"host_id": null, "group_id": "1029911714", "user_id": "2739405262"}, "sender": {"id": "2739405262", "name": "残阳亦旭•我爱艾蕾！"}, "message": "“哈，那就，互不干扰？”"}
{"time": 1755528291, "type": "recv", "message_id": "857642428", "deleted": false, "dect": {"host_id": null, "group_id": "1029911714", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“可以”"}
{"time": 1755528305, "type": "recv", "message_id": "859198345", "deleted": false, "dect": {"host_id": null, "group_id": "1029911714", "user_id": "970417396"}, "sender": {"id": "970417396", "name": "银翼"}, "message": "“能说说为什么会召唤失败？据我所知，历代被选中的人好像没出现过这种情况”"}
{"time": 1755528626, "type": "recv", "message_id": "690621018", "deleted": false, "dect": {"host_id": null, "group_id": "1029911714", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“呵，这谁知道呢。历史是由胜利者所书写的，我们所知道的未必是真实发生的事情”"}
{"time": 1755528632, "type": "recv", "message_id": "813773210", "deleted": false, "dect": {"host_id": null, "group_id": "1029911714", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“也许过去也有那么几个和我一样的倒霉蛋。毫无疑问，他们会在圣杯战争中被敌人轻易抹杀掉。而赢家为了展现自己的实力，也会选择隐瞒召唤失败的事情”"}
{"time": 1755528638, "type": "recv", "message_id": "1659746090", "deleted": false, "dect": {"host_id": null, "group_id": "1029911714", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“战胜强者的故事，不觉得比掐死一个倒霉蛋好听的多吗”"}
{"time": 1755528705, "type": "recv", "message_id": "1447634619", "deleted": false, "dect": {"host_id": null, "group_id": "1029911714", "user_id": "970417396"}, "sender": {"id": "970417396", "name": "银翼"}, "message": "（）"}
{"time": 1755528713, "type": "recv", "message_id": "214807613", "deleted": false, "dect": {"host_id": null, "group_id": "1029911714", "user_id": "970417396"}, "sender": {"id": "970417396", "name": "银翼"}, "message": "（这种不讲人话的）"}
{"time": 1755528717, "type": "recv", "message_id": "1461813756", "deleted": false, "dect": {"host_id": null, "group_id": "1029911714", "user_id": "970417396"}, "sender": {"id": "970417396", "name": "银翼"}, "message": "（真的好像yln）"}
{"time": 1755528771, "type": "recv", "message_id": "915022146", "deleted": false, "dect": {"host_id": null, "group_id": "1029911714", "user_id": "2739405262"}, "sender": {"id": "2739405262", "name": "残阳亦旭•我爱艾蕾！"}, "message": "“不管你到底是召唤失败还是令咒不在手臂上”"}
{"time": 1755528789, "type": "recv", "message_id": "1585498216", "deleted": false, "dect": {"host_id": null, "group_id": "1029911714", "user_id": "970417396"}, "sender": {"id": "970417396", "name": "银翼"}, "message": "“或许是吧，谁知道呢”*说完耸了耸肩"}
