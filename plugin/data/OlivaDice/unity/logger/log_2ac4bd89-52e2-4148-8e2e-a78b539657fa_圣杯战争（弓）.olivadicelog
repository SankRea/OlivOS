{"time": 1755528077, "type": "recv", "message_id": "316024538", "deleted": false, "dect": {"host_id": null, "group_id": "1029911714", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "（他好喜欢无妨）"}
