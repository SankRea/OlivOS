{"time": 1770820882, "type": "recv", "message_id": "1894218261", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(行"}
{"time": 1770820936, "type": "recv", "message_id": "493302506", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "往后的路途倒没什么意外，也许是神山露确实是王牌带着你们走也说不定？你们顺利下了山，回到了熟悉的街角，竟有了些恍若隔世的错觉"}
{"time": 1770820960, "type": "recv", "message_id": "2051681850", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=1894218261]（hh）"}
{"time": 1770820980, "type": "recv", "message_id": "1445251958", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“该吃晚饭了，再不去食堂都要关了”"}
{"time": 1770821005, "type": "recv", "message_id": "1172742288", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "天色已晚，食堂大概早就不剩什么了。"}
{"time": 1770821268, "type": "recv", "message_id": "775031324", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（给动作咯）"}
{"time": 1770821291, "type": "recv", "message_id": "489768532", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“唔，雨纪前辈是住校的吧？秋山学姐呢？”"}
{"time": 1770821315, "type": "recv", "message_id": "1917245320", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我家在学校附近..离得也不是很远”"}
{"time": 1770821405, "type": "recv", "message_id": "1412268201", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“要不我们一起去外面吃好了，对了学妹，你呢住校还是走读”"}
{"time": 1770821675, "type": "recv", "message_id": "1102622178", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我也住老街诶？离学校不怎么远。”她眨眨眼，“好啊，前辈的意见呢？”"}
{"time": 1770821762, "type": "recv", "message_id": "1521383152", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“反正离得不远……一起去也好”"}
{"time": 1770821862, "type": "recv", "message_id": "1142303901", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "身上钱应该还够，就当散散心了"}
