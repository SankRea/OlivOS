{"time": 1770865552, "type": "recv", "message_id": "1103984331", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "《偷偷》"}
{"time": 1770865602, "type": "recv", "message_id": "1460602140", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（虽然不知道你吃不吃得完）"}
{"time": 1770865630, "type": "recv", "message_id": "1669209445", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "自己不用回家，倒是吃得有条不紊。不过看向天宫的碗，总感觉浪费有点可惜"}
{"time": 1770865630, "type": "recv", "message_id": "1767416447", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "毕竟是碳水大餐，神山吃得肚子饱饱，吃完了吗?"}
{"time": 1770865646, "type": "recv", "message_id": "154611454", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（过什么吗（）"}
{"time": 1770865654, "type": "recv", "message_id": "1833095426", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（体质吧）"}
{"time": 1770865684, "type": "recv", "message_id": "197842114", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（既然你诚心诚意地发问了）"}
{"time": 1770865699, "type": "recv", "message_id": "443388789", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "轻轻松松，擦擦嘴"}
{"time": 1770865822, "type": "recv", "message_id": "1353515195", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“厉害”轻轻拍拍手，随后站起身准备结账“该走了，天都有点黑了”"}
{"time": 1770865974, "type": "recv", "message_id": "1134988019", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...”把自己的那一份付了“用我送你回去吗，雨纪酱”"}
{"time": 1770866117, "type": "recv", "message_id": "1203944391", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“回学校而已……”顿了顿“嗯……随便你咯，要是你愿意走两遍夜路的话”"}
{"time": 1770866332, "type": "recv", "message_id": "874078001", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（then？）"}
{"time": 1770866350, "type": "recv", "message_id": "1542664352", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那走吧，反正我家离得也不远”"}
{"time": 1770866459, "type": "recv", "message_id": "1273983660", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "那你送她到了学校门口。"}
{"time": 1770866471, "type": "recv", "message_id": "2045466930", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（wait）"}
{"time": 1770866483, "type": "recv", "message_id": "931578150", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（wait是）"}
{"time": 1770866492, "type": "recv", "message_id": "2014379066", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（寒暄两句就分到小群吧）"}
{"time": 1770866527, "type": "recv", "message_id": "2029864183", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "走在路上的时候，侧头询问“那个，神山同学。今天为什么突然搬到后面的空位去了？”"}
{"time": 1770866546, "type": "recv", "message_id": "622172062", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“来了新同学么，照顾一下她”"}
{"time": 1770866639, "type": "recv", "message_id": "197278639", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“喔”笑了笑“我还以为你是想离我远点呢”"}
{"time": 1770866694, "type": "recv", "message_id": "654111651", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“？我们可是好朋友啦”"}
{"time": 1770866866, "type": "recv", "message_id": "870476665", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“不过照顾新同学的事好像落到我身上了。嘛，在旁边也能稍微安心一点就是了。”沉默一会，借着开口“那个，我只是有点猜测哦，我就这么一说，你就这么一听”"}
{"time": 1770866901, "type": "recv", "message_id": "1486277429", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我在想，你今天在后山上踩到的东西，会不会是什么东西的蛋？”"}
{"time": 1770866919, "type": "recv", "message_id": "1950634523", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“蛋？什么...什么意思”"}
{"time": 1770866959, "type": "recv", "message_id": "2000524410", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（什么叫什么意思）"}
{"time": 1770866980, "type": "recv", "message_id": "664544729", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“字面意思啊……你看那个黄黄的不像蛋黄吗？”"}
{"time": 1770867037, "type": "recv", "message_id": "1577920930", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不会是蛇蛋吧....”"}
{"time": 1770867131, "type": "recv", "message_id": "215568956", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“还是什么别的..”想到奇怪的草有点不太敢想了，自己应该没冒犯神明吧..."}
{"time": 1770867163, "type": "recv", "message_id": "1603546659", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我不懂啦，也只是突发奇想。”摇摇头“想不通就不想了，当我没说过好了”"}
{"time": 1770867181, "type": "recv", "message_id": "1028795987", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（在东北你已经被柳仙拿下了）"}
{"time": 1770867236, "type": "recv", "message_id": "160076614", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（在东北你已经被柳仙拿下了）"}
{"time": 1770867259, "type": "recv", "message_id": "1857168893", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好过分..怎么感觉你在故意吓我”"}
{"time": 1770867367, "type": "recv", "message_id": "398095148", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“怎么这样，我还没说蛋以外的猜想呢，那种才吓人一点吧。”翻个白眼“最多就是鸟蛋蛇蛋，你又不住校，怕什么”"}
{"time": 1770867395, "type": "recv", "message_id": "334476383", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那种是...什么...算了，你别说了..”"}
{"time": 1770867406, "type": "recv", "message_id": "473316303", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "擦擦额头的汗“我走了，明天见”"}
{"time": 1770867446, "type": "recv", "message_id": "559399499", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“明天见啦。”摆摆手，进校门去了"}
{"time": 1770867451, "type": "recv", "message_id": "324137926", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "回家"}
{"time": 1770867601, "type": "recv", "message_id": "1624402947", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "那么你们二分别"}
{"time": 1770867614, "type": "recv", "message_id": "1189348615", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "天色已沉，要走一段夜路了。"}
{"time": 1770867617, "type": "recv", "message_id": "1261561177", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。log off"}
