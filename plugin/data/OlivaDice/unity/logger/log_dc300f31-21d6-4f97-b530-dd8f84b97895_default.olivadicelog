{"time": 1770863195, "type": "recv", "message_id": "272007560", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（翔哥忘了买纸了.jpg）"}
