{"time": 1770861794, "type": "recv", "message_id": "385447148", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（不是15交，16就年后了还好吧）"}
{"time": 1770861822, "type": "recv", "message_id": "835454316", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:image,file=6F4A58AE73EE3CBFBDCE2E7F121E65BC.png,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhQn0vnt4i5AiubKheEm5zyALVatrRj-8AIg_woot5rHru7SkgMyBHByb2RQgL2jAVoQUfc7UP1P0ZiLFldYFpVZxXoCFY-CAQJneg&amp;rkey=CAISMI_edc4PwbZxriDi9TXqb-jjQpb3GNehxV4qoKxh_dDUAKbm7qd1sLbz9oA4ax_qDw,file_size=47230]"}
{"time": 1770861888, "type": "recv", "message_id": "121432633", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "神弃川的老街不长，路面是被雨水泡得发暗的旧石板，缝隙里长着深绿色的苔藓，踩上去微凉、微滑。两旁的房子大多是几层的木造，深褐色的木板墙被岁月熏得发黑，窗框歪歪扭扭，玻璃蒙着一层永远擦不掉的白雾。"}
{"time": 1770861982, "type": "recv", "message_id": "411717742", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "虽然毗邻高中，但本就不算繁华，空气里飘着潮湿木头味、旧纸张味，还有一丝若有若无的、像墨水混着雨水的冷香。想来也不会有特别好的饭店，不过拉面这种碳水供应倒是生根发芽，也许得益于港口城市的原因。"}
{"time": 1770862027, "type": "recv", "message_id": "543878880", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“去吃拉面吧”看看哪家人多"}
{"time": 1770862191, "type": "recv", "message_id": "1450561845", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“拉面啊...”秋四处张望，“这个街上大部分我都吃过了，感觉没什么不同。”"}
{"time": 1770862209, "type": "recv", "message_id": "617180922", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那学妹来推荐吧，我跟着你”"}
{"time": 1770862246, "type": "recv", "message_id": "1064681017", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（aibo，拉面一库贼）"}
{"time": 1770862318, "type": "recv", "message_id": "1074358797", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“学姐不也住在这条街上吗？”她眨眨眼，“诶，一直都是我们说，前辈的意见呢？”"}
{"time": 1770862382, "type": "recv", "message_id": "2090212227", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“虽然我是住这里啦，不过吃食堂更多一些”也眨眨眼"}
{"time": 1770862398, "type": "recv", "message_id": "1454456419", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“拉面啊，加溏心蛋的话，我只能吃得下小份”晃了晃手指“不吃煮的鱼就行啦，其他的我都不挑”"}
{"time": 1770862545, "type": "recv", "message_id": "1356731047", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“这样...”她带着你们拐进街巷，最后停在一家钟表店——旁的千味拉面前，“那我，私心地推荐我家旁边这家，可以吧？”她伸手指了指店面，脸上挂上了些得逞的笑"}
{"time": 1770862564, "type": "recv", "message_id": "134113191", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（毫不意外）"}
{"time": 1770862609, "type": "recv", "message_id": "1511049415", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我没意见啊，学妹推荐，必属精品”"}
{"time": 1770862720, "type": "recv", "message_id": "409967572", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“天宫同学原来住在这附近么？”稍微留意一下街道，随后撩开门帘“那就来尝一尝吧”"}
{"time": 1770862856, "type": "recv", "message_id": "521677059", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“雨纪酱家住哪来着，下次放假我去找你玩吧”"}
{"time": 1770862956, "type": "recv", "message_id": "1360729859", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“在镇北，矿山那边”进门了找个空的方桌"}
