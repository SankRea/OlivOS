{"time": 1770864774, "type": "recv", "message_id": "1057114704", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（模组背景应该已经有犬夜叉了罢）"}
