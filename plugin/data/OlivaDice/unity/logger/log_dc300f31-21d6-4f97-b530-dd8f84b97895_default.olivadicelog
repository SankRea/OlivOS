{"time": 1770861652, "type": "recv", "message_id": "1218329751", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（我在想一件事，哦，我下午不开就好了）"}
