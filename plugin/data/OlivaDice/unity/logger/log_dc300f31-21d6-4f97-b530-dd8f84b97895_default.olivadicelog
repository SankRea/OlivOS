{"time": 1770801702, "type": "recv", "message_id": "904702621", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（怎么开了，我还在粥）"}
{"time": 1770801902, "type": "recv", "message_id": "344121237", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“咦！”抬起脚看一眼"}
{"time": 1770802002, "type": "recv", "message_id": "424839742", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*看一眼"}
{"time": 1770802076, "type": "recv", "message_id": "1267758197", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "神山脚底的草丛中布满了某种黏腻的黄色粘液，还有白色的角质，散发着一股油漆般的恶臭。"}
{"time": 1770802112, "type": "recv", "message_id": "1024997870", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“这什么啊，好恶心..”强忍着没有吐出来"}
{"time": 1770802147, "type": "recv", "message_id": "413660029", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“咦呃……”嫌弃地走开了点“毛毛虫？我听说有的有毒的毛毛虫会有臭味……”"}
{"time": 1770802198, "type": "recv", "message_id": "2124560209", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“雨纪酱，学妹你们有纸吗，借我用下”泪眼汪汪的看着二人"}
{"time": 1770802284, "type": "recv", "message_id": "1516192381", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（不是走在路上蹭蹭）"}
{"time": 1770802287, "type": "recv", "message_id": "651818620", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（就没了）"}
{"time": 1770802311, "type": "recv", "message_id": "2120277577", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（蹭蹭在擦擦（））"}
{"time": 1770802339, "type": "recv", "message_id": "1010144229", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（而且万一爆汁溅到裤腿上了就不好了）"}
{"time": 1770802370, "type": "recv", "message_id": "1571825241", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（？还有第二关）"}
{"time": 1770802423, "type": "recv", "message_id": "311139975", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我没带，教室里有”摇头"}
{"time": 1770802557, "type": "recv", "message_id": "1598553560", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶，我也没带啦。\"秋看了一眼连忙撇开眼睛，\"好恶心...\"她抱着手臂有些发抖"}
{"time": 1770802601, "type": "recv", "message_id": "382126925", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "有点难受...先在路边蹭蹭，然后看看裤腿上有没有沾上"}
{"time": 1770802613, "type": "recv", "message_id": "252641855", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*找根干净的树枝，拨开草丛看一眼"}
{"time": 1770802644, "type": "recv", "message_id": "143041092", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "里面似乎没什么东西的样子，当然是说活着的东西。"}
{"time": 1770802823, "type": "recv", "message_id": "937482650", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“你……想想办法吧，找个树皮凑合”"}
{"time": 1770802825, "type": "recv", "message_id": "268454045", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“什么的”"}
{"time": 1770803198, "type": "recv", "message_id": "582659577", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...”心有不甘的点点头“好恶心...”"}
{"time": 1770803738, "type": "recv", "message_id": "1609706036", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"还要上去吗...\"秋看了看天色，\"先发生了这样的事，现在又...\""}
{"time": 1770803754, "type": "recv", "message_id": "1943854083", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（hyw）"}
{"time": 1770803785, "type": "recv", "message_id": "186735369", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“上去吧..现在回去了，我不是白踩了”擦擦眼角的一点点泪"}
{"time": 1770803876, "type": "recv", "message_id": "2114998164", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯……虽然不是我踩到的，但是一只虫子而已……祈福不能这么半途而废吧”"}
{"time": 1770804190, "type": "recv", "message_id": "213271222", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"可是已经到这个时间了诶...\"秋说着，暮色已经晕染了半个天空"}
{"time": 1770804750, "type": "recv", "message_id": "1446175872", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯..那要不学妹先回去？”"}
{"time": 1770804810, "type": "recv", "message_id": "980793748", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...不一起回去吗？明天再来吧...\""}
{"time": 1770805278, "type": "recv", "message_id": "1073368142", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯……你要是怕了的话，可以自己回去的”"}
{"time": 1770805286, "type": "recv", "message_id": "1995746206", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“明天放学，也差不多是这个时候吧”"}
{"time": 1770805805, "type": "recv", "message_id": "2099792271", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（吃饭）"}
{"time": 1770805810, "type": "recv", "message_id": "296030478", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我...我才不怕。\"尽管她这么说，不过语气有点抖，\"既然要去...就一起去。\""}
{"time": 1770806907, "type": "recv", "message_id": "324721511", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“emmm...”伸出手“要不学妹抱着我”"}
{"time": 1770807000, "type": "recv", "message_id": "894719245", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶?\"秋抬起头打量了你一下，\"那我就不客气咯？\"她走近一步，\"怎么抱?\""}
{"time": 1770807038, "type": "recv", "message_id": "2077630656", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“就抱着我的胳膊吧...遇到危险我会保护你的”另一只手拍拍自己的胸膛"}
{"time": 1770807203, "type": "recv", "message_id": "580644879", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶?要是再踩到什么东西怎么办?\""}
{"time": 1770807245, "type": "recv", "message_id": "1031045330", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“......虫子...虫子其实还好啦...踩死就. 踩死了..”有点不利索"}
{"time": 1770807250, "type": "recv", "message_id": "1205301397", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“哪有那么多怪东西能踩啦”摇头“走吧走吧，快去快回”"}
{"time": 1770807499, "type": "recv", "message_id": "323473156", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\""}
{"time": 1770807533, "type": "recv", "message_id": "626787963", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "说着你们继续往上，翻过一个小山头，看见了一个掉色的鸟居，上面绑着生锈的铃铛"}
{"time": 1770807584, "type": "recv", "message_id": "223546224", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“听说鸟居后面就是神居住的地方了”整理一下衣服，双手合十拍拍“打扰了”"}
{"time": 1770807626, "type": "recv", "message_id": "335080796", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "有样学样“打扰了..”微微弯腰"}
{"time": 1770807921, "type": "recv", "message_id": "1084015502", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "当然无人回应，只有风声扇动的铃铛寂寞地摇晃，但不知是生锈了还是怎么样，只有些许不怎么清脆的铃声"}
{"time": 1770807937, "type": "recv", "message_id": "1580017445", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*进！"}
{"time": 1770807944, "type": "recv", "message_id": "1858400025", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "*进！"}
{"time": 1770808264, "type": "recv", "message_id": "1847373648", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "鸟居后面的上路似乎被好好维护过，至少没有在杂草丛生，一条小小的黄土路直通更高的位置。"}
{"time": 1770808321, "type": "recv", "message_id": "228531437", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（理发了"}
{"time": 1770808352, "type": "recv", "message_id": "122575690", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "而没有走多久，你们就看见了第二个鸟居，这个鸟居表面开裂开来，看上去摇摇欲坠，但不知为何，上面的牌匾却是新漆的朱红色"}
{"time": 1770808414, "type": "recv", "message_id": "1377648492", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“看起来还是有人在打理的嘛”抬头看一眼，很快又低头看路"}
{"time": 1770808558, "type": "recv", "message_id": "658219067", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "可以侦查"}
