{"time": 1770861698, "type": "recv", "message_id": "956538542", "deleted": false, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（还没，年后吧）"}
