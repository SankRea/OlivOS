{"time": 1770809883, "type": "recv", "message_id": "286140429", "deleted": true, "dect": {"host_id": null, "group_id": "1044159263", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:image,file=A6134E5CA6C437505BF6C49F87A8C22F.png,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhTvd09uOZq3UUwRKgYDpFkgZzmLTRiVTCD_CijUr4LwrNGSAzIEcHJvZFCAvaMBWhCIyZgdUYQu6Gu4kqvVB1YMegJ6CYIBAmd6&amp;rkey=CAISMMaNTUlkWgyoMSZJYGLmABC1L9xZz3f90JzDWSa0tPQc8aaaRgtkCLagwVh684iyDQ,file_size=9749]"}
