{"time": 1755946815, "type": "recv", "message_id": "667601510", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"这边有这么受人欢迎吗？大叔，你有什么头绪吗？\"看着他离远，反倒舒服了不少，开口。"}
{"time": 1755946951, "type": "recv", "message_id": "1468368715", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=449784407]（不是）"}
{"time": 1755946960, "type": "recv", "message_id": "345708556", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（那你下来转述不是累死了？）"}
{"time": 1755946970, "type": "recv", "message_id": "293549766", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（这样吧，我换个小号得了）"}
{"time": 1755946975, "type": "recv", "message_id": "1396542698", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "（？）"}
{"time": 1755946979, "type": "recv", "message_id": "188891877", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“你放的鸟你问我？”"}
{"time": 1755947006, "type": "recv", "message_id": "497231568", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（三组转述感觉你工作量很大啊）"}
{"time": 1755947028, "type": "recv", "message_id": "1315214839", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "（呃）"}
{"time": 1755947036, "type": "recv", "message_id": "116014175", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "（再说）"}
{"time": 1755947140, "type": "recv", "message_id": "1107660102", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"要不是你把鸽子打落，会这么麻烦吗？\"语气稍微有些不耐，但也没到生气的程度，\"大叔的反派印象就是那时候建起来的。\""}
{"time": 1755947467, "type": "recv", "message_id": "1650813890", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(yysy，如果是熟悉的魔力源我应该能感知出来吧)"}
{"time": 1755947501, "type": "recv", "message_id": "1611004217", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "（不是）"}
{"time": 1755947597, "type": "recv", "message_id": "1595894818", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "[CQ:reply,id=1107660102]“我可没有被天上的眼睛盯着的习惯”没有再搭话的打算"}
{"time": 1755947665, "type": "recv", "message_id": "808333385", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "也没有再开口的打算，坐在剧场里。"}
{"time": 1755947686, "type": "recv", "message_id": "2063535322", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "都不说话了我也不说了，乖乖看剧"}
{"time": 1755947816, "type": "recv", "message_id": "771748977", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "外面的魔力波动朝东去了"}
{"time": 1755947934, "type": "recv", "message_id": "985036854", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“还以为会更热闹点呢，现在该怎么办”给安安传音"}
{"time": 1755948017, "type": "recv", "message_id": "1322269800", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...露露姐姐说自己想走的。\"语气颇无语"}
{"time": 1755948100, "type": "recv", "message_id": "1473827375", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“感觉和他待在一起好难受，硬留在这里也什么都做不了，好烦”"}
{"time": 1755948266, "type": "recv", "message_id": "1647818676", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"不如试着和解呗。\"虽然这么说，不过语气完全没有什么感情，就像是逼着自己说出来。"}
{"time": 1755948319, "type": "recv", "message_id": "540643320", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“和解吗？他从者那样说安安，不可能和解的啦....”"}
{"time": 1755948403, "type": "recv", "message_id": "1823284847", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"如果是露露姐姐的想法，安安会接受的。\""}
{"time": 1755948543, "type": "recv", "message_id": "1727461191", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不行不行，不能和解，大不了我们就在这耗着就是了”"}
{"time": 1755948715, "type": "recv", "message_id": "611877459", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...但是也要用一些条件让他们离开才是。\"余光看一眼那边的动静。"}
{"time": 1755948757, "type": "recv", "message_id": "804016168", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "没什么动静"}
{"time": 1755948778, "type": "recv", "message_id": "1736533042", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“要不让他们去找二阶堂小姐？”"}
{"time": 1755948823, "type": "recv", "message_id": "50395181", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"用毒苹果跟他做交易。\""}
{"time": 1755948860, "type": "recv", "message_id": "1651228653", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "有点没太懂安安的比喻“安安的意思是？”"}
{"time": 1755948919, "type": "recv", "message_id": "1090303102", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“但是如果我们表现的太想留下的话..恐怕会被猜出我们的意图吧”"}
{"time": 1755948953, "type": "recv", "message_id": "1933572005", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...这点倒也对啦，不过，既然他留在这里，倒是依然想和我们交换情报呢。\""}
{"time": 1755949103, "type": "recv", "message_id": "877938982", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "鸽子使魔观察到小黑去了古罗马广场"}
{"time": 1755949119, "type": "recv", "message_id": "1686469372", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"良子大叔，欣赏完结不了的故事固然很让人感动，不过您留在这里，想来也有别的原因吧。\"起身，看着他，\"未做完的情报交换，要继续吗？\""}
{"time": 1755949128, "type": "recv", "message_id": "1038157524", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我的使魔应该陆续就位了吧)"}
{"time": 1755949155, "type": "recv", "message_id": "1820640032", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "（差不多吧）"}
{"time": 1755949157, "type": "recv", "message_id": "1409321994", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(除了被打落的居民区和医院之外)"}
{"time": 1755949168, "type": "recv", "message_id": "117757291", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(有消息传给我)"}
{"time": 1755949197, "type": "recv", "message_id": "357158086", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(还有罗马广场的皇后是气息遮断B的，虽然阵地没有遮断)"}
{"time": 1755949216, "type": "recv", "message_id": "1064801317", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "（好的）"}
{"time": 1755949228, "type": "recv", "message_id": "2102513998", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "（现在还没建起来就是了）"}
{"time": 1755949444, "type": "recv", "message_id": "1414412020", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那接下来安安主导吧，我会配合你的”"}
{"time": 1755949473, "type": "recv", "message_id": "636113598", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "与此同时，大学处有从者魔力波动"}
{"time": 1755949542, "type": "recv", "message_id": "2040596377", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "在相互发现的下一刻，使魔被攻击摧毁了"}
{"time": 1755949552, "type": "recv", "message_id": "297215334", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "看看长啥样"}
{"time": 1755949593, "type": "recv", "message_id": "1893513646", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "是个背着厚重匣子的男人。攻击方式是飞锤"}
{"time": 1755949621, "type": "recv", "message_id": "1596381300", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（有立绘吗）"}
