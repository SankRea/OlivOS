{"time": 1755444600, "type": "recv", "message_id": "987458207", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"玛丽皇后，谢谢您。\""}
