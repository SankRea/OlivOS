{"time": 1755933229, "type": "recv", "message_id": "28498967", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"她是不是觉得我们不在剧院...\""}
