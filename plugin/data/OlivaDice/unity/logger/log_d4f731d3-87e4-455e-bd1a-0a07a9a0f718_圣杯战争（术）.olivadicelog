{"time": 1756205516, "type": "recv", "message_id": "2128861919", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(传音不是小群rp吗翔哥)"}
{"time": 1756205522, "type": "recv", "message_id": "570854776", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“没关系，现在圣杯战争还没开始，我出不了什么事的”"}
{"time": 1756205588, "type": "recv", "message_id": "1384447430", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“而且，我可没有安安想的那么弱”"}
