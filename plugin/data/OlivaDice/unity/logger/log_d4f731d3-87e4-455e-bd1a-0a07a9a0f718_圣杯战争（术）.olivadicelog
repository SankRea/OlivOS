{"time": 1756205651, "type": "recv", "message_id": "801449337", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那么多人追着我...要是...露露姐出了什么事...\""}
{"time": 1756206002, "type": "recv", "message_id": "1587623875", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(快说服我，翔哥)"}
{"time": 1756206021, "type": "recv", "message_id": "1153045790", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不会出事的，我有姐姐留给我的很厉害的魔术...”"}
{"time": 1756206071, "type": "recv", "message_id": "1646266308", "deleted": true, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“而且安安你忘了吗，除了杀，所有从者无法向御主动手的”"}
