{"time": 1755436546, "type": "recv", "message_id": "1363958353", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "小树林没有，密闭的电话亭倒是有"}
