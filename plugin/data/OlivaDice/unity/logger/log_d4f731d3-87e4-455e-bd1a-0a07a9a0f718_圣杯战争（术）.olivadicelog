{"time": 1755526386, "type": "recv", "message_id": "306695899", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我为什么一动不动)"}
{"time": 1755526483, "type": "recv", "message_id": "569821945", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "你们从真言之口的观景点出发，沿着大路前往万神庙。天色已经完全亮起来了。蓝白色的鸽群在广场上起落，还有色彩缤纷的冰淇淋车停在街边"}
{"time": 1755526652, "type": "recv", "message_id": "1374625415", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（好的）"}
{"time": 1755526681, "type": "recv", "message_id": "757862474", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“安安，你喜欢吃什么口味的冰激凌”"}
{"time": 1755526725, "type": "recv", "message_id": "743792345", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...?\"在玛利亚的怀里抬起头，\"有冰淇淋吗？\""}
{"time": 1755526781, "type": "recv", "message_id": "1543383923", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“就在那边哦，安安不清楚的话，我可以每个口味的冰激凌都给你买一个”"}
{"time": 1755526927, "type": "recv", "message_id": "367585451", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...不清楚...但是不能多吃，会吃坏肚子，还会掉牙齿。\"伸手揉揉自己肚子，\"嗯...皇后有吃不坏肚子和牙齿的药吗？\""}
{"time": 1755527234, "type": "recv", "message_id": "363696861", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那买一个三色的吧，直接可以吃三个口味”"}
{"time": 1755527347, "type": "recv", "message_id": "884614884", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"略有些期待，表情也变得好看了一些，嘴角微微扬着，对着皇后们眨眨眼。"}
{"time": 1755527406, "type": "recv", "message_id": "814543723", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "带着安安走到冰激凌车前“老板，来个三色冰激凌球”"}
{"time": 1755527432, "type": "recv", "message_id": "464267744", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（[CQ:at,qq=3625185457] 老板）"}
{"time": 1755527577, "type": "recv", "message_id": "630657390", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“好嘞，可爱的姑娘们。三色的话，自然是最经典的款式——草莓、香草和巧克力咯”老板带着哄小孩的笑容熟练地挖出三个雪球，累在一个脆皮圆筒上，随后递给了看起来最成熟的玛利亚？"}
{"time": 1755527703, "type": "recv", "message_id": "229240570", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "眼巴巴地看着皇后，\"...玛利亚皇后...\""}
{"time": 1755527881, "type": "recv", "message_id": "915599875", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“当然了，小爱丽丝……”玛利亚低下头，把冰淇淋放到你手中“这是乖孩子的奖励”"}
{"time": 1755527981, "type": "recv", "message_id": "283042298", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我才是监护人啦”掏钱给老板"}
{"time": 1755528025, "type": "recv", "message_id": "1823837299", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...不过现在御亲给我取了新名字，要叫安安啦...\""}
{"time": 1755528198, "type": "recv", "message_id": "830294836", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "[CQ:reply,id=283042298]老板给你们找了零，而玛丽亚宠溺地说道“都依你的，安安”"}
{"time": 1755528250, "type": "recv", "message_id": "1012626693", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "接过三色球，有些犹豫...递出去，\"御亲要吗？\""}
{"time": 1755528306, "type": "recv", "message_id": "1638072427", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“安安吃吧”摸摸安安的头"}
{"time": 1755528341, "type": "recv", "message_id": "466576511", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“安安还要吃棉花糖吗”"}
{"time": 1755528478, "type": "recv", "message_id": "519554140", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...好甜，感觉牙齿会坏掉..\"摇摇头，舔一口冰淇淋"}
{"time": 1755528569, "type": "recv", "message_id": "1277238428", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好吃吗”宠溺的眼神"}
{"time": 1755528663, "type": "recv", "message_id": "957825439", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...香草味的...喜欢。\""}
{"time": 1755528921, "type": "recv", "message_id": "1151630932", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“安安喜欢就好...我可以牵安安的手吗？”"}
{"time": 1755529056, "type": "recv", "message_id": "375733261", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "抬头看一眼天宫露，感觉也没那么烦了，\"刚刚是我不好...露露姐姐..\"低着头，感觉有些后悔，\"嗯...\"扭捏"}
{"time": 1755529143, "type": "recv", "message_id": "291761969", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“安安没有错哦，错的是我，安安可以原谅我吗”"}
{"time": 1755529232, "type": "recv", "message_id": "829216283", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...嗯...\"点点头又感觉哪里不对，\"嗯。\""}
{"time": 1755529316, "type": "recv", "message_id": "1268740271", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“谢谢安安，那我们接下来去万神殿逛逛吧”朝安安伸出手"}
{"time": 1755529380, "type": "recv", "message_id": "742030696", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(你就不能自己牵住)"}
{"time": 1755529478, "type": "recv", "message_id": "1109452687", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（互相牵有一种仪式感）"}
{"time": 1755529484, "type": "recv", "message_id": "842615867", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（代表你认可了我（）"}
{"time": 1755529577, "type": "recv", "message_id": "683574348", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"伸出手握住，一边舔着冰淇淋球，\"露露带安安去吧。\""}
{"time": 1755529609, "type": "recv", "message_id": "2034986818", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好啊，乐意为安安效劳”[CQ:face,id=63,raw=&#91;object Object&#93;]"}
{"time": 1755529694, "type": "recv", "message_id": "1340794940", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "（玫瑰是？）"}
