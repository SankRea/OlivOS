{"time": 1755444622, "type": "recv", "message_id": "533233254", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"御主亲，接下来要我做什么?什么都可以哦，安安什么都可以做。\""}
{"time": 1755444699, "type": "recv", "message_id": "1888623195", "deleted": false, "dect": {"host_id": null, "group_id": "964141319", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“既然安安是caster的话，先阵地做成？”"}
