{"time": 1757255501, "type": "recv", "message_id": "2128110516", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "“天啊？这都发了什么？”"}
{"time": 1757255518, "type": "recv", "message_id": "1045370572", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "在强烈的视觉冲击过后，你发现了雾雨铃——她躺在浑天仪下，手脚被反绑，双眼紧闭。"}
{"time": 1757255531, "type": "recv", "message_id": "115277054", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "＃赶紧上前给她解绑"}
{"time": 1757255544, "type": "recv", "message_id": "1103103174", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "（闯进了邪教仪式）"}
