{"time": 1771900019, "type": "recv", "message_id": "1024485819", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "她显然没注意到你"}
{"time": 1771900073, "type": "recv", "message_id": "806065141", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "想想过去的时候，这个不存在之人的规矩在校外大家还遵守吗"}
