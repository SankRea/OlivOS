{"time": 1770807463, "type": "recv", "message_id": "1541494935", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(学校在镇子中间，远倒是不远吧)"}
