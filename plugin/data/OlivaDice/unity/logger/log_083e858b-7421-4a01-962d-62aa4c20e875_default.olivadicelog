{"type": "log_total_duration", "total_time": 0}
{"time": 1770198785, "type": "reply", "message_id": "1371822890", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "408119794"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "开始记录乐谱"}
{"time": 1770198950, "type": "recv", "message_id": "1679965411", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "你的座位在最后一片，几乎是无人关注的角落，坐在椅子上，后背就能贴着冰冷的墙壁，后门的风时不时卷进来，吹得课本边角微微翻动，却吹不散周身的死寂。三年三班最后一排的角落，这里是全班刻意划出的真空区——没有同桌，没有邻座，甚至没有一丝目光会落在你身上，仿佛你从来都没有存在过。"}
{"time": 1770199213, "type": "recv", "message_id": "1926123274", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "（不赖）"}
{"time": 1770199274, "type": "recv", "message_id": "170191415", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（你动）"}
{"time": 1770199293, "type": "recv", "message_id": "38725523", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "（原来我可以动了吗，现在是什么时候）"}
{"time": 1770199301, "type": "recv", "message_id": "339854228", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（午间休息）"}
{"time": 1770199306, "type": "recv", "message_id": "1030593502", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "正午的阳光被教学楼的阴影切得发灰，三年三班的教室里很吵，有人趴在桌上午睡，有人扎堆聊周末的事，粉笔灰在光柱里飘。讲台上的值日生擦着黑板，擦到一半顿了顿，午后的时间总是有些闲适"}
{"time": 1770199310, "type": "recv", "message_id": "653626186", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "但这些都与你无关"}
{"time": 1770199343, "type": "recv", "message_id": "262354974", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "（日本高中有饭堂吗 还是吃便当的）"}
{"time": 1770199372, "type": "recv", "message_id": "1876719635", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（我其实不知道）"}
{"time": 1770199398, "type": "recv", "message_id": "1791823894", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "（我记得之前跑都有饭堂，那就这样吧）"}
