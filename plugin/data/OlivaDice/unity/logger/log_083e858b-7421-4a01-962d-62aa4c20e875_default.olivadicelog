{"time": 1770806966, "type": "recv", "message_id": "969105120", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "看向墓地，思考离这里多远"}
{"time": 1770807241, "type": "recv", "message_id": "408197144", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "墓地在镇子最西边，太阳落下的地方"}
{"time": 1770807262, "type": "recv", "message_id": "1744871093", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "（就是多远）"}
