{"time": 1772361232, "type": "recv", "message_id": "682640494", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "教室里空了几个座位，不包括你还有，班长，神山露，转校生和巫山雨纪。"}
{"time": 1772361246, "type": "recv", "message_id": "75713010", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "（我超 都消失了）"}
{"time": 1772361293, "type": "recv", "message_id": "878141769", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "你的视线不经意一瞥，黑板上残留着你昨天留下的你在吗的粉笔字，但是好像无人在意。此外，你感觉到了别人的视线，你往走廊那边看去，看见了班长和你对视着。旁边是转校生和雨纪。"}
{"time": 1772361299, "type": "recv", "message_id": "1171318017", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "他们都在教师办公室的门口"}
{"time": 1772361306, "type": "recv", "message_id": "427963015", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "转校生蹲在地上，似乎有些难受。"}
{"time": 1772361376, "type": "recv", "message_id": "1522816723", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "（yuki上去了吗）"}
{"time": 1772361384, "type": "recv", "message_id": "391077258", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(已经离开了)"}
{"time": 1772361432, "type": "recv", "message_id": "138425984", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "过去看看呗，也不打算说话，就在走廊上靠着"}
{"time": 1772361675, "type": "recv", "message_id": "1641402503", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "转校生低头不敢看你"}
{"time": 1772361687, "type": "recv", "message_id": "1447537354", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "另外两人在说着悄悄话"}
{"time": 1772361688, "type": "recv", "message_id": "1513009700", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "聆听"}
