{"time": 1772443129, "type": "recv", "message_id": "1340922305", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "你感觉到了湿冷感，浑身都湿漉漉地，像是长时间浸泡在水中，忍不住地打哆嗦，眼前的视野也越来越暗"}
{"time": 1772443155, "type": "recv", "message_id": "1389349270", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“.......”"}
{"time": 1772443247, "type": "recv", "message_id": "1099473000", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "身体逐渐失控，发软，随时可能会晕倒"}
{"time": 1772443342, "type": "recv", "message_id": "561424560", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(怎么个倒法，温柔点还是粗暴点)"}
{"time": 1772443361, "type": "recv", "message_id": "532925488", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "（温柔点吧）"}
{"time": 1772443459, "type": "recv", "message_id": "537697998", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(那你自己来倒)"}
{"time": 1772443463, "type": "recv", "message_id": "1520376553", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(是不是很温柔)"}
{"time": 1772443537, "type": "recv", "message_id": "1405679691", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "(那很温柔了，等一下先）"}
{"time": 1772443822, "type": "recv", "message_id": "692610391", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "四周人群在喧嚣，警察下了车，从两旁跑去，风把血腥味带到了我的面前。难道不是yuki酱的事情吗，对了，救护车了？班级是不是也出事了？没有细想，指尖温暖的暗红色在眼前无限放大，占据了眼帘，占据了脑海，占据了意识。之后，传来了啪嗒的一声，眼前感受到一丝阳关，就什么也不知道了。"}
{"time": 1772443923, "type": "recv", "message_id": "14889844", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "于是她，轻轻跌入眼前的水中"}
{"time": 1772445200, "type": "recv", "message_id": "809335786", "deleted": false, "dect": {"host_id": null, "group_id": "972136174", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "（《水》）"}
