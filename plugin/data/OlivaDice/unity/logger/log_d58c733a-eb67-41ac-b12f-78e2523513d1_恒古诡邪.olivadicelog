{"time": 1753181083, "type": "recv", "message_id": "1684326956", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"比起枷薇，奥契丝的那些法术才是治疗向的吧？\""}
{"time": 1753181212, "type": "recv", "message_id": "954114300", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（总之你不用担心强大的奥术人的事情）"}
{"time": 1753181238, "type": "recv", "message_id": "919549930", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“但是我的法术很厉害啊，所以奥契丝姐姐不要担心了”"}
{"time": 1753181353, "type": "recv", "message_id": "318919079", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好吧，嗯...按理说应该能在这里面找到那本书\""}
{"time": 1753181367, "type": "recv", "message_id": "937980822", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（暗黑连锁？）"}
{"time": 1753181374, "type": "recv", "message_id": "850896643", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "翻一下院长的尸体，没有的话去二层的图书馆看看"}
{"time": 1753181376, "type": "recv", "message_id": "1665120464", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(对)"}
{"time": 1753181520, "type": "recv", "message_id": "848683850", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你并没有找到那本名为暗夜连锁的书"}
{"time": 1753181607, "type": "recv", "message_id": "813082681", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "但你找到了一个雕刻成大脑形状的木箱子，一本描绘着尖叫着的和哭泣着的双胞胎的书籍和一个黄铜做成的奧斯利昂的金字塔雕像。这三件物品每一样都价值50gp。赞达鲁斯的那几幅画作一套能卖出100gp，同时你还在书架上找到了几本贵重的书，一本是Doctor Beaurigmand Trice所著的野心，失望与叹惋的治疗法；一本是Doctor Henri Meirtmane所写的暴虐沙滩；还有艾利森·金德勒笔下的Galdyce的贵客 诺斯费拉图的盛宴的副本。每一本书都重达2磅，价值100gp。"}
{"time": 1753181624, "type": "recv", "message_id": "275319802", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（话说，你是不是该开个文档，记一下战利品啊）"}
