{"time": 1753112457, "type": "recv", "message_id": "2064592319", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“你...你要干嘛”"}
{"time": 1753112463, "type": "recv", "message_id": "1431453063", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "召唤了四只凶暴鼠"}
{"time": 1753112476, "type": "recv", "message_id": "1299981779", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“你，带着她们钻进这里面看看。”"}
{"time": 1753112488, "type": "recv", "message_id": "846080133", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "指着之前准备探查的甬道"}
{"time": 1753112516, "type": "recv", "message_id": "1159080170", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“里面什么也没有啊...”"}
{"time": 1753112544, "type": "recv", "message_id": "1530877280", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“...”"}
{"time": 1753112562, "type": "recv", "message_id": "899904524", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“真的没有，别杀我...”"}
{"time": 1753112580, "type": "recv", "message_id": "365508581", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“...那这里面是什么？”"}
{"time": 1753112606, "type": "recv", "message_id": "166494459", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“就是一些联通地底的通道..”"}
{"time": 1753112687, "type": "recv", "message_id": "119579732", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“地下有什么？”"}
{"time": 1753112849, "type": "recv", "message_id": "1589080747", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“地下有一只好大好大的蠕虫，之前的地震就是因为它睡觉时候翻了个身子”"}
{"time": 1753112865, "type": "recv", "message_id": "229658714", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“...原来如此，那么你现在呢？准备留在这里？”"}
{"time": 1753112882, "type": "recv", "message_id": "495471889", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我家在这里...”"}
{"time": 1753112994, "type": "recv", "message_id": "1268747529", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“行吧，那我就不为难你了。”"}
{"time": 1753113013, "type": "recv", "message_id": "420627952", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“谢谢你，谢谢你，你大人有大量”"}
{"time": 1753113014, "type": "recv", "message_id": "958362452", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "准备离开图书馆，往图书馆之后的房间移动"}
{"time": 1753113033, "type": "recv", "message_id": "119952778", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "指挥着鼠群探路"}
{"time": 1753113035, "type": "recv", "message_id": "1581340866", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（话说大门你都不看一眼？）"}
{"time": 1753113046, "type": "recv", "message_id": "1308353447", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（不全是雾？）"}
{"time": 1753113055, "type": "recv", "message_id": "13362530", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（待会回来的路上不还要看一遍）"}
{"time": 1753113058, "type": "recv", "message_id": "333055412", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（也是）"}
