{"time": 1753002341, "type": "recv", "message_id": "1970166153", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哪来的老鼠...吓我一跳。\"看一眼伤口"}
{"time": 1753002343, "type": "recv", "message_id": "1999897318", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你发现在锅炉底下，有两个日光法杖"}
{"time": 1753002394, "type": "recv", "message_id": "48314751", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“没事吧，奥契丝姐姐”伽薇有些担忧的看着你"}
{"time": 1753002441, "type": "recv", "message_id": "456468805", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "离炉边约4尺。一个小型或更小的生物可以爬下去拿到它们，但是体型在这之上的生物无法拿到。"}
{"time": 1753002446, "type": "recv", "message_id": "270141189", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没事没事，一点点小伤。\"拿出奶杖，\"我的东西都找回来了，以后受伤尽管找我啦。\""}
{"time": 1753002616, "type": "recv", "message_id": "805171716", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:image,file=9C9F6C45200452489FA65BDED60CECC6.png,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhS6f0c69O4eQSuIfcKPTnEOEDGAOxiDmgEg_woo8YCz0YvLjgMyBHByb2RQgL2jAVoQ62uuCt3zDo0Ek4qfbs3e8XoCRig&amp;rkey=CAISMDJauPKYRfOICVuTykSuiDZ6pplJzKfDuwzn7XABcmZTaHImBBpP7SWH3uPdjrAn3w,file_size=19715]"}
{"time": 1753002815, "type": "recv", "message_id": "2004058547", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"走吧...我们也不能停在这里\""}
