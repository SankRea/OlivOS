{"time": 1753100253, "type": "recv", "message_id": "1499620509", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯....今天确实需要休息一下。\""}
