{"time": 1752993905, "type": "recv", "message_id": "359776176", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（这真的不是excel？"}
{"time": 1752994012, "type": "recv", "message_id": "271034817", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你睁开眼，感觉到头痛欲裂，你不记得自己是谁，也不知道自己为什么在这里，总之你十分的迷茫"}
{"time": 1752994057, "type": "recv", "message_id": "1880249537", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "然后你发现远处似乎有一个人，虽然你不知道她是谁，但却有种莫名的熟悉的感觉"}
{"time": 1752994104, "type": "recv", "message_id": "1950336196", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:file,file=从结云村开始.2.doc,file_id=/8f6dfdb9-2721-44a6-92ee-dca2f0096fc0,file_size=2699229,url=https://gzc-download.ftn.qq.com/ftn_handler/53dcf8046590cff81283098e85030a6961cd7cef9b116389534593a2d9c8ad815d18adc23191ada01534b9c4c19a9726764e0a70bf847b3fbc1c2710a37abe89/?fname=]"}
{"time": 1752994128, "type": "recv", "message_id": "1004582653", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。rd6"}
{"time": 1752994128, "type": "reply", "message_id": "1004582653", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[桃乐丝]演奏出: 1D6=1"}
{"time": 1752994153, "type": "recv", "message_id": "1696706782", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你发现自己身上破破的，什么都没有"}
{"time": 1752994170, "type": "recv", "message_id": "841956344", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“呃...”"}
{"time": 1752994182, "type": "recv", "message_id": "768579934", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": ".r1d4"}
{"time": 1752994182, "type": "reply", "message_id": "768579934", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[露儿]演奏出: 1D4=4"}
{"time": 1752994339, "type": "recv", "message_id": "2003799679", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "召唤亚里莎"}
{"time": 1752994348, "type": "recv", "message_id": "1090783655", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "那个人走到你的身前“我们之前是不是在哪里见过？”"}
{"time": 1752994413, "type": "recv", "message_id": "1584972706", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“你是谁？”"}
{"time": 1752994442, "type": "recv", "message_id": "460934441", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "四周是一片黄色的雾气，在灰石砖的砌成胡同巷子废墟里流动，看上去一切都像染上了黄疸病一般。在眼前陌生的小巷分开了两条岔路，一左一右的蜿蜒而出。在默默蔓延的雾气中，传出缓慢却与这似乎要把人吞噬的雾气保持着相应的节奏的脚步声"}
{"time": 1752994494, "type": "recv", "message_id": "972525267", "deleted": true, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我叫奥契丝，但是关于我的过去，我有点不太记得了，只是隐隐约约感觉我好像认识你........”"}
{"time": 1752994549, "type": "recv", "message_id": "686952117", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我叫伽薇，但是关于我的过去，我有点不太记得了，只是隐隐约约感觉我好像认识你........”"}
{"time": 1752994586, "type": "recv", "message_id": "736464541", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“嗯...我是奥契丝，我似乎也认识你...”"}
{"time": 1752994602, "type": "recv", "message_id": "1702918105", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“但是，关于你是谁，我完全不记得。”"}
{"time": 1752994612, "type": "recv", "message_id": "1694640704", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“你也失忆了吗....”"}
{"time": 1752994706, "type": "recv", "message_id": "941049555", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“呃..我身上的东西还丢完了”"}
{"time": 1752994710, "type": "recv", "message_id": "635386412", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "在你们交谈的时候，黄色的雾气与追赶的脚步声正逐渐向你们逼近"}
{"time": 1752994722, "type": "recv", "message_id": "915506058", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“等下，好像有什么东西在靠近...”"}
{"time": 1752994741, "type": "recv", "message_id": "1355449179", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“亚里莎，警戒一下。”"}
{"time": 1752994742, "type": "recv", "message_id": "914502319", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": ".init clear"}
{"time": 1752994742, "type": "reply", "message_id": "914502319", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "已清空先攻列表"}
{"time": 1752994798, "type": "recv", "message_id": "757927419", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "那伽薇感觉到不对，也把真红叫了出来"}
