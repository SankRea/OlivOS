{"time": 1753111688, "type": "recv", "message_id": "325303016", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（神恩作用于自身啊）"}
{"time": 1753111695, "type": "recv", "message_id": "1923847321", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（亚里沙怎么样也吃不到的）"}
