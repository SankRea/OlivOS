{"time": 1753111712, "type": "recv", "message_id": "881177112", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（记错了）"}
{"time": 1753111716, "type": "recv", "message_id": "1908981460", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(作用于自共享给幻灵)"}
{"time": 1753111723, "type": "recv", "message_id": "1221106062", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我有把伽薇记成神术了）"}
{"time": 1753111728, "type": "recv", "message_id": "1101975330", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"人面鼠....呃...\""}
{"time": 1753111750, "type": "recv", "message_id": "2021282194", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好吧，姑且听你说几句，你有什么情报?\""}
{"time": 1753111753, "type": "recv", "message_id": "943406122", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“放过我吧，我们也没袭击你对吧..”"}
{"time": 1753111763, "type": "recv", "message_id": "415486363", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"你这不是准备袭击我吗？\""}
{"time": 1753111814, "type": "recv", "message_id": "1865623459", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我叫詹妮·双尾，住在这个图书馆，我们只是想把你给赶走..”"}
{"time": 1753111842, "type": "recv", "message_id": "611875710", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"赶走?我也没做什么啊...\""}
{"time": 1753111845, "type": "recv", "message_id": "1645363772", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我原来生活在棘石岛下面的岩石深处，期中有许多无法让大个子通过的小甬道，虽然这些甬道在最近的地震中崩塌了，但也得以让我和同族可以离开以前的巢穴来到地面”"}
{"time": 1753111864, "type": "recv", "message_id": "1676934420", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“对不起，我错了，别杀我好吗，美丽的女士...”"}
{"time": 1753111884, "type": "recv", "message_id": "1306695798", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"这里本来就是人类的势力范围吧。你这家伙。\"瞪着她，\"说起来，只有这一条情报吗？\""}
{"time": 1753111915, "type": "recv", "message_id": "2056396853", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"你们几个家伙在这里这么久，有没有搜集到什么，值钱的东西也行，其他人类的信息也行。\""}
{"time": 1753111938, "type": "recv", "message_id": "50450089", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"不然亚里莎就不客气了。\"心念所至，亚里莎拈弓搭箭"}
{"time": 1753111948, "type": "recv", "message_id": "2023567472", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我也是刚来的....别杀我...我也不太清楚”"}
{"time": 1753111988, "type": "recv", "message_id": "468399106", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "侦测一下毒素"}
{"time": 1753112063, "type": "recv", "message_id": "1173957117", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "看看人面鼠身上带不带毒"}
{"time": 1753112124, "type": "recv", "message_id": "1064322843", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "没有毒"}
{"time": 1753112142, "type": "recv", "message_id": "1400447195", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "这三只老鼠本身的攻击方式疑似是用书砸你们"}
{"time": 1753112199, "type": "recv", "message_id": "221450240", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“唉，那你下来吧。”"}
{"time": 1753112219, "type": "recv", "message_id": "388517960", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我保证不杀了你，但是不乖乖听我的话的话...”甜甜地笑"}
{"time": 1753112235, "type": "recv", "message_id": "1638244720", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“别别杀我...“"}
{"time": 1753112258, "type": "recv", "message_id": "366534734", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“下来，到我旁边来”"}
{"time": 1753112262, "type": "recv", "message_id": "1483530099", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "老鼠跳了下来“我下来了，快让你的同伴把弓箭放下来吧，我不想死”"}
{"time": 1753112380, "type": "recv", "message_id": "1085498974", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“可以哦，亚里莎，放下来吧。”"}
{"time": 1753112408, "type": "recv", "message_id": "1837336248", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "亚里沙听了你的话，把弓箭放了下来"}
{"time": 1753112411, "type": "recv", "message_id": "1577541404", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“鼠鼠啊。”和蔼地看着它"}
{"time": 1753112414, "type": "recv", "message_id": "1328312334", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“谢谢你，谢谢你”"}
{"time": 1753112425, "type": "recv", "message_id": "1400241472", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（话说这鼠鼠居然会四环法术就离谱）"}
{"time": 1753112437, "type": "recv", "message_id": "378447700", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "召唤出几只凶暴鼠"}
