{"time": 1753103622, "type": "recv", "message_id": "1808159358", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "今晚你感觉很安详，没有做什么奇怪的梦"}
{"time": 1753103800, "type": "recv", "message_id": "468511628", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“嗯...难得做了个干净的梦。”睁开眼睛"}
{"time": 1753103820, "type": "recv", "message_id": "863680729", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“早上好啊，奥契丝姐姐”"}
{"time": 1753103863, "type": "recv", "message_id": "895022299", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你一醒来就发现枷薇站在你的身旁，居高临下的看着你"}
{"time": 1753103880, "type": "recv", "message_id": "254122034", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“枷薇，昨晚睡得怎么样？有没有做一个清爽的梦？”没有起身，看着她"}
{"time": 1753103905, "type": "recv", "message_id": "293762010", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯，感觉好久没有睡的这么舒服过了”"}
{"time": 1753103990, "type": "recv", "message_id": "451732678", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“嗯..今天之后就会有些忙哦？”起身"}
{"time": 1753104076, "type": "recv", "message_id": "2132496839", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“没事，只要补充奥契丝能量，我就不会累了”说完，她就在你身上蹭了蹭"}
{"time": 1753104199, "type": "recv", "message_id": "740641531", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“诶？”抱住她，抬手摸摸脑袋，“撑不住的时候要跟我说哦？”"}
{"time": 1753104445, "type": "recv", "message_id": "1169678154", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“唉..”叹口气，“也许会死在里面哦？”"}
{"time": 1753104478, "type": "recv", "message_id": "844746530", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“和奥契丝姐姐死在一起吗...那也可以的”"}
{"time": 1753104504, "type": "recv", "message_id": "643417829", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（如果你死了，枷薇直接转死灵法师，然后把你复活成糖的不得了的僵尸（）"}
{"time": 1753104540, "type": "recv", "message_id": "1384513954", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（？）"}
{"time": 1753104586, "type": "recv", "message_id": "855573002", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“别说这种话嘛，我会保护你的。”靠着床头，拿着发带，准备整理自己的头发"}
{"time": 1753104693, "type": "recv", "message_id": "1529892445", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我也会保护奥契丝姐姐的”"}
{"time": 1753104723, "type": "recv", "message_id": "1298559486", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（忽然发现你角色又是a开头（）"}
{"time": 1753104733, "type": "recv", "message_id": "1929458499", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（不愧是强度党）"}
{"time": 1753104738, "type": "recv", "message_id": "413220970", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（？？）"}
{"time": 1753104742, "type": "recv", "message_id": "1521972527", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（为什么强度党）"}
{"time": 1753104753, "type": "recv", "message_id": "1114983666", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（先攻一样排前面啊（）"}
{"time": 1753104753, "type": "recv", "message_id": "1082304229", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“唔..”"}
{"time": 1753104760, "type": "recv", "message_id": "852023822", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（好的）"}
{"time": 1753104769, "type": "recv", "message_id": "510683053", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“帮我绑一下发带，枷薇。”"}
{"time": 1753104803, "type": "recv", "message_id": "320041429", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯嗯”枷薇接过发带开始帮你绑“奥契丝姐姐的头发..好柔顺”"}
{"time": 1753104818, "type": "recv", "message_id": "290307061", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“诶？我这几天都没洗过头哦”"}
{"time": 1753104840, "type": "recv", "message_id": "226124578", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（好想说变态的话）"}
{"time": 1753104857, "type": "recv", "message_id": "41448988", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（？）"}
{"time": 1753104861, "type": "recv", "message_id": "1843178351", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（别有一番风味（bushi）"}
{"time": 1753104866, "type": "recv", "message_id": "1780463260", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你们在玩什么）"}
{"time": 1753104872, "type": "recv", "message_id": "999026160", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我不在意的...”"}
{"time": 1753104879, "type": "recv", "message_id": "900795340", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=1780463260](cod[CQ:at,qq=825734198]"}
{"time": 1753104885, "type": "recv", "message_id": "679805606", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（克苏鲁的地下城）"}
{"time": 1753104894, "type": "recv", "message_id": "153916429", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（准备打死哈斯塔了）"}
{"time": 1753105004, "type": "recv", "message_id": "1590894019", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“怎么会有那么柔顺啦。”自己伸手试一试"}
{"time": 1753105069, "type": "recv", "message_id": "457885985", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=1590894019][CQ:at,qq=1252219916] emmm，有点油？"}
{"time": 1753105098, "type": "recv", "message_id": "1198464386", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“这不是没洗头嘛，枷薇，真是的。”"}
{"time": 1753105104, "type": "recv", "message_id": "1853517544", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我记得不是有个法术，洁身术？好像叫这个来着）"}
{"time": 1753105162, "type": "recv", "message_id": "1763123101", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“奥契丝姐姐的一切我都会去接受的”"}
{"time": 1753105205, "type": "recv", "message_id": "1067497952", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“诶...那也要干净一些吧？”"}
{"time": 1753105218, "type": "recv", "message_id": "211020957", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“既然如此，去问问他们这里能不能洗个澡？”"}
{"time": 1753105313, "type": "recv", "message_id": "318180253", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "还剩一半发带没有绑，从床铺上起来，“走吧？”"}
{"time": 1753105573, "type": "recv", "message_id": "2007117480", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "那你想到之前在你救起艾尔温之后，她教了你b9的锅炉如何恢复使用，如果可以恢复锅炉房的燃烧，b14洗衣房那里便可以通过开关，放出沸水和冷水"}
{"time": 1753105632, "type": "recv", "message_id": "1102162933", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "加热炉被重新运作5个小时以上，锅炉将再次发挥作用"}
{"time": 1753105718, "type": "recv", "message_id": "761202075", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“emmm，现在水资源听说有点紧缺，听温特说外面虽然一直在下雨，但雨水好像有点奇怪，处理之后也不能引用，可能没有多余的水给我们洗澡吧”伽薇说到"}
{"time": 1753105803, "type": "recv", "message_id": "45134903", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\""}
{"time": 1753105811, "type": "recv", "message_id": "1512681550", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那看来只有先解决这里的事情了。\""}
{"time": 1753105830, "type": "recv", "message_id": "319779975", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"昨晚我去那边看了一眼，今天得先去问问温特小姐\""}
{"time": 1753105847, "type": "recv", "message_id": "1518233241", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯，那走吧...”"}
{"time": 1753105895, "type": "recv", "message_id": "122569786", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "找到温特问一问那个房间里的折纸动物"}
{"time": 1753106096, "type": "recv", "message_id": "405018962", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那个啊，这里还有两个孩子，护士托尔曼·雷勒斯教那两个孩子如何去折纸，让他们能够保持冷静”"}
{"time": 1753106230, "type": "recv", "message_id": "1568203351", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"孩子?现在他们在哪\""}
{"time": 1753106357, "type": "recv", "message_id": "1868669145", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“还在那边睡觉吧”"}
{"time": 1753106371, "type": "recv", "message_id": "588056152", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（指小教堂内部）"}
{"time": 1753106419, "type": "recv", "message_id": "2101202369", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...你可以带我们去看看吗？我猜他们也许和那个门口的作祟有关\""}
{"time": 1753106433, "type": "recv", "message_id": "968890077", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（？）"}
{"time": 1753106442, "type": "recv", "message_id": "1904265348", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“为什么奥契丝会这样想呢”"}
{"time": 1753106475, "type": "recv", "message_id": "34760928", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“门口的东西原来你已经看过了啊”"}
{"time": 1753106556, "type": "recv", "message_id": "557310745", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那玩意邪门的很，如果攻击它的话，那眼球会大叫‘我变成了什么？’，然后还会长出牙齿咬附近的人”"}
{"time": 1753106568, "type": "recv", "message_id": "1904295537", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不过我想不明白跟那两个孩子有什么关系”"}
{"time": 1753106575, "type": "recv", "message_id": "780236748", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...这样么\""}
{"time": 1753106645, "type": "recv", "message_id": "2143549997", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“嗯..因为作祟很难处理嘛”"}
{"time": 1753106657, "type": "recv", "message_id": "1419754482", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我在旁边的房间也只看见了这么些折纸动物”"}
{"time": 1753106710, "type": "recv", "message_id": "1883714296", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那个房间本来也有一些书架之类的，不过已经被幸存者全拆了”"}
{"time": 1753106747, "type": "recv", "message_id": "1630942338", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"还有那个房间之中的星星?\""}
{"time": 1753106772, "type": "recv", "message_id": "87241004", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那原来是个牧师的房间”"}
{"time": 1753106858, "type": "recv", "message_id": "679599383", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那那个星星是?\""}
{"time": 1753106884, "type": "recv", "message_id": "1858591408", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那是墓土女士的圣辉”"}
{"time": 1753106905, "type": "recv", "message_id": "684553796", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:image,file=9B2C0CF6F083139380F2704E77F73257.png,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhQzCRlM-Q5kek0-JUf76E1tUH6sqRjsngMg_woox8_FkpDOjgMyBHByb2RQgL2jAVoQwBBGRS-GQngt5SdGRSqcHXoCXrA&amp;rkey=CAQSMK_1wdrKa50mtX2dR1FIFFWgGdV33lDeadhKoA_j4V8J2ZJhU7lFBQ_uKn9bEctu1w,file_size=53100]"}
{"time": 1753106922, "type": "recv", "message_id": "1130502569", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（圣徽）"}
{"time": 1753106978, "type": "recv", "message_id": "1264561468", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哦...原来如此。\""}
{"time": 1753106985, "type": "recv", "message_id": "992450975", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那我们再去看看吧。\""}
{"time": 1753107008, "type": "recv", "message_id": "1479411043", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯，拜托你了，奥契丝小姐”"}
{"time": 1753107061, "type": "recv", "message_id": "334199154", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "去那个作祟前"}
{"time": 1753107086, "type": "recv", "message_id": "1709715125", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“你变成了一堵墙。”歪着头试探着问到"}
{"time": 1753107100, "type": "recv", "message_id": "46299807", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "没有任何反应"}
{"time": 1753107119, "type": "recv", "message_id": "377441499", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"你变成了一个邪祟。\"继续说话"}
{"time": 1753107137, "type": "recv", "message_id": "375492251", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“奥契丝姐姐是在？”枷薇有些疑惑的看着你"}
{"time": 1753107324, "type": "recv", "message_id": "371374742", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我在试答案?不清楚啦，毕竟这是个作祟，好麻烦的东西。\""}
{"time": 1753107353, "type": "recv", "message_id": "1033401609", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“原来是这样，可是这个东西真的可以听到奥契丝姐姐的声音吗？”"}
{"time": 1753107364, "type": "recv", "message_id": "1689771295", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“毕竟这只是个眼睛”"}
{"time": 1753107502, "type": "recv", "message_id": "633002494", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯....我也不清楚。\"看看这个眼睛有没有动静"}
{"time": 1753107514, "type": "recv", "message_id": "2032006820", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=633002494][CQ:at,qq=1252219916] 没什么动静"}
{"time": 1753107668, "type": "recv", "message_id": "605209290", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"亚里莎，射它一箭\""}
{"time": 1753107688, "type": "recv", "message_id": "857889242", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“是，master”"}
{"time": 1753107764, "type": "recv", "message_id": "777111663", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（roll伤害吧）"}
{"time": 1753107777, "type": "recv", "message_id": "178509560", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（这玩意感觉不能破敌吧）"}
{"time": 1753107822, "type": "recv", "message_id": "1528507313", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。rd8+4"}
{"time": 1753107822, "type": "reply", "message_id": "1528507313", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[桃乐丝]演奏出: 1D8+4={4}+4=8"}
{"time": 1753107847, "type": "recv", "message_id": "1306230586", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你的箭被直接弹开了"}
{"time": 1753107882, "type": "recv", "message_id": "1596366463", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "然后你看到眼睛上长了獠牙，所幸墙边没有站有任何人"}
{"time": 1753107916, "type": "recv", "message_id": "1520908109", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "眼睛用好像许多濒死的人一起发出般的声音尖啸道“我变成了什么？”，并像流泪一般流出了难闻的液体"}
{"time": 1753108363, "type": "recv", "message_id": "967910581", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"一个邪祟，长着眼球，还像个墙壁。\""}
{"time": 1753108392, "type": "recv", "message_id": "1841235522", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "一本正经地回答"}
{"time": 1753108558, "type": "recv", "message_id": "1140443814", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "眼球依旧没什么反应"}
{"time": 1753108592, "type": "recv", "message_id": "1730479721", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“emmm，奥契丝姐姐，你说它只是个眼球，会不会要看见自己的模样才行呢”沉思"}
{"time": 1753108886, "type": "recv", "message_id": "2055325429", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯....\""}
{"time": 1753108899, "type": "recv", "message_id": "1258531414", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"这边有没有镜子?\""}
{"time": 1753108903, "type": "recv", "message_id": "1441011656", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "去找一面镜子来"}
{"time": 1753108923, "type": "recv", "message_id": "1409032340", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你想起之前洗衣房是有一面镜子的"}
{"time": 1753108944, "type": "recv", "message_id": "1554219962", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "那你去洗衣房把那面落地镜搬了过来"}
{"time": 1753108978, "type": "recv", "message_id": "1590982249", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"你的样子，嗯...\""}
{"time": 1753108986, "type": "recv", "message_id": "1420779055", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "搬到它面前"}
{"time": 1753109045, "type": "recv", "message_id": "1467734664", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "眼球看到镜子中的样子...静静的枯萎了，随着眼球的慢慢萎缩，连带着那堵墙壁也逐渐的破碎"}
{"time": 1753109159, "type": "recv", "message_id": "232289293", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不愧是奥契丝姐姐，太厉害了”伽薇崇拜的看着你"}
{"time": 1753109218, "type": "recv", "message_id": "568929678", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呃...多亏了枷薇提醒啦。\""}
{"time": 1753109235, "type": "recv", "message_id": "756896992", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“奥契丝小姐和伽薇小姐真是厉害，轻松便解决了困扰了我们这么久的问题..”温特由衷的称赞道"}
{"time": 1753109459, "type": "recv", "message_id": "1448221000", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没什么，之后的事情才更麻烦。\""}
{"time": 1753109477, "type": "recv", "message_id": "514552060", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"这里还有作祟的事情...真是不简单。\""}
{"time": 1753109518, "type": "recv", "message_id": "358456598", "deleted": true, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "来着枷薇，\"嗯...为了热水\""}
{"time": 1753109526, "type": "recv", "message_id": "1623508287", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "拉着枷薇，\"嗯...为了热水\""}
{"time": 1753109528, "type": "recv", "message_id": "1297868383", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(b9在哪)"}
{"time": 1753109550, "type": "recv", "message_id": "214020700", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"看来今天这趟锅炉房，怎么都要去一趟了。\""}
{"time": 1753109641, "type": "recv", "message_id": "955471022", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（b9就是你刚来这张地图的地方）"}
{"time": 1753109707, "type": "recv", "message_id": "1679357451", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(那不是有热水吗？)"}
{"time": 1753109714, "type": "recv", "message_id": "1197630936", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=1448221000][CQ:at,qq=1252219916] “之后的事情就麻烦二位了....”"}
{"time": 1753109720, "type": "recv", "message_id": "511082351", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"这里的事情解决了，该去洗个澡了。\""}
{"time": 1753109759, "type": "recv", "message_id": "1570327814", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "打个哈欠，\"锅炉房里的怪物我已经清理过了，应该是能有热水的吧？现在\""}
{"time": 1753109819, "type": "recv", "message_id": "753790545", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“如果重新燃起锅炉应该是可以的”"}
{"time": 1753109861, "type": "recv", "message_id": "2001531950", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“但是锅炉要先烧五个小时”"}
{"time": 1753109879, "type": "recv", "message_id": "1635787417", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“二位可以先去看看正门什么情况，我去重启锅炉”"}
{"time": 1753109928, "type": "recv", "message_id": "459478227", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"行吧。\""}
{"time": 1753109937, "type": "recv", "message_id": "533875216", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "略微思考一下，去正门"}
{"time": 1753109997, "type": "recv", "message_id": "540046261", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "在这大教堂般的白色瓷砖大厅的墙壁上布满蛛网状的裂痕。一张椭圆形的办公桌突兀的放在中央对着坚固的大门，墙边排列着长木凳，其上挂着的是医生的阴暗肖像。原本有一条豪华的楼梯通往二楼，现在却已被瓦砾压断。透过高耸的窗户与窗外的铁栅栏，可以看到黄色的迷雾依旧在翻滚。"}
{"time": 1753110073, "type": "recv", "message_id": "1514608954", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "召唤几只小狗到处探路"}
{"time": 1753110211, "type": "recv", "message_id": "359884058", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"艾丽莎，能拜托你检查一下中间那张办公桌吗？\""}
{"time": 1753110309, "type": "recv", "message_id": "995721165", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你的狗狗探查道入口大厅通往许多地方，包括几道门，楼梯以及向东面通往急诊室的过道，尽管那已被大量的碎石所堵住。除了正门，所有的们都很容易被打开，与大多数房间不一样，这里的天花板有20尺高。 楼梯可以爬到10尺高的地方，但是瓦砾堵住了往上的路。在瓦砾之后没有任何东西"}
{"time": 1753110329, "type": "recv", "message_id": "1214103944", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "至于办公桌，没有什么特殊的"}
{"time": 1753110423, "type": "recv", "message_id": "236049460", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"这里似乎没什么东西...\""}
{"time": 1753110456, "type": "recv", "message_id": "752954783", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "推门去C6"}
{"time": 1753110633, "type": "recv", "message_id": "274169759", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你推门，发现这个房间是个图书室，书架与移动棚梯都积着灰尘，有着厚重书皮的阴沉的书满眼皆是。房间的中央有一张老旧的桌子，旁边环绕着一些令人不适的椅子。天花板上挂着铁枝吊灯。皮革与古书的气味弥漫在这个房间里，但其中也夹杂着野兽的气息。"}
{"time": 1753110671, "type": "recv", "message_id": "1132252328", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"图书馆?\"皱着眉，在里面随意翻找一番，重点看看桌子"}
