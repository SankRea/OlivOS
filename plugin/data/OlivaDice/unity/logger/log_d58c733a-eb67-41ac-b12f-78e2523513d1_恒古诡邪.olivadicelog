{"time": 1753030986, "type": "recv", "message_id": "607900323", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（解消是？）"}
{"time": 1753030997, "type": "recv", "message_id": "2031564942", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(送幻灵走啊"}
