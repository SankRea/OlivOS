{"time": 1753197290, "type": "recv", "message_id": "1504462036", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“看来外面还是没什么机会探索。”想起梦中的事，“走吧，回去洗澡。”"}
{"time": 1753197305, "type": "recv", "message_id": "1097786041", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "在关上门之前，你听到了外面传来了肠胃搅动般的巨大声响，而且隐隐约约看到了一个模糊的球状块体"}
{"time": 1753197350, "type": "recv", "message_id": "1703814484", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我们可以一起洗吗，奥契丝姐姐”伽薇期待的看着你"}
{"time": 1753197394, "type": "recv", "message_id": "1767611902", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“可以哦，枷薇也要好好洗一洗才行。来这边都不知道多久了。”"}
{"time": 1753197428, "type": "recv", "message_id": "1847742458", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那我们快走吧”伽薇拉起你的手朝营地跑去"}
{"time": 1753197490, "type": "recv", "message_id": "1984024300", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“不用那么急嘛。”被她拽着手，“今天要好好休息。”"}
{"time": 1753197638, "type": "recv", "message_id": "964838653", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯嗯，好吧”伽薇停下了奔跑，不过还是走的挺快的"}
{"time": 1753197679, "type": "recv", "message_id": "1956121629", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你们很快便回到了小教堂，现在正好是饭点"}
{"time": 1753197703, "type": "recv", "message_id": "1736224179", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“奥契丝和小伽薇回来了啊”温特热情的迎接了你们"}
{"time": 1753197765, "type": "recv", "message_id": "1972388692", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"从正厅到档案室一带我们已经全部探索过了。\""}
{"time": 1753197797, "type": "recv", "message_id": "572236710", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯....我们似乎是伯爵的人?但是完全没印象。\""}
{"time": 1753197799, "type": "recv", "message_id": "1504939417", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“辛苦你们了，没有受什么伤吧，我也是个牧师，如果你们受伤的话，可以找我帮忙”"}
{"time": 1753197859, "type": "recv", "message_id": "786114118", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那等我们逃出去之后，你们可以去瑟拉什摩爾看看”"}
{"time": 1753197860, "type": "recv", "message_id": "925136395", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...您要是会复原术的话，就再好不过了\""}
{"time": 1753197873, "type": "recv", "message_id": "1395517498", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（她只会次等复原术）"}
{"time": 1753197923, "type": "recv", "message_id": "1104562770", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（怎么说呢，她在原著里属于可入队的选项，所以等级你就当和你一样吧）"}
{"time": 1753197984, "type": "recv", "message_id": "1938730686", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(那就当她对我用了次等复原术吧)"}
{"time": 1753197994, "type": "recv", "message_id": "1175069366", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（好的）"}
{"time": 1753197997, "type": "recv", "message_id": "66948999", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"说起来，这边可以洗澡了吗？\""}
{"time": 1753198022, "type": "recv", "message_id": "1538977850", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"枷薇看上去有些迫不及待了。\"微微歪着脑袋，轻笑"}
{"time": 1753198031, "type": "recv", "message_id": "206034162", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“已经可以了，不过目前浴室的路还是被碎石挡住了，两位只能在洗衣房勉强凑合一下洗了”"}
{"time": 1753198058, "type": "recv", "message_id": "2070288173", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“对了，我这有一些换洗衣物送给两位了”"}
{"time": 1753198104, "type": "recv", "message_id": "513747685", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"感谢。\"低头看着自居沾满血迹的衣服，\"说起来有些无语，但其实大部分都是我自己的血\""}
{"time": 1753198216, "type": "recv", "message_id": "627819909", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯，算了。\"接过衣服去洗衣房"}
{"time": 1753198246, "type": "recv", "message_id": "175523474", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“辛苦二位了，我们所有人会感激你们的付出的”"}
{"time": 1753198378, "type": "recv", "message_id": "1005679362", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没事啦...\"进洗衣服，关上房门背靠着房门终于松了口气"}
{"time": 1753198391, "type": "recv", "message_id": "577305041", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好累..\""}
{"time": 1753198504, "type": "recv", "message_id": "1698934942", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“奥契丝姐姐也可以更多的依赖我一些的”枷薇说到"}
{"time": 1753198633, "type": "recv", "message_id": "151106363", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"主要是和他们说话，一直感觉好麻烦。\"靠着房门坐下"}
{"time": 1753198660, "type": "recv", "message_id": "382667797", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那....之后我来和他们聊吧...”"}
{"time": 1753198750, "type": "recv", "message_id": "1701813210", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嘛，这种事还是我来吧，枷薇...不用勉强自己。\"解掉发绳"}
{"time": 1753198754, "type": "recv", "message_id": "1639411455", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"洗澡吧。\""}
{"time": 1753198809, "type": "recv", "message_id": "1495017665", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“只要能帮奥契丝姐姐分忧的话....”"}
{"time": 1753198817, "type": "recv", "message_id": "1138430082", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "枷薇也开始逐渐脱掉衣服"}
{"time": 1753198862, "type": "recv", "message_id": "682877713", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（但是我是不会帮你交涉的（）"}
{"time": 1753198866, "type": "recv", "message_id": "2143218210", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我知道)"}
{"time": 1753198893, "type": "recv", "message_id": "322195227", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "脱掉沾了血污的裙子，看看这边是怎么防水的"}
{"time": 1753198898, "type": "recv", "message_id": "1227030670", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(放)"}
{"time": 1753198899, "type": "recv", "message_id": "1512637760", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（话说b7你居然没有去看看）"}
{"time": 1753198921, "type": "recv", "message_id": "875586153", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "有三个闸，一个放冷水，一个放热水，一个放温水"}
{"time": 1753199062, "type": "recv", "message_id": "272658390", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呼...虽然没有香皂之类的了，也没有木桶泡澡...但能洗个澡已经不错了。\""}
{"time": 1753199116, "type": "recv", "message_id": "1543213898", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯嗯，尤其的可以和奥契丝姐姐一起洗”"}
{"time": 1753199138, "type": "recv", "message_id": "1634425715", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "说完枷薇就摸了一下你的背“奥契丝姐姐皮肤真好啊”"}
{"time": 1753199224, "type": "recv", "message_id": "1128631745", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"枷薇也很好啦。\"调着热水，\"有点痒啦枷薇\""}
{"time": 1753199449, "type": "recv", "message_id": "1954930147", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（洗澡要详细描述吗）"}
{"time": 1753199497, "type": "recv", "message_id": "554330181", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你感觉到后背有什么软软的东西贴了上来“我们可以一直在一起吗，奥契丝姐姐”"}
{"time": 1753199505, "type": "recv", "message_id": "1137511912", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（一休？）"}
{"time": 1753199522, "type": "recv", "message_id": "1099379047", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶?现在的话当然是在一起啦。\""}
{"time": 1753199552, "type": "recv", "message_id": "1894578531", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"以后...唔...我也不知道呢，枷薇。\""}
{"time": 1753199604, "type": "recv", "message_id": "347302319", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“这样吗.....”有些失望，不过很快便调整过来“不过奥契丝姐姐说的对，至少我们现在还在一起”"}
{"time": 1753199723, "type": "recv", "message_id": "1613864884", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯，要拉钩吗？\"没转过身，散开头发，往后伸出小拇指，\"约定在一起?\""}
{"time": 1753199743, "type": "recv", "message_id": "1718991912", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好啊”枷薇伸出小拇指"}
{"time": 1753199838, "type": "recv", "message_id": "1059616643", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"现在能安心了吗？小枷薇?\""}
{"time": 1753199871, "type": "recv", "message_id": "1896129566", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好好洗个澡吧。\"调好水温，似乎只能淋浴的样子"}
{"time": 1753199890, "type": "recv", "message_id": "1350660034", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯，奥契丝姐姐最好了”从后面用脸蹭蹭你的脸"}
{"time": 1753199910, "type": "recv", "message_id": "1412427869", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:image,file=78ECFE5547835A3E4925225E956C5D8D.jpg,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhTp2oCwyC-lwnmzSiVVE3wfK0I9WBi79gEg_wooqo3czurQjgMyBHByb2RQgL2jAVoQ6BeB3FFKIHLjYATHrXOMEHoC6IA&amp;rkey=CAESMHNTlHjQqpQaby33GbuOwf0bAQ1Dy8SP7rgPAAkDqecyRfromkOrgcUAgGbsCvw6dw,file_size=31547]"}
{"time": 1753199916, "type": "recv", "message_id": "2077005993", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（yln哥哥最坏了（）"}
{"time": 1753200054, "type": "recv", "message_id": "35783731", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(好的)"}
{"time": 1753200163, "type": "recv", "message_id": "6126810", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1350660034]\"快点洗啦。\"打开水阀淋浴，\"呼...清爽多了\""}
{"time": 1753200480, "type": "recv", "message_id": "561992780", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...”"}
{"time": 1753200494, "type": "recv", "message_id": "443142961", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "那么你们二人一起洗了澡，然后就回去睡觉了"}
{"time": 1753200525, "type": "recv", "message_id": "1999865665", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（save还是继续，我都行）"}
{"time": 1753200558, "type": "recv", "message_id": "1027762881", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "摸摸自己干爽的头发，心情顿时好了很多，靠着床头，“现在要摸摸吗？我可是很自信我的头发的”"}
{"time": 1753200669, "type": "recv", "message_id": "339767020", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“可以吗”然后枷薇摸了摸你的脸"}
{"time": 1753200674, "type": "recv", "message_id": "1067791432", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好软啊”"}
{"time": 1753200786, "type": "recv", "message_id": "1983519315", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“诶？我明明说的是头发吧？怎么摸我的脸啦。”"}
{"time": 1753200933, "type": "recv", "message_id": "767641193", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "摇摇脑袋尝试把她的手甩掉，“快去睡觉，睡觉啦。”"}
{"time": 1753201005, "type": "recv", "message_id": "289855038", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好吧，晚安oh，奥契丝姐姐”"}
{"time": 1753201051, "type": "recv", "message_id": "685809943", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“嗯，晚安。枷薇。”看着她躺下去，靠着床头沉思"}
{"time": 1753201176, "type": "recv", "message_id": "646195261", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "对于迄今为止发生的一切有些不可思议，感觉还是有些无法接受，靠着床有些睡不着。"}
{"time": 1753201273, "type": "recv", "message_id": "1452876643", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "枷薇面对着你，装睡，实际一直在偷看你"}
{"time": 1753201360, "type": "recv", "message_id": "1711822816", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（第二天？）"}
{"time": 1753201368, "type": "recv", "message_id": "1409265945", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（该探索d了）"}
{"time": 1753201405, "type": "recv", "message_id": "110381543", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“好好睡觉啦。”拍一拍枷薇的脑袋，紧接着自己也钻进被窝"}
{"time": 1753201458, "type": "recv", "message_id": "1292569682", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哎，被发现了”枷薇尴尬的笑了笑"}
{"time": 1753201506, "type": "recv", "message_id": "2068949994", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "在德丝娜的保佑下，你又睡了个好觉"}
{"time": 1753201518, "type": "recv", "message_id": "1781493569", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（起床喵）"}
{"time": 1753201541, "type": "recv", "message_id": "848114580", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "睁开眼，盘算着今天要去哪里，暂时没有动"}
{"time": 1753201556, "type": "recv", "message_id": "472076755", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你一醒来就看见枷薇坐在你的床边，低头盯着你看"}
{"time": 1753201565, "type": "recv", "message_id": "1942125127", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“早上好，奥契丝姐姐”"}
{"time": 1753201627, "type": "recv", "message_id": "281172678", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“早上好，醒的这么早吗？”抬头看着她"}
{"time": 1753201768, "type": "recv", "message_id": "38884442", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“因为我想让奥契丝姐姐醒来第一眼看到的就是我”"}
{"time": 1753201894, "type": "recv", "message_id": "1265543828", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“诶，那也不用这么勉强自己吧？”伸出手掐掐她的脸，顺势起床，拿出发带开始绑起来"}
{"time": 1753201908, "type": "recv", "message_id": "2008646817", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我休息的很好的”"}
{"time": 1753202048, "type": "recv", "message_id": "935054649", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“好吧，为了证明这一点，帮我绑一下发带？”"}
{"time": 1753202077, "type": "recv", "message_id": "615191723", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好啊”"}
{"time": 1753202086, "type": "recv", "message_id": "1306685959", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“这不是简简单单么”"}
{"time": 1753202098, "type": "recv", "message_id": "104781042", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "枷薇很轻松的就帮你绑上了发带"}
{"time": 1753202237, "type": "recv", "message_id": "730106789", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“那么，待会就出发吧。”换上衣服，同时带上黄色的两套衣服，“今天也要打起精神来”"}
{"time": 1753202249, "type": "recv", "message_id": "3126023", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（回复完就sv了吧，明天早起）"}
{"time": 1753202257, "type": "recv", "message_id": "521566856", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（好的）"}
{"time": 1753202262, "type": "recv", "message_id": "1736804549", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那出发”"}
{"time": 1753202272, "type": "recv", "message_id": "394750876", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": ".log off"}
