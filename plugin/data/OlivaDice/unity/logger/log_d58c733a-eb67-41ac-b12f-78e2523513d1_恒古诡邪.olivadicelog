{"time": 1753033393, "type": "recv", "message_id": "1118348798", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（厉害）"}
{"time": 1753033432, "type": "recv", "message_id": "1535762948", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你和枷薇睡了过去，晚上好像又做了什么梦，但你们不太记得了，只记得依旧有一片黄色的雾"}
{"time": 1753033484, "type": "recv", "message_id": "1233041699", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“...又是这黄色的大雾...”"}
{"time": 1753033585, "type": "recv", "message_id": "1835830145", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "捂着脑袋起床，搂了搂枷薇，“早上好”"}
{"time": 1753033655, "type": "recv", "message_id": "2113286405", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“奥契丝姐姐，早上好，昨晚好像又做噩梦了，好像梦见一个疯子？”"}
{"time": 1753033661, "type": "recv", "message_id": "1123859519", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“记不太清了..n”"}
{"time": 1753033676, "type": "recv", "message_id": "787225537", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我记得有一片黄色的雾...别的都不记得了”"}
{"time": 1753033702, "type": "recv", "message_id": "289454086", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...好奇怪啊”"}
{"time": 1753033761, "type": "recv", "message_id": "1683476395", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“嗯..暂时别想了，今天还有些事要忙。”"}
{"time": 1753033781, "type": "recv", "message_id": "65437831", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯....出发吧”"}
{"time": 1753033868, "type": "recv", "message_id": "124497501", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "把幻灵呼唤出来"}
{"time": 1753033901, "type": "recv", "message_id": "369036867", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "随后你们召唤出幻灵，然后和约克简单告别后，便来到了洗衣房门口"}
{"time": 1753033903, "type": "recv", "message_id": "2030267404", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "去西北边的洗衣房，在门口的时候，“我们先把加护加上吧，感觉里面的怪物也许有些强。”想起那些人有些害怕的样子"}
{"time": 1753033925, "type": "recv", "message_id": "1187532331", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯，奥契丝姐姐想的真周到”"}
{"time": 1753033993, "type": "recv", "message_id": "655426485", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“那就”"}
{"time": 1753034014, "type": "recv", "message_id": "1802815581", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "两个法师护甲，魔牙，给真红贴一个反邪"}
{"time": 1753034042, "type": "recv", "message_id": "873498931", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "祝福术，魔化武器，神恩，顺便贴好神导术"}
{"time": 1753034077, "type": "recv", "message_id": "118897064", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“枷薇，不管待会发生什么，出事了你一定要逃走。”摸摸脑袋，“我会为你断后。”"}
{"time": 1753034118, "type": "recv", "message_id": "740412027", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不要说这种话...我会永远和奥契丝姐姐在一起的，永远...”"}
{"time": 1753034157, "type": "recv", "message_id": "291307365", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "敲敲脑袋，“死了的话，你就走得远远的啦。记得哦”"}
{"time": 1753034175, "type": "recv", "message_id": "1255333345", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“走吧”"}
{"time": 1753034178, "type": "recv", "message_id": "1515202921", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "推开门"}
{"time": 1753034262, "type": "recv", "message_id": "1393132971", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“虽然不知道为什么，但能请你去死吗？变形怪先生。”"}
{"time": 1753034268, "type": "recv", "message_id": "811613926", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你进到房间内，看到一个医生装扮的人踩着折叠梯，在向一个水池里扔肉块"}
{"time": 1753034305, "type": "recv", "message_id": "1825888843", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哎？好暴躁的客人啊，不如你来当我的试验品吧，我会把你变成非常漂亮的食尸鬼的”医生说到"}
{"time": 1753034327, "type": "recv", "message_id": "1614274837", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“可恶的家伙，等死吧..”枷薇有些生气"}
{"time": 1753034349, "type": "recv", "message_id": "1260704109", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“你这家伙还真是毫无品味，作为变形怪而言是不是有些不雅观了？”"}
{"time": 1753034364, "type": "recv", "message_id": "1351122436", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“果然我更欣赏半变形怪一些”"}
{"time": 1753034373, "type": "recv", "message_id": "66083386", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": ".init clear"}
