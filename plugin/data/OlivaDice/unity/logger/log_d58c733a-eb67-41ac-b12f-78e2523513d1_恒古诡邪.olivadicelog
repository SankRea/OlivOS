{"time": 1753188836, "type": "recv", "message_id": "1828811466", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(没附魔搞这么帅)"}
{"time": 1753188844, "type": "recv", "message_id": "259101531", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（没了（））"}
{"time": 1753189028, "type": "recv", "message_id": "543163197", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "收起这些东西，\"研究...说实话奥契丝已经搞不明白了。\""}
{"time": 1753189194, "type": "recv", "message_id": "715447687", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"有点累...\""}
{"time": 1753189196, "type": "recv", "message_id": "503061406", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我也不太懂....”"}
{"time": 1753189206, "type": "recv", "message_id": "837135320", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"今天把最后一个房间看一下就离开吧。\""}
{"time": 1753189227, "type": "recv", "message_id": "1308128738", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不过疗养院的事情看起来应该和那个叫赞达鲁斯的家伙有关吧”"}
{"time": 1753189288, "type": "recv", "message_id": "1125616913", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（c19?）"}
{"time": 1753189294, "type": "recv", "message_id": "103359074", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...不过这家伙现在还不知道在哪，感觉之后会遇见。\""}
{"time": 1753189319, "type": "recv", "message_id": "532324171", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"啊...今天不仅要洗澡，这衣服...\"皱着眉，\"我也没有带换洗的衣服。\""}
{"time": 1753189322, "type": "recv", "message_id": "767609462", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(对)"}
{"time": 1753189356, "type": "recv", "message_id": "1117833352", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "\"温特姐姐说不定有多余的衣服，可以问问她看\""}
{"time": 1753189621, "type": "recv", "message_id": "1583453643", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯，先去最后一个房间看看吧。\""}
{"time": 1753189625, "type": "recv", "message_id": "1138489308", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(c19)"}
{"time": 1753189673, "type": "recv", "message_id": "719296984", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "那么c19被彻底压塌了，进不去"}
{"time": 1753189722, "type": "recv", "message_id": "851458476", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（进不去desuwa）"}
{"time": 1753189785, "type": "recv", "message_id": "1431188830", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(好的)"}
{"time": 1753189793, "type": "recv", "message_id": "156510895", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"这样的话，今天似乎可以回去了。\""}
{"time": 1753189798, "type": "recv", "message_id": "1074368510", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"去看看那只小老鼠还在不在吧\""}
{"time": 1753189899, "type": "recv", "message_id": "328135344", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "\"嗯..回去可以和奥契丝姐姐一起洗澡了\""}
{"time": 1753189955, "type": "recv", "message_id": "608487432", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好多天没洗过澡，累了累了。\"眯眯眼，\"亚里莎，抱我回去。\""}
{"time": 1753189966, "type": "recv", "message_id": "1974867920", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "那你又回到了图书馆，亚里沙抱着你"}
{"time": 1753189976, "type": "recv", "message_id": "1366606128", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（懒狗）"}
{"time": 1753190116, "type": "recv", "message_id": "874230281", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(懒是对的)"}
{"time": 1753190124, "type": "recv", "message_id": "1033450512", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我今天掉了两个自己这么多血了)"}
{"time": 1753190155, "type": "recv", "message_id": "1952590316", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "那么你回到图书馆的时候，发现小老鼠还在这里"}
{"time": 1753190382, "type": "recv", "message_id": "1246106078", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哈喽，忘了叫什么的小老鼠。\""}
{"time": 1753190468, "type": "recv", "message_id": "1016745865", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我是詹妮·双尾”老鼠抬头看了眼你“怎....怎么是你，你不会反悔了吧...”"}
{"time": 1753190609, "type": "recv", "message_id": "353464265", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"有点后悔哦\""}
{"time": 1753190626, "type": "recv", "message_id": "1149615009", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“别...别杀我...”"}
{"time": 1753190681, "type": "recv", "message_id": "57767798", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我在想，你以后要不要跟着我?\""}
{"time": 1753190701, "type": "recv", "message_id": "84802485", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“跟着你很危险吧...我只想安安静静的生活下去..”"}
{"time": 1753190717, "type": "recv", "message_id": "1819151178", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"还好吧，你不想看看外面的风景?\""}
{"time": 1753190738, "type": "recv", "message_id": "721838323", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不想...我只想跟着老大重回地底”"}
{"time": 1753190852, "type": "recv", "message_id": "770084693", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好吧，但是在这个设施内，能不能跟着我?\""}
{"time": 1753191012, "type": "recv", "message_id": "2017856203", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“可是，可是，真的好危险啊，我给你讲个我以前听过的故事，你不要让我跟着了，好不好，大姐姐”"}
{"time": 1753191128, "type": "recv", "message_id": "869625915", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好吧，你说说看\""}
{"time": 1753191385, "type": "recv", "message_id": "302650052", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "\"你有没有做过噩梦，梦里有个布条人\""}
{"time": 1753191514, "type": "recv", "message_id": "558700428", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"有的有的。\""}
{"time": 1753191574, "type": "recv", "message_id": "1099073483", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那东西很久以前侍奉过棘石女巫“他不自主的看一下身后，再用近乎微不可闻的声量说“也是黄衣之王的仆从”"}
{"time": 1753191632, "type": "recv", "message_id": "1492863440", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“而且最恐怖的是它那充满恶意的双眼盯上了谁谁就死定了，许多在睡梦中离世的患者都是被布条人杀的”"}
{"time": 1753191790, "type": "recv", "message_id": "550617927", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯....\""}
{"time": 1753191794, "type": "recv", "message_id": "1992385420", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"梦中杀人吗？\""}
{"time": 1753192013, "type": "recv", "message_id": "2014697728", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "\"是的是的，非常的恐怖\""}
{"time": 1753192026, "type": "recv", "message_id": "1958370425", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呃，我其实在梦里被杀过一次了。\""}
{"time": 1753192198, "type": "recv", "message_id": "317596343", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“啊这....”"}
{"time": 1753192216, "type": "recv", "message_id": "1701381336", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“可能..可能要杀好几次才行”"}
{"time": 1753192290, "type": "recv", "message_id": "1671541743", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哼，你还不如跟着我呢？\"咯咯笑，\"我那边有艾奥梅黛守护，晚上不会有雾气入梦\""}
{"time": 1753192309, "type": "recv", "message_id": "778487515", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（是德丝娜的守护...）"}
{"time": 1753192419, "type": "recv", "message_id": "1120590892", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我..我不去...”"}
{"time": 1753192476, "type": "recv", "message_id": "810360679", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（你有什么想搜的方向都可以在图书馆找对应的书）"}
{"time": 1753192485, "type": "recv", "message_id": "2129905163", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶，有梦女神德斯娜的守护也不去吗？\""}
{"time": 1753192509, "type": "recv", "message_id": "1414074275", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "在这里搜索一下有没有与黄衣信徒有关的书籍，还有梦中怪物的书籍"}
{"time": 1753192575, "type": "recv", "message_id": "605093018", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "老鼠摇了摇头，然后在你找书的时候离开了"}
{"time": 1753192627, "type": "recv", "message_id": "1482495314", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "关于黄衣信徒你没有找到相关的记载，不过褴褛者，你倒是找到了一点点，民间传说将许多失踪事件和瑟拉什摩爾发生的坏事都归咎于棘石女巫，一位据说住在棘石岛的神出鬼没的老婆婆。第一次出现棘石女巫的传言是在4000年代的前期，从建立瑟拉什摩爾的崇拜心理学的农民口中传出的。这些故事把许多功绩都归于女巫名下并将她视作帮助定居者渡过最艰难的时期的人物。有些传说还提到了女巫的仆从，褴褛者"}
{"time": 1753192830, "type": "recv", "message_id": "857513958", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...女巫?这倒是没听说过的人。\""}
{"time": 1753192846, "type": "recv", "message_id": "669156477", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "在图书馆里找一找女巫之事，似乎是本地传说"}
{"time": 1753192929, "type": "recv", "message_id": "639469345", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "棘石女巫并非传说。她是一个对鲜为人知的邪教和神秘知识感兴趣的卡利德人。她与瑟拉什摩爾的居民分享她的知识并加入他们，在展现了她的力量之后她成为了他们的领袖。但在4050年，一位法莱斯玛的检察官德保高中谴责瑟拉什摩爾的居民“在仪式中嘲笑法莱斯玛和她的仆从的名字”。在棘石女巫的鼓舞下，瑟拉什摩爾的人民从教会和政府手中分裂了出去。但当国家的军队为了夺回这片土地而来到这里时却发现所有人都失踪了。尽管空荡荡的小镇里的建筑有一些令人毛骨悚然的痕迹，但却没有任何人的踪迹。这令人不安的事件被称为瑟拉什摩爾失踪事件，在数百年之后才有人敢再到此地定居。"}
{"time": 1753193137, "type": "recv", "message_id": "766091691", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"啧...\"收起这些书，\"今天就到此为止吧，回去休息了。\""}
{"time": 1753193141, "type": "recv", "message_id": "966410011", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"说实话还是没搞清楚。\""}
