{"time": 1753002862, "type": "recv", "message_id": "559142894", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯”"}
{"time": 1753002878, "type": "recv", "message_id": "1798455066", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "那你来到了走廊"}
{"time": 1753002895, "type": "recv", "message_id": "1200711888", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。rd3"}
{"time": 1753002895, "type": "reply", "message_id": "1200711888", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[桃乐丝]演奏出: 1D3=2"}
{"time": 1753002912, "type": "recv", "message_id": "419413756", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "让两只狗往走廊上面探路"}
{"time": 1753003014, "type": "recv", "message_id": "1223581380", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "两只狗顺着走廊一直向北边走，尽头已经完全坍塌，只余一片灰色的碎石。只有偶尔卵石滚动发出哗啦响声让这片土丘听上去还不是一片死寂，但更多的碎石可能在任何时候崩塌。还屹立着的门通往西面和东面的通道。"}
{"time": 1753003084, "type": "recv", "message_id": "1125038028", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "先往西边走，\"这里怎么倒塌成这样...\""}
{"time": 1753003203, "type": "recv", "message_id": "656815880", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（先off吧，我吃个饭）"}
{"time": 1753003211, "type": "recv", "message_id": "1533493067", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(好的)"}
{"time": 1753003216, "type": "recv", "message_id": "370927640", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": ".log off"}
{"time": 1753009848, "type": "reply", "message_id": "60019700", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "继续记录乐谱"}
{"time": 1753009852, "type": "recv", "message_id": "931587679", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "坚固的架子与翻倒的桌子都在昭示这里曾是一个相当大的洗衣房。房间的北部几乎都堆满了碎石。"}
{"time": 1753009880, "type": "recv", "message_id": "313760905", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "走进屋内，“这里以前是什么生活设施吗？"}
{"time": 1753009883, "type": "recv", "message_id": "2088023806", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "房间西边的凹室里布满了管状的梁木。三个有着人形的东西被捆在架子上，从南到北来看分别是 一个穿着黄色长袍的人，其前额上还用粉笔画了一个火焰形状的标记；一个被吃掉了一部分的病人尸体；还有一只食尸鬼。"}
{"time": 1753010015, "type": "recv", "message_id": "1256639306", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "最右边的食尸鬼一直摇来摇去来吃着中间的尸体，最左边的人一直在挣扎"}
{"time": 1753010044, "type": "recv", "message_id": "1061441261", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "看见你之后，嘴里一直嘟囔着“赞美！赞美！”"}
{"time": 1753010058, "type": "recv", "message_id": "1845027224", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“嘶...这里居然还有理智清醒的人吗？”听完他的话，“算了，似乎也不怎么清醒”"}
{"time": 1753010108, "type": "recv", "message_id": "1351496515", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "食尸鬼听了你的话，看了你一眼，然后继续去啃尸体了"}
{"time": 1753010128, "type": "recv", "message_id": "1694942999", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“你是什么人？”质问黄衣男人"}
{"time": 1753010170, "type": "recv", "message_id": "586358316", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“赞美！无言！”他嘴里嘟囔着这些怪话"}
{"time": 1753010207, "type": "recv", "message_id": "201985737", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好像是个精神病”伽薇有点嫌弃的看着他"}
{"time": 1753010225, "type": "recv", "message_id": "686936970", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“这家伙真的能沟通吗？”拿木棍捅捅他"}
{"time": 1753010291, "type": "recv", "message_id": "702113656", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“赞美！赞达鲁斯看！”虽然他说的话让人听不懂，不过从他的眼神和动作可以看出他挺想让你把他救出去的"}
{"time": 1753010344, "type": "recv", "message_id": "408876520", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那家伙就是个疯子，之后会成为我的食物”旁边的食尸鬼看见你试图和那家伙沟通说到，然后继续去啃尸体了"}
{"time": 1753010375, "type": "recv", "message_id": "1422389909", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“想要我救你，就不要说一些乱七八糟的话。”看见马头被捆着的样子，“你有在说什么？”皱眉"}
{"time": 1753010398, "type": "recv", "message_id": "909102368", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "尸体鬼没有理你，继续在啃尸体"}
{"time": 1753010408, "type": "recv", "message_id": "1029434935", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（可以过个dc14的交涉）"}
{"time": 1753010441, "type": "recv", "message_id": "732357267", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。rd+7"}
{"time": 1753010441, "type": "reply", "message_id": "732357267", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[桃乐丝]演奏出: 1D20+7={9}+7=16"}
{"time": 1753010482, "type": "recv", "message_id": "1141965706", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“这里是哪里？马头先生。”"}
{"time": 1753010495, "type": "recv", "message_id": "2045202713", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“如果你能告诉我一些事情，这家伙我就留给你当食物了”"}
{"time": 1753010525, "type": "recv", "message_id": "84249618", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“这里是疗养院啊，我们一起都是这的病人，我叫Argade”"}
{"time": 1753010532, "type": "recv", "message_id": "1214055036", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（以前）"}
{"time": 1753010638, "type": "recv", "message_id": "1796795331", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“疗养院？那你认识我？”"}
{"time": 1753010659, "type": "recv", "message_id": "1951089544", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“你谁啊？”"}
{"time": 1753010676, "type": "recv", "message_id": "1466240589", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“你不认识我，我以前不在吗？嗯...”"}
{"time": 1753010685, "type": "recv", "message_id": "205479797", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“那我为什么会在这里。”"}
{"time": 1753010708, "type": "recv", "message_id": "1322239792", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“你脑子有病吧，我都不认识你，怎么可能知道”"}
{"time": 1753010710, "type": "recv", "message_id": "1042625983", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“居然敢这样和奥契丝姐姐说话，给我放尊重点”伽薇有些生气"}
{"time": 1753010775, "type": "recv", "message_id": "811819461", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“嗯...那你为什么被绑着？”伸手安抚一下枷薇"}
{"time": 1753010830, "type": "recv", "message_id": "1358114220", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我们被变形怪俘虏了，他不知道对我们做了什么，把我们变成了食尸鬼，不过这都不重要了，我现在只想把他们两个吃了”马头贪婪地看着旁边那两个人"}
{"time": 1753010843, "type": "recv", "message_id": "1933912194", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“无言！无言！”"}
{"time": 1753010873, "type": "recv", "message_id": "1999761045", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "那个穿道袍的人焦急的喊着"}
{"time": 1753010880, "type": "recv", "message_id": "360484476", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“呵...那你就继续在这里待着吧。”看向那个黄衣人，“你呢，有什么想说的吗？”"}
{"time": 1753010909, "type": "recv", "message_id": "102292620", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“赞美！赞美！”他用乞求的眼神看着你"}
{"time": 1753010999, "type": "recv", "message_id": "1325367233", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“嗯...亚里莎，把她放下来吧。”"}
{"time": 1753011035, "type": "recv", "message_id": "420306420", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“遵命”然后亚里沙把那个道士放了下来"}
{"time": 1753011066, "type": "recv", "message_id": "1100274554", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“赞美，赞美”那道士塞了三幅镣铐送给了你"}
{"time": 1753011114, "type": "recv", "message_id": "66210471", "deleted": true, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“你之后打算做什么？”想了想，“你可以歇下来”"}
{"time": 1753011121, "type": "recv", "message_id": "1005314297", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“你之后打算做什么？”想了想，“你可以写下来”"}
{"time": 1753011159, "type": "recv", "message_id": "1053837278", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "然后那道士就一溜烟跑了"}
{"time": 1753011187, "type": "recv", "message_id": "1974823479", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“诶这家伙...”索性也不想理他，“马头先生，我想起一件好事。”"}
{"time": 1753011194, "type": "recv", "message_id": "1919020734", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "马头有些生气的看着你，不过很快就不管你了，继续啃尸体去了"}
{"time": 1753011203, "type": "recv", "message_id": "1815832845", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“把尸体也放下来吧，亚里莎”"}
{"time": 1753011235, "type": "recv", "message_id": "1039853806", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "那尸体的一只手已经被啃光了，随后被亚里沙放了下来"}
{"time": 1753011248, "type": "recv", "message_id": "2023607585", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“可恶的人类，你这家伙”马头看起来很生气的样子"}
{"time": 1753011286, "type": "recv", "message_id": "1454982044", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“你就在这里，别吃别吃吧。”检查一下尸体"}
{"time": 1753011315, "type": "recv", "message_id": "1053494951", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你发现其中一个口袋里的脏手绢包着一个奇怪的东西"}
{"time": 1753011326, "type": "recv", "message_id": "43067434", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "一个硬币大小的眼球，其瞳孔是X形的"}
{"time": 1753011335, "type": "recv", "message_id": "1941631527", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“眼球？这是什么”"}
{"time": 1753011359, "type": "recv", "message_id": "285790702", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不知道，看起来好邪门”伽薇说到"}
{"time": 1753011378, "type": "recv", "message_id": "165494932", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "如果放置在平坦的地方它会随机向一个方向缓慢滚动。眼球内的薄膜每隔几分钟就会眨动一下，并且瞳孔会自己转向持有者的方向与其对视。眼球没有明显的功能，但若是出于好奇可能会有人出250gp买下它"}
{"time": 1753011380, "type": "recv", "message_id": "1424075519", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "拿起来检查一下，“马头，你认识这个吗？”"}
{"time": 1753011396, "type": "recv", "message_id": "2128029027", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "马头生气的看着你，想要咬你"}
{"time": 1753011436, "type": "recv", "message_id": "1833210622", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“哎呀哎呀，看来说教无益。”心念所至，让亚里莎举起弓对准马头"}
{"time": 1753011544, "type": "recv", "message_id": "1573115809", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "马头两眼通红的看着你"}
{"time": 1753011553, "type": "recv", "message_id": "181185536", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“嗯，看来只有放点血了。”"}
{"time": 1753011576, "type": "recv", "message_id": "1107939550", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“多说无益，你刚刚居然那样对奥契丝姐姐说话，真红咬他！”"}
{"time": 1753011601, "type": "recv", "message_id": "458111851", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“诶，算了，也行吧。”"}
{"time": 1753011613, "type": "recv", "message_id": "1483422940", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。r2d8+8"}
{"time": 1753011613, "type": "reply", "message_id": "1483422940", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[桃乐丝]演奏出: 2D8+8={1+8}(9)+8=17"}
{"time": 1753011626, "type": "recv", "message_id": "915195064", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。r2d6+9+1d4"}
{"time": 1753011626, "type": "reply", "message_id": "915195064", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[桃乐丝]演奏出: 2d6+9+1d4={4+6}(10)+9+{3}=22"}
{"time": 1753011710, "type": "recv", "message_id": "1208014051", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“可惜，太便宜他了。”"}
{"time": 1753011730, "type": "recv", "message_id": "209038186", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "收起眼球，摸摸枷薇的脑袋，“走吧，我们去东边看看。”"}
{"time": 1753011731, "type": "recv", "message_id": "1481393108", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "\"真是恶心的生物...”"}
