{"time": 1753031005, "type": "recv", "message_id": "877221026", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（好的）"}
{"time": 1753031049, "type": "recv", "message_id": "538502378", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“目前并没有解毒的手段...”有些头疼，“我们回之前的房间，找个安全的地方休息一下”"}
{"time": 1753031098, "type": "recv", "message_id": "1711317251", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "至于在储藏室，你找到了一个提灯，一把锤子和5条冬用毛毯，10尺的铁链，一条加值5gp的老旧银项链。"}
{"time": 1753031112, "type": "recv", "message_id": "724839519", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯，伽薇都听奥契丝姐姐的”"}
{"time": 1753031139, "type": "recv", "message_id": "604749439", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "当你们出储藏室的时候，你看到了在南方好像有两个人"}
{"time": 1753031176, "type": "recv", "message_id": "516583570", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“...”远远看一眼，没有幻灵的现在，做事得小心谨慎一些"}
{"time": 1753031237, "type": "recv", "message_id": "1989456050", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "对面似乎也注意到了你们"}
{"time": 1753031253, "type": "recv", "message_id": "1400553996", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "拉着枷薇往后退"}
{"time": 1753031271, "type": "recv", "message_id": "1157299220", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "两名警卫拿弩箭对准你们“这里！我发现他们了！不许靠近这里！快点后退，你们这群怪物”"}
{"time": 1753031334, "type": "recv", "message_id": "481058923", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "闻言直接跑起来"}
{"time": 1753031346, "type": "recv", "message_id": "2032573533", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（刚刚北面是有一个缝隙是吧）"}
{"time": 1753031351, "type": "recv", "message_id": "2030951697", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（不交涉一下？）"}
{"time": 1753031355, "type": "recv", "message_id": "1353311030", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=2032573533]（是的）[CQ:at,qq=1252219916]"}
{"time": 1753031398, "type": "recv", "message_id": "2111589495", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（总之看你吧）"}
{"time": 1753031401, "type": "recv", "message_id": "374136063", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“别射箭，我们是正常人。”一边跑一边开口"}
{"time": 1753031425, "type": "recv", "message_id": "2106006054", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“谁知道呢”对方并没有射箭，看起来只是在威慑你们"}
{"time": 1753031474, "type": "recv", "message_id": "753886602", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "随后从那边的房间里走出一个人，看起来像是他们的牢大"}
{"time": 1753031480, "type": "recv", "message_id": "1377946414", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“有证明的办法吗？”皱着眉，跑到裂缝下面"}
{"time": 1753031534, "type": "recv", "message_id": "404373398", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“陌生人，我不想射杀你们，快走吧...这个地方有太多的变形怪，我们不能确定你是不是真的幸存者”"}
{"time": 1753031583, "type": "recv", "message_id": "1561287959", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“变形怪....我知道，我们刚刚才干掉两个。”"}
{"time": 1753031634, "type": "recv", "message_id": "1043066063", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“抱歉...我不太清楚这里是哪，能大致说一下这里发生了什么吗？我保证不靠近。”举起双手"}
{"time": 1753031701, "type": "recv", "message_id": "221896429", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“真的吗？”对方沉思了一会，叹了口气“过去的几天，我看到了太多的死亡与无法解释的事情，我不知道你说话的真假，北方的洗衣房里有一只变形怪，如果你可以带回他的尸体，我就会相信你，对不起小姐”"}
{"time": 1753031762, "type": "recv", "message_id": "603155501", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（那个我不是已经干掉了吗）"}
{"time": 1753031772, "type": "recv", "message_id": "2076430634", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（你干掉的是另一只）"}
{"time": 1753031779, "type": "recv", "message_id": "1445281082", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“洗衣房？”"}
{"time": 1753031785, "type": "recv", "message_id": "901631135", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（他说的西北方向，你干掉的是东北的）"}
{"time": 1753031917, "type": "recv", "message_id": "1587147552", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“唔...”"}
{"time": 1753031960, "type": "recv", "message_id": "160235919", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“好吧，但是今天的话有些勉强，请您见谅。我们刚刚从地下室逃出来，今天已经和四五波敌人交战过了”"}
{"time": 1753032014, "type": "recv", "message_id": "2145940253", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“emmm，哎两位可怜的小姐，这样吧，我可以让你们暂且在警卫室休息....不过你们不要有多余的动作...”"}
{"time": 1753032074, "type": "recv", "message_id": "1457572116", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“好的，感谢您。我原本以为要在这里找个地方讲究一下了。”"}
{"time": 1753032083, "type": "recv", "message_id": "1178397034", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "舒口气，拉着枷薇"}
{"time": 1753032369, "type": "recv", "message_id": "219857375", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你们被带到了房间的北部，约克嘱托你们“带你们进来已经是仁至义尽了..不要来到房间的南部”"}
{"time": 1753032561, "type": "recv", "message_id": "1127410993", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“好吧。”"}
{"time": 1753032565, "type": "recv", "message_id": "347805310", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（长休？）"}
{"time": 1753032571, "type": "recv", "message_id": "35651503", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "在这里寻找一下有没有床铺"}
{"time": 1753032656, "type": "recv", "message_id": "465178632", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "并没有，只有一些麻袋之类的东西"}
{"time": 1753032773, "type": "recv", "message_id": "82103682", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "找一些麻袋铺在身下，“唉...今晚凑合一下吧，枷薇”"}
{"time": 1753032791, "type": "recv", "message_id": "947662937", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...我不在意这些的”"}
{"time": 1753032962, "type": "recv", "message_id": "1216699318", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（off？还是把小boss打完升个级）"}
{"time": 1753032969, "type": "recv", "message_id": "1238215343", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（怎么打）"}
{"time": 1753032974, "type": "recv", "message_id": "1065974061", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（我现在幻灵都没了）"}
{"time": 1753032985, "type": "recv", "message_id": "78830124", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（哦，长休完可以打）"}
{"time": 1753032988, "type": "recv", "message_id": "1843979048", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（长休完去打么）"}
{"time": 1753032999, "type": "recv", "message_id": "79729711", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（可以）"}
{"time": 1753033083, "type": "recv", "message_id": "760325087", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "意志检定dc12"}
{"time": 1753033107, "type": "recv", "message_id": "251052456", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“嗯...是我对不起枷薇了。”"}
{"time": 1753033190, "type": "recv", "message_id": "1635349507", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“奥契丝姐姐为什么这么说...”枷薇直接上前抱住了你 “有奥契丝姐姐就足够了”"}
{"time": 1753033224, "type": "recv", "message_id": "1386558847", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“有你真好...枷薇”"}
