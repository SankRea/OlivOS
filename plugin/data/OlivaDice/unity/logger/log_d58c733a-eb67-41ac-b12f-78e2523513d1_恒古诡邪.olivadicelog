{"time": 1753113835, "type": "recv", "message_id": "109585511", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"办公室?\""}
{"time": 1753113868, "type": "recv", "message_id": "1835356982", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "这两名年轻的医生是死于后脑被攻击，而他们的腿被什么小而凶恶的东西啃咬过。头部的伤口似乎是细小的爪子造成的，并且直接挖到头盖骨"}
{"time": 1753113922, "type": "recv", "message_id": "283008614", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“...鼠？”"}
