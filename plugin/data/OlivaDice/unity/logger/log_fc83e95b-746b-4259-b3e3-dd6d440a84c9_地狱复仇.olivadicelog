{"time": 1765440147, "type": "recv", "message_id": "843051452", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(这是银龙，能说话的)"}
