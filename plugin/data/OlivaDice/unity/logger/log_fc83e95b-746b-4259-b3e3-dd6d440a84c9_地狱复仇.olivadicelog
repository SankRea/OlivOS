{"time": 1765509182, "type": "recv", "message_id": "773347480", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(虽然现在不是龙型)"}
