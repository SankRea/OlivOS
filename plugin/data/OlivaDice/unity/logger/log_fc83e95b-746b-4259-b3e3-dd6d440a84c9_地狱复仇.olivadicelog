{"time": 1765441077, "type": "recv", "message_id": "1110725926", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:image,file=4EF417EAFE7BDBB5373FC11D674AF69F.png,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhT_IIOiBPtjl7CIKneJC5AHHOihsxiFTiD_Ciio4OjBjLWRAzIEcHJvZFCAvaMBWhD80WJEXv12p4qukG_Y_P_LegLP9IIBAm5q&amp;rkey=CAMSMFbnRUufjv1VgomZvTbat1CsNsxL0og7dV0-H3VqNOyaQiiF_qSHzVH6VMOjSJjSJQ,file_size=9989]"}
