{"time": 1765469510, "type": "recv", "message_id": "354719277", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（妹妹和哥哥，不知道你会不会净化解击飞）"}
{"time": 1765469519, "type": "recv", "message_id": "403546492", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"看着她们动了嘴，这才点点头，\"梅梅，吃吧。\""}
{"time": 1765469522, "type": "recv", "message_id": "664088171", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（没事，我没有铁心）"}
