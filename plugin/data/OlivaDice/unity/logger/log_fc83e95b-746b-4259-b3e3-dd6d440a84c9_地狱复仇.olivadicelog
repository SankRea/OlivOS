{"time": 1765509211, "type": "recv", "message_id": "113935215", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（没事，走）"}
{"time": 1765509212, "type": "recv", "message_id": "1880660631", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我在想，她类人变成人的话，爪子能挠人吗)"}
{"time": 1765509225, "type": "recv", "message_id": "1275800715", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（不知道）"}
{"time": 1765509225, "type": "recv", "message_id": "622675999", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(虽然没有翅膀没有尾扫)"}
{"time": 1765509233, "type": "recv", "message_id": "258004368", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（可能可以？）"}
{"time": 1765509233, "type": "recv", "message_id": "496770098", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(也可能没有咬)"}
{"time": 1765509238, "type": "recv", "message_id": "414640178", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(但是爪子应该还在)"}
{"time": 1765509244, "type": "recv", "message_id": "1988834497", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=828984218]“怎么样，里头动静符合预估吗？”"}
{"time": 1765509271, "type": "recv", "message_id": "993460051", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "没开口"}
{"time": 1765509286, "type": "recv", "message_id": "422575196", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...里面除了上夜班的人，罗斯里克，和狗之外，应该是没有其他人了”"}
{"time": 1765509398, "type": "recv", "message_id": "2088725281", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那就是羅斯里克皮革廠。我們等会破門而入，找到老羅斯里克的辦公室，拿走所有亮晶晶的東西，然後在治安官到達之前撤走”她手指向那建筑群“我再强调一遍，如果需要分頭跑路的話，黎明時在灰屋碰頭”"}
{"time": 1765509414, "type": "recv", "message_id": "801760001", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（白马，定叫他有来无回（））"}
{"time": 1765509433, "type": "recv", "message_id": "1510260112", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“搞不懂，皮革厂有什么好两班倒的”看了看建筑“还就只有一个门，连个窗户也没有。是多怕见光死啊？”"}
{"time": 1765509467, "type": "recv", "message_id": "565464078", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那是不是应该蒙上脸）"}
{"time": 1765509486, "type": "recv", "message_id": "590245291", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（你们可以过一个单一的技能检定，任何技能都行）"}
{"time": 1765509506, "type": "recv", "message_id": "52862920", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(隐匿)"}
