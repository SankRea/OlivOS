{"time": 1765824182, "type": "recv", "message_id": "1345383255", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（你说了也没人听得见）"}
{"time": 1765824193, "type": "recv", "message_id": "869171687", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗨嗨，怎么了?\"一边走一边挥手，\"难道不欢迎我吗?\""}
{"time": 1765824250, "type": "recv", "message_id": "1373528643", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "与格蕾西亚相比，你前进就更有阻力一些，毕竟大家似乎不是很怕你"}
{"time": 1765824333, "type": "recv", "message_id": "10657892", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“无趣，主子都退场了，群众演员还在这干嘛？”皱眉"}
{"time": 1765824362, "type": "recv", "message_id": "1380364119", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "大家当然都是在看头盔"}
{"time": 1765824376, "type": "recv", "message_id": "1427686218", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"唉～\"摘下面具，\"拜托，看看我是谁好吗？\""}
{"time": 1765824429, "type": "recv", "message_id": "740554618", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "依旧没人理你，此刻和你的外貌相比，明显有更重要的东西值得观看，哪怕是格蕾西亚本人，也没有太多人在意"}
{"time": 1765824482, "type": "recv", "message_id": "250347489", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“一个头盔而已，就让你们着了魔了”"}
{"time": 1765824491, "type": "recv", "message_id": "1520019427", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（原来油桶是这么用的）"}
{"time": 1765824509, "type": "recv", "message_id": "1461607583", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（油桶用法挺多的）"}
{"time": 1765824516, "type": "recv", "message_id": "2053545121", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（不过你们现在肯定是用不了了）"}
{"time": 1765824597, "type": "recv", "message_id": "322665848", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"唉...明明是没有任何魔力的东西。\"戴上面具，\"那怎么办?\"看向格雷西亚的方向"}
{"time": 1765824612, "type": "recv", "message_id": "2070037647", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你问我？）"}
{"time": 1765824636, "type": "recv", "message_id": "990463213", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "西姆莉也找到了你们，你们四人短暂集合在了一起"}
{"time": 1765824655, "type": "recv", "message_id": "1365893696", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“...现在好像只能先回去了？毕竟其实任务也算完成了”"}
{"time": 1765824664, "type": "recv", "message_id": "1007385373", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“连心之刃也在特鲁恩家族手中，区区一个头盔，又有何用？”"}
{"time": 1765824685, "type": "recv", "message_id": "982008885", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=1007385373]（你这又是哪个时代的新闻）"}
{"time": 1765824698, "type": "recv", "message_id": "1026413477", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（心之刃已经被抢走了）"}
{"time": 1765824738, "type": "recv", "message_id": "667824978", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"心之刃早就在那些家伙手里咯。\"反正跟自己信仰的神祇无关，一副事不关己的样子"}
{"time": 1765824796, "type": "recv", "message_id": "118583241", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“回去交差？”"}
{"time": 1765824815, "type": "recv", "message_id": "1620239200", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "西姆莉看起来对那些人狂热的反应无所谓的样子"}
{"time": 1765824882, "type": "recv", "message_id": "693042918", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（原来已经没了？）"}
{"time": 1765825026, "type": "recv", "message_id": "367811932", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"交差吧？\"打个哈欠，感觉到这些人的无聊之处，\"又不能杀人\""}
{"time": 1765825112, "type": "recv", "message_id": "1651060708", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“现在杀人绝对不是个明智的选择...”西姆莉忍不住吐槽道"}
{"time": 1765825120, "type": "recv", "message_id": "1448228194", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“一群冢中枯骨”"}
{"time": 1765825158, "type": "recv", "message_id": "1630743403", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“走吧走吧....领赏去吧”西姆莉率先朝灰屋去了"}
{"time": 1765825180, "type": "recv", "message_id": "1254756298", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "(睡！"}
{"time": 1765825336, "type": "recv", "message_id": "1034632950", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(睡)"}
{"time": 1765825519, "type": "recv", "message_id": "658225722", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "(睡！"}
{"time": 1765844661, "type": "recv", "message_id": "1717545324", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:image,file=23FF0C0D7C7A856F4A1FC0DA547FCA3D.jpg,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhR33xNuGwKNMuJGmv5qI3d4AXGsrhjjnAEg_woo16ny_evAkQMyBHByb2RQgL2jAVoQpnX_lVc8N_AVRMqQcXUWrHoC4oSCAQJneg&amp;rkey=CAISMIAsKm-YMdIUfKZ0eC3CuiklLVQOGqlDasUXULCl6C5kqN8SeDXI7unUdGaa4aXODA,file_size=20067]"}
{"time": 1765847204, "type": "recv", "message_id": "268222004", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你们又回到了那个熟悉的房间，依旧是熟悉的屏风"}
{"time": 1765847285, "type": "recv", "message_id": "2142620037", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "熟悉的无法辨别年龄的声音传来“事情怎么样...她说了什么”"}
{"time": 1765847533, "type": "recv", "message_id": "1300986559", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“他们说，有个姓维瑟伦还是什么的，光复骑士团的人写了封信，说早晚要过来，让艾奥梅黛成为切利亚斯的正统——可笑。除此之外，他们还说得到了一个什么‘天使骑士’的预兆。不过是一个全包围的金属头盔，我看最多也就是个工艺品”"}
{"time": 1765847706, "type": "recv", "message_id": "1740670386", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "在一旁听着，一声不吭，既然格雷西亚这么上心，自己当然全盘让她来"}
{"time": 1765847748, "type": "recv", "message_id": "827867889", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“宣讲的那位更是懦夫，刚讲完没多久就匆匆离去了”"}
{"time": 1765847789, "type": "recv", "message_id": "1553069286", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“這位鄉村牧師的行動可比我預料中的更有戲劇性——真是令人印象深刻。蒂利維亞·阿拉瑪比我想得更有意思。不過我更好奇的是那個頭盔和『天使騎士』。我聽過有關光復騎士團的傳言。一群太過狂熱的艾奧梅黛暴徒幻想號召一個全國性的起義，就好像能成似的。不過，大男爵費克斯還是會覺得這些信息有價值。\n       無論如何，你們幹得不錯。你們可以去客廳拿你們的報酬。今天不會有其他活了，但是不出意外明天就會有。等我的消息。”"}
{"time": 1765847955, "type": "recv", "message_id": "399079726", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "摊摊手，拉着梅梅率先下楼"}
{"time": 1765848000, "type": "recv", "message_id": "840043159", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "去看看自己的报酬是什么，和这两人在一起也不会让她们评价自己的新衣服，径直转身。"}
{"time": 1765848056, "type": "recv", "message_id": "520440409", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“谢谢您……但真令人不快。明明那些骑士才是强盗，靠些子虚乌有的东西就想让人依附……还偏偏就有人信”"}
{"time": 1765848139, "type": "recv", "message_id": "808543621", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯....你说的对”人影点了点头“好了，今天就先这样吧，你也回去休息一下吧”"}
{"time": 1765848245, "type": "recv", "message_id": "226919164", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“是”*低头告退"}
{"time": 1765848372, "type": "recv", "message_id": "1229148457", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "跟西姆莉一起下去了"}
{"time": 1765848447, "type": "recv", "message_id": "2044222813", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=840043159][CQ:at,qq=1252219916] 依旧在客厅的箱子里，不过这次你的钱袋似乎比其他人的大一些"}
{"time": 1765848546, "type": "recv", "message_id": "1150610621", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嚯?\"掂量一下，打开看看"}
{"time": 1765848589, "type": "recv", "message_id": "2075325422", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "看起来是300金币的样子，大概多的是给梅梅的吧"}
{"time": 1765848780, "type": "recv", "message_id": "1319617034", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "落了座，没急着拿钱，而是靠在椅背上架起腿，双臂环抱，琢磨着今晚去把那头盔偷来的事"}
{"time": 1765848828, "type": "recv", "message_id": "801315835", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "拎着自己的袋子，把袋子递给梅梅。心满意足地坐在自己的床上，表情怡然。"}
{"time": 1765848834, "type": "recv", "message_id": "972141346", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“在想什么呢”西姆莉拿走自己的那份钱，看你的样子有些好奇"}
{"time": 1765849112, "type": "recv", "message_id": "1669628162", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“要不我们试试今晚把那头盔偷走吧，给那群愚民祛个魅”摇摇头，这才抬起头来，依旧是一副紧绷的表情，视线扫过卡提西亚的时候稍微多停了停"}
{"time": 1765849139, "type": "recv", "message_id": "484480123", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“emmm...别把我算上....”"}
{"time": 1765849281, "type": "recv", "message_id": "466850044", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“是吗，那真可惜”叹了口气，打开钱袋看看"}
{"time": 1765849329, "type": "recv", "message_id": "400451557", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "200金币分枚不少"}
{"time": 1765849508, "type": "recv", "message_id": "2110717184", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "依旧盯着卡提西亚，良久，幽幽开口“说不定我也该换身行头了，不然想在城里打探些事情都不方便”"}
{"time": 1765849793, "type": "recv", "message_id": "21360873", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“对了，去吃饭吧...大家应该午饭也没吃的样子？”"}
{"time": 1765849801, "type": "recv", "message_id": "692371797", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "西姆莉提议道"}
{"time": 1765849827, "type": "recv", "message_id": "1228676827", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（原来是一天没吃，但是昨晚有宵夜）"}
{"time": 1765850143, "type": "recv", "message_id": "1248808789", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“确实”"}
{"time": 1765850805, "type": "recv", "message_id": "708862736", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"随便。\""}
{"time": 1765850914, "type": "recv", "message_id": "329981901", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（and？）"}
{"time": 1765851099, "type": "recv", "message_id": "713448575", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“走吧”站起身来“可惜没有昨晚那种伙食”"}
