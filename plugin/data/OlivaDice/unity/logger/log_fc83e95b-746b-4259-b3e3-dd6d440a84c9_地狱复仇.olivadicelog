{"time": 1765885348, "type": "recv", "message_id": "547722333", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(拐了下左手)"}
{"time": 1765885379, "type": "recv", "message_id": "1534445969", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（哎，你的手怎么这么多灾多难）"}
{"time": 1765885386, "type": "recv", "message_id": "952447573", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（真是那个男人吧）"}
{"time": 1765885421, "type": "recv", "message_id": "734998776", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "()"}
