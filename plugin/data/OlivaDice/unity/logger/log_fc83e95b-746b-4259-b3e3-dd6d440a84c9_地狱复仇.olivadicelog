{"time": 1765819567, "type": "recv", "message_id": "1020716978", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那你不准备上了？”"}
{"time": 1765819776, "type": "recv", "message_id": "481351914", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“你上去了还能用绳子拉我”"}
