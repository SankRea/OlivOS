{"time": 1765565727, "type": "recv", "message_id": "1076099425", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哼哼?\"等着身边的人夸自己，洋洋得意地抬起头"}
{"time": 1765565798, "type": "recv", "message_id": "1784166979", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“小卡好厉害”梅梅崇拜的看着你"}
{"time": 1765565845, "type": "recv", "message_id": "477399981", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“真的假的.. 运气吧，居然扎这么准”西姆莉有些吃惊，不服的说道“再来一次”"}
{"time": 1765565851, "type": "recv", "message_id": "780791512", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": ".rd+6"}
