{"time": 1765773549, "type": "recv", "message_id": "1137806461", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（你们是不是到午休时间了）"}
