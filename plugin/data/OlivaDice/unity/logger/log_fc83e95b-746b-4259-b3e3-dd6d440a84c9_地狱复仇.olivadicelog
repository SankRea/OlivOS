{"time": 1765823925, "type": "recv", "message_id": "1531711710", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（除非你说你会飞）"}
