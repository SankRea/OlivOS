{"time": 1765882389, "type": "recv", "message_id": "2087374429", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（哎，该寻求世界之外的力量了）"}
{"time": 1765882404, "type": "recv", "message_id": "707427868", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“那就这样吧”合上菜单，长刀转而架在桌边"}
