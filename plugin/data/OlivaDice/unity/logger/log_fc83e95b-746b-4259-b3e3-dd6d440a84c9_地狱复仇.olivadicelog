{"time": 1765885249, "type": "recv", "message_id": "694001432", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（啥车没事吧）"}
{"time": 1765885262, "type": "recv", "message_id": "1538278211", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（车撞你了还是你撞车了）"}
