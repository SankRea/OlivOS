{"time": 1766032554, "type": "recv", "message_id": "174264111", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（翔哥今天久违地醒的比我早）"}
{"time": 1766032576, "type": "recv", "message_id": "1239188699", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那还说啥了）"}
{"time": 1766032640, "type": "recv", "message_id": "1229900693", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我早上醒了片刻，看了眼手机意识到你肯定没醒，爬起来喊你)"}
{"time": 1766032644, "type": "recv", "message_id": "746338782", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(真是你爹)"}
