{"time": 1765509184, "type": "recv", "message_id": "1341405875", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（哦，原来是，只准备了一个法甲）"}
