{"time": 1765772178, "type": "recv", "message_id": "1819405587", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我其实在想，我要是和龙神脸有些像)"}
{"time": 1765772185, "type": "recv", "message_id": "1919070717", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(以龙神当地的口碑)"}
