{"time": 1765819942, "type": "recv", "message_id": "1925850896", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "扶好梯子等她上去"}
{"time": 1765819992, "type": "recv", "message_id": "755360561", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "西姆莉很轻松便上到了二楼，随后给你扔下来一条绳子"}
{"time": 1765820022, "type": "recv", "message_id": "1972449408", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "进行一个爬"}
