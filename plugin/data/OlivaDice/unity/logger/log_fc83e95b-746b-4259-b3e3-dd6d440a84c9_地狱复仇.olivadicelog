{"time": 1765469625, "type": "recv", "message_id": "475989937", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（卡缇希亚可能是viper，但是想不到怎么和viper对应）"}
