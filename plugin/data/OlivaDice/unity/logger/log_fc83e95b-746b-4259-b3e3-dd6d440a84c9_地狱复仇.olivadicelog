{"time": 1765441592, "type": "recv", "message_id": "1104419098", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(你都没给信仰吧，龙神)"}
