{"time": 1765819317, "type": "recv", "message_id": "1906168363", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（无坑速动）"}
