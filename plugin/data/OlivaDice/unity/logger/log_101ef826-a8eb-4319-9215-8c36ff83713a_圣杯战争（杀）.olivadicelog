{"time": 1755672733, "type": "recv", "message_id": "1971858219", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "1985245608"}, "sender": {"id": "1985245608", "name": "洛绫飞羽"}, "message": "（我怎么感觉来者不善）"}
