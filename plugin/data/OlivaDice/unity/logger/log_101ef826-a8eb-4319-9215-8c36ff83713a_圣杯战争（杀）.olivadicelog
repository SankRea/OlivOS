{"time": 1755527600, "type": "recv", "message_id": "1923041235", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "（之前到哪了）"}
{"time": 1755527921, "type": "recv", "message_id": "520240450", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“我们准备把天文台当据点，你愿意和我们联手吗？”白衣青年说到"}
{"time": 1755528036, "type": "recv", "message_id": "1497431285", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "1985245608"}, "sender": {"id": "1985245608", "name": "洛绫飞羽"}, "message": "“无妨”"}
{"time": 1755528073, "type": "recv", "message_id": "1220830160", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "1985245608"}, "sender": {"id": "1985245608", "name": "洛绫飞羽"}, "message": "“我不会在天文台与你们一起驻扎，但是在商业区做个邻居没什么问题”"}
{"time": 1755528208, "type": "recv", "message_id": "979580075", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“哈，那就，互不干扰？”"}
{"time": 1755528249, "type": "recv", "message_id": "1778187655", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "1985245608"}, "sender": {"id": "1985245608", "name": "洛绫飞羽"}, "message": "“可以”"}
{"time": 1755528364, "type": "recv", "message_id": "1873440944", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“能说说为什么会召唤失败？据我所知，历代被选中的人好像没出现过这种情况”那个御主这么说道"}
{"time": 1755528475, "type": "recv", "message_id": "33483237", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "1985245608"}, "sender": {"id": "1985245608", "name": "洛绫飞羽"}, "message": "“呵，这谁知道呢”"}
{"time": 1755528497, "type": "recv", "message_id": "1288659812", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "1985245608"}, "sender": {"id": "1985245608", "name": "洛绫飞羽"}, "message": "“历史是由胜利者所书写的，我们所知道的未必是真实发生的事情”"}
{"time": 1755528578, "type": "recv", "message_id": "289635188", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "1985245608"}, "sender": {"id": "1985245608", "name": "洛绫飞羽"}, "message": "“也许过去也有那么几个和我一样的倒霉蛋。毫无疑问，他们会在圣杯战争中被敌人轻易抹杀掉。而赢家为了展现自己的实力，也会选择隐瞒召唤失败的事情”"}
{"time": 1755528623, "type": "recv", "message_id": "689263341", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "1985245608"}, "sender": {"id": "1985245608", "name": "洛绫飞羽"}, "message": "“战胜强者的故事，不觉得比掐死一个倒霉蛋好听的多吗”"}
{"time": 1755528898, "type": "recv", "message_id": "590622494", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "白衣青年先开口“不管你到底是召唤失败还是令咒不在手臂上，我会信任你刚才做出的互不干扰的承诺”"}
{"time": 1755528919, "type": "recv", "message_id": "1511930559", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "那名御主则不置可否“或许是吧，谁知道呢”*说完耸了耸肩"}
{"time": 1755529000, "type": "recv", "message_id": "1835243211", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "1985245608"}, "sender": {"id": "1985245608", "name": "洛绫飞羽"}, "message": "“好了，我说了这么多，你们是不是也该分享下你们的故事呢”"}
{"time": 1755529328, "type": "recv", "message_id": "1929359737", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“我只想拯救世界，所以来了这次杯战，目前看来你不是我的目标”"}
{"time": 1755529334, "type": "recv", "message_id": "1757595945", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "白衣青年摇了摇头"}
{"time": 1755529356, "type": "recv", "message_id": "584179019", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "御主则是摇了摇头“我没啥故事，觉得我应该来，所以我来了”"}
{"time": 1755529359, "type": "recv", "message_id": "785852395", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "1985245608"}, "sender": {"id": "1985245608", "name": "洛绫飞羽"}, "message": "“哦？拯救世界？”"}
{"time": 1755529371, "type": "recv", "message_id": "1857515011", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“真要了解的话，不如今晚彻夜长谈”"}
{"time": 1755529443, "type": "recv", "message_id": "635838171", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "1985245608"}, "sender": {"id": "1985245608", "name": "洛绫飞羽"}, "message": "“那自然是无妨”"}
{"time": 1755529538, "type": "recv", "message_id": "213785391", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "1985245608"}, "sender": {"id": "1985245608", "name": "洛绫飞羽"}, "message": "“既然刚才多少算我叨扰各位，那不妨由我请客，邀各位于这商业中心之下一家鲜有人知晓的店中，对酒当歌，如何”"}
{"time": 1755529797, "type": "recv", "message_id": "1736660697", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“既然有人相邀，自当作陪”“到时当然会登门拜访”“那么现在。。。？”"}
{"time": 1755530074, "type": "recv", "message_id": "180371510", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "（那么现在？）"}
{"time": 1755530091, "type": "recv", "message_id": "1160262897", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "1985245608"}, "sender": {"id": "1985245608", "name": "洛绫飞羽"}, "message": "“其实我原打算看看天文台之景色与设置，没想到遇到诸位。现在既已合作，那晚点再登门拜访或许也无妨？”"}
{"time": 1755530124, "type": "recv", "message_id": "219009869", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "1985245608"}, "sender": {"id": "1985245608", "name": "洛绫飞羽"}, "message": "“诸位此前不是要四处探查？继续如何？”"}
{"time": 1755530198, "type": "recv", "message_id": "1009206057", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“那继续呗”*对方的御主说到"}
{"time": 1755530240, "type": "recv", "message_id": "722161877", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "他双手手掌交叉放在脑后，一副无所谓的样子"}
{"time": 1755530333, "type": "recv", "message_id": "918224074", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“那么今晚再登门拜访吧，暂时别过”"}
{"time": 1755530438, "type": "recv", "message_id": "364639409", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "1985245608"}, "sender": {"id": "1985245608", "name": "洛绫飞羽"}, "message": "*点点头"}
{"time": 1755530503, "type": "recv", "message_id": "2093950943", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“既然后边要登门拜访，不如留个联系方式？”"}
{"time": 1755530783, "type": "recv", "message_id": "842936863", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "1985245608"}, "sender": {"id": "1985245608", "name": "洛绫飞羽"}, "message": "*点点头，递上名片“叫我「蜗牛」即可。上面的号码是传真机。需要与我联系时，用传真机发出讯息，我自有办法收到。”*笑笑“在这个时代 ，越古老，越安全”"}
{"time": 1755530794, "type": "recv", "message_id": "1175647215", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "1985245608"}, "sender": {"id": "1985245608", "name": "洛绫飞羽"}, "message": "“那么两位的联系方式。。。。？”"}
{"time": 1755531452, "type": "recv", "message_id": "1276819874", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "对方让你等了一会，旋即林间飞出了一枚小小的袖珍盾牌。白衣青年把那个小盾交给了你"}
{"time": 1755531618, "type": "recv", "message_id": "987433961", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "1985245608"}, "sender": {"id": "1985245608", "name": "洛绫飞羽"}, "message": "“这是。。。？”"}
{"time": 1755531624, "type": "recv", "message_id": "2136868457", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "1985245608"}, "sender": {"id": "1985245608", "name": "洛绫飞羽"}, "message": "（不给个解释吗）"}
{"time": 1755531792, "type": "recv", "message_id": "826307761", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“我常用的联络用礼装”"}
{"time": 1755531803, "type": "recv", "message_id": "804690504", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“可以用它来联络我”"}
{"time": 1755531862, "type": "recv", "message_id": "803800316", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“相信以你的魔术水平能看出来用途的”"}
{"time": 1755531946, "type": "recv", "message_id": "848775858", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "1985245608"}, "sender": {"id": "1985245608", "name": "洛绫飞羽"}, "message": "*揣起来“也罢”"}
{"time": 1755531975, "type": "recv", "message_id": "1558931589", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "1985245608"}, "sender": {"id": "1985245608", "name": "洛绫飞羽"}, "message": "“那么，就此别过？”"}
{"time": 1755532082, "type": "recv", "message_id": "1680267731", "deleted": false, "dect": {"host_id": null, "group_id": "1056339614", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“那么，就此别过？”"}
