{"time": 1743774367, "type": "recv", "dect": {"host_id": null, "group_id": "1040792363", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（怎么了，还有人比我到的早？）"}
