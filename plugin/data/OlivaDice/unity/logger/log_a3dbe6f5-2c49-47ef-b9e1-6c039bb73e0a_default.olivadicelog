{"time": 1772456322, "type": "recv", "message_id": "1737165139", "deleted": false, "dect": {"host_id": null, "group_id": "1040792363", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*腾地站起来，左顾右盼找医生"}
{"time": 1772456326, "type": "recv", "message_id": "2034381492", "deleted": false, "dect": {"host_id": null, "group_id": "1040792363", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "今天是2026年，3月14日，距离那件事，已经过去很久了"}
