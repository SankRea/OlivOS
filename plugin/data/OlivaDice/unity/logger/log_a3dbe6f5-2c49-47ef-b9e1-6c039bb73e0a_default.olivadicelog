{"time": 1743729075, "type": "recv", "dect": {"host_id": null, "group_id": "1040792363", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:image,file=ef150c912ff81b04d9f8f30fdd3ce6a5.image,subType=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhRRupCpfZPJXa29ySJgbiPhQcTtyRjf6xAg_woosaLrgJm9jAMyBHByb2RQgL2jAVoQGkhZWO_YbUr7mqEFvaPso3oCVRE&amp;spec=0&amp;rkey=CAQSKAB6JWENi5LM2HIlNiKY8naIvThWQ46n2qOo9DyuieU7xKIzWnAVzBo]"}
