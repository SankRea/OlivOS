{"time": 1754752796, "type": "recv", "message_id": "2016318750", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（气笑了啊）"}
