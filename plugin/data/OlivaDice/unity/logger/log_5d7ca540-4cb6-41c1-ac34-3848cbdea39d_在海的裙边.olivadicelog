{"time": 1754758359, "type": "recv", "message_id": "144672060", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(总不能在这钓鱼吧)"}
{"time": 1754758363, "type": "recv", "message_id": "695122438", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（回）"}
{"time": 1754758369, "type": "recv", "message_id": "1225383859", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（那好像可以鸟鸟了）"}
{"time": 1754758376, "type": "recv", "message_id": "753278641", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我是没有办法钓起来这东西的)"}
{"time": 1754758423, "type": "recv", "message_id": "920026275", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那好像可以鸟鸟了）"}
{"time": 1754758434, "type": "recv", "message_id": "495199461", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（但是水里好像也没有能打过的）"}
{"time": 1754758529, "type": "recv", "message_id": "482440530", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(除非它自己爬上来)"}
{"time": 1754758696, "type": "recv", "message_id": "566068010", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "总之，至少海洋的愤怒暂时被迫平息。天空也略微明亮一些"}
{"time": 1754758728, "type": "recv", "message_id": "1679878023", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "至于海中的大魔……不知道何时会卷海重来。不过至少结云与炎火的通道被打通了"}
{"time": 1754758865, "type": "recv", "message_id": "996206316", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "回去打算好好休息，美美泡个温泉"}
{"time": 1754758868, "type": "recv", "message_id": "982170425", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（海中有大魔侵扰）"}
{"time": 1754759007, "type": "recv", "message_id": "1256365236", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(?申鹤)"}
{"time": 1754759018, "type": "recv", "message_id": "1625391157", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（钟离）"}
{"time": 1754759091, "type": "recv", "message_id": "1764615810", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "回去的路稀疏平常，雨势已经小了不少，甚至能隐约透过云层看到东方初升的月亮"}
{"time": 1754759241, "type": "recv", "message_id": "1412507795", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没想到都晚上了...我倒是想在结云多待几天，不急着去炎火倒是...\"靠着夏弥，反正身上早就湿漉漉的，无所谓什么状态了，\"泡澡去～\""}
{"time": 1754759321, "type": "recv", "message_id": "1521046424", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（可以鸟了.jpg）"}
