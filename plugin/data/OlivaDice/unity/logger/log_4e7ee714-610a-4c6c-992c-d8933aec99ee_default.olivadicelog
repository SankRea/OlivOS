{"time": 1772286504, "type": "recv", "message_id": "1622145882", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（）"}
{"time": 1772287044, "type": "recv", "message_id": "1807070866", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "你在一颗红色的树下看见了姐姐，神山识，她束着一个高马尾，就像死时那天一样。背对着你。"}
{"time": 1772287071, "type": "recv", "message_id": "1397938157", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“姐....姐姐？”有点不敢确定...."}
{"time": 1772287322, "type": "recv", "message_id": "1489850248", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...\"少女逐渐转过了身，眼睛亮亮地，就和你之前很多次很多次看到的那样。"}
{"time": 1772287368, "type": "recv", "message_id": "1856674309", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“真的是你”此刻什么也顾不上了，上前就抱住她“姐姐...我好想你”"}
{"time": 1772287676, "type": "recv", "message_id": "2004071578", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "体温一如往常，温暖，带着些你熟悉的芳香，\"有那么想吗？\"她摸着你的脑袋，笑意盈盈"}
{"time": 1772287700, "type": "recv", "message_id": "243220192", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我...我还以为...再也见不到姐姐了...”"}
{"time": 1772288370, "type": "recv", "message_id": "623899683", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“唔...都说只要一直念着的话，总是可以再见的。”她的语气很轻，抚摸着你的脑袋的手也很轻。"}
{"time": 1772288426, "type": "recv", "message_id": "830707045", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "紧紧的抱着姐姐，害怕一松手就不见了..."}
{"time": 1772289882, "type": "recv", "message_id": "1918870338", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“别抱得那么紧啦。”她扭了扭身子，拍拍你的肩膀，“露的话，不是不希望出现灾害吗？”"}
{"time": 1772289990, "type": "recv", "message_id": "1387497765", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“.....嗯...但是这和现在有什么关系...”"}
{"time": 1772290815, "type": "recv", "message_id": "1523036269", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“没什么。”她笑着推开了你一些，“没什么啦，姐姐会保护小露的。”"}
{"time": 1772290838, "type": "recv", "message_id": "1236529683", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“姐姐...怎么推开我...”有点委屈🥺"}
{"time": 1772291396, "type": "recv", "message_id": "2022993570", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"咦，还要抱着吗？\"她凑上去拉着你的手，\"小露都长大了。\""}
{"time": 1772291442, "type": "recv", "message_id": "153743019", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“但是...这样的机会...不会很多...万一是梦的话...”"}
{"time": 1772292051, "type": "recv", "message_id": "836469652", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"唔，小露以为，我已经去了哪里?\"她握紧了些你的手，语气有些奇怪。"}
{"time": 1772292112, "type": "recv", "message_id": "55473926", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我....我...不..不要说了..”更紧的抱住姐姐，害怕忽然就消散了"}
{"time": 1772292191, "type": "recv", "message_id": "928214400", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好啦，姐姐会保护好小露的。\"她的表情忽然有些悲伤，\"明明，不该是这样的，小露，也不该做这些。\""}
{"time": 1772292230, "type": "recv", "message_id": "448015488", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯嗯...”用力点点头“没关系姐姐...不会再发生那样的事情了..不会了”"}
{"time": 1772292512, "type": "recv", "message_id": "1890927703", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...\"识摇了摇脑袋，\"已经发生了，小露，你现在要做的...\"她的话语还没有说完，不知何处而来的大风呼啸而过，吹得你睁不开眼睛，树叶发出莎莎的响动好似哭声。"}
{"time": 1772292555, "type": "recv", "message_id": "313295989", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "红色的树枝哗啦哗啦地折断，又落下，砸在你的身上，或者说，砸在你抱着的那个人的背上。"}
{"time": 1772292591, "type": "recv", "message_id": "860057109", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不...不要，姐姐快趴下”想要去护住她"}
{"time": 1772292897, "type": "recv", "message_id": "2060531596", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "她压着你，不让树枝掉到你的身上，你感觉到一些粘稠的液体顺着相交的手臂，顺着你的额头滴下，有些温热，黏腻。"}
{"time": 1772292961, "type": "recv", "message_id": "1791487877", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不...不要...不要这样...”哭了出来“姐姐...”"}
{"time": 1772293318, "type": "recv", "message_id": "1018460196", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...小露。\"她的声音有些抖，刻意压着些，\"要早些离开...早些...找到那...\"话语还没有传达完，你猛然睁开了眼，输液大厅明晃晃的白炽灯让你有些乱了心神"}
{"time": 1772293399, "type": "recv", "message_id": "31214652", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“姐....姐姐！”"}
{"time": 1772293539, "type": "recv", "message_id": "51740608", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "猛的坐起...."}
