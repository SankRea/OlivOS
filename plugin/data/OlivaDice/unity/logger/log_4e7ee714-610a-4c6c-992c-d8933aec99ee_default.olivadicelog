{"time": 1770871237, "type": "recv", "message_id": "256537572", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "那你到了家，推开门看见母亲在玄关有些焦急地等着，看到你进门才如释重负，\"露露，怎么这么晚...我都担心...\""}
{"time": 1770871269, "type": "recv", "message_id": "753382995", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“抱歉了妈妈，我晚上在外面和同学一起吃了”"}
{"time": 1770871281, "type": "recv", "message_id": "1235130706", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "上去抱抱"}
{"time": 1770871417, "type": "recv", "message_id": "1702790604", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没事就好。\"她叹了口气，\"我只是有些担心，你知道的，学校的事...\""}
{"time": 1770871508, "type": "recv", "message_id": "1372011327", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯嗯...抱歉，妈妈，我以后会早点回来的，就算有事，也会回来也说一声的”"}
{"time": 1770871622, "type": "recv", "message_id": "914694150", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯。\"她点了点头，拍拍你的背\"去念书吧。\""}
