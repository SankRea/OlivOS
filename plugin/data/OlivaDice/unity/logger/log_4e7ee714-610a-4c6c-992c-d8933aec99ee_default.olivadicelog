{"time": 1772281339, "type": "recv", "message_id": "1056740405", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（咦，有什么大事发生吗（））"}
{"time": 1772281378, "type": "recv", "message_id": "1725087604", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "护士提着配好的针剂走到你身边，针尖浸出一些药剂，滴在地板上。看上去不太细。"}
{"time": 1772281403, "type": "recv", "message_id": "1467126910", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "忍不住的发抖，但为了活下去...."}
{"time": 1772281617, "type": "recv", "message_id": "404372252", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "过一下体质。"}
