{"time": 1772281637, "type": "reply", "message_id": "23018587", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[神山露]进行技能[体质:80]检定: 1D100=43/80 成功，春风得意马蹄急，一日看尽长安花"}
{"time": 1772281652, "type": "recv", "message_id": "282150970", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（孩子没什么优点，就是耐打）"}
{"time": 1772281708, "type": "recv", "message_id": "283882821", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "这一针虽然有些疼，但神山露咬咬牙也就过去了，护士拍拍你的胳膊，\"以后不要去后山了。\"她的表情有些冷冷的。"}
{"time": 1772281731, "type": "recv", "message_id": "685428351", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...”点点头，但说实话感觉护士有点奇怪"}
{"time": 1772281775, "type": "recv", "message_id": "491488612", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"已经废弃了，你知道吧。\"护士走到一边接着调试起下一个针剂，你只感觉有些冷。"}
{"time": 1772281797, "type": "recv", "message_id": "388997003", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "雨纪酱今天应该会来看我吧，我们是好朋友，她应该会来吧..."}
{"time": 1772281825, "type": "recv", "message_id": "1799652787", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...话说姐姐那里为什么废弃了...”其实关于这个自己也不太清楚"}
{"time": 1772281871, "type": "recv", "message_id": "1257427745", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"毕竟是神明，如果不显灵的话，没有人会去也是很正常的。\""}
{"time": 1772281914, "type": "recv", "message_id": "2040491665", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“.....我以后不会去了.....”看看护士胸口的工牌"}
{"time": 1772282003, "type": "recv", "message_id": "229872690", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "上面写着铃木响子，\"当然，那地方也不是一天两天的事情了。总还是会有人上去的吧。\"护士的眼睛看向你，一双灰色的瞳孔透着冷意。"}
{"time": 1772282025, "type": "recv", "message_id": "2091095043", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "有点不敢看他，低下头..."}
{"time": 1772282146, "type": "recv", "message_id": "1353605952", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"你还有什么没说的吧。\"你感觉到护士似乎弯下了腰，视线明晃晃地"}
{"time": 1772282460, "type": "recv", "message_id": "73019008", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“啊？”"}
{"time": 1772282474, "type": "recv", "message_id": "1324832075", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我都说了啊....”有点摸不到头脑"}
{"time": 1772282514, "type": "recv", "message_id": "1524083284", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "护士摇摇头，你能感觉到她的鼻息，\"在那里，做了什么，看见了什么，听到了什么。\""}
{"time": 1772282563, "type": "recv", "message_id": "1475628104", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我....我就拜了拜神.....”"}
{"time": 1772282614, "type": "recv", "message_id": "1116296625", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "护士没说话，你感觉莫名地心慌"}
{"time": 1772282690, "type": "recv", "message_id": "86094104", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“护士小姐...你是不是知道点什么...告诉我吧...”"}
{"time": 1772282855, "type": "recv", "message_id": "2085327627", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我，我吗？\"响子指了指自己，她此刻离开了你身边，坐在你面前的椅子上，\"我只是普通人。\""}
{"time": 1772282981, "type": "recv", "message_id": "327485276", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“但是...但是...”低下头不知道该怎么办才好"}
{"time": 1772283032, "type": "recv", "message_id": "1864642986", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"不清楚的话就算了吧。\"她下了逐客令，\"下一针也没有必要再打了，待会优小姐会给你吊水。\""}
{"time": 1772283051, "type": "recv", "message_id": "510828153", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“还有...还有...”"}
{"time": 1772283071, "type": "recv", "message_id": "565126814", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我往钱箱里放了钱...里面好像有什么...”"}
{"time": 1772283168, "type": "recv", "message_id": "1688338820", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "沉默着"}
{"time": 1772283198, "type": "recv", "message_id": "1764542335", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“剩下的...我还扔一个学妹一起投了钱...还看了钱箱....剩下什么都没做了...”"}
{"time": 1772283349, "type": "recv", "message_id": "1579647289", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "她依然沉默着，过了一会才开口，\"八百万神明都在高天原。\"她停了一下，晃了晃神，下一句话有些没头没脑，\"针打完了?\"眨了眨眼"}
{"time": 1772283862, "type": "recv", "message_id": "769467290", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“应...应该吧...”"}
{"time": 1772283872, "type": "recv", "message_id": "27565417", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“就打一针么....”"}
{"time": 1772283962, "type": "recv", "message_id": "1619341215", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"本来就是一针吧？\"她抓了抓自己的头发，\"咦...\""}
{"time": 1772284129, "type": "recv", "message_id": "596121347", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不是一针退烧...一针疫苗么...”有点害怕"}
{"time": 1772284169, "type": "recv", "message_id": "484592645", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶?\"她挠了挠头，\"有吗？为什么要打疫苗?\"紧接着她看了看一旁桌子上的配药，\"刚刚打了什么?\""}
{"time": 1772284177, "type": "recv", "message_id": "317734056", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "你注意到她的语气有些紧张"}
{"time": 1772284194, "type": "recv", "message_id": "565791137", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不是说....狂犬疫苗么.....”"}
{"time": 1772284313, "type": "recv", "message_id": "261733594", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"地西泮...唑吡坦...\"你注意到她的眉头越皱越深，随后遮住了脸，\"没事没事...现在感觉怎么样？\""}
{"time": 1772284382, "type": "recv", "message_id": "1724074369", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“这...这两个药...是干嘛的....”感觉有种莫名的困意“好像...有点..困”"}
{"time": 1772284565, "type": "recv", "message_id": "1359173008", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呃...没什么...\"她有些慌慌张张地，遮掩着动作，\"困的话就去输液室吧，优小姐会给你吊一点盐水。\""}
{"time": 1772284665, "type": "recv", "message_id": "1293380868", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "啊....摸不着头脑"}
{"time": 1772284678, "type": "recv", "message_id": "179398850", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "该不该举办她啊...."}
{"time": 1772284693, "type": "recv", "message_id": "1176768625", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "还是这是神明对我的惩罚.."}
{"time": 1772284763, "type": "recv", "message_id": "529670623", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "头晕的感觉确实有所好转，不过被困倦所替代，响子走到你身边，\"走...走吧?\"语气有些躲闪"}
{"time": 1772284786, "type": "recv", "message_id": "1850609811", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...”算了，睡醒再说吧...好困"}
{"time": 1772284884, "type": "recv", "message_id": "865511025", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "她扶着你出去，你只感觉模模糊糊地，手臂上好像就被吊上了针，滴滴的输液声是绝好的助眠白噪音。"}
{"time": 1772285012, "type": "recv", "message_id": "1308576977", "deleted": false, "dect": {"host_id": null, "group_id": "1041572232", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "昏昏欲睡，眼皮越来越重，身体也越来越没力气了"}
