{"type": "log_total_duration", "total_time": 0}
{"time": 1751032477, "type": "reply", "message_id": "879351030", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "开始记录乐谱"}
{"time": 1751032508, "type": "recv", "message_id": "1022556080", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "（让我康康！）"}
{"time": 1751032510, "type": "recv", "message_id": "584159366", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“怎么了医生？”"}
{"time": 1751032529, "type": "recv", "message_id": "41169280", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“她呢？怎么样了？”"}
{"time": 1751032572, "type": "recv", "message_id": "1142145619", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“多亏了你的药，已经基本全好了”"}
{"time": 1751032594, "type": "recv", "message_id": "2020063236", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "莉兹坐在床上"}
{"time": 1751032598, "type": "recv", "message_id": "180002317", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "静静地看着你"}
{"time": 1751032625, "type": "recv", "message_id": "1987570941", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我应该得到一句感谢？”"}
{"time": 1751032695, "type": "recv", "message_id": "359124100", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“大恩大德，难以言谢”"}
{"time": 1751032712, "type": "recv", "message_id": "2102465259", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“医生你有什么需要帮忙的告诉我就好，我会尽力帮你完成的”"}
{"time": 1751032829, "type": "recv", "message_id": "462138225", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我只想了解一切，救下所有人”"}
{"time": 1751032915, "type": "recv", "message_id": "493323163", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“但是我们也不知道多少事情哎..”"}
{"time": 1751032950, "type": "recv", "message_id": "691153182", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“关于画笔的来源可以更仔细说明一下吗”"}
{"time": 1751032990, "type": "recv", "message_id": "1411798499", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "莉兹一直没说话"}
{"time": 1751032994, "type": "recv", "message_id": "1850945350", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“就是一个中年人，自称老雅克”"}
{"time": 1751033028, "type": "recv", "message_id": "2068111341", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“说和我有缘之类的就送给我了”"}
{"time": 1751033122, "type": "recv", "message_id": "1670375228", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“说真的”"}
{"time": 1751033132, "type": "recv", "message_id": "337289528", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“这个镇子实在是超乎我的想象”"}
{"time": 1751033142, "type": "recv", "message_id": "2011363239", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我真心希望我们能够合作”"}
{"time": 1751033160, "type": "recv", "message_id": "280844551", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我不能允许有人再接二连三死去了”"}
{"time": 1751033195, "type": "recv", "message_id": "1140620860", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“谁...死了”"}
{"time": 1751033325, "type": "recv", "message_id": "1336846837", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我知道这很难相信”"}
{"time": 1751033335, "type": "recv", "message_id": "461399483", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“但是小卡大抵是死了”"}
{"time": 1751033341, "type": "recv", "message_id": "347142344", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "\"？\""}
{"time": 1751033351, "type": "recv", "message_id": "914449712", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“她不是活生生站在那么”"}
{"time": 1751033353, "type": "recv", "message_id": "1092077653", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“至于为什么，等回诊所我再解释”"}
{"time": 1751033372, "type": "recv", "message_id": "2007282435", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“现在这情况还能回诊所吗，外面那么多...怪物”"}
{"time": 1751033465, "type": "recv", "message_id": "410193264", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我不知道”"}
{"time": 1751033475, "type": "recv", "message_id": "1557537912", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“她有什么想说的吗”"}
{"time": 1751033479, "type": "recv", "message_id": "1627368822", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*看向床上"}
{"time": 1751033513, "type": "recv", "message_id": "1874370875", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“莉兹有点怕生”"}
{"time": 1751033535, "type": "recv", "message_id": "755870787", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你有合作的意愿吗，莉兹”"}
{"time": 1751033568, "type": "recv", "message_id": "1129619292", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那要看你的意愿了\""}
{"time": 1751033571, "type": "recv", "message_id": "177634131", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"医生。\""}
{"time": 1751033605, "type": "recv", "message_id": "1943959772", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我的意愿已经表达的很明显了”"}
{"time": 1751033610, "type": "recv", "message_id": "1968396374", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“给你用的药”"}
{"time": 1751033618, "type": "recv", "message_id": "996284244", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“只能说，至此一份”"}
{"time": 1751033825, "type": "recv", "message_id": "977577061", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我是死了也无所谓的人，这份药，不能说明决心。\""}
{"time": 1751033853, "type": "recv", "message_id": "2039823188", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不要说这种话”"}
{"time": 1751033986, "type": "recv", "message_id": "1328500859", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...\"她看着你，露出了你没见过的认真神情"}
{"time": 1751034016, "type": "recv", "message_id": "2005860515", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“怎么会....无所谓呢”"}
{"time": 1751034082, "type": "recv", "message_id": "1449162274", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“那你的要求又是什么呢”"}
{"time": 1751034087, "type": "recv", "message_id": "1685242732", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“是她吗”"}
{"time": 1751034106, "type": "recv", "message_id": "1603759334", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"有人要离开这里，有人不能。\""}
{"time": 1751034218, "type": "recv", "message_id": "1028641902", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“...为什么有人不能”"}
{"time": 1751034265, "type": "recv", "message_id": "522105636", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "她没接话，而是看着医生，紧接着目光扫过助手"}
{"time": 1751034271, "type": "recv", "message_id": "1932953649", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我呢”"}
{"time": 1751034276, "type": "recv", "message_id": "550051327", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我属于哪个”"}
{"time": 1751034302, "type": "recv", "message_id": "929002691", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"这取决于你的选择，医生。\"她拿出一支笔，\"你的选择。\""}
{"time": 1751034336, "type": "recv", "message_id": "1456542560", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "#看看笔"}
{"time": 1751034441, "type": "recv", "message_id": "1571133524", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我不明白你的意思”"}
{"time": 1751034459, "type": "recv", "message_id": "1437498416", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“没事，我也不明白”"}
{"time": 1751034467, "type": "recv", "message_id": "1178983235", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“先想想外面的事情怎么办吧”"}
{"time": 1751034717, "type": "recv", "message_id": "1206157129", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“所以怎么说？”"}
{"time": 1751034805, "type": "recv", "message_id": "986175659", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“不如下来吧，找个协防的地方”"}
{"time": 1751034810, "type": "recv", "message_id": "1061823625", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“不要分开行动了”"}
{"time": 1751034898, "type": "recv", "message_id": "1419577291", "deleted": true, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“”"}
{"time": 1751034901, "type": "recv", "message_id": "1741183712", "deleted": true, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“”"}
{"time": 1751034908, "type": "recv", "message_id": "1555408182", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯”"}
{"time": 1751035106, "type": "recv", "message_id": "73000445", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我可以为你实现一个愿望\""}
{"time": 1751035126, "type": "recv", "message_id": "1620106635", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不行”"}
{"time": 1751035141, "type": "recv", "message_id": "381420214", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“愿望？用那个画笔吗”"}
{"time": 1751035187, "type": "recv", "message_id": "1695123129", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"用我的羽毛笔\""}
{"time": 1751035252, "type": "recv", "message_id": "1782937789", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不可以...”"}
{"time": 1751035281, "type": "recv", "message_id": "1729250208", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我记得代价可是极其惨痛的，但我相信你的觉悟”"}
{"time": 1751035281, "type": "recv", "message_id": "2053704862", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=929002691][CQ:at,qq=1252219916] #去抢那支笔"}
{"time": 1751035294, "type": "recv", "message_id": "38306145", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“把这个留到最后把”"}
{"time": 1751035296, "type": "recv", "message_id": "1977653344", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*叹气"}
