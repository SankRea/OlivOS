{"time": 1751035443, "type": "recv", "message_id": "829022002", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“一起下去把”"}
{"time": 1751035482, "type": "recv", "message_id": "53277171", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "她抬起手不让你够到"}
{"time": 1751035503, "type": "recv", "message_id": "1435565590", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"代价并不重要\""}
{"time": 1751035504, "type": "recv", "message_id": "632138393", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我长这么矮）"}
{"time": 1751035517, "type": "recv", "message_id": "831214569", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=53277171][CQ:at,qq=1252219916] #那我跳起来"}
{"time": 1751035536, "type": "recv", "message_id": "1980301436", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“外面那些怪物”"}
{"time": 1751035542, "type": "recv", "message_id": "795514926", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你们有什么头绪”"}
{"time": 1751035554, "type": "recv", "message_id": "1589714934", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“完全没有头绪”"}
{"time": 1751035581, "type": "recv", "message_id": "1459930578", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你们注意一下维克多吧”"}
{"time": 1751035587, "type": "recv", "message_id": "86968053", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“他看上去不太正常”"}
{"time": 1751035591, "type": "recv", "message_id": "1912676808", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“怎么说”"}
{"time": 1751035697, "type": "recv", "message_id": "233550530", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“他对比起外面的怪物反倒更关心我的助手”"}
{"time": 1751035702, "type": "recv", "message_id": "804660705", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“难道不奇怪吗”"}
{"time": 1751035706, "type": "recv", "message_id": "414755210", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"在这种地方，那种怪物很正常。不足为奇。\""}
{"time": 1751035732, "type": "recv", "message_id": "1807514875", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "反倒是莉兹开了口，同时手中的笔也不见了。她看了一眼露儿，伸手摸了摸头"}
{"time": 1751035800, "type": "recv", "message_id": "870066495", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不要把我当小孩子，我是认真的”"}
{"time": 1751036017, "type": "recv", "message_id": "983430492", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"认真什么?\""}
{"time": 1751036069, "type": "recv", "message_id": "927972409", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不准再用那支笔了..”"}
{"time": 1751036115, "type": "recv", "message_id": "1761940386", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*点头"}
{"time": 1751036138, "type": "recv", "message_id": "881904767", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...\"她没说话，\"现状如此，医生能理解吗？\""}
{"time": 1751036144, "type": "recv", "message_id": "1477402135", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“是可以的”"}
{"time": 1751036149, "type": "recv", "message_id": "988981644", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“处境艰难”"}
{"time": 1751036213, "type": "recv", "message_id": "1104888545", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"有些手段必须要使用。\""}
{"time": 1751036274, "type": "recv", "message_id": "236632525", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“能够理解，但不必着急”"}
{"time": 1751036842, "type": "recv", "message_id": "2021278009", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“算了，先下楼吧..”"}
{"time": 1751036964, "type": "recv", "message_id": "1455729489", "deleted": false, "dect": {"host_id": null, "group_id": "1048556042", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "#牵起莉兹的手下楼"}
