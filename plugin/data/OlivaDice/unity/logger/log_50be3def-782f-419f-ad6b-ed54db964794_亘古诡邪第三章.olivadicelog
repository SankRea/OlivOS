{"time": 1768915792, "type": "recv", "message_id": "1523984102", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哼，如果你们帮我解决了这个问题，我就既往不咎”"}
{"time": 1768915807, "type": "recv", "message_id": "407776110", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不过，你们在行事时候千万不能破坏我的名誉”"}
