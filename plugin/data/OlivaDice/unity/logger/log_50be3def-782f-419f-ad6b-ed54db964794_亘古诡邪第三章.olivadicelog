{"time": 1768917691, "type": "recv", "message_id": "399195237", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "他欣喜的接过了剑"}
{"time": 1768917696, "type": "recv", "message_id": "598288256", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"希望你能承受住这把剑的重量。\""}
{"time": 1768917698, "type": "recv", "message_id": "303894836", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好了，我原谅那家伙了”"}
{"time": 1768917703, "type": "recv", "message_id": "851728291", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "神秘一笑"}
{"time": 1768917722, "type": "recv", "message_id": "518130059", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（2/3）"}
{"time": 1768917766, "type": "recv", "message_id": "1493508901", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "那你们打听到穆迪特在宴会厅的墙边站着的时候，一条厚实的织带抓住了她并将她拉到了天花板上"}
{"time": 1768917776, "type": "recv", "message_id": "896139922", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "然后你们注意到有一个梯子可以上去"}
