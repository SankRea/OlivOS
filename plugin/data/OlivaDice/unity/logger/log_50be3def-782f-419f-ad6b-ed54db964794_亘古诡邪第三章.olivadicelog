{"time": 1768915967, "type": "recv", "message_id": "1915297857", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（简单，我来跳不就是了）"}
{"time": 1768915969, "type": "recv", "message_id": "335488613", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“他们三个非常显眼，你们在大厅逛一逛就找到了”"}
{"time": 1768915988, "type": "recv", "message_id": "1329765226", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“那画像有没有”"}
