{"time": 1769000881, "type": "recv", "message_id": "605444174", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不客气不客气”"}
{"time": 1769000887, "type": "recv", "message_id": "1725890108", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "3362422751"}, "sender": {"id": "3362422751", "name": "维兹"}, "message": "“我等前来此地所为正是一哈基米尾巴草”"}
{"time": 1769000896, "type": "recv", "message_id": "972178041", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "3362422751"}, "sender": {"id": "3362422751", "name": "维兹"}, "message": "“不知尔等可有了解”"}
{"time": 1769000911, "type": "recv", "message_id": "256866985", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“你说的是帕德的尾巴？”"}
{"time": 1769000927, "type": "recv", "message_id": "757910524", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "3362422751"}, "sender": {"id": "3362422751", "name": "维兹"}, "message": "“你是对的。”"}
{"time": 1769000937, "type": "recv", "message_id": "979387591", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我们确实有一条”"}
{"time": 1769000968, "type": "recv", "message_id": "1006867251", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "3362422751"}, "sender": {"id": "3362422751", "name": "维兹"}, "message": "“可否交予我们？它对我们非常重要”"}
{"time": 1769001018, "type": "recv", "message_id": "667467380", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“虽然我很想给你们，但他对我们也很重要......主要是，我们有些缺食物，如果你可以帮我们找点食物，我就把他交给你们”"}
{"time": 1769001028, "type": "recv", "message_id": "1024161005", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“沿着这个树干往前走，有很多老虎”"}
