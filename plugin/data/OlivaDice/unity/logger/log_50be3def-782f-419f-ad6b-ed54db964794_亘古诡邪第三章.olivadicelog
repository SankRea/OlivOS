{"time": 1769006133, "type": "recv", "message_id": "969517041", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“你好，我们是来拜访食尸鬼王的”"}
{"time": 1769006178, "type": "recv", "message_id": "1590605078", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“额，我们的王早已死去，所以我们才一直被古革巨人欺负....”"}
{"time": 1769006187, "type": "recv", "message_id": "1593489284", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“如今老天有眼”"}
{"time": 1769006194, "type": "recv", "message_id": "1919066321", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "那我们是来祭拜食尸鬼王的"}
{"time": 1769006199, "type": "recv", "message_id": "667756053", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "他的墓地在哪"}
