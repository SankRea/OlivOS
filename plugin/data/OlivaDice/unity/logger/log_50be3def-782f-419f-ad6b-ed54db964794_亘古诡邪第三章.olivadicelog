{"time": 1768916031, "type": "recv", "message_id": "102546966", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "3362422751"}, "sender": {"id": "3362422751", "name": "维兹"}, "message": "（来了）"}
