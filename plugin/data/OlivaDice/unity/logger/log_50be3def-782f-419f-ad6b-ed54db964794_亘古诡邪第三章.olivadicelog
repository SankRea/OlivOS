{"time": 1768915816, "type": "recv", "message_id": "535451399", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "“都是哪几位需要我们去沟通？”"}
{"time": 1768915838, "type": "recv", "message_id": "448237466", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“所以是哪三个人”"}
{"time": 1768915865, "type": "recv", "message_id": "112450719", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那三位来宾分别是优雅的乌达兰达·裂骨者女士，富有影响力的商人阿迪文·泰格利特和平凡却动人的穆迪特女士”"}
{"time": 1768915893, "type": "recv", "message_id": "1259661176", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(言哥高论)"}
