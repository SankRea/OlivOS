{"time": 1769005861, "type": "recv", "message_id": "1815424219", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "那么接下来你们回去之后"}
{"time": 1769005870, "type": "recv", "message_id": "837775826", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "香风智乃又继续开始了读书"}
{"time": 1769005882, "type": "recv", "message_id": "1663700015", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "这次你们要找的是食尸鬼王的头骨"}
{"time": 1769005901, "type": "recv", "message_id": "1311485718", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "根据对异界不死生物的研究，幻梦境的食尸鬼比起现世中的同类更文明—虽然他们还是邪恶生物。他们拥有悠久的历史和由王族领导的群体"}
{"time": 1769005908, "type": "recv", "message_id": "737458136", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "根据对冷原的研究，在冷原与幻梦境的辩解居住着一些更为强大的食尸鬼。这些冷原食尸鬼比起他们瘦弱的同类更为精明。"}
{"time": 1769005930, "type": "recv", "message_id": "909266070", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "总之你们找到了下一个幻梦境的进入方法"}
{"time": 1769005939, "type": "recv", "message_id": "1765199939", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "一天是食尸鬼"}
{"time": 1769005941, "type": "recv", "message_id": "845075852", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "上buff"}
{"time": 1769005942, "type": "recv", "message_id": "496666090", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "一辈子都是食尸鬼！"}
{"time": 1769005968, "type": "recv", "message_id": "1125312702", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你们到了幻梦境 与古革巨人的交战之地"}
{"time": 1769006018, "type": "recv", "message_id": "1499961265", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“你好，我们是来拜访食尸鬼王的”"}
{"time": 1769006021, "type": "recv", "message_id": "39329480", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你们来到了这个幻梦境，当你们进来的时候，周围围绕着光，随后你们听到这样的声音"}
{"time": 1769006024, "type": "recv", "message_id": "1446754090", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“把食尸鬼王的头骨交出来。”"}
{"time": 1769006048, "type": "recv", "message_id": "302170830", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“伟大的奈亚斯托提普，能不能派勇者来拯救我们”"}
{"time": 1769006088, "type": "recv", "message_id": "393693382", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "随后光柱消散，你们看到了许多食尸鬼跪在地上看着你们“勇者大人，是勇者大人，奈亚大人派了勇者来拯救我们了”"}
{"time": 1769006099, "type": "recv", "message_id": "843395617", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我是来杀你们的。”"}
{"time": 1769006100, "type": "recv", "message_id": "1224625137", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "放眼望去，一大片一大片的食尸鬼"}
{"time": 1769006116, "type": "recv", "message_id": "234804656", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "其中有一个绿色的食尸鬼看着你们"}
