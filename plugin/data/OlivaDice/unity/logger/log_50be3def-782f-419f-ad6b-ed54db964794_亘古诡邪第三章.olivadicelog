{"time": 1768916819, "type": "recv", "message_id": "1116198382", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1258719565"}, "sender": {"id": "1258719565", "name": "雪狼"}, "message": "（跟她睡觉呢）"}
{"time": 1768916852, "type": "recv", "message_id": "445190668", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“所以现在跳舞？”"}
{"time": 1768916860, "type": "recv", "message_id": "1790159076", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"如果你下手轻一点的话，哦，下口。\""}
{"time": 1768916933, "type": "recv", "message_id": "2042026686", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "智乃和吸血鬼女士进行了共舞"}
{"time": 1768916949, "type": "recv", "message_id": "1707737797", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "在跳舞途中，脖子被咬了两下"}
{"time": 1768916953, "type": "recv", "message_id": "2053462409", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "随后她满意的离开了"}
{"time": 1768916973, "type": "recv", "message_id": "1748344272", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（hp上限-14）"}
{"time": 1768916975, "type": "recv", "message_id": "494770132", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1258719565"}, "sender": {"id": "1258719565", "name": "雪狼"}, "message": "（哇是我就更进一步了（不是））"}
{"time": 1768916999, "type": "recv", "message_id": "1290268918", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（1/3）"}
{"time": 1768917005, "type": "recv", "message_id": "918182452", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...\"捂着脖子，\"为什么不肯吸言言呢。\"自言自语"}
{"time": 1768917063, "type": "recv", "message_id": "548978333", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“收不收货”"}
{"time": 1768917078, "type": "recv", "message_id": "1558906473", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "\"额，什么货\""}
{"time": 1768917096, "type": "recv", "message_id": "903607873", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "掏出斩首大刀"}
{"time": 1768917104, "type": "recv", "message_id": "930829856", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“那要看你，能付得起多少钱了”"}
{"time": 1768917113, "type": "recv", "message_id": "1378758962", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“没有钱的话，以物易物也可以”"}
{"time": 1768917194, "type": "recv", "message_id": "892065968", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“额，这太贵重了，我这次出来身上没带什么东西”"}
{"time": 1768917203, "type": "recv", "message_id": "146352175", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“那没事了”"}
{"time": 1768917207, "type": "recv", "message_id": "1328292893", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“第二件事”"}
{"time": 1768917213, "type": "recv", "message_id": "13020304", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那你有什么?\""}
{"time": 1768917247, "type": "recv", "message_id": "1859558104", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“子爵要我们告诉你”"}
{"time": 1768917258, "type": "recv", "message_id": "840948058", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“今晚午夜，他不能和你共舞了”"}
{"time": 1768917276, "type": "recv", "message_id": "1734780689", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“？怎么可以这样，他简直是个骗子”"}
{"time": 1768917313, "type": "recv", "message_id": "1626404787", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"你与他的协商需要调到日后，他今晚要和自己的心上人共赏明月\""}
{"time": 1768917325, "type": "recv", "message_id": "1472543766", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不行，我今天必须要和他跳舞，这对我的声望非常重要，你们回去告诉他，必须改变主意，不然我就告诉所有人他是个骗子”"}
{"time": 1768917391, "type": "recv", "message_id": "899483260", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"希望你能好好考虑清楚，需要什么条件可以去问子爵。\""}
{"time": 1768917445, "type": "recv", "message_id": "1322701120", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好了，不要再说了，你们回去去告诉子爵吧，我非常生气”"}
{"time": 1768917454, "type": "recv", "message_id": "932232306", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“除非你们能帮我找一条财路”"}
{"time": 1768917514, "type": "recv", "message_id": "1014685023", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我觉得你们刚刚那把剑就不赖”"}
{"time": 1768917519, "type": "recv", "message_id": "137173085", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“我知道一条生财之道”"}
{"time": 1768917527, "type": "recv", "message_id": "1741612941", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“但是不能在大庭广众之下说”"}
{"time": 1768917541, "type": "recv", "message_id": "1269423178", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不行，你们把那把剑给我就行了”"}
{"time": 1768917545, "type": "recv", "message_id": "354466995", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“我们现在就可以去隐秘的地方聊一聊”"}
{"time": 1768917565, "type": "recv", "message_id": "1012077657", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。rd+16"}
{"time": 1768917565, "type": "reply", "message_id": "1012077657", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[沙耶]演奏出: 1D20+16={4}+16=20"}
{"time": 1768917584, "type": "recv", "message_id": "1726752242", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不行，我就要那把剑”"}
{"time": 1768917665, "type": "recv", "message_id": "1288064463", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“也可以”"}
{"time": 1768917669, "type": "recv", "message_id": "1671575795", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "3362422751"}, "sender": {"id": "3362422751", "name": "维兹"}, "message": ".rd+10"}
