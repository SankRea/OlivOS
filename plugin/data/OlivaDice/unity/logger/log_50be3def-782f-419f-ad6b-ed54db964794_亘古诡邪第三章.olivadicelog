{"time": 1768917901, "type": "recv", "message_id": "1323621949", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "穿过梯子可以来到60尺高的宴会厅的顶部走道"}
{"time": 1768917912, "type": "recv", "message_id": "179310924", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你们发现这里被黑暗笼罩"}
{"time": 1768917938, "type": "recv", "message_id": "317116961", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你发现这是魔法黑暗"}
