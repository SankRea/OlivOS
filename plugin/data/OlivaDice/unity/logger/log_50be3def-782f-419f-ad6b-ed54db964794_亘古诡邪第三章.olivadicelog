{"time": 1769004823, "type": "recv", "message_id": "980098204", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "拿起精通异能戒指-改"}
{"time": 1769004869, "type": "recv", "message_id": "1524727130", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "（以8级标准诗人来举例，装上帽子和战旗后，提振勇气的加值便能达到+4，获得对团队的巨大增益，同时还不妨碍自身的战斗（旗子挂长矛上），而且手持战旗的形象非常刚正朴实（贞德：没错就是我））"}
{"time": 1769004900, "type": "recv", "message_id": "2018194583", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "（【变体】晨花狂舞者（Dawnflower Dervish）能让你自身从提振勇气获得的加值翻倍，于是在8级时就能获得命中和伤害+8之高的战斗Buff，可以说是为所欲为。唯一的限制便是你要么就得使用长矛或者长棍作为你的主武器，以为列王旗提供载体，要么就要一手号角一手弯刀（和狂舞者送的狂舞专长配合良好））"}
{"time": 1769004903, "type": "recv", "message_id": "1073421704", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“话说你们有没有看到一个切里亚斯女性”"}
{"time": 1769004977, "type": "recv", "message_id": "449047153", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "\"并没有\""}
{"time": 1769004986, "type": "recv", "message_id": "799662009", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“她是个王牌猎人，有着黑色的头发和眉毛，鼻子上还有一道伤疤，她的名字叫做凯雯，一直在森林中进行永无止境的狩猎，非常的邪恶”"}
{"time": 1769005006, "type": "recv", "message_id": "492161670", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "\"\"我是罗娜兰，你们来这里做什么的？"}
{"time": 1769005007, "type": "recv", "message_id": "1924469513", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我一直在阻止她，但她似乎在6个月前完全失去了踪影”"}
{"time": 1769005022, "type": "recv", "message_id": "1050552879", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我听说凯雯来了这个幻梦境屠戮这里的居民”"}
{"time": 1769005032, "type": "recv", "message_id": "2076514780", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“所以我就来了这里，你们要去干嘛”"}
{"time": 1769005069, "type": "recv", "message_id": "887790828", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我们来取哈基米之尾”"}
{"time": 1769005080, "type": "recv", "message_id": "1069069928", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我是来毁掉这个幻梦境的”"}
{"time": 1769005092, "type": "recv", "message_id": "1941449697", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“看起来你不是那么邪恶的人”"}
{"time": 1769005105, "type": "recv", "message_id": "2110367166", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“让我加入你们吧”"}
{"time": 1769005120, "type": "recv", "message_id": "1581837330", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我想短暂和你们同行，也许可以找到些什么”"}
{"time": 1769005157, "type": "recv", "message_id": "643966886", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:image,file=7D247CEB77F7F6D82AC1AE1992CE978B.png,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhQwsqKhcYfAsdG1BK9pWcnK5aIlQBjUgAEg_woo-o3K3-mckgMyBHByb2RQgL2jAVoQ9pFyh4TN4BP1cXnHtLK1GXoCJjWCAQJuag&amp;rkey=CAMSMNSbytpIEjlHpnADUEYichodlI-GoayoA78xtaYh0xD00NVdzoj3M7dyrOQdTtS9xA,file_size=16468]"}
{"time": 1769005236, "type": "recv", "message_id": "1453671229", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"随你的便。”"}
