{"time": 1769005720, "type": "recv", "message_id": "16046369", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "不过和普通的不同，里面是葡萄酒"}
