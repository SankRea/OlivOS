{"time": 1768920356, "type": "recv", "message_id": "1283503943", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "\"谢谢你们救了我\"她看起来楚楚可怜"}
{"time": 1768920370, "type": "recv", "message_id": "1174272159", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“阿尔托莉雅，你可以下去找梅菲斯了。”"}
{"time": 1768920600, "type": "recv", "message_id": "277330089", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "梅菲斯身边落了几只蜘蛛包围着她，但晕了过去"}
{"time": 1768920614, "type": "recv", "message_id": "1906094719", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "先补刀"}
{"time": 1768920615, "type": "recv", "message_id": "1975408098", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "商人表示听不懂你在说什么"}
{"time": 1768920619, "type": "recv", "message_id": "1863227116", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "3362422751"}, "sender": {"id": "3362422751", "name": "维兹"}, "message": "*下楼开杀"}
{"time": 1768920672, "type": "recv", "message_id": "1990904469", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=1283503943]（）"}
{"time": 1768920682, "type": "recv", "message_id": "1809668321", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "“你是穆迪特小姐吗？”"}
{"time": 1768920684, "type": "recv", "message_id": "1339024715", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“好的，你为什么会被绑上来。”"}
{"time": 1768920690, "type": "recv", "message_id": "227700808", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "“为什么这些蜘蛛只袭击了你？”"}
{"time": 1768920701, "type": "recv", "message_id": "340774903", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯，是我，谢谢两位，我也不知道，为什么要绑我”"}
{"time": 1768920716, "type": "recv", "message_id": "212061316", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“你的身上带着什么吗?”"}
{"time": 1768920724, "type": "recv", "message_id": "595160225", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "她摇摇头"}
{"time": 1768920732, "type": "recv", "message_id": "2128172730", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我只是单纯的靠墙站着”"}
{"time": 1768920756, "type": "recv", "message_id": "1674146147", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“先说说看子爵的事吧，你和他约定了舞会？”"}
{"time": 1768920773, "type": "recv", "message_id": "1959928091", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...确实有这件事”"}
{"time": 1768920795, "type": "recv", "message_id": "1288748359", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“出于什么理由？”"}
{"time": 1768920836, "type": "recv", "message_id": "774908772", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯，子爵之前邀请的我”"}
{"time": 1768920864, "type": "recv", "message_id": "2134137659", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“不管是什么理由，他现在放弃你了，他想要和自己的心上人跳舞。”"}
{"time": 1768920864, "type": "recv", "message_id": "1537690058", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“但现在经过这件事，我已经不太想待在这里了，但我有些不敢拒绝他”"}
{"time": 1768920876, "type": "recv", "message_id": "502133577", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=2134137659]“是吗”她松了一口气"}
{"time": 1768920881, "type": "recv", "message_id": "1387270027", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那你现在就可以离开了。\""}
{"time": 1768920891, "type": "recv", "message_id": "1776217478", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“谢谢各位...”"}
{"time": 1768920904, "type": "recv", "message_id": "1234770766", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯。\""}
{"time": 1768920916, "type": "recv", "message_id": "64519773", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（刚才玩了一把连拨击锤薇恩，把对面打投降了）"}
{"time": 1768920925, "type": "recv", "message_id": "1114020307", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=1387270027]居然没有loot"}
{"time": 1768920948, "type": "recv", "message_id": "1371000798", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "（还行）"}
{"time": 1768920957, "type": "recv", "message_id": "1431041428", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "(3/3"}
{"time": 1768920994, "type": "recv", "message_id": "1011519054", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "涂山言言开启任意门带我和罗娜兰出现在子爵面前"}
{"time": 1768921049, "type": "recv", "message_id": "126062664", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“怎么样，事情办的怎么样了”"}
{"time": 1768921086, "type": "recv", "message_id": "211421694", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "“三个人都搞定了，他们不会在日落时来打扰子爵你了。”"}
{"time": 1768921112, "type": "recv", "message_id": "928319219", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "“另外你这儿天花板该清理一下了”"}
{"time": 1768921124, "type": "recv", "message_id": "1382999247", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“确实”"}
{"time": 1768921206, "type": "recv", "message_id": "1282164318", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不错，刚刚我的仆人跟在你们身后，已经完整见识了整个过程，你们做的确实不错”他拍拍手，来了个仆人为你们带来了玺戒，同时还带了一个+4强体腰带“这是给你们的额外奖励”"}
{"time": 1768921314, "type": "recv", "message_id": "54748066", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。rd+18"}
{"time": 1768921314, "type": "reply", "message_id": "54748066", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[沙耶]演奏出: 1D20+18={19}+18=37"}
{"time": 1768921439, "type": "recv", "message_id": "17873742", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "3362422751"}, "sender": {"id": "3362422751", "name": "维兹"}, "message": "[CQ:image,file=AE6F60D4C798F46BAAF1425ED35ECCF8.png,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhSahyjVj3kHp18Z4V_wnxZYHIbathj9vgIg_woo-oH477GakgMyBHByb2RQgL2jAVoQETwmonKCqbxv68v4mEx2BnoCtTSCAQJneg&amp;rkey=CAMSMOsOu5jViMhJnVLw5u2xzLdfxx0I8E5bab3wcCC0Kq92LJFImdKf7pRlD4pbgKgBqg,file_size=40829]"}
{"time": 1768921499, "type": "recv", "message_id": "1768804035", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "3362422751"}, "sender": {"id": "3362422751", "name": "维兹"}, "message": "[CQ:image,file=A06CF7B543A842C98A452A5BB39F71ED.png,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhQeHVw0q3aM933n4uN7t2wV_7HxQRjxTSD_Ciig982MspqSAzIEcHJvZFCAvaMBWhDWKjuPNPWDRQgF5CIRRFM6egLIHoIBAmd6&amp;rkey=CAMSMOsOu5jViMhJnVLw5u2xzLdfxx0I8E5bab3wcCC0Kq92LJFImdKf7pRlD4pbgKgBqg,file_size=9969]"}
{"time": 1768921517, "type": "recv", "message_id": "392819103", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=54748066][CQ:at,qq=1252219916] 那你发现商人周围似乎有些人看起来也是商人的人，看那个商人的眼神不太友善，似乎是竞争对手，也许可以帮到你们"}
{"time": 1768921563, "type": "recv", "message_id": "541270968", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "[CQ:reply,id=1282164318][CQ:at,qq=1040972910] “感谢子爵打人”"}
{"time": 1768921564, "type": "recv", "message_id": "927046501", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "大人"}
{"time": 1768921598, "type": "recv", "message_id": "973980574", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“看起来，你们对那个叫做阿迪文·泰格利特的有一点意见”"}
{"time": 1768921628, "type": "recv", "message_id": "1463055226", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“那个奸商，刚刚骗走了我的剑，我们或许可以一起想办法弄他一票”"}
{"time": 1768921630, "type": "recv", "message_id": "1308609269", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "3362422751"}, "sender": {"id": "3362422751", "name": "维兹"}, "message": "[CQ:image,file=473D933D877230906245AC374F79A446.png,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhTQYrfjyrVcqXvUn7zICMr7RVD0tBiYzwMg_woopIuVy7KakgMyBHByb2RQgL2jAVoQdylIp-atWNZM7ZdvQZ9TXnoCLUmCAQJneg&amp;rkey=CAMSMOsOu5jViMhJnVLw5u2xzLdfxx0I8E5bab3wcCC0Kq92LJFImdKf7pRlD4pbgKgBqg,file_size=59288]"}
{"time": 1768921637, "type": "recv", "message_id": "158970985", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那把剑我也看到了，看得我有些眼红”"}
{"time": 1768921675, "type": "recv", "message_id": "1981662380", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那你打算怎么做”"}
{"time": 1768921691, "type": "recv", "message_id": "1835717659", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“如果你们出的起钱的话，我们一起弄死他，然后五五分成”"}
{"time": 1768921725, "type": "recv", "message_id": "816931694", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“额，这个方法好像有些过于激进了”"}
{"time": 1768921729, "type": "recv", "message_id": "10125382", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我不太赞同”"}
{"time": 1768921741, "type": "recv", "message_id": "18942301", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“那你有什么办法把那把剑骗过来吗”"}
{"time": 1768921746, "type": "recv", "message_id": "1494517049", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我不知道啊，你们有办法的话，我可以帮忙”"}
{"time": 1768921755, "type": "recv", "message_id": "326646475", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“或者，我只需要你们帮我把那个商人骗到偏僻的角落”"}
{"time": 1768921759, "type": "recv", "message_id": "638000292", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“我自会解决”"}
{"time": 1768921771, "type": "recv", "message_id": "1186636051", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“不过这样的话，你们的报酬，就没有多少了”"}
{"time": 1768921779, "type": "recv", "message_id": "1614046723", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“没事，看他赚钱比我亏钱还难受”"}
{"time": 1768921793, "type": "recv", "message_id": "1168251570", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "\"可以，那你去和他交涉"}
{"time": 1768921802, "type": "recv", "message_id": "634907854", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“把他骗到阁楼”"}
{"time": 1768921809, "type": "recv", "message_id": "776220524", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“或者门外”"}
{"time": 1768921811, "type": "recv", "message_id": "1610978710", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "听到阁楼，他脸色大变"}
