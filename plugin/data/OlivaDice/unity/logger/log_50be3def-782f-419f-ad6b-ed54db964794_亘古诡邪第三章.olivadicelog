{"time": 1769005539, "type": "recv", "message_id": "1876327373", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“再见了各位，有缘再见”"}
{"time": 1769005590, "type": "recv", "message_id": "1786374362", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "祖各非常非常感谢你们的老虎肉，把猫之尾送给了你们"}
{"time": 1769005592, "type": "recv", "message_id": "81913535", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "除此之外"}
{"time": 1769005606, "type": "recv", "message_id": "2141924004", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "还送了一们一个灵药酒尊“感谢各位大英雄”"}
