{"time": 1769006225, "type": "recv", "message_id": "433818577", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "等我祭拜完你们的王"}
{"time": 1769006231, "type": "recv", "message_id": "375377017", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "我就去温酒斩巨人"}
