{"time": 1759849373, "type": "recv", "message_id": "519984425", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "（那你有三环？）"}
