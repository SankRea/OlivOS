{"time": 1761224473, "type": "recv", "message_id": "1507107607", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"闪开，不要挡住英雄的征途。\""}
{"time": 1761224519, "type": "recv", "message_id": "1050901362", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "（？）"}
