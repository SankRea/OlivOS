{"time": 1761231393, "type": "recv", "message_id": "178514537", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（不要在意立绘（）"}
{"time": 1761231501, "type": "recv", "message_id": "1027848973", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“所以几位是？”"}
{"time": 1761231518, "type": "recv", "message_id": "1784100415", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "（这俩人没听见外面打架吗Orz）"}
{"time": 1761231532, "type": "recv", "message_id": "538443344", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（可能喝酒喝嗨了（）"}
{"time": 1761231550, "type": "recv", "message_id": "10895245", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "*我们是来找这里的管家梅丽森小姐的，请问二位是？"}
{"time": 1761231562, "type": "recv", "message_id": "1329201164", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "（太夸张了）"}
{"time": 1761231650, "type": "recv", "message_id": "1306333635", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我们听说皇家御史来调查劳尔斯爵士了，对此非常感兴趣，想要了解一下详情，结果劳尔斯就把我们安顿在这里不闻不问，不知道什么意思，我们想走，外面的那些很野蛮的人还不让我们走”"}
{"time": 1761231684, "type": "recv", "message_id": "1944867628", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我们只能在这里借酒消愁”"}
{"time": 1761231710, "type": "recv", "message_id": "1332587237", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "“方便二位为什么对这件事感兴趣吗？”"}
{"time": 1761231715, "type": "recv", "message_id": "1007341657", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "（方便问下）"}
{"time": 1761231800, "type": "recv", "message_id": "285091314", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不瞒你们说，劳尔斯爵士因为一些神秘学方面的事情被调查，可是一桩丑闻，带回去肯定可以卖个大价钱的，可能因为我们的目的被发现了，他才不让我们走”"}
{"time": 1761231901, "type": "recv", "message_id": "506106832", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "“二位是记者，或者说情报商？”"}
{"time": 1761231952, "type": "recv", "message_id": "1970780869", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“差不多吧，而且我们本来就对这种事情感兴趣”"}
{"time": 1761231965, "type": "recv", "message_id": "498470061", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“也有一点个人爱好在里面”"}
{"time": 1761232052, "type": "recv", "message_id": "381712412", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "“二位在这里多久了？”"}
{"time": 1761232081, "type": "recv", "message_id": "851400222", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“一个多月了吧，爵士也是一个月前走的”"}
{"time": 1761232100, "type": "recv", "message_id": "449183407", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“所以几位来这里是来做什么的”"}
