{"time": 1760359803, "type": "recv", "message_id": "1159521943", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "*检查一下床铺，有多久没用过了，是否有其他痕迹"}
