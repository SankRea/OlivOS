{"time": 1759849443, "type": "recv", "message_id": "1549652856", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(但是我可以拓审判者的表)"}
{"time": 1759849460, "type": "recv", "message_id": "330230232", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "（那你现在也没有啊）"}
{"time": 1759849468, "type": "recv", "message_id": "1252235799", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（审判者也是三环啊）"}
{"time": 1759849489, "type": "recv", "message_id": "1175587466", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（而且你应该知道她为什么得病了吧，哪有那么简单（）"}
{"time": 1759849560, "type": "recv", "message_id": "460840779", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好吧，那就之后再说吧。\""}
{"time": 1759849595, "type": "recv", "message_id": "1634339032", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不管怎样，还是谢谢你们....”"}
