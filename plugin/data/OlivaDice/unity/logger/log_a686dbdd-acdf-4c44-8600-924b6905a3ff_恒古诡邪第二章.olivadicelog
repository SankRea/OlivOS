{"time": 1758459125, "type": "recv", "message_id": "1393779353", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"看上去还很仇视我们。\""}
{"time": 1758459126, "type": "recv", "message_id": "1626818684", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（好的）"}
{"time": 1758459128, "type": "recv", "message_id": "860689096", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"什么情况\""}
{"time": 1758459136, "type": "recv", "message_id": "1164935721", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“或许，是过去的罪孽吧”"}
{"time": 1758459146, "type": "recv", "message_id": "1352910397", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“我真是一个罪孽深重而不自知的女人啊”"}
{"time": 1758459153, "type": "recv", "message_id": "825737535", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我也不知道啊...“温特摇摇头“算了，我们还是先去找御史吧”"}
{"time": 1758459198, "type": "recv", "message_id": "1446263034", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呃，虽然不懂你在说什么，但是有罪大概是真的。\""}
{"time": 1758459207, "type": "recv", "message_id": "1987731280", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"毕竟我们也在替那谁做事\""}
{"time": 1758459500, "type": "recv", "message_id": "847263478", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"走?\""}
{"time": 1758459501, "type": "recv", "message_id": "1593425348", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“算了，现在聊这些也没什么用，起码你们现在来说是个好人...”"}
{"time": 1758459534, "type": "recv", "message_id": "353805745", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“是的”"}
{"time": 1758459542, "type": "recv", "message_id": "1455122230", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“过去罪孽深重的我已经死了”"}
{"time": 1758459622, "type": "recv", "message_id": "1997021305", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我虽然觉得逃不开那些，不过既然你们都这么说了。\""}
{"time": 1758459640, "type": "recv", "message_id": "853330168", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"不管，先去见一见?\""}
{"time": 1758459761, "type": "recv", "message_id": "1094608244", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那走吧....”说完温特便带着你们往无忧机构去，御史的所在地"}
{"time": 1758459792, "type": "recv", "message_id": "110086427", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“好的”"}
{"time": 1758459928, "type": "recv", "message_id": "876789897", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你们很快便来到了一个大型的木制建筑前，这里看起来有点偏僻，显得十分幽静，门是关着的"}
{"time": 1758460037, "type": "recv", "message_id": "1784934842", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "温特上前敲了敲门，很快一个年轻的女子出来开了门，看见温特她显得十分热情“修女大人，你回来了啊，我还担心你出了什么事呢，这么多天了也没收到你的消息“然后她看到了跟在温特身后的你们，有一点点震惊，但很快便压制了下去"}
{"time": 1758460055, "type": "recv", "message_id": "152647036", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“几位这边走吧”她礼貌的对你们发出邀请"}
{"time": 1758460094, "type": "recv", "message_id": "978762204", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“好的”"}
{"time": 1758460100, "type": "recv", "message_id": "1096547780", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"为什么这么看我?\""}
{"time": 1758460105, "type": "recv", "message_id": "419428", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "（现在几点了我问你）"}
{"time": 1758460106, "type": "recv", "message_id": "79354507", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "（半夜吗）"}
{"time": 1758460108, "type": "recv", "message_id": "1839184142", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "（还是第二天）"}
{"time": 1758460558, "type": "recv", "message_id": "1109336024", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（等一下）"}
{"time": 1758460563, "type": "recv", "message_id": "1721189575", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我找个东西）"}
{"time": 1758461274, "type": "recv", "message_id": "177426539", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（有点忙，今晚先off吧）"}
{"time": 1758461372, "type": "recv", "message_id": "1310203436", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": ".log off"}
{"time": 1758461516, "type": "reply", "message_id": "263751953", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "继续记录乐谱"}
{"time": 1758461595, "type": "recv", "message_id": "1199536060", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=1096547780]“抱歉小姐...对不起”[CQ:at,qq=1252219916]"}
{"time": 1758461606, "type": "recv", "message_id": "1602229504", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=419428]（晚上九点吧）[CQ:at,qq=2422497068]"}
{"time": 1758461624, "type": "recv", "message_id": "1038790955", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "？"}
{"time": 1758461628, "type": "recv", "message_id": "228846444", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "（何意）"}
{"time": 1758461638, "type": "recv", "message_id": "630850053", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（就是游戏内也是晚上九点）"}
{"time": 1758461676, "type": "recv", "message_id": "225046600", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "（那现在该干嘛）"}
{"time": 1758461754, "type": "recv", "message_id": "2027446279", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"为什么?我做过什么吗？\""}
{"time": 1758462163, "type": "recv", "message_id": "1037126818", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“抱歉，失礼了，这些不是我该说的，具体的你等会问瑟莎蒂亚大人吧，几位，这边走”"}
{"time": 1758462219, "type": "recv", "message_id": "606464557", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“好的”"}
{"time": 1758462323, "type": "recv", "message_id": "300043433", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "她带你们来到舒适的大堂，给你们端来了几杯茶“几位请慢用，我去叫瑟莎蒂亚大人过来”"}
{"time": 1758462327, "type": "recv", "message_id": "486851071", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好的...\""}
{"time": 1758462532, "type": "recv", "message_id": "412866995", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "很快，那位被称为瑟莎蒂亚的人过来了，不过她显得有些憔悴"}
{"time": 1758462578, "type": "recv", "message_id": "1702194205", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:image,file=F13A1A5D4D3EBABA8FA891DB0087E98B.png,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhS2h80oZA_Sywa0aOpoi5XurZnjcBiR5Q4g_woou9yLyv_pjwMyBHByb2RQgL2jAVoQC6iloqDv2ZAnNXshguRiEHoCuKSCAQJuag&amp;rkey=CAISMDlNfAfltRCP1ZDfVLJZTI6Y_g1CZcj4oQNxaH-KvJQSWXw9TejSbJ0pkPX27SzmOA,file_size=242321]"}
{"time": 1758462609, "type": "recv", "message_id": "97699465", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“怎么是你们”她看见你们三个有些惊讶"}
{"time": 1758462649, "type": "recv", "message_id": "1728180232", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "[CQ:image,summary=&#91;动画表情&#93;,file=11DF10A2E401E8E2818ECF27E814E059.jpg,sub_type=1,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhQY-5LunQBjX6Hymf7ah1q6rAoRNRiPuAIg_woo_oSr7P_pjwMyBHByb2RQgL2jAVoQ8-4isTY_5Yi_pKYmGgZkinoClH-CAQJneg&amp;rkey=CAISMDlNfAfltRCP1ZDfVLJZTI6Y_g1CZcj4oQNxaH-KvJQSWXw9TejSbJ0pkPX27SzmOA,file_size=39951]"}
{"time": 1758462665, "type": "recv", "message_id": "2108666591", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（因为这其实是个侦探机构）"}
{"time": 1758462910, "type": "recv", "message_id": "1116775647", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呃，你是?\""}
{"time": 1758462923, "type": "recv", "message_id": "28764350", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“我们最近失去了一段时间的记忆”"}
{"time": 1758463018, "type": "recv", "message_id": "1476158418", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我可以为她们作证，瑟莎蒂亚”温特说到“她们确实失忆了，而且如果没有她们的话，我大概也回不来了....她们现在是非常善良的人...”"}
{"time": 1758463105, "type": "recv", "message_id": "1832188669", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "瑟莎蒂亚虽然还是有些对你们感到怀疑，但态度明显好了很多“也不是什么大事..你们之前为劳尔斯爵士效力，然后对我的下属说过很过分的话....不过居然温特为你们作担保了，我也没什么话要说...”"}
{"time": 1758463142, "type": "recv", "message_id": "252942711", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "温特看到情况逐渐稳定下来了松了一口气“对了，瑟莎蒂亚，御史大人呢，好像没看见她”"}
{"time": 1758463244, "type": "recv", "message_id": "1381166999", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呃，我知道这事，但是我们做了什么?\""}
{"time": 1758463354, "type": "recv", "message_id": "1026586509", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“你们之前。。。emmm，在劳尔斯的手下做了挺多欺男霸女的事情.....不过有劳尔斯庇护你们，你们也没什么事..”"}
{"time": 1758463601, "type": "recv", "message_id": "2050480330", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呃...\""}
{"time": 1758463700, "type": "recv", "message_id": "1266644744", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=252942711]“御史大人...哎，最近镇子上发生了很多事，自从劳尔斯离开之后，镇上频频发生一些绑架案，而且大部分失踪的都是管理人员，治安官不知道什么原因离开了这里.....民兵队由于一直拖欠工资不发也解散了，御史大人去劳尔斯的庄园调查，也一去不返....”"}
{"time": 1758463830, "type": "recv", "message_id": "1619365388", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "（那很坏了）"}
{"time": 1758463832, "type": "recv", "message_id": "1193350969", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"你们的意思是，让我们去找劳尔斯(\""}
{"time": 1758463857, "type": "recv", "message_id": "499834186", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（不是）"}
{"time": 1758463883, "type": "recv", "message_id": "1913765433", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“镇上的镇民不在相信原有的领导人，希望无眠机构可以负责保护镇子，但我们人手实在不足...”她露出一个苦笑“三位失忆了，是回来要找自己的记忆吗....”"}
{"time": 1758463898, "type": "recv", "message_id": "193552343", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“是的”"}
{"time": 1758463915, "type": "recv", "message_id": "1056654612", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“所以我们会在这里待上一段时间”"}
{"time": 1758463924, "type": "recv", "message_id": "1099710705", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“如果你们很缺少人手的话”"}
{"time": 1758463930, "type": "recv", "message_id": "987446209", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"当然，我必须直面自己的过去\""}
{"time": 1758463937, "type": "recv", "message_id": "1819322463", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“报酬合理的话我们三人也可以助你们一臂之力”"}
{"time": 1758463958, "type": "recv", "message_id": "60416019", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“真的吗，你们愿意帮忙吗.”她看起来很惊喜的样子"}
{"time": 1758464138, "type": "recv", "message_id": "102853208", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“只要你给钱”"}
{"time": 1758464139, "type": "recv", "message_id": "35862227", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...只是现在确实可以帮忙。\""}
{"time": 1758464150, "type": "recv", "message_id": "1019871321", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"这也算分内之事\""}
{"time": 1758464255, "type": "recv", "message_id": "962499209", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“最近镇子上很多人失踪，大家都说是棘石女巫干的，但我觉得这些只是迷信，但有个渔夫说距离小镇一里的地方他看见了一个发光的小洞穴，大家都说那是女巫回来的征兆...三位可以去调查一下么....我大概可以给出3000gp的报酬”"}
{"time": 1758464514, "type": "recv", "message_id": "601234255", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"有人带吗\""}
{"time": 1758464621, "type": "recv", "message_id": "406358867", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“每人3k吗”"}
{"time": 1758464623, "type": "recv", "message_id": "1450443992", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我的意思是，有人带我们一起过去?\""}
{"time": 1758464641, "type": "recv", "message_id": "74108187", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“一共3k....”"}
{"time": 1758464659, "type": "recv", "message_id": "789599397", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“也可以吧”"}
{"time": 1758464669, "type": "recv", "message_id": "1516052643", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我可以在地图上给你们把那个点标记一下”"}
{"time": 1758465007, "type": "recv", "message_id": "1461243840", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"行，看看在哪。\""}
{"time": 1758465036, "type": "recv", "message_id": "1513356024", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "对方给你们标记了一处地点"}
{"time": 1758465065, "type": "recv", "message_id": "531052401", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不过现在天色已经晚了，三位先休息一下吧”"}
