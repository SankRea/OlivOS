{"time": 1758203398, "type": "recv", "message_id": "167747285", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "（你在看比赛吗）"}
{"time": 1758203399, "type": "recv", "message_id": "1333168379", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“对的对的，我有预感，你们肯定能拯救瑟拉什摩尔于水火”"}
