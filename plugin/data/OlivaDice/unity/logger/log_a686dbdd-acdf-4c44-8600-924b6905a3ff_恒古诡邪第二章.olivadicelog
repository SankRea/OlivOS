{"time": 1759847093, "type": "recv", "message_id": "1777436876", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“晚上好啊，梅菲斯，智乃，罗娜兰”"}
{"time": 1759847099, "type": "recv", "message_id": "61159822", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "“似乎我们曾经相当亲近是吗？”"}
{"time": 1759847102, "type": "recv", "message_id": "907531973", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"是这么回事，不过...\"停住话头"}
{"time": 1759847124, "type": "recv", "message_id": "1461618703", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那当然，我们是好朋友啊”"}
{"time": 1759847186, "type": "recv", "message_id": "1208470883", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你们跟随格温走进她的房子，不过看起来有些老旧，灯光也忽明忽暗的，而格温则时不时的咳嗽一下，然后走起路来有点摇摇晃晃的"}
{"time": 1759847286, "type": "recv", "message_id": "119391731", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=907531973]“不过？”"}
{"time": 1759847360, "type": "recv", "message_id": "1247326470", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没什么，罗娜兰说得对\""}
{"time": 1759847435, "type": "recv", "message_id": "487218171", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "“也不知道哪个劳伦斯爵士让我们干了什么，我们三个确实是一点都记不起来了”"}
{"time": 1759847450, "type": "recv", "message_id": "417676749", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "（被高纬度超智能夺舍了）"}
{"time": 1759847478, "type": "recv", "message_id": "337992921", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "“能请你讲讲我们之前是怎样生活的吗？”"}
{"time": 1759847502, "type": "recv", "message_id": "312025620", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "“另外在我们出事之前，你是否有注意到什么不同寻常的情况？”"}
{"time": 1759847568, "type": "recv", "message_id": "1301976611", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“你们好像之前确实提过在为劳尔斯爵士做事...但具体做了什么并没有给我讲”"}
{"time": 1759847686, "type": "recv", "message_id": "869266502", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "“这样吗……”"}
{"time": 1759847727, "type": "recv", "message_id": "2069177103", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“抱歉...我有点没用，帮不上什么忙...至于我们的过去，你们对我非常好，想办法帮我治病...但是感觉我已经没有几天可活了，我连报答你们都做不到”格温说着说着便哭了出来"}
{"time": 1759847747, "type": "recv", "message_id": "502808743", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "“说起来，你身上是什么病啊？”"}
{"time": 1759847751, "type": "recv", "message_id": "1510744916", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呃，你先别急。我总觉得想救你是很简单的事，你说呢，罗兰娜\""}
{"time": 1759847794, "type": "recv", "message_id": "1066314505", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（让我想想）"}
{"time": 1759847897, "type": "recv", "message_id": "2007880606", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "“先听听情况吧”"}
{"time": 1759847909, "type": "recv", "message_id": "1992888498", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "（这玩意模组没写吗）"}
{"time": 1759847922, "type": "recv", "message_id": "2060670014", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "(因为这块是自定义吧（)"}
{"time": 1759848119, "type": "recv", "message_id": "807373592", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "（其实主要看让不让一个移除疾病治好吧）"}
{"time": 1759848126, "type": "recv", "message_id": "963561732", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "（不是莫名其妙变成娃娃了？）"}
{"time": 1759848132, "type": "recv", "message_id": "816770371", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我小时候做过一个噩梦...梦里看到了一个好像穿着黄衣服的人,醒来之后不知道为什么，我就感觉越来越难受，你们帮我找遍了各种医生也没有查出病因...”"}
{"time": 1759848227, "type": "recv", "message_id": "1517620220", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“虽然外表看起来好像没什么事，但我感觉我的体力好像越来越弱...咳咳咳..大概应该活不了多久了，感谢你们之前一直以来的照顾...”"}
{"time": 1759848290, "type": "recv", "message_id": "131077523", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "*看了看队友“又是黄衣服的人呢”"}
{"time": 1759848408, "type": "recv", "message_id": "1498670196", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "“我现在怎么觉得全是劳伦斯爵士的问题”"}
{"time": 1759848423, "type": "recv", "message_id": "1513320110", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "“我问一下啊，咱们这儿像你一样的人还有吗？”"}
{"time": 1759848436, "type": "recv", "message_id": "1535396013", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（劳尔斯）"}
{"time": 1759848446, "type": "recv", "message_id": "619390907", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好像没有其他人了....”"}
{"time": 1759848556, "type": "recv", "message_id": "829164160", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=807373592]（dc应该有点高）[CQ:at,qq=1009793416]"}
{"time": 1759848585, "type": "recv", "message_id": "494168830", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "“嗯……你小时候和劳尔斯爵士家有过瓜葛吗？”"}
{"time": 1759848618, "type": "recv", "message_id": "266117077", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“应该没有吧...我几乎都没见过他”"}
{"time": 1759848736, "type": "recv", "message_id": "1148077327", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "“那就不知道了，不过总之我们醒来后也遭遇了一些黄衣服的人，不知道和你的病有没有关系。总之你再坚持一段时间，或许就有办法了”"}
{"time": 1759848775, "type": "recv", "message_id": "834414006", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "“另外你还需要生活资金吗？我们也可以稍微支援你一点。”"}
{"time": 1759848785, "type": "recv", "message_id": "1488237301", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...谢谢你们，我会努力活下去的....”"}
{"time": 1759848822, "type": "recv", "message_id": "1508131084", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=834414006][CQ:at,qq=1009793416] “哎？不用了...你们之前给我的钱还有一些，你们现在应该比我更用的上吧”"}
{"time": 1759848982, "type": "recv", "message_id": "2138501966", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "“那行，我们明天准备去冰流堡探一探。你觉得关于我们的过去，还有什么需要现在告诉给我们的吗？”"}
{"time": 1759849048, "type": "recv", "message_id": "2041797841", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“应该没有什么特别重要的事情了....”"}
{"time": 1759849109, "type": "recv", "message_id": "1986613731", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好哦，那要我给你用一下移除疾病的法术吗？\""}
{"time": 1759849110, "type": "recv", "message_id": "326293754", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "“行，那我们也回去休息了”（先知我记得是已知人吧？）"}
{"time": 1759849119, "type": "recv", "message_id": "1098563252", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "（你有移除疾病？）"}
{"time": 1759849167, "type": "recv", "message_id": "1076205102", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "（你有移除疾病？）"}
{"time": 1759849185, "type": "recv", "message_id": "1024854837", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（你除非出20）"}
{"time": 1759849242, "type": "recv", "message_id": "404811270", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我是秘术)"}
{"time": 1759849247, "type": "recv", "message_id": "1375414218", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(又不是先知)"}
{"time": 1759849256, "type": "recv", "message_id": "1205655882", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哎？智乃想试的话就试试吧...虽然应该不太可能成功”"}
{"time": 1759849266, "type": "recv", "message_id": "391515150", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=1024854837]（出20也不一定）"}
{"time": 1759849332, "type": "recv", "message_id": "617537911", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "（秘术是啥来着？基础职业？）"}
{"time": 1759849337, "type": "recv", "message_id": "1972787359", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "（进阶）"}
