{"time": 1758203508, "type": "recv", "message_id": "1473102402", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "：“你画吧”"}
{"time": 1758203538, "type": "recv", "message_id": "663782622", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“你人真好...”她开始了快乐的绘画"}
{"time": 1758203557, "type": "recv", "message_id": "517829179", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "过了一段时间，画好了，你们收到了来自她的100gp"}
{"time": 1758203563, "type": "recv", "message_id": "1737150294", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（loot你们自己记吧）"}
{"time": 1758203573, "type": "recv", "message_id": "1770670250", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呃。\""}
{"time": 1758203606, "type": "recv", "message_id": "1206113300", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“对了，你们来瑟拉什摩尔是干什么的，之前好像没见过你们”"}
{"time": 1758203627, "type": "recv", "message_id": "365094491", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我要是记得，我也不会在这里了。\""}
{"time": 1758203656, "type": "recv", "message_id": "1877442289", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“我也 不记得了”"}
{"time": 1758203864, "type": "recv", "message_id": "2037779586", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哎？你们来这里是去找失去的记忆吗，好标准的主角模版”"}
{"time": 1758203896, "type": "recv", "message_id": "1346552522", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那你们有地方住吗，不介意的话，可以先住我家，招待未来的大英雄什么的..想想就开心”"}
{"time": 1758204023, "type": "recv", "message_id": "1631642330", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“好的”"}
{"time": 1758204028, "type": "recv", "message_id": "313336207", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“感谢你，心地善良的小姐”"}
{"time": 1758204106, "type": "recv", "message_id": "427508433", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“没关系啦，你们刚刚也帮了我呢...”"}
