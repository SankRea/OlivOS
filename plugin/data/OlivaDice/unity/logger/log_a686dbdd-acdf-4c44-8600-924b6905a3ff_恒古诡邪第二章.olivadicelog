{"time": 1761140788, "type": "recv", "message_id": "498154465", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（现在回答问题的是那个被抓起来的无辜市民）"}
{"time": 1761140821, "type": "recv", "message_id": "2073342373", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": "（行吧）"}
