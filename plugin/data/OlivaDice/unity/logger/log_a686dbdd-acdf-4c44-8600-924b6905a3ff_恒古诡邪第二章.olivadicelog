{"time": 1761140837, "type": "recv", "message_id": "659152858", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "（你怎么什么都知道）"}
