{"time": 1758201380, "type": "recv", "message_id": "1430946828", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“呼...”画家长舒了一口气“谢谢你们救了我，那群人都不听讲话的”"}
{"time": 1758201399, "type": "recv", "message_id": "1101287558", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“你们要来我的作坊坐一坐吗”"}
{"time": 1758201428, "type": "recv", "message_id": "1756785393", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“好的”"}
{"time": 1758201490, "type": "recv", "message_id": "1764060890", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那你们三个先聊，我去先带大家去教堂”温特说到"}
{"time": 1758201575, "type": "recv", "message_id": "458405593", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哎？教堂的工作人员不知道为什么全都失踪了，无眠机关的瑟莎蒂亚·伦特兹小姐委托我现在代为管理，有什么事和我说就好了”"}
{"time": 1758201608, "type": "recv", "message_id": "973104548", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我也不知道可以说什么\""}
{"time": 1758201617, "type": "recv", "message_id": "333381149", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "\"我也不知道可以说什么\""}
{"time": 1758201687, "type": "recv", "message_id": "902181301", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“emmm，怎么会这样”温特听到这个消息有些震惊，然后她又和画家聊了几句，带着那一大堆幸存者朝教堂走去，留下你们三个在原地"}
{"time": 1758201751, "type": "recv", "message_id": "809393362", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "作坊是一个小型的两户型建筑，两个房间都摆满了油画，画画工具和半成品。"}
{"time": 1758201801, "type": "recv", "message_id": "48915349", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "等你们进去坐下之后，莱文为你们倒了几杯茶“多谢几位了，几位请慢用”"}
{"time": 1758201921, "type": "recv", "message_id": "186021702", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"谢谢。\"喝茶"}
{"time": 1758201948, "type": "recv", "message_id": "1738525811", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "（所以，要干嘛）"}
{"time": 1758201989, "type": "recv", "message_id": "1779651171", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你们注意到在画室的中间摆有几幅画，里面是一些不同的城市，但却都在一片黄色的天空之下，画中有三个人，但都没有脸"}
{"time": 1758202178, "type": "recv", "message_id": "926766339", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哦，这是你画的吗？\""}
{"time": 1758202279, "type": "recv", "message_id": "2115924454", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...这都是我之前做的梦，醒来就记录下来了，但是每次睡醒，都不太记得那几个人长什么样子”她沉思了一会，开始端详你们三个“emmm....对了，你们就是我梦里的人”她很惊喜的样子"}
{"time": 1758202344, "type": "recv", "message_id": "359186948", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "（那很巧了）"}
{"time": 1758202588, "type": "recv", "message_id": "2099026745", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“你们可以当我的模特吗，我可以付你们100gp”期待ing"}
{"time": 1758202744, "type": "recv", "message_id": "694582116", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "（额】）"}
{"time": 1758202802, "type": "recv", "message_id": "1994922186", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呃\""}
{"time": 1758202813, "type": "recv", "message_id": "1633961885", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"梦中吗？那很神奇了，说说看吧\""}
{"time": 1758202881, "type": "recv", "message_id": "1862800504", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "\"emmm。我梦到了你们打败了好多的坏家伙，最后拯救了世界\"她用一种欣赏的眼神看着你们"}
{"time": 1758203179, "type": "recv", "message_id": "788423081", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呃，封夜君姑且不论，封音吗？\""}
{"time": 1758203215, "type": "recv", "message_id": "497772925", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "（封音也是二次元滤镜好吧）"}
