{"time": 1754237835, "type": "recv", "message_id": "871910109", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(别急，绝望不是这么写的)"}
{"time": 1754237881, "type": "recv", "message_id": "662151835", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我...我不会走的...我会和你一起的...就算走，也会带着你一起走...”"}
{"time": 1754237885, "type": "recv", "message_id": "441690767", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……”牙齿咬的吱嘎作响。刚回归不久的鳞片再次浮现“好……6年之内，你我总有一个要死”"}
{"time": 1754237946, "type": "recv", "message_id": "1664218709", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“露莉亚...别怕...”尝试去抱住她"}
