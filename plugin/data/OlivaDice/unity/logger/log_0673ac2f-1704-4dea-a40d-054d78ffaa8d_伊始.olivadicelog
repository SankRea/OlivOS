{"time": 1754336127, "type": "recv", "message_id": "1553814190", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "揉揉眼睛“我眼花了吗？”"}
{"time": 1754336183, "type": "recv", "message_id": "69191189", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(要是还有话，打出来就off吧)"}
{"time": 1754336190, "type": "recv", "message_id": "965670855", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我先躺下了。)"}
{"time": 1754336243, "type": "recv", "message_id": "283197096", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "不过想起以前的听过的童话故事，看见流星记得许愿，双手十指交叉“希望露莉亚可以恢复视力”然后继续上山"}
