{"time": 1754424319, "type": "recv", "message_id": "26848257", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我真的变成人类了？”"}
