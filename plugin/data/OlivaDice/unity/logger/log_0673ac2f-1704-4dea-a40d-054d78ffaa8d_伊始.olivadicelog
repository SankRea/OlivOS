{"time": 1754510772, "type": "recv", "message_id": "688930036", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（她不要我就不能送吗）"}
