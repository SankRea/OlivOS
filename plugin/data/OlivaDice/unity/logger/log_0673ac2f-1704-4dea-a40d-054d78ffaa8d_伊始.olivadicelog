{"time": 1754356335, "type": "recv", "message_id": "95700619", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（看笑了，虾是海底的香蕉剥了皮就能吃）"}
