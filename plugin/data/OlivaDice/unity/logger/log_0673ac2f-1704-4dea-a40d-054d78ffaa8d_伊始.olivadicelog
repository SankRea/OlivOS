{"time": 1754334845, "type": "recv", "message_id": "1118555477", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(莉夏也许知道，但你也没问啊)"}
