{"time": 1754321910, "type": "recv", "message_id": "975006407", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(不然怎么咒杀)"}
