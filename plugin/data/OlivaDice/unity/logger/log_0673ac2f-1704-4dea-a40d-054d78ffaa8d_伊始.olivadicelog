{"time": 1754419677, "type": "recv", "message_id": "1486172131", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我...想成为人类有什么错....”"}
