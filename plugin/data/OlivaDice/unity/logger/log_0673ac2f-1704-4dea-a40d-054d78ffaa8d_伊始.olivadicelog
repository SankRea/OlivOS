{"time": 1754243703, "type": "recv", "message_id": "398166307", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（gbc主题曲，五个少女从天上跳下来（）"}
{"time": 1754243732, "type": "recv", "message_id": "255747409", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“莉夏姐姐可以收我为徒吗”期待的看着她"}
{"time": 1754243923, "type": "recv", "message_id": "1019817120", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...我只会用剑。\"她还是这句话"}
{"time": 1754243930, "type": "recv", "message_id": "1831130920", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“不行……睡着的话，就不能……再骗自己了”*拥抱着她，眼角分泌出苦咸的液体“明明我有很多话想跟姐姐说……但是姐姐却听不见”"}
{"time": 1754243983, "type": "recv", "message_id": "468778728", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“请莉夏姐收我为徒吧”跪下"}
