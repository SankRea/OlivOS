{"time": 1754559767, "type": "recv", "message_id": "188727795", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“是昨天晚上那只...”"}
