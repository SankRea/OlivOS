{"time": 1754195607, "type": "recv", "message_id": "703799674", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（别急）"}
