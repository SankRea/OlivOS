{"time": 1754425943, "type": "recv", "message_id": "1183954185", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "然后用羽毛靠近伤口"}
{"time": 1754425986, "type": "recv", "message_id": "1661722826", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "伤口很快就痊愈得像是没有存在过"}
{"time": 1754425994, "type": "recv", "message_id": "312185295", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "但是羽毛的光泽变暗了"}
{"time": 1754426031, "type": "recv", "message_id": "1409832587", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "颤抖的拿着羽毛靠近露莉亚的眼睛"}
{"time": 1754426192, "type": "recv", "message_id": "1808866532", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "羽毛散发着点点荧光，靠近之后就逐渐消失于漆黑的夜中"}
{"time": 1754426241, "type": "recv", "message_id": "1793367148", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "把露莉亚摇醒“露莉亚 露莉亚 醒醒”"}
{"time": 1754426287, "type": "recv", "message_id": "1200085088", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(?你是真的变态)"}
{"time": 1754426322, "type": "recv", "message_id": "1844417540", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（怎么了（）"}
{"time": 1754426340, "type": "recv", "message_id": "567725205", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（为什么会漆黑呢，我回来不是都早上了？）"}
{"time": 1754426368, "type": "recv", "message_id": "635856720", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "总之她确实醒了，有些睡眼惺忪，下意识揉了揉眼睛，\"嗯...诺诺...\"眨眨眼，\"你还舍得回...等等...\"你发现她的眼睛骤然瞪大，\"能看见了...?\""}
{"time": 1754426376, "type": "recv", "message_id": "1586012128", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(你不会觉得梦里的时间是假的吧)"}
{"time": 1754426382, "type": "recv", "message_id": "67457541", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(现在第二天夜里)"}
{"time": 1754426389, "type": "recv", "message_id": "1979760156", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（原来是这样）"}
{"time": 1754426397, "type": "recv", "message_id": "494659968", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那这段时间这谁怎么度过的（）"}
{"time": 1754426433, "type": "recv", "message_id": "1939843457", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(翔哥不是躺一天尸)"}
{"time": 1754426452, "type": "recv", "message_id": "44490175", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“太好了.....”抱住她"}
{"time": 1754426493, "type": "recv", "message_id": "537269952", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...你做了什么?\"虽然眼泪已经溢出了眼眶，但她还是下意识发问"}
{"time": 1754426502, "type": "recv", "message_id": "932781757", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "虽然你永远不能回答她"}
{"time": 1754426641, "type": "recv", "message_id": "1219288641", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我没做什么啊”心里感谢埃忒尔一万遍“肯定是老天垂怜露莉亚”"}
{"time": 1754426659, "type": "recv", "message_id": "2054182367", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(她为什么这么温柔)"}
{"time": 1754426661, "type": "recv", "message_id": "1760268930", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(唉)"}
