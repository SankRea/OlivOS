{"time": 1754278235, "type": "recv", "message_id": "1478663548", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*找找龙类谱系、魔族谱系和用的上龙鳞的炼金配方"}
{"time": 1754278415, "type": "recv", "message_id": "1766556957", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=702376203]\"哦。\""}
{"time": 1754278483, "type": "recv", "message_id": "70577655", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "你感觉她的回应淡淡的，好像不怎么在意?"}
{"time": 1754278497, "type": "recv", "message_id": "865182438", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1478663548](你阿爸的)"}
