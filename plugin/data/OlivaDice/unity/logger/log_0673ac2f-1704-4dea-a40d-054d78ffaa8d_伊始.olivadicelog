{"time": 1754198222, "type": "recv", "message_id": "881529165", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（话说，我现在是12岁对吗）"}
