{"time": 1755442132, "type": "recv", "message_id": "445736518", "deleted": false, "dect": {"host_id": null, "group_id": "1056340271", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“嗯？”"}
