{"time": 1755440565, "type": "recv", "message_id": "814784911", "deleted": false, "dect": {"host_id": null, "group_id": "1056340271", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“人类的食物也挺好吃的…就是不顶饱。”"}
{"time": 1755440592, "type": "recv", "message_id": "1192642855", "deleted": false, "dect": {"host_id": null, "group_id": "1056340271", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“多吃点就好了”"}
{"time": 1755440685, "type": "recv", "message_id": "613076208", "deleted": false, "dect": {"host_id": null, "group_id": "1056340271", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "*那就在吃了十几份之后准备拎着十份打包的披萨离开这家店。"}
{"time": 1755440714, "type": "recv", "message_id": "1193001756", "deleted": false, "dect": {"host_id": null, "group_id": "1056340271", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“在回去的路上再买点零食，可以吗姐姐大人？”"}
{"time": 1755440806, "type": "recv", "message_id": "1376656125", "deleted": false, "dect": {"host_id": null, "group_id": "1056340271", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "（厉害）"}
