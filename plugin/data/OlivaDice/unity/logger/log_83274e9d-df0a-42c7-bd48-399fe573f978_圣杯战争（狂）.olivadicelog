{"time": 1755526982, "type": "recv", "message_id": "734204282", "deleted": false, "dect": {"host_id": null, "group_id": "1056340271", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“你好”*迟疑着抬头，出示手里的传单“我听说这里塔罗占卜很准…”"}
{"time": 1755527032, "type": "recv", "message_id": "1575213544", "deleted": false, "dect": {"host_id": null, "group_id": "1056340271", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“这是当然，请坐在对应的位置上，如果没有异议的话，占卜就可以开始，开始前请查看价格表，选择套餐，然后闭目养神，抽取面前三张塔罗牌即可”"}
{"time": 1755528306, "type": "recv", "message_id": "988179564", "deleted": false, "dect": {"host_id": null, "group_id": "1056340271", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "（[CQ:at,qq=2388921818] 随便说三个推进度吧）"}
{"time": 1755529088, "type": "recv", "message_id": "1436479307", "deleted": false, "dect": {"host_id": null, "group_id": "1056340271", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(请不要)"}
{"time": 1755529100, "type": "recv", "message_id": "190081261", "deleted": false, "dect": {"host_id": null, "group_id": "1056340271", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(戳破我的忽悠)"}
{"time": 1755529367, "type": "recv", "message_id": "164396631", "deleted": false, "dect": {"host_id": null, "group_id": "1056340271", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“小黑，再叫几份外卖吧，想吃什么？还是鸡肉还是说吃点牛肉的？”"}
{"time": 1755529482, "type": "recv", "message_id": "1115985940", "deleted": false, "dect": {"host_id": null, "group_id": "1056340271", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“换换口味吧，我想吃意大利面了。”"}
{"time": 1755529492, "type": "recv", "message_id": "1873028700", "deleted": false, "dect": {"host_id": null, "group_id": "1056340271", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“肉酱多放点。”"}
{"time": 1755529503, "type": "recv", "message_id": "288089804", "deleted": false, "dect": {"host_id": null, "group_id": "1056340271", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“对了，姐姐大人，刚才一单赚了多少啊？”"}
{"time": 1755529509, "type": "recv", "message_id": "1325203270", "deleted": false, "dect": {"host_id": null, "group_id": "1056340271", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“叫外卖吧，我打个电话，我有一个预感，我们今天还会陆续有很多客人来”"}
{"time": 1755529521, "type": "recv", "message_id": "837158953", "deleted": false, "dect": {"host_id": null, "group_id": "1056340271", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“够我们一个星期随便吃食了”"}
{"time": 1755529548, "type": "recv", "message_id": "1424035625", "deleted": false, "dect": {"host_id": null, "group_id": "1056340271", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*叫七八份意面到占卜店来"}
{"time": 1755529638, "type": "recv", "message_id": "1548363131", "deleted": false, "dect": {"host_id": null, "group_id": "1056340271", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(怎么只有一队在商业街这边)"}
