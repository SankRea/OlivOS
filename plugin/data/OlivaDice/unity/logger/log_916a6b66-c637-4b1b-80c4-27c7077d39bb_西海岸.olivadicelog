{"time": 1767685742, "type": "recv", "message_id": "1315752633", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（但是不管怎么样）"}
