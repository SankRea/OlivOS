{"time": 1768465157, "type": "recv", "message_id": "1088540828", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我觉得应该是敏捷）"}
