{"time": 1773799600, "type": "recv", "message_id": "250076360", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:image,file={CABE6F67-94F5-168F-2E2D-659B3B1A6262}.png,sub_type=0,url=https://gchat.qpic.cn/gchatpic_new/0/0-0-CABE6F6794F5168F2E2D659B3B1A6262/0,file_size=8988]"}
