{"time": 1768470109, "type": "recv", "message_id": "1453522793", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（没啊，箱子里装着餐具，饭盒这些东西啦）"}
{"time": 1768470131, "type": "recv", "message_id": "1858215846", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（是啊，直接打开到最里层了）"}
