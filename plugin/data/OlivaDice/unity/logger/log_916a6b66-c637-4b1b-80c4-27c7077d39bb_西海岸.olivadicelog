{"time": 1768266569, "type": "recv", "message_id": "20001054", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“爽快，祝你学业有成啊学弟”"}
