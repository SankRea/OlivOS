{"time": 1769068916, "type": "recv", "message_id": "1669517660", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哦～\"想起这么回事，\"嗯嗯\""}
{"time": 1769069014, "type": "recv", "message_id": "2021034139", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（虽然我是觉得魔法世界的宵禁没什么约束力）"}
{"time": 1769069032, "type": "recv", "message_id": "1293001367", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那走吧，我送舒茉回去”等着舒茉从自己身上爬起来先"}
{"time": 1769069102, "type": "recv", "message_id": "1465300825", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那伊恩怎么办？\"眨眨眼，从伊恩的腿上起身，坐在一边的椅子上"}
{"time": 1769069192, "type": "recv", "message_id": "1203038379", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“小册子上说，一楼有几个学长的宿舍，关灯比较晚，而且不是很在意，所以可以从他们宿舍的窗户翻进去...”感觉有点不靠谱，说着也没什么底“或者我通过阳台，慢慢传送好了”"}
{"time": 1769069227, "type": "recv", "message_id": "1601257954", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶?那我送伊恩回去吧。\"点着脑袋，\"反正再不济我还能回家嘛。\""}
{"time": 1769069280, "type": "recv", "message_id": "42894064", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“没事啦，我送舒茉好了，走吧走吧”起身牵起舒茉的手"}
{"time": 1769069542, "type": "recv", "message_id": "1148161085", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯。\"听完也不再坚持，紧握着手，扣住手指，\"走吧～\""}
{"time": 1769069647, "type": "recv", "message_id": "903167055", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（感觉可以skip了啊（））"}
