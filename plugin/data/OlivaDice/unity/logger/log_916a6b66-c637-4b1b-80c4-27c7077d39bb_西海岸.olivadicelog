{"time": 1773922225, "type": "recv", "message_id": "886456934", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你还是先想想写什么吧）"}
{"time": 1773922340, "type": "recv", "message_id": "1235960306", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我刚刚做梦)"}
{"time": 1773922368, "type": "recv", "message_id": "1656027056", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(梦见我周五把哈基米关进了床头柜)"}
{"time": 1773922396, "type": "recv", "message_id": "141607621", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(到了第二周周四，忘记放出来了，床头柜没动静了)"}
{"time": 1773922417, "type": "recv", "message_id": "1245023528", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（不太像人）"}
