{"time": 1775550134, "type": "recv", "message_id": "544088010", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=375218826]（睡着了）"}
