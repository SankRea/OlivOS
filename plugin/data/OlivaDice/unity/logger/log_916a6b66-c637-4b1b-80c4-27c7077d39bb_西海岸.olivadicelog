{"time": 1776407525, "type": "recv", "message_id": "2046420422", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(咦，有区别吗)"}
