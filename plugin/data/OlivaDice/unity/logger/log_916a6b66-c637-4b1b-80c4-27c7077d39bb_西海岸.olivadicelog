{"time": 1776248714, "type": "recv", "message_id": "467527809", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“别...别么，露露..”"}
