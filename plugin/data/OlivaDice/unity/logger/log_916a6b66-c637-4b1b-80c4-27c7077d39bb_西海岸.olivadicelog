{"time": 1770103664, "type": "recv", "message_id": "874876352", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（所幸打野被爆的更厉害，没人骂我）"}
