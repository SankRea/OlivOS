{"time": 1773671215, "type": "recv", "message_id": "1986607822", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（干嘛，主要目的是解除黏膜）"}
{"time": 1773671223, "type": "recv", "message_id": "396333953", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（至于怎么接触你别管）"}
