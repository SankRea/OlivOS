{"time": 1768027886, "type": "recv", "message_id": "609292456", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（哈利波特厕所里是不是有个桃金娘）"}
{"time": 1768027943, "type": "recv", "message_id": "225436899", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（没看过哈利波特）"}
{"time": 1768027967, "type": "recv", "message_id": "1552771569", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那夏洛克不如猜猜我来自哪吧”"}
