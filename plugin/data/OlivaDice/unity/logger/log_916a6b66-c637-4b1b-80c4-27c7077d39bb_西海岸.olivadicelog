{"time": 1767929973, "type": "recv", "message_id": "2014481218", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（喊麦也是东北的吧）"}
{"time": 1767930238, "type": "recv", "message_id": "1342989697", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“就开小灶而言，你们应该旗鼓相当吧。”舒蕾转头看看你“刚开学就能混脸熟，既是压力也是动力吧。”"}
{"time": 1767930627, "type": "recv", "message_id": "1066534768", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（[CQ:at,qq=1252219916] ）"}
