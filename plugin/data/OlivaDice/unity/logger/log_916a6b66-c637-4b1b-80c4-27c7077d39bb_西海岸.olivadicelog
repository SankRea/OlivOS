{"time": 1768206843, "type": "recv", "message_id": "1513935254", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（理论上现在只能算高中）"}
