{"time": 1773707570, "type": "recv", "message_id": "1523876971", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:image,summary=&#91;期待&#93;,file=99-997246fc8f386877cc09bef76f114df0.gif,url=https://gxh.vip.qq.com/club/item/parcel/item/99/997246fc8f386877cc09bef76f114df0/raw300.gif,key=b399915ade13d52c,emoji_id=997246fc8f386877cc09bef76f114df0,emoji_package_id=233707]"}
