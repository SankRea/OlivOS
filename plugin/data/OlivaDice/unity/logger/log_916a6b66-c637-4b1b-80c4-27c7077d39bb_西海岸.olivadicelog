{"time": 1767666940, "type": "recv", "message_id": "546995051", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（那舒茉现在是已经出门还是正要出门）"}
