{"time": 1768205184, "type": "recv", "message_id": "1473022363", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(拍完不说话咩，那我说)"}
{"time": 1768205196, "type": "recv", "message_id": "1321650047", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（你不回头看我，我怎么说）"}
{"time": 1768205243, "type": "recv", "message_id": "1221231721", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呀，伊恩?\"回头，虽然很想装出惊讶的样子，不过怎么都有点露馅的感觉，\"怎么突然出现在我身后。\""}
{"time": 1768205276, "type": "recv", "message_id": "1133538233", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哎？”和想象的有点不太一样“舒茉是不是早看到我了啊”"}
{"time": 1768205291, "type": "recv", "message_id": "1632847756", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（谁家好人拍完不说话）"}
{"time": 1768205511, "type": "recv", "message_id": "104251355", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（正常不是，拍一下，然后惊讶，你来了！之类的）"}
{"time": 1768205552, "type": "recv", "message_id": "125951815", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没有哦?\"无辜地摊手"}
{"time": 1768205643, "type": "recv", "message_id": "33406733", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“就是看到了吧”牵起舒茉的手“对了，舒茉的室友怎么样，好相处吗”关心一下"}
{"time": 1768205674, "type": "recv", "message_id": "330788667", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（拍的时候“哈！”一下不是更常见么）"}
{"time": 1768205699, "type": "recv", "message_id": "1752816924", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"目前还只有两个，嗯...感觉都是很好的人。\"点点头，\"都很漂亮，很有魅力...伊恩呢？\""}
{"time": 1768205725, "type": "recv", "message_id": "1090960082", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我其实喜欢，站在右边拍左肩，然后不说话😶，所以后来我顺着方向拍也不说话了）"}
{"time": 1768205772, "type": "recv", "message_id": "2138610625", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（不如一个大跳挂身上）"}
{"time": 1768205800, "type": "recv", "message_id": "1024936269", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“看着也都是很不错的人，而且我有个室友特别厉害，是顾问侦探呢 能从一点蛛丝马迹推断出好多东西”"}
{"time": 1768205956, "type": "recv", "message_id": "1169030271", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=2138610625]（我挂舒茉身上她肯定摔了吧（bushi）"}
{"time": 1768206152, "type": "recv", "message_id": "20744887", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哦?这么厉害?我都想问问他一些事情了。\""}
{"time": 1768206215, "type": "recv", "message_id": "2095944854", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哦，什么事？舒茉问我也可以”拍拍自己的胸膛“他今天和我比赛可是输了呢”"}
{"time": 1768206296, "type": "recv", "message_id": "692644024", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那你为什么不和他赌点银币（））"}
{"time": 1768206465, "type": "recv", "message_id": "758366012", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"伊恩?\"笑嘻嘻地看着他，摆摆手，\"没事没事，我们先去吃饭吧？\""}
{"time": 1768206478, "type": "recv", "message_id": "523745577", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "看看天色"}
{"time": 1768206492, "type": "recv", "message_id": "1329597613", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“怎么啦，舒茉不相信我吗”"}
{"time": 1768206534, "type": "recv", "message_id": "553217234", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（说起来好像没给你们发生活费。首周暂且按一人三枚金的算吧，大概一个月10枚？）"}
{"time": 1768206545, "type": "recv", "message_id": "423547528", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=523745577]中午"}
