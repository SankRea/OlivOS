{"time": 1774422634, "type": "recv", "message_id": "1084069992", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(my precious)"}
