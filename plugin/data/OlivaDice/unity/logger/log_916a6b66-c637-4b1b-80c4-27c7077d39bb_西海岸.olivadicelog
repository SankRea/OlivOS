{"time": 1768979372, "type": "recv", "message_id": "148824604", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（是说图书馆里专门有一块区域留给特殊人群（））"}
{"time": 1768979385, "type": "recv", "message_id": "1316031410", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（不是说全校的人都要去图书馆幽会）"}
{"time": 1768979401, "type": "recv", "message_id": "3571372", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（没有记载哪里有小树林吗（））"}
{"time": 1768979422, "type": "recv", "message_id": "1467582102", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（也可以有吧？）"}
{"time": 1768979470, "type": "recv", "message_id": "1703628272", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（远离全是夜猫子的观星科和养了一堆昼伏夜出魔宠的召唤科就是了）"}
{"time": 1768979878, "type": "recv", "message_id": "180752121", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那我现在带舒茉过去吧”开心的背着舒茉前往“约会圣地”，感觉腰也不酸了，腿也不软了"}
{"time": 1768979984, "type": "recv", "message_id": "1209134499", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"先去买点水啦。\"捏捏伊恩的肩膀，\"现在口干舌燥的——\""}
{"time": 1768981088, "type": "recv", "message_id": "1648858452", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哦”点点头，调转方向去小卖铺了"}
{"time": 1768981401, "type": "recv", "message_id": "1548062096", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "那么你们来到了小卖部，店主是个看起来四十多岁的男人。店里的人不算少，大多是来买零食和白天没买齐的日用品的"}
{"time": 1768981454, "type": "recv", "message_id": "1312335413", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“emmm，舒茉要下来吗”虽然自己倒也不是很介意了，不过还是问问舒茉怎么说"}
{"time": 1768981515, "type": "recv", "message_id": "1011373736", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "背着个人进来总是引人注目的。尤其是被背着的人是舒茉的情况下"}
{"time": 1768981528, "type": "recv", "message_id": "1848627001", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "自己倒是还想再待在背上一会，不过既然被这么问了，\"嗯。\"松开手轻巧地落在地上站稳。"}
{"time": 1768981741, "type": "recv", "message_id": "913088338", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "虽然放下了舒茉，不过顺势直接牵起了她的手，然后和她去买水了"}
{"time": 1768981803, "type": "recv", "message_id": "1132404139", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "周围的视线总是让自己有些不舒服，不过有伊恩在身边的话，倒是能安心下来，\"伊恩想要什么样的味道?\"指着一排不同口味的牛奶，\"很重要哦?\""}
{"time": 1768982002, "type": "recv", "message_id": "527376869", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“emmm，我都可以啦，不如就要这个吧”手伸过去拿一盒蓝莓味的牛奶"}
{"time": 1768982289, "type": "recv", "message_id": "857338304", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶～帮我挑啦。\"眉头微微皱了皱，轻轻捶了捶伊恩伸过去的手，\"我改变主意啦，牛奶的话，待会会有一点腻味，唔，还是果汁吧？\""}
{"time": 1768982594, "type": "recv", "message_id": "194094298", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“oh...这样啊..”有些后知后觉“那就蓝莓味果汁？”"}
{"time": 1768982777, "type": "recv", "message_id": "368622685", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"蓝莓味，嗯...\"虽然自己是很喜欢啦，不过待会也会是这个味道，\"待会也会是这个味道哦?\""}
{"time": 1768982906, "type": "recv", "message_id": "542414553", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...”羞涩的点了点头"}
{"time": 1768983125, "type": "recv", "message_id": "1194857766", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "眼见他的样子，嘴角不由得弯了几度，心情很好地从架子上拿下两瓶果汁，\"呼...\"掂了掂，去前台结账，\"叔叔，多少钱?\""}
{"time": 1768983395, "type": "recv", "message_id": "1663528349", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（原来到我了）"}
{"time": 1768983447, "type": "recv", "message_id": "136929022", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“4银币。还有什么要帮忙的吗？”他看着你们两个"}
{"time": 1768983558, "type": "recv", "message_id": "606692942", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "好像没有了，摇摇头"}
{"time": 1768983652, "type": "recv", "message_id": "377591173", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我看你们腿脚不便.jpg）"}
{"time": 1768983717, "type": "recv", "message_id": "1415075210", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯。\"递过银币，把一盒塞到伊恩手里，拿过自己的一盒，开封先喝一口，\"走吧～\"嗓子被液体浸润，瞬间舒服许多"}
{"time": 1768983848, "type": "recv", "message_id": "1588933793", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "也喝一口，感觉甜甜的“嗯嗯”，牵着舒茉的手去约会圣地"}
{"time": 1768984012, "type": "recv", "message_id": "1868354401", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "冬夜的校园，虽然总有几个教室亮着，小径上也有路灯，不过只要你想，总能绕开稀疏而不懂距离感的光照，转而投身暧昧的夜色"}
{"time": 1768984156, "type": "recv", "message_id": "1078214039", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "一路安安静静，不时喝一口手里的果汁，然而从手心传来的温度总让人有些心焦，因而体温也逐渐上升，渐渐有些热意。"}
{"time": 1768984394, "type": "recv", "message_id": "419299602", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "直到四下无人，停了下来，小小转身，面对着舒茉，另一只手也去牵舒茉的手，四目相对，白天终究还只是粗略的看了几眼舒茉的妆造，如今终于有机会仔细去观察...好漂亮，感觉舒茉像仙子一样 如果不是自己知道，还以为舒茉是从天上来的呢"}
{"time": 1768984416, "type": "recv", "message_id": "161386221", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（）"}
{"time": 1768984499, "type": "recv", "message_id": "1198930921", "deleted": true, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“感觉好像虽然就只分开了半天...但感觉过了好久好久”"}
{"time": 1768984719, "type": "recv", "message_id": "257574060", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好像虽然就只分开了半天...但感觉过了好久好久”"}
{"time": 1768984729, "type": "recv", "message_id": "772947834", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "所谓的约会圣地，是一片没那么静谧的林地。那几乎是个公园，种着密生的常绿树林，零散地装着几条长椅，不知是不是故意的，没有安装任何人造光源，不过树干上缠着的树藤和某些低矮的蕨类植物散发着幽幽的蓝光，微妙地勾勒出所见一切的轮廓"}
{"time": 1768984774, "type": "recv", "message_id": "977756420", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶，怎么话都说不利索了?\"眉眼弯弯，带着好笑的情绪，\"唔?\"注意到伊恩的视线，脸再贴近了一些，\"好看吗?\"睫毛扑棱扑棱"}
{"time": 1768984999, "type": "recv", "message_id": "251894936", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...”下定决心要更加的努力，要不以后怎么保护舒茉“非常好看..感觉舒茉就像星空一样漂亮..”"}
{"time": 1768985128, "type": "recv", "message_id": "283759827", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"人怎么可能像星空啦～\"往后退开一步，手依然牵着，\"不过，只允许现在...星空是蓝莓味的。\"闭上眼睛微微仰起脑袋。"}
{"time": 1768985262, "type": "recv", "message_id": "1939414819", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "也闭上眼睛，轻轻的吻了上去"}
{"time": 1768985277, "type": "recv", "message_id": "2059408366", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我在想看得清吗.jpg）"}
{"time": 1768985333, "type": "recv", "message_id": "931786760", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "甜甜的，蓝莓味占了一些，舒茉本身也甜甜的.."}
{"time": 1768985640, "type": "recv", "message_id": "1765083780", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "满足的感觉涌上心头，身体酥酥麻麻的，软软的没什么力气，干脆把整个人都倾倒在伊恩怀里。"}
{"time": 1768985910, "type": "recv", "message_id": "520748322", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（念头通达了？）"}
{"time": 1768985949, "type": "recv", "message_id": "354323665", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（不想思考了）"}
{"time": 1768985986, "type": "recv", "message_id": "1865592694", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "抱着舒茉，继续享受这片刻的安宁"}
{"time": 1768986000, "type": "recv", "message_id": "676804856", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（站着？）"}
