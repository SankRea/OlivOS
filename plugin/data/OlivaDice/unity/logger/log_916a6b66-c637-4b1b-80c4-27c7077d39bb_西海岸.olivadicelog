{"time": 1767943023, "type": "recv", "message_id": "1463895181", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（为什么伊神不用过）"}
{"time": 1767943041, "type": "recv", "message_id": "629804903", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（因为是你想和他一个班（））"}
{"time": 1767943112, "type": "recv", "message_id": "436039660", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(那我过)"}
