{"time": 1773717459, "type": "recv", "message_id": "764684168", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(那个其实消除了大部分)"}
{"time": 1773717467, "type": "recv", "message_id": "942453864", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（你不是说还有么）"}
