{"time": 1775050506, "type": "recv", "message_id": "1220928142", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1327696307]\"诶...?\"露莉亚还没反应过来，你就看见那人像是看见了你，刻意避着往外走了"}
{"time": 1775050540, "type": "recv", "message_id": "1857284078", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好像被看到了...算了，她跑了，我们还是继续吃饭吧”"}
{"time": 1775050678, "type": "recv", "message_id": "1133003166", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1857284078]露莉亚一下站起身，\"她跑了，她怎么能跑...\"呼吸很急促，朝着你看着的方向张望，\"在哪？\""}
{"time": 1775050723, "type": "recv", "message_id": "455030636", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那走...”拉着露露的手直接去追她"}
{"time": 1775050909, "type": "recv", "message_id": "1059948043", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1629452591]你看见那两人站起身朝你这边跑了过来，jpg"}
{"time": 1775051001, "type": "recv", "message_id": "1644660273", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……”叹了口气，现在肯定是跑不过的，但是就当没看见吧。依旧往住院部走"}
{"time": 1775051029, "type": "recv", "message_id": "1831914191", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（住院部是什么）"}
{"time": 1775051063, "type": "recv", "message_id": "2012343894", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（就是住院部啊）"}
{"time": 1775051175, "type": "recv", "message_id": "1039874147", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(门诊部，住院部，这不是配套的嘛)"}
{"time": 1775051206, "type": "recv", "message_id": "2131097532", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（oh）"}
{"time": 1775051251, "type": "recv", "message_id": "2082948997", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "前面的人走得不紧不慢，诺薇菈和莉莉娅轻轻松松就追上了。她手里拎着打包的餐点，脸色看上去有些苍白。"}
{"time": 1775051306, "type": "recv", "message_id": "1979152155", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“伊芙，不准跑”"}
{"time": 1775051335, "type": "recv", "message_id": "521523006", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*我要是应了就是傻逼（）"}
{"time": 1775051396, "type": "recv", "message_id": "1052032471", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "对方没应声"}
{"time": 1775051467, "type": "recv", "message_id": "944970883", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "上去抓住她胳膊"}
{"time": 1775051553, "type": "recv", "message_id": "1412398185", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……”少见地叹出一口无力感很强的气，声音因为许久没喝水实际沙哑“这位同学，你有什么事直说好吗？”"}
{"time": 1775051567, "type": "recv", "message_id": "1084013833", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“伊芙？”"}
{"time": 1775051580, "type": "recv", "message_id": "2066302092", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我一眼就看出是你了？”"}
{"time": 1775051633, "type": "recv", "message_id": "788312080", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "露莉亚在一旁，倒是没上手，而是仔仔细细打量着对方的脸，目光里带着深深的审视"}
{"time": 1775051701, "type": "recv", "message_id": "1844995057", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“就算你化成灰，我也不会认错”"}
{"time": 1775051703, "type": "recv", "message_id": "1605976652", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“有事快说”语气颇为不耐烦“我还有事”"}
{"time": 1775051749, "type": "recv", "message_id": "688348874", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "周围人还挺多，自己还真不能把她怎么样，看看露露怎么说"}
{"time": 1775051844, "type": "recv", "message_id": "725816817", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（信息密度好低的对话）"}
{"time": 1775051867, "type": "recv", "message_id": "1326646039", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"真的是...?\"听到亲口承认的话，露莉亚有些不敢置信，语气有些颤抖，\"你就是...那个杀了我们村子的人?你怎么能这么堂而皇之地走在这里...\""}
{"time": 1775051895, "type": "recv", "message_id": "2077757009", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(那一般来说应该这里是你们主导对话吧，俺寻思)"}
{"time": 1775051912, "type": "recv", "message_id": "628902049", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（应该是翔哥主导）"}
{"time": 1775051914, "type": "recv", "message_id": "463973826", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "趁机咬她一口，虽然做不了什么，但收个利息算了"}
