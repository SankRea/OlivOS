{"time": 1770194527, "type": "recv", "message_id": "369082279", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我觉得他只是单纯忘了还有午饭这码事）"}
