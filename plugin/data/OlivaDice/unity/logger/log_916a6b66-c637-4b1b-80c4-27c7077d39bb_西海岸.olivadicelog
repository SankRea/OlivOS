{"time": 1767789572, "type": "recv", "message_id": "861620068", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "本来也准备打招呼再见了，不过这么一说也想起来来了“阿尼亚师姐，米拉教授是？为什么主任让我去找她”有些好奇"}
{"time": 1767789780, "type": "recv", "message_id": "1722056879", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:image,file=C29B762D513362CDC6899C239DA411E7.jpg,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhQkzceY-d55NTR2pyimEp8umLj20BjZgw8g_wooi9qZjrr5kQMyBHByb2RQgL2jAVoQFhPlt6qr3Rfw9mqnq6L7KXoCi1OCAQJuag&amp;rkey=CAQSMJnIhmnc1XjvlZS52ec3ygKTMv5q4DpJwqqWyJWuZs4uQEiUDnKvs02Tq9Ycub6A8g,file_size=246233]"}
