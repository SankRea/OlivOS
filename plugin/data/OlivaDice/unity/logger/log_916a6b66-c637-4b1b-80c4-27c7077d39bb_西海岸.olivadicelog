{"time": 1775792983, "type": "recv", "message_id": "602091127", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（虽然说也就刚扎进去的时候疼吧）"}
