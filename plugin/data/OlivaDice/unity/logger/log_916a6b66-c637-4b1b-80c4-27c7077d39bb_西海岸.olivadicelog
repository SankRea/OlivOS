{"time": 1775187188, "type": "recv", "message_id": "608111802", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（因为那时候洋荷没给妙妙工具（）"}
