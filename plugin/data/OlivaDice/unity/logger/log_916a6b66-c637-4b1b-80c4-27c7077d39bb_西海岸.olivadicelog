{"time": 1767771700, "type": "recv", "message_id": "1723628533", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "不知道该不该坐，有些局促地站着等待"}
{"time": 1767771746, "type": "recv", "message_id": "69945721", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“应该可以坐吧”"}
{"time": 1767771791, "type": "recv", "message_id": "1113419320", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "会议室倒是，和一般的会议室无二。严肃标准得让你联系到没粘贴任何告示的布告栏"}
{"time": 1767771800, "type": "recv", "message_id": "10057112", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那你坐不坐（））"}
{"time": 1767771842, "type": "recv", "message_id": "693078448", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "不过看舒茉没有坐的意思，自己也不坐了，和她站在一起"}
{"time": 1767771860, "type": "recv", "message_id": "114931450", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那你说你的那个）"}
{"time": 1767771950, "type": "recv", "message_id": "633411145", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "低头沉思，虽然思绪是一团乱麻"}
{"time": 1767772021, "type": "recv", "message_id": "1199100428", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "静静的等来人吧"}
{"time": 1767772687, "type": "recv", "message_id": "31989033", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "没让你们等太久，大约两分钟后，桌对面泛起一阵魔力的涟漪，随后紫金双色的光芒扭曲、凝结，化作一袭长裙的高挑女性形象。与此同时，门再次被推开，阿尼亚微喘着气走了进来"}
{"time": 1767772727, "type": "recv", "message_id": "1204985945", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“？好帅的出场方式...”吃惊，是怎么做到的，传送魔法吗"}
{"time": 1767772767, "type": "recv", "message_id": "1540113708", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "定睛看着对方，似乎不是真正来到了这里...但是没有出声，等对方先自我介绍。"}
{"time": 1767773027, "type": "recv", "message_id": "1558687281", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（让我再纠结一会立绘）"}
{"time": 1767773033, "type": "recv", "message_id": "694631506", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（感觉沙奈朵也不是不行（））"}
{"time": 1767773886, "type": "recv", "message_id": "480780332", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "人形表面带着些许光晕，大概的确不是实体，从魔力波动上也能察觉一二，不过外观来看几可乱真，粉红的发丝根根分明。不知是不是因为不是真人的原因，表情稍显僵硬，不过唯有视线能明显看得出有几分兴趣。她开口，声音听起来说得上和善“我是元素科现任主任，吉普莉尔。本人现在在天空之塔实地勘察，因此暂时只能以这种方式见面，还请不要介意。”"}
{"time": 1767774119, "type": "recv", "message_id": "1039312833", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "纠结该怎么称呼，最后慢慢开口，\"吉普莉尔主任...您好...\""}
{"time": 1767774143, "type": "recv", "message_id": "959494403", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "原来是投影啊，有些失望，不过没表现出来“主任您好..”"}
{"time": 1767774169, "type": "recv", "message_id": "117725781", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（失望是？）"}
{"time": 1767774194, "type": "recv", "message_id": "2071674341", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=117725781](结合上下文啊)"}
{"time": 1767774280, "type": "recv", "message_id": "1662321025", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（她传不传送和你失不失望应该有联系吗）"}
{"time": 1767774318, "type": "recv", "message_id": "1030913074", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（没传不代表不会，何况也不是投影）"}
{"time": 1767774349, "type": "recv", "message_id": "1488516432", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（以为是传送所以兴奋，结果不是失望，不是很正常么）"}
{"time": 1767774367, "type": "recv", "message_id": "616211072", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "有些畏惧对方的视线，看了一眼就低下头"}
{"time": 1767774377, "type": "recv", "message_id": "965142996", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（为什么传送会兴奋）"}
{"time": 1767774400, "type": "recv", "message_id": "1213711564", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（很帅吧）"}
{"time": 1767774410, "type": "recv", "message_id": "365019756", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（她帅和你有什么关系（））"}
{"time": 1767774506, "type": "recv", "message_id": "497369478", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（看见很帅的东西兴奋不是很正常么）"}
{"time": 1767774522, "type": "recv", "message_id": "183666535", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那不是传送就不帅了吗（））"}
{"time": 1767774588, "type": "recv", "message_id": "1074133464", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（投影确实没传送帅啊（）"}
{"time": 1767774590, "type": "recv", "message_id": "1943000690", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“你们好，我就省略不必要的部分，从简了。”她的目光先是落在舒茉身上“舒茉同学，听说你直接穿过了学院的防护层。”"}
{"time": 1767774670, "type": "recv", "message_id": "1754382688", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"既然点到自己也就不能逃开视线了，看向她，点点头"}
{"time": 1767774854, "type": "recv", "message_id": "1756827566", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯……”她抬了抬手，隔空朝着你的方向点了点，会议室内以你为中心亮起一个四方形法阵，随后你感到有些微魔力流向了你的体内"}
{"time": 1767774913, "type": "recv", "message_id": "759582351", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "在旁边的伊恩，尽管不在法阵中心，但也有一样的感觉"}
{"time": 1767775016, "type": "recv", "message_id": "2039220894", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“哦？”吉普莉尔的目光在伊恩身上稍作停留，随后开口，对阿尼亚发问“这个小家伙，是我们专业的吗？”"}
{"time": 1767775064, "type": "recv", "message_id": "615216730", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "刚刚的是检测吗，不太懂，但乖乖点点头"}
{"time": 1767775067, "type": "recv", "message_id": "252418755", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呃...\"压制住本能地想激发出的雾气，一直重复做深呼吸"}
{"time": 1767775251, "type": "recv", "message_id": "1862759221", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“啊，是的”阿尼亚点头，吉普莉尔颔首，挥散法阵“这边弄完了之后，带他去见米拉教授吧。然后。”她的目光重新转向舒茉“……别紧张，只是测量一下你的元素亲和度。嗯……虽然没有系统学习过，但你应该有会的魔法吧？”"}
{"time": 1767775310, "type": "recv", "message_id": "288606666", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"点头，\"有一些...\""}
{"time": 1767775434, "type": "recv", "message_id": "1916309378", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“试试看，对这里来”她指了指自己“让我看看”"}
{"time": 1767775517, "type": "recv", "message_id": "1294603511", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“加油”小声在舒茉耳边说道"}
{"time": 1767775635, "type": "recv", "message_id": "1619961000", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "几乎微不可闻地嗯了一声，走近一些，慢慢释放属于自己的雾气，同时在指尖点亮环绕着拖曳着尾迹的小星星，不确定地看着她，\"还...还要吗...\""}
{"time": 1767775747, "type": "recv", "message_id": "1409929513", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你的书呢）"}
{"time": 1767775896, "type": "recv", "message_id": "955356505", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(挎在腰间吧)"}
{"time": 1767776140, "type": "recv", "message_id": "1481282917", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯……”她的兴趣似乎又浓厚了几分“还有就继续”"}
{"time": 1767776302, "type": "recv", "message_id": "1996843132", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"依次展示自己的魔法，数量不多，很快就全部过了一遍，\"...只有这些了...主任。\""}
{"time": 1767776808, "type": "recv", "message_id": "1103200383", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯，直接说结论吧……哦，忘了，先坐下吧”她也拉开椅子落座，双腿交叠“你很特殊，也很复杂。元素亲和力只能算中等，使用的魔法，从形象上看，和占星类魔法有些相通，但实质上与精神科的魔法更接近。至于为什么能穿过防护层，一时半会我也给不出定论，如果不是偶然，那几乎可以开个课题了”"}
{"time": 1767776913, "type": "recv", "message_id": "1194778311", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "好像不是自己该说话的场合，不过还是小声对舒茉说“好厉害，不愧是舒茉”"}
{"time": 1767777028, "type": "recv", "message_id": "445238651", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“简单来说，是个四不像”她的总结相当简单粗暴“不过可能性很多。我听阿尼亚说，你还没确定专业？”"}
{"time": 1767777193, "type": "recv", "message_id": "2066478019", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"听到四不像心里有些纠起来，\"果然我去哪里都不太合适吧...\""}
{"time": 1767777213, "type": "recv", "message_id": "1149815739", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“明明是哪里都合适吧”"}
{"time": 1767777550, "type": "recv", "message_id": "899194229", "deleted": true, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“不是那么合不合适能概括的事情，她连四大属性的元素亲和力都完全一样”吉普莉尔摇头“太过精妙均衡了。”末了，她话锋一转“正适合选择元素科。作为支柱专业，元素科的基础课程教学是最完善全面的。”"}
{"time": 1767777664, "type": "recv", "message_id": "1456208164", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（好像这句有点左右脑互肘）"}
{"time": 1767777747, "type": "recv", "message_id": "188816190", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“不是合不合适能概括的事情，她连四大属性的元素亲和力都完全一样”吉普莉尔摇头“太过精妙均衡了。”末了，她话锋一转“正应选择元素科。作为支柱专业，元素科的基础课程教学是最完善全面的。一年时间，在升入二年级之前，元素科一定能帮你找到发展方向。”"}
{"time": 1767777813, "type": "recv", "message_id": "141269038", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "元素，那不就和自己一个专业了么，有点想劝舒茉选这个，不过只是想想，这种事还是得让她自己决定，不能去绑架她..."}
{"time": 1767778149, "type": "recv", "message_id": "1929884382", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（都进了元素科的大楼还想走？）"}
