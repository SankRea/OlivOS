{"time": 1769053363, "type": "recv", "message_id": "308233690", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（+100%）"}
