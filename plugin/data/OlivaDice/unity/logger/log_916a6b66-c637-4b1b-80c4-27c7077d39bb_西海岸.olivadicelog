{"time": 1773303735, "type": "recv", "message_id": "1490927964", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（还有蓝宝石胸针吧）"}
