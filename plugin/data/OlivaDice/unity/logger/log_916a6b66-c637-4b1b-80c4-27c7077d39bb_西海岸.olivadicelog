{"time": 1774530832, "type": "recv", "message_id": "880664519", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（tp完理论上就可以直接动手了对不对）"}
