{"time": 1768277172, "type": "recv", "message_id": "486204056", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "\"学生会长啊，那他下午应该会回来，等他一起？\""}
