{"time": 1769055200, "type": "recv", "message_id": "873345297", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“然后闭上眼睛吧”低头看着舒茉"}
