{"time": 1775532146, "type": "recv", "message_id": "2047787220", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好啦。\"她点点头，指了指面前如用蜂巢一般的建筑物，\"到了，这里怎么样?\""}
{"time": 1775532291, "type": "recv", "message_id": "1042169189", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“wow...好壮观啊”"}
