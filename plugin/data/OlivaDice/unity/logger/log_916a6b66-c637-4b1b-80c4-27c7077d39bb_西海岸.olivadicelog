{"time": 1775037036, "type": "recv", "message_id": "1051837652", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（偷师了一手理解，推推棒nibja）"}
