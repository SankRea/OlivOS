{"time": 1767960367, "type": "recv", "message_id": "1824839960", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（感觉该跳到开学第一课了）"}
{"time": 1767960477, "type": "recv", "message_id": "1025087766", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(也对吧)"}
