{"time": 1774838110, "type": "recv", "message_id": "416471975", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我睡到五点半被蚊子咬了四五口)"}
{"time": 1774838123, "type": "recv", "message_id": "1119605188", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(王从天降，愤怒狰狞)"}
{"time": 1774838124, "type": "recv", "message_id": "545179957", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（为什么睡沙发）"}
