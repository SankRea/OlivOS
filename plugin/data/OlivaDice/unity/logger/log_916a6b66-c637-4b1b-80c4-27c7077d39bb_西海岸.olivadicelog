{"time": 1767606194, "type": "recv", "message_id": "184468673", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(也有比较大的河虾吧)"}
