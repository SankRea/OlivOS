{"time": 1775532972, "type": "recv", "message_id": "582561467", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好大的漏斗”"}
