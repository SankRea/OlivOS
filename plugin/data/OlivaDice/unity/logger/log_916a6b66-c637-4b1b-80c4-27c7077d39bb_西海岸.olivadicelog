{"time": 1775118045, "type": "recv", "message_id": "1282209457", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（怎么这次没追半天）"}
