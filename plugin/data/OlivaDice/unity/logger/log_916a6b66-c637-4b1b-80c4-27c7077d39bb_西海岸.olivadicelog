{"time": 1774534912, "type": "recv", "message_id": "957186012", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（什么时候被没收了）"}
{"time": 1774534980, "type": "recv", "message_id": "295348919", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(那两把进了这边之后是不是就没了我记得。)"}
{"time": 1774534994, "type": "recv", "message_id": "873728804", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(她的剑你当成闪烁之光我感觉差不多)"}
{"time": 1774534999, "type": "recv", "message_id": "198467159", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（没啊，一开始是）"}
{"time": 1774535008, "type": "recv", "message_id": "117874802", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我拿的露露一把，师父一把）"}
{"time": 1774535011, "type": "recv", "message_id": "1723801818", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(坏了，你的不会叫阐释者吧)"}
