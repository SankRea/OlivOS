{"time": 1776164503, "type": "recv", "message_id": "341338702", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（三角洲赛季末没什么冲的欲望）"}
{"time": 1776164515, "type": "recv", "message_id": "1322887388", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（不如宝可梦）"}
