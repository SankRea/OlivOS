{"time": 1776748549, "type": "recv", "message_id": "1839057945", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:at,qq=1252219916] “没事啦...”自觉牵起她手"}
{"time": 1776752977, "type": "recv", "message_id": "1218990493", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（还醒着吗）"}
{"time": 1776753450, "type": "recv", "message_id": "1723276439", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(你应该问翔哥还醒着没)"}
