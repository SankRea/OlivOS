{"time": 1768979092, "type": "recv", "message_id": "1814823313", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "看看四周有没有人“在这里吗，我今天看老前辈手册里，里面提到个地方...好像更合适一些...”"}
{"time": 1768979149, "type": "recv", "message_id": "310179349", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（是吗，我已经完全不记得了（））"}
{"time": 1768979205, "type": "recv", "message_id": "980328079", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "闭着的眼眸睁开，\"嗯哼?什么？\""}
