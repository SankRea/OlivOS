{"time": 1767685025, "type": "recv", "message_id": "644657181", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（好的）"}
{"time": 1767685029, "type": "recv", "message_id": "266225774", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（所以确实会被拍死。但是相对静止的匀速运动没什么好说的）"}
{"time": 1767685049, "type": "recv", "message_id": "559197149", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（那假如是在车顶呢）"}
