{"time": 1773795688, "type": "recv", "message_id": "986792895", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(刚看完折神改枪)"}
{"time": 1773797167, "type": "recv", "message_id": "1752903643", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=771266017]\"什么表示...\"泉支支吾吾起来，不过她始终保持在你的身后几步路的地方，看起来并不会主动离开。"}
{"time": 1773797413, "type": "recv", "message_id": "629151895", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*愤怒已经只剩下无语了，扭头看着妃花“我还是第一次见这种的”"}
{"time": 1773797548, "type": "recv", "message_id": "1891715415", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "妃花眨了眨眼，倒是没在泉面前接过话，她轻笑了一下，抓起你的手袖，\"我们现在怎么办?\"\n泉难得没开口回敬你，低着脑袋不知道在想什么。"}
{"time": 1773797585, "type": "recv", "message_id": "1732226300", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我会说我一直在找人（））"}
{"time": 1773797666, "type": "recv", "message_id": "1855776178", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“先随便找个老师问问什么情况好了”"}
{"time": 1773797832, "type": "recv", "message_id": "289191020", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(那你怎么找呢，jpg)"}
