{"time": 1767749921, "type": "recv", "message_id": "1297746627", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:image,summary=&#91;送花&#93;,file=e7-e706d2ae351cab38c6a5d6125a131d38.gif,url=https://gxh.vip.qq.com/club/item/parcel/item/e7/e706d2ae351cab38c6a5d6125a131d38/raw300.gif,key=9bd6ed197ad677e3,emoji_id=e706d2ae351cab38c6a5d6125a131d38,emoji_package_id=235847]"}
