{"time": 1775187721, "type": "recv", "message_id": "526971449", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（但是我还没想好什么惩罚）"}
