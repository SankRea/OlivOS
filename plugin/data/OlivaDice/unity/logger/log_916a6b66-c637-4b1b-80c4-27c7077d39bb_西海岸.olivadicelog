{"time": 1768879570, "type": "recv", "message_id": "2004980541", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "随后一簇火焰在你指尖升腾，现在摸上去肯定会烧伤"}
{"time": 1768879782, "type": "recv", "message_id": "708263142", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "等亚克回来打包好，然后就一起回去吧"}
