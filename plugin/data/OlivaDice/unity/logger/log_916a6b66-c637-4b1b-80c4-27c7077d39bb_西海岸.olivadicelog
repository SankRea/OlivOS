{"time": 1773688293, "type": "recv", "message_id": "1007424042", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1079254948](在沙发上吧)"}
