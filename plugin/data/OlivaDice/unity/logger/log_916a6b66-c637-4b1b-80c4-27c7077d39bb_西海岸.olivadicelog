{"time": 1774683548, "type": "reply", "message_id": "1890596638", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[诺薇拉]演奏出: 1D100=28"}
