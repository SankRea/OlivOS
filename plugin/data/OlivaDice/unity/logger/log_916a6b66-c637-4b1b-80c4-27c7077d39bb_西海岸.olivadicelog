{"time": 1774838144, "type": "recv", "message_id": "1302865825", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（无言了）"}
{"time": 1774838145, "type": "recv", "message_id": "1856968476", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(睡到七点醒了回房间继续睡)"}
