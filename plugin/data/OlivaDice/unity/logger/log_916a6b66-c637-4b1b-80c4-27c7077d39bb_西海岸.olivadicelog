{"time": 1767869828, "type": "recv", "message_id": "1756677972", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（没活了？）"}
{"time": 1767869839, "type": "recv", "message_id": "1244694206", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（也行吧。接下来可能就得参考）"}
{"time": 1767869844, "type": "recv", "message_id": "523653525", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那我们出去随便逛逛？”朝舒茉伸出手"}
{"time": 1767869850, "type": "recv", "message_id": "888684687", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（哈利波特了，虽然我并没有仔细看过）"}
{"time": 1767869884, "type": "recv", "message_id": "450852896", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "呼出口气，点点头，牵上手从床上起来。"}
{"time": 1767869915, "type": "recv", "message_id": "1372025133", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（刚回家就出门好青春啊）"}
{"time": 1767869964, "type": "recv", "message_id": "1152300313", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（如果你能在我们逛逛的时候，把我们拉进副本就逛逛，单纯买买买就可以跳过了）"}
{"time": 1767870000, "type": "recv", "message_id": "482748373", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我在想舒茉的日记本是不是很久没动过了，但是又没什么好动的）"}
{"time": 1767870089, "type": "recv", "message_id": "589748214", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(确认恋爱，抵达新生活不是可以记录吗？俺寻思)"}
{"time": 1767870126, "type": "recv", "message_id": "91386716", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你不翻它，它也不会主动跳出来跟你说如我所书更新了）"}
{"time": 1767870198, "type": "recv", "message_id": "1389505547", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(好的，可能入学前夜会翻翻吧)"}
{"time": 1767870389, "type": "recv", "message_id": "1549007131", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "总之，在被太阳烘烤得暖意十足的街道上走着，又远眺着一批批摩伽陀从塔边归还之后，天色又暗了下来。塔身高处那璀璨的楼层依旧如迫近的星星般闪耀"}
{"time": 1767870440, "type": "recv", "message_id": "1328818281", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "真是热闹啊，这么想着，走在回家的路上。"}
{"time": 1767870567, "type": "recv", "message_id": "1547351857", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "街景被盖上神秘的红紫色，海风扬起，凉意有些许袭人。高塔出现至今，城内为数不多的惊慌已经几乎消失殆尽了"}
{"time": 1767870652, "type": "recv", "message_id": "501048849", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（是时候买顶帽子cos菲比啾比了）"}
{"time": 1767870724, "type": "recv", "message_id": "718730581", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(或许也对)"}
{"time": 1767870743, "type": "recv", "message_id": "688123191", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "颇有些惬意"}
{"time": 1767870992, "type": "recv", "message_id": "2031829539", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（哎，我悟了）"}
{"time": 1767871181, "type": "recv", "message_id": "132615313", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（知道天空之城副本怎么设计了）"}
{"time": 1767871184, "type": "recv", "message_id": "692868768", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“海风吹着好舒服啊”"}
{"time": 1767871228, "type": "recv", "message_id": "1972672591", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯，真希望这样的日子，能平常地持续下去。\"感叹道，\"回去吧～\""}
{"time": 1767871306, "type": "recv", "message_id": "1307584886", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯..走吧”点点头，西海岸果然是个好地方...这样想着，又想到了未白，希望那边不会出什么事...要是能更快的变强就好了"}
{"time": 1767871355, "type": "recv", "message_id": "1014829016", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（现在也不会回未白了吧）"}
{"time": 1767871525, "type": "recv", "message_id": "195238073", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "指尖擦染星尘传递到伊恩的手上，回想起曾玩过的游戏，快步走到前面背着双手回头浅笑，\"现在能追上我吗？\""}
{"time": 1767871629, "type": "recv", "message_id": "1973990889", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（哎，确实该跑起来的）"}
{"time": 1767871675, "type": "recv", "message_id": "1153824595", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“等等我”笑笑，算了，未白的事还是以后在想吧，现在和舒茉过好每一天就好了，扫平心中的郁闷，朝舒茉跑去"}
{"time": 1767871755, "type": "recv", "message_id": "389828360", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"才不要咧。\"笑着往前跑去"}
{"time": 1767872010, "type": "recv", "message_id": "115483061", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "街上行人不多不少。你们追跑着穿行，直到额角微微冒汗，直到心分不清因何而动，夜色恰好落幕，把笑容和腼腆都藏在一起"}
{"time": 1767872058, "type": "recv", "message_id": "2030088540", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "回到家中，舒蕾半买半做地准备好了晚饭，汉斯也已经到了，看起来找工作的事还算顺利，不过自己开店铺，一时半会应该是指望不上了。消费大概要降级了，天天在外面吃多半是很难指望了"}
{"time": 1767872159, "type": "recv", "message_id": "659351468", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "有了些曾经在家里的实感，\"舒茉回来啦——\"拖着长音走进门，\"终于又能吃妈妈做的菜了诶。\""}
{"time": 1767872197, "type": "recv", "message_id": "333354587", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我也回来啦...”跟在舒茉身后"}
{"time": 1767872221, "type": "recv", "message_id": "2087823009", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我在想舒蕾如果要就业的话怎么就（））"}
{"time": 1767872235, "type": "recv", "message_id": "1877072596", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（教练吧）"}
{"time": 1767872263, "type": "recv", "message_id": "2141219682", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（工作时长不能太长，可能教练也对）"}
{"time": 1767872305, "type": "recv", "message_id": "1045228093", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(教练吧)"}
{"time": 1767872447, "type": "recv", "message_id": "721692297", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯哼，前前后后，差不多一周没开过火了吧？”舒蕾在围裙上擦着手“今天来不及买肉自己处理了，尝尝素菜吧？我今天买了菜谱，有机会试试海鲜吧”"}
{"time": 1767872530, "type": "recv", "message_id": "1850571256", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "尝过一次之后对海鲜倒没什么特别的兴趣，不过还是不能拂了妈妈的兴致，点着脑袋坐到餐桌前，\"好诶，反正妈妈做什么都好吃。\""}
{"time": 1767872723, "type": "recv", "message_id": "16659192", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "坐到舒茉身旁“阿姨做的饭还是那么香啊”"}
{"time": 1767872866, "type": "recv", "message_id": "868889360", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "舒蕾很受用地点点头，简单碰杯过后，舒蕾往汉斯身上一靠，不无感慨地说“今天跟他们去学院走了一趟……欸，他们好像都不简单呐。”"}
{"time": 1767872882, "type": "recv", "message_id": "318106217", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（哦凑，忘了让舒蕾问心脏的事了）"}
{"time": 1767872956, "type": "recv", "message_id": "766064594", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶，妈妈说的好像很不了解舒茉一样。\"叉着腰，嘟着嘴，语气佯装生气。"}
