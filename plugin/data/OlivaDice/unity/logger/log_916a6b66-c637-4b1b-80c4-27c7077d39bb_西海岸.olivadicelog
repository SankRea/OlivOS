{"time": 1774552290, "type": "recv", "message_id": "1521480752", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我依然是早起之人)"}
{"time": 1774553415, "type": "recv", "message_id": "1050260450", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(骨大哥确实帅，睡觉)"}
