{"time": 1767813175, "type": "recv", "message_id": "1023443982", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（吃惊不应该是，居然还能摘）"}
