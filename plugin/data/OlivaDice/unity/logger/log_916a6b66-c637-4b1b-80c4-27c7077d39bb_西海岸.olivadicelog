{"time": 1767606285, "type": "recv", "message_id": "1324631458", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（基围虾其实不是品种名（））"}
{"time": 1767606290, "type": "recv", "message_id": "853718198", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（说的是养殖方式）"}
{"time": 1767606331, "type": "recv", "message_id": "1838085303", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"虾头好硬诶...妈妈小心一点啦。\"慢慢细嚼慢咽，\"好吃...\"继续试一试其他的海鲜。"}
{"time": 1767606335, "type": "recv", "message_id": "2051771430", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（但是我吃海鲜也不多，非要问说个所以然就是）"}
{"time": 1767606353, "type": "recv", "message_id": "1619604224", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（海虾偏甜一些，河虾其实没什么特别的味道）"}
{"time": 1767606358, "type": "recv", "message_id": "714738591", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（虾头处理的干净吗（）"}
{"time": 1767606380, "type": "recv", "message_id": "191549590", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（工业革命以前吃虾又不需要考虑重金属污染（））"}
{"time": 1767606397, "type": "recv", "message_id": "1880685759", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（在水箱里养两天就干净了）"}
{"time": 1767606407, "type": "recv", "message_id": "1854464637", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（好像有点道理）"}
{"time": 1767606445, "type": "recv", "message_id": "1364635558", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（但虾不是食腐的么）"}
{"time": 1767606475, "type": "recv", "message_id": "1795972969", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（海里倒是没什么腐不腐一说）"}
{"time": 1767606487, "type": "recv", "message_id": "18767879", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（有啥吃啥）"}
{"time": 1767606503, "type": "recv", "message_id": "1748113473", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（剩肉也是肉）"}
{"time": 1767606582, "type": "recv", "message_id": "1009552887", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯嗯……让背部先入口就好啦”舒蕾传授着技巧，抬手叫了几碗米饭“最大的问题其实是干吃会咸，汤也大多是咸的……啊，饮料还没讨论出个所以然。”"}
{"time": 1767606598, "type": "recv", "message_id": "349092995", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“果汁吧”"}
{"time": 1767606608, "type": "recv", "message_id": "941353937", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "只要不是酒，什么都无所谓其实"}
{"time": 1767606630, "type": "recv", "message_id": "198414040", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"今天喝一点也可以吧...\""}
{"time": 1767606854, "type": "recv", "message_id": "389941645", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "伴着饭吃倒是能接受那股嚼劲十足的口味，不过果然还是要喝点什么。"}
{"time": 1767606894, "type": "recv", "message_id": "67623434", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "舀点汤到饭里，然后夹点鱼尝尝"}
{"time": 1767607246, "type": "recv", "message_id": "447838477", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "更嚼劲十足的是那裹着酱汁的鱿鱼仔，更高的含水量比虾肉更加下饭。鱼肉处理得相当到位，外酥里嫩的同时没有一点腥味，吃起来也没有兽肉那么油腻的负担，难怪能开几十年"}
{"time": 1767607501, "type": "recv", "message_id": "1918790517", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=198414040]期待地看着桌上的人，对上视线的时候双手握拳放在胸前卖萌地眨眼睛。"}
{"time": 1767607692, "type": "recv", "message_id": "1561685008", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（当浮一大白）"}
{"time": 1767608030, "type": "recv", "message_id": "53665338", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“反正也是我来收拾？”舒蕾也眨眨眼"}
{"time": 1767608192, "type": "recv", "message_id": "366221760", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"给爸爸和伊恩收拾啦。\"咯咯笑"}
{"time": 1767610487, "type": "recv", "message_id": "1387553163", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（伊恩呢）"}
{"time": 1767610499, "type": "recv", "message_id": "2037114428", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（哦哦）"}
{"time": 1767610533, "type": "recv", "message_id": "22907570", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哎...”虽然想劝不要喝酒，不过气氛都到了，很难扫兴了“好吧..我没意见”"}
{"time": 1767610765, "type": "recv", "message_id": "658975028", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“好啊，那到时候就交给你们收拾咯~”舒蕾轻笑道“那就来一扎橘子酒？”"}
{"time": 1767610826, "type": "recv", "message_id": "764223584", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯哼～\"拿几个杯子过来码在桌上，\"唔...果酒的话，舒茉能喝多一点。\""}
{"time": 1767610937, "type": "recv", "message_id": "1243018298", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "继续吃饭吧"}
{"time": 1767611122, "type": "recv", "message_id": "527711738", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "给伊恩要一杯蓝莓的果汁，眼睛亮亮地看着他"}
{"time": 1767611161, "type": "recv", "message_id": "678493934", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“谢谢舒茉了..不过..算了，开心就好”"}
{"time": 1767611265, "type": "recv", "message_id": "110348028", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“伊恩怎么看起来愁眉苦脸的？”舒蕾先倒上了两杯"}
{"time": 1767611283, "type": "recv", "message_id": "1560967298", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“没有啦”摇摇头"}
{"time": 1767611370, "type": "recv", "message_id": "1448328808", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "接过杯子，先小口抿一口，\"伊恩担忧的事情总是很多嘛。\"说完咯咯笑起来，\"对不对?\""}
{"time": 1767611370, "type": "recv", "message_id": "1714071462", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "喝一口舒茉帮忙点的蓝莓汁，再吃口好吃的饭，心情很快愉悦起来了"}
{"time": 1767611959, "type": "recv", "message_id": "1729830456", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“是这样嘛”舒蕾笑了笑“我看是有人怕喝酒了。不过今天也不用你来照顾。就是辛苦汉斯了对不对？”她说着往汉斯身上靠了靠，半开玩笑地道。汉斯眨了眨眼，正色道“保证完成任务”"}
{"time": 1767612076, "type": "recv", "message_id": "530611713", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我会帮忙的...”"}
{"time": 1767612079, "type": "recv", "message_id": "40508305", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呼呼～\"被带得心情愉快，\"好哦，那今天...舒茉就加油喝到喝不下为止吧!\""}
{"time": 1767612204, "type": "recv", "message_id": "1640238234", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "先喝下一整杯，\"嘶...\"喉咙有些烧灼，不由得发出呲牙的声音。"}
{"time": 1767612262, "type": "recv", "message_id": "580528686", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“慢点喝啦...”想到了上次自己喝的很快的下场"}
{"time": 1767612299, "type": "recv", "message_id": "625292421", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“呀，倒也……”舒蕾轻轻咳了咳“嘛，算了，今天好不容易有个理由对不对？”"}
{"time": 1767612421, "type": "recv", "message_id": "881464391", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你上次对瓶吹是他妈白酒）"}
{"time": 1767612454, "type": "recv", "message_id": "129292419", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯!\"递出空杯子，\"不会醉的啦，伊恩不用担心，我有分寸。\""}
{"time": 1767612552, "type": "recv", "message_id": "708853736", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哈哈...嗯，好的”虽然嘴上这么说，先继续吃饭吧"}
{"time": 1767612555, "type": "recv", "message_id": "1485030802", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“可别光顾着喝了，多吃点菜”舒蕾半推半就地又给你添上半杯，“伊恩还要加菜吗？”"}
{"time": 1767612673, "type": "recv", "message_id": "710498710", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"知道嘛。\"这次倒是不怎么着急喝完，先吃点干瘪的海鲜，\"呼——这些当下酒菜很合适诶。\""}
{"time": 1767612809, "type": "recv", "message_id": "2020365279", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=1485030802]“差不多够了，谢谢”"}
{"time": 1767612856, "type": "recv", "message_id": "521630919", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你来做客的吗还客气上了.jpg）"}
{"time": 1767612882, "type": "recv", "message_id": "300112490", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（你来做客的吗还客气上了.jpg）"}
{"time": 1767612897, "type": "recv", "message_id": "1599418833", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“舒茉和叔叔呢”"}
{"time": 1767612979, "type": "recv", "message_id": "1927664376", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "自己的食量一直不大，倒是确确实实足够了，\"嗯...不用问我的意见啦。\"拍拍胸口，看起来渐入佳境，递出空杯子"}
{"time": 1767613107, "type": "recv", "message_id": "440417869", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "果酒的那点干涩感让人很容易分不清到底来自于酒精还是糖分，此外黄灿灿的很好看，说是水果罐头里的汁大概也有人信。但度数和红酒也相差无几，而你喝得几乎比舒蕾还快了"}
{"time": 1767613300, "type": "recv", "message_id": "224783312", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "也没有什么难受的感觉，反而生出了些继续喝的欲望，\"嗯...\""}
{"time": 1767613367, "type": "recv", "message_id": "15090969", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "汉斯倒是好像想起了什么高兴的事，揶揄到“伊恩怎么不也喝点，一共就这一瓶。”"}
{"time": 1767613398, "type": "recv", "message_id": "1812318651", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我...我不爱喝酒..”再喝口果汁"}
{"time": 1767613430, "type": "recv", "message_id": "1458800192", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（是这样的，你多喝了就有人要少喝（））"}
{"time": 1767613462, "type": "recv", "message_id": "1781350305", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“但是吧...”看到舒茉喝的那么快"}
{"time": 1767613488, "type": "recv", "message_id": "1153541701", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“稍微尝尝也没什么不好的”给自己满上"}
{"time": 1767613498, "type": "recv", "message_id": "751699770", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（“稍微”）"}
{"time": 1767613523, "type": "recv", "message_id": "139950305", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶?\"递出杯子，\"我也要嘛。\""}
{"time": 1767613549, "type": "recv", "message_id": "904952627", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "帮舒茉也倒点，但是只倒半杯"}
{"time": 1767613660, "type": "recv", "message_id": "97372340", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "盯着杯子，\"怎么这样?\"不接"}
{"time": 1767613759, "type": "recv", "message_id": "858393799", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（不接是什么）"}
{"time": 1767613778, "type": "recv", "message_id": "1917891489", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(就是不接过来，还放在你面前)"}
{"time": 1767613778, "type": "recv", "message_id": "958538384", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（oh）"}
{"time": 1767613794, "type": "recv", "message_id": "2105151049", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我还以为是你手拿着杯子，我给你倒呢）"}
{"time": 1767613821, "type": "recv", "message_id": "2079329024", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "只能帮舒茉倒满了"}
{"time": 1767613870, "type": "recv", "message_id": "774109150", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“噗哈哈”桌对面的舒蕾没忍住笑了出来，没忘记掩着嘴。汉斯没笑出声来，但看起来也憋得有点辛苦"}
{"time": 1767613881, "type": "recv", "message_id": "475261451", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（再叫一瓶不是炸了吗（））"}
{"time": 1767614007, "type": "recv", "message_id": "1381924292", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"这还差不多嘛。\"满意地接到身前，瞪一眼妈妈，接着举起杯子，\"笑一声罚一杯。\""}
{"time": 1767614036, "type": "recv", "message_id": "920198679", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你还罚上了.jpg）"}
{"time": 1767614064, "type": "recv", "message_id": "1058616065", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“叔叔阿姨舒茉，干个杯吧...庆祝新生活的开始”也举起杯子"}
{"time": 1767614116, "type": "recv", "message_id": "1957218375", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好～\"声音绵软悠长，拖着语调"}
{"time": 1767614323, "type": "recv", "message_id": "1536022139", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "一扎的量本来就不算太多，两人各自倒了半杯之后就已经见了底“好好……咳嗯，为了崭新的世界，干杯~”"}
{"time": 1767614427, "type": "recv", "message_id": "935896905", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "斟酌了一下，但是最后没吐出什么祝酒词，\"嗯嗯...\"酒杯送到嘴边，不自觉就喝下大半杯"}
{"time": 1767614555, "type": "recv", "message_id": "1932909205", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "舒蕾倒是面色如常，相当游刃有余。但舒茉已经后知后觉地有些目眩口干了"}
{"time": 1767614589, "type": "recv", "message_id": "75902972", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "看也没什么酒了，就小口慢慢喝完"}
{"time": 1767614679, "type": "recv", "message_id": "485549976", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "挣扎着想要把剩下的小半杯也解决，但是身体有些软，只能趴在桌上枕着自己的手，\"呃...\""}
{"time": 1767614880, "type": "recv", "message_id": "1871793324", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“要不我来帮舒茉吧...”看她好像不太舒服的样子"}
{"time": 1767614928, "type": "recv", "message_id": "1036339485", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“看着还行？还醒着。”舒蕾这次反倒没喝上多少，把瓶子里最后一点底都倒进自己的杯子里“应该也不至于头疼，喝到这个份上就差不多该停咯~尤其是高兴的时候”"}
{"time": 1767615033, "type": "recv", "message_id": "957949841", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"头晕的感觉涌上来，也不算很好受，用力睁着眼睛盯着眼前的餐盘，一直做深呼吸"}
{"time": 1767615272, "type": "recv", "message_id": "927477040", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "拍拍舒茉的背，然后把她面前杯子剩下的酒喝完"}
{"time": 1767615301, "type": "recv", "message_id": "144163421", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（为什么要拍背（））"}
{"time": 1767615319, "type": "recv", "message_id": "1210896401", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我看一般难受都拍背）"}
{"time": 1767615378, "type": "recv", "message_id": "370128051", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "菜也差不多吃完了。晚饭到这已经接近尾声，而西海岸在短暂的小憩后，换上了暖色的纱丽，比赫顿玛尔更加灯火通明"}
{"time": 1767615408, "type": "recv", "message_id": "2015124866", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（听起来像安倍的保镖会干的事情）"}
{"time": 1767615441, "type": "recv", "message_id": "2112706651", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（但是那不重要，间接接吻才重要（））"}
{"time": 1767615442, "type": "recv", "message_id": "1524541440", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(直接喝喝过的杯子吗)"}
{"time": 1767615473, "type": "recv", "message_id": "1899882306", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...?\"有些出神地看着"}
{"time": 1767615508, "type": "recv", "message_id": "1332425496", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=2112706651]（其实对嘴的位置不一定一样）"}
