{"time": 1767685591, "type": "recv", "message_id": "1344306187", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（没有相对运动就不会有阻力）"}
