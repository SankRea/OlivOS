{"time": 1774516973, "type": "recv", "message_id": "1568927754", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（不过学院里时间不对我知道，中环什么时候时间不对的）"}
