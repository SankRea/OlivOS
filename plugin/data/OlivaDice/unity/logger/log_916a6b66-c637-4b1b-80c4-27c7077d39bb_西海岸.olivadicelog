{"time": 1767617999, "type": "recv", "message_id": "68951939", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(既然如此)"}
{"time": 1767618034, "type": "recv", "message_id": "1980736386", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "深吸一口气，站起身，\"我出去散个步...\"虽然有些面红耳赤，视线也有些晃荡"}
{"time": 1767618105, "type": "recv", "message_id": "1755041378", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "想到舒茉之前的酒量“我扶着你吧...”也起身，到舒茉身侧，搀扶住她“小心点”"}
{"time": 1767618545, "type": "recv", "message_id": "1768650806", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没事...\"虽然这么说，不过还是把自己的身体靠到他身上，\"只是...有一点点晕\""}
{"time": 1767618898, "type": "recv", "message_id": "1537430048", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“差不多也该走了”舒蕾拎起行李，稍显臃肿地站了起来"}
{"time": 1767618996, "type": "recv", "message_id": "1883890672", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"唔...嗯...\"靠着伊恩，\"走....——走!\""}
{"time": 1767619102, "type": "recv", "message_id": "2016878727", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "摇了摇头“小酒鬼”小声，然后扶着舒茉“对了，今晚住哪”看向阿姨"}
{"time": 1767619188, "type": "recv", "message_id": "492485235", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"才不是...\"感觉呼吸都带着酒气，\"好困...\""}
{"time": 1767619361, "type": "recv", "message_id": "2048583517", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那要不我背着舒茉吧..这样舒茉还能趴我身上睡会”"}
{"time": 1767619450, "type": "recv", "message_id": "1470784788", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...嗯。\"点头，\"那...伊恩背...背...\""}
{"time": 1767619494, "type": "recv", "message_id": "1770382904", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那舒茉先扶着我..”确保她扶稳之后，慢慢移到她身前，半蹲下来"}
{"time": 1767619543, "type": "recv", "message_id": "2037031756", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（今晚拎包入住啊）"}
{"time": 1767619671, "type": "recv", "message_id": "1915986469", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "安心地趴下，\"呼呼...\"呼出的气息轻轻席卷在眼前人的后脖颈上"}
{"time": 1767619801, "type": "recv", "message_id": "1306955059", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "感受到气息之后浑身震了一下...脸红彤彤的，不过没多说什么，毕竟舒茉已经很累了，慢慢的跟在叔叔阿姨的身后"}
{"time": 1767619899, "type": "recv", "message_id": "1416618645", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "安心地闭着眼，感受晚风吹拂"}
