{"time": 1768465141, "type": "recv", "message_id": "280715360", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（过魔力吗）"}
