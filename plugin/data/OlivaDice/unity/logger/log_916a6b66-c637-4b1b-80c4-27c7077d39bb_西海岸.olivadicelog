{"time": 1775406815, "type": "recv", "message_id": "1228391483", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "下床去洗把脸清醒一下"}
