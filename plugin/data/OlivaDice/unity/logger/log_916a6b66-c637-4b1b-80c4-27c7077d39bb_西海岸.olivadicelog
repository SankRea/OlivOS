{"time": 1767951985, "type": "recv", "message_id": "632919813", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我这样是不是有点绑架舒茉...”"}
{"time": 1767952029, "type": "recv", "message_id": "1370360823", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（缺乏娱乐手段导致的）"}
{"time": 1767952042, "type": "recv", "message_id": "1180755576", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（但是我觉得干别的事也不影响输送魔力啊）"}
{"time": 1767952136, "type": "recv", "message_id": "523707405", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没事啦。\"事已至此，找本小说，在看小说的时候输送魔力。"}
{"time": 1767952214, "type": "recv", "message_id": "455034483", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "凑过去和舒茉一起看"}
{"time": 1767952251, "type": "recv", "message_id": "817237317", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "第二轮结束，两人的魔力基本都喂给了无底洞一般的黑暗之眼。稍微有了些提升的实感"}
{"time": 1767952296, "type": "recv", "message_id": "96045924", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "大概这样坚持两个月，魔力的获取速度和容量就能翻倍吧"}
{"time": 1767952375, "type": "recv", "message_id": "224321308", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "魔力消耗完总是有些疲惫感，打个长长的哈欠，合上书，\"我先去休息了。\""}
{"time": 1767952499, "type": "recv", "message_id": "1952566447", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...晚饭见...”也去睡睡"}
{"time": 1767952579, "type": "recv", "message_id": "2082129988", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(想好开学典礼了吗)"}
