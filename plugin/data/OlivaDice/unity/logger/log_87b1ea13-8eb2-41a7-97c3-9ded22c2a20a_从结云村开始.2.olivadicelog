{"time": 1751921228, "type": "recv", "message_id": "1329736661", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(现在就卡住了)"}
{"time": 1751921236, "type": "recv", "message_id": "1640401851", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(找个坑埋了吧)"}
{"time": 1751921297, "type": "recv", "message_id": "1518095917", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=798772541](但是不是把它从鬼门关扯回来了不管怎么说)"}
{"time": 1751921300, "type": "recv", "message_id": "784058357", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:image,summary=&#91;动画表情&#93;,file=43B2A56BF06247340A244FB99DE06CBD.jpg,sub_type=1,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhQvju6fkgO_qY-NR3nEcmmAGWNj1RjNYCD_CijB0vK1z6uOAzIEcHJvZFCAvaMBWhCfZoRDUNmzPBeqY998kGw3egKqXA&amp;rkey=CAQSMPnFRFE9tZUqLyauy204wGZMujvgD7s8IHZnapiaoD-Am7fDGu2bjAjVquqg3-BSbQ,file_size=12365]"}
{"time": 1751921321, "type": "recv", "message_id": "224878561", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"唉，你要是连死都不怕，为什么不让我绑?\""}
{"time": 1751921561, "type": "recv", "message_id": "467805539", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（怎么看都感觉很变态）"}
{"time": 1751921582, "type": "recv", "message_id": "1166717599", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我为什么要让你如愿？”"}
{"time": 1751921649, "type": "recv", "message_id": "1761172388", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"唉，求求你了。我输了，对不起。你太厉害了...\""}
{"time": 1751921779, "type": "recv", "message_id": "403082642", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "你看到她身上还完好的的部分肉眼可见地泛起一层鸡皮疙瘩"}
{"time": 1751921888, "type": "recv", "message_id": "2023866344", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呜呜...我本来也没那么坚强，对不起...求求你好不好...刚刚都是放狠话...\"把烤鱼递给她，\"不够还有...\""}
{"time": 1751921910, "type": "recv", "message_id": "1378946214", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（不太像人）"}
{"time": 1751922029, "type": "recv", "message_id": "298709847", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……”她无言，重新打量你一番“……你没病吧”"}
{"time": 1751922106, "type": "recv", "message_id": "1546248083", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "鼓起脸颊，\"干嘛...我都求你了。\"恶狠狠地咬一口鱼"}
{"time": 1751922338, "type": "recv", "message_id": "1806046573", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "果然人在无语的时候是会笑的……看起来龙也一样"}
{"time": 1751922386, "type": "recv", "message_id": "1048245389", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "她看着你，有一种引线只剩最后一毫米却被硬生生憋回去的无力感"}
{"time": 1751922439, "type": "recv", "message_id": "154570964", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "趁机把烤好的鱼递给她，\"嗯...很好吃..\""}
{"time": 1751922620, "type": "recv", "message_id": "340891612", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……要不还是杀了我吧，我还能早点解脱”"}
{"time": 1751922733, "type": "recv", "message_id": "654699297", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"不要...你先尝尝\""}
{"time": 1751922768, "type": "recv", "message_id": "273255478", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "再咬口鱼肉，把另一条递到她面前，\"难道做得不好?\""}
{"time": 1751923039, "type": "recv", "message_id": "132702931", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我不会了）"}
{"time": 1751923071, "type": "recv", "message_id": "209561359", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(干嘛，安本来就是柔软的性格吧)"}
{"time": 1751923078, "type": "recv", "message_id": "189401237", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(从来没被这么凶过)"}
{"time": 1751923226, "type": "recv", "message_id": "384561005", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（要是一转弗雷尔卓德童话，这故事就可以断在这里了）"}
{"time": 1751923314, "type": "recv", "message_id": "1397483925", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我一想到她还顶了绘梨衣的名字）"}
{"time": 1751923321, "type": "recv", "message_id": "1334496046", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我就好难受）"}
{"time": 1751923364, "type": "recv", "message_id": "181157927", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(昨日种种)"}
{"time": 1751923384, "type": "recv", "message_id": "698429991", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(千辛万苦)"}
{"time": 1751923385, "type": "recv", "message_id": "790982444", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "她朝远离你的方向缩了缩，没说什么话，看起来远比先前更怕你"}
{"time": 1751923460, "type": "recv", "message_id": "385359748", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "但至少，没有再说什么"}
{"time": 1751923508, "type": "recv", "message_id": "257143554", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "鼓着脸颊，上前把烤鱼塞到她手里，\"不够我这里还有...烤了很多。\"如释重负地松了口气"}
{"time": 1751923713, "type": "recv", "message_id": "19989771", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "场面的变换速度超出看她大脑能处理的极限"}
{"time": 1751923716, "type": "recv", "message_id": "820585236", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "她呆住了"}
{"time": 1751923824, "type": "recv", "message_id": "274559990", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "正好把烤鱼塞进她嘴里"}
{"time": 1751923830, "type": "recv", "message_id": "2017937657", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我也呆住了）"}
{"time": 1751923837, "type": "recv", "message_id": "382976519", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(干什么，这是我)"}
{"time": 1751923845, "type": "recv", "message_id": "1045947498", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(最后的波纹了)"}
{"time": 1751924190, "type": "recv", "message_id": "1019329160", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“咕……唔，咳咳……”她囫囵被塞了一口，随后像是被呛到了，轻轻咳嗽起来，孜然料落到她身上的伤口，疼得她龇牙咧嘴"}
{"time": 1751924200, "type": "recv", "message_id": "28421643", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "……但是没有吐出来"}
{"time": 1751924257, "type": "recv", "message_id": "1007740697", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "拿帕子帮她擦擦伤口，然后垫在烤鱼下面，点点头，\"好吃吗？\""}
{"time": 1751924442, "type": "recv", "message_id": "1401674656", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我已经不知道人设为何物了）"}
{"time": 1751924587, "type": "recv", "message_id": "921231995", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(好的)"}
{"time": 1751924588, "type": "recv", "message_id": "1825406205", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……为什么……到底为什么会变成这样……”她有些呆滞"}
{"time": 1751924659, "type": "recv", "message_id": "1395403365", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"唔...\"抬手摸摸脑袋，\"好啦好啦，以后跟着安，有数不清的鱼吃哦，所以说，绘梨衣大人，求求你了嘛。\""}
{"time": 1751924938, "type": "recv", "message_id": "1147809444", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（不行）"}
{"time": 1751924942, "type": "recv", "message_id": "2001049345", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我rp不了了）"}
{"time": 1751924951, "type": "recv", "message_id": "712192681", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（sv）"}
{"time": 1751924956, "type": "recv", "message_id": "169968999", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(干嘛)"}
{"time": 1751924961, "type": "recv", "message_id": "1365266064", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(这不是马上就)"}
{"time": 1751924965, "type": "recv", "message_id": "551981634", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(敲定下来了)"}
{"time": 1751924973, "type": "recv", "message_id": "301088926", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我最后的绿宝石水花)"}
{"time": 1751925096, "type": "recv", "message_id": "1698683641", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我一想到）"}
{"time": 1751925104, "type": "recv", "message_id": "788797105", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(你一想到)"}
{"time": 1751925108, "type": "recv", "message_id": "571852709", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（以后每次回忆都是这个画面）"}
{"time": 1751925117, "type": "recv", "message_id": "516620368", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（就不是很想让她跟你走了）"}
{"time": 1751925124, "type": "recv", "message_id": "1679589242", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(干什么)"}
{"time": 1751925130, "type": "recv", "message_id": "265163915", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(值得纪念)"}
{"time": 1751925138, "type": "recv", "message_id": "1663449924", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(该拐走了)"}
{"time": 1751925148, "type": "recv", "message_id": "674378345", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(昨日种种辛辛苦苦)"}
{"time": 1751925407, "type": "recv", "message_id": "1596597976", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……我本来就可以天天有鱼吃……”"}
{"time": 1751925478, "type": "recv", "message_id": "1714645477", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"这可是味道不一样的哦?对吧？比生鱼好吃多了吧？\""}
{"time": 1751925537, "type": "recv", "message_id": "1281739411", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"而且还有别的...炒鱼，炸鱼，鱼丸，鱼卷，章鱼丸子，绘梨衣大人肯定不会后悔的啦。\""}
{"time": 1751925549, "type": "recv", "message_id": "790641048", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“可这里才是我的家。它不能没有我”"}
{"time": 1751925650, "type": "recv", "message_id": "997317257", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“就算我已经……变成这样，如果不得不离开……”她皱眉“我也不想和你们去一个方向”"}
{"time": 1751925750, "type": "recv", "message_id": "181578055", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呜呜...还在嫌弃我吗？\"小心地拿起她的手臂摇晃，\"求求你...能不能先给安一个机会。\"眼睛里楚楚可怜"}
{"time": 1751925963, "type": "recv", "message_id": "1128816109", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我好沉默）"}
{"time": 1751925971, "type": "recv", "message_id": "1529475807", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……我需要一个解释”"}
{"time": 1751926077, "type": "recv", "message_id": "2037646145", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"因为安和夏弥都很喜欢...你。\""}
{"time": 1751926165, "type": "recv", "message_id": "121725959", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我好难绷得住）"}
{"time": 1751926174, "type": "recv", "message_id": "663156856", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……你自己说出来不会笑吗？”"}
{"time": 1751926295, "type": "recv", "message_id": "1187142040", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"实话为什么要笑。\"一脸认真"}
{"time": 1751926310, "type": "recv", "message_id": "1540023611", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(但是这就是原因啊)"}
{"time": 1751926376, "type": "recv", "message_id": "515007264", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……你们的喜欢我无福消受，现在的我连下水都疼的要命”"}
{"time": 1751926543, "type": "recv", "message_id": "778878379", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"所以我会...负责的。求你了，就给安一次机会好不好。\"拿出一个秘药放在她手里，\"疗伤...\""}
{"time": 1751927000, "type": "recv", "message_id": "6067322", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“啊……见鬼”她看着你手里的药丸，没有伸手去接，只是向后仰面躺倒在地上。她抬起一条胳膊盖在眼睛上，整个人蜷缩着抽泣起来“为什么……要摆出这种姿态……为什么偏偏是……我，为什么……为什么会这么……疼啊……”"}
{"time": 1751927134, "type": "recv", "message_id": "705681323", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...当时没有停手..因为我判断有误...对不起...\"把药丸放在她嘴边，\"啊——张嘴。\"看着她吃下去。然后拿出新的绷带换掉她身上的染血绷带。做完之后尝试把她抱起来"}
{"time": 1751927253, "type": "recv", "message_id": "432688981", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "在换绷带那一步已经昏过去了"}
{"time": 1751927363, "type": "recv", "message_id": "1232897543", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "走到夏弥旁边，\"唉...夏弥都不帮我说说话，好累...\""}
{"time": 1751927391, "type": "recv", "message_id": "2017891647", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "身心俱疲，\"再也不做这种麻烦的事情了。\""}
