{"time": 1751897501, "type": "recv", "message_id": "544690668", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“具体一点，这人的情况不普通”"}
{"time": 1751897543, "type": "recv", "message_id": "387286201", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“就是在那个海边的湖捡到的”"}
