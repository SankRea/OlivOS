{"time": 1751991768, "type": "recv", "message_id": "569419739", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“安姐姐”一路小跑过去"}
{"time": 1751991782, "type": "recv", "message_id": "1371785659", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（龙神记得把人鱼龙的钱给安）"}
{"time": 1751991783, "type": "recv", "message_id": "947776529", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "你们自然也看到了露儿和后面跟着的蓝发高个女性"}
{"time": 1751991837, "type": "recv", "message_id": "682429539", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（好的）"}
{"time": 1751991848, "type": "recv", "message_id": "260621679", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"小露儿?\"有些惊讶，\"这两天没做什么危险的事吧？\""}
{"time": 1751991877, "type": "recv", "message_id": "2066843051", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“没有哦，我这两天离大海挺远的”"}
{"time": 1751991883, "type": "recv", "message_id": "1841992224", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“对了安姐姐，你的包”"}
{"time": 1751992156, "type": "recv", "message_id": "1095652499", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"真的?\"接过包，\"当时忘记了，是不是麻烦露儿了。\""}
{"time": 1751992193, "type": "recv", "message_id": "1873376283", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“是我忘记还给安姐姐才对，不知道有没有给你造成麻烦”戳手指"}
{"time": 1751992352, "type": "recv", "message_id": "2135868842", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没事，要说麻烦还是我自己弄得多。\"叹口气，小声\"总是说露儿任性...其实最任性还是我啊...\""}
{"time": 1751992423, "type": "recv", "message_id": "2001499908", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“遇到了什么事吗？”"}
{"time": 1751992682, "type": "recv", "message_id": "2058778106", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没什么没什么。\"露出个勉强的笑，\"下午要做什么吗？\""}
{"time": 1751992740, "type": "recv", "message_id": "2029732764", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“昨天接了个委托，不过因为一些原因没做成，下午去做一下”"}
{"time": 1751992764, "type": "recv", "message_id": "505008616", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯....\"看了看她身后的人，\"这位是?\""}
{"time": 1751992816, "type": "recv", "message_id": "226331417", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“这位是沧澜，我最近认识的新朋友”"}
{"time": 1751992838, "type": "recv", "message_id": "152560788", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“沧澜，这位是安姐姐，之前一直很照顾我”"}
{"time": 1751992948, "type": "recv", "message_id": "859022954", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“哦”沧澜简单点头，没有发表看法，继续打量着集会所的每个角落"}
{"time": 1751992999, "type": "recv", "message_id": "2021911818", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"看来之后不需要我陪同了？\"看着露儿，\"小露儿成长了呢\""}
{"time": 1751993076, "type": "recv", "message_id": "1573589655", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“安姐姐不要说这种话，和安姐姐一起出任务也很快乐啊”"}
