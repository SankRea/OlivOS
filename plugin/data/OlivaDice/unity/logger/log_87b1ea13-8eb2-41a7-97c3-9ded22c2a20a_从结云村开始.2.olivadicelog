{"time": 1751960768, "type": "recv", "message_id": "1135866271", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1410732001]\"嗯...\"叹口气，\"我们回去吧。\""}
