{"time": 1751908725, "type": "recv", "message_id": "1164576540", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"唔....都已经喝了我这么多血了，不给不给。\""}
