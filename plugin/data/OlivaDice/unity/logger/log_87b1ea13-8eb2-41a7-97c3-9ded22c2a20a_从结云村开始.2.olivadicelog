{"time": 1751908822, "type": "recv", "message_id": "1677926763", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我想起一个叫夏空的邪恶名字)"}
