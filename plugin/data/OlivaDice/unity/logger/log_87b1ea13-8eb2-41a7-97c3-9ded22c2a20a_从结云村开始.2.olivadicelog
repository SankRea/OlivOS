{"time": 1752601063, "type": "recv", "message_id": "533806868", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（好丢人的出目）"}
{"time": 1752601067, "type": "recv", "message_id": "446915654", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"不试试怎么知道?我在雪山滑的雪可比这坡陡多了。\"拉着夏弥，\"要来支舞吗？\""}
{"time": 1752601072, "type": "recv", "message_id": "378010355", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:image,file=FECF2CD04F68E41881B219D86BA8B394.jpg,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhTSls1BEzqnercJaadpiqdx6rVJAhjP7wUg_woo4vv-4bO_jgMyBHByb2RQgL2jAVoQfU0S36pU13lnxSdf8r2jYHoC_g0&amp;rkey=CAQSMGmTAIWs0AqmbzgHY7ui_HZ3SUUj_ayRQosJ3bsiXDngS5SgRsaSo1cHhHA4X1rn6A,file_size=96207]"}
