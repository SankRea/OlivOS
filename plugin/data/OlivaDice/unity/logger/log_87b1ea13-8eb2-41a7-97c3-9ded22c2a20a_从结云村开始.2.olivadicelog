{"time": 1752517726, "type": "recv", "message_id": "859829051", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯....”"}
{"time": 1752517751, "type": "recv", "message_id": "282212244", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"家里会有人等你，现在也有她在你左右。\""}
{"time": 1752517866, "type": "recv", "message_id": "560481777", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "眼角逐渐湿润，想到在家等自己的父亲和受伤的沧澜，眼泪流了出来“对....对不起，我....以后会做足准备的.....”"}
{"time": 1752517913, "type": "recv", "message_id": "1212116326", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "叹口气，拿出手帕帮她擦掉眼泪\"回去吧。\"轻柔地摸摸脑袋，\"这段时间要是想找我就来炎火吧，尤其是遇到自己面对不了的事情。\""}
{"time": 1752517953, "type": "recv", "message_id": "1254512813", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯....安姐姐....一路顺...风”哽咽的说到"}
{"time": 1752518111, "type": "recv", "message_id": "1726686671", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "收回手，\"我很快也会回来的哦，早些回家吧？\""}
