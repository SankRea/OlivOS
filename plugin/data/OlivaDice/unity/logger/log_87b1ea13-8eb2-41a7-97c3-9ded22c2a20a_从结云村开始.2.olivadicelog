{"time": 1752685212, "type": "recv", "message_id": "1904595481", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（在看短剧？）"}
{"time": 1752685214, "type": "recv", "message_id": "1203619671", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "然后去睡觉吧"}
{"time": 1752685225, "type": "recv", "message_id": "740529514", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=1904595481]（在刷b站刚刚）[CQ:at,qq=825734198]"}
{"time": 1752685238, "type": "recv", "message_id": "1967128559", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（感觉那就）"}
