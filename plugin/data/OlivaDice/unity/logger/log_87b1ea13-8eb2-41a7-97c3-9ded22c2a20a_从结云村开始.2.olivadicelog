{"time": 1751970972, "type": "recv", "message_id": "150200733", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“但是龙变成人什么的....”"}
{"time": 1751971018, "type": "recv", "message_id": "2083192511", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“你还记得自己为什么变成这样了吗”想到之前安姐姐说的有关自己的话，也有些激动"}
{"time": 1751971019, "type": "recv", "message_id": "1616474561", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=150200733]“不知道，我也从来没听说过”"}
