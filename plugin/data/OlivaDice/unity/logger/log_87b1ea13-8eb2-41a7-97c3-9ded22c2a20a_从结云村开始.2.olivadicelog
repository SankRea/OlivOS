{"time": 1752073430, "type": "recv", "message_id": "1598972798", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（又不是现在就出门做）"}
{"time": 1752073718, "type": "recv", "message_id": "700977803", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我的意思是）"}
{"time": 1752073722, "type": "recv", "message_id": "256379084", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（露儿是不是一起下去）"}
{"time": 1752073730, "type": "recv", "message_id": "1709439154", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "跟着"}
{"time": 1752073748, "type": "recv", "message_id": "1560752047", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(翔哥杀戮尖塔玩的太开心)"}
{"time": 1752073751, "type": "recv", "message_id": "1165098030", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(体谅一下)"}
{"time": 1752073808, "type": "recv", "message_id": "2135974578", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "你们又回到任务处"}
{"time": 1752073836, "type": "recv", "message_id": "1553156733", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“晚上好，猎人们，请问要做什么？”"}
