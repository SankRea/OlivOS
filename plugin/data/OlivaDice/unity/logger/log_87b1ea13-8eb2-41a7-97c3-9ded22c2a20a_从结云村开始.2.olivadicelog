{"time": 1752047650, "type": "recv", "message_id": "1660770675", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "总之邀了他们一起去吃饭"}
