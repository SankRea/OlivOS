{"time": 1751966792, "type": "recv", "message_id": "1118324621", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“还可以……所以还有吗”她又把碗朝小栗送了送"}
{"time": 1751966813, "type": "recv", "message_id": "729045506", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“啊……还有的喵，但是病人刚醒来第一餐不可以……”"}
{"time": 1751966843, "type": "recv", "message_id": "499411909", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“应该没事的，给她吧”蝴蝶夫人给予首肯"}
{"time": 1751966912, "type": "recv", "message_id": "532880217", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“那……好的喵，病人稍等……”小栗从沧澜（暂定）手中拿走碗，不一会就接了碗新的回来"}
{"time": 1751966944, "type": "recv", "message_id": "828845584", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“她大概要修养多久”"}
{"time": 1751966952, "type": "recv", "message_id": "1594755660", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（休养）"}
{"time": 1751967018, "type": "recv", "message_id": "882601393", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“不知道，这种程度的雷击伤能活下来就已经是奇迹了。而她现在好像还挺活蹦乱跳的”"}
{"time": 1751967034, "type": "recv", "message_id": "404171312", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“确实蛮神奇的”"}
{"time": 1751967052, "type": "recv", "message_id": "503488554", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“沧澜，你昏迷之前的事还记得吗”"}
{"time": 1751967056, "type": "recv", "message_id": "1516523097", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“看着也不像龙人”"}
{"time": 1751967057, "type": "recv", "message_id": "906565716", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(好像可以再睡一会)"}
{"time": 1751967066, "type": "recv", "message_id": "1223569429", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=906565716]（不准睡[CQ:at,qq=1252219916]"}
{"time": 1751967072, "type": "recv", "message_id": "1107718648", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（你快出场了吧）"}
{"time": 1751967074, "type": "recv", "message_id": "47573872", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(?)"}
{"time": 1751967083, "type": "recv", "message_id": "1082404373", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（确实）"}
{"time": 1751967084, "type": "recv", "message_id": "740669831", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:image,summary=&#91;动画表情&#93;,file=7D191123216E9DABB1AACF49C4BDF12E.jpg,sub_type=1,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhRzdz0kp5wcrwSbLWOEi7S7Vph9KBjJjAEg_woojtXB_fmsjgMyBHByb2RQgL2jAVoQmeGmYNbsLBjwW1CbYLeyDHoC-YY&amp;rkey=CAQSMGxMp3Dk00YLTO4tcVhEC0DOZYilnhr8W7Q6ratVdR8EhgMnBiMZwqk8Cwb2g7zF2A,file_size=17993]"}
{"time": 1751967217, "type": "recv", "message_id": "1703333018", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=503488554]“海里……黑色的……彩色的龙”她皱眉"}
{"time": 1751967248, "type": "recv", "message_id": "1817190797", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“你为什么会在海里呢？”"}
{"time": 1751967349, "type": "recv", "message_id": "1707507446", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“那是我的地盘”她皱眉“我当然在”"}
{"time": 1751967466, "type": "recv", "message_id": "166244300", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“你住在海上？”"}
{"time": 1751967709, "type": "recv", "message_id": "1507722349", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "她点点头"}
{"time": 1751967739, "type": "recv", "message_id": "479952090", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“可是...可是..”"}
{"time": 1751967759, "type": "recv", "message_id": "575346217", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“对了，之前你见过我吗？”"}
{"time": 1751967823, "type": "recv", "message_id": "1160806094", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“对”"}
{"time": 1751967843, "type": "recv", "message_id": "380368710", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“什么时候...我怎么一点印象没有了？”"}
{"time": 1751967889, "type": "recv", "message_id": "1662415077", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“昨天……也许”"}
{"time": 1751967916, "type": "recv", "message_id": "662602586", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“昨天？”"}
{"time": 1751967957, "type": "recv", "message_id": "995527167", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我昨天见到你的时候你在昏迷啊”"}
{"time": 1751968041, "type": "recv", "message_id": "965756287", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“那……可能是前天”"}
{"time": 1751968057, "type": "recv", "message_id": "418205667", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我昏迷了多久？”"}
{"time": 1751968089, "type": "recv", "message_id": "311983794", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我也不太清楚”"}
{"time": 1751968114, "type": "recv", "message_id": "177449680", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“但是我们是在哪碰面的，为什么我一点印象都没有，你感觉还蛮引人注目的”"}
{"time": 1751968192, "type": "recv", "message_id": "808280703", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“水里……弱小生物的避难所入口”"}
{"time": 1751968289, "type": "recv", "message_id": "1397446578", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“前天我是下水了，但是我只看见了一条凶狠的龙，没看到其他人啊”托腮思考🤔"}
{"time": 1751968319, "type": "recv", "message_id": "1639141116", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "算了不想了，喝口水"}
{"time": 1751968361, "type": "recv", "message_id": "648964773", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（[CQ:at,qq=1252219916] 差不多该到了）"}
{"time": 1751968460, "type": "recv", "message_id": "255852371", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "11点前后，安和夏弥，拎着昏迷的绘梨衣回到了村口"}
{"time": 1751968662, "type": "recv", "message_id": "2064077978", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1397446578]“那就是我”她皱眉，平静地丢出一个炸弹"}
{"time": 1751968706, "type": "recv", "message_id": "177365111", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“？”一口水直接吐了出来“怎么..怎么可能呢，那是龙，你是个人啊”"}
{"time": 1751968811, "type": "recv", "message_id": "1379526544", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我不知道发生了什么，我战斗，负伤。昏迷醒来……就是这样”"}
{"time": 1751968880, "type": "recv", "message_id": "331100119", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "蝴蝶夫人的表情先是呆滞，随后是自我怀疑般的沉思，最后变为研究者特有的狂热"}
{"time": 1751968927, "type": "recv", "message_id": "1329028312", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那个医生，你先冷静一下，有没有可能是她这里撞到了”再指指脑袋"}
{"time": 1751968933, "type": "recv", "message_id": "901825675", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“你的意思是……你从龙变成了人？是这样吗？”她抓起沧澜的手，两眼放光"}
{"time": 1751968942, "type": "recv", "message_id": "506705980", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我真的还要去诊所吗)"}
{"time": 1751968953, "type": "recv", "message_id": "1319792860", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我就说我是不是可以睡一觉)"}
{"time": 1751968971, "type": "recv", "message_id": "1288819437", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=506705980]（不然呢）"}
