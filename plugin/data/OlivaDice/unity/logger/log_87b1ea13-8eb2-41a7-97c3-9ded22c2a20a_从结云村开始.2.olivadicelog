{"time": 1752051972, "type": "recv", "message_id": "121707854", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"不过没事的..露儿，不用担心我\""}
{"time": 1752052015, "type": "recv", "message_id": "1849311051", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“安姐姐要不说出来吧，说出来说不定能好点”"}
