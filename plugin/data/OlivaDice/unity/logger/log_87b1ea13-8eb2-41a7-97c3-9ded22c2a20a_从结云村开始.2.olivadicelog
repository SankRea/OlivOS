{"time": 1752514983, "type": "recv", "message_id": "521389658", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "压着火气，“她胡闹，你也跟着胡闹吗”"}
