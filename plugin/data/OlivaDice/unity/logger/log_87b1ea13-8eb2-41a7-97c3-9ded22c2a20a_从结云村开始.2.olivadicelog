{"time": 1751993893, "type": "recv", "message_id": "1041696416", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（然后呢[CQ:at,qq=1040972910] ）"}
{"time": 1751993959, "type": "recv", "message_id": "1062097720", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我只要一半...”"}
{"time": 1751994289, "type": "recv", "message_id": "1630009644", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"不..我完全没有参与那条龙的讨伐。\""}
{"time": 1751994303, "type": "recv", "message_id": "1730365801", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（尬黑）"}
{"time": 1751994324, "type": "recv", "message_id": "1848643918", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"还是露儿拿走吧。\""}
{"time": 1751994441, "type": "recv", "message_id": "425785831", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"而且，露儿现在花钱很快吧。\""}
{"time": 1751994462, "type": "recv", "message_id": "1452507007", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“....谢谢安姐姐”"}
{"time": 1751994605, "type": "recv", "message_id": "595936914", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯，没事啦。\""}
{"time": 1751994676, "type": "recv", "message_id": "916716691", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（这样吧）"}
{"time": 1751994683, "type": "recv", "message_id": "1851319080", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "。rd+6 夏弥侦查"}
{"time": 1751994683, "type": "reply", "message_id": "1851319080", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[张风辰]使用[夏弥侦查]演奏出:[1D20+6={20}+6=26]"}
{"time": 1751994691, "type": "recv", "message_id": "110423934", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那很会侦查了）"}
{"time": 1751994704, "type": "recv", "message_id": "1686586053", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "。rd+2 沧澜侦查"}
{"time": 1751994704, "type": "reply", "message_id": "1686586053", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[张风辰]使用[沧澜侦查]演奏出:[1D20+2={11}+2=13]"}
{"time": 1751994735, "type": "recv", "message_id": "118474266", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我们还没吃过饭，露儿要一起吗\""}
{"time": 1751994769, "type": "recv", "message_id": "1058247133", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯？”夏弥抬头，略微多看了沧澜一眼，最后视线停留在她的右侧身子上"}
{"time": 1751994806, "type": "recv", "message_id": "1979240850", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "沧澜也抬起头，嗅着什么“怎么有股血味……”"}
{"time": 1751994971, "type": "recv", "message_id": "82320114", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我刚刚吃过了”"}
{"time": 1751994981, "type": "recv", "message_id": "54079878", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“晚饭在一起吧，如果任务顺利的话”"}
{"time": 1751995013, "type": "recv", "message_id": "1225664397", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯，做什么任务?\""}
{"time": 1751995116, "type": "recv", "message_id": "1981382102", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“捕获夜鸟，感觉难度还行”"}
{"time": 1751995178, "type": "recv", "message_id": "1734461140", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哦...露儿小心一下它的尖嘴。\""}
{"time": 1751995184, "type": "recv", "message_id": "1345810046", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那我就准备吃饭了?\""}
{"time": 1751995234, "type": "recv", "message_id": "1512257464", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯嗯，再见了安姐姐”"}
{"time": 1751995247, "type": "recv", "message_id": "892854959", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你还是过个怪物常识吧（）"}
{"time": 1751995254, "type": "recv", "message_id": "1375017265", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（夜鸟和尖嘴有什么关系（）"}
{"time": 1751995374, "type": "recv", "message_id": "1036255799", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(哦猫头鹰)"}
{"time": 1751995391, "type": "recv", "message_id": "1511019382", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"拜拜，晚上见啦，我请大家吃饭。\""}
{"time": 1751995457, "type": "recv", "message_id": "1059907121", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我来请吧，毕竟人鱼龙那个任务给了好多钱”"}
{"time": 1751995570, "type": "recv", "message_id": "946532631", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我会定好餐等你的。\"笑一笑，把钥匙递给绘梨衣，\"我们也吃饭吧。\""}
{"time": 1751995693, "type": "recv", "message_id": "1122410449", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=946532631]“……”她沉默地接过钥匙，放在掌心打量着"}
{"time": 1751995753, "type": "recv", "message_id": "1201347770", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"你的房间，嗯..在这边的话不要暴露自己的身份，就当自己是普通人。\"小声，指着屏风后的餐桌，\"坐吧。\"说完就拉着夏弥先落座。"}
{"time": 1751995996, "type": "recv", "message_id": "402444783", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1059907121]（你呢）"}
{"time": 1751996143, "type": "recv", "message_id": "452233526", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1201347770]你和夏弥落了座。绘梨衣拿着钥匙，只是站到桌边，并不落座——大概臀部与腿部还有血口子"}
{"time": 1751996149, "type": "recv", "message_id": "2123183904", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（[CQ:at,qq=1040972910] 睡着了？）"}
{"time": 1751996153, "type": "recv", "message_id": "779231892", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（没）"}
{"time": 1751996180, "type": "recv", "message_id": "1689289085", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "带着沧澜做任务去喽"}
{"time": 1751996181, "type": "recv", "message_id": "337074749", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1979240850]（怎么根本没人理我，哎）"}
{"time": 1751996208, "type": "recv", "message_id": "1159185987", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(有什么好说的我)"}
{"time": 1751996338, "type": "recv", "message_id": "375423692", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1689289085]（那过个幸运吧）"}
{"time": 1751996376, "type": "recv", "message_id": "499934155", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=452233526]“安”夏弥开口“那个沧澜，似乎有些不一般”"}
{"time": 1751996438, "type": "recv", "message_id": "1386642712", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"怎么了?\"看着绘梨衣的样子，给她找来一个软垫"}
{"time": 1751996501, "type": "recv", "message_id": "489095402", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": ".rd+1 幸运"}
{"time": 1751996501, "type": "reply", "message_id": "489095402", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[露儿]使用[幸运]演奏出:[1D20+1={6}+1=7]"}
{"time": 1751996539, "type": "recv", "message_id": "1360356404", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“侧身有一道很长的伤痕，看起来是新伤。不过看起来，她似乎受影响有限”"}
{"time": 1751996574, "type": "recv", "message_id": "1965320135", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……不过最主要的是，眼睛是竖瞳……我们猜测过的吧？”"}
{"time": 1751996582, "type": "recv", "message_id": "217095752", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...我知道。\""}
{"time": 1751996588, "type": "recv", "message_id": "1292965745", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"是那只海龙吗\""}
{"time": 1751996736, "type": "recv", "message_id": "864699426", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=489095402]沿海的天色依旧阴郁，此时日渐西斜，更是暮色沉沉，连带着涛声都有些唬人。而夜鸟——并不在先前你发现的巢穴里，应该是出去了"}
{"time": 1751996760, "type": "recv", "message_id": "1338561179", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1292965745]“我不知道，海里的生物我了解不多”"}
{"time": 1751996821, "type": "recv", "message_id": "849481603", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“但如果是海龙的话……”夏弥顿了顿“是什么存在能伤到她？”"}
{"time": 1751996881, "type": "recv", "message_id": "2095329631", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=864699426]（走过去都傍晚了？[CQ:at,qq=825734198]"}
{"time": 1751996890, "type": "recv", "message_id": "308888312", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（看样子不能和安一起吃饭了）"}
{"time": 1751996894, "type": "recv", "message_id": "1832728217", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（没有啊）"}
{"time": 1751996901, "type": "recv", "message_id": "1266027819", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（就这天色）"}
{"time": 1751996916, "type": "recv", "message_id": "172384457", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我也不太清楚...\"把软垫给绘梨衣垫下"}
{"time": 1751997043, "type": "recv", "message_id": "1681013028", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“emmm，不在巢穴吗”"}
{"time": 1751997063, "type": "recv", "message_id": "1944331925", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=172384457]“……”绘梨衣看了你一眼，尝试性地坐了下去，但没多久又站了起来。菜品上来后，也只能端着碗吃"}
{"time": 1751997070, "type": "recv", "message_id": "713069466", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "看看周围有没有什么痕迹"}
{"time": 1751997077, "type": "recv", "message_id": "2144682891", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那天不是找到了两个存在吗？\""}
{"time": 1751997091, "type": "recv", "message_id": "854552822", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=713069466]（飞的能有什么痕迹）"}
{"time": 1751997101, "type": "recv", "message_id": "1915891134", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（不知道啊）"}
