{"time": 1752478556, "type": "recv", "message_id": "1405802607", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（肯定中了才算啊）"}
{"time": 1752478588, "type": "recv", "message_id": "536541733", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(诶，那我好像节奏全面放缓了)"}
{"time": 1752478608, "type": "recv", "message_id": "1752455111", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(大部分时间应该都会摸过去)"}
{"time": 1752478626, "type": "recv", "message_id": "502586704", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（你闲着没事可以去听河南战歌（[CQ:at,qq=1252219916]"}
{"time": 1752478657, "type": "recv", "message_id": "190769274", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(神人)"}
{"time": 1752478718, "type": "recv", "message_id": "665539908", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（其实活当然是自己找的）"}
{"time": 1752478739, "type": "recv", "message_id": "742661497", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（不过kp想推动当然也不难）"}
{"time": 1752478765, "type": "recv", "message_id": "1469826361", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（怪猎推动剧情当然是靠放怪）"}
{"time": 1752478785, "type": "recv", "message_id": "1983319157", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（那安明说要放缓节奏了，如果同时推进的话，应该大部分时候都没啥事）"}
{"time": 1752478873, "type": "recv", "message_id": "802984775", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(不过我倒是问题不大喵)"}
{"time": 1752478895, "type": "recv", "message_id": "128613837", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=708205819][CQ:at,qq=1040972910] 总之到了"}
{"time": 1752478977, "type": "recv", "message_id": "574686867", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“沧澜沧澜，出发吧”"}
{"time": 1752479112, "type": "recv", "message_id": "1556474134", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“好，今天要去狩猎什么来着？”沧澜早就等在前厅的座位上，见你来了便站起来"}
{"time": 1752479232, "type": "recv", "message_id": "1372807087", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“影蜘蛛，不过我们得准备点照明的东西了”"}
{"time": 1752479489, "type": "recv", "message_id": "1332983853", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1372807087]“嗯……火把？”"}
{"time": 1752479579, "type": "recv", "message_id": "973964598", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯，要不太黑了，或者沧澜，你能用雷电照明吗”"}
{"time": 1752479729, "type": "recv", "message_id": "1915224425", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“遗憾，我没法持续放电。体力限制是其一，其二是身体并没有那么耐电”"}
{"time": 1752479764, "type": "recv", "message_id": "1107793261", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“这样，那我们还是准备点火把吧”"}
{"time": 1752480063, "type": "recv", "message_id": "186206756", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "买点火把，朝着目的地前进！"}
{"time": 1752480326, "type": "recv", "message_id": "1670736945", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "那你们沿着先去去过的道路，往先前发现的那个洞口去。赶路自然免不了些时间，但天气恰好，只是发汗，但不至于黏腻"}
{"time": 1752480358, "type": "recv", "message_id": "1397336369", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "反倒有些畅快感，至少，你看，鱼不会有汗腺"}
{"time": 1752480470, "type": "recv", "message_id": "658024504", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "上次你们敲开的那个洞口已经被新的石头堵上了"}
{"time": 1752480689, "type": "recv", "message_id": "363135600", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“emmm，该怎么办呢，被石头堵上了”"}
{"time": 1752480804, "type": "recv", "message_id": "1727137134", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“被堵上了？”沧澜看着这块和地面说得上有些严丝合缝的石头“意思是，下面有个洞？”"}
{"time": 1752480837, "type": "recv", "message_id": "1891391096", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯，那只蜘蛛我之前碰到过，逃跑本身挺厉害的”"}
{"time": 1752480893, "type": "recv", "message_id": "148148299", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“就住在这颗石头底下的洞穴里”"}
{"time": 1752480912, "type": "recv", "message_id": "196223421", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不过这石头确实是个难题啊，不知道有没有其他路”"}
{"time": 1752480949, "type": "recv", "message_id": "101770925", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（[CQ:at,qq=1252219916] 该说不说，其实可以醒）"}
{"time": 1752480956, "type": "recv", "message_id": "183256208", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（虽然醒了也没活）"}
