{"time": 1752515770, "type": "recv", "message_id": "1806041673", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...\"不打算继续谈论这些事情，跟其他人打个招呼，示意可以先离开了"}
{"time": 1752515774, "type": "recv", "message_id": "1720828032", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（BYD好尴尬啊）"}
{"time": 1752515782, "type": "recv", "message_id": "1341700764", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(没事，我会自己走开)"}
{"time": 1752515802, "type": "recv", "message_id": "1431969345", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "她迟疑了一会“没事，刚刚碰到了安，她给你用了解毒药”"}
{"time": 1752515828, "type": "recv", "message_id": "1149490931", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“安姐姐吗？”四处看看"}
