{"time": 1752132821, "type": "recv", "message_id": "411094631", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "起床，伸个懒腰"}
{"time": 1752132939, "type": "recv", "message_id": "698604422", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"看见了金色的雷...好生气，嘶..然后就...在发泄..好害怕..安不想变成那样\""}
{"time": 1752133078, "type": "recv", "message_id": "1787816350", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "去吃早饭吧"}
