{"time": 1752052330, "type": "recv", "message_id": "418743836", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“对不起，你就当我在胡说吧”"}
