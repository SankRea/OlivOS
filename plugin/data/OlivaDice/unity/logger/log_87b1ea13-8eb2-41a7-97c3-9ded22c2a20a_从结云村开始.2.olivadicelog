{"time": 1752684322, "type": "recv", "message_id": "1266518435", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那怎么揉呢.jpg）"}
