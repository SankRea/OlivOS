{"time": 1752664301, "type": "recv", "message_id": "494841574", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "走上前看看这头尾锤龙"}
