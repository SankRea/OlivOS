{"time": 1751969135, "type": "recv", "message_id": "1116150709", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=255852371]（）"}
{"time": 1751969149, "type": "recv", "message_id": "1522944208", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(看见蝴蝶奶奶畏惧了)"}
{"time": 1751969170, "type": "recv", "message_id": "497527949", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我在考虑现在举家带口去隔壁村子的事)"}
{"time": 1751969196, "type": "recv", "message_id": "1927628513", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（？）"}
{"time": 1751969229, "type": "recv", "message_id": "1107350746", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那...如果你真是那条龙的话，你伤好了不会揍我吧”"}
{"time": 1751969277, "type": "recv", "message_id": "240265428", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1107350746]“我为什么要揍你？”她不解"}
{"time": 1751969287, "type": "recv", "message_id": "624617157", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1116150709](不是抱着)"}
{"time": 1751969299, "type": "recv", "message_id": "713173309", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(拎着重伤员有点哈人)"}
{"time": 1751969301, "type": "recv", "message_id": "596958864", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（区别不大）"}
{"time": 1751969302, "type": "recv", "message_id": "1809692259", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我...我砍了她一刀”"}
{"time": 1751969355, "type": "recv", "message_id": "12931167", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“原来，你那是攻击？”"}
{"time": 1751969368, "type": "recv", "message_id": "226062160", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"唔.....\"探一下泡狐的鼻息"}
{"time": 1751969388, "type": "recv", "message_id": "1089343874", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“你..难道不是被我吓跑了吗”"}
