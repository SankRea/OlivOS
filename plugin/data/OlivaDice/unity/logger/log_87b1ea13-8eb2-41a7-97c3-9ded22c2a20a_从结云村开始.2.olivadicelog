{"time": 1752062189, "type": "recv", "message_id": "1048606816", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“一起去泡温泉？边泡边聊”"}
{"time": 1752062234, "type": "recv", "message_id": "611797215", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“...中午才泡过，不是很想去”"}
{"time": 1752062244, "type": "recv", "message_id": "589626658", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“唔……真大胆”"}
{"time": 1752062259, "type": "recv", "message_id": "1228239209", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "村子附近有没有什么淡水湖"}
{"time": 1752062270, "type": "recv", "message_id": "93239671", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（应该有的）"}
{"time": 1752062285, "type": "recv", "message_id": "212076646", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“而且，就这么邀请我去泡温泉吗？”眨眨眼睛"}
{"time": 1752062320, "type": "recv", "message_id": "856302521", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那算了，村子附近有个湖，这个点应该没什么人，我们可以去那里聊”"}
{"time": 1752062421, "type": "recv", "message_id": "126290381", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=212076646]“绝对哒咩”夏弥叉手"}
{"time": 1752062448, "type": "recv", "message_id": "119011099", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=856302521]()"}
{"time": 1752062615, "type": "recv", "message_id": "2021497637", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“到底要说什么啦，弄得这么神秘”"}
{"time": 1752062660, "type": "recv", "message_id": "525784335", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“emmm，一些奇怪的事情，感觉安姐姐可能会知道，关于她的”指指沧澜"}
{"time": 1752062683, "type": "recv", "message_id": "83607824", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“不是很想出门，要不去房间？”"}
{"time": 1752062694, "type": "recv", "message_id": "1765069057", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“也行吧”"}
{"time": 1752062842, "type": "recv", "message_id": "1060025905", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“唔唔……行吧”夏弥勉强点头同意"}
{"time": 1752062915, "type": "recv", "message_id": "1768650896", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "那么回房间"}
{"time": 1752062961, "type": "recv", "message_id": "468452348", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "带着沧澜跟着"}
{"time": 1752062967, "type": "recv", "message_id": "2132586734", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "房间依旧是那样，宽窗大桌，照明喜人"}
{"time": 1752063024, "type": "recv", "message_id": "224482290", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "搬两张椅子，\"坐吧。\"自己坐在床上，\"要问什么?\""}
{"time": 1752063059, "type": "recv", "message_id": "1027593524", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“总之就是很奇怪的一件事”"}
{"time": 1752063097, "type": "recv", "message_id": "1466024940", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯?\""}
{"time": 1752063100, "type": "recv", "message_id": "1918144449", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“沧澜本来是条海龙，不知道为什么变成了人，安姐姐你别不相信，我没骗你”认真的说到"}
{"time": 1752063111, "type": "recv", "message_id": "786539022", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“嗯，我猜到了。”"}
{"time": 1752063117, "type": "recv", "message_id": "1774324999", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“只有这个吗？”"}
{"time": 1752063141, "type": "recv", "message_id": "888870095", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（觉在吗）"}
{"time": 1752063148, "type": "recv", "message_id": "267858837", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“没事，我也觉得....哎！这不奇怪吗”本来以为安姐姐不会相信，没想到这么平淡"}
{"time": 1752063165, "type": "recv", "message_id": "511577990", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“你不会觉得我脑子有问题吧....”"}
{"time": 1752063165, "type": "recv", "message_id": "1062091242", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（可能不在）"}
{"time": 1752063228, "type": "recv", "message_id": "2114676978", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“不觉得，为什么这么想”"}
{"time": 1752063250, "type": "recv", "message_id": "771032362", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“感觉蛮匪夷所思的”"}
{"time": 1752063256, "type": "recv", "message_id": "1794223141", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那安姐姐知道原因吗”"}
{"time": 1752063347, "type": "recv", "message_id": "186872095", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "摇头"}
{"time": 1752063377, "type": "recv", "message_id": "1866128350", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那安姐姐之前遇到过类似的事？感觉好像过于平静了”"}
{"time": 1752063401, "type": "recv", "message_id": "596544909", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“嗯，你在水下的时候被她。”指着苍蓝，“划伤了对吧。”"}
{"time": 1752063421, "type": "recv", "message_id": "761584107", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“那时候我就有这方面的预感了。”"}
{"time": 1752063446, "type": "recv", "message_id": "264526268", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯，她咬了一口我的手腕...”"}
{"time": 1752063455, "type": "recv", "message_id": "1359619429", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“唉？这有什么关系吗”"}
{"time": 1752063528, "type": "recv", "message_id": "1396961314", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“虽然不知道原理，但好像只要进战并且淋到了血，他们就会变成人的样子哦。”靠在夏弥肩膀上，说话很轻。、"}
{"time": 1752063554, "type": "recv", "message_id": "1141208435", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "看着自己的手腕"}
{"time": 1752063576, "type": "recv", "message_id": "1265570541", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“血？谁的血都可以吗”"}
{"time": 1752063598, "type": "recv", "message_id": "974478570", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"你的。\""}
{"time": 1752063618, "type": "recv", "message_id": "1125130948", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“啊？为什么...这么神奇吗”"}
{"time": 1752063661, "type": "recv", "message_id": "2079710834", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"解释不清啦...\"揉揉自己的眉心"}
{"time": 1752063677, "type": "recv", "message_id": "1916139670", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（龙神我问你，沧澜没什么反应吗）"}
{"time": 1752063684, "type": "recv", "message_id": "964572810", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（没有）"}
{"time": 1752063695, "type": "recv", "message_id": "2123888632", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（那很平静了）"}
{"time": 1752063698, "type": "recv", "message_id": "1072835882", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "看看沧澜"}
{"time": 1752063715, "type": "recv", "message_id": "1654820685", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我们也不知道原因”夏弥一起摇头“尽管这件事已经发生过好几次了”"}
{"time": 1752063743, "type": "recv", "message_id": "988229052", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好几次？”"}
{"time": 1752063831, "type": "recv", "message_id": "532183737", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯，我似乎有些太任性了。\""}
{"time": 1752063844, "type": "recv", "message_id": "1225000370", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"所以下定决心以后不会再用这种能力。\""}
{"time": 1752063886, "type": "recv", "message_id": "656596254", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "吐出口气，\"还有什么要问的吗？\""}
{"time": 1752063903, "type": "recv", "message_id": "1213607427", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好像没什么了....”"}
{"time": 1752063996, "type": "recv", "message_id": "1473285706", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...那我来问问吧，是什么把海龙打伤成这样?\""}
{"time": 1752064024, "type": "recv", "message_id": "1780821121", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“沧澜你自己说吧，她们都是好人，没关系的”"}
{"time": 1752064035, "type": "recv", "message_id": "789520778", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1213607427]（你不该问问还有谁么（）"}
{"time": 1752064118, "type": "recv", "message_id": "1441794252", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（）"}
{"time": 1752064161, "type": "recv", "message_id": "1192174276", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1780821121]“不，我也很好奇”对敌人是谁的话题，沧澜似乎更感兴趣一些“那头不知名的龙，明明在海中，却长着翅膀……像个三角形。通体漆黑，却又会发出流动的光”"}
{"time": 1752064180, "type": "recv", "message_id": "1056619362", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“能放电，而且不用快速游动就能影响浪潮”"}
{"time": 1752064208, "type": "recv", "message_id": "1205741336", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“流动的光是？”"}
{"time": 1752064230, "type": "recv", "message_id": "248142134", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“在身上，彩色的，流动的光”"}
{"time": 1752064236, "type": "recv", "message_id": "1783516506", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"....\""}
{"time": 1752064295, "type": "recv", "message_id": "1909776240", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(那我认识吗)"}
{"time": 1752064300, "type": "recv", "message_id": "1079222291", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你不认识）"}
{"time": 1752064318, "type": "recv", "message_id": "2135424381", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（不能怪物知识吗（bushi）"}
{"time": 1752064323, "type": "recv", "message_id": "312271444", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（不能）"}
