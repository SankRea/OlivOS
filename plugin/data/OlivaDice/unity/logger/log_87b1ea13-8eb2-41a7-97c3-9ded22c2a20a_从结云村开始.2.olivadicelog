{"time": 1752041843, "type": "recv", "message_id": "864173256", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"用这个。\"展示手里的鳞片"}
