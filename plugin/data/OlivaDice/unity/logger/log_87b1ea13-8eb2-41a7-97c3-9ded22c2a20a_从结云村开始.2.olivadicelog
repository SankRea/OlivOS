{"time": 1752649736, "type": "recv", "message_id": "1375787050", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那我就不客气啦。\"切一些鹿背上的腱子肉，分给夏弥然后自己吃一点"}
{"time": 1752649737, "type": "recv", "message_id": "1090665830", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "兔子抖动了两下鼻子，开始追着你的草药跑"}
