{"time": 1751900657, "type": "recv", "message_id": "1468908619", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“露儿？回来了，一身的水……没带伞吗？”你的父亲开门，把你迎进来"}
{"time": 1751900796, "type": "recv", "message_id": "150526758", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我今天狩猎的时候捡到了一个伤员，然后把她带了回来”"}
{"time": 1751900834, "type": "recv", "message_id": "1209947091", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“赶路有些急，所以没打伞，不过父亲别担心，我身体蛮好的”"}
{"time": 1751901039, "type": "recv", "message_id": "1369880271", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“噢……伤员”彻伸手擦干你睫毛上的水“做得好……你自己没事吧？”"}
{"time": 1751901091, "type": "recv", "message_id": "281957775", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯，我自己没什么事，毕竟我很厉害”有点骄傲"}
{"time": 1751901130, "type": "recv", "message_id": "504626412", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“等下吃完饭，我想去照顾一下她，晚上就不回来了”"}
{"time": 1751901157, "type": "recv", "message_id": "916192282", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯，以后露儿也是某人的救命恩人了，很厉害哦”"}
{"time": 1751901174, "type": "recv", "message_id": "1010144664", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“要过夜啊……注意身体，不要太累着了”"}
{"time": 1751901201, "type": "recv", "message_id": "1833466287", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯嗯，我已经长大了，父亲不用太担心我了”"}
{"time": 1751901315, "type": "recv", "message_id": "1451358966", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "总之，你炫完了饭"}
{"time": 1751901395, "type": "recv", "message_id": "236248694", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "去洗个澡"}
{"time": 1751901415, "type": "recv", "message_id": "263842980", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "洗完了澡"}
{"time": 1751901419, "type": "recv", "message_id": "586739305", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "听起来接下来该睡觉了"}
