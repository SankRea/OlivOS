{"time": 1752339881, "type": "recv", "message_id": "28100228", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...好啦...\"停一下，提高音量，\"老板！来生意了。\""}
{"time": 1752339944, "type": "recv", "message_id": "1469171551", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "那你们看到老板从月痕式楼梯走下来"}
