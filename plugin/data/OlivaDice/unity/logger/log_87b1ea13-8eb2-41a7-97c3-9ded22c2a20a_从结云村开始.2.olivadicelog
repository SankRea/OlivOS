{"time": 1752067313, "type": "recv", "message_id": "1038533108", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"有点..想放弃，想回家...\""}
