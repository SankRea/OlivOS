{"time": 1752126152, "type": "recv", "message_id": "272511817", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"出门吗？\"眨眨眼，\"那些任务不急的\""}
