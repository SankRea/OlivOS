{"time": 1752147168, "type": "recv", "message_id": "1046106253", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“是蜂蜜吗？”"}
{"time": 1752147275, "type": "recv", "message_id": "962174363", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=983936261]“干嘛，我去消食”"}
{"time": 1752147346, "type": "recv", "message_id": "287184638", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1046106253]“不知道，我没见过”"}
{"time": 1752147360, "type": "recv", "message_id": "1401385141", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那你带路，我们可以去看看”"}
{"time": 1752147469, "type": "recv", "message_id": "906075075", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=962174363]\"正好我们也散散步嘛。\"倚着夏弥，轻巧地开口"}
