{"time": 1752037714, "type": "recv", "message_id": "1399718999", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(或许去学会的时候，你可以补一下)"}
