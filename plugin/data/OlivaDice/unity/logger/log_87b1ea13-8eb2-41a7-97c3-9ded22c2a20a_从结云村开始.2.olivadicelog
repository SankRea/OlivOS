{"time": 1751897251, "type": "recv", "message_id": "592692424", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "随后从瓶子里倒出一个小药丸，捏开那女人的嘴巴，塞到喉咙深处"}
{"time": 1751897288, "type": "recv", "message_id": "484133688", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "打个哈欠"}
