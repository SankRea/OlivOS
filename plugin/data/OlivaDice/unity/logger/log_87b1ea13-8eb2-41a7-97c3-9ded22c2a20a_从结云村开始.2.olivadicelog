{"time": 1752478380, "type": "recv", "message_id": "1420629975", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（对的对的）"}
{"time": 1752478382, "type": "recv", "message_id": "537190752", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（反击本来就不吃武器材质）"}
{"time": 1752478474, "type": "recv", "message_id": "1844945820", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那就前四刀+4，之后需要磨刀不然就+3）"}
