{"time": 1756387920, "type": "reply", "message_id": "410359872", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "1040972910"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "继续记录乐谱"}
{"time": 1756387967, "type": "recv", "message_id": "1693772870", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“呀，这么快就又见面了，小白毛~还有你的新朋友？”"}
{"time": 1756387977, "type": "recv", "message_id": "4896921", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"您好?这边是什么情况...\"眨眨眼"}
{"time": 1756388023, "type": "recv", "message_id": "323378293", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“这边是我的工作室~很明显吧？”"}
{"time": 1756388092, "type": "recv", "message_id": "1173403130", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“？”"}
