{"time": 1756910037, "type": "recv", "message_id": "997808269", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“你们在这里干什么呢”"}
{"time": 1756910070, "type": "recv", "message_id": "1719869038", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“金属啊，不是吃的啊。”"}
{"time": 1756910133, "type": "recv", "message_id": "2000434837", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "[CQ:reply,id=997808269]“我准备做饭给她吃啾”"}
{"time": 1756910165, "type": "recv", "message_id": "497897534", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯。\""}
{"time": 1756910215, "type": "recv", "message_id": "684057383", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（这借口你们就用上了是吧）"}
{"time": 1756910496, "type": "recv", "message_id": "465883674", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“菜还没买呢，我要去买肉。”"}
{"time": 1756911076, "type": "recv", "message_id": "103830944", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（怎么没人说话了）"}
{"time": 1756911081, "type": "recv", "message_id": "1298179993", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“那其他几位是来蹭饭的？”"}
{"time": 1756911089, "type": "recv", "message_id": "581612413", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（而且感觉我把画风带歪了）"}
{"time": 1756911154, "type": "recv", "message_id": "903022028", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（要拉群吗）"}
{"time": 1756911166, "type": "recv", "message_id": "1039534466", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "（否）"}
{"time": 1756911321, "type": "recv", "message_id": "1471334787", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"算是。\""}
{"time": 1756912378, "type": "recv", "message_id": "235200564", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“所以说希望这位大叔不要在这块区域周围打架啾”"}
{"time": 1756912379, "type": "recv", "message_id": "496862719", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“为什么？”"}
{"time": 1756912587, "type": "recv", "message_id": "125224280", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"有打的必要吗？\""}
{"time": 1756912680, "type": "recv", "message_id": "1873327296", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "[CQ:reply,id=125224280]“我觉得没有啾”"}
{"time": 1756912688, "type": "recv", "message_id": "1974169510", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“现在不是还没有正式开始吗？”"}
{"time": 1756912706, "type": "recv", "message_id": "1943066485", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“时间没到也不能动手吧，时间到了你们还能客客气气地在这唠家常？”*大叔"}
{"time": 1756912724, "type": "recv", "message_id": "1624038777", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“因为欠了别人一个人情啾，要以这种方式偿还啾”"}
{"time": 1756912766, "type": "recv", "message_id": "343848500", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“不到只剩最后两个人是没有确定的敌人的啾”"}
{"time": 1756912820, "type": "recv", "message_id": "1497932765", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“所以说你们几个是结盟了？”*大叔"}
{"time": 1756912971, "type": "recv", "message_id": "2136916282", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“只是这小鸟说她很会做饭，就想吃饭了，中午饭还没吃。”"}
{"time": 1756913029, "type": "recv", "message_id": "3938181", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“只是身为阎魔亭老板娘要为饿肚子的人做饭啾”"}
{"time": 1756913086, "type": "recv", "message_id": "1877951361", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我只是看这位很有老板娘很熟悉，加上她做的菜确实不错啦。\"看着新进来的大叔，\"我想阁下总要卖我们一个面子。\""}
{"time": 1756913104, "type": "recv", "message_id": "1332319455", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "（很有老板娘是什么）"}
{"time": 1756913131, "type": "recv", "message_id": "243272261", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(删掉很有)"}
{"time": 1756913279, "type": "recv", "message_id": "1008442520", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（话说这个大叔是从者吗？）"}
{"time": 1756913288, "type": "recv", "message_id": "784407007", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(是)"}
{"time": 1756913297, "type": "recv", "message_id": "269100283", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我甚至知道是哪个傻哔)"}
{"time": 1756913322, "type": "recv", "message_id": "1084291031", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "“无妨，我也只是看这里这么多魔力波动，进来看看罢了”*大叔"}
{"time": 1756913421, "type": "recv", "message_id": "1764310867", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "[CQ:reply,id=1084291031]“既然大家其乐融融这么和谐，不如来交换一些情报？”"}
{"time": 1756913450, "type": "recv", "message_id": "1122294378", "deleted": false, "dect": {"host_id": null, "group_id": "1057651114", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那就待会见?\"看向红阎魔，\"我想，你总不至于不愿意见我吧？毕竟...\"刻意停下来不说"}
