{"time": 1754985637, "type": "recv", "message_id": "1873800051", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“没事..这点小伤不算什么...”"}
