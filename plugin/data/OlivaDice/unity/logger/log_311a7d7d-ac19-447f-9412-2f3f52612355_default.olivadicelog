{"time": 1754936759, "type": "recv", "message_id": "1614794028", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“露露...你自己来吧，做出自己的抉择”"}
