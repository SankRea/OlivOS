{"time": 1754998072, "type": "recv", "message_id": "350613006", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*也不强求，由着她自己消遣，伸出手看一眼"}
