{"time": 1756628565, "type": "recv", "message_id": "144029221", "deleted": false, "dect": {"host_id": null, "group_id": "1057762086", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "（感觉看完不会想吃了）"}
{"time": 1756628587, "type": "recv", "message_id": "1770644896", "deleted": false, "dect": {"host_id": null, "group_id": "1057762086", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "（但是不排除撕裂伤在腹部 从内到外撕那种）"}
{"time": 1756628591, "type": "recv", "message_id": "417136332", "deleted": false, "dect": {"host_id": null, "group_id": "1057762086", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "此行的目的是为了探明买卖城袭击事件的真相，观察喇嘛和毛子们有什么异动，把情况汇报给他"}
