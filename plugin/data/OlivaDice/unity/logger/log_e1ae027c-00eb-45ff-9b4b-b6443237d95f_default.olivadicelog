{"time": 1770708399, "type": "recv", "message_id": "880565974", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(虽然有人睡着了)"}
{"time": 1770708407, "type": "recv", "message_id": "192419442", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(不过姑且把之后要用的东西开好)"}
{"time": 1770708414, "type": "recv", "message_id": "1072903761", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(OK)"}
{"time": 1770708420, "type": "recv", "message_id": "1156984876", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(能开@我)"}
{"time": 1770708424, "type": "recv", "message_id": "96039897", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(不然有可能看不见)"}
{"time": 1770709194, "type": "recv", "message_id": "1060206177", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（我直接call）"}
{"time": 1770710041, "type": "recv", "message_id": "1547587211", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "静静的跟在老师身后"}
{"time": 1770710051, "type": "recv", "message_id": "962026548", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:at,qq=1370316409]"}
{"time": 1770710063, "type": "recv", "message_id": "1842757626", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*紧随其后"}
{"time": 1770710175, "type": "recv", "message_id": "341353332", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“谢谢班长了”突然开口"}
{"time": 1770710212, "type": "recv", "message_id": "1286512428", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“没什么，应尽的责任”"}
{"time": 1770710532, "type": "recv", "message_id": "1890072801", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "老师大概是听到了你们的对话，回头看了你们一眼，喉头耸动，但是没有开口说什么。"}
{"time": 1770710567, "type": "recv", "message_id": "1400154818", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*看向老师"}
{"time": 1770710576, "type": "recv", "message_id": "1404564442", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“怎么了，有什么事吗？”"}
{"time": 1770710624, "type": "recv", "message_id": "763969489", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "你们走的时候下课铃还没响，因此走廊上没什么人，他摇摇头，“没什么，待会麻烦你们送到器材室了。”"}
{"time": 1770710635, "type": "recv", "message_id": "1973851868", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“好的”"}
{"time": 1770710638, "type": "recv", "message_id": "538548159", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯....”"}
{"time": 1770710886, "type": "recv", "message_id": "2062747549", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "你们在办公室和他分开，正巧下课铃也响了。"}
{"time": 1770710907, "type": "recv", "message_id": "419618049", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*看看器材室里是什么情况"}
{"time": 1770710964, "type": "recv", "message_id": "1053896436", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "气氛一下就变得轻松愉快，社团活动的学生陆续涌出教室，归家部则紧随其后，下午的好天气正适合做些什么，整个教学楼立刻变得吵吵闹闹。"}
{"time": 1770711011, "type": "recv", "message_id": "1810889573", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(回家打游戏部)"}
{"time": 1770711013, "type": "recv", "message_id": "1932130485", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "器材室里分了化学，物理两大类，其中物理也有标注了光学的部分，架子上空缺了一个箱子大小的空间。"}
{"time": 1770711035, "type": "recv", "message_id": "1916156328", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*把刚才出问题的透镜拿出来看看，其他的归位"}
{"time": 1770711269, "type": "recv", "message_id": "450397563", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "把东西放好，凑过去和班长一起看"}
{"time": 1770711339, "type": "recv", "message_id": "933408540", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "透镜总归像是上了年代的老物，金属的部分有些锈蚀，镜子本身则有些包浆，上面蒙着一些黄色的东西。"}
{"time": 1770711396, "type": "recv", "message_id": "2146095585", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“只是有些旧了没道理会出现实验错误”"}
{"time": 1770711401, "type": "recv", "message_id": "1614855717", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“奇怪”"}
{"time": 1770711409, "type": "recv", "message_id": "1199008713", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“神山同学你怎么看”"}
{"time": 1770711435, "type": "recv", "message_id": "379700724", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我不懂啊，我物理蛮烂的”挠挠头“要不我们再试一次？”"}
{"time": 1770711448, "type": "recv", "message_id": "1650641061", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*再试试实验"}
{"time": 1770711725, "type": "recv", "message_id": "813591342", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（那，说出你实验的步骤）"}
{"time": 1770711735, "type": "recv", "message_id": "1825231973", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(我勒个逗)"}
{"time": 1770711745, "type": "recv", "message_id": "3567381", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "照着老师刚刚做的做"}
{"time": 1770712119, "type": "recv", "message_id": "824606444", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(233做的好啊)"}
{"time": 1770712120, "type": "recv", "message_id": "1124621503", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（那你过个灵感吧，小窗。）"}
{"time": 1770712319, "type": "recv", "message_id": "1887760922", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "神山摆弄了一下，半天没能在光屏上看见成像。"}
{"time": 1770712343, "type": "recv", "message_id": "47026191", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“呃，抱歉，我记得不太清了，班长你来试试吧”"}
{"time": 1770712357, "type": "recv", "message_id": "292719004", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“感觉不像是实验步骤的问题啊”"}
{"time": 1770712358, "type": "recv", "message_id": "61497501", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "倒是班长看出了她操作上的不规范，很快就照着样子弄出了一个倒着的蜡烛像。"}
{"time": 1770712370, "type": "recv", "message_id": "646966352", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“原来就是实验不规范的问题”"}
{"time": 1770712376, "type": "recv", "message_id": "1023693078", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "[CQ:image,summary=&#91;动画表情&#93;,file=BFA9991CDA5AA6D6AA1A912F5FCEB42E.jpg,sub_type=1,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhSA1kAgsAYqiIFFran9n7p4e8NeDhi6EiD_Cije_MXRwc6SAzIEcHJvZFCAvaMBWhCGkBPfdy6J7R0kfmmmucLfegKC1IIBAmd6&amp;rkey=CAESMLLFrVspBz_lWTxeAmUwo0slGoipu5ZWQ1MRFaeKQuhqjtqCg715Kn6BX1aALlbPvg,file_size=2362]"}
{"time": 1770712391, "type": "recv", "message_id": "1864124158", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“感觉老师不会出错吧，对了班长”"}
{"time": 1770712415, "type": "recv", "message_id": "1715505304", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我拉窗帘的时候好像看到窗户外有像”"}
{"time": 1770712423, "type": "recv", "message_id": "1768649818", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“？”"}
{"time": 1770712474, "type": "recv", "message_id": "52126491", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“窗户外面？怎么感觉那是不应该出现的东西呢”"}
{"time": 1770712697, "type": "recv", "message_id": "1671775316", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（请继续）"}
{"time": 1770712719, "type": "recv", "message_id": "153845431", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“总之我们先把这块透镜拿上吧，反正也有点问题”"}
{"time": 1770712730, "type": "recv", "message_id": "1887286137", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哇嘎呐..那我先走了，我还有社团活动要做呢”"}
{"time": 1770712769, "type": "recv", "message_id": "233662628", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我也该走了，我还得去田径部训练呢”"}
{"time": 1770712788, "type": "recv", "message_id": "522978561", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“拜拜啦”回教室拿剑"}
{"time": 1770712817, "type": "recv", "message_id": "493380100", "deleted": false, "dect": {"host_id": null, "group_id": "1077323674", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。log off"}
