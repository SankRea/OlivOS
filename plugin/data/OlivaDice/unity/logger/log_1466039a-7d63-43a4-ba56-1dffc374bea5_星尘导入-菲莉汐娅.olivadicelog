{"time": 1757910516, "type": "recv", "message_id": "225194267", "deleted": false, "dect": {"host_id": null, "group_id": "1043679506", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "（冰滴挺浓的，参考浓茶）"}
