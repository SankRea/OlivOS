{"time": 1753274794, "type": "recv", "message_id": "1688769571", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（你是对的）"}
{"time": 1753274923, "type": "recv", "message_id": "850002739", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“请稍等我做一番准备”"}
{"time": 1753275065, "type": "recv", "message_id": "1586207981", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没问题。\"找个地方坐下，心里盘算这什么"}
{"time": 1753275291, "type": "recv", "message_id": "1946571926", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "他取出一个装饰华丽的瓶子，从里面倒出一些水到一个盘子上，将瓶子供奉在桌上，引导你跪在毯子上"}
{"time": 1753275413, "type": "recv", "message_id": "2059467842", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "带着对魔法的虔诚照做"}
{"time": 1753275514, "type": "recv", "message_id": "382169180", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "主教手持盘子，站在你身前叽里咕噜说了好多宗教用语（懒得编了），然后双指沾了盘子里的水，往你的额头点去"}
{"time": 1753275554, "type": "recv", "message_id": "2055418447", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "静下心来，感受有没有什么联系"}
{"time": 1753275569, "type": "recv", "message_id": "1006591607", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "又是叽里咕噜一段话，神父示意你洗礼结束了"}
{"time": 1753275586, "type": "recv", "message_id": "186567291", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": ".rh"}
{"time": 1753275586, "type": "reply", "message_id": "186567291", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[夜鹿夜游真夜中]试图在黑暗中窥见岁月史书"}
{"time": 1753275587, "type": "reply_private", "message_id": "186567291", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "在演奏厅中[夜鹿夜游真夜中]演奏出: 1D100=81"}
{"time": 1753275620, "type": "recv", "message_id": "1777153521", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "你感觉，眉心湿湿的有点痒"}
{"time": 1753275662, "type": "recv", "message_id": "1357951394", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呃...\"心里默然"}
{"time": 1753275679, "type": "recv", "message_id": "589593525", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我难道不是很虔诚的人吗？神啊，能把治疗的魔法赐给我吗？\""}
{"time": 1753275685, "type": "recv", "message_id": "1558524618", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "心里话"}
{"time": 1753275739, "type": "recv", "message_id": "391663097", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "当然是，没有回应"}
{"time": 1753275762, "type": "recv", "message_id": "355975704", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"....\""}
{"time": 1753275780, "type": "recv", "message_id": "680761800", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好像没什么感觉，主教大人。\""}
{"time": 1753275800, "type": "recv", "message_id": "265409796", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"不如您直接施展一番，我也好尝试从根源上解析。\""}
{"time": 1753276012, "type": "recv", "message_id": "593805882", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“洗礼之后便能与神相连接，只要心诚，神终有一日会给予奖赏”"}
{"time": 1753276076, "type": "recv", "message_id": "1928894103", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“而且，我并没有获得治愈他人的能力，你找梅露露吧”"}
{"time": 1753276222, "type": "recv", "message_id": "47295353", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哦?\"睁大眼睛，\"您是什么类型的神恩?\""}
{"time": 1753276255, "type": "recv", "message_id": "730746915", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "主教笑而不语"}
{"time": 1753276320, "type": "recv", "message_id": "1334115384", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶?我很想知道啦，毕竟事关存在证明。\""}
{"time": 1753276451, "type": "recv", "message_id": "1319651596", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“桃乐丝小姐的目的不是要研究治愈魔法吗”"}
{"time": 1753276601, "type": "recv", "message_id": "1958079811", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"议题当然不止一个了，因为先前接触的神恩只有梅露露亲的治愈魔法嘛，所以才搁置了下来。\""}
{"time": 1753276646, "type": "recv", "message_id": "1368532344", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"如果有神の存在证明这种有趣的课题，很难不让人追问。\""}
{"time": 1753276751, "type": "recv", "message_id": "2097272132", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“桃乐丝小姐真是贪心呢”"}
{"time": 1753276792, "type": "recv", "message_id": "2029741582", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“总不能是我们这边一直在付出吧”"}
{"time": 1753276876, "type": "recv", "message_id": "1360345371", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我可是提出过要加盟成为贵教的原始成员了，梅露露亲拒绝了哦\""}
{"time": 1753277151, "type": "recv", "message_id": "486210269", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“我们可不敢让塔里出来的人成为我们的高层呢”"}
{"time": 1753277167, "type": "recv", "message_id": "962916257", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“不管你是不是异端”"}
{"time": 1753277200, "type": "recv", "message_id": "2042285491", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"怎么了？这是偏见哦，我已经划清界限了。\""}
{"time": 1753277267, "type": "recv", "message_id": "229165429", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"而且，我觉得贵教很有意思，就发展而言，之后应该会相当不错，对于我而言，也是合适的。\"打个响指，\"毕竟桃乐丝不老不灭，已经被追杀了两百年呢？\"笑"}
{"time": 1753277309, "type": "recv", "message_id": "1968333075", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“还请容我拒绝”主教还以微笑"}
{"time": 1753277413, "type": "recv", "message_id": "1358053172", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"唉，有点无情哦。\""}
{"time": 1753277431, "type": "recv", "message_id": "2007643278", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "调整了一下神色，\"那么，您希望我回报什么？\""}
{"time": 1753277787, "type": "recv", "message_id": "147216867", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“我不需要桃乐丝小姐回报什么，你想研究治愈魔法大可找梅露露，那是你们俩之间的私事”"}
{"time": 1753277955, "type": "recv", "message_id": "382909978", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"看来是不能从主教大人这里得到什么帮助或解释了？\""}
{"time": 1753278019, "type": "recv", "message_id": "416182486", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"但是，能给我留下什么证明或信物之类的吗？若干年后我大概还会找上门呢，主教先生。\""}
{"time": 1753278142, "type": "recv", "message_id": "736633185", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“直接找梅露露不就好了”"}
{"time": 1753278369, "type": "recv", "message_id": "603673354", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"唉，真让人伤心。\""}
{"time": 1753278384, "type": "recv", "message_id": "705375799", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"梅露露亲，我可以带走一阵子吗？\""}
{"time": 1753278559, "type": "recv", "message_id": "1552747969", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“诶？”梅露露惊叫一声"}
{"time": 1753278605, "type": "recv", "message_id": "1431637759", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“我还得在这里给镇民看病呢”"}
{"time": 1753279938, "type": "recv", "message_id": "1552058063", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好吧，看来只有握时常叨扰了。\""}
{"time": 1753280200, "type": "recv", "message_id": "185722837", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“那么你们聊，我就先走了”主教向你们俩告别"}
