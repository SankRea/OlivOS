{"time": 1752481193, "type": "recv", "message_id": "257455580", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "你们来到了一个卖点心的铺子，上面是新鲜出炉的甜点"}
{"time": 1752481296, "type": "recv", "message_id": "49463316", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呜哇...这个不粗诶。\"俯下身子，看着糕点，\"老板怎么卖的\""}
{"time": 1752481403, "type": "recv", "message_id": "851759617", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“不贵不贵，我们店的点心很实惠的哦”老板给你比了一个数，确实挺实惠的，而且领主姑且也有给你发工资"}
{"time": 1752481593, "type": "recv", "message_id": "1143827074", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"感觉可以买一点诶，回去也能带给小安琪尝尝。\"挑一些形状很好的打包起来"}
{"time": 1752481767, "type": "recv", "message_id": "1888367569", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“啊，我要吃这个”格林买了几个蛋挞"}
{"time": 1752481810, "type": "recv", "message_id": "1306913742", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"少吃一点，格林的小肚子都长出来了。\""}
{"time": 1752481892, "type": "recv", "message_id": "313670390", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“胡……胡说！”"}
{"time": 1752481962, "type": "recv", "message_id": "20324835", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "格林摸了摸肚子"}
{"time": 1752481965, "type": "recv", "message_id": "334259141", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我早上才看到的，这些天是不是太松懈了?\""}
{"time": 1752482101, "type": "recv", "message_id": "1724676518", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“怎么会，明明我都有在……”格林又揉了揉肚子，确认肚子并没有赘肉后安心下来"}
{"time": 1752482170, "type": "recv", "message_id": "1628426596", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哼哼，果然瞒着阿桃在偷偷做什么吧？\"走上前盯着她，\"快从实招来哦\""}
{"time": 1752482295, "type": "recv", "message_id": "159689835", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“没有啦，师傅吃蛋挞”她把一个蛋挞塞你嘴里，然后往下一个摊走去"}
{"time": 1752482395, "type": "recv", "message_id": "1511241484", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"唔唔...\"咬一口之后伸手拿下来，\"半夜是不是跑去练习匕首了？这种事要瞒着阿桃吗？\""}
{"time": 1752482638, "type": "recv", "message_id": "203693041", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "格林小跑开溜"}
{"time": 1752482667, "type": "recv", "message_id": "1838789922", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶?别跑。\"跟着她的脚步"}
{"time": 1752482891, "type": "recv", "message_id": "146669395", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（该看下一个摊是什么了"}
