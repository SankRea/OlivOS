{"time": 1752485529, "type": "recv", "message_id": "425942523", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "走着走着，你发现了地上有些格林刚才买的蛋挞的包装袋"}
{"time": 1752485605, "type": "recv", "message_id": "1588190307", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"....\"顺着袋子一路跟过去"}
{"time": 1752485798, "type": "recv", "message_id": "1732731945", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "走了一段路，没有多的袋子了，你来到一个三叉路口，你要往哪边走？"}
{"time": 1752485849, "type": "recv", "message_id": "332968320", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "左边看起来光线要更暗一点"}
{"time": 1752485890, "type": "recv", "message_id": "1179377535", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "建筑看起来也更古老"}
{"time": 1752485910, "type": "recv", "message_id": "2121170046", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "应该说是更老旧（）"}
