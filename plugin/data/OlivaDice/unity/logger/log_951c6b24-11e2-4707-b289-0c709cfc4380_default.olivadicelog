{"time": 1753265257, "type": "recv", "message_id": "1105475081", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "格林在练剑"}
{"time": 1753265336, "type": "recv", "message_id": "310099727", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "上次说要看着阿桃，总之等她告一段落的时候询问一下"}
{"time": 1753265538, "type": "recv", "message_id": "964858305", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“嗯？这也要我一起去吗？”"}
