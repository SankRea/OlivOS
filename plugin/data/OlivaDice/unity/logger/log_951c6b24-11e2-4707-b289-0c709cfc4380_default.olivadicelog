{"time": 1752480700, "type": "recv", "message_id": "1635650459", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:image,summary=&#91;动画表情&#93;,file=5CEBC378207B06969230746E0126CB79.jpg,sub_type=1,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhQS1i10E_DWSd384iE2W4yJ_c6e6xiDgAEg_woo1PHNrPO7jgMyBHByb2RQgL2jAVoQsZwTs3qf-fE11zPhc-zegHoC0kI&amp;rkey=CAMSMBd4LKLsDRvca6sJGQfKSjthoHH_WFCilMTGfw2GNSCQcAaUDdsRAdQaieRSVotu-Q,file_size=16387]"}
