{"time": 1753191231, "type": "recv", "message_id": "1365397301", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我有点厉害嘛)"}
{"time": 1753191323, "type": "recv", "message_id": "1911461670", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“嗯，蛮好看的”"}
{"time": 1753191507, "type": "recv", "message_id": "567110098", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯哼?\"拉着她，\"那今天格林就是我的侍女了，走吧？\"歪着头看她，\"出去花园转转?\""}
{"time": 1753191541, "type": "recv", "message_id": "1504897685", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“谁是你的侍女啊……”"}
{"time": 1753191559, "type": "recv", "message_id": "1442368541", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“得寸进尺了是吧”"}
{"time": 1753191570, "type": "recv", "message_id": "1734178361", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "戳你脸"}
{"time": 1753191682, "type": "recv", "message_id": "1656675309", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯哼?今天嘛，就今天。\""}
{"time": 1753191703, "type": "recv", "message_id": "669039814", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "对着她伸出手，\"挽着我，走嘛。\""}
{"time": 1753191779, "type": "recv", "message_id": "551258492", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我可是很早就想当一当所谓的贵族了。\"咂咂嘴"}
{"time": 1753191861, "type": "recv", "message_id": "594320769", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（好麻烦（）"}
