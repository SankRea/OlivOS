{"time": 1753188640, "type": "recv", "message_id": "1434086297", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(略早说是)"}
{"time": 1753188804, "type": "recv", "message_id": "45814302", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（10点吧）"}
{"time": 1753188835, "type": "recv", "message_id": "925101533", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“这叫显年轻”"}
{"time": 1753188914, "type": "recv", "message_id": "101017458", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我本来就年轻。\"打个哈欠，慵懒地眯着眼睛，\"配什么衣服?说起来，我很少穿贵族的衣服 \""}
{"time": 1753188950, "type": "recv", "message_id": "457883628", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“普通的不就好了”"}
{"time": 1753189057, "type": "recv", "message_id": "1377805888", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶?特意打扮一番，不应该惊艳所有人?\"扭头看她，戳戳自己的脸，\"难道阿桃不好看吗？\""}
{"time": 1753189127, "type": "recv", "message_id": "1211918523", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“还行吧，只比我差那么一点点”"}
{"time": 1753189269, "type": "recv", "message_id": "1159395247", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶?\"站起身，转身坐在桌上看向格林，\"格林可不能昧着良心说话呢？老实说，阿桃长相已经是最好的一档了吧？\""}
{"time": 1753189363, "type": "recv", "message_id": "1817419649", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“但是，我也不赖”"}
{"time": 1753189370, "type": "recv", "message_id": "1339971473", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "[CQ:image,summary=&#91;动画表情&#93;,file=4BC8D9B74714068C636998F0F8FF252C.jpg,sub_type=1,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhQqhcG_k63UolI5ERld7XlyRId4YhjsOSD_CijP_dysw9COAzIEcHJvZFCAvaMBWhA6PKd5p40kiPh2jDraSbPGegKArw&amp;rkey=CAISMMO2nCPOSSljTV7xNR_0T7VG4fiLuswQrQyziEUUY-XyrCW0aP0tke54ukMUjRCRSg,file_size=7404]"}
{"time": 1753189570, "type": "recv", "message_id": "51425149", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哼哼，不过不知道为什么，走在路上为什么没人看我啦?\""}
{"time": 1753189609, "type": "recv", "message_id": "1117606410", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"每次我都在想这个问题。\"苦着脸，\"难道确实是没打理吗？\"站起身，拉开衣柜看看有没有什么贵族式的服饰"}
{"time": 1753189634, "type": "recv", "message_id": "237262427", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（又在加戏（）"}
{"time": 1753189697, "type": "recv", "message_id": "1161461283", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "有的姐妹，有的"}
{"time": 1753189711, "type": "recv", "message_id": "1086033343", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "这样的贵族服饰有九套"}
{"time": 1753189799, "type": "recv", "message_id": "1320793139", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "每个都是t0级别的华丽"}
{"time": 1753189828, "type": "recv", "message_id": "110461647", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(正常，就该加戏)"}
{"time": 1753189906, "type": "recv", "message_id": "1290202717", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我果然还是适合黑紫色的衣服，挑一套哥特式的裙子。\"挂在身上，\"说起来，这些衣服我一次都没穿过，是不是太随便了。\""}
{"time": 1753189980, "type": "recv", "message_id": "893685356", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“我还以为是你不喜欢穿这种衣服呢”"}
{"time": 1753190146, "type": "recv", "message_id": "667444768", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好看的衣服谁都喜欢啦，不然我也不会那么中意那件袍子。\""}
{"time": 1753190200, "type": "recv", "message_id": "307199992", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"格林，帮我穿一下啦，我不会\""}
{"time": 1753190228, "type": "recv", "message_id": "1009427416", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“你还会做啥……”格林扶额"}
{"time": 1753190315, "type": "recv", "message_id": "1354742288", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没穿过嘛。\"楚楚可怜地看着她"}
{"time": 1753190447, "type": "recv", "message_id": "1132067728", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“穿个衣服有什么难的”格林一边无语一边帮你穿"}
{"time": 1753190629, "type": "recv", "message_id": "1496169133", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "心安理得褪掉自己的外衣，摊开手，\"来吧。\""}
{"time": 1753190706, "type": "recv", "message_id": "1517249093", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我可是坦诚相见了。\"点点头"}
{"time": 1753190711, "type": "recv", "message_id": "940774823", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "穿好了"}
{"time": 1753190781, "type": "recv", "message_id": "675190868", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "转个身看看，\"怎么样?\""}
