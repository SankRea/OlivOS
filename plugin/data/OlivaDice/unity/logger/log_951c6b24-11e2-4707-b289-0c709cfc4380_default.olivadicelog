{"time": 1752484371, "type": "recv", "message_id": "1584589993", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "按着最后一眼看见格林的方向你追了上去，可你终究没有走上和她一样的路"}
{"time": 1752484377, "type": "recv", "message_id": "317231492", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（没有大失败真是可惜了）"}
