{"time": 1752510601, "type": "recv", "message_id": "1706830298", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（但是这种情况也正常吧，因为我要先起身）"}
{"time": 1752510656, "type": "recv", "message_id": "1433227941", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（这种情况下起身不是等着捅吗）"}
{"time": 1752510684, "type": "recv", "message_id": "1286822099", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（你说滚一下护在身下还差不多）"}
{"time": 1752510706, "type": "recv", "message_id": "339460193", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（感觉直接起身就是什么都保护不了.jpg）"}
{"time": 1752510743, "type": "recv", "message_id": "611678423", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "那就滚一圈护在身下"}
{"time": 1752510944, "type": "recv", "message_id": "353510186", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“剑神的弟子吗……”长剑被阻拦住，女子流露出一丝惊讶"}
{"time": 1752511056, "type": "recv", "message_id": "596103126", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“...啊？”"}
{"time": 1752511057, "type": "recv", "message_id": "106590649", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“还请前辈手下留情，我们师徒二人并不想冒犯！”格林在你身下喊道"}
{"time": 1752511129, "type": "recv", "message_id": "1280880144", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“...”"}
{"time": 1752511151, "type": "recv", "message_id": "1653659398", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "长剑悬停在你们头上“你说她是你师傅？”"}
{"time": 1752511209, "type": "recv", "message_id": "551866092", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我是。”看向她"}
{"time": 1752511273, "type": "recv", "message_id": "90145789", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "格林点头"}
{"time": 1752511334, "type": "recv", "message_id": "1426180116", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“你应该是师从剑神奥尔芬，或者他的弟子”冷漠的声音传来"}
{"time": 1752511429, "type": "recv", "message_id": "301179181", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“...”一时之间居然不知道该说什么，缓了一下，“格林是我收的弟子...”咬着嘴唇，“不是你说的谁”"}
{"time": 1752511697, "type": "recv", "message_id": "632498261", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“吉诺，剑神弟子吉诺是我的剑术老师，这位是我魔法的师傅”"}
{"time": 1752511881, "type": "recv", "message_id": "1909398675", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“哦，原来是这样……”"}
{"time": 1752511902, "type": "recv", "message_id": "965739485", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“既然的确是剑神一脉……”"}
{"time": 1752511914, "type": "recv", "message_id": "1908324399", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“...这种事...一直瞒着我？”"}
{"time": 1752512020, "type": "recv", "message_id": "355536910", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“那你们就有充分的理由离开这个世界了”玄黑长剑斩下"}
