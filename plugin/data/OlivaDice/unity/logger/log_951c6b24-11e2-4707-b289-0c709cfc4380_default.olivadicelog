{"time": 1753191888, "type": "recv", "message_id": "2072373468", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“唉，看来今天的训练是真泡汤了”"}
{"time": 1753192014, "type": "recv", "message_id": "529226165", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哼哼，毕竟今天要陪阿桃，怎么了？好多天都不陪着阿桃了。\""}
{"time": 1753192087, "type": "recv", "message_id": "241207884", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（？）"}
{"time": 1753192091, "type": "recv", "message_id": "261303683", "deleted": false, "dect": {"host_id": null, "group_id": "902737966", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（训练啊）"}
