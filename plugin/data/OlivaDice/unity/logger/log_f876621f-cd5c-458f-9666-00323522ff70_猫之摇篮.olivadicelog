{"time": 1770190486, "type": "recv", "message_id": "917855699", "deleted": false, "dect": {"host_id": null, "group_id": "938830904", "user_id": "3222503301"}, "sender": {"id": "3222503301", "name": "劇場愛歌"}, "message": "（笑死了）"}
