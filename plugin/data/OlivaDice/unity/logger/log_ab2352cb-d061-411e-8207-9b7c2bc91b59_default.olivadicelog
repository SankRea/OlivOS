{"time": 1770873609, "type": "recv", "message_id": "414269786", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(其实可以快进到第二天)"}
{"time": 1770873630, "type": "recv", "message_id": "1736327996", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"咦～\"她摇摇头，没再管你。"}
{"time": 1770873644, "type": "recv", "message_id": "1456131993", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(理论上你会做一个)"}
