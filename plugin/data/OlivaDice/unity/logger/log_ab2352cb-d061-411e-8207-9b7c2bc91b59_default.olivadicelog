{"time": 1771899893, "type": "recv", "message_id": "339728561", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*模模糊糊睁开眼睛"}
