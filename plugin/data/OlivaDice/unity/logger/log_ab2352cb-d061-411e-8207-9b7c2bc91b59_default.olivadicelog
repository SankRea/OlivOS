{"time": 1770730596, "type": "recv", "message_id": "1380476210", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“是，折原班长。”她淡漠地点点头，“有什么事吗？”"}
{"time": 1770730696, "type": "recv", "message_id": "1471156705", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“没事，要一起跑步吗？锻炼身体”"}
{"time": 1770730709, "type": "recv", "message_id": "484576137", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*抹了抹汗水"}
{"time": 1770730721, "type": "recv", "message_id": "932297065", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“不好意思”"}
{"time": 1770730726, "type": "recv", "message_id": "837458595", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*站远点"}
{"time": 1770730734, "type": "recv", "message_id": "111947544", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“刚训练完”"}
{"time": 1770730749, "type": "recv", "message_id": "191377250", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“抱歉。”她扭头看了下你，又转回去，“我不太习惯和别人一起，毕竟，谁也不知道什么时候会是下一个，对吗？班长。”"}
{"time": 1770730790, "type": "recv", "message_id": "1171082271", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“没有开始呢，或许今年可以安全渡过”"}
{"time": 1770730797, "type": "recv", "message_id": "80038788", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“乐观点心态好一点”"}
