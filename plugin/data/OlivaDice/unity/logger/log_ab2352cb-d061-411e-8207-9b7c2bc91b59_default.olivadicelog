{"time": 1772440088, "type": "recv", "message_id": "2115246683", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*有声响吗"}
{"time": 1772440176, "type": "recv", "message_id": "147746565", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "没有传来重物落地的声音。"}
{"time": 1772440191, "type": "recv", "message_id": "410385058", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*擦了擦眼睛，可能是错觉？"}
{"time": 1772440199, "type": "recv", "message_id": "1053814567", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*去找警察说明情况"}
{"time": 1772440203, "type": "recv", "message_id": "369978636", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*详细描述"}
{"time": 1772440450, "type": "recv", "message_id": "503462354", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "警察简单问询了你一下，言语间显得有些避讳，\"好的，我们知道了...尸体会处理的。\""}
{"time": 1772440478, "type": "recv", "message_id": "1905958578", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“如果可以，能够在得知死因后告知我们吗？”"}
{"time": 1772440652, "type": "recv", "message_id": "1747503317", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯。\"他还要开口"}
{"time": 1772440661, "type": "recv", "message_id": "2085802154", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "你的电话响了"}
{"time": 1772440673, "type": "recv", "message_id": "444655197", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“稍等，我有个电话”"}
{"time": 1772440676, "type": "recv", "message_id": "481122195", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*接通"}
{"time": 1772440681, "type": "recv", "message_id": "1505779138", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“喂，是哪位？”"}
{"time": 1772440991, "type": "recv", "message_id": "2044656972", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "神山露"}
{"time": 1772441007, "type": "recv", "message_id": "1618001532", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“有什么事情吗？”"}
{"time": 1772441028, "type": "recv", "message_id": "414800466", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“是我啦班长，神山露”"}
{"time": 1772441073, "type": "recv", "message_id": "386420609", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我生病了...现在在医院”"}
{"time": 1772441107, "type": "recv", "message_id": "1408962094", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我看到消息了，雨纪等人都赶去你家了，我已经发消息让他们回来了”"}
{"time": 1772441123, "type": "recv", "message_id": "646116810", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“学校出事了，你今天早上到底做了什么”"}
{"time": 1772441549, "type": "recv", "message_id": "385650068", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我早上没做什么啊....”"}
{"time": 1772441559, "type": "recv", "message_id": "480995852", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“但我早上遇到那家伙了”"}
{"time": 1772441564, "type": "recv", "message_id": "639522531", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“然后？”"}
{"time": 1772441887, "type": "recv", "message_id": "588941507", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“她很反常...来找我搭话..我没理她，但我妈妈不知道，和她聊了几句...”"}
{"time": 1772441894, "type": "recv", "message_id": "1310523614", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我当时太难受了...没阻止成功”"}
{"time": 1772441900, "type": "recv", "message_id": "1385935763", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“想打电话告诉你们...没人接”"}
{"time": 1772441904, "type": "recv", "message_id": "622638456", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“诅咒开始了”"}
{"time": 1772441905, "type": "recv", "message_id": "1141496638", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“学校发生了什么吗”"}
{"time": 1772441911, "type": "recv", "message_id": "1308497898", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“神山同学，诅咒开始了”"}
{"time": 1772441930, "type": "recv", "message_id": "984001102", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“小林老师已经死在了办公室了”"}
{"time": 1772442099, "type": "recv", "message_id": "330999449", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“怎么会...”那头传来瘫坐的声音"}
{"time": 1772442122, "type": "recv", "message_id": "1522315409", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我们需要重新商量一下怎么阻止诅咒了”"}
{"time": 1772442132, "type": "recv", "message_id": "1571775754", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“最起码，不能让诅咒再继续蔓延了”"}
{"time": 1772442213, "type": "recv", "message_id": "1928643903", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我们等下去医院找你，你稍等一会吧”"}
{"time": 1772442423, "type": "recv", "message_id": "1540677007", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“？怎么...怎么会这样...都是...都是我的错...”"}
{"time": 1772442451, "type": "recv", "message_id": "1196770577", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“不要过于自责了，一切已经开始了，怎么阻止才是现在应该思考的事情”"}
{"time": 1772442520, "type": "recv", "message_id": "1578511847", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“嗯...嗯...”"}
{"time": 1772442640, "type": "recv", "message_id": "1210575748", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“谢...谢班长...”你听到女孩流泪的呜咽声"}
{"time": 1772442657, "type": "recv", "message_id": "539828946", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我也会赶过去的”"}
