{"time": 1770867698, "type": "reply", "message_id": "303893219", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[沃斯·伊升]进行技能[幸运:50]检定: 1D100=44/50 成功，春风得意马蹄急，一日看尽长安花"}
{"time": 1770867804, "type": "recv", "message_id": "2048281518", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "出老街的时候你远远看见神山露从学校的方向走过来，不过她似乎没看见你"}
{"time": 1770867832, "type": "recv", "message_id": "1379883414", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(决定一下行动)"}
{"time": 1770867843, "type": "recv", "message_id": "2014703964", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*过去找她"}
