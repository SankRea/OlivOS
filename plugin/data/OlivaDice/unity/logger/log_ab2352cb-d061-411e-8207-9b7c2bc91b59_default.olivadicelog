{"time": 1772437902, "type": "recv", "message_id": "515015521", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(你有给神山露打过电话吗)"}
