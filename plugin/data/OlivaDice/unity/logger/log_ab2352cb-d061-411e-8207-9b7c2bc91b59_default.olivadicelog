{"time": 1770731238, "type": "recv", "message_id": "2035888060", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我知道，只是真的很难做到这样”"}
{"time": 1770731251, "type": "recv", "message_id": "96107736", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“而且对....也很....”"}
{"time": 1770731257, "type": "recv", "message_id": "2027132101", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“当我没说过吧”"}
{"time": 1770731294, "type": "recv", "message_id": "2095967853", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "阳菜回头看了你一眼，也没继续开口，开始下一轮锻炼起来。"}
