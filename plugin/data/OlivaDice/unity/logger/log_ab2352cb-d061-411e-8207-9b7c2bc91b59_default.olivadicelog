{"time": 1770802025, "type": "recv", "message_id": "1147207627", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "也许是太过集中于自己的路，又或是其他什么原因，你在校门口直直地撞到了一个跑进来的男生，你和他一起摔倒，但很明显对方摔得厉害一些"}
{"time": 1770802048, "type": "recv", "message_id": "1051785010", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“抱歉抱歉”"}
{"time": 1770802058, "type": "recv", "message_id": "1519608037", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*连忙起身扶起他"}
{"time": 1770802252, "type": "recv", "message_id": "781482097", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶你这家伙，走路不看路吗？\"对面看上去有些恼火，甩开了你，自己站了起来，\"嘶...!\"他的腿上有一大块擦伤"}
{"time": 1770802280, "type": "recv", "message_id": "1033988093", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“对不起，我送你去保健室吧”"}
{"time": 1770802290, "type": "recv", "message_id": "1798663084", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*看看是谁 我认识吗"}
{"time": 1770802324, "type": "recv", "message_id": "680792929", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(理论上不认识)"}
{"time": 1770802495, "type": "recv", "message_id": "1072016970", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"别烦我。和你这种斯文的家伙没什么好说的。\"他甩开你的手，\"挡在我面前烦死了。\""}
{"time": 1770802531, "type": "recv", "message_id": "963172962", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你现在受伤很严重的，小心感染，让我送你去保健室吧”"}
{"time": 1770802534, "type": "recv", "message_id": "824146272", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“对不起”"}
{"time": 1770802588, "type": "recv", "message_id": "1791263239", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"都说了，我有事，不要你管。\"他的嗓门渐渐大了起来"}
{"time": 1770802637, "type": "recv", "message_id": "992849652", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“有什么事情能比得上自己的健康吗？我们还是去保健室好吗”"}
{"time": 1770803466, "type": "recv", "message_id": "811326637", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"啧，不关你的事。\"他拖着腿甩开你，一瘸一拐地往教学楼走。"}
{"time": 1770803479, "type": "recv", "message_id": "111905673", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*跟在他后面"}
{"time": 1770803485, "type": "recv", "message_id": "1060784896", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“同学，同学”"}
{"time": 1770803508, "type": "recv", "message_id": "1071866233", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“最起码让我帮你把事情做完吧，然后我们去保健室，你看这样好吗”"}
{"time": 1770803591, "type": "recv", "message_id": "488139717", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我只是拿东西。\"他似乎有些气笑了，\"而且，我待会要去医院。\""}
{"time": 1770803609, "type": "recv", "message_id": "1373378823", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“没事一起去吧”"}
{"time": 1770803681, "type": "recv", "message_id": "1050573961", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "他懒得理会你，自顾自进了教学楼"}
{"time": 1770803693, "type": "recv", "message_id": "951645494", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*跟过去"}
{"time": 1770804208, "type": "recv", "message_id": "1832670410", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(要等一下)"}
{"time": 1770806271, "type": "recv", "message_id": "1353631552", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "一路有些若有若无的视线打量着你，不过在进教学楼之后就消失了。"}
{"time": 1770806289, "type": "recv", "message_id": "288561472", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "他忍着痛换上室内鞋朝着三年级的教室走过去"}
{"time": 1770806584, "type": "recv", "message_id": "1246341973", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*跟过去"}
{"time": 1770806647, "type": "recv", "message_id": "1488822685", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "他走进三年一班的教室，从自己的桌肚翻翻找找拿出一个暗色的笔记本，回头看了你一眼，露出些厌烦的神色，\"还跟着啊，你到底要干什么。\""}
{"time": 1770806675, "type": "recv", "message_id": "1942176078", "deleted": true, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*几班"}
{"time": 1770806705, "type": "recv", "message_id": "792198093", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“这不是关心你吗”"}
{"time": 1770806717, "type": "recv", "message_id": "1709936715", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你要参加话剧社吗？看你这样”"}
{"time": 1770806938, "type": "recv", "message_id": "30667948", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呵，我才不参与小孩子过家家。这是我的机密文件。\"他炫耀地挥了挥手里的东西，\"算了，跟你讲你也不懂，让开。我走了。\""}
{"time": 1770807086, "type": "recv", "message_id": "2143328489", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*让开路"}
{"time": 1770807096, "type": "recv", "message_id": "606251095", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“记得去医院”"}
{"time": 1770807109, "type": "recv", "message_id": "1349152613", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(上手抢也太不好了)"}
{"time": 1770807158, "type": "recv", "message_id": "13198251", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(申请话术吧)"}
{"time": 1770807164, "type": "recv", "message_id": "764047923", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(看看能不能让他和我说)"}
{"time": 1770807182, "type": "recv", "message_id": "1885920267", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“不一定，我感觉我好像会懂的”"}
{"time": 1770807187, "type": "recv", "message_id": "310926163", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": ".ra 话术50"}
{"time": 1770807187, "type": "reply", "message_id": "310926163", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[沃斯·伊升]进行技能[话术:50]检定: 1D100=67/50 失败，人面不知何处去，桃花依旧笑春风"}
{"time": 1770807223, "type": "recv", "message_id": "1023481397", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(那看来不太像是会懂的)"}
{"time": 1770807253, "type": "recv", "message_id": "1856428374", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(没招)"}
{"time": 1770807356, "type": "recv", "message_id": "1408604952", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呵，你懂什么?这可是，灵异，灵异，只有我理解一切。\""}
{"time": 1770807370, "type": "recv", "message_id": "1306301393", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“...”"}
{"time": 1770807401, "type": "recv", "message_id": "1186280149", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你最好对那些东西保持慎重，传说并不会只是传说的”"}
{"time": 1770807788, "type": "recv", "message_id": "646878241", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"何以见得?\"他皱皱眉，看上去有了些兴趣，坐了下来"}
{"time": 1770807829, "type": "recv", "message_id": "610960867", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你也是本地人，三年三班的传说你总听说过吧”"}
{"time": 1770808382, "type": "recv", "message_id": "1465247885", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"是，略有耳闻，你们不会真的信了吧？\"他嗤笑了一声"}
{"time": 1770808635, "type": "recv", "message_id": "322401095", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你不信？”"}
{"time": 1770808645, "type": "recv", "message_id": "1587864355", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“还是说你知道怎么解决？”"}
{"time": 1770809074, "type": "recv", "message_id": "2109852343", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"解决?谁知道不会发生的事情该怎么解决?\""}
{"time": 1770809113, "type": "recv", "message_id": "1721856935", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“那你的灵异又是什么呢？”"}
{"time": 1770809171, "type": "recv", "message_id": "1996373614", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“灵异本就是不该发生的事情发生了不是吗”"}
{"time": 1770809768, "type": "recv", "message_id": "1409194293", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我的灵异?哼哼，我当然是在调查七大不可思议，就我所知，不过全部都是人为编造。\""}
{"time": 1770809849, "type": "recv", "message_id": "1622738013", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“七大不可思议？”"}
{"time": 1770809854, "type": "recv", "message_id": "1558318054", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*我能知道什么吗"}
{"time": 1770809858, "type": "recv", "message_id": "609929854", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*回忆"}
{"time": 1770810784, "type": "recv", "message_id": "1163481958", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "似乎是镇上很有名的几个传闻，90年代的时候盛行"}
{"time": 1770810924, "type": "recv", "message_id": "1221027075", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我明白了，你接下来要去医院探索其中之一”"}
{"time": 1770811004, "type": "recv", "message_id": "1840750146", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "他没接话，只是似笑非笑地看着你"}
{"time": 1770811027, "type": "recv", "message_id": "1243142489", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“一个人去不太好吧”"}
{"time": 1770811050, "type": "recv", "message_id": "1739865498", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我的意思是，我也想看看所谓的七大不可思议究竟是什么”"}
{"time": 1770811226, "type": "recv", "message_id": "686747240", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呵呵，我先说好，如果你相信的话，你会下场很惨哦?\""}
{"time": 1770811272, "type": "recv", "message_id": "765296261", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“下场还能惨到哪去呢，探索未知才是人类的使命不是吗”"}
{"time": 1770811756, "type": "recv", "message_id": "776748124", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我已经警告过你了。\"他若有所思，虽然站起来的时候倒吸了一口冷气，\"走?\""}
{"time": 1770811805, "type": "recv", "message_id": "1851290374", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“那我还能说什么呢，但是你等等，我还有些创口贴，我给你拿来先应急吧”"}
{"time": 1770811812, "type": "recv", "message_id": "852766382", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*给他创口贴"}
{"time": 1770812111, "type": "recv", "message_id": "644157549", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "他接过但是完全没用，放进口袋，\"医院这种地方，其实很难发生什么有趣的事情吧？所谓灵异，都是道听途说的艺术加工。\"一边说他一边往前走"}
{"time": 1770812136, "type": "recv", "message_id": "1572935528", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“不好说，天平间的鬼故事也不在少数”"}
{"time": 1770812380, "type": "recv", "message_id": "89330294", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"最后的原因无非是什么医生技术不精，或者是被撞明的行骗罢了。\"他不以为意，走在黄昏时的路上，早秋的风竟有些萧瑟，有些生冷。"}
{"time": 1770812419, "type": "recv", "message_id": "881553205", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“毕竟大家都抱着宁可信其有不可信其无的观念吗”"}
{"time": 1770812795, "type": "recv", "message_id": "1516422780", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"大部分人是不信的吧？\"他咧了咧嘴，\"你们选中的人是谁?\""}
{"time": 1770812810, "type": "recv", "message_id": "1948070101", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*摇头"}
{"time": 1770812820, "type": "recv", "message_id": "78326339", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我们不应该讨论这个”"}
{"time": 1770812830, "type": "recv", "message_id": "315525611", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“还是聚焦到医院吧”"}
{"time": 1770812844, "type": "recv", "message_id": "202793694", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"果然你还是在怕的吧？\"他的表情玩味"}
{"time": 1770812864, "type": "recv", "message_id": "1404612285", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我怕你出事”"}
{"time": 1770812890, "type": "recv", "message_id": "1854715638", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“这种多年的所谓的诅咒，尽管可能是虚假的，但仍然有些敬重比较好”"}
{"time": 1770815610, "type": "recv", "message_id": "1067927744", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哦，我知道了。\"说着你们到了医院的门口，这是个五层高的建筑，门口写着神弃川市立医院。"}
{"time": 1770816913, "type": "recv", "message_id": "94372786", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:at,qq=1370316409]"}
{"time": 1770844410, "type": "recv", "message_id": "451626626", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(醒了，有无)"}
{"time": 1770849883, "type": "recv", "message_id": "2348661", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（五点问）"}
{"time": 1770849886, "type": "recv", "message_id": "569649644", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（你是人）"}
{"time": 1770850007, "type": "recv", "message_id": "1558931674", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(咋了)"}
{"time": 1770850025, "type": "recv", "message_id": "2146121596", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我代天巡猎)"}
{"time": 1770860512, "type": "recv", "message_id": "34330689", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "我睡着了"}
{"time": 1770860642, "type": "recv", "message_id": "694606559", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我知道)"}
{"time": 1770862036, "type": "recv", "message_id": "1968123359", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（then？）"}
{"time": 1770862052, "type": "recv", "message_id": "1777330647", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "（你要跑团还是什么）"}
{"time": 1770862105, "type": "recv", "message_id": "604777343", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（都行吧，也可以补进度，也能上号）"}
{"time": 1770862128, "type": "recv", "message_id": "606022135", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "（看你）"}
{"time": 1770862138, "type": "recv", "message_id": "1467903276", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（还有人吗）"}
{"time": 1770862182, "type": "recv", "message_id": "372525848", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "（你得问龙神）"}
{"time": 1770862409, "type": "recv", "message_id": "193467480", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（那补进度吧）"}
{"time": 1770862475, "type": "recv", "message_id": "436079105", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“市立医院，不怕人多眼杂吗”"}
{"time": 1770862716, "type": "recv", "message_id": "1852825093", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“为什么这么说?”他走去前台挂号"}
{"time": 1770862952, "type": "recv", "message_id": "1444273842", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我还是不明白”"}
{"time": 1770862956, "type": "recv", "message_id": "702030824", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*跟着过去"}
{"time": 1770862971, "type": "recv", "message_id": "1524132345", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我们接下来去哪，不能真是太平间吧”"}
{"time": 1770863153, "type": "recv", "message_id": "672793883", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“那我问你，一本正经的烂好人。”他坐下，颇有些洋洋自得，“世界的少女要去哪里寻找天空的少女？”"}
{"time": 1770863434, "type": "recv", "message_id": "2025296533", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“哑谜？”"}
{"time": 1770863444, "type": "recv", "message_id": "642851226", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“科学的来说”"}
{"time": 1770863447, "type": "recv", "message_id": "1747587112", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“应该是坐飞机”"}
{"time": 1770863454, "type": "recv", "message_id": "2105335770", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“航天火箭也是可能的”"}
{"time": 1770863656, "type": "recv", "message_id": "569894053", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“真是无趣的答案，就和你一样一本正经。”他摇摇头，“当然是，天台。”"}
{"time": 1770863670, "type": "recv", "message_id": "894516129", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“...”"}
{"time": 1770863682, "type": "recv", "message_id": "364983056", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“感觉天台和天空也就一个字沾边”"}
{"time": 1770863687, "type": "recv", "message_id": "824769323", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“坠落的瞬间，血花飞溅的瞬间，天空重回世界之中，这是常识啊，我的朋友。”"}
{"time": 1770863703, "type": "recv", "message_id": "1521968051", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“那**叫自杀”"}
{"time": 1770863811, "type": "recv", "message_id": "429829761", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“本身就是这么一件事吧。”他无所谓的样子，“某人在天台扔下一个布娃娃，总会有人捡起来的。”"}
{"time": 1770863848, "type": "recv", "message_id": "1052517614", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“所以，这一次的不可思议的传言完整版是什么呢”"}
{"time": 1770864102, "type": "recv", "message_id": "2131832490", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“你知道吗？”他的话题转得很快，“老街里的一家钟表店，每到十点十三分，所有的钟都会一起停下来哦？”"}
{"time": 1770864130, "type": "recv", "message_id": "959655614", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“1013？这个时间有什么特殊意味吗”"}
{"time": 1770864615, "type": "recv", "message_id": "1185696925", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“谁知道呢？”他耸耸肩，“就连这个消息，也只能说是道听途说来的吧。”"}
{"time": 1770864623, "type": "recv", "message_id": "1442053791", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“怎么，你要去验证？”"}
{"time": 1770864636, "type": "recv", "message_id": "1905095214", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“贪多嚼不烂，先看看医院的吧”"}
{"time": 1770864722, "type": "recv", "message_id": "1024491630", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“医院的故事可就多了，何必问我?”"}
{"time": 1770864754, "type": "recv", "message_id": "362154021", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“别绕来绕去了，你现在打算先看病？那倒是算好事”"}
{"time": 1770865262, "type": "recv", "message_id": "640572010", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“差不多吧，你能理解就好，当然不用陪着我。既然你还有想去的地方？回归世界，怎么样？”"}
{"time": 1770865335, "type": "recv", "message_id": "764077534", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“都到这里了，不见识一下七大不可思议之一就没意思了”"}
{"time": 1770865343, "type": "recv", "message_id": "1793118853", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“半途而废不是什么好品质”"}
{"time": 1770865423, "type": "recv", "message_id": "1109338994", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“祝你顺利。”他耸耸肩。"}
{"time": 1770865434, "type": "recv", "message_id": "1052889028", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“不带我见识一下？”"}
{"time": 1770865455, "type": "recv", "message_id": "1715964578", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“如果你告诉我不可思议只是一个哑谜那可太...”"}
{"time": 1770865579, "type": "recv", "message_id": "572843062", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我没兴趣，据我所知，那家钟表店只是一家正常营业的店铺，就算你想去查什么，也什么也查不到。传说就是这种东西，迷信更是如此。”"}
{"time": 1770865611, "type": "recv", "message_id": "977072527", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“迷信确实是这样”"}
{"time": 1770865622, "type": "recv", "message_id": "1987391613", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“不过聊了这么久我还不知道你叫什么呢”"}
{"time": 1770865627, "type": "recv", "message_id": "388437050", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我是折原临也”"}
{"time": 1770865634, "type": "recv", "message_id": "275646009", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*伸手"}
{"time": 1770866098, "type": "recv", "message_id": "706553639", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我、本大爷姓佐藤，名巴，好好记住吧。”他撇了撇嘴"}
{"time": 1770866118, "type": "recv", "message_id": "2128394058", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(没招了)"}
{"time": 1770866122, "type": "recv", "message_id": "1553196689", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(纯纯小鬼)"}
{"time": 1770866208, "type": "recv", "message_id": "905918294", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（之后呢）"}
{"time": 1770866241, "type": "recv", "message_id": "1546624721", "deleted": true, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*在地图软件上搜索一下附近的钟表店"}
{"time": 1770866246, "type": "recv", "message_id": "1095977570", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(科技改变生活)"}
{"time": 1770866252, "type": "recv", "message_id": "514358198", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（03年）"}
{"time": 1770866257, "type": "recv", "message_id": "123999181", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(那没事了)"}
{"time": 1770866259, "type": "recv", "message_id": "86501985", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（你哪来的智能手机和app）"}
{"time": 1770866277, "type": "recv", "message_id": "522095209", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*我能记起附近的钟表店吗"}
{"time": 1770866309, "type": "recv", "message_id": "1488347311", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "提起老街的钟表店，在深巷里倒是有且仅有一家。"}
{"time": 1770866327, "type": "recv", "message_id": "1392006438", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "似乎是叫天宫记钟表的样子"}
{"time": 1770866349, "type": "recv", "message_id": "2060655301", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“佐藤同学，要是我后续拿到什么有意思的情报，或许可以和你共享，留个联系方式怎么样”"}
{"time": 1770866361, "type": "recv", "message_id": "502360209", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“搞不好我真能找到点迷信的东西”"}
{"time": 1770866405, "type": "recv", "message_id": "153633956", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“随你吧。”他报上了自己的号码，“发短信，别打电话。”"}
{"time": 1770866450, "type": "recv", "message_id": "1699548673", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“好的”"}
{"time": 1770866455, "type": "recv", "message_id": "176770299", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(进度赶上了吗)"}
{"time": 1770866459, "type": "recv", "message_id": "651645911", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(没赶上就继续)"}
{"time": 1770866468, "type": "recv", "message_id": "1032252712", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(haimei"}
{"time": 1770866493, "type": "recv", "message_id": "1790396802", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你接下来就在医院了？那我去钟表店看看了”"}
{"time": 1770866552, "type": "recv", "message_id": "606909496", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“差不多吧，不过待会就准备回家了。”"}
{"time": 1770866564, "type": "recv", "message_id": "1789995951", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“再见”"}
{"time": 1770866573, "type": "recv", "message_id": "523950188", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*准备去一趟钟表店"}
{"time": 1770866596, "type": "recv", "message_id": "1623073246", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（对了）"}
{"time": 1770866612, "type": "recv", "message_id": "1277003944", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(镇子南边是码头，北边是矿山，有穿山隧道，西边是墓地，学校在正中央，旁边就是老街。选一下你家在什么方位吧。)"}
{"time": 1770866627, "type": "recv", "message_id": "1936057355", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(码头)"}
{"time": 1770866641, "type": "recv", "message_id": "1951000530", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(因为码头牛逼)"}
{"time": 1770866661, "type": "recv", "message_id": "239973421", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（好的）"}
{"time": 1770866677, "type": "recv", "message_id": "737651076", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "神弃川的老街不长，路面是被雨水泡得发暗的旧石板，缝隙里长着深绿色的苔藓，踩上去微凉、微滑。两旁的房子大多是几层的木造，深褐色的木板墙被岁月熏得发黑，窗框歪歪扭扭，玻璃蒙着一层永远擦不掉的白雾。"}
{"time": 1770866682, "type": "recv", "message_id": "720376454", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "虽然毗邻高中，但本就不算繁华，空气里飘着潮湿木头味、旧纸张味，还有一丝若有若无的、像墨水混着雨水的冷香。想来也不会有特别好的饭店，不过拉面这种碳水供应倒是生根发芽，也许得益于港口城市的原因。"}
{"time": 1770866705, "type": "recv", "message_id": "717430737", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*按照记忆里的样子去找那个钟表店"}
{"time": 1770866710, "type": "recv", "message_id": "675031253", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(现在几点)"}
{"time": 1770866716, "type": "recv", "message_id": "328903920", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（已经过了七点）"}
{"time": 1770866719, "type": "recv", "message_id": "1191379536", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(周几)"}
{"time": 1770866747, "type": "recv", "message_id": "1155182070", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（三吧）"}
{"time": 1770866781, "type": "recv", "message_id": "1812633370", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(待到晚上十点也太傻逼了)"}
{"time": 1770866807, "type": "recv", "message_id": "1409541657", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*先去店里看看"}
{"time": 1770866815, "type": "recv", "message_id": "454984630", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "老街中段的光影比别处更暗，像是被一块无形的灰布蒙住，连风都在这里放轻了脚步，只剩下潮湿的木头味，混着旧金属的冷意，缠在鼻尖挥之不去。石板路到这里变得格外光滑，苔藓长得更密，深绿中透着一丝灰黑，踩上去偶尔会发出细微的“吱呀”声，像是脚下的石板在低语。​\n钟表店就嵌在两栋老旧木楼之间，不算起眼，门牌上写着天宫记，此刻店铺的木门紧闭，橱窗是老式的木框玻璃，里面很暗。"}
{"time": 1770866834, "type": "recv", "message_id": "2136304394", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“莫西莫西？”"}
{"time": 1770866838, "type": "recv", "message_id": "2052926841", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“有人在吗”"}
{"time": 1770866917, "type": "recv", "message_id": "1744961295", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "过了一会才有人回应，一个穿着校服的女生从里面推开门，“怎么了？”"}
{"time": 1770866929, "type": "recv", "message_id": "615310642", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:image,file={306497F4-AB34-5499-2F52-2AD8BB8A380B}.jpg,sub_type=0,url=https://gchat.qpic.cn/gchatpic_new/0/0-0-306497F4AB3454992F522AD8BB8A380B/0,file_size=137238]（样貌）"}
{"time": 1770866935, "type": "recv", "message_id": "1791284365", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(...)"}
{"time": 1770866956, "type": "recv", "message_id": "2063859800", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(话说我那个高中是叫什么名字)"}
{"time": 1770866998, "type": "recv", "message_id": "762273311", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（神弃川县立高中）"}
{"time": 1770867024, "type": "recv", "message_id": "146729489", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你也是县立高中的学生吗？”"}
{"time": 1770867049, "type": "recv", "message_id": "669755930", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我先打算买个手表送给朋友当做生日礼物，想看看这里有没有”"}
{"time": 1770867053, "type": "recv", "message_id": "1257930860", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“怀表也可以”"}
{"time": 1770867089, "type": "recv", "message_id": "1368334468", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "她看了看你，“呃，嗯。”点了点脑袋，“但是今天不开门了哦...同学。”语气有些弱弱地"}
{"time": 1770867117, "type": "recv", "message_id": "2049753259", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“不开门吗？为什么？”"}
{"time": 1770867127, "type": "recv", "message_id": "590381323", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“啊，抱歉，那我擅自闯进来是不是不太好”"}
{"time": 1770867138, "type": "recv", "message_id": "416019138", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我们家七点以后就关门了...这是规矩...”"}
{"time": 1770867180, "type": "recv", "message_id": "297313073", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“能通融一下吗？我只想看看手表之类的”"}
{"time": 1770867218, "type": "recv", "message_id": "1185632487", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "她缓慢但是坚定地摇了摇头，“明天再来吧。”"}
{"time": 1770867256, "type": "recv", "message_id": "13924096", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“好吧...”"}
{"time": 1770867296, "type": "recv", "message_id": "1117917447", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“那我明天再来，我叫折原临也，很高兴认识你”"}
{"time": 1770867347, "type": "recv", "message_id": "138465916", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...我叫天宫秋...再见...\"她合上了门店的木门。"}
{"time": 1770867356, "type": "recv", "message_id": "529429792", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(没活)"}
{"time": 1770867376, "type": "recv", "message_id": "177577817", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*那没活了，回家吧"}
{"time": 1770867689, "type": "recv", "message_id": "1030056062", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "过幸运"}
