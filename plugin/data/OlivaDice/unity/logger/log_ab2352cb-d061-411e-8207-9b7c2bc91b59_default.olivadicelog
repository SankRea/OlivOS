{"time": 1770871102, "type": "recv", "message_id": "1011911071", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "等你回到渔港附近，天色已经完全黑了下来，最后一批出港的渔民已经离去。"}
{"time": 1770871110, "type": "recv", "message_id": "1917464584", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(家里有没有亲人之类的?)"}
{"time": 1770871134, "type": "recv", "message_id": "96139266", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(来点姐妹)"}
{"time": 1770871145, "type": "recv", "message_id": "658849395", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(有妹有房，父母双忙)"}
{"time": 1770871372, "type": "recv", "message_id": "436841180", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"欢迎回来——\"推开门，折原杏，你的妹妹对着你很有元气，手掌对着你的方向抬到脑袋旁欢迎道，\"怎么这么晚?\"紧接着一句抱怨"}
{"time": 1770871406, "type": "recv", "message_id": "1682263674", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“社团活动之后去老街那边逛了逛，可惜店铺基本都关门了”"}
{"time": 1770871463, "type": "recv", "message_id": "753426779", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"老街?去那边干嘛啦。\""}
{"time": 1770871623, "type": "recv", "message_id": "540573940", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“惊喜，给惊喜保留一点神秘感好吗”"}
{"time": 1770871820, "type": "recv", "message_id": "160879420", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好吧，不过这也太晚了，老哥下次能不能发个短信啦。\"杏略微嘟着嘴，看上去有些埋怨"}
{"time": 1770871889, "type": "recv", "message_id": "591316914", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“下次注意下次注意”"}
{"time": 1770871896, "type": "recv", "message_id": "2059779027", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*捂手求饶"}
{"time": 1770872132, "type": "recv", "message_id": "113670019", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好啦。\"她拍拍手，\"老哥还有事吧？我也做自己的事去了。\""}
{"time": 1770872146, "type": "recv", "message_id": "1857082526", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“倒是没有，你晚饭吃了吗”"}
{"time": 1770872279, "type": "recv", "message_id": "497683138", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"当然吃过了，这都几点了。\"杏有些孺子不可教地摇摇头，\"老哥肯定没吃，给你留了。\""}
{"time": 1770873570, "type": "recv", "message_id": "153350537", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“还是我的一抹多最可爱了”"}
{"time": 1770873573, "type": "recv", "message_id": "1907856229", "deleted": false, "dect": {"host_id": null, "group_id": "589351221", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*吃饭饭"}
