{"time": 1763172198, "type": "recv", "message_id": "1382122808", "deleted": false, "dect": {"host_id": null, "group_id": "1058913258", "user_id": "1760933748"}, "sender": {"id": "1760933748", "name": "佩洛洛Sama"}, "message": "你觉得偷书贼就是随便挑的"}
{"time": 1763172346, "type": "recv", "message_id": "703764260", "deleted": false, "dect": {"host_id": null, "group_id": "1058913258", "user_id": "3067019388"}, "sender": {"id": "3067019388", "name": "神秘二刀男"}, "message": "我仔细看了看书架，并没有看出个所以然来。我毫无头绪，决定去日记上提到的旁边的墓地周围去看看。我去找托马斯问他能不能让我进那个墓地"}
{"time": 1763172434, "type": "recv", "message_id": "280608256", "deleted": false, "dect": {"host_id": null, "group_id": "1058913258", "user_id": "1760933748"}, "sender": {"id": "1760933748", "name": "佩洛洛Sama"}, "message": "“哦，你去找守墓人，他就住在墓地边上的一栋小屋里”"}
{"time": 1763172506, "type": "recv", "message_id": "1288683097", "deleted": false, "dect": {"host_id": null, "group_id": "1058913258", "user_id": "3067019388"}, "sender": {"id": "3067019388", "name": "神秘二刀男"}, "message": "那我按着他说的来到守墓人的住处，敲门问他"}
{"time": 1763172554, "type": "recv", "message_id": "2091727816", "deleted": false, "dect": {"host_id": null, "group_id": "1058913258", "user_id": "1760933748"}, "sender": {"id": "1760933748", "name": "佩洛洛Sama"}, "message": "（别急）"}
{"time": 1763172565, "type": "recv", "message_id": "1048784516", "deleted": false, "dect": {"host_id": null, "group_id": "1058913258", "user_id": "3067019388"}, "sender": {"id": "3067019388", "name": "神秘二刀男"}, "message": "（就这样头铁）"}
{"time": 1763172617, "type": "recv", "message_id": "1050973639", "deleted": false, "dect": {"host_id": null, "group_id": "1058913258", "user_id": "3067019388"}, "sender": {"id": "3067019388", "name": "神秘二刀男"}, "message": "（那我去警察局查他叔叔失踪的档案吧）"}
{"time": 1763172633, "type": "recv", "message_id": "1176132139", "deleted": false, "dect": {"host_id": null, "group_id": "1058913258", "user_id": "1760933748"}, "sender": {"id": "1760933748", "name": "佩洛洛Sama"}, "message": "你走过树林间的小路来点墓地边上，可以看到一个老头穿着工作服在修剪植被"}
{"time": 1763172654, "type": "recv", "message_id": "172663211", "deleted": false, "dect": {"host_id": null, "group_id": "1058913258", "user_id": "1760933748"}, "sender": {"id": "1760933748", "name": "佩洛洛Sama"}, "message": "看到你过来他停下手里的活对你打了个招呼"}
{"time": 1763172668, "type": "recv", "message_id": "1505096065", "deleted": false, "dect": {"host_id": null, "group_id": "1058913258", "user_id": "1760933748"}, "sender": {"id": "1760933748", "name": "佩洛洛Sama"}, "message": "“上午好啊，年轻人”"}
{"time": 1763172676, "type": "recv", "message_id": "658271375", "deleted": false, "dect": {"host_id": null, "group_id": "1058913258", "user_id": "3067019388"}, "sender": {"id": "3067019388", "name": "神秘二刀男"}, "message": "（哦原来还是可以去，）"}
{"time": 1763172712, "type": "recv", "message_id": "2010677328", "deleted": false, "dect": {"host_id": null, "group_id": "1058913258", "user_id": "3067019388"}, "sender": {"id": "3067019388", "name": "神秘二刀男"}, "message": "我回答道：“上午好。您是这里的守墓人？”"}
{"time": 1763172758, "type": "recv", "message_id": "1640451605", "deleted": false, "dect": {"host_id": null, "group_id": "1058913258", "user_id": "1760933748"}, "sender": {"id": "1760933748", "name": "佩洛洛Sama"}, "message": "“对，我就是，叫我杰弗逊就好”"}
{"time": 1763172782, "type": "recv", "message_id": "821848876", "deleted": false, "dect": {"host_id": null, "group_id": "1058913258", "user_id": "1760933748"}, "sender": {"id": "1760933748", "name": "佩洛洛Sama"}, "message": "“您是个生面孔啊”"}
{"time": 1763172800, "type": "recv", "message_id": "385797879", "deleted": false, "dect": {"host_id": null, "group_id": "1058913258", "user_id": "1760933748"}, "sender": {"id": "1760933748", "name": "佩洛洛Sama"}, "message": "“请问您到墓地来有什么事情吗”"}
{"time": 1763173024, "type": "recv", "message_id": "1822847293", "deleted": false, "dect": {"host_id": null, "group_id": "1058913258", "user_id": "3067019388"}, "sender": {"id": "3067019388", "name": "神秘二刀男"}, "message": "我向他行一个礼“我是帮隔壁金博尔先生调查失窃案的，有线索表明失窃案和这墓地有关系。我想了解一下这里现在 或者曾经有什么怪事发生吗？”"}
{"time": 1763173263, "type": "recv", "message_id": "1504780436", "deleted": false, "dect": {"host_id": null, "group_id": "1058913258", "user_id": "1760933748"}, "sender": {"id": "1760933748", "name": "佩洛洛Sama"}, "message": "“怪事没有，不过老金博尔我倒是熟的很，他以前经常大晚上一个人坐在墓碑上读书，不过我们不常说话，我问好他也不回答，已经失踪一年了么，唉世事无常啊”"}
{"time": 1763173436, "type": "recv", "message_id": "156317955", "deleted": false, "dect": {"host_id": null, "group_id": "1058913258", "user_id": "3067019388"}, "sender": {"id": "3067019388", "name": "神秘二刀男"}, "message": "我点点头“看来他确是爱书之人。他经常坐着读书的地方是哪里，我可以去看看吗？”"}
{"time": 1763173480, "type": "recv", "message_id": "700533059", "deleted": false, "dect": {"host_id": null, "group_id": "1058913258", "user_id": "1760933748"}, "sender": {"id": "1760933748", "name": "佩洛洛Sama"}, "message": "“就在那块”他手一指“您稍等我去拿钥匙”"}
{"time": 1763173519, "type": "recv", "message_id": "869728784", "deleted": false, "dect": {"host_id": null, "group_id": "1058913258", "user_id": "1760933748"}, "sender": {"id": "1760933748", "name": "佩洛洛Sama"}, "message": "他把门打开后，就继续忙修剪植被了"}
{"time": 1763173545, "type": "recv", "message_id": "1212477255", "deleted": false, "dect": {"host_id": null, "group_id": "1058913258", "user_id": "3067019388"}, "sender": {"id": "3067019388", "name": "神秘二刀男"}, "message": "我去他指的那个地方仔细看看"}
{"time": 1763173558, "type": "recv", "message_id": "1722245680", "deleted": false, "dect": {"host_id": null, "group_id": "1058913258", "user_id": "1760933748"}, "sender": {"id": "1760933748", "name": "佩洛洛Sama"}, "message": "过个侦查吧"}
