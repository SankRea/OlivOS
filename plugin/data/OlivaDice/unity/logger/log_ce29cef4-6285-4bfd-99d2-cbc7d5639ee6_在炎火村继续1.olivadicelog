{"time": 1753767803, "type": "recv", "message_id": "756582615", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": ".rd+1 灵感"}
