{"time": 1753795814, "type": "recv", "message_id": "1584000865", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（肉）"}
{"time": 1753795836, "type": "recv", "message_id": "465408072", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(这个只能想象力了)"}
{"time": 1753795898, "type": "recv", "message_id": "917910186", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"动静真大。\"在外面啧啧称奇，\"露儿什么时候能再打一发龙气炮?有那个的话狩猎会容易好多\""}
{"time": 1753795932, "type": "recv", "message_id": "1542872276", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“emmm，不会啊”"}
