{"time": 1753706418, "type": "recv", "message_id": "1852643601", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"二选一，怎么说?\""}
