{"time": 1753793293, "type": "recv", "message_id": "1160203443", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(吃节肢动物是人类吗)"}
