{"time": 1753981887, "type": "recv", "message_id": "1901294801", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（给你看看稀饭盖饭你就知错了）"}
{"time": 1753981903, "type": "recv", "message_id": "1299925015", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（可惜没有胡辣汤）"}
