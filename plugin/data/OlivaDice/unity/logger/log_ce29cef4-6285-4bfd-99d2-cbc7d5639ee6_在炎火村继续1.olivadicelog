{"time": 1753631818, "type": "recv", "message_id": "100982554", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我在认真思考打消果实到底是该吃还是该捏）"}
