{"time": 1753626880, "type": "recv", "message_id": "1377924299", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我大失败原来没有惩罚啊）"}
{"time": 1753626924, "type": "recv", "message_id": "970032382", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "还在戳夏弥的脸，\"诶?\"完全没有收手的打算，靠到夏弥身上抱住她，头看向声音来源，\"让我看看是什么家伙来了?\""}
