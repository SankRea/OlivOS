{"time": 1753767807, "type": "recv", "message_id": "1548623755", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（呃）"}
{"time": 1753767811, "type": "recv", "message_id": "1934911342", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（没活）"}
{"time": 1753767815, "type": "recv", "message_id": "1401019039", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我都说了，这算是难得的体验嘛。\"歪着脑袋，\"感觉还行啦。\""}
{"time": 1753767823, "type": "recv", "message_id": "1346736211", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你再低一点就有了（）"}
{"time": 1753767824, "type": "recv", "message_id": "1709119980", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（不是说中间没活么）"}
{"time": 1753767831, "type": "recv", "message_id": "1018945063", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（这够低了吧（）"}
{"time": 1753767842, "type": "recv", "message_id": "2046102270", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（举个例子，如果我是17的话）"}
{"time": 1753767848, "type": "recv", "message_id": "1986153295", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（是不是就有活了）"}
{"time": 1753767894, "type": "recv", "message_id": "1636430979", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（17也没）"}
{"time": 1753767911, "type": "recv", "message_id": "1197193034", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（不够极端）"}
{"time": 1753767926, "type": "recv", "message_id": "22176406", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（再碰一下（bushi）"}
{"time": 1753767954, "type": "recv", "message_id": "27118094", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"收回手，看看手心的情况，\"要说烫还是有一点?\""}
{"time": 1753768037, "type": "recv", "message_id": "1078112639", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "感觉脑子好像灵光一闪"}
{"time": 1753768040, "type": "recv", "message_id": "127941227", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "再碰一下"}
{"time": 1753768050, "type": "recv", "message_id": "288772642", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哎呦，好烫”再飞快拿开"}
{"time": 1753768122, "type": "recv", "message_id": "1166051948", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（？）"}
{"time": 1753768206, "type": "recv", "message_id": "2123484604", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（没有就是没有）"}
{"time": 1753768227, "type": "recv", "message_id": "1601009004", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（这是什么，碰一下，失忆岩浆，这是什么，碰一下，失忆岩浆）"}
{"time": 1753768288, "type": "recv", "message_id": "82354126", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(那看看我的手心有没有破皮)"}
{"time": 1753768463, "type": "recv", "message_id": "756873891", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=82354126]（有吧）"}
{"time": 1753768540, "type": "recv", "message_id": "204514427", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶...夏弥明明说可以了，手心都烫破了。\""}
{"time": 1753768556, "type": "recv", "message_id": "1369656409", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=288772642]你感到一种异样的灼热，似乎不来自你的触感，而是来自你的记忆"}
{"time": 1753768613, "type": "recv", "message_id": "485571673", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"不过...\"活动活动手指，\"其实我也是在确认一件事啦，露儿。\""}
{"time": 1753768614, "type": "recv", "message_id": "1509066713", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "往后退，离岩浆远点"}
{"time": 1753768625, "type": "recv", "message_id": "2035197494", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“有点烫...我还是离远一点吧”"}
{"time": 1753768829, "type": "recv", "message_id": "1706124971", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我以前做过一个梦。\"一边开口一边在夏弥面前晃晃自己的手心，委屈巴巴地盯着她，\"梦里见过漫天的岩浆和一个黑色怪物...今天到这里，才会突发奇想，接触一下岩浆...\""}
{"time": 1753768868, "type": "recv", "message_id": "1127039285", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那你有想到什么吗”"}
{"time": 1753769067, "type": "recv", "message_id": "1869192850", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1706124971]夏弥瘪瘪嘴“为什么怪我啦……不过安的梦……似乎不只是”她像是意识到什么，闭上了嘴"}
{"time": 1753769125, "type": "recv", "message_id": "1645887438", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没有哦?或者说我做的梦就很具体啦，被千丈的岩浆打落，跌入沸腾的地狱...这种，还有一个看不清的黑色怪物。\""}
{"time": 1753769148, "type": "recv", "message_id": "1444338675", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（夏弥想说的其实是不只是梦（）"}
{"time": 1753769176, "type": "recv", "message_id": "977401958", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好吓人....那安姐姐怎么还靠近，正常不应该是有多远跑多远么...”"}
{"time": 1753769277, "type": "recv", "message_id": "598134772", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...?不只是?夏弥想说什么?\"重新看向亮红的液体，\"因为感觉不应该怕它啊...好奇怪的说法，嗯...就是，我好像并不是怕岩浆?这样?\""}
{"time": 1753769474, "type": "recv", "message_id": "1839376705", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“安也不是会逃避的性子啦”夏弥牵过安的手“毕竟之前也……两句话就把我哄来结云了。同样是因为……一个梦”"}
{"time": 1753769550, "type": "recv", "message_id": "2068337590", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“下来我们去哪”"}
{"time": 1753769551, "type": "recv", "message_id": "236223986", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“夏弥难道想说梦其实是真实的吗？”看向露儿，“小露儿之前有做过什么梦吗？”"}
{"time": 1753769566, "type": "recv", "message_id": "1469077818", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“有吧...”"}
{"time": 1753769597, "type": "recv", "message_id": "1354484764", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“嗯？虽然有点失礼，但我想听一听。”"}
{"time": 1753769798, "type": "recv", "message_id": "47022164", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=1968578069]“emm，好久之前了，有点记不太清了，大概是在一片黑暗中，被蓝色的光点烧死了，好像是这样”回忆"}
{"time": 1753769938, "type": "recv", "message_id": "1036331966", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“蓝光...?”思索了一会，“黑暗...?难道是海里吗？”"}
{"time": 1753770035, "type": "recv", "message_id": "721862257", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“露儿..现在能不能回想一下，这个世界上，纯粹黑暗的地方可不多哦？”"}
{"time": 1753770093, "type": "recv", "message_id": "225452520", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“应该是海里吧，毕竟每次做奇怪的梦基本都是泡在水中的时候”"}
{"time": 1753770177, "type": "recv", "message_id": "726549094", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“嗯...深海中蓝色的光吗？总觉得在说很超现实的东西，好啦，现在完全摸不着头脑的话，就不管了好啦。走吧，我们继续往前，去山之心看看”"}
{"time": 1753770344, "type": "recv", "message_id": "451678620", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（上号？）"}
{"time": 1753770361, "type": "recv", "message_id": "823556176", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（一会沧澜来一句我见过你们不是炸了）"}
{"time": 1753770369, "type": "recv", "message_id": "2059296139", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（真见过吗？）"}
{"time": 1753770375, "type": "recv", "message_id": "7119068", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（没啊）"}
{"time": 1753770375, "type": "recv", "message_id": "373132032", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“会不会是不是什么电球呢”"}
{"time": 1753770431, "type": "recv", "message_id": "50831989", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“电球...?”看向沧澜，“嗯...海中带电体吗》”"}
{"time": 1753770477, "type": "recv", "message_id": "1738823082", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我？”沧澜见你们都看向她，指了指自己"}
{"time": 1753770490, "type": "recv", "message_id": "2032301422", "deleted": true, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=451678620]（）"}
{"time": 1753770530, "type": "recv", "message_id": "657303573", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“提起深海里的龙...能带电的第一反应就是...沧澜了吧？”"}
{"time": 1753770562, "type": "recv", "message_id": "483492170", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“应该不是沧澜吧，感觉沧澜肯定不会电我的”"}
{"time": 1753770576, "type": "recv", "message_id": "329022295", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你在发什么颠）"}
{"time": 1753770583, "type": "recv", "message_id": "185427473", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（是一件事吗）"}
{"time": 1753770599, "type": "recv", "message_id": "1770485620", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（哈哈）"}
{"time": 1753770618, "type": "recv", "message_id": "2132151332", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“开个玩笑..”"}
{"time": 1753770632, "type": "recv", "message_id": "935941858", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“确实不会……一般情况下”沧澜居然接了"}
{"time": 1753770640, "type": "recv", "message_id": "1033020261", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（最后因为不会读空气，被魔女化的伊拉汉娜杀了（）"}
{"time": 1753770654, "type": "recv", "message_id": "2008371782", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“呃...深海啊，真是完全不懂的地方”"}
{"time": 1753770793, "type": "recv", "message_id": "1711122515", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“说起来，我们这里，对海洋懂的最多的，也就是沧澜了吧？海里有什么吗？”停顿，“以及，虽然我一直没问，但我也很好奇，是什么伤到了你，在海里。”"}
{"time": 1753770912, "type": "recv", "message_id": "690135441", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“给我留下伤疤的那个，也会放电来着。应该是古龙吧”沧澜偏转身体，像是在用伤口回忆“没有我那时的躯体长……说实话，我也是第一次见”"}
{"time": 1753771015, "type": "recv", "message_id": "1455216304", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“古龙？”皱起眉，“海中的古龙只听说过大海龙这种诶...”"}
{"time": 1753771034, "type": "recv", "message_id": "1488613906", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“但是那种怎么都不会比沧澜小吧。”"}
{"time": 1753771105, "type": "recv", "message_id": "1462165091", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“也就是说。”目光灼灼地看着她们,“确认有新的古龙种吗？”"}
{"time": 1753771118, "type": "recv", "message_id": "1046423594", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“会不会还没成年呢”"}
{"time": 1753771148, "type": "recv", "message_id": "1063582313", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“这一点沧澜应该最清楚最多？”"}
{"time": 1753771314, "type": "recv", "message_id": "193862789", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“毫无疑问是成年体”沧澜摇头“你们说的大海龙是哪种？”"}
{"time": 1753771489, "type": "recv", "message_id": "663854513", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“安姐姐来讲吧，我也不是特别清楚”"}
{"time": 1753771518, "type": "recv", "message_id": "1668778661", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...就是..\"卡壳，\"我也没见过\""}
{"time": 1753771652, "type": "recv", "message_id": "1219124942", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“光听名字的话……确实有一种很大很大的古龙”沧澜想了想“体色很淡，一般不在深海。相比较而言，脾气也算……还好”"}
{"time": 1753771654, "type": "recv", "message_id": "547614430", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"感觉...大号的海龙?\""}
{"time": 1753771709, "type": "recv", "message_id": "259287211", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“总之，和我遇到的确实不是同一种”"}
{"time": 1753771778, "type": "recv", "message_id": "134974310", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（说起来你们还在火山来着）"}
{"time": 1753771781, "type": "recv", "message_id": "1302862828", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（过个聆听）"}
{"time": 1753771787, "type": "recv", "message_id": "1332671457", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": ".rd+2"}
