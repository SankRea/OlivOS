{"time": 1753631658, "type": "recv", "message_id": "265119885", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"小心黏菌哦?\"抽出剑向前夹击，\"我来助你。\""}
{"time": 1753631677, "type": "recv", "message_id": "493007052", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "顺带一提，露儿身上的黏菌已然变成明亮的粉红色"}
{"time": 1753631721, "type": "recv", "message_id": "976069389", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...你怎么完全不管黏菌?\"皱着眉，从包里扔出打消果实给露儿"}
