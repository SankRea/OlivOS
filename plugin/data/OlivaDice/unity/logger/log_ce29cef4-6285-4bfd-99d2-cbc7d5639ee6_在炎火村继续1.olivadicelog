{"time": 1753773663, "type": "recv", "message_id": "113694722", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(好的)"}
{"time": 1753773673, "type": "recv", "message_id": "1888706336", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=29501741]“嗯，不错不错”夏弥点头“这次要不要直接按住呢？不想弄得一片一片的啦”"}
{"time": 1753773724, "type": "recv", "message_id": "2039054849", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:image,file=23C3E0F7BA8333EDF8BB1FBCFD10F751.jpg,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhQhm4JG5kYyIABUvAuWGgME6uOIAhi1qGcg_wooi92WnsThjgMyBHByb2RQgL2jAVoQ4b2yqznjl3AYNQM_X1fHRXoCfWM&amp;rkey=CAMSMBvX19wbqgf0Amjz38WvkuuQnfnxTQ3Y7d11UrHk8zPzuY0KClEgpw1nTbcGvqbyuQ,file_size=1692725]"}
{"time": 1753773730, "type": "recv", "message_id": "530232273", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我好尽力，可惜还是输了）"}
{"time": 1753773743, "type": "recv", "message_id": "1081339505", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你好尽力）"}
{"time": 1753773759, "type": "recv", "message_id": "1581321177", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"可以哦?\"打量着成色，\"露儿和沧澜待会攻击的时候，能不能尽量不要破坏到丝线的部分呢？\""}
{"time": 1753773766, "type": "recv", "message_id": "1228847057", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好”"}
{"time": 1753773788, "type": "recv", "message_id": "1113265675", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"尤其是赫萝啦，不要用翅膀把丝线全割断了。\""}
{"time": 1753773820, "type": "recv", "message_id": "1018326901", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（直接拿风按在地上不就好了（）"}
{"time": 1753773860, "type": "recv", "message_id": "1802557628", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(按得住的话，那我当然没意见)"}
{"time": 1753774950, "type": "recv", "message_id": "229693636", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...或者直接用风压按在地上?但是...做得到吗？\""}
{"time": 1753775089, "type": "recv", "message_id": "124902286", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“一般来说可能……比较难。但这家伙的受力面积尤其大啦。这就是所谓的……”夏弥抬手又下压“树大招风啦？”"}
{"time": 1753775378, "type": "recv", "message_id": "1996740165", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "气流的流向陡然改变，向着穹顶汇聚，又自妃蜘蛛头顶呼啸而下，它高昂的头颅顿时砸在地上，强韧的丝线拖着它的肢体一一跪伏"}
{"time": 1753775545, "type": "recv", "message_id": "1957914422", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶...好厉害。\"看着妃蜘蛛被压下来，\"嗯...\""}
{"time": 1753775555, "type": "recv", "message_id": "504137938", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "风声不断变得锐利，令你们有一种在穿梭的不真实感。而妃蜘蛛不断试图挣扎起身，臣蜘蛛运气好的被吹飞，运气差的则落入岩浆中"}
{"time": 1753775709, "type": "recv", "message_id": "779385666", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“大家都好厉害啊”"}
{"time": 1753775763, "type": "recv", "message_id": "167454606", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我的话就没那么厉害啦。\""}
{"time": 1753775777, "type": "recv", "message_id": "1192301654", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"感觉还不如露儿你\""}
{"time": 1753775863, "type": "recv", "message_id": "2052774300", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哎？安姐姐不是也可以飞么，我倒是和个普通人没什么区别”"}
{"time": 1753775897, "type": "recv", "message_id": "624923083", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没有啦，我只会近地悬浮...\"沮丧，\"露儿还能打出很帅的激光炮吧？\""}
{"time": 1753775905, "type": "recv", "message_id": "595724435", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“只取丝……应该就好了？我尽量削减它的体力”夏弥出口气"}
{"time": 1753775991, "type": "recv", "message_id": "1418896924", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"摸摸夏弥的额头，\"只取丝就好了。"}
{"time": 1753776211, "type": "recv", "message_id": "266109533", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“不过我也没法那么精细地在维持风场的同时动刀，只能自己动手了”说着，夏弥抓出一柄小刀，朝风场里走去"}
{"time": 1753776235, "type": "recv", "message_id": "71001392", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哎？真的算会吗，我都感觉当时会不会是误会了，其实根本不是我发射的”挠挠头"}
{"time": 1753776312, "type": "recv", "message_id": "1099674666", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=71001392]“这点倒不用怀疑啦，露儿，毋庸置疑就是你。”看着夏弥往风场里走，拉住她“诶诶，我去吧？”"}
{"time": 1753776519, "type": "recv", "message_id": "216653745", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1099674666]“里头强度很高的啦”夏弥吐吐舌头“或者……你们带了麻醉的东西吗？”"}
{"time": 1753776624, "type": "recv", "message_id": "565908825", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“麻醉玉的话，倒是有随身带着。”递给她，“里头强度很高的话，夏弥也不能进去。”拉着的手靠近一些变成挽在一起"}
{"time": 1753776725, "type": "recv", "message_id": "298186922", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你在说什么.jpg）"}
{"time": 1753776744, "type": "recv", "message_id": "1919560768", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(本来是手拉着手臂)"}
{"time": 1753776756, "type": "recv", "message_id": "2129124948", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(现在滑进去不就成挽在一起)"}
{"time": 1753776770, "type": "recv", "message_id": "1893626480", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我的意思是，难道会被自己的风刮到吗）"}
{"time": 1753776808, "type": "recv", "message_id": "133202838", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（看着很危险，打咩）"}
{"time": 1753777099, "type": "recv", "message_id": "179010981", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=565908825]“好嘛好嘛”夏弥用风团包裹着麻醉玉，强行糊在妃蜘蛛面部，只要呼吸，就没法避免吸入"}
{"time": 1753777578, "type": "recv", "message_id": "928207956", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯哼，这样就好了。\""}
{"time": 1753777724, "type": "recv", "message_id": "353732465", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"安什么时候才能有这种程度的能力啦。\"靠在夏弥肩膀上喃喃自语"}
{"time": 1753777882, "type": "recv", "message_id": "336374939", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "默默的磨刀，为没有战斗叹气"}
{"time": 1753778001, "type": "recv", "message_id": "1545864264", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(什么拔刀)"}
{"time": 1753778005, "type": "recv", "message_id": "286513529", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（为没有战斗叹气是？）"}
{"time": 1753778030, "type": "recv", "message_id": "178777955", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（不能战斗爽了）"}
{"time": 1753778060, "type": "recv", "message_id": "738380562", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（拔都拔了，磨一下）"}
{"time": 1753778085, "type": "recv", "message_id": "457697076", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "拿出血药喝一口，之前没喝来着，顺便给沧澜一瓶"}
{"time": 1753778106, "type": "recv", "message_id": "1480348894", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（原来人设是杀胚？）"}
{"time": 1753778121, "type": "recv", "message_id": "825559920", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（也对吧（）"}
{"time": 1753778134, "type": "recv", "message_id": "643112530", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（毕竟回顾我短短的一生，一直在找怪杀）"}
{"time": 1753778634, "type": "recv", "message_id": "1004409612", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我要问了）"}
{"time": 1753778644, "type": "recv", "message_id": "1950839106", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你是抱着什么心情挥刀的，这还挺重要的）"}
