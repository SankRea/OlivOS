{"time": 1753795973, "type": "recv", "message_id": "1122646639", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（小扣10血）"}
{"time": 1753796011, "type": "recv", "message_id": "1321053740", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“安姐姐是怎么学会飞的呢”"}
{"time": 1753796091, "type": "recv", "message_id": "1891497305", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“没关系，总有一天露儿会熟练掌握那种能力的。”看着里面动静逐渐变小，“嗯..我的话，似乎是靠近了结云之后？”"}
{"time": 1753796102, "type": "recv", "message_id": "925244048", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "里头安静下来，稍微过了会，盔甲上沾着几点没完全凝固的岩浆的赫萝手上拿着片蒜瓣肉边啃边走出来“完事完事……真劲道啊，这鱼……”"}
{"time": 1753796195, "type": "recv", "message_id": "1104443068", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“不过我也只能做到些近地悬浮这种程度啦。”看着赫萝出来，递给她一瓶回复药G，“这种...好像撒点调味料就能直接吃？”"}
{"time": 1753796203, "type": "recv", "message_id": "1099783436", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（悬浮，什么汉娜）"}
{"time": 1753796358, "type": "recv", "message_id": "1513926930", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我看着……差不多？不过里头现在还很热，到处都是岩浆”赫萝随手接过你的药，已经习惯了从你那拿补给了"}
{"time": 1753796636, "type": "recv", "message_id": "233305312", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"赫萝倒是一点不怕烫，有些羡慕啊。\"打量自己之前破皮的手心，想到了什么侧过头看夏弥，\"夏弥呢？\""}
{"time": 1753796700, "type": "recv", "message_id": "801910769", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（其实天慧只有龙耐是正的（））"}
{"time": 1753796739, "type": "recv", "message_id": "659074347", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "崇拜的看着赫萝"}
{"time": 1753796929, "type": "recv", "message_id": "1644449032", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:image,file=F5E4C4F7233E2F6673AF6FBCD41F9718.png,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhR9bjfHdDG09bTZQEYnsHCpCSGShxiCRyD_CiiG8p_XmuKOAzIEcHJvZFCAvaMBWhCOV87EOZSdBtEdbTZzVZimegJugw&amp;rkey=CAQSMPHwtVqwvbw3yldWHJzVbfmn6hGXilnEHleG8Z8tF3Sl1TD_TBgcaud2kGWCWAfMpA,file_size=9090]"}
{"time": 1753796994, "type": "recv", "message_id": "465097739", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(龙属性以外的攻击特别有效)"}
{"time": 1753797005, "type": "recv", "message_id": "1996498057", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（这是钢龙（））"}
{"time": 1753797011, "type": "recv", "message_id": "1719843677", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（冰耐100）"}
{"time": 1753797040, "type": "recv", "message_id": "317885050", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(到底是谁不怕恶劣环境，jpg)"}
{"time": 1753797249, "type": "recv", "message_id": "2088549137", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=233305312]“我？你知道的啦，我只是格外怕雷击……还有一些古龙通病，对龙属性能量，不太……”夏弥伸个懒腰“自然界里的火焰很少有能融化合金的啦，所以在火山我还是没什么天敌的”"}
{"time": 1753797332, "type": "recv", "message_id": "1276017127", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“好啦，我去里面换换气……凉快了就能进来了”"}
{"time": 1753797519, "type": "recv", "message_id": "1394695830", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:image,file={CB8B2F1F-B24F-19D1-8C75-3DE78202DCF8}.png,sub_type=0,url=https://gchat.qpic.cn/gchatpic_new/0/0-0-CB8B2F1FB24F19D18C753DE78202DCF8/0,file_size=229076]"}
{"time": 1753797528, "type": "recv", "message_id": "1975682394", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（原来怕火）"}
{"time": 1753797622, "type": "recv", "message_id": "410785906", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“嗯嗯...”点点头，“那我就在外面等啦。”扶着下巴，“不知道那家伙的弱点是什么...”"}
{"time": 1753797893, "type": "recv", "message_id": "966762653", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "总之，里头风声大作了一阵子。夏弥出来之后，你们再进去，发现甚至连岩浆色泽都黯淡了些"}
{"time": 1753797904, "type": "recv", "message_id": "2119798984", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“好啦好啦，可以进来了”"}
{"time": 1753797962, "type": "recv", "message_id": "952327139", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "蹦蹦跳跳凑上前，挽住她，“好耶，晚上吃生鱼片...嘶，真的算生的吗？”"}
{"time": 1753798072, "type": "recv", "message_id": "1314844223", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "转头看向那只可能被揍得很惨的鱼"}
{"time": 1753798356, "type": "recv", "message_id": "803666715", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "确实被揍得很惨，地上的足印看得出它几次想跳回河里，但是被赫萝粗暴地打断了。身上没几块好的鳞片，侧鳍的活肉被厨子切下偷吃了"}
{"time": 1753798530, "type": "recv", "message_id": "786809340", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“岩浆烤鱼，露儿。”发挥了一些黑色幽默的细胞，说出这么一句话，“尝一尝？”"}
{"time": 1753798946, "type": "recv", "message_id": "912250401", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "自己拉着夏弥靠过去，就着被切下来的侧鳍部分下刀研究一下肉质"}
{"time": 1753798956, "type": "recv", "message_id": "252109324", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“谢谢安姐姐”接过来"}
{"time": 1753799109, "type": "recv", "message_id": "1764972996", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“露儿也来看看吧，这种岩浆里的生物，身体构造想来会很有趣。”"}
{"time": 1753799169, "type": "recv", "message_id": "305482922", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "过去看看"}
{"time": 1753799254, "type": "recv", "message_id": "460911754", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（不会编啊（）"}
{"time": 1753799337, "type": "recv", "message_id": "152653860", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（ok）"}
{"time": 1753799340, "type": "recv", "message_id": "146284054", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "虽然没有冒烟，但是近体表的鱼肉摸上去微微有些烫手。虽然和熔岩完全没有可比性，不过也比寻常生物体温高得多。不知道该说体表个人能力强还是差"}
{"time": 1753799360, "type": "recv", "message_id": "644951219", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=146284054]（个人能力）"}
{"time": 1753799403, "type": "recv", "message_id": "673882527", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（隔热能力（）"}
{"time": 1753799429, "type": "recv", "message_id": "1013987311", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "放下小折刀，“嘛...”剜下几块泛白的鱼肉，分给周围的人，“岩浆烤鱼刺身！”"}
{"time": 1753799505, "type": "recv", "message_id": "1208840838", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "此外摸着相当有弹性，肌肉强度颇高。与鱼肉相比天然没有腥味。想来寻常不过百来度的开水应该煮不透"}
{"time": 1753799523, "type": "recv", "message_id": "1939524305", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（快进到发明高压锅，不过这玩意只对气密性有要求（）"}
{"time": 1753799660, "type": "recv", "message_id": "1493508282", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“感觉咬下去会很粘牙...”皱着眉，试探着吃一口"}
{"time": 1753799930, "type": "recv", "message_id": "1763270449", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“emmm，味道还不错哎”"}
{"time": 1753800168, "type": "recv", "message_id": "1963147832", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“小心烫哦？露儿牙口好好。”半天咬不断，“呜哇...”看向夏弥，可怜巴巴"}
{"time": 1753800201, "type": "recv", "message_id": "796499280", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那她能怎么办呢）"}
{"time": 1753800219, "type": "recv", "message_id": "1192543656", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（帮她嚼嚼）"}
{"time": 1753800296, "type": "recv", "message_id": "1625386140", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（不太像人）"}
{"time": 1753800359, "type": "recv", "message_id": "568721874", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“可能因为我比较年轻？”"}
{"time": 1753800461, "type": "recv", "message_id": "125435559", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“...我们不是一样大吗？”叼着鱼肉说话含糊不清"}
{"time": 1753800463, "type": "recv", "message_id": "497645577", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "与原主的外观不同，它的肉确实延续着鱼龙种的清甜口味，不过带着很淡的烟熏气，腥味倒是几乎吃不出来。意外地汁水不少，饱满而多汁的口感倒是有点像贝类"}
{"time": 1753800640, "type": "recv", "message_id": "1241229883", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1963147832]“就算这样我也……”夏弥眨眨眼，又掰下一块，放在岩浆上悬着熏烤起来"}
{"time": 1753800733, "type": "recv", "message_id": "2023022413", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“这些生物结云完全没有，看样子四处多走走果然有必要啊”"}
{"time": 1753800777, "type": "recv", "message_id": "1139240985", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "感慨一下"}
{"time": 1753800930, "type": "recv", "message_id": "181842378", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1241229883]“...”郁闷地看着，过一会蹲到一边咬起手上的鱼肉，不说话了"}
{"time": 1753801163, "type": "recv", "message_id": "89208961", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=181842378]失去甲壳保护的鱼肉在岩浆的温度下皱缩起来，像被烤干的菠萝蜜。夏弥凭直觉感受火候，随后撕开表层略微焦化的部分"}
{"time": 1753801175, "type": "recv", "message_id": "1167283198", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "。rd-4 厨艺（对吗）"}
{"time": 1753801175, "type": "reply", "message_id": "1167283198", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[张风辰]使用[厨艺（对吗）]演奏出:[1D20-4={7}-4=3]"}
{"time": 1753801180, "type": "recv", "message_id": "1588092800", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（笑嘻了）"}
{"time": 1753801302, "type": "recv", "message_id": "1580387509", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（笑嘻了）"}
{"time": 1753801319, "type": "recv", "message_id": "1482247769", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(那很黑暗了)"}
{"time": 1753801603, "type": "recv", "message_id": "196476405", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "凑过来看着，\"唔...\"点点头，表情肉眼可见地开心，把没啃断的鱼肉扔进岩浆，安静地继续看着。"}
{"time": 1753801693, "type": "recv", "message_id": "1482830868", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“唔……好像有点烤砸了，啊哈哈……”夏弥自己尝了一口，皱了皱眉"}
{"time": 1753801779, "type": "recv", "message_id": "1022407048", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“原来耐火还能这么用”沧澜陷入沉思，寻找能串签的东西"}
{"time": 1753801834, "type": "recv", "message_id": "952940261", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...我尝尝啦\"，伸手拿过来到自己手上，紧接着咬一口尝尝"}
{"time": 1753801867, "type": "recv", "message_id": "1277013077", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "反正没放调味料，也扒掉了焦糊的部位，再怎么样也不会比生吃差了，对吗？"}
{"time": 1753802211, "type": "recv", "message_id": "10530374", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...感觉还可以诶。\"开口，\"至少现在咬得动了。\"点点头，小口吃，\"我就知道夏弥有办法的嘛。\""}
{"time": 1753803502, "type": "recv", "message_id": "36283883", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "安静吃饭desuwa"}
{"time": 1753803512, "type": "recv", "message_id": "1703113136", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "安静吃饭desuwa"}
{"time": 1753803656, "type": "recv", "message_id": "578931019", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“唔……这种程度，不行啊不行……小白可以帮我判断火候吗？”夏弥揉起自己的脸蛋，对着一旁喝冷饮的白发问"}
{"time": 1753803763, "type": "recv", "message_id": "1396039716", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"唔...\"看见夏弥的架势，当然不会打断她的干劲，\"交给夏弥啦。\"到一旁找露儿，趁着时间闲暇打算继续之前的话题，\"说起来露儿对自己的身份有什么猜测吗？\""}
{"time": 1753803937, "type": "recv", "message_id": "193716271", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不知道啊”"}
{"time": 1753803945, "type": "recv", "message_id": "822799461", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“可能是海里的龙？”"}
{"time": 1753803968, "type": "recv", "message_id": "156548401", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“之前追人鱼龙那次，我感觉我在水里待了好久好久”"}
{"time": 1753804079, "type": "recv", "message_id": "741282397", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...你之前那次中毒昏迷，醒来看见我生气得不行记得吧?你想知道那时候发生了什么吗？\""}
{"time": 1753804141, "type": "recv", "message_id": "1488542111", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“发生了..什么事吗”感觉嘴里东西好像不香了"}
{"time": 1753804354, "type": "recv", "message_id": "850190516", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "看一眼沧澜，\"嗯...当时现在这里的人也都在场。\""}
{"time": 1753804432, "type": "recv", "message_id": "330258535", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"虽然我也想推论露儿就是新出现在海边的那只古龙...\"停顿，\"但是现在似乎可以下定论...并不是呢...\""}
{"time": 1753804480, "type": "recv", "message_id": "1804412309", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“应该不是那只吧，据沧澜所说，那只不会发射帅气的红色激光”"}
{"time": 1753804691, "type": "recv", "message_id": "1004756806", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...就是今天问过之后才确定的。在海里...还存在着特殊的古龙种。\"解开绑着的头发甩一甩，\"真危险啊\""}
{"time": 1753804817, "type": "recv", "message_id": "1060393879", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“所以那天发生了什么吗”"}
{"time": 1753804855, "type": "recv", "message_id": "1568239456", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“毕竟海洋面积比陆地广阔的多吧，纵深更要远胜”沧澜淡定地吃自己的"}
{"time": 1753804862, "type": "recv", "message_id": "541953328", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"对着我们发射了帅气的红色激光。\"捧读，伸手梳理自己的头发"}
{"time": 1753804895, "type": "recv", "message_id": "756607468", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不可能吧，我醒来也没看见有激光发射的过痕迹啊”疑惑"}
{"time": 1753804924, "type": "recv", "message_id": "866804552", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你要是对天发射肯定看不到（）"}
{"time": 1753804944, "type": "recv", "message_id": "964252235", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（但是安说的对她们）"}
{"time": 1753804976, "type": "recv", "message_id": "655328526", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（只要高于水平线且没有树就可以了对不对）"}
{"time": 1753805009, "type": "recv", "message_id": "1687285205", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯哼？\"转头，看见夏弥在专心烤鱼，对着赫萝眨个眼，\"赫萝，你说是不是?\""}
{"time": 1753805079, "type": "recv", "message_id": "616467855", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "赫萝在专心吃鱼“啊？什么？呃……嗯”她随口应了两句，不知道肯定和敷衍那个更多"}
{"time": 1753805106, "type": "recv", "message_id": "685954345", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "看向沧澜求证"}
{"time": 1753805110, "type": "recv", "message_id": "865400697", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"当时把我们可是吓了一跳。\""}
{"time": 1753805283, "type": "recv", "message_id": "129080255", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我没见过啊？”沧澜停下嘴里的鱼肉抬头“激光什么的”"}
{"time": 1753805314, "type": "recv", "message_id": "330993502", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那天发生了什么吗[CQ:face,id=32,raw=&#91;object Object&#93;][CQ:face,id=32,raw=&#91;object Object&#93;][CQ:face,id=32,raw=&#91;object Object&#93;]”"}
{"time": 1753805549, "type": "recv", "message_id": "237117391", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"唉，好吧。\"摇摇头，\"并不是激光......而是露儿像个吸盘一样吸在沧澜的身上\""}
{"time": 1753805561, "type": "recv", "message_id": "1643572846", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“？”"}
{"time": 1753805599, "type": "recv", "message_id": "1973075887", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "沧澜没有发表评论，而是刻意回避一般接着吃肉"}
{"time": 1753805677, "type": "recv", "message_id": "1620902914", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“还...还有吗”心里希望没干什么离谱的事情"}
{"time": 1753805685, "type": "recv", "message_id": "813776222", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"拉过露儿的手放在自己的脖子上，\"像这样用手臂狠狠掐住，怎么用力都掰不开...就像...在捕食?\""}
{"time": 1753805727, "type": "recv", "message_id": "110162111", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“？我的力气应该...没那么大吧，沧澜有受伤吗...”"}
{"time": 1753805801, "type": "recv", "message_id": "1392471192", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"都说是捕食咯?你可以现在掐掐我。\"看着她，松开自己搭在她手臂上的手，\"像是...蟒蛇一样?\""}
{"time": 1753805867, "type": "recv", "message_id": "2044681012", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“没有”沧澜放下食物，直视你的眼睛"}
{"time": 1753805869, "type": "recv", "message_id": "1769386439", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "有点不敢看沧澜...但还是愧疚的看向沧澜“对...不起，我不知道...”"}
{"time": 1753805988, "type": "recv", "message_id": "1200745655", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我知道”沧澜摇头"}
{"time": 1753806023, "type": "recv", "message_id": "980874596", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯哼?虽然想一直瞒着你，但是既然聊到这个话题，还是要说一说的吧?\"手搭上她的手臂，\"现在你的力气当然不足以做到那种事\""}
{"time": 1753806057, "type": "recv", "message_id": "2130771242", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"但是...在那个时候可是像没有骨头一样，牢牢地勒在被捕食对象的身上。\""}
{"time": 1753806064, "type": "recv", "message_id": "565935186", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"当时有做什么梦吗？\""}
{"time": 1753806073, "type": "recv", "message_id": "363856532", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好像没有”"}
{"time": 1753806078, "type": "recv", "message_id": "898526697", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1200745655]她的意思是，“我知道你不是故意的”"}
{"time": 1753806087, "type": "recv", "message_id": "187000675", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（龙神吞梦（）"}
{"time": 1753806099, "type": "recv", "message_id": "1649409626", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(有的吧)"}
{"time": 1753806105, "type": "recv", "message_id": "40943214", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我都记得你在梦里吃东西)"}
{"time": 1753806150, "type": "recv", "message_id": "1831976149", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:forward,id=7532540053628492974]"}
{"time": 1753806161, "type": "recv", "message_id": "1649576417", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（这算梦吗，感觉完全无意识啊）"}
{"time": 1753806230, "type": "recv", "message_id": "151397059", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"无意识的行为往往是一种表征啦。\"继续开口，\"软体，无骨，蟒蛇一样的捕食\""}
{"time": 1753806244, "type": "recv", "message_id": "1160040973", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（废话，梦为什么会有意识）"}
{"time": 1753806259, "type": "recv", "message_id": "1349725675", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我知道了！\"一只手成拳敲到另一只手手掌上"}
{"time": 1753806287, "type": "recv", "message_id": "1634552945", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“.....”还在想自己伤害了沧澜的事情，有点后怕，幸好当时安姐姐在..."}
{"time": 1753806306, "type": "recv", "message_id": "1576161363", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（原来是水母！）"}
{"time": 1753806317, "type": "recv", "message_id": "1889818396", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我还以为是章鱼）"}
{"time": 1753806329, "type": "recv", "message_id": "407853254", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"是水蛇啊\""}
{"time": 1753806334, "type": "recv", "message_id": "875859243", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（水母倒还好看点（）"}
{"time": 1753806359, "type": "recv", "message_id": "927533429", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "点头，\"绝对是水蛇吧！\""}
{"time": 1753806369, "type": "recv", "message_id": "99758576", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯....”有些心不在焉的，随便附和"}
{"time": 1753806475, "type": "recv", "message_id": "754209823", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"有没有认真听我分析啦。\""}
{"time": 1753806687, "type": "recv", "message_id": "110997939", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“蛇吗？”沧澜一手抵着下巴思考“海底确实见过一些很大的蛇形骨架”"}
{"time": 1753806709, "type": "recv", "message_id": "1797599267", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"唉...这件事，嗯...所以说以后不要把自己弄到那个地步。\"继续喋喋不休，\"处理起来好麻烦...而且。\"想到了什么，\"露儿是不是经常会很饿啊?\""}
{"time": 1753806764, "type": "recv", "message_id": "2047030999", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那不是完全对上了。\"摇摇手指，\"贪吃蛇\""}
{"time": 1753806785, "type": "recv", "message_id": "1670498834", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（厉害）"}
