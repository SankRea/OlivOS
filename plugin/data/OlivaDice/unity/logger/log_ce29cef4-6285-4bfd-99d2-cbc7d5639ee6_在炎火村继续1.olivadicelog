{"time": 1753436997, "type": "recv", "message_id": "987581247", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "虽然已经第二次飞了，但还是感觉好新奇"}
