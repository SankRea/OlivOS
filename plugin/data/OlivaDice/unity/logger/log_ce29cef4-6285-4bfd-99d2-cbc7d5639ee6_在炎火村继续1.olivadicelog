{"time": 1753764853, "type": "recv", "message_id": "1505402852", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（吃饭）"}
{"time": 1753765071, "type": "recv", "message_id": "2070456634", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（吃好了）"}
{"time": 1753765120, "type": "recv", "message_id": "1296784110", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "离岩浆远点，不想靠近..."}
{"time": 1753766201, "type": "recv", "message_id": "1241099631", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1618662272]“摸起来倒是……还行”夏弥站起身拍拍手“不过不要让它承重哦”"}
{"time": 1753766351, "type": "recv", "message_id": "40763209", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯嗯。\"招呼露儿过来，\"小露儿，快来吧，这可是难得的体验\""}
{"time": 1753766501, "type": "recv", "message_id": "432773766", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好....吧”看见安姐姐盛情难却，慢慢的靠近"}
{"time": 1753766595, "type": "recv", "message_id": "355249133", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯哼?我很早之前就在想了，这种状态是不是很像脆皮雪糕，芒果味?\""}
{"time": 1753766966, "type": "recv", "message_id": "1875445172", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "岩浆块贴边停滞下来，迫使上游的熔岩改道。暗红与黑色交错，倒像是烤糊的橡皮糖"}
{"time": 1753767056, "type": "recv", "message_id": "2051856920", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好啦。\"看着露儿过来，自己先上手，戳戳之后伸出手覆在其上，\"感觉像是黏黏的热水?其实就快是石头了吧？\""}
{"time": 1753767131, "type": "recv", "message_id": "1521447582", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（真的可以吗）"}
{"time": 1753767371, "type": "recv", "message_id": "1052575476", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(相信我好吧)"}
{"time": 1753767561, "type": "recv", "message_id": "1461101423", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "手感温度大概六十多度，会把手略微烫红的程度"}
{"time": 1753767624, "type": "recv", "message_id": "1743142778", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不烫吗..”"}
{"time": 1753767743, "type": "recv", "message_id": "1426097883", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"还好啦，露儿也试试吧。\""}
{"time": 1753767758, "type": "recv", "message_id": "306721257", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "稍微碰一下"}
{"time": 1753767768, "type": "recv", "message_id": "290685611", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哎呦，好烫”瞬间把手拿开"}
{"time": 1753767779, "type": "recv", "message_id": "1230900775", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（诶理论上是不是可以用碎龙的背甲当冲浪板使）"}
{"time": 1753767786, "type": "recv", "message_id": "456043739", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=290685611]（哦那你可以过个灵感了（）"}
