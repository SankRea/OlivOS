{"time": 1753631933, "type": "recv", "message_id": "110707215", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(那我好像只有这个动作了)"}
