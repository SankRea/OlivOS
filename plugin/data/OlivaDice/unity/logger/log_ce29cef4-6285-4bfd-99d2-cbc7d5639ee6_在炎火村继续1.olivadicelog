{"time": 1753887019, "type": "recv", "message_id": "151560963", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（又不是在回答我）"}
{"time": 1753887045, "type": "recv", "message_id": "2110224615", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那麻烦夏弥姐姐了”"}
{"time": 1753887147, "type": "recv", "message_id": "638632797", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“总之，先回炎火村落脚吧……”夏弥把那丝线抱进怀里，随后一如既往带着你们升空"}
{"time": 1753887194, "type": "recv", "message_id": "512679361", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那就乘着夜晚的西风，回结云吧。\"收拾好东西挽着夏弥，\"诶...先回炎火嘛...好\""}
{"time": 1753887272, "type": "recv", "message_id": "2147205443", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（总得交任务，3还有刀没取）"}
{"time": 1753887279, "type": "recv", "message_id": "1862721945", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（虽然，已经不需要了）"}
{"time": 1753887290, "type": "recv", "message_id": "286314130", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（刀怎么不需要了）"}
