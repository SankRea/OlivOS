{"time": 1753879367, "type": "recv", "message_id": "924235536", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（能不能快点吃完下山了）"}
