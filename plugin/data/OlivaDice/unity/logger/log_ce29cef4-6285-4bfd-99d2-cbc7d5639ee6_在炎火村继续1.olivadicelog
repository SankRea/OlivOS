{"time": 1753886784, "type": "recv", "message_id": "585153875", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（）"}
