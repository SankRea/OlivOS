{"time": 1753877178, "type": "recv", "message_id": "1136582714", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（就不能给人家吃点不进口的）"}
