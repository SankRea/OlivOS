{"time": 1753625404, "type": "recv", "message_id": "2029938504", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我还以为是鱼皮）"}
