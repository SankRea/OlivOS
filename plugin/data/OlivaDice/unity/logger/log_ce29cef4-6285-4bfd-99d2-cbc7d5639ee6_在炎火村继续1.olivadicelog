{"time": 1753795958, "type": "recv", "message_id": "790175944", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "。rd5 受伤程度？"}
