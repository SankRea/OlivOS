{"time": 1753431189, "type": "recv", "message_id": "1614521458", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“？安姐姐，你怎么来了”有些疑惑掺杂着惊喜"}
{"time": 1753431260, "type": "recv", "message_id": "1428992613", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“准备去很热的地方探索探索，路过这里的时候看见你们了。正好，我也想来这边看看咯。”"}
{"time": 1753431297, "type": "recv", "message_id": "1404908549", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“这里有什么？”"}
{"time": 1753431305, "type": "recv", "message_id": "102030895", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“很热的地方？对了，安姐姐，你的病好了？”"}
{"time": 1753431384, "type": "recv", "message_id": "124317851", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“嗯...喝完药之后差不多要好了，总得出门转转对不对？”"}
{"time": 1753431422, "type": "recv", "message_id": "417371833", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那就好，不过我也没发现什么特别的东西了，就这些竹简”递给安"}
{"time": 1753431648, "type": "recv", "message_id": "341055243", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...是不是遗落了一部分？”打量着竹简上的文字，“这些故事连不起来”"}
{"time": 1753431744, "type": "recv", "message_id": "136350987", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“神明啊...是说怪物吗？”"}
{"time": 1753432013, "type": "recv", "message_id": "1372492577", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不知道啊，剩下的可能遗失了吧..”"}
{"time": 1753432100, "type": "recv", "message_id": "1358249756", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“总感觉似乎在描述什么事件。”在神社里面转转"}
{"time": 1753432364, "type": "recv", "message_id": "434665039", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（侦查）"}
{"time": 1753432528, "type": "recv", "message_id": "207836419", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。rd20+3"}
{"time": 1753432528, "type": "reply", "message_id": "207836419", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[桃乐丝]演奏出: 1D20+3={7}+3=10"}
{"time": 1753432567, "type": "recv", "message_id": "759319628", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "除了墙上模糊的巴纹图标外，没什么可以留意的东西了"}
{"time": 1753432665, "type": "recv", "message_id": "1486326958", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"算了，就当是饭后的逸闻吧，有兴趣的话，可以在村子里问问咯。\"如是开口，\"我们还有路要赶，露儿是回去了吗\""}
{"time": 1753432690, "type": "recv", "message_id": "848557783", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“安姐姐去火山是要干嘛”"}
{"time": 1753432830, "type": "recv", "message_id": "943842084", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我没有说要去火山吧，不过既然你都猜出来了。嗯...过去转转，工会的任务\""}
{"time": 1753432855, "type": "recv", "message_id": "480123558", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（哈哈，看串了）"}
{"time": 1753432864, "type": "recv", "message_id": "1147952803", "deleted": true, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“oh，大概要去多久”"}
{"time": 1753432894, "type": "recv", "message_id": "790065343", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“oh，我可以一起去吗”期待"}
{"time": 1753433108, "type": "recv", "message_id": "277422763", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那地方很热哦，沧澜可以吗？\""}
{"time": 1753433128, "type": "recv", "message_id": "502386896", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“emmm，那沧澜先回去？”看看沧澜怎么说"}
{"time": 1753433214, "type": "recv", "message_id": "528733259", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯？我吗？我没去过。但我不怕火”沧澜摇头“也不是没有和会喷火的飞龙较量过”"}
{"time": 1753433318, "type": "recv", "message_id": "71851573", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好吧，那就一起去转转吧。我听说那边的一种甲壳类怪物的素材很漂亮，也是打算找一找\""}
{"time": 1753433341, "type": "recv", "message_id": "2068248470", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“这么厉害吗”崇拜的看着沧澜"}
{"time": 1753433585, "type": "recv", "message_id": "2000816848", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=71851573]（咩啊）"}
{"time": 1753433612, "type": "recv", "message_id": "624687087", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那要赶夜路吗”"}
{"time": 1753433649, "type": "recv", "message_id": "2016100469", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(妃)"}
