{"time": 1753433743, "type": "recv", "message_id": "258422383", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（和你们这种靠飞的没什么好说的）"}
{"time": 1753433760, "type": "recv", "message_id": "1018737484", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“对哦，差点忘了夏弥姐姐还有那种厉害的不得了的能力”"}
{"time": 1753433771, "type": "recv", "message_id": "1527660522", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（海龙有翅膀吗）"}
