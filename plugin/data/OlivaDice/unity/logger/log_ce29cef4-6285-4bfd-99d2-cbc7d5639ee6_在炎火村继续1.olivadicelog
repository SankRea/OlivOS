{"time": 1753616775, "type": "recv", "message_id": "361779793", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "平缓语气，跟着赫萝往前走"}
