{"time": 1755611555, "type": "recv", "message_id": "1677633222", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“你东西这个能吃吗？”"}
