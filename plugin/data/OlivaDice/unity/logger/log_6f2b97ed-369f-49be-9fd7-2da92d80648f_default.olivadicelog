{"time": 1755611076, "type": "recv", "message_id": "581673491", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...要确定盟约吗？\"摆摆手，\"对此安安也有办法。\""}
{"time": 1755611089, "type": "recv", "message_id": "1683188971", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“行 我的联系方式是xxxxxxxxzx”"}
{"time": 1755611106, "type": "recv", "message_id": "1942442668", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“确定盟约？”"}
{"time": 1755611110, "type": "recv", "message_id": "160572069", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我没有意见”"}
{"time": 1755611146, "type": "recv", "message_id": "582158963", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“但是我要提前说明，后续的客人我都会采取这个态度，绝非什么货真价实的联盟，只有我们是联盟”"}
{"time": 1755611161, "type": "recv", "message_id": "1151375863", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“但是这是情报收集的手段”"}
{"time": 1755611166, "type": "recv", "message_id": "832987794", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“无可厚非”"}
