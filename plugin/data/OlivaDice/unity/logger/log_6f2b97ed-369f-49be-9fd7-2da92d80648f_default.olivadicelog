{"time": 1755955500, "type": "recv", "message_id": "777543312", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“可以”"}
