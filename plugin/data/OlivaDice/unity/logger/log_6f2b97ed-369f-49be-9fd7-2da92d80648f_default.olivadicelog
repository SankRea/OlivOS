{"time": 1755955361, "type": "recv", "message_id": "601423194", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“用选择题排除有什么意义吗”"}
{"time": 1755955375, "type": "recv", "message_id": "1313425614", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我对圣杯没兴趣不信我提供情报不信”"}
{"time": 1755955376, "type": "recv", "message_id": "696263864", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“毕竟据你所说，你是caster的御主”"}
{"time": 1755955382, "type": "recv", "message_id": "1077565266", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你又有什么诚意呢”"}
{"time": 1755955395, "type": "recv", "message_id": "1023176473", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“诚意就是，作为第五组”"}
{"time": 1755955414, "type": "recv", "message_id": "1262689986", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你觉得一个店铺值得这些情报吗”"}
{"time": 1755955417, "type": "recv", "message_id": "90624476", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“我会帮你说第六第七组”"}
{"time": 1755955423, "type": "recv", "message_id": "610434074", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我只是为了安静做生意罢了”"}
{"time": 1755955428, "type": "recv", "message_id": "1920528194", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“说句不好听的”"}
