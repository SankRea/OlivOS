{"time": 1755611076, "type": "recv", "message_id": "581673491", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...要确定盟约吗？\"摆摆手，\"对此安安也有办法。\""}
{"time": 1755611089, "type": "recv", "message_id": "1683188971", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“行 我的联系方式是xxxxxxxxzx”"}
{"time": 1755611106, "type": "recv", "message_id": "1942442668", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“确定盟约？”"}
{"time": 1755611110, "type": "recv", "message_id": "160572069", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我没有意见”"}
{"time": 1755611146, "type": "recv", "message_id": "582158963", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“但是我要提前说明，后续的客人我都会采取这个态度，绝非什么货真价实的联盟，只有我们是联盟”"}
{"time": 1755611161, "type": "recv", "message_id": "1151375863", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“但是这是情报收集的手段”"}
{"time": 1755611166, "type": "recv", "message_id": "832987794", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“无可厚非”"}
{"time": 1755611181, "type": "recv", "message_id": "792041291", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好的，我没意见，二阶堂小姐用自己的方法就好”"}
{"time": 1755611200, "type": "recv", "message_id": "2124808534", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*用手机发送一段录音给你们"}
{"time": 1755611212, "type": "recv", "message_id": "1111566381", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "手心一翻，两只鸽子叼着一张羊皮纸出现，\"签下字...就是契约...\""}
{"time": 1755611218, "type": "recv", "message_id": "769563372", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“遇到危险，可以带上耳机放出这段录音即可”"}
{"time": 1755611225, "type": "recv", "message_id": "227152338", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“小黑会过来的”"}
{"time": 1755611235, "type": "recv", "message_id": "837083525", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“内容只是我唱歌的声音而已”"}
{"time": 1755611260, "type": "recv", "message_id": "927006292", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“行，多谢了，希望我们能达成愉快的同盟”"}
{"time": 1755611265, "type": "recv", "message_id": "112268680", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“姐姐你什么时候去录的？”"}
{"time": 1755611278, "type": "recv", "message_id": "112148429", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*脸红"}
{"time": 1755611286, "type": "recv", "message_id": "1825649319", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“洗澡啦，不要问这种细节的问题了”"}
{"time": 1755611345, "type": "recv", "message_id": "1703071098", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“那么第三位客人，请继续你们的行动吧，记得遇到其他人替我宣传一下，服务费在门口左手边的pos上刷卡即可，现金可交给小黑”"}
{"time": 1755611371, "type": "recv", "message_id": "380041150", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...唱歌吗？黑头发的姐姐原来也有这种爱好?\"羊皮纸落到自己手里，递给对方，鸽子则是顺着门飞出"}
{"time": 1755611401, "type": "recv", "message_id": "2122991745", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*签下盟约"}
{"time": 1755611407, "type": "recv", "message_id": "1389603317", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“希望一切顺利”"}
{"time": 1755611420, "type": "recv", "message_id": "2112660238", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“下午要一起参加热狗大胃王比赛吗，就在这条商业街。”"}
{"time": 1755611420, "type": "recv", "message_id": "1771330604", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“拜拜了二位”刷卡付费"}
