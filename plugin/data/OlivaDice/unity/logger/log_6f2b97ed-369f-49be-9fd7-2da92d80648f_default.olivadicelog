{"time": 1755954983, "type": "recv", "message_id": "679393472", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“西班牙”"}
{"time": 1755954991, "type": "recv", "message_id": "236939948", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“不信就没必要问我了”"}
{"time": 1755954995, "type": "recv", "message_id": "1846559602", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*皱眉"}
{"time": 1755955088, "type": "recv", "message_id": "9972191", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“哦哦”"}
{"time": 1755955096, "type": "recv", "message_id": "1679848334", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“不赖嘛”"}
{"time": 1755955115, "type": "recv", "message_id": "100483689", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你的问话就像是在审判”"}
{"time": 1755955140, "type": "recv", "message_id": "412833850", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“如果真要继续质问”"}
{"time": 1755955142, "type": "recv", "message_id": "125972435", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“只是一些必要的排查而已”"}
{"time": 1755955144, "type": "recv", "message_id": "1207334458", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我只能告诉你”"}
{"time": 1755955149, "type": "recv", "message_id": "840252369", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“全是假的”"}
