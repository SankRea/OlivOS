{"time": 1755955156, "type": "recv", "message_id": "819224553", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“满意”"}
