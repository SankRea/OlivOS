{"time": 1755955302, "type": "recv", "message_id": "2108200661", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“有点恶心吗”"}
{"time": 1755955313, "type": "recv", "message_id": "849779615", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你一直提问，一直认为我是假的”"}
