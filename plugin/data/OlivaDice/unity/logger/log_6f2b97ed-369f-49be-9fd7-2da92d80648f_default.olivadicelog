{"time": 1755955215, "type": "recv", "message_id": "2140971007", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“选择题？”"}
{"time": 1755955223, "type": "recv", "message_id": "662436187", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你的意思我在参加一场考试？”"}
{"time": 1755955239, "type": "recv", "message_id": "928441271", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“三一大教堂和医院，哪一处的灵脉是lv5”"}
