{"time": 1758543683, "type": "recv", "message_id": "1814699795", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "（那你们，自己聊？）"}
{"time": 1758543706, "type": "recv", "message_id": "526269215", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你好，需要我为您做些什么吗？”"}
{"time": 1758543855, "type": "recv", "message_id": "1989631162", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“塔罗占卜店欢迎您的到来”"}
{"time": 1758544918, "type": "recv", "message_id": "1173081583", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "（我先咕着）"}
{"time": 1758544984, "type": "recv", "message_id": "2062045010", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "（厉害）"}
