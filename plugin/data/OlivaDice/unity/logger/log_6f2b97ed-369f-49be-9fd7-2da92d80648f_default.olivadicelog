{"time": 1755951534, "type": "recv", "message_id": "1521169293", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“阁下呢”"}
{"time": 1755951575, "type": "recv", "message_id": "771862549", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“在您回答前我向您提出一份誓约”"}
{"time": 1755951591, "type": "recv", "message_id": "1469671448", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“应该是rider吧”"}
{"time": 1755951603, "type": "recv", "message_id": "792818022", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“虽然我觉得像是berserker”"}
{"time": 1755951610, "type": "recv", "message_id": "1789286376", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“关于让占卜店成为一个临时停战区域的地方”"}
{"time": 1755951629, "type": "recv", "message_id": "528060199", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“这里灵脉等级不低吧”"}
{"time": 1755951667, "type": "recv", "message_id": "321090577", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "（骑车了）"}
{"time": 1755951671, "type": "recv", "message_id": "951163337", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“任何人都不允许在此作战”"}
{"time": 1755951675, "type": "recv", "message_id": "2071337289", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“并非高等级”"}
{"time": 1755951678, "type": "recv", "message_id": "1711323578", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "（弧一会）"}
{"time": 1755951685, "type": "recv", "message_id": "228185524", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我只是保护我的店铺而已”"}
{"time": 1755952514, "type": "recv", "message_id": "1895152087", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“也就是说，现在不会在占卜店动手的已经有五组主从了？”"}
{"time": 1755952531, "type": "recv", "message_id": "1363005589", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“算上您是第五组”"}
{"time": 1755952620, "type": "recv", "message_id": "1750971975", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“你也不会动手？”"}
{"time": 1755952633, "type": "recv", "message_id": "1197939647", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我自然是在五组之中”"}
{"time": 1755952688, "type": "recv", "message_id": "989359936", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“如果真有一天打起来，你会在占卜店阻止我进来避难么”"}
{"time": 1755952701, "type": "recv", "message_id": "2112587902", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "\"并不会\""}
{"time": 1755952713, "type": "recv", "message_id": "372535071", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“如何保障”"}
{"time": 1755952735, "type": "recv", "message_id": "1095731316", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“对于魔术师而言，誓约即是保障”"}
{"time": 1755952751, "type": "recv", "message_id": "1985088539", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“前提是，落款本人”"}
{"time": 1755952776, "type": "recv", "message_id": "1976155107", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我是不是欺骗者，你大可以用些探测的魔术”"}
{"time": 1755952797, "type": "recv", "message_id": "2108695544", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“还是说你在占卜屋附近看见过争斗？”"}
{"time": 1755952804, "type": "recv", "message_id": "1750692490", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“我可以以霍恩海姆家的荣耀和技艺起誓，你要在天平另一段放上什么呢”"}
{"time": 1755952850, "type": "recv", "message_id": "242581011", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我说句实话，我要是也以所谓的世家荣耀起誓，其实也就是一句话的事情”"}
{"time": 1755952957, "type": "recv", "message_id": "315216118", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“那我押上我的魔术刻印，如何”"}
{"time": 1755952977, "type": "recv", "message_id": "14835676", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我用情报来换取信任吧”"}
{"time": 1755953019, "type": "recv", "message_id": "1513311184", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“还是说你希望我用什么起誓呢”"}
{"time": 1755953077, "type": "recv", "message_id": "335752915", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“我不知道哦”*笑"}
{"time": 1755953099, "type": "recv", "message_id": "1898632864", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“你会给我什么样的情报呢”"}
{"time": 1755953244, "type": "recv", "message_id": "480491153", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“灯塔藏着一份提前设置的道具”"}
{"time": 1755953249, "type": "recv", "message_id": "1281353659", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你可以去获取”"}
{"time": 1755953346, "type": "recv", "message_id": "1799096399", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“前提是，其他人没有去过”"}
{"time": 1755953485, "type": "recv", "message_id": "720651321", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“如果我没拿到的话，岂不是亏了”"}
{"time": 1755953503, "type": "recv", "message_id": "1961436025", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“没拿到也只是倒霉”"}
{"time": 1755953508, "type": "recv", "message_id": "1594156265", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“我会去灯塔看看，之后再决定”"}
{"time": 1755953565, "type": "recv", "message_id": "582756241", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我事前提醒”"}
{"time": 1755953583, "type": "recv", "message_id": "2084591614", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我没有任何理由去帮助你赢得圣杯战争”"}
{"time": 1755953588, "type": "recv", "message_id": "1161428745", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“请不要得寸进尺”"}
{"time": 1755953599, "type": "recv", "message_id": "1446740688", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我只是需要不想店铺被破坏而已”"}
{"time": 1755953614, "type": "recv", "message_id": "976003130", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“一个店铺并不值得我给你一个非你莫属的绝佳道具”"}
{"time": 1755953617, "type": "recv", "message_id": "1574331505", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你需要理解”"}
{"time": 1755953759, "type": "recv", "message_id": "821321756", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“我没有一定要赢的理由”"}
{"time": 1755953790, "type": "recv", "message_id": "294441364", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“你呢？假如真的有机会，你是要店铺？还是要圣杯？”"}
{"time": 1755953798, "type": "recv", "message_id": "1685335550", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我对圣杯没有兴趣”"}
{"time": 1755953806, "type": "recv", "message_id": "551310484", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“不然我也不会把优势拱手让人”"}
{"time": 1755953909, "type": "recv", "message_id": "50894864", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“那么进行下一步吧”"}
{"time": 1755953930, "type": "recv", "message_id": "1290135788", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“塔罗牌的预言是，不要前往天文台”"}
{"time": 1755954000, "type": "recv", "message_id": "894709541", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“只是对我的吗”"}
{"time": 1755954047, "type": "recv", "message_id": "1401176329", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“只是对你”"}
{"time": 1755954344, "type": "recv", "message_id": "40498712", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“商业街的灵脉等级在我们对话这段时间也足够你查询了”"}
{"time": 1755954362, "type": "recv", "message_id": "757716275", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你是这五组中最多疑的那个，现在也应该相信我了吧”"}
{"time": 1755954469, "type": "recv", "message_id": "1208843570", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“好吧”"}
{"time": 1755954474, "type": "recv", "message_id": "421338679", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“我答应你”"}
{"time": 1755954497, "type": "recv", "message_id": "1047891520", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“再次奉劝你，就当是我骗你吧”"}
{"time": 1755954506, "type": "recv", "message_id": "2062853079", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“不要一个人走向右边的天文台”"}
{"time": 1755954526, "type": "recv", "message_id": "796329602", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“那你陪我去？”*笑"}
{"time": 1755954559, "type": "recv", "message_id": "1137661008", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“并不行”"}
{"time": 1755954576, "type": "recv", "message_id": "1091406619", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“知道什么叫做定点秒杀吗”"}
{"time": 1755954581, "type": "recv", "message_id": "2078871666", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*笑"}
{"time": 1755954595, "type": "recv", "message_id": "428489991", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“你的手笔？”"}
{"time": 1755954607, "type": "recv", "message_id": "1549605166", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“如果是我，今天圣杯就该出世了”"}
{"time": 1755954619, "type": "recv", "message_id": "620629820", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“很不幸，我只是知道”"}
{"time": 1755954620, "type": "recv", "message_id": "238110098", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“我会去看看的”"}
{"time": 1755954638, "type": "recv", "message_id": "2085301353", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我只尽到奉劝的义务”"}
{"time": 1755954647, "type": "recv", "message_id": "1944220592", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“这是第二份的价格了”"}
{"time": 1755954666, "type": "recv", "message_id": "513502056", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“如果你要再深入，需要付第三份的价格了”"}
{"time": 1755954764, "type": "recv", "message_id": "2134934317", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“你想要我出怎样的价呢”"}
{"time": 1755954778, "type": "recv", "message_id": "1096964553", "deleted": true, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“价格是由你提供由是评估”"}
{"time": 1755954784, "type": "recv", "message_id": "1429068832", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“价格是由你提供由我评估”"}
{"time": 1755954795, "type": "recv", "message_id": "901743999", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“那很难办了呢”"}
{"time": 1755954808, "type": "recv", "message_id": "254985710", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“诚意才是做生意的基本”"}
{"time": 1755954823, "type": "recv", "message_id": "1359019647", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“即战力，令咒，救助”"}
{"time": 1755954824, "type": "recv", "message_id": "1503262688", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“西半区的灵脉等级你探查过了吗”"}
{"time": 1755954833, "type": "recv", "message_id": "2092242658", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“价格是都是可以商讨的”"}
{"time": 1755954852, "type": "recv", "message_id": "2128753062", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我自然是知道的，但是你能付出价格吗”"}
{"time": 1755954868, "type": "recv", "message_id": "1426059764", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“那你跑的挺快的”"}
{"time": 1755954889, "type": "recv", "message_id": "1924077616", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“并不是”"}
{"time": 1755954897, "type": "recv", "message_id": "766641610", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“全知全能的代价罢了”"}
{"time": 1755954910, "type": "recv", "message_id": "1536748439", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“我要验证一下你嘴里的真假了。”"}
{"time": 1755954919, "type": "recv", "message_id": "1476492335", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“请”"}
