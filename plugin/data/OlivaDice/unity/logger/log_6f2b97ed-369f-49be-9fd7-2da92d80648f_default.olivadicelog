{"time": 1755607379, "type": "recv", "message_id": "788834708", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "看眼价目表"}
{"time": 1755607379, "type": "recv", "message_id": "1854452009", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（怎么叠词）"}
{"time": 1755607397, "type": "recv", "message_id": "948088756", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“需要进行塔罗占卜的话，请随机抽取三张塔罗牌”"}
{"time": 1755607413, "type": "recv", "message_id": "953197269", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好，拜托你了”"}
{"time": 1755607426, "type": "recv", "message_id": "1374917396", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“请”"}
{"time": 1755607427, "type": "recv", "message_id": "1426099567", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（多少抽三呢）"}
{"time": 1755607462, "type": "recv", "message_id": "212404651", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*在帘子后伸手，示意她从面前抽取即可"}
{"time": 1755607464, "type": "recv", "message_id": "1182116337", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(22)"}
{"time": 1755607496, "type": "recv", "message_id": "917241567", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": ".r3#d22"}
{"time": 1755607496, "type": "reply", "message_id": "917241567", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[天宫露]演奏出: 1D22= \n16\n8\n9"}
{"time": 1755607559, "type": "recv", "message_id": "29303602", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "坐在一边，含着棒棒糖，\"嗯...味道还不错。\""}
{"time": 1755607624, "type": "recv", "message_id": "519888194", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“作为圣杯战争的一员”"}
{"time": 1755607642, "type": "recv", "message_id": "637186320", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“塔罗牌占卜并非毫无用处”"}
{"time": 1755607662, "type": "recv", "message_id": "357240702", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“作为lancer的御主，很高兴能遇见您”"}
{"time": 1755607674, "type": "recv", "message_id": "485538675", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“您是哪位御主呢？”"}
{"time": 1755607694, "type": "recv", "message_id": "982923188", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“？这么坦诚吗”"}
{"time": 1755607705, "type": "recv", "message_id": "1421300222", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我还以为会更勾心斗角一点”"}
{"time": 1755607716, "type": "recv", "message_id": "707589217", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我只是开店赚一些钱罢了”"}
{"time": 1755607722, "type": "recv", "message_id": "2043194952", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我对那个杯子没什么兴趣”"}
{"time": 1755607769, "type": "recv", "message_id": "2009686175", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“如果有需要，你付出足够的代价，我可以提供有关我所知道的圣杯战争的情报”"}
{"time": 1755607780, "type": "recv", "message_id": "1829609411", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“一切都可以量化，只要价钱足够”"}
{"time": 1755607786, "type": "recv", "message_id": "1534220549", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那您的从者呢”"}
{"time": 1755607797, "type": "recv", "message_id": "1746840510", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“她也对圣杯不感任何兴趣？”"}
{"time": 1755607814, "type": "recv", "message_id": "612114437", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“她如果感兴趣就不会吃十几份意面了”"}
{"time": 1755607819, "type": "recv", "message_id": "441306124", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“是吧，小黑”"}
{"time": 1755607829, "type": "recv", "message_id": "308498311", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“能够吃饱杯子就只是杯子”"}
{"time": 1755607853, "type": "recv", "message_id": "760374942", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“？”"}
{"time": 1755607857, "type": "recv", "message_id": "655679182", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“下午还有热狗大赛等着我呢。”"}
{"time": 1755607862, "type": "recv", "message_id": "1760799925", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“您的从者也是罗小黑？”"}
{"time": 1755607874, "type": "recv", "message_id": "615853740", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“你也要去参加吗？”"}
{"time": 1755607881, "type": "recv", "message_id": "1659926192", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "*看向金发的从者"}
{"time": 1755607892, "type": "recv", "message_id": "1129532700", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“还是先回到我的问题吧，您是哪一位御主”"}
{"time": 1755607909, "type": "recv", "message_id": "1288620643", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"肉酱意面好没有品味...\"有些无语，\"就算想吃东西，也得吃多点甜品才对吧。\"扭头看向从者，\"热狗...这个不错。\""}
{"time": 1755607926, "type": "recv", "message_id": "944609656", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“请放心，在您之前的二位御主已经和我缔结下契约，兴许您还在码头或者大桥什么地方遇到过她或者他”"}
{"time": 1755607967, "type": "recv", "message_id": "951181160", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“安安想告诉你的话她会告诉你的，我尊重安安的想法”"}
{"time": 1755607967, "type": "recv", "message_id": "1594332091", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“在这个塔罗占卜屋里，是无法进行任何战争的”"}
{"time": 1755607982, "type": "recv", "message_id": "740343273", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“不想说也无所谓”"}
{"time": 1755607992, "type": "recv", "message_id": "240750870", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“让我猜猜吧”"}
{"time": 1755607999, "type": "recv", "message_id": "1725488809", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“也让你觉得物所超值”"}
{"time": 1755608034, "type": "recv", "message_id": "1061952248", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我听露露姐姐的。\"朝着黑发从者伸出手，\"棒棒糖，还要。\""}
{"time": 1755608050, "type": "recv", "message_id": "934382939", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“就剩俩了，你只能拿一个。”"}
{"time": 1755608066, "type": "recv", "message_id": "419527117", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“作为魔术师的御主，谨慎自然是正确的”"}
{"time": 1755608082, "type": "recv", "message_id": "410988912", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“caster也需要地方构筑自己的防御”"}
{"time": 1755608086, "type": "recv", "message_id": "861193614", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那你很厉害了”"}
{"time": 1755608106, "type": "recv", "message_id": "51376381", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "*嚼碎嘴里的棒棒糖，从手里分出一支给金发从者。"}
{"time": 1755608110, "type": "recv", "message_id": "1437107013", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“阁下既然这么厉害的话，能猜出来我的魔术吗”"}
{"time": 1755608116, "type": "recv", "message_id": "736771675", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "*然后自己吃一支。"}
{"time": 1755608147, "type": "recv", "message_id": "1892017722", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "接过来，撕掉糖纸含在嘴里，\"味道还不错...哪里买的\""}
{"time": 1755608168, "type": "recv", "message_id": "17474475", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“大道万千，这是中国古话，不巧的是，您的大道，貌似我也略知一二”"}
{"time": 1755608175, "type": "recv", "message_id": "1128994385", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"甜甜的...不过吃多了感觉会烂牙齿。\""}
{"time": 1755608179, "type": "recv", "message_id": "1544488988", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“说来听听”"}
{"time": 1755608185, "type": "recv", "message_id": "1121618146", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“我在店后面找到的，好像已经过期了不过不影响。”"}
{"time": 1755608204, "type": "recv", "message_id": "701550180", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "（原来你们还没互爆世家吗）"}
{"time": 1755608219, "type": "recv", "message_id": "174291907", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(不是你没说吗，自我介绍都说了)"}
{"time": 1755608228, "type": "recv", "message_id": "815767125", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(有没有可能早自我介绍了)"}
{"time": 1755608230, "type": "recv", "message_id": "259977858", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "（我以为你们会自己说）"}
