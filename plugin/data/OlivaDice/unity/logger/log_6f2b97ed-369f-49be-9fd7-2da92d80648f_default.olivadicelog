{"time": 1760531760, "type": "recv", "message_id": "1368868879", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "（我都忘了）"}
{"time": 1760531839, "type": "recv", "message_id": "741254861", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "[CQ:reply,id=1989631162]“占卜吗？明明身为御主却在做着一些多余的事情呢。”"}
{"time": 1760531863, "type": "recv", "message_id": "1459490337", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“御主也是要生活的”"}
{"time": 1760531971, "type": "recv", "message_id": "1150260102", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“哈哈哈哈，居然还有被生活所迫的魔术师吗”"}
{"time": 1760531983, "type": "recv", "message_id": "1547479714", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“就不能是兴趣爱好吗”"}
{"time": 1760532042, "type": "recv", "message_id": "1058324481", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“无妨，那我就照顾一下你的‘生活’吧”一幅自说自话的样子坐到了对面"}
{"time": 1760532059, "type": "recv", "message_id": "1763244466", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“请问您需要占卜什么？”"}
{"time": 1760532112, "type": "recv", "message_id": "1013509142", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“爱情，如何？这应该是所有塔罗占卜店最畅销的项目吧”"}
{"time": 1760532122, "type": "recv", "message_id": "373110930", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“实际上是事业”"}
{"time": 1760532132, "type": "recv", "message_id": "1521454252", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“但是一切依客人”"}
{"time": 1760532156, "type": "recv", "message_id": "464714187", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "（真的是事业吗）"}
{"time": 1760532159, "type": "recv", "message_id": "1249817750", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“请翻开面前的塔罗牌堆，随机抽取一张即可”"}
{"time": 1760532161, "type": "recv", "message_id": "1035743151", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(真是)"}
{"time": 1760532209, "type": "recv", "message_id": "1615290628", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“那就第五张，帮忙翻开吧”"}
{"time": 1760532232, "type": "recv", "message_id": "372899753", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“恭喜您抽到了战车”"}
{"time": 1760532252, "type": "recv", "message_id": "992730362", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“按照牌面的意思来，您的爱情生涯还真是，风风火火？”"}
{"time": 1760532267, "type": "recv", "message_id": "320785256", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“如万军睥睨之势”"}
{"time": 1760532287, "type": "recv", "message_id": "1600097196", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "（不说正逆？）"}
{"time": 1760532298, "type": "recv", "message_id": "830571401", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "（不说正逆？）"}
{"time": 1760532327, "type": "recv", "message_id": "906434792", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "塔罗牌"}
{"time": 1760532358, "type": "recv", "message_id": "252743051", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“正向的战车意味着您需要勇敢地前进前行，你所坚持的道路即为正确的道路”"}
{"time": 1760532372, "type": "recv", "message_id": "2064364889", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "（这个圣杯反而像我这个人设该抽的）"}
{"time": 1760532388, "type": "recv", "message_id": "2001424456", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(答案是只有大阿卡那)"}
{"time": 1760532401, "type": "recv", "message_id": "412815004", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(因为太多我，记不住)"}
{"time": 1760532478, "type": "recv", "message_id": "91824259", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“吼~战车吗，有意思。”"}
{"time": 1760532484, "type": "recv", "message_id": "349961726", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "（你人设图长啥样来着，忘了）"}
{"time": 1760532497, "type": "recv", "message_id": "773279781", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "（希罗）"}
{"time": 1760532517, "type": "recv", "message_id": "1445435047", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "[CQ:image,file=CABFB67FF5E79B5C4B7774120682F66A.jpg,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhQfrVJ6IcGc5rflip9YDE9RJdFq3hinpQIg_woo4bz52Z6mkAMyBHByb2RQgL2jAVoQv3lFa_dwVeIq8Hbf5-qtcnoCCBuCAQJneg&amp;rkey=CAQSMI6vw9kEq7eTQ-AVlRK5FjzMKYTGSV6U9vpy6P_grVnRXY_TXdSYMuge-1Y8JHQ4-w,file_size=37543]"}
{"time": 1760532667, "type": "recv", "message_id": "111592655", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“兴致的闲谈先告一段落吧。美丽的少女啊，我问你，你向圣杯所求为何”"}
{"time": 1760532690, "type": "recv", "message_id": "1198673899", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我并非对圣杯过度渴求”"}
{"time": 1760532706, "type": "recv", "message_id": "180883159", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“如你所见，我在这里开店，而不是到处奔走”"}
{"time": 1760532855, "type": "recv", "message_id": "1559378218", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“谎言，从者且不论，只有渴求圣杯之人或是深藏愿望之人才会被圣杯选定为御主，这是常识吧”"}
{"time": 1760532891, "type": "recv", "message_id": "234962751", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“圣杯只是我达成目的的手段之一，并非唯一手段”"}
{"time": 1760532903, "type": "recv", "message_id": "396202346", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“并非极度渴求”"}
{"time": 1760532931, "type": "recv", "message_id": "1541288556", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“只是许愿机和自己上下求索得到的区别”"}
{"time": 1760532949, "type": "recv", "message_id": "33495702", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“这么说，你和我一样，是寻求捷径之人”"}
{"time": 1760532964, "type": "recv", "message_id": "689098927", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“有捷径自然要看看，人之常情”"}
{"time": 1760533120, "type": "recv", "message_id": "134724722", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“说的不错，说的不错。而我这里有一条通往捷径的捷径，要试着占卜一下吗”"}
{"time": 1760533132, "type": "recv", "message_id": "1134020583", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“但说无妨”"}
{"time": 1760533150, "type": "recv", "message_id": "525572296", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“占卜这种把戏骗骗普通人的”"}
{"time": 1760533163, "type": "recv", "message_id": "1116493221", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我还是对自己的职业有充分的认识的”"}
{"time": 1760533338, "type": "recv", "message_id": "353884351", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“我向圣杯所求的愿望无比简单，只要能得到满足，即使是完全地倒向你方也无所谓”"}
{"time": 1760533369, "type": "recv", "message_id": "1933892187", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“战争还没有开始，倒向也没有个说法”"}
{"time": 1760533385, "type": "recv", "message_id": "2006333372", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“更何况是我这个并不特别依赖圣杯的”"}
{"time": 1760533399, "type": "recv", "message_id": "2534073", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“御主中比我更渴望的不是大有人在吗”"}
{"time": 1760533547, "type": "recv", "message_id": "1659815247", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“远东的味真一族，世代传承着大胃袋礼装，但凡继承了的魔术师都会成为像我这样的体型”又自说自话起来"}
{"time": 1760533678, "type": "recv", "message_id": "1241825555", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“五百年来，为了保证魔术的资质不会下降，我们一族世代都会因为传宗接代的问题而付出大量彩礼”"}
{"time": 1760533763, "type": "recv", "message_id": "1614796583", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "（彩礼是……）"}
{"time": 1760533857, "type": "recv", "message_id": "708359687", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“交付资源，换来妻子，交付魔术，换来妻子。在魔术界看来这样的传承逻辑可能并没有什么问题吧。但当我在十二岁时，偶然的一次遭遇改变了我”"}
{"time": 1760533870, "type": "recv", "message_id": "1927703498", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“还真是，传奇的故事”"}
{"time": 1760533913, "type": "recv", "message_id": "1441035341", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“爱情，一见钟情的爱情，轰轰烈烈的爱情，相濡以沫的爱情，平淡如水的爱情”"}
{"time": 1760533963, "type": "recv", "message_id": "479837913", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“在我的父母身上看不到，在我的叔叔阿姨身上看不到，在我的爷爷奶奶，我的祖祖辈辈都看不到！”"}
{"time": 1760534018, "type": "recv", "message_id": "1108798669", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“我要——‘打破这个命运’，美丽的小姐，你能明白吗”"}
{"time": 1760534036, "type": "recv", "message_id": "870149074", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“还真是伟大的梦想”"}
{"time": 1760534105, "type": "recv", "message_id": "1322461659", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "[CQ:reply,id=353884351]（）"}
{"time": 1760534138, "type": "recv", "message_id": "619024976", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我可没你那么崇高的梦想，事实上我要许的愿望比你想象中简单”"}
{"time": 1760534144, "type": "recv", "message_id": "2048676273", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*拿出一个笔记本"}
{"time": 1760534172, "type": "recv", "message_id": "428458058", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“作为远东的二阶堂家族的传世礼装，既是馈赠也是诅咒”"}
{"time": 1760534234, "type": "recv", "message_id": "1963602446", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“这本笔记上什么字都没有，但是如果家族的人在名为‘二阶堂希罗’的本子上写下什么，关于二阶堂希罗的命运就会被必然的确定下来”"}
{"time": 1760534246, "type": "recv", "message_id": "1064218422", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“至于我要做的”"}
{"time": 1760534250, "type": "recv", "message_id": "1366031075", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*微笑"}
{"time": 1760534254, "type": "recv", "message_id": "1453984088", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“就很简单了”"}
{"time": 1760534343, "type": "recv", "message_id": "444379209", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“剪定自己未来事项的魔术，还真是伟大的创造，已经可以称得上是第五法的一角了吧”"}
{"time": 1760534391, "type": "recv", "message_id": "208342459", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“如果真这么伟大就不会成为家族的桎梏了”"}
{"time": 1760534461, "type": "recv", "message_id": "855674032", "deleted": true, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我在名为命运的石柱旁，被一根叫做二十五年的柱子拴住，我伸出手，只有五年的光景，剩下的都是一片黑暗”"}
{"time": 1760534480, "type": "recv", "message_id": "930287181", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我在名为命运的石柱旁，被一根叫做二十五年的绳子拴住，我伸出手，却只能触碰五年的光景，剩下的都是一片黑暗”"}
{"time": 1760534527, "type": "recv", "message_id": "621672393", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“改变世界和创造规则对一个穿着拘束衣的囚犯来说，只不过是给折翼的鸟描述笼子外的美好”"}
{"time": 1760534653, "type": "recv", "message_id": "1809144081", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“你是说，你的未来被一件礼装死死绑定，再过几年就要一项项执行其中的内容？”"}
{"time": 1760534685, "type": "recv", "message_id": "450674623", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“礼装吗？我还以为是我的命运”"}
{"time": 1760534843, "type": "recv", "message_id": "1430723446", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“那这么一说，如果你的‘人生笔记’中没有写下‘你能夺得圣杯逃离命运’，你便不会有这样的命运吗？真是可笑”"}
{"time": 1760534910, "type": "recv", "message_id": "1272337057", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“礼装姑且没有强大到能够控制第三法”"}
{"time": 1760534925, "type": "recv", "message_id": "1764701003", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你看圣杯战争，短暂香甜的自由”"}
{"time": 1760534928, "type": "recv", "message_id": "955517383", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“多美好”"}
{"time": 1760534940, "type": "recv", "message_id": "217554051", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“在罗马开一家占卜店也算是小小梦想了”"}
{"time": 1760534978, "type": "recv", "message_id": "493813075", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "（YYSY，龙神能不能说一下这是一条什么世界线）"}
{"time": 1760535012, "type": "recv", "message_id": "832194212", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "（正常圣杯四战五战魔术协会是不知道冬木圣杯跟第三法有关的）"}
{"time": 1760535023, "type": "recv", "message_id": "634507482", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(原来不知道吗)"}
{"time": 1760535025, "type": "recv", "message_id": "113849062", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(哎哟我)"}
{"time": 1760535038, "type": "recv", "message_id": "621305345", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(其实我就想说圣杯战争是被派出来的)"}
{"time": 1760535052, "type": "recv", "message_id": "1280041060", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "（不知道的，肯主任要是知道和第三法有关就不会这么托大了）"}
{"time": 1760535059, "type": "recv", "message_id": "1390057854", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(无所谓了)"}
{"time": 1760535067, "type": "recv", "message_id": "1005510023", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(自有log替我辩经)"}
{"time": 1760535287, "type": "recv", "message_id": "1351006303", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "[CQ:reply,id=1764701003]“笼中的美丽鸟儿——二阶堂希罗，我也来为你塔罗占卜一番吧。”"}
{"time": 1760535290, "type": "recv", "message_id": "897289573", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "塔罗牌"}
{"time": 1760535303, "type": "recv", "message_id": "525987369", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(这么应景啊)"}
{"time": 1760535305, "type": "recv", "message_id": "1985539965", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(无敌了)"}
{"time": 1760535553, "type": "recv", "message_id": "273723287", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“那就容本魔术怪盗作出预告吧，二阶堂希罗，我会偷走你命运的枷锁。”#自认为帅气实则很圆润的wink"}
{"time": 1760535584, "type": "recv", "message_id": "1783426783", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“还有别的需要吗？看在你略显帅气的发言，本次占卜免费”"}
{"time": 1760535670, "type": "recv", "message_id": "1503827384", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“那把散发着奇怪魔力的枪，是你的战利品吗”"}
{"time": 1760535683, "type": "recv", "message_id": "1787977", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“并不是，战争还没开始”"}
{"time": 1760535742, "type": "recv", "message_id": "1113058890", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“那，它是你的所有物吗”"}
{"time": 1760535759, "type": "recv", "message_id": "486561136", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我也没什么好隐瞒的”"}
{"time": 1760535765, "type": "recv", "message_id": "904755942", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“它是，昆古尼尔”"}
{"time": 1760535800, "type": "recv", "message_id": "1762803669", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“世界树的永恒之枪？”"}
{"time": 1760535821, "type": "recv", "message_id": "649527771", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“具体来历得问我我的从者了”"}
{"time": 1760535831, "type": "recv", "message_id": "2109908190", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“反正他只留下了名字”"}
{"time": 1760535859, "type": "recv", "message_id": "1004948340", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“留着防止其他人破坏规则”"}
{"time": 1760535867, "type": "recv", "message_id": "360396423", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我还是很想保住我的小店的”"}
{"time": 1760535909, "type": "recv", "message_id": "219101019", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“有趣，我会再光顾你的小店的，下次见”"}
{"time": 1760535918, "type": "recv", "message_id": "1986160717", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“如果允许”"}
{"time": 1760535926, "type": "recv", "message_id": "1127186173", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“希望还是不要透露这些给其他人了”"}
{"time": 1760535932, "type": "recv", "message_id": "951516270", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“希望你能成功”"}
{"time": 1760535952, "type": "recv", "message_id": "869234677", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“以及，如果战争开始，能尽可能不破坏这家店吗”"}
{"time": 1760536043, "type": "recv", "message_id": "1577487846", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "458095233"}, "sender": {"id": "458095233", "name": "风铃浅唱"}, "message": "“当然无妨，这样的小地方我也施展不开”"}
{"time": 1760536059, "type": "recv", "message_id": "905747838", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(over)"}
