{"time": 1755609855, "type": "recv", "message_id": "320052082", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“倒不如换一点更有价值的事情”"}
{"time": 1755609867, "type": "recv", "message_id": "1924969021", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我可以很坦诚地告诉你”"}
{"time": 1755609874, "type": "recv", "message_id": "834825907", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“比如呢”"}
{"time": 1755609878, "type": "recv", "message_id": "64818899", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我们拥有一项千变万化的宝具”"}
{"time": 1755609883, "type": "recv", "message_id": "1712340758", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“您呢”"}
{"time": 1755609899, "type": "recv", "message_id": "1025140853", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1459322941]\"...你太会吃了。\"皱眉，\"像你这样，糖果店面包店都会被你吃光。\""}
{"time": 1755609902, "type": "recv", "message_id": "659529241", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你大可以把测谎的什么手段用到我身上”"}
{"time": 1755609910, "type": "recv", "message_id": "1854286986", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我不会反抗”"}
{"time": 1755609927, "type": "recv", "message_id": "1594155436", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "[CQ:reply,id=1025140853]“你怎么知道我早上吃了几十块披萨。”"}
{"time": 1755609952, "type": "recv", "message_id": "970147996", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“这样啊....听起来蛮厉害的，那安安讲讲你的宝具吧”"}
{"time": 1755610006, "type": "recv", "message_id": "1523854381", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶...我吗？\"从正在吃吃吃的从者身上移开视线，\"在这里说吗？\""}
{"time": 1755610039, "type": "recv", "message_id": "1403287527", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（姨妈！扣扣得？）"}
{"time": 1755610071, "type": "recv", "message_id": "656846923", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“讲个大概就好吧”"}
{"time": 1755610155, "type": "recv", "message_id": "236793824", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（酒神好强，我真是做了最正确决定，抽酒神）"}
{"time": 1755610233, "type": "recv", "message_id": "1789599923", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好吧...\"抚平前额的碎发，\"我的宝具...可以给予友方加护，提升大部分性能，如同拥抱着的星辰...嗯。\""}
{"time": 1755610316, "type": "recv", "message_id": "2079098442", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我们可以缔结一个盟约，但是我有一个不方便的地方需要你们见谅”"}
{"time": 1755610337, "type": "recv", "message_id": "72847516", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我需要待在这个占卜屋内，最少，最少也得到下午才能行动”"}
{"time": 1755610361, "type": "recv", "message_id": "839798025", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“无所谓吧，反正圣杯战争是晚上的战争”"}
{"time": 1755610378, "type": "recv", "message_id": "619442152", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我的活动范围姑且暂时是整个商业区”"}
{"time": 1755610400, "type": "recv", "message_id": "406119076", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“下午还要去参加热狗大胃王比赛，别忘了姐姐。”"}
{"time": 1755610418, "type": "recv", "message_id": "2126760089", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那盟约怎么确立呢，口头约定？”"}
{"time": 1755610555, "type": "recv", "message_id": "907893349", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“这样吧”"}
{"time": 1755610565, "type": "recv", "message_id": "2011895136", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我们交换一个魔术道具吧”"}
{"time": 1755610590, "type": "recv", "message_id": "110051072", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“毕竟我无法出行，将这个交给你也未尝不可”"}
{"time": 1755610607, "type": "recv", "message_id": "1300712843", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“至于您，随便什么表示诚意的就可以”"}
{"time": 1755610611, "type": "recv", "message_id": "1859148032", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“emmm，让我想想我们有什么可以给你”"}
{"time": 1755610658, "type": "recv", "message_id": "736532946", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“安安你来吧”"}
{"time": 1755610833, "type": "recv", "message_id": "1656967198", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*丢出塔罗牌·恶魔"}
{"time": 1755610865, "type": "recv", "message_id": "2100495924", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我想一想...\"手指轻点地面，泛着蓝色涟漪，\"二级吗...安安送你们一个阵地，足够交换吗？\""}
{"time": 1755610871, "type": "recv", "message_id": "1155197748", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“拿走吧，至于效果，您一定很满意”"}
{"time": 1755610882, "type": "recv", "message_id": "1421223394", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我相信它值得这个二级阵地”"}
{"time": 1755610889, "type": "recv", "message_id": "1530569349", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": ".tarot 恶魔"}
{"time": 1755610920, "type": "recv", "message_id": "722772134", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那感谢二阶堂小姐的馈赠了”"}
{"time": 1755610920, "type": "recv", "message_id": "1599389161", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(注明一下，暂时偷取，三个回合)"}
{"time": 1755610927, "type": "recv", "message_id": "2084683423", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（好的）"}
{"time": 1755611040, "type": "recv", "message_id": "1701162764", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那交换一下联系方式吧”拿出自己绿毛狐狸手机壳的手机"}
{"time": 1755611041, "type": "recv", "message_id": "1359517867", "deleted": false, "dect": {"host_id": null, "group_id": "2163053609", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(包强大的)"}
