{"time": 1774275914, "type": "recv", "message_id": "627270315", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“我叫江杨”"}
