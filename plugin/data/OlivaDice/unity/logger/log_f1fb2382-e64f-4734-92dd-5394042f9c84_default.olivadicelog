{"time": 1775655308, "type": "recv", "message_id": "1872498582", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2483922115"}, "sender": {"id": "2483922115", "name": "湘江August"}, "message": "“关圣帝君保佑，关圣帝君保佑”立刻跪拜"}
{"time": 1775655371, "type": "recv", "message_id": "1024148883", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2483922115"}, "sender": {"id": "2483922115", "name": "湘江August"}, "message": "“请关圣帝君保佑我家孩子，不被邪祟所害”"}
{"time": 1775655464, "type": "recv", "message_id": "556306087", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "下一秒迷雾散去，你们发现自己站在关帝庙殿中，眼前就是威武的关圣帝君像"}
{"time": 1775655504, "type": "recv", "message_id": "1656133211", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“今日于殿上见过一面，吾视汝等虽为亡命之徒，但非大奸大恶，且颇有血性，特此来告汝一言，吾关圣帝君已视未来，今日堂上之签便是告诫，汝等所犯之事凶险异常，如此下去必死无疑……但若汝等哪日破了本君的圣言，可再来见我。最后一句话送给诸位，人已生于天地之间，无终始者，非君子也。”"}
{"time": 1775655508, "type": "recv", "message_id": "397886081", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "＃发现是关帝显灵，原地恭敬跪下"}
{"time": 1775655566, "type": "recv", "message_id": "1920628683", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "“谢帝君圣言”＃俯首拜下"}
{"time": 1775655607, "type": "recv", "message_id": "1594749123", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2483922115"}, "sender": {"id": "2483922115", "name": "湘江August"}, "message": "“谢帝君圣言”#俯身跪拜，额头贴地"}
{"time": 1775655653, "type": "recv", "message_id": "1444770331", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "（言王帝君）"}
