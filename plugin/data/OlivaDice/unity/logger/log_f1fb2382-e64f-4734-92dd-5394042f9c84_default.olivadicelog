{"time": 1774186929, "type": "recv", "message_id": "1215606551", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "（第一部最后？）"}
