{"time": 1775651535, "type": "recv", "message_id": "742301328", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "他查看女童的后背，赫然有一道符咒"}
