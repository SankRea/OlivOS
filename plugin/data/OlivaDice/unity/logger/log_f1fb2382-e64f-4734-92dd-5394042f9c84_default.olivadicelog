{"time": 1774185228, "type": "recv", "message_id": "1114398386", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "#示意同伴安静，走到房间里，接通电话"}
{"time": 1774185252, "type": "recv", "message_id": "1760163092", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "对面传来急切的声音“你还没到吗？”"}
{"time": 1774185288, "type": "recv", "message_id": "1770516610", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2483922115"}, "sender": {"id": "2483922115", "name": "湘江August"}, "message": "保持安静，帮女婴洗干净身子"}
{"time": 1774185400, "type": "recv", "message_id": "353490552", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "#故意用很沙哑的声音回答，装作手机信号不好的样子“倒霉极了，我在路上遇到了塌方，车子出了问题修好花了不少时间，现在还在路上”"}
{"time": 1774185477, "type": "recv", "message_id": "691638512", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“………你是什么人？”对面沉默了一会，立刻反问"}
{"time": 1774185506, "type": "recv", "message_id": "1627301902", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "“你在说什么？”#尝试用话术掩盖过去"}
{"time": 1774185550, "type": "recv", "message_id": "1702764712", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“嘟…嘟…嘟…”对面直接挂断了"}
{"time": 1774185585, "type": "recv", "message_id": "52399140", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "“誒，对方很警惕，也许我不应该接这个电话”"}
{"time": 1774185655, "type": "recv", "message_id": "1043760016", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "#回忆对方的口音，是否和刚刚聊天的老板娘相似"}
{"time": 1774185688, "type": "recv", "message_id": "957247978", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2483922115"}, "sender": {"id": "2483922115", "name": "湘江August"}, "message": "“不必自责，对面很警惕，你不接这个电话他们也会怀疑的”"}
{"time": 1774185712, "type": "recv", "message_id": "1783293440", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2483922115"}, "sender": {"id": "2483922115", "name": "湘江August"}, "message": "给孩子洗完澡，穿好衣服从浴室里出来"}
{"time": 1774185730, "type": "recv", "message_id": "1524490474", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "廖廖数句，并不能分辨出来"}
