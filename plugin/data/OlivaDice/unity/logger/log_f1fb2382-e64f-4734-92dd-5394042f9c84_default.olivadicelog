{"time": 1774181970, "type": "recv", "message_id": "1874141596", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "“最近镇子上有什么活动嘛？”"}
{"time": 1774181977, "type": "recv", "message_id": "2017085717", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "”你确定吗？在哪儿？“"}
