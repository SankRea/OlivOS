{"time": 1774273082, "type": "recv", "message_id": "2019577240", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "[CQ:reply,id=1723984322]点点头，看看那个人"}
{"time": 1774273083, "type": "recv", "message_id": "1878690328", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "在干啥"}
{"time": 1774273149, "type": "recv", "message_id": "2147247229", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "抽烟，像是在等人"}
{"time": 1774273247, "type": "recv", "message_id": "389057375", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "”我去跟他会会“"}
{"time": 1774273261, "type": "recv", "message_id": "184035746", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "#说完，靠过去"}
{"time": 1774273282, "type": "recv", "message_id": "77428467", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "”兄弟，方便借一根抽抽？“"}
{"time": 1774273293, "type": "recv", "message_id": "259560231", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "在一旁看他们聊天"}
{"time": 1774273320, "type": "recv", "message_id": "2044137875", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "（现在是不是一堆地点都是就看了下，还没深入调查）"}
{"time": 1774273325, "type": "recv", "message_id": "220875575", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "（晚点回宿舍我再图）"}
{"time": 1774273331, "type": "recv", "message_id": "1715615833", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“嘿，你这人还真不客气”"}
{"time": 1774273343, "type": "recv", "message_id": "1846709531", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“我不给你能怎么样？”"}
{"time": 1774273400, "type": "recv", "message_id": "431677449", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "”那就很抱歉了。我还以为，你等的人是我呢？“"}
{"time": 1774273435, "type": "recv", "message_id": "706131377", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "他笑了出来，“等你干嘛，你很帅吗？”"}
{"time": 1774273460, "type": "recv", "message_id": "1998011511", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "（我很帅）"}
{"time": 1774273462, "type": "recv", "message_id": "841459287", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "。st app"}
{"time": 1774273462, "type": "reply", "message_id": "841459287", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[王逍遥]的[外貌]: 85"}
{"time": 1774273518, "type": "recv", "message_id": "1542060692", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "”看来是我唐突了。我还以为，山体滑坡给您带来了不小的麻烦。“"}
{"time": 1774273579, "type": "recv", "message_id": "931362198", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“你这人真有意思，净说些我听不懂的话”"}
{"time": 1774273595, "type": "recv", "message_id": "1492000442", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "他掏出一根烟递给你，“来一根？”"}
{"time": 1774273618, "type": "recv", "message_id": "198911370", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "”谢谢。“"}
{"time": 1774273634, "type": "recv", "message_id": "1964804486", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "”帮金茂干活的？“"}
{"time": 1774273646, "type": "recv", "message_id": "1190597041", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "1985245608"}, "sender": {"id": "1985245608", "name": "洛绫飞羽"}, "message": "*从裤兜里摸出一根烟叼到嘴上“我也陪一根”"}
{"time": 1774273679, "type": "recv", "message_id": "1008134280", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“嗯？”"}
{"time": 1774273692, "type": "recv", "message_id": "1086792294", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2483922115"}, "sender": {"id": "2483922115", "name": "湘江August"}, "message": "（？）"}
{"time": 1774273696, "type": "recv", "message_id": "1446713810", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“怎么，你想去金茂干活？”"}
{"time": 1774273729, "type": "recv", "message_id": "991375105", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“你是外地人吧，啥时候来的？”"}
{"time": 1774273804, "type": "recv", "message_id": "282486451", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "“刚来没几天吧。人生地不熟的，别的不知道，就是这边孩子特别多。也不知道为什么‘父母’都喜欢把孩子带到这地方来拜仙姑”"}
{"time": 1774273984, "type": "recv", "message_id": "1885124931", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“最近是中元节嘛，每年都有很多带孩子来祈福的”"}
{"time": 1774273997, "type": "recv", "message_id": "1262001956", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“你又是为什么来的？你有孩子吗”"}
{"time": 1774274045, "type": "recv", "message_id": "1930332567", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "“你看我这像成了家的人吗。”"}
{"time": 1774274051, "type": "recv", "message_id": "1106151513", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "“只不过……”"}
{"time": 1774274090, "type": "recv", "message_id": "37565608", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "“我好像看到一个红衣女童，鞋上绣的都是金丝，一看就是大户人家”"}
{"time": 1774274118, "type": "recv", "message_id": "809163094", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "#观察他的反应"}
{"time": 1774274139, "type": "recv", "message_id": "2093113148", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": ".rh"}
