{"time": 1776684318, "type": "recv", "message_id": "274042630", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "“镇店之宝？拿出来看看？”"}
