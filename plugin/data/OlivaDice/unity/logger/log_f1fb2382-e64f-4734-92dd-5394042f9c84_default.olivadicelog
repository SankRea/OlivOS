{"time": 1776079375, "type": "recv", "message_id": "1130307780", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2483922115"}, "sender": {"id": "2483922115", "name": "湘江August"}, "message": "“倪兄身体好些了吗？”"}
