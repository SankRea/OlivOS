{"time": 1776086274, "type": "recv", "message_id": "467236867", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（你要问啥"}
{"time": 1776086341, "type": "recv", "message_id": "1335751074", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "”欸，哥们，我是来应聘的。你知道要面试些什么吗？事成之后请你搓一顿“"}
{"time": 1776086403, "type": "recv", "message_id": "389485838", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“就是把基本信息填一填，签个合同就可以了”"}
{"time": 1776086412, "type": "recv", "message_id": "1926425385", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“没有什么面试啥的”"}
{"time": 1776086433, "type": "recv", "message_id": "284091509", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "”这么简单？金茂这么缺人吗？“"}
{"time": 1776086538, "type": "recv", "message_id": "614279583", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“毕竟咱们这里年轻劳动力流失嘛，所以厂长很欢迎来做工的”"}
{"time": 1776086597, "type": "recv", "message_id": "1483391974", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "”说得倒也对。金茂药材厂也是因为没人才开始搞食品厂吗？“"}
{"time": 1776086608, "type": "recv", "message_id": "827752549", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "1258719565"}, "sender": {"id": "1258719565", "name": "雪狼"}, "message": "（有味道）"}
{"time": 1776086630, "type": "recv", "message_id": "1396230820", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“在这边主要是干什么的”"}
{"time": 1776086633, "type": "recv", "message_id": "1051743208", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "1258719565"}, "sender": {"id": "1258719565", "name": "雪狼"}, "message": "（有千禧年那味了）"}
{"time": 1776086643, "type": "recv", "message_id": "427773569", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "（就是千禧年捏）"}
{"time": 1776086647, "type": "recv", "message_id": "1611101154", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“你是外地人吧？药材厂十年前被洪水毁了啊”"}
{"time": 1776086657, "type": "recv", "message_id": "1036227492", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "他无语地看着你"}
{"time": 1776086692, "type": "recv", "message_id": "734715805", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "[CQ:reply,id=834691542]（）"}
