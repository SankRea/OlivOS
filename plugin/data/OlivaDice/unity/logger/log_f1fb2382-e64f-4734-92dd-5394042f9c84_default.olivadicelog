{"time": 1774187661, "type": "recv", "message_id": "319439061", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（[CQ:at,qq=2483922115] ）"}
