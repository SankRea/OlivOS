{"time": 1776688517, "type": "recv", "message_id": "1301672078", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "[CQ:image,summary=&#91;动画表情&#93;,file=DD7842BB1FC44186330C02B8F1BF904B.jpg,sub_type=1,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhSZb-p9A7qacePnoeduwqEtWCh1kxi_lgIg_woog6e-v7j8kwMyBHByb2RQgL2jAVoQIRkLA4HMUF-u9PAzOCtW-HoC_dmCAQJneg&amp;rkey=CAQSMJxwDvaKFYU7QqNbX7OK7wyCuAD0NVbZvbg1woAvxQXeoMizrySCsfrDgs-tftS8jA,file_size=35647]"}
