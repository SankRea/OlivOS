{"time": 1776086748, "type": "recv", "message_id": "1026214273", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "“这不是扬短避长吗？”"}
{"time": 1776086766, "type": "recv", "message_id": "1148583284", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“这我咋知道，你去问厂长呗”"}
{"time": 1776086829, "type": "recv", "message_id": "255349854", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "“倒也是，唉，洪水害人啊。”"}
{"time": 1776086876, "type": "recv", "message_id": "83305078", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "“也可能是三太子作孽哦”"}
