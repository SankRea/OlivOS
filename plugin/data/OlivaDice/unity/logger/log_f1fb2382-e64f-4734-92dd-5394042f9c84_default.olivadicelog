{"time": 1776083853, "type": "recv", "message_id": "1824219507", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“未曾听说过”"}
