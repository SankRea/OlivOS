{"time": 1776684053, "type": "recv", "message_id": "953714960", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（孩子在徐舟那呢）"}
{"time": 1776684060, "type": "recv", "message_id": "52100046", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "“我买多一点，100块钱三把，怎么样？”#尝试话术讲价"}
