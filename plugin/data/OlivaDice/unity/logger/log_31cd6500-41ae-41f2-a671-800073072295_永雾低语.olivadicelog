{"time": 1771170739, "type": "recv", "message_id": "233069510", "deleted": false, "dect": {"host_id": null, "group_id": "111918256", "user_id": "1257856112"}, "sender": {"id": "1257856112", "name": "09"}, "message": "那么你们来到了F栋。503位于5楼，605位于6楼。"}
