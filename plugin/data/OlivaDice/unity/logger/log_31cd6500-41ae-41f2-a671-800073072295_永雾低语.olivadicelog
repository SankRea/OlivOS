{"time": 1771076813, "type": "recv", "message_id": "1609178136", "deleted": false, "dect": {"host_id": null, "group_id": "111918256", "user_id": "1162084637"}, "sender": {"id": "1162084637", "name": "十二月星回"}, "message": "“好的，那就麻烦您了。”"}
