{"time": 1771080715, "type": "recv", "message_id": "882345658", "deleted": false, "dect": {"host_id": null, "group_id": "111918256", "user_id": "1257856112"}, "sender": {"id": "1257856112", "name": "09"}, "message": "（CG）"}
