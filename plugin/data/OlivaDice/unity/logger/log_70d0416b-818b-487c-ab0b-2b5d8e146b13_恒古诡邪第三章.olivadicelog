{"time": 1764681820, "type": "recv", "message_id": "1540290200", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我是黄王啊”"}
{"time": 1764681855, "type": "recv", "message_id": "119303994", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“虽然你们可能看我很像某个故人，但我并不是那个人”"}
{"time": 1764681908, "type": "recv", "message_id": "1714393476", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“其实我是劳尔斯的独立出来的一部分，所以有一点点他的记忆”"}
{"time": 1764681928, "type": "recv", "message_id": "990048184", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“你们可能和劳尔斯有仇，但不应该迁怒到我的身上”"}
{"time": 1764681929, "type": "recv", "message_id": "244622398", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(快点死"}
{"time": 1764681934, "type": "recv", "message_id": "1147165332", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"你也该死了。\""}
{"time": 1764681937, "type": "recv", "message_id": "1253836724", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "突袭"}
{"time": 1764681943, "type": "recv", "message_id": "1736679626", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。ri+20"}
{"time": 1764681943, "type": "reply", "message_id": "1736679626", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "先攻列表已设置:\n1. [沙耶]: 1D20+20=40"}
{"time": 1764681961, "type": "recv", "message_id": "1380523844", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“你以为换了名字，改了装扮，你的罪恶就可以一笔勾销了吗”"}
{"time": 1764681964, "type": "recv", "message_id": "1031064295", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“等一下，不要激动，我可以帮你们”"}
{"time": 1764681964, "type": "recv", "message_id": "1707177603", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "2422497068"}, "sender": {"id": "2422497068", "name": "芊"}, "message": "“散兵”"}
{"time": 1764682023, "type": "recv", "message_id": "394420910", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": "1009793416", "name": "灵风雨璇"}, "message": ".RD+2"}
{"time": 1764682023, "type": "reply", "message_id": "394420910", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1009793416"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[灵风雨璇]演奏出: 1D20+2={11}+2=13"}
{"time": 1764682035, "type": "recv", "message_id": "1987729350", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "3362422751"}, "sender": {"id": "3362422751", "name": "维兹"}, "message": ".r"}
{"time": 1764682035, "type": "reply", "message_id": "1987729350", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "3362422751"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[阿尔托莉雅·潘德拉贡]演奏出: 1D20=4"}
{"time": 1764682054, "type": "recv", "message_id": "381796359", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "那你们觉得他看起来非常的真诚，而且很友善的样子"}
{"time": 1764682142, "type": "recv", "message_id": "609371541", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我真的可以帮你们”"}
{"time": 1764682149, "type": "recv", "message_id": "190206633", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“你们是不是要去找劳尔斯”"}
{"time": 1764682187, "type": "recv", "message_id": "1266207277", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“因为我对你们的故事很感兴趣”"}
{"time": 1764682190, "type": "recv", "message_id": "1708527016", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"关你何事。\""}
{"time": 1764682194, "type": "recv", "message_id": "158110679", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我看见你就烦。\""}
{"time": 1764682215, "type": "recv", "message_id": "1623237765", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“至于帮你们找劳尔斯，虽然我不能直接帮助你们，带我可以带你们去找疯诗人”"}
{"time": 1764682234, "type": "recv", "message_id": "1933502957", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“疯诗人无所不知，他应该可以告诉你们劳尔斯的下落”"}
{"time": 1764682281, "type": "recv", "message_id": "1302774888", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=158110679][CQ:at,qq=1252219916] 面对你的咄咄逼人的态度，他没有说什么"}
{"time": 1764682348, "type": "recv", "message_id": "407958538", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“并非，劳尔斯去拜访疯诗人带了很多礼物，所以疯诗人才帮助了他”"}
{"time": 1764682396, "type": "recv", "message_id": "1813482643", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“是这样的，但这要几乎走遍整个幻梦境”"}
{"time": 1764682416, "type": "recv", "message_id": "1711391604", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“当然，如果你们礼物带的够多的话，还会有出乎意料的奖励”"}
{"time": 1764682450, "type": "recv", "message_id": "1452796332", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“并非，你们要找特殊的礼物，礼物清单在劳尔斯的一本书上”"}
{"time": 1764682468, "type": "recv", "message_id": "1464902191", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那本书的名字叫邪灵语翻译指南”"}
{"time": 1764682515, "type": "recv", "message_id": "442458992", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“当你们找齐了七份礼物，就带这那些礼物来找我”"}
{"time": 1764682524, "type": "recv", "message_id": "1243054957", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我带你们去找疯诗人”"}
{"time": 1764682762, "type": "recv", "message_id": "1834400162", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "门是锁的"}
