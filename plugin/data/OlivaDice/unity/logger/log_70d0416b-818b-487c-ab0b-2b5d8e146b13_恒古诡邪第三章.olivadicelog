{"time": 1764683140, "type": "recv", "message_id": "1910395046", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "然后你们来到了泥怪的正上方"}
{"time": 1764683194, "type": "recv", "message_id": "1669051328", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "3362422751"}, "sender": {"id": "3362422751", "name": "维兹"}, "message": "*砸地板"}
{"time": 1764683207, "type": "recv", "message_id": "1065433724", "deleted": false, "dect": {"host_id": null, "group_id": "1098529435", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "那你们砸开了屋顶"}
