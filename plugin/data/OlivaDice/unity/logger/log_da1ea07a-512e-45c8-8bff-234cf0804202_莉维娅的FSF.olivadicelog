{"time": 1770734857, "type": "recv", "message_id": "23836945", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "电话响了很久终于接通了，传来疲劳感很重的声音。"}
{"time": 1770734866, "type": "recv", "message_id": "276885648", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“…谁啊？”"}
{"time": 1770734902, "type": "recv", "message_id": "1220811888", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"是我，韦伯。\"停了一下，感觉有些不合适，\"君主埃尔梅罗。\""}
{"time": 1770734922, "type": "recv", "message_id": "1924862835", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "莉维娅换号码了吗？\n1、换了\n2、没换"}
{"time": 1770734956, "type": "recv", "message_id": "1392380802", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。rd2"}
{"time": 1770734956, "type": "reply", "message_id": "1392380802", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[浅上悠子]演奏出: 1D2=2"}
{"time": 1770735097, "type": "recv", "message_id": "2088190759", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“哦，莉维娅啊，打电话给我想必是很要紧的事吧。”"}
{"time": 1770735227, "type": "recv", "message_id": "1708866930", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我在雪原市，韦伯应该知道吧?\""}
{"time": 1770735292, "type": "recv", "message_id": "816991924", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"倒也不是这件事。我遇见了你的学生，沙条绫香。\"长话短说，\"她召唤了saber的从者。\""}
{"time": 1770735575, "type": "recv", "message_id": "1748464786", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“…我正要坐飞机过去呢，既然你在那，我就放心多了。”"}
{"time": 1770735589, "type": "recv", "message_id": "560792634", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "韦伯有些惊喜。"}
{"time": 1770735623, "type": "recv", "message_id": "1264506118", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "韦伯听到莉维娅在雪原市还要坐飞机过来吗？\n1、要\n2、取消机票了"}
{"time": 1770735634, "type": "recv", "message_id": "1998145137", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"你?君主也要过来?\"有些疑惑，\"我本来是想找你问一下怎么解决这件事，毕竟是你教室的学生。\""}
{"time": 1770735636, "type": "recv", "message_id": "1448434207", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。rd2"}
