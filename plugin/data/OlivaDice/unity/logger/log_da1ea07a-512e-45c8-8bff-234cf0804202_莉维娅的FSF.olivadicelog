{"time": 1773509934, "type": "recv", "message_id": "437241194", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "光刃一刀斩断怪兽的腰部，捷斯塔变成了捷斯 塔"}
{"time": 1773509985, "type": "recv", "message_id": "1963862986", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "随后庞大的尸体缓缓化作灰烬消散。"}
{"time": 1773510009, "type": "recv", "message_id": "83293860", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“这就结束了吗，不愧是天使之力…”"}
{"time": 1773510035, "type": "recv", "message_id": "1462220302", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "神父对莉维娅鞠了一躬。"}
{"time": 1773510301, "type": "recv", "message_id": "1947536585", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...\"不确认这家伙是否真的死亡，\"要小心，这家伙不知道是不是已经死了。\""}
{"time": 1773510338, "type": "recv", "message_id": "1253931190", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "皱着眉，解除天使形态，缓缓落地，\"呼...很累的。\"对神父比个嘘声的姿势，\"什么都没看见，对吧？\""}
{"time": 1773510449, "type": "recv", "message_id": "1636429809", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“嗯嗯，我什么都没看见，毕竟我有一只眼睛带着眼罩，天太黑看不见也很正常。”"}
{"time": 1773510602, "type": "recv", "message_id": "831726964", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "点点头，\"我只是普通的御主。\"打个哈欠，困意上涌，\"所以，你懂我意思。\""}
{"time": 1773510725, "type": "recv", "message_id": "933287116", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“多谢了，我先回去看看警察局那帮人的情况，刚才他们有几个受伤了。”"}
{"time": 1773510750, "type": "recv", "message_id": "2046717845", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "神父转身进入了破碎的警察局后门。"}
{"time": 1773510779, "type": "recv", "message_id": "1667812336", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“怎么还是来了…不应该好好休息吗？”"}
{"time": 1773510789, "type": "recv", "message_id": "1469585937", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "沉默了许久的狂信子发问。"}
{"time": 1773510808, "type": "recv", "message_id": "895414322", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"拜拜。\"在他身后打个招呼，笑着回应狂信子，\"我怎么可能不来。\"走到她身边伸手摸摸脑袋，\"你的事就是我的事。\""}
{"time": 1773510838, "type": "recv", "message_id": "1778911216", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"一起回去吧。\""}
{"time": 1773510936, "type": "recv", "message_id": "1301497219", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"正好我也有些累了，带我回去嘛。\""}
{"time": 1773511150, "type": "recv", "message_id": "1245764872", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“…好。”"}
{"time": 1773511161, "type": "recv", "message_id": "952673992", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "两人一起回到了酒店。"}
