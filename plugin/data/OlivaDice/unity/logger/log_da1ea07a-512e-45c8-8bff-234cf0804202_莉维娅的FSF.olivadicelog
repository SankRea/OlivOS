{"time": 1769618715, "type": "recv", "message_id": "1720548887", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(实名上网)"}
{"time": 1769618806, "type": "recv", "message_id": "1168262226", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“好熟悉的气息…你是，长老？”"}
{"time": 1769618838, "type": "recv", "message_id": "1714580844", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "见到来者是熟人，刚刚还心存戒备的Assassin瞬间放松下来。"}
{"time": 1769618856, "type": "recv", "message_id": "719791605", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "并且摘下兜帽靠近过来。"}
{"time": 1769618896, "type": "recv", "message_id": "1789811358", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“长老怎么在这里，您也是来参加圣杯战争的吗？”"}
{"time": 1769618917, "type": "recv", "message_id": "2068275015", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没想到会是你啊。\"拂了拂发丝，点点头，\"你的御主呢？\""}
{"time": 1769618947, "type": "recv", "message_id": "2093229090", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"有一位旧友邀请我。\"补充一句"}
{"time": 1769619090, "type": "recv", "message_id": "537261069", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“我现在没有御主，我已经把我的御主杀了，他是个追求圣杯的魔术师。”"}
{"time": 1769619104, "type": "recv", "message_id": "619411793", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“长老你也是追求圣杯的魔术师吗？”"}
{"time": 1769619114, "type": "recv", "message_id": "977104409", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "狂信子有些紧张。"}
{"time": 1769619248, "type": "recv", "message_id": "1575980591", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我是应邀而来啦。\"安抚她，\"对于我而言，没有什么需要圣杯实现的愿望。\""}
{"time": 1769619318, "type": "recv", "message_id": "998903619", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“太好了…我就知道长老您不是追求圣杯的人。”"}
{"time": 1769619328, "type": "recv", "message_id": "1712089427", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "狂信子松了一口气。"}
{"time": 1769619352, "type": "recv", "message_id": "1482306918", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "看向天边，\"有位老友告诉我这一次存在神灵级的从者，我当然要亲自来确认一番。\"转头看向她，\"不过，御主如果真的死亡，从者还能保持存在吗？\""}
{"time": 1769619357, "type": "recv", "message_id": "681067182", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "莉维娅过个rd100的侦查"}
{"time": 1769619366, "type": "recv", "message_id": "893397646", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "伸出手，\"我来确认一下吧。\""}
{"time": 1769619368, "type": "recv", "message_id": "1673284304", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。rd100"}
{"time": 1769619368, "type": "reply", "message_id": "1673284304", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[浅上悠子]演奏出: 1D100=72"}
{"time": 1769619468, "type": "recv", "message_id": "448490109", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "雪原市的天空本应繁星满天，但是被城市灯光遮掩了星光，倒是显得没那么美了。"}
{"time": 1769619485, "type": "recv", "message_id": "710756734", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（这个侦查要求极难，没过）"}
{"time": 1769619522, "type": "recv", "message_id": "1140941380", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "[CQ:reply,id=893397646]“是这样吗，那还请长老确认一下。”"}
{"time": 1769619533, "type": "recv", "message_id": "758769812", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "狂信子伸出手。"}
{"time": 1769619550, "type": "recv", "message_id": "146388211", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "握住手，确认契约内容"}
{"time": 1769619571, "type": "recv", "message_id": "1451193619", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "在莉维娅的感知下，狂信子的主从契约并没有中断。"}
{"time": 1769619590, "type": "recv", "message_id": "1427976447", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "可以追加过个魔力感知"}
{"time": 1769619596, "type": "recv", "message_id": "1032163805", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。rd70+30"}
{"time": 1769619596, "type": "reply", "message_id": "1032163805", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[浅上悠子]演奏出: 1D70+30={34}+30=64"}
{"time": 1769619597, "type": "recv", "message_id": "1191626132", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（r70＋30）"}
{"time": 1769619638, "type": "recv", "message_id": "1972248776", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"果然，那家伙没有死呢。\"确信地开口，\"既然不被你所承认，那家伙是?\""}
{"time": 1769619642, "type": "recv", "message_id": "661459489", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "莉维娅还感应到了从契约传过来的魔力性质，那是一种庞大，但是与人类魔力完全相反性质的魔力波动。"}
{"time": 1769619701, "type": "recv", "message_id": "1987034840", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“不可能，我已经用妄想心音直接抹杀了那家伙的生命，难道那名魔术师有后手？”"}
{"time": 1769619799, "type": "recv", "message_id": "1694320554", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"死徒。\""}
{"time": 1769619809, "type": "recv", "message_id": "1009303982", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "直接下了定论，\"那家伙，不是人类。\""}
{"time": 1769619822, "type": "recv", "message_id": "1088580532", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“那名魔术师的名字是捷斯塔…您说什么？”"}
{"time": 1769619838, "type": "recv", "message_id": "1848810015", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "狂信子显然有些难以置信。"}
{"time": 1769619882, "type": "recv", "message_id": "388552953", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯，这不是人类的魔力。这是...非人的死徒。\""}
{"time": 1769619948, "type": "recv", "message_id": "2040349671", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "死徒。\n听闻此单字时，狂信子浑身打起寒颤。\n并非针对被唤作吸血鬼的异形感到恐惧。\n而是对于自己所处的状况做出了最坏的想像。"}
{"time": 1769619962, "type": "recv", "message_id": "321647052", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "──徒劳的死亡信差。\n──驱逐人类的破坏使者。\n她生前并未直接面对过「死徒」，但听闻过关于他们的轶闻。\n每当与异教徒发生大战时，即会现身于战场且不分阵营掀起暴虐狂风的恐怖怪物。"}
{"time": 1769620001, "type": "recv", "message_id": "1367057982", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“──我之所以还存在是因为……？\n──那名怪物…… 将魔力分给我的关系……？”"}
{"time": 1769620017, "type": "recv", "message_id": "1263634749", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯。\"点头，\"契约，没有中断。\""}
{"time": 1769620017, "type": "recv", "message_id": "1646391517", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "无可救药的厌恶感奔窜于她全身上下。\n仿佛体内每一滴鲜血均为剧毒污泥所染般的感觉。\n非人者。\n再者，光是留意他不多的言行举止即可明白。这名男子对所有人类而言，确实有害。\n她无法允许此般人物的魔力流入自己体内。\n就连自身被死徒套上项圈一事都没能察觉，她对自身的不成熟憎恨不已。"}
{"time": 1769620083, "type": "recv", "message_id": "1674834431", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“怎么会…那长老，请允许我先在此告辞，去在此诛杀非人之物，来为我被死徒召唤之事赎罪。”"}
{"time": 1769620130, "type": "recv", "message_id": "781514192", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"御主对从者，持有的令咒，你如何解决?\""}
{"time": 1769620179, "type": "recv", "message_id": "1469195033", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "摇摇头，\"这件事，我来处理吧。\"看向四周，\"你在听吧，名叫杰斯塔的死徒?\""}
{"time": 1769620484, "type": "recv", "message_id": "1432404649", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "。rd100"}
{"time": 1769620484, "type": "reply", "message_id": "1432404649", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[斯薇塔]演奏出: 1D100=20"}
{"time": 1769620522, "type": "recv", "message_id": "270608881", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（还是不这样r了）"}
{"time": 1769620526, "type": "recv", "message_id": "1662421567", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（换个方式）"}
{"time": 1769620547, "type": "recv", "message_id": "384971913", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "死徒捷斯塔会出现吗？\n1、怂了\n2、出现了"}
{"time": 1769620555, "type": "recv", "message_id": "1423561697", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。rd2"}
{"time": 1769620555, "type": "reply", "message_id": "1423561697", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[浅上悠子]演奏出: 1D2=2"}
{"time": 1769620662, "type": "recv", "message_id": "1422038967", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "「嗨，真不错真不错！实在是很合我胃口的重逢啊！」\n大楼顶部突然响彻鼓掌声，还在风中回荡着情绪激昂到诡谲的高亢人声。"}
{"time": 1769620754, "type": "recv", "message_id": "1188229927", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "天台入口关闭的门的阴影中，反映出漆黑暗影的部分，忽然有某人以食指轻轻纵向划过──\n一名青年的身影仿佛要撑开那道裂痕般自门扉出现。"}
{"time": 1769620783, "type": "recv", "message_id": "801538077", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "[CQ:image,file=8156AC1CAE67AEEE9D08810A952FEA59.jpg,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhSoZr_TjbXTKWg1iyzdUA0YJrR9KRj-qQcg_woo7_TwkN-ukgMyBHByb2RQgL2jAVoQubtN2z9Ppj4wFvirUuzDP3oCMhWCAQJneg&amp;rkey=CAESMBaMdoO7B1R05CQxQfFxpcNITTGM4FvKzVoVF8ibefscZdZdHFbz7NVinGGgo057dw,file_size=120062]"}
{"time": 1769620817, "type": "recv", "message_id": "2037336625", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“不过我刚才听说这位小姐要处理我啊，是我听错了吗？”"}
{"time": 1769620853, "type": "recv", "message_id": "2076795831", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "这一瞬间，狂信子就能察觉到，这位就是还与其保持着契约联系的死徒捷斯塔。"}
{"time": 1769620875, "type": "recv", "message_id": "1115230385", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "令人作呕的感觉让狂信子不带犹豫的发动了宝具。"}
{"time": 1769620900, "type": "recv", "message_id": "1364225261", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“妄想心音「zabaniya」！”"}
{"time": 1769620935, "type": "recv", "message_id": "400345846", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "皱眉打量着，等狂信子先动手"}
{"time": 1769621002, "type": "recv", "message_id": "1753687960", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "自称捷斯塔的青年将凶恶笑容贴在脸上，像是用舌尖舔舐刺客全身似的凝视她。"}
{"time": 1769621053, "type": "recv", "message_id": "1310514889", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“啊啊！是那一招吗？那手掌的触感简直像激烈的接吻，想必我将永生难忘。你当时可谓是名副其实地抓住了我的心啊。我因为一度经历死亡的惊吓，连容貌都改变了。”"}
{"time": 1769621112, "type": "recv", "message_id": "1708403243", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "已经无法容忍捷斯塔再说下去的狂信子，带着宝具召唤出的第三只巨手冲向捷斯塔。"}
{"time": 1769621124, "type": "recv", "message_id": "287403616", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "打从心底厌恶这种非人之物，但是没有开口，只是默默开始运转自己的生命之树体系"}
{"time": 1769621171, "type": "recv", "message_id": "154773153", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "靠自己消灭眼前的怪物，驱除自身污秽。\n受到想消灭自己的冲动驱使，却基于信仰而不被允许。但思考这种事本身即是还不成熟的证据，她为此感到羞愧，于是拼尽全力尝试排除眼前的「敌人（主人）」。\n狂信子是如此想的。"}
{"time": 1769621194, "type": "recv", "message_id": "1672426206", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "然而──"}
{"time": 1769621209, "type": "recv", "message_id": "1197677063", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“…… 我以令咒命令你。尽可能转移至远离这座城镇的地点。”"}
{"time": 1769621219, "type": "recv", "message_id": "1100475478", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "捷斯塔边笑边说的同时，女刺客的身体散发光辉。"}
{"time": 1769621233, "type": "recv", "message_id": "1029411525", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我来处理吧，明天见。\"在这时终于开了口"}
{"time": 1769621243, "type": "recv", "message_id": "2085361761", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "光芒在狂信子打算嘶吼什么前，更快地包覆她全身──\n然后直接消失到并非此处的某个地方。"}
{"time": 1769621275, "type": "recv", "message_id": "692227829", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "不过在转移前的最后，狂信子看到莉维娅的眼神，还是露出了释怀的苦笑。"}
{"time": 1769621333, "type": "recv", "message_id": "260124679", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "随后，捷斯塔扫视剩余的莉维娅并耸肩宣言：\n“就是所谓的交棒换人，毕竟我也需要圣杯呢。换句话说，这个嘛，怎么说才好……”"}
{"time": 1769621365, "type": "recv", "message_id": "726210036", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“能请你赶快死掉吗，血袋？”"}
{"time": 1769621403, "type": "recv", "message_id": "445970757", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好吧，看来死徒永远学不会人类的语言，自始至终，只是模仿而已。\""}
{"time": 1769621418, "type": "recv", "message_id": "717620098", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "打个哈欠，\"死徒有几条命?杰斯塔?\""}
{"time": 1769621447, "type": "recv", "message_id": "1179637906", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "莉维娅在刚才捷斯塔使用令咒之时，明确发现了令咒位于捷斯塔左肋下方的位置。"}
{"time": 1769621453, "type": "recv", "message_id": "2028708086", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "[CQ:image,file=98FC77DB856197F0E1D67E908481AC29.jpg,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhR0bylTouzl9mFMJCDH5A-lmAEe4xjAiB4g_woo06mI0OGukgMyBHByb2RQgL2jAVoQjsdAndBzHEFE6oFxWKfkDnoCPZeCAQJneg&amp;rkey=CAESMPkCBihuz6s2eQLRsGfSFKmom46p4qltAwIk9IFyWQ4bETg7A0UDG5v4veJw7hh7IQ,file_size=492608]"}
{"time": 1769621470, "type": "recv", "message_id": "1218825488", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"不过，剥离令咒也是必要的呢。\""}
{"time": 1769621482, "type": "recv", "message_id": "1310507976", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“喂喂，别说大话了，区区人类！”"}
{"time": 1769621507, "type": "recv", "message_id": "304894220", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "随后捷斯塔以极快的速度上前，打算先卸掉莉维娅的四肢。"}
{"time": 1769621544, "type": "recv", "message_id": "540910454", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“我要慢慢折磨你，让我的从者看着你到血慢慢流干！”"}
{"time": 1769621597, "type": "recv", "message_id": "2076531673", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "展开防御术式，既然白天都闹得那么大了，那么自己动动筋骨也不错吧?不过——铺开自己的人偶，要不趁现在试一试?"}
{"time": 1769621666, "type": "recv", "message_id": "1352331956", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "。rd100捷斯塔的攻击"}
