{"time": 1773162030, "type": "reply", "message_id": "916198126", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "人物卡已切换至[小黑]"}
{"time": 1773162039, "type": "recv", "message_id": "588023875", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“那么，就此别过吧。”"}
{"time": 1773162044, "type": "recv", "message_id": "187482363", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "。rd100绫香的分别欲望"}
{"time": 1773162045, "type": "reply", "message_id": "187482363", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[小黑]使用[绫香的分别欲望]演奏出:[1D100=88]"}
{"time": 1773162088, "type": "recv", "message_id": "335723170", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“今晚真是麻烦了，莉维娅小姐，后续有能帮上忙的，请尽管找我。”"}
{"time": 1773162139, "type": "recv", "message_id": "1320374258", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "*绫香深深鞠了一躬，和莉维娅交换好联系方式之后，离开了。"}
{"time": 1773162190, "type": "recv", "message_id": "1834133735", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没关系。\"打个招呼，回身伸个懒腰，也准备回自己下榻的酒店了，\"艾蕾酱怎么看?她做好准备了吗？\"歪着脑袋询问"}
{"time": 1773162203, "type": "recv", "message_id": "1276698668", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“下次见面，不知我们是敌是友呢～”\n*理查双手抱头转身跟着绫香离开了。"}
{"time": 1773162246, "type": "recv", "message_id": "1618543529", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "[CQ:reply,id=1834133735]（你问的她做好准备，她是指谁）"}
{"time": 1773162375, "type": "recv", "message_id": "2124424279", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(绫香)"}
{"time": 1773162401, "type": "recv", "message_id": "808873041", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "。rd100艾蕾的看法"}
{"time": 1773162401, "type": "reply", "message_id": "808873041", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[小黑]使用[艾蕾的看法]演奏出:[1D100=28]"}
{"time": 1773162406, "type": "recv", "message_id": "24667995", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1276698668]笑眯眯地开口回应，\"希望你不会让我觉得无聊哦?理查三世。\""}
{"time": 1773162446, "type": "recv", "message_id": "998754523", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“其实，我感觉那个女孩很奇怪。”"}
{"time": 1773162467, "type": "recv", "message_id": "1742423194", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "艾蕾一边说一边用手指点着脸颊。"}
{"time": 1773162559, "type": "recv", "message_id": "1482232445", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯?哪方面?\"看向艾蕾，\"魔力，还是魔术?\""}
{"time": 1773162598, "type": "recv", "message_id": "1825097517", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“她身上有着一种若有若无仿佛拉德鲁灵一样的气息。”"}
{"time": 1773162616, "type": "recv", "message_id": "900811897", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（应该是叫这个名称吧，有点记不清了）"}
{"time": 1773162635, "type": "recv", "message_id": "1586555454", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“拉德鲁灵就是差不多幽灵一样的东西啦～”"}
{"time": 1773162639, "type": "recv", "message_id": "2031585528", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "随后她解释到。"}
{"time": 1773162664, "type": "recv", "message_id": "1267077668", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“这么说，那位小姐不是邪恶的魔术师，而是魔物吗？”"}
{"time": 1773162682, "type": "recv", "message_id": "586833933", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "旁边的狂信子抓住了什么要点。"}
{"time": 1773162726, "type": "recv", "message_id": "664207899", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"魔物?\"皱眉，\"嗯...那倒是有点奇怪了。\""}
{"time": 1773162736, "type": "recv", "message_id": "247038814", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“不对不对，起码从行为上看算是一个正常的女高中生吧，你快把匕首收起来。”"}
{"time": 1773162939, "type": "recv", "message_id": "1158044596", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...就算是魔物，本人也不自知吧。\"摇摇头，往水晶之丘走，\"而且，现在也有一个国王在她旁边看着，应该不会出事?\""}
{"time": 1773162966, "type": "recv", "message_id": "1905905719", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（叫迦鲁拉灵）"}
{"time": 1773162968, "type": "recv", "message_id": "446133706", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（记错了）"}
{"time": 1773163005, "type": "recv", "message_id": "1347619646", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“我看那个国王应该是完全没看出来，因为即使是我也只能若有若无的感觉到。”"}
{"time": 1773163040, "type": "recv", "message_id": "651799511", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“话说她跟伊什塔尔有关系，那应该是伊什塔尔做了什么手脚吧。”"}
{"time": 1773163069, "type": "recv", "message_id": "606915929", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“还是小心防范为好，毕竟伊什塔尔什么都做得出来…”"}
{"time": 1773163081, "type": "recv", "message_id": "2038048999", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"唔，如果是那个女神的问题的话，我们想必很快就会遇上了。\"耸耸肩，\"毕竟艾蕾在这里嘛。\""}
{"time": 1773163119, "type": "recv", "message_id": "1663473353", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"不如说，什么时候遇到伊什塔尔，都不奇怪?\"环视四周看看"}
{"time": 1773163128, "type": "recv", "message_id": "283761817", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "水晶之丘距离警察局并不是很远，三人走走聊聊，很快就到了豪华酒店的正门处。"}
{"time": 1773163230, "type": "recv", "message_id": "77725837", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"今天就先休息吧，毕竟好像明天才...开始?\""}
{"time": 1773163289, "type": "recv", "message_id": "1593132907", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "在这里会遇到？\n1、被女神气息吸引过来的伊什塔尔？\n2、某个金发闪闪的家伙\n3、并没有遇到人，只是门口的接待\n4、正在往金碧辉煌大厅里望的弗拉特\n5、某个带着四个女性的独眼神父\n6、被女神气息吸引过来的伊什塔尔？\n7、某个金发闪闪的家伙\n8、并没有遇到人，只是门口的接待\n9、独眼神父\n10、混沌的超展开"}
{"time": 1773163384, "type": "recv", "message_id": "263378819", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。rd10"}
{"time": 1773163384, "type": "reply", "message_id": "263378819", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[浅上真由理]演奏出: 1D10=3"}
{"time": 1773163399, "type": "recv", "message_id": "95232586", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(平平淡淡)"}
{"time": 1773163526, "type": "recv", "message_id": "1284824540", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "那就三人等电梯后上到最顶层的豪华总统套房，确认了一下结界的状况后安全进屋。"}
{"time": 1773163578, "type": "recv", "message_id": "2119311357", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“你还要给那个警察局长制作带有Assassin气息的替身人偶吗？”"}
{"time": 1773163596, "type": "recv", "message_id": "1708201315", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "艾蕾闲的无聊表示要观察一番。"}
{"time": 1773163658, "type": "recv", "message_id": "1367777574", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"毕竟答应了嘛。\"从行李里摸出材料，\"虽然不觉得他们能做到，但有信心是好事。\"随手开始制作起来"}
{"time": 1773163682, "type": "recv", "message_id": "78168972", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "狂信子也过来提供了一根头发作为材料。"}
{"time": 1773163707, "type": "recv", "message_id": "1021247974", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "制作花费的时间rd100分钟"}
{"time": 1773163756, "type": "recv", "message_id": "324416439", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。rd100"}
{"time": 1773163756, "type": "reply", "message_id": "324416439", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[浅上真由理]演奏出: 1D100=28"}
{"time": 1773163798, "type": "recv", "message_id": "1094647076", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "收起制作完成的人偶放在一边，仅仅只花了半个小时不到。看向窗外的夜景，\"真不知道这地方明天会变成什么样子。\""}
