{"time": 1770739532, "type": "recv", "message_id": "1727016078", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（改专利）"}
{"time": 1770739540, "type": "recv", "message_id": "1770279956", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（该上床了）"}
{"time": 1770739601, "type": "recv", "message_id": "137354906", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“既然有莉维娅你在，除了你刚才提到的沙条凌香的事，我还有一名学生也参加了圣杯战争，名字是弗拉特。”"}
{"time": 1770739619, "type": "recv", "message_id": "322168476", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "rd100弗拉特认识莉维娅吗？"}
{"time": 1770739640, "type": "recv", "message_id": "462409852", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“既然这样，我就先把这两名学生拜托给你了。”"}
{"time": 1770740956, "type": "recv", "message_id": "1839640584", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "。log off"}
{"time": 1770774072, "type": "reply", "message_id": "2010085762", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "继续记录乐谱"}
{"time": 1770774181, "type": "recv", "message_id": "1103893994", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:image,summary=&#91;送花&#93;,file=e7-e706d2ae351cab38c6a5d6125a131d38.gif,url=https://gxh.vip.qq.com/club/item/parcel/item/e7/e706d2ae351cab38c6a5d6125a131d38/raw300.gif,key=9bd6ed197ad677e3,emoji_id=e706d2ae351cab38c6a5d6125a131d38,emoji_package_id=235847]"}
{"time": 1770774220, "type": "recv", "message_id": "1693822724", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“弗拉特打算参加这次圣杯战争，如果他还没召唤英灵就阻止他，如果召唤了从者，那就委托莉维娅前辈你帮忙看护好他，别让他丢了性命。”"}
{"time": 1770774269, "type": "recv", "message_id": "1942574011", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“对于沙条凌香也是一样，既然召唤了Saber那就没办法了，拜托了。”"}
{"time": 1770774311, "type": "recv", "message_id": "957089198", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“如果你也需要圣遗物召唤英灵，我会提供力所能及的支持的。”"}
{"time": 1770774429, "type": "recv", "message_id": "1394066568", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我大概已经算参与了圣杯战争吧？”语气若有所思，“不过，照看这种事情就这么交给我了？这不是你的责任吗？君主？”"}
{"time": 1770774535, "type": "recv", "message_id": "1366506193", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（我刚路过你骑车带我摔倒的地方，坑已经消失了）"}
{"time": 1770774589, "type": "recv", "message_id": "1430781279", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(唉，人面不知何处去)"}
{"time": 1770774596, "type": "recv", "message_id": "38660437", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "[CQ:reply,id=1394066568]。rd100韦伯的责任心"}
{"time": 1770774596, "type": "reply", "message_id": "38660437", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[斯薇塔]使用[韦伯的责任心]演奏出:[1D100=52]"}
{"time": 1770774646, "type": "recv", "message_id": "1001138945", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“好像我的其他学生们要集体插手这次圣杯战争，我已经够头疼了，所以暂时那边先交给你。”"}
{"time": 1770774714, "type": "recv", "message_id": "278731295", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "电话挂断了。"}
{"time": 1770774756, "type": "recv", "message_id": "1356681036", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“你刚才在和谁打电话，什么学生什么的啊…”"}
{"time": 1770774765, "type": "recv", "message_id": "1048069982", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "rd100沙条凌香的理解"}
{"time": 1770774777, "type": "recv", "message_id": "1978773151", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"啧。\"皱了皱眉，听到绫香的话转过来看向她，平复一下表情。"}
