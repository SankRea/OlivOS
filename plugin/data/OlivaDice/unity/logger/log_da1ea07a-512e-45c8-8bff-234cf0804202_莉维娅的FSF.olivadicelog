{"time": 1770776439, "type": "recv", "message_id": "1951148808", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（原作向展开）"}
{"time": 1770776462, "type": "recv", "message_id": "1120259627", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "就在莉维娅准备离开的时候，大量警员出现了。"}
{"time": 1770776488, "type": "recv", "message_id": "1665749102", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“有人举报剧院发生了谋杀案，请你们走一趟了。”"}
{"time": 1770776503, "type": "recv", "message_id": "473918983", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "有没有认识莉维娅的警员？\nd100"}
{"time": 1770776599, "type": "recv", "message_id": "868569137", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。rd100"}
