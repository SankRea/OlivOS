{"time": 1769794157, "type": "recv", "message_id": "424539703", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "[CQ:image,file=98708EC64F5B54D5918B4462743BB7E6.jpg,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhQgKjXI9mF92c65MeIbEd9r2QlARRiQwwUg_woo2dGggOWzkgMyBHByb2RQgL2jAVoQfxIv6MJ_ZscWd2ji2O8XQnoCG2OCAQJneg&amp;rkey=CAISMFf4K871b8C2X1V79d4iu4jAj7C-vAf5CHo_M9JOPzjLtuLvhAEvUCCm0rHopRP2wQ,file_size=90512]"}
