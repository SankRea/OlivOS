{"time": 1769622264, "type": "reply", "message_id": "1176926958", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[浅上悠子]演奏出: 1D100+50={22}+50=72"}
