{"time": 1769622225, "type": "recv", "message_id": "1849298852", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（还是先解决战斗再说是吧）"}
{"time": 1769622234, "type": "recv", "message_id": "1916320189", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（那就快点打）"}
