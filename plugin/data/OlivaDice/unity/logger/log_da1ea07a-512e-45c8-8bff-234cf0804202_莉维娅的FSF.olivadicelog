{"time": 1773170196, "type": "recv", "message_id": "1631367323", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "随着一张红心K被翻出，在围观群众震惊的目光中，场上的公牌是黑桃9，黑桃J，黑桃K，红心K，梅花K"}
{"time": 1773170217, "type": "recv", "message_id": "1297770", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "属于非常大的公牌"}
{"time": 1773170237, "type": "recv", "message_id": "941764206", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“那么，请双方开牌。”"}
{"time": 1773170245, "type": "recv", "message_id": "1349149235", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（要作弊吗）"}
