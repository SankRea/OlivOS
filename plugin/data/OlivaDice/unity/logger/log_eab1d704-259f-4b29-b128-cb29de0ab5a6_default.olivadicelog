{"time": 1772526046, "type": "recv", "message_id": "1464239660", "deleted": false, "dect": {"host_id": null, "group_id": "1084785147", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(感觉啥也没干啊)"}
