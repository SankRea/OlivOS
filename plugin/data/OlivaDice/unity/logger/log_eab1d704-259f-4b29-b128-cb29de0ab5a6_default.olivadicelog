{"time": 1772630063, "type": "recv", "message_id": "1422502169", "deleted": false, "dect": {"host_id": null, "group_id": "1084785147", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "不归你管，所以你没那个病人的详细信息"}
