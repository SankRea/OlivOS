{"time": 1772629594, "type": "recv", "message_id": "2027160878", "deleted": false, "dect": {"host_id": null, "group_id": "1084785147", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（不认识就说不认识）"}
{"time": 1772629752, "type": "recv", "message_id": "463452458", "deleted": false, "dect": {"host_id": null, "group_id": "1084785147", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "翻阅手头的资料看看有没有这么个人"}
{"time": 1772629790, "type": "recv", "message_id": "608116635", "deleted": false, "dect": {"host_id": null, "group_id": "1084785147", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "是五楼特殊病房的病人，但不归你管"}
