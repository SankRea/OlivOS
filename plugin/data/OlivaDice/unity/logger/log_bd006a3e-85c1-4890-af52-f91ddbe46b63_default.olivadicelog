{"time": 1770202494, "type": "reply", "message_id": "5986650", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "开始记录乐谱"}
{"time": 1770202515, "type": "recv", "message_id": "143405466", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*敲了敲门，示意我们进来了"}
{"time": 1770202516, "type": "recv", "message_id": "1615100046", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“老师好～”跟老师打个招呼“这位就是新同学吗”"}
{"time": 1770202549, "type": "recv", "message_id": "1497034594", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"班长。\"班主任看向折原，先开口，点了点头，不过没理神山露的话，\"这是今年我们班的转学生，你们先各自介绍一下。\""}
{"time": 1770202631, "type": "recv", "message_id": "1326717230", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我叫神山露，别看我矮矮的，其实我是剑道高手..个人爱好是写小说”伸出手以示友好"}
{"time": 1770202650, "type": "recv", "message_id": "320160819", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "#双手提着学生包，两条麻花辫搭在双肩，长长的刘海挡住眼睛，默默打量眼前的二人"}
{"time": 1770202679, "type": "recv", "message_id": "322904048", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "ciallo!"}
{"time": 1770202703, "type": "recv", "message_id": "877034286", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我叫折原临也，是三年三班的班长，欢迎来到三年三班”"}
{"time": 1770202717, "type": "recv", "message_id": "581707197", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“我是矢吹绫，请多指教”"}
{"time": 1770202724, "type": "recv", "message_id": "1337993235", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "#鞠躬行礼"}
{"time": 1770202725, "type": "recv", "message_id": "458328935", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（我是奶龙）"}
{"time": 1770202730, "type": "recv", "message_id": "1129923885", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "（你是？）"}
{"time": 1770202744, "type": "recv", "message_id": "2034759985", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哎？不必行此大礼啦”扶起她"}
{"time": 1770202766, "type": "recv", "message_id": "75255525", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你有亲戚是本地人吗？还是父母之前在本地？”"}
{"time": 1770202767, "type": "recv", "message_id": "1573478808", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”欸“"}
{"time": 1770202782, "type": "recv", "message_id": "1396379154", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "#对眼前过分热情的肢体接触产生本能的抗拒"}
{"time": 1770202800, "type": "recv", "message_id": "842603959", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "看她有些抗拒，就收回了手..."}
{"time": 1770202806, "type": "recv", "message_id": "732750959", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "[CQ:reply,id=75255525]”呃，我、我是“"}
{"time": 1770202855, "type": "recv", "message_id": "2136912710", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“不对，我是本地人”"}
{"time": 1770202867, "type": "recv", "message_id": "1802277601", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“以前住在这里”"}
{"time": 1770202875, "type": "recv", "message_id": "1597960218", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“以前吗？”"}
{"time": 1770202912, "type": "recv", "message_id": "253769904", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“……准确来说，直到国中毕业，我都在这里学习”"}
{"time": 1770202940, "type": "recv", "message_id": "723196355", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“这样啊，那你对当地应该也算是很熟悉吧”"}
{"time": 1770202967, "type": "recv", "message_id": "1965833042", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“差不多吧”"}
{"time": 1770202973, "type": "recv", "message_id": "961190159", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“有些事情不太方便现在给你说，我们先去班上吧，稍后我们会让对策委员长和你详谈”"}
{"time": 1770202982, "type": "recv", "message_id": "440591771", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（原来是老资历）"}
{"time": 1770202989, "type": "recv", "message_id": "2061292742", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“也希望你有一个快乐的学习生活”"}
{"time": 1770203004, "type": "recv", "message_id": "1208504325", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "[CQ:reply,id=961190159]“欸，啊……好的”"}
{"time": 1770203012, "type": "recv", "message_id": "1533652194", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“遇到什么困难的话，我们会帮助你的”拍拍胸膛"}
{"time": 1770203033, "type": "recv", "message_id": "1442371886", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”谢谢“"}
{"time": 1770203062, "type": "recv", "message_id": "1730753338", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "#微抿嘴唇"}
{"time": 1770203102, "type": "recv", "message_id": "1089098759", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*询问老师，“现在就让新同学去班上吗？我们是不是还要额外申请一套桌椅”"}
{"time": 1770203128, "type": "recv", "message_id": "1663034742", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...\"班主任拿起了桌上的文件，摇摇头，\"不清楚的话，不要清楚比较好。毕竟风险在这里。\""}
{"time": 1770203164, "type": "recv", "message_id": "975901628", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“明白了，我们先领新同学去班上吧”"}
{"time": 1770203310, "type": "recv", "message_id": "11599977", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我来带路吧，那老师再见!”"}
{"time": 1770203401, "type": "recv", "message_id": "38193186", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"新的桌椅倒是不需要吧，班里本来不就空了一套吗？\"他看上去很是疲惫，喝了一口热茶，\"靠窗的最后一排座位。\""}
{"time": 1770203418, "type": "recv", "message_id": "505849484", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "（后排靠窗）"}
{"time": 1770203426, "type": "recv", "message_id": "1214797130", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "（嘶——）"}
{"time": 1770203430, "type": "recv", "message_id": "1107618953", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“那一套，真的可以吗”"}
{"time": 1770203446, "type": "recv", "message_id": "1983469559", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*先带新同学过去"}
{"time": 1770203506, "type": "recv", "message_id": "158975827", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "#默默跟在他们后面"}
{"time": 1770203605, "type": "recv", "message_id": "1295824869", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=1107618953]“要不我坐那里，矢吹同学坐我的位置”"}
{"time": 1770203609, "type": "recv", "message_id": "778061768", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“咳……咳咳”"}
{"time": 1770203628, "type": "recv", "message_id": "884989695", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“哈……那套桌椅，怎么了？”"}
{"time": 1770203628, "type": "recv", "message_id": "133270885", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“不要破坏规矩，听对策委员的安排吧”"}
{"time": 1770203766, "type": "recv", "message_id": "1462736749", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“太靠后了”"}
{"time": 1770203796, "type": "recv", "message_id": "953174262", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“而且新同学坐中间位置方便快速融入吧”"}
{"time": 1770203853, "type": "recv", "message_id": "1005200160", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“不，不用”"}
{"time": 1770203857, "type": "recv", "message_id": "772013025", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”这样就好“"}
{"time": 1770203880, "type": "recv", "message_id": "343890981", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”不必为我来换座位的“"}
{"time": 1770203915, "type": "recv", "message_id": "960783938", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“没关系啦，毕竟你是新来的么”"}
{"time": 1770203963, "type": "recv", "message_id": "1092486462", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”……谢谢“"}
