{"time": 1770204088, "type": "recv", "message_id": "308579280", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "说着话的功夫，你们到了教室。三年三班的门牌有些泛黄，透着漫长岁月的洗礼。班级里熙熙攘攘，或者称得上吵闹。"}
{"time": 1770204259, "type": "recv", "message_id": "1269148087", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“这边这边”带她去自己的位置"}
{"time": 1770204282, "type": "recv", "message_id": "1680842893", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“先做一个自我介绍吧，方便大家认识你”"}
{"time": 1770204288, "type": "recv", "message_id": "66180915", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*领着她往讲台走"}
{"time": 1770204306, "type": "recv", "message_id": "1932604078", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“安静安静，我们班新来了一位转校生”"}
{"time": 1770204331, "type": "recv", "message_id": "1675897466", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”！“"}
{"time": 1770204351, "type": "recv", "message_id": "1673001852", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "#见状，不情不愿地往讲台上走去"}
{"time": 1770204388, "type": "recv", "message_id": "997617421", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“呃，那个……”"}
{"time": 1770204426, "type": "recv", "message_id": "1016181606", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“我叫矢吹绫，请多多指教“"}
{"time": 1770204463, "type": "recv", "message_id": "1105343776", "deleted": false, "dect": {"host_id": null, "group_id": "686998018", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(稍等)"}
