{"time": 1759430705, "type": "recv", "message_id": "275269210", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好像也对...难道只能碰运气了吗”"}
{"time": 1759430864, "type": "recv", "message_id": "2013022219", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"如果要出门的话，我们一起吧。\"她看了看窗外，\"待会天黑之后。\""}
{"time": 1759430893, "type": "recv", "message_id": "586595922", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯..谢谢西莉丝姐姐，那我们先去吃晚饭吧..不知道艾璃西雅姐姐吃了没”"}
{"time": 1759431108, "type": "recv", "message_id": "1479898327", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...回来之后我还没看见她\""}
{"time": 1759431131, "type": "recv", "message_id": "339107575", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哎？她不会出门了吧...我去看看”"}
{"time": 1759431148, "type": "recv", "message_id": "1247939928", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "去艾璃西雅房间看看"}
