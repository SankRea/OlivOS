{"time": 1759143800, "type": "recv", "message_id": "1789792265", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(前半肯定是对龙神说的)"}
