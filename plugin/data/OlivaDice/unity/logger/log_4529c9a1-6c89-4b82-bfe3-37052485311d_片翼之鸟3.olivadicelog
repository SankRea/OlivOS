{"time": 1760640350, "type": "recv", "message_id": "770845915", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（因为，不熟）"}
