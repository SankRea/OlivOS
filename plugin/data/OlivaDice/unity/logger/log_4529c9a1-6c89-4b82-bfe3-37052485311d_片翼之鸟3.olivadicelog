{"time": 1756226627, "type": "recv", "message_id": "1533622574", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=554314077]\"诶...可以哦。\"她大大方方地抱着你，\"这种甚至不是奖励啦，粉丝回馈?\""}
{"time": 1756226668, "type": "recv", "message_id": "1815476600", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“姐姐的粉丝真幸福”"}
{"time": 1756226741, "type": "recv", "message_id": "1524235840", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "抱一会不舍的分开“我一定会努力的，让大家都讨厌我...让里谢娜姐姐成为我的唯一”"}
{"time": 1756226869, "type": "recv", "message_id": "125522303", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那姐姐再见了...”恋恋不舍的出去"}
