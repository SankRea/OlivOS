{"time": 1757398883, "type": "recv", "message_id": "1787131615", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“风格相差好远”*心里嘀咕一声"}
{"time": 1757399115, "type": "recv", "message_id": "1746116927", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“您好……原本只是好奇一下，没想到能见到本尊啊。我叫伊芙·艾络温”"}
{"time": 1757399791, "type": "recv", "message_id": "1557393830", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "她的面具遮住上侧的脸，看不清表情，脚踝上的铃铛一响一响，\"嗯哼...?觉得我不像是管理者吗？\""}
{"time": 1757399933, "type": "recv", "message_id": "340837581", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我叫诺薇拉...”"}
{"time": 1757400210, "type": "recv", "message_id": "280214934", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“只是觉得您本人和人偶的风格差别好大，不过审美都在线”"}
{"time": 1757400281, "type": "recv", "message_id": "1234692075", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "不是前管理者么，心里嘀咕..."}
{"time": 1757400422, "type": "recv", "message_id": "343793120", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"人偶毕竟要追寻时兴的潮流。\"她的手指轻拂过嘴唇，流露出一丝媚意，\"我本人还是更喜欢传统一些的服饰。\""}
{"time": 1757401158, "type": "recv", "message_id": "1603666760", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“龙芙小姐，您知道目前中环到底发生了什么吗...”"}
{"time": 1757402272, "type": "recv", "message_id": "535903364", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哦呀，我不是万事通哦?\"她放下自己的兜帽，\"你们找我不是为了这种问题吧？\""}
{"time": 1757402376, "type": "recv", "message_id": "1630426223", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那我们怎样能见到艾希连德德凛克”"}
{"time": 1757405009, "type": "recv", "message_id": "242425627", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哦...你们对他感兴趣，让我猜猜是你们为了什么而来?\"黑丝手套从手袖子里拿出一支烟斗"}
{"time": 1757405148, "type": "recv", "message_id": "1171974194", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"为了刺杀他吗？\"她露出些微笑"}
{"time": 1757405161, "type": "recv", "message_id": "1785175009", "deleted": true, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=1603666760]（）"}
{"time": 1757405220, "type": "recv", "message_id": "1820615974", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我要是有那么厉害，我就不在这里了”"}
{"time": 1757405528, "type": "recv", "message_id": "1868649429", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哦?那为什么急不可耐地要找他?\""}
{"time": 1757405565, "type": "recv", "message_id": "97831769", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“想问问他怎么离开这里..”"}
{"time": 1757405839, "type": "recv", "message_id": "621189239", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“也不是非见他不可，只是希望比之前好点……不过我想见您其实是，对这人偶更感兴趣些”"}
{"time": 1757406272, "type": "recv", "message_id": "1367048780", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=621189239]\"哦...?\"她看着你们，\"既然还想问更多的东西，为什么不请我进去坐坐?\""}
{"time": 1757406324, "type": "recv", "message_id": "148411374", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“抱歉抱歉，龙芙姐姐快进来吧”"}
{"time": 1757406865, "type": "recv", "message_id": "500774290", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "龙芙走进你们室内的沙发坐下，\"好了，慢慢来，一个一个问，而我看心情\""}
{"time": 1757407316, "type": "recv", "message_id": "2060623988", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "去给她倒杯水，放在她面前“龙芙小姐请喝”"}
{"time": 1757408125, "type": "recv", "message_id": "2070808699", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（说起来我还以为我没进去）"}
{"time": 1757408147, "type": "recv", "message_id": "574829553", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没关系。\"她没有拿起水杯，礼貌性地回答了一下"}
{"time": 1757408194, "type": "recv", "message_id": "1229452208", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那个泰坦是用不正当手段夺走了你的管理者身份吗”"}
{"time": 1757408288, "type": "recv", "message_id": "387216759", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（？）"}
{"time": 1757408301, "type": "recv", "message_id": "488666558", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=2070808699](?你不是在房间里吗)"}
{"time": 1757408427, "type": "recv", "message_id": "429529717", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（都行吧，只能说一般来说我不太会进别人的房间）"}
{"time": 1757408915, "type": "recv", "message_id": "484127657", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1229452208]面具的原因看不清上半部分的脸，她发出意味深长的\"哦～\""}
{"time": 1757408919, "type": "recv", "message_id": "1075645108", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(客厅啊)"}
{"time": 1757408922, "type": "recv", "message_id": "2140534276", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(这是套房)"}
{"time": 1757409612, "type": "recv", "message_id": "1683020068", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=484127657]\"上来就问这么尖锐的问题的话，我选择不回答哦?\"她的手放在桌上的杯子上，\"而且心情会变差呢\""}
{"time": 1757409744, "type": "recv", "message_id": "1934112067", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“对不起....”"}
{"time": 1757409854, "type": "recv", "message_id": "1106749857", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“姐姐喜欢吃什么”"}
{"time": 1757409986, "type": "recv", "message_id": "2032713606", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“或者喜欢其他什么东西...”"}
{"time": 1757411387, "type": "recv", "message_id": "1634117224", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哦～这次换成问我的私人隐私吗？\"她的嘴角勾起，\"啊啦...\"有些意味深长。一旁的西里斯扶着额头，稍后拉着爱璃西雅进了房间。"}
{"time": 1757411429, "type": "recv", "message_id": "1844495748", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我...不是那个意思，我我我...”有些急感觉自己说什么都不对"}
{"time": 1757412688, "type": "recv", "message_id": "212117940", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（下班）"}
{"time": 1757412791, "type": "recv", "message_id": "2072371934", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我猜king为了这台人偶应该也下了不少本钱？”*插一嘴"}
{"time": 1757412836, "type": "recv", "message_id": "395689805", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*歪歪脑袋打量一下“这是魔导科技？应该不是炼金术吧”"}
{"time": 1757413028, "type": "recv", "message_id": "194819542", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"艾希连德德凛克?不对哦?这是我的人偶。\""}
{"time": 1757413198, "type": "recv", "message_id": "1792367779", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“喔……我还以为‘权限’指的是所有权……”"}
{"time": 1757413253, "type": "recv", "message_id": "1188265436", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“但是变成客房接待了呢，那我是不是可以斗胆猜测，小姐就住在这酒店……五楼？”"}
{"time": 1757413467, "type": "recv", "message_id": "1792093983", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "自己不太会交涉，就先交给伊芙吧"}
{"time": 1757413790, "type": "recv", "message_id": "1919994507", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哦...?\"龙芙靠着沙发，\"我不否认这个说法，继续吧。\""}
{"time": 1757413972, "type": "recv", "message_id": "1464282883", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我帮您捏捏肩吧”跃跃欲试"}
{"time": 1757414116, "type": "recv", "message_id": "1132982120", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“多的我倒是也不打算过问。king是谁，从哪来……早晚要回哪去的”*坚持不懈地看着诺亚“小姐是，人偶师？可以这么叫吗？”"}
{"time": 1757414798, "type": "recv", "message_id": "1490249035", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1464282883]\"你认真的?\"她抬头看向你，面具下的眼瞳带着些乐见其成，\"不过...\"人偶走到她身后，很自然地为她锤捏肩膀"}
{"time": 1757414984, "type": "recv", "message_id": "1087296261", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哎？”"}
{"time": 1757415134, "type": "recv", "message_id": "1726399446", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1132982120]“要不是囊中羞涩……说什么我也要和小姐讨一个……哪怕是没这么大的”"}
{"time": 1757415243, "type": "recv", "message_id": "97666593", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1132982120]\"哦....你们有没有什么推测?说来听听吧。\"她扭过头看着人偶，\"哦，你这么想的话，我倒是心情会好不少。\""}
{"time": 1757415330, "type": "recv", "message_id": "863319215", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“没有依据的推测没什么意思。小姐看着和连得凛克也不像一路的人，他和他的出现一样没什么道理”"}
{"time": 1757415583, "type": "recv", "message_id": "1220755546", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“不过非要说有什么推测……”"}
{"time": 1757415617, "type": "recv", "message_id": "832437147", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我想，小姐总该带着些目的来的吧？不然，也没必要特地下来一趟”"}
{"time": 1757415679, "type": "recv", "message_id": "1070388560", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“何况身份最高的那位已经进屋了，小姐也一眼都没看过。我们有什么值得注意的吗？”"}
{"time": 1757415857, "type": "recv", "message_id": "1968184089", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"艾希连德德凛克，自称是造世的神明哦?\"她整了整身形，有些心不在焉的开口，\"他是唯一的存在，只是一分为三，坚称作为经济泰坦的自己将重回于一，直到永恒。\""}
{"time": 1757416033, "type": "recv", "message_id": "1085564712", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“这儿应该没人信这个吧”"}
{"time": 1757416077, "type": "recv", "message_id": "933716887", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好自恋啊...”"}
{"time": 1757416112, "type": "recv", "message_id": "531420532", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我会说君权神授是常见伎俩）"}
{"time": 1757416117, "type": "recv", "message_id": "1602453378", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（但是伊芙16岁，算了）"}
{"time": 1757416139, "type": "recv", "message_id": "430208040", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好吧，其实他的话就最为关键的漏洞。\"她的手指敲着桌子，等待你们的回答"}
{"time": 1757416226, "type": "recv", "message_id": "1447878151", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“显然。在他一分为三以前，永恒的神明在哪？”"}
{"time": 1757416452, "type": "recv", "message_id": "1979586304", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"当然，另外...你们有没有见过其他的泰坦?\"她挂着笑，面具下的眼瞳微眯"}
{"time": 1757416469, "type": "recv", "message_id": "1376033250", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯，剩下两个都见过了”"}
{"time": 1757416510, "type": "recv", "message_id": "50324219", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那就很容易想清楚了吧？\"目光带着期待"}
{"time": 1757416545, "type": "recv", "message_id": "1524261223", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“哇哦，变性人”"}
{"time": 1757416749, "type": "recv", "message_id": "220055206", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...\"她敲桌子的手停了下来，\"正确说法应该是，因为有人升华泰坦的实例吧？\""}
{"time": 1757416793, "type": "recv", "message_id": "616918314", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我不知道啊.jpg）"}
{"time": 1757416830, "type": "recv", "message_id": "975889082", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“然后承受不住力量裂成三份了？”"}
{"time": 1757416840, "type": "recv", "message_id": "1271750592", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（？）"}
