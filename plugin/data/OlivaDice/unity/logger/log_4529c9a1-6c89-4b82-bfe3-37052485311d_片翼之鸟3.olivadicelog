{"time": 1760410808, "type": "recv", "message_id": "1932166469", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=1646747339]（去哪找）"}
{"time": 1760410827, "type": "recv", "message_id": "1455961136", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(感应去吧)"}
{"time": 1760410869, "type": "recv", "message_id": "1971387814", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1084690521]\"我的话...会进去。\"她双手扶着帽子，\"但是诺诺还有更在乎的人吧?西里斯姐姐还在这里。\""}
{"time": 1760411166, "type": "recv", "message_id": "192777421", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我....”有些犹豫“但是之前已经和姐姐说好了...我会先陪着你的，西莉丝姐姐暂时还没什么事情，我不会抛弃姐姐的....”"}
