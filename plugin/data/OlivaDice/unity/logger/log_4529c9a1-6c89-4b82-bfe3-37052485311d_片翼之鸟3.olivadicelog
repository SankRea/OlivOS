{"time": 1760011186, "type": "recv", "message_id": "1394422212", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“对不起....主人，我不会在做背叛你的事情了...”"}
{"time": 1760011214, "type": "recv", "message_id": "1338082422", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（真的吗）"}
