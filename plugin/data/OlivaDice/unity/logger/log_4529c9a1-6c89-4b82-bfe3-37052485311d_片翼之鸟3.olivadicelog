{"time": 1759993961, "type": "recv", "message_id": "1178789124", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...\"黑暗中传出意料之外的声响，一扇房门打开，虽然里面也没有开灯，但传出了虽然淡却不容忽视的血腥气，\"带着斑比要的血回来了吗？\"声音慵懒"}
{"time": 1759994011, "type": "recv", "message_id": "327269319", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哈哈...在给我一点点时间，斑比酱，12点之前我一定会带回来的...”尴尬的笑笑"}
{"time": 1759994144, "type": "recv", "message_id": "1621698466", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没有?\"声音陡然提高随后又低了下来，\"这里不是有几个现成的?\""}
{"time": 1759994169, "type": "recv", "message_id": "1324572254", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“她们都是普通人...血很一般的..”"}
{"time": 1759994196, "type": "recv", "message_id": "1785249951", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“有个比较特殊的，但她的血斑比酱已经尝过了”"}
{"time": 1759994226, "type": "recv", "message_id": "1052857112", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“斑比酱要是饿了的话，先吸点我的凑合凑合吧...”"}
{"time": 1759994340, "type": "recv", "message_id": "1585762360", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(等等龙神react)"}
