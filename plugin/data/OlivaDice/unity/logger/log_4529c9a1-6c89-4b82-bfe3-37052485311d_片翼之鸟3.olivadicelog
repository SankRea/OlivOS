{"time": 1759304752, "type": "recv", "message_id": "1388661613", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“？西莉丝姐姐在装睡吗”"}
{"time": 1759305165, "type": "recv", "message_id": "904048942", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=861648506]（什么时候回来宝宝（）"}
