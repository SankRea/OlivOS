{"time": 1760011218, "type": "recv", "message_id": "686829742", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"就到这里可以吗？\"突兀的声音响起，不属于你也不属于她"}
{"time": 1760011296, "type": "recv", "message_id": "2087674123", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "看看是谁..."}
{"time": 1760011341, "type": "recv", "message_id": "362263960", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "当然是诺亚，她站在了你们身边"}
{"time": 1760011425, "type": "recv", "message_id": "240071888", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "虽然很感激诺亚帮自己说话，不过看看斑比酱怎么说"}
{"time": 1760011755, "type": "recv", "message_id": "743674847", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哦...\"斑比看了一眼旁边的诺亚，收回了手，\"我也觉得到这里就可以了，没想到人偶比人更有眼力见。\""}
{"time": 1760011885, "type": "recv", "message_id": "394377205", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“斑比酱....我有什么可以帮你做的吗...”"}
{"time": 1760011997, "type": "recv", "message_id": "549807959", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好啊。\"她稍微后退了一些，\"去把刚刚出去的人的血，我没有尝过的那个，带过来。\""}
{"time": 1760012168, "type": "recv", "message_id": "2112539448", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哎？好....好的..”想要站起来，但感觉浑身好痛，试图起身，却直接瘫倒在地上"}
{"time": 1760012313, "type": "recv", "message_id": "412820086", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "只能朝门口爬了，虽然有些丢脸，但是是唯一的方法了"}
{"time": 1760012546, "type": "recv", "message_id": "722287125", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我的血会修复你的身体。\"她冷冷抛下这句话，\"人偶，你带她出去，刚刚的事，给我告诉他们。\""}
{"time": 1760012615, "type": "recv", "message_id": "2014546877", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“对不起...”躺在地上稍微缓一下"}
{"time": 1760012754, "type": "recv", "message_id": "678112643", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（怎么会有每回合往牌库里塞一张无中生有的这么变态的牌）"}
{"time": 1760012773, "type": "recv", "message_id": "1530011470", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（什么牌？）"}
