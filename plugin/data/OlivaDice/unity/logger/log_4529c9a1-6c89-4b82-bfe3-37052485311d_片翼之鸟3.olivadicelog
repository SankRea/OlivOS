{"time": 1759305789, "type": "recv", "message_id": "1468565389", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1388661613]\"...\"她伸手压着你的脸颊，\"别闹了诺诺\""}
{"time": 1759305807, "type": "recv", "message_id": "1126862149", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "话语带着些温热，轻轻喘息"}
{"time": 1759305938, "type": "recv", "message_id": "1396470938", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "不好意思的笑了笑“西莉丝姐姐困的话，我就不打扰你了”"}
{"time": 1759306583, "type": "recv", "message_id": "1231434641", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"你都打扰过了。\"她推开你，\"好热。\""}
{"time": 1759306607, "type": "recv", "message_id": "1934569397", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“抱歉抱歉...”"}
{"time": 1759306968, "type": "recv", "message_id": "422048086", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我先走了..西莉丝姐姐继续睡吧”"}
{"time": 1759307294, "type": "recv", "message_id": "1404133369", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"被你这么一弄，怎么睡得着。\"她叹口气，坐起来，\"找我做什么?\""}
{"time": 1759307335, "type": "recv", "message_id": "732204440", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“只是有点想西莉丝姐姐了”"}
{"time": 1759307409, "type": "recv", "message_id": "897090156", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“而且我想要出一趟门，来告诉一下西莉丝姐姐”"}
{"time": 1759308335, "type": "recv", "message_id": "1087200209", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=897090156]\"出门?诺诺要去哪？\""}
{"time": 1759308660, "type": "recv", "message_id": "993998171", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“出去找坏人吧...我得去收集点血”"}
{"time": 1759308760, "type": "recv", "message_id": "2005452885", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...只是收集血的话...\"西里斯犹豫了一会，伸出手，\"用我的吧?\""}
{"time": 1759308796, "type": "recv", "message_id": "1328675439", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不行....一直都拜托西莉丝姐姐的话，西莉丝姐姐的身体会撑不住的...”"}
{"time": 1759309421, "type": "recv", "message_id": "1497068697", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“而且..而且..”西莉丝姐姐的血只有我可以喝，不过后半句只是在心中想想“没什么..”"}
{"time": 1759309910, "type": "recv", "message_id": "428793514", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哦...不要一个人出门。\"她收回手，\"嗯...\""}
{"time": 1759310179, "type": "recv", "message_id": "528548452", "deleted": true, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好吧..西莉丝姐姐可以陪我呢”"}
{"time": 1759310184, "type": "recv", "message_id": "985014799", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好吧..西莉丝姐姐可以陪我吗”"}
{"time": 1759310393, "type": "recv", "message_id": "173743685", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"虽然总觉得在这个时间点不应该出门。\"她看着外面的日光，\"诺诺可以吗？\""}
{"time": 1759310424, "type": "recv", "message_id": "767398719", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“去一些巷子里应该没事...”"}
