{"time": 1758646135, "type": "recv", "message_id": "816789483", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1976059467]\"诶...不太好吧...\""}
