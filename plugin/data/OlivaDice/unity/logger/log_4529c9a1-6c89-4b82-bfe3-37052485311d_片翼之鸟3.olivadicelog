{"time": 1759142552, "type": "recv", "message_id": "273114949", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哦～\"狼面具的吻部对着你，\"可以啊，那现在跳下去吧？\""}
{"time": 1759142584, "type": "recv", "message_id": "8059006", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……那你等会”"}
{"time": 1759142614, "type": "recv", "message_id": "1411927670", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“这个戒指借我用下，虽然可能没什么大用处，但总归还是有比较好”"}
{"time": 1759142618, "type": "recv", "message_id": "929913730", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*把戒指又扯下来，塞到她手里"}
