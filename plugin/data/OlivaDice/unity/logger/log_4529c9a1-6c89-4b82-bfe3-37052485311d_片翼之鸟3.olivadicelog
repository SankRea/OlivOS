{"time": 1759686491, "type": "recv", "message_id": "761364694", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "(感觉我碰到好多坏女人（bushi)"}
