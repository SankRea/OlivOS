{"time": 1759078720, "type": "recv", "message_id": "1551038507", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "试探性的砍一剑，没想到直接被弹回来了"}
{"time": 1759078731, "type": "recv", "message_id": "2102594142", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“还挺坚韧...”"}
