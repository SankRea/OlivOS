{"time": 1757606611, "type": "recv", "message_id": "1901535650", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（那还有什么好说的）"}
{"time": 1757606628, "type": "recv", "message_id": "670754714", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我是要重击确认吗）"}
{"time": 1757606730, "type": "recv", "message_id": "1805136432", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。r3#d20"}
