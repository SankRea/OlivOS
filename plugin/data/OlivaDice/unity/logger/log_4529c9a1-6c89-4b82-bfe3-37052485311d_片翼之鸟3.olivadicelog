{"time": 1757886848, "type": "recv", "message_id": "2146519033", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "于是张开嘴，不再抵抗"}
