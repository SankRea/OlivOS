{"time": 1756836250, "type": "recv", "message_id": "610102923", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你可以来应聘亲卫，说不定能克死我呢）"}
