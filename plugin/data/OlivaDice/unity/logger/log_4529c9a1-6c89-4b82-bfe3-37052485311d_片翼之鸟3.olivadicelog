{"time": 1759176414, "type": "recv", "message_id": "1040778792", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "两边同时放血"}
{"time": 1759176436, "type": "recv", "message_id": "1440751027", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "等会回去，一定要找伊芙狠狠补一口"}
