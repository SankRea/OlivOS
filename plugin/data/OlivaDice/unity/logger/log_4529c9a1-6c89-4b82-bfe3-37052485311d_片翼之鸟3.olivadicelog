{"time": 1757500209, "type": "recv", "message_id": "9970714", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（龙神应该想打的是 是你吧）"}
