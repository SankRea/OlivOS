{"time": 1756837880, "type": "recv", "message_id": "466891637", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（说起来中环难道只有这里能花钱吗（）"}
