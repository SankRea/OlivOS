{"time": 1756406784, "type": "recv", "message_id": "1249397641", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*看看/摸摸"}
{"time": 1756406790, "type": "recv", "message_id": "504586752", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "上书，\"唯有无罪者方可通过...\"\n下书，\"入此门者，当摒弃一切希望\""}
{"time": 1756406810, "type": "recv", "message_id": "1065126081", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（好经典的两句话）"}
