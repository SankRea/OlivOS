{"time": 1757338967, "type": "recv", "message_id": "1894813770", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "松开了准备拔剑的手"}
{"time": 1757339040, "type": "recv", "message_id": "1823924037", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*当然没有打算留手“这又不是比试……这是……杀人，哪有说停就停？”"}
{"time": 1757339095, "type": "recv", "message_id": "1307620394", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“和你拼了”右手重新放到剑上，反正看不见，准备拔剑朝身前乱捅"}
