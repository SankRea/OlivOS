{"time": 1757898823, "type": "recv", "message_id": "804837810", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "(那我还可以说都怪你不想吃饭（)"}
