{"time": 1756408333, "type": "recv", "message_id": "360741140", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "摇摇头，默默跟上她"}
