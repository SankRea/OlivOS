{"time": 1758301316, "type": "recv", "message_id": "555634808", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=104505892]\"决定了么？\""}
