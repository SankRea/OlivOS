{"time": 1757565858, "type": "recv", "message_id": "637869071", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "挥出帅气强力的一剑"}
{"time": 1757566089, "type": "recv", "message_id": "749791911", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(还在挥还在挥)"}
