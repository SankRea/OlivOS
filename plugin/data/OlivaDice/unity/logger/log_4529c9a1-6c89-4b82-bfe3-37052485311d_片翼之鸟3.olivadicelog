{"time": 1757203941, "type": "recv", "message_id": "1309341585", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（不知道为啥我剑魔3星了）"}
{"time": 1757203960, "type": "recv", "message_id": "624402890", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“会不会这画把你的灵魂吸了一部分”"}
{"time": 1757204068, "type": "recv", "message_id": "1956203203", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“诶...灵魂吗？”粉毛抱着脑袋，“那我有点想试试..诶？”"}
{"time": 1757204099, "type": "recv", "message_id": "841387355", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“？想试试是何意，这看起来很危险吧，艾璃西雅姐姐”"}
