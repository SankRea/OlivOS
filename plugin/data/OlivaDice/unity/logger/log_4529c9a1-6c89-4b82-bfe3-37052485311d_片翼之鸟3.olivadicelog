{"time": 1757306304, "type": "recv", "message_id": "686917410", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你看，嘴从来没软过）"}
