{"time": 1759135080, "type": "recv", "message_id": "1812144019", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那是什么）"}
