{"time": 1756881812, "type": "recv", "message_id": "287695598", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（胡辣汤里加面条太邪恶了）"}
