{"time": 1757499098, "type": "recv", "message_id": "906827549", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（刚刚发了什么）"}
