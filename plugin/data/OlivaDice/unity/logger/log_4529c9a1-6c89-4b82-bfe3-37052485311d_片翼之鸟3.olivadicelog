{"time": 1759989011, "type": "recv", "message_id": "901488568", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我真不记得了）"}
{"time": 1759989012, "type": "recv", "message_id": "535022235", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“等下我在门口等你吧，我有点不敢见她”"}
{"time": 1759989016, "type": "recv", "message_id": "1869745515", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（是斑比）"}
{"time": 1759989024, "type": "recv", "message_id": "1810356170", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（厉害）"}
{"time": 1759989199, "type": "recv", "message_id": "450021801", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“你还背着妃花呢”"}
{"time": 1759989224, "type": "recv", "message_id": "1222017954", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“额，好吧...你说的对，我还是跟着你一起吧”"}
{"time": 1759989250, "type": "recv", "message_id": "472243397", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"不敢见?\"爱璃西雅走在最后面，看见房间门脚步停了下来，\"呃...我好像也知道了。\""}
{"time": 1759989353, "type": "recv", "message_id": "304494168", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“不知道你们在说什么……也不一定在吧”*刷卡开门"}
{"time": 1759989387, "type": "recv", "message_id": "775328481", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "有些发抖，现在应该还不算晚上吧，自己应该还有时间吧，大概吧..."}
{"time": 1759989405, "type": "recv", "message_id": "202770853", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "跟着伊芙进去"}
{"time": 1759989456, "type": "recv", "message_id": "1850030540", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=304494168]房间被你打开，里面没有开灯，漆黑一片。"}
{"time": 1759989485, "type": "recv", "message_id": "948496280", "deleted": true, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "爱璃西雅拉着诺诺的手臂，\"...\"你注意到她的手有些"}
{"time": 1759989489, "type": "recv", "message_id": "1271087103", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "爱璃西雅拉着诺诺的手臂，\"...\"你注意到她的手有些抖"}
{"time": 1759989537, "type": "recv", "message_id": "412592562", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“爱璃西雅..姐姐别怕..”但其实自己也有点害怕就是了“建议别开灯”"}
{"time": 1759989648, "type": "recv", "message_id": "1247817958", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“？为什么。算了……诺亚，你在吗？”*用说话的音量呼唤"}
{"time": 1759989760, "type": "recv", "message_id": "898297055", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "角落里传来衣物窸窣的声音，一双紫色结晶般的瞳孔在无光的室内也显出微微的回光，\"...\"人偶站起身"}
{"time": 1759989961, "type": "recv", "message_id": "1017297758", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“是我，你怎么到这里来了？明明早上还说要等我们回来……”*朝着微微发亮的眼睛走去"}
{"time": 1759990231, "type": "recv", "message_id": "320198629", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...\"你们看见她在黑暗中轻轻地摇头，\"职责所在...只要房间里有客人...诺亚...必须待在这里。\""}
{"time": 1759990379, "type": "recv", "message_id": "922341405", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“啊……好吧。之后我应该也住这边了。不过那个不急……来看看妃花小姐？”*指了指诺维拉背上的人"}
{"time": 1759990436, "type": "recv", "message_id": "1625096514", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哎，你要住这边吗？”如果斑比能直接把伊芙吸死的话，是不是也算自己复仇成功了"}
{"time": 1759990656, "type": "recv", "message_id": "792991955", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "诺亚走上前，紫色的水晶在黑暗中盯着诺诺的脸上看了几秒之后抬上去看向妃花，\"...当时谢谢你。\"\n\"诶...\"妃花惊了一下，\"没什么，和妃花没关系。\""}
{"time": 1759990764, "type": "recv", "message_id": "727883463", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"靠我一个人，肯定没办法从那种地方出去。\"诺亚的声音低而平稳，有些刻意躲着什么，\"伊芙小姐应该也知道。\""}
{"time": 1759990943, "type": "recv", "message_id": "1543446246", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“当时……”*小声念叨，想来那时候的顺利果然是别有隐情。“倒是我给你们添麻烦了。不过……”*凑上去轻轻抱住诺亚“我知道这样有点奇怪，但是你没事，太好了”"}
{"time": 1759991100, "type": "recv", "message_id": "44573756", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1543446246]\"...\"熟悉的味道钻入你的鼻尖，没来由安下心，\"...\"在这种时刻她没开口说话，手臂轻轻摇晃了一下，随后下定决心轻轻抱住你"}
{"time": 1759991211, "type": "recv", "message_id": "1743901359", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "有种怪怪的感觉，明明是我先认识的....不过现在也不是想这种事的时候，在这里每多呆一s,都害怕斑比会出现"}
{"time": 1759991221, "type": "recv", "message_id": "10854633", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“要不我们换个地方聊？”"}
{"time": 1759991252, "type": "recv", "message_id": "1393080365", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（哇还有ntr）"}
{"time": 1759991300, "type": "recv", "message_id": "1122812119", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（骑个车）"}
{"time": 1759991750, "type": "recv", "message_id": "668238964", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=10854633]*叹口气，松开诺亚。那时候的事之后再聊吧“嗯……我陪妃花下去转转。诺亚知道哪里能弄到轮椅吗？看得出来，她腿脚现在不太利索”"}
{"time": 1759992298, "type": "recv", "message_id": "640596981", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...可以找前台。\"诺亚后退了几步，\"除开家居人偶之外，大部分事情都可以找酒店的前台商量。\""}
{"time": 1759992400, "type": "recv", "message_id": "822569848", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯，谢谢你。这里应该还有空房间吧？”"}
{"time": 1759992417, "type": "recv", "message_id": "595527053", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“今晚，我应该就住这边了”"}
{"time": 1759992734, "type": "recv", "message_id": "1339434163", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“还有一间。”诺亚点头，“我不能陪着几位。”她退到之前的角落，“不过我可以在这里等着你们回来。”"}
{"time": 1759992866, "type": "recv", "message_id": "994221089", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯嗯”*点点头，不过多少觉得有些遗憾。“晚点见”"}
{"time": 1759993025, "type": "recv", "message_id": "659999184", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...\"她重新闭上了眼，黑暗中落针可闻"}
{"time": 1759993285, "type": "recv", "message_id": "1779676368", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那我们快点离开吧...”"}
