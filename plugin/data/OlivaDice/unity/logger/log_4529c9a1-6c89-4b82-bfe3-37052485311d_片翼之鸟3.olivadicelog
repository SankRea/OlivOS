{"time": 1757479270, "type": "recv", "message_id": "797207412", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我刚想说也不像啊）"}
