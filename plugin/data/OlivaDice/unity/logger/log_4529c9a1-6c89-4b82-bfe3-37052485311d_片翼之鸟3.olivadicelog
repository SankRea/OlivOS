{"time": 1759984003, "type": "recv", "message_id": "1872096225", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“emmm....确实是这么回事吧”"}
