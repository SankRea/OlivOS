{"time": 1757103617, "type": "recv", "message_id": "123250644", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（还行）"}
{"time": 1757103659, "type": "recv", "message_id": "1273455375", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“晚上好……”*倒也不催促，等她习惯身体的运作“刚睡醒？”"}
{"time": 1757103660, "type": "recv", "message_id": "815351003", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好香....你在干什么”有些警惕，之前有这个人用粉末攻击人的印象"}
{"time": 1757103725, "type": "recv", "message_id": "2145757234", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。rd20"}
