{"time": 1760025662, "type": "recv", "message_id": "542107771", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"希望是这样。\""}
{"time": 1760025691, "type": "recv", "message_id": "1378821662", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我会努力让斑比酱满意的.”"}
{"time": 1760025699, "type": "recv", "message_id": "596209561", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "诺亚带着你出了门"}
{"time": 1760025841, "type": "recv", "message_id": "6750294", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“抱歉，让诺亚看见了这么丢人的一幕....”"}
{"time": 1760025921, "type": "recv", "message_id": "1119690", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没事，不是第一次。\"她低头看了看你的脸，出门看见了走廊上站着的三人。"}
{"time": 1760025969, "type": "recv", "message_id": "160073180", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"听从客人的吩咐，我把她带了出来。不过...请讲吧，诺薇拉小姐，你有不得不说的事吧？\""}
{"time": 1760026045, "type": "recv", "message_id": "1692939279", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“妃花姐姐...可以给我一点点你的血吗，就一点点”"}
{"time": 1760026102, "type": "recv", "message_id": "1943945403", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=1692939279]虽然有些于心不忍说出这些话 但更不敢违抗斑比的命令"}
{"time": 1760026161, "type": "recv", "message_id": "599330771", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……”*再用左眼看看妃花的状态"}
{"time": 1760026381, "type": "recv", "message_id": "1445762425", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "左腿上依然盘踞着黑漆漆的东西，其他地方倒是没什么问题，不过看上去还是不算有元气"}
{"time": 1760026399, "type": "recv", "message_id": "1682044443", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我知道这个请求很冒昧...妃花小姐有什么想要的吗，我可以想办法帮你”"}
{"time": 1760026414, "type": "recv", "message_id": "1719796506", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“一点点？像我先前那种量的话，我觉得不算一点点。”"}
{"time": 1760026483, "type": "recv", "message_id": "745999527", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“用不了那么多...”"}
{"time": 1760026496, "type": "recv", "message_id": "1720097181", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“就像献一次血那么多吧...”"}
{"time": 1760026518, "type": "recv", "message_id": "98747620", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（？）"}
{"time": 1760026543, "type": "recv", "message_id": "896218198", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（这时代有血库吗）"}
{"time": 1760026558, "type": "recv", "message_id": "719666222", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我...\"妃花自己有些拿不定主意，看向伊芙，在场的其他人也没有说话。"}
{"time": 1760026561, "type": "recv", "message_id": "1986210619", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(大概没吧)"}
{"time": 1760026573, "type": "recv", "message_id": "644705295", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "(好吧)"}
{"time": 1760026621, "type": "recv", "message_id": "568164313", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“大概半杯水的量就可以了...”"}
{"time": 1760026650, "type": "recv", "message_id": "1926025845", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“拜托你了妃花小姐...我真的没办法违抗斑比大人”"}
{"time": 1760026758, "type": "recv", "message_id": "353391084", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呃...\""}
{"time": 1760026829, "type": "recv", "message_id": "109159896", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“柯艾特倒是给我留了些补品……”"}
{"time": 1760026891, "type": "recv", "message_id": "1832693193", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“诺薇菈在救援中贡献了不少，我不反对”"}
{"time": 1760026991, "type": "recv", "message_id": "1678555715", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那...好吧。\"妃花伸出手，\"要轻一点...\""}
{"time": 1760027057, "type": "recv", "message_id": "823366053", "deleted": true, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“谢谢..谢谢..诺亚，可以帮忙找个杯子吗”"}
{"time": 1760027082, "type": "recv", "message_id": "68083027", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(她现在抱着你)"}
{"time": 1760027113, "type": "recv", "message_id": "1381050800", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“谢谢..谢谢..艾璃西雅姐姐，可以帮忙找个杯子吗”"}
{"time": 1760027282, "type": "recv", "message_id": "2073969992", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好吧。\"爱璃西雅回房间取了一个新的杯子，递了过来"}
{"time": 1760027306, "type": "recv", "message_id": "908610573", "deleted": true, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我会轻点的..妃花姐姐靠近一点”吧"}
{"time": 1760027354, "type": "recv", "message_id": "17175217", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我会轻点的..妃花姐姐把手臂伸过来”吧"}
{"time": 1760027545, "type": "recv", "message_id": "266028093", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "她伸出自己的手，“唔...”"}
