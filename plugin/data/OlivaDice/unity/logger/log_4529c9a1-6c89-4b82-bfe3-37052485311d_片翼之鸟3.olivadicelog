{"time": 1756683240, "type": "recv", "message_id": "1013089498", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "失重感仍在，不过在逐渐减弱"}
{"time": 1756683309, "type": "recv", "message_id": "32200768", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*慢慢调整姿态，感觉即将落地，活动一下被风吹麻木的面部肌肉，打算等对方先开口"}
