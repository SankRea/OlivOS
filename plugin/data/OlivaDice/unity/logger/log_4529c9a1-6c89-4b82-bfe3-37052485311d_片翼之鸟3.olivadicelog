{"time": 1756282061, "type": "recv", "message_id": "1142782120", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1181687703]\"诶，嘛，不感兴趣就算了。\"她也没多说什么，\"反正...迟早。这个空白，我暂时不打算填，你既然签了，自然也知道这代表着什么吧？\""}
{"time": 1756282101, "type": "recv", "message_id": "700323120", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1344495684]里榭娜，是谁来着?"}
{"time": 1756282122, "type": "recv", "message_id": "477146722", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（这个也忘记了？）"}
{"time": 1756282160, "type": "recv", "message_id": "125750983", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "看看外面天色"}
{"time": 1756282228, "type": "recv", "message_id": "430816463", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "半下午的样子"}
{"time": 1756282270, "type": "recv", "message_id": "2082298970", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……听起来比卖身还糟些”*蜷缩起来"}
{"time": 1756282274, "type": "recv", "message_id": "937456553", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“师父怎么还不给我解绑呢..被绑着好难受”"}
{"time": 1756282297, "type": "recv", "message_id": "1764861809", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“师父...露露....”喊几声"}
{"time": 1756282538, "type": "recv", "message_id": "970085035", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "大概再过了一会，蜜诺走进房间，身后跟着莉夏。\"你是说...这孩子被控制了？\""}
{"time": 1756282615, "type": "recv", "message_id": "1286800769", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=2082298970]\"无所谓，反正...你欠的我多了。\"她的声音懒洋洋的，\"但既然空白契约在我手上...我就可以让你永远不能复活伊莉丝哦?\""}
{"time": 1756282622, "type": "recv", "message_id": "2001552190", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我感觉我现在蛮清醒的...”"}
{"time": 1756282820, "type": "recv", "message_id": "1903101322", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=2001552190]\"...我来看看吧。\"蜜诺的手里出现一摊散发着轻灵气息的液体，她将液体拍在你的脑袋上，你顿时感觉浑身轻飘飘的...\"我问，你答...\"不能撒谎...你不能撒谎"}
{"time": 1756282848, "type": "recv", "message_id": "1382854013", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯....”"}
{"time": 1756282875, "type": "recv", "message_id": "778366185", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“蜜姆姐姐问吧，我肯定知无不言”"}
{"time": 1756283003, "type": "recv", "message_id": "1535290201", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"今天，和西里斯分开之后，做了什么\""}
{"time": 1756283043, "type": "recv", "message_id": "1837494935", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我去找了师父取剑，然后师父让我去学院逛了逛”"}
{"time": 1756283117, "type": "recv", "message_id": "1619861457", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我遇到了艾洛温家的大小姐，想要找她复仇，被艾莲娜教授阻止了...艾莲娜教授给我讲了一些道理...”"}
{"time": 1756283158, "type": "recv", "message_id": "1403922674", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "她一边听着一边记录，\"继续\""}
{"time": 1756283158, "type": "recv", "message_id": "1537615983", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“然后我遇到了塑能系的学生艾璃西雅和她的姐姐....”"}
{"time": 1756283203, "type": "recv", "message_id": "2130973088", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“在之后我想着在中环巡逻，然后....然后就不记得了，在醒来就在这里了”"}
{"time": 1756283235, "type": "recv", "message_id": "2040705243", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1286800769]@安 “你……”瞳孔缩起来，跌跌撞撞地起身，踉跄着走进她“不……不许……不行！”但挫败感还未散去，在这个人面前，自己似乎……总是反抗不了，最开始就不该和她接触的。到了现在，自然也没有谈判的筹码“不……不要，求……求求你……”身体失衡，扑通一声跪下来“我什么都愿意做，不要……”"}
{"time": 1756283239, "type": "recv", "message_id": "1527858228", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（哎，原来是）"}
{"time": 1756283244, "type": "recv", "message_id": "2004037626", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（哦内该，哇达西）"}
{"time": 1756283539, "type": "recv", "message_id": "1675338920", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1537615983]\"...\"她皱着眉，\"这里发生了什么？\""}
{"time": 1756283631, "type": "recv", "message_id": "1058428792", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“emmm，我在塑能系教室外闲逛，碰到了因为等朋友迟到被罚站的艾璃西雅姐姐，然后我就安慰她...她就带我去见了见她的姐姐艾尔”"}
{"time": 1756283665, "type": "recv", "message_id": "1065301861", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“艾尔前辈还带我去看了她的花园，不过好像来了什么不速之客，但还是被艾尔前辈赶跑了”"}
{"time": 1756283731, "type": "recv", "message_id": "531084483", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“之后艾璃西雅想帮艾尔前辈，但被拒绝，我帮忙说了几句话，艾尔前辈把我们都赶出去了...然后艾璃西雅姐姐就回学校了，我因为参观的原因中午不能进去了，就一个人开始闲逛了..”"}
{"time": 1756283789, "type": "recv", "message_id": "2048110069", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“然后我看到了一个叫作收敛办事厅的地方...然后”试图回忆起接下来发生了什么"}
{"time": 1756284089, "type": "recv", "message_id": "831636214", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"她看着你"}
{"time": 1756284095, "type": "recv", "message_id": "1701614432", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那边怎么了？\""}
{"time": 1756284123, "type": "recv", "message_id": "414481122", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（只是不记得里谢娜）"}
{"time": 1756284123, "type": "recv", "message_id": "2015027829", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好像有个坏人.....”试图回忆起坏人的样子"}
{"time": 1756284127, "type": "recv", "message_id": "1766480242", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（不是还有个人吗）"}
{"time": 1756284163, "type": "recv", "message_id": "1590470542", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好像跟当时进城时候盯着我的是一个人....”"}
{"time": 1756284207, "type": "recv", "message_id": "2017719991", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“她好像自称叫吉尔内丽莎”"}
{"time": 1756284323, "type": "recv", "message_id": "927118191", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（主要是我不太清楚那边的事我记得多少）"}
{"time": 1756284334, "type": "recv", "message_id": "1727189133", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=2040705243]\"嗯?我还以为，小伊芙面对我的时候总是上风呢\""}
{"time": 1756284644, "type": "recv", "message_id": "1925700504", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*不知道说什么好，但显然不敢抬头看她，只是拽着她的袖子"}
{"time": 1756284687, "type": "recv", "message_id": "1351928788", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=2017719991]\"我知道了，这个情况...\"她收回手，\"你的记忆被篡改"}
{"time": 1756284706, "type": "recv", "message_id": "1418883989", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“啊？”"}
{"time": 1756284884, "type": "recv", "message_id": "1774211550", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不会吧... 她改了多少”"}
{"time": 1756285339, "type": "recv", "message_id": "2003315109", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1925700504]\"好啦，我就暂时留着这个，小伊芙也不用担心啦。\"笑了笑，\"以后要怎么对我呢？\""}
{"time": 1756285592, "type": "recv", "message_id": "1018811777", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1774211550]\"还挺多，从你见到她之后，都不在我的预料之中。\"她摇摇头，\"你被做了什么，但是现在影响被抹消掉了\""}
{"time": 1756285615, "type": "recv", "message_id": "63218802", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……”该示弱吗？能示弱吗？如果就此言听计从……在那个不知道会不会到来的结果真的展露之前，自己还会失去多少东西？"}
{"time": 1756285631, "type": "recv", "message_id": "1219465488", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那怎么办....还是继续把我绑起来吧..”"}
{"time": 1756285636, "type": "recv", "message_id": "503590723", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我不想伤害大家”"}
{"time": 1756285919, "type": "recv", "message_id": "1292358325", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“对了...有一件事..我可以只给师父说吗...”"}
{"time": 1756286200, "type": "recv", "message_id": "184878326", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=63218802]她看着你，等待你的回合"}
{"time": 1756286358, "type": "recv", "message_id": "553043881", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(回答)"}
{"time": 1756286366, "type": "recv", "message_id": "918428608", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1292358325]\"说吧。\""}
{"time": 1756286371, "type": "recv", "message_id": "1920644264", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "莉夏把耳朵凑过来"}
{"time": 1756286517, "type": "recv", "message_id": "1381092425", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=63218802]“……抱歉，如你所见……”*咬着嘴唇，努力站起来“I'm a bad girl，总是出尔反尔、忘恩负义、反复无常、朝三暮四，很快就要朝生暮死了。在我死前……我还要是我。你要是不许我复活姐姐……我就去找别的人交易。你要是连这也不许……我会拉上你垫背的”"}
{"time": 1756286622, "type": "recv", "message_id": "1163053579", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“师父...我有个非常重要的东西...但是我不记得它是从哪里来的了，我决定把它交给师父处理吧..我相信师父您肯定不会害我的...”指了指那个发箍"}
{"time": 1756286672, "type": "recv", "message_id": "1850081749", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（几乎是不知廉耻了，伊芙怎么这么坏）"}
{"time": 1756287399, "type": "recv", "message_id": "1092105736", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1163053579]\"呃...发箍?那个是什么\""}
{"time": 1756287452, "type": "recv", "message_id": "54644398", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不知道...我只觉得它好像很重要”"}
{"time": 1756287658, "type": "recv", "message_id": "499711183", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1381092425]\"哦呀?你恐怕是小看了空白契约的威力吧？\"她的笑容你有些看不懂，\"我也可以不让你...找其他人哦?\""}
{"time": 1756287725, "type": "recv", "message_id": "625920485", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“反正说到底，也就只能做到一件事……我不会为了这件事做更多让步的”"}
{"time": 1756287972, "type": "recv", "message_id": "1682114312", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哼哼...\"她的声音有些听不清，\"你现在，威胁我吗？\""}
{"time": 1756288138, "type": "recv", "message_id": "80122366", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“怎么会？我哪有那种能力”*眨眨眼“我只是发现，和你相处，不能那么听话而已”"}
{"time": 1756288433, "type": "recv", "message_id": "729034803", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=54644398]\"呃...好的，如果是现在的诺诺的话。\"她拿着发箍，\"蜜姆会在这里照顾你，好好听话。\""}
{"time": 1756288632, "type": "recv", "message_id": "1035905475", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（哎，感觉快拉不住人设了）"}
{"time": 1756288828, "type": "recv", "message_id": "1363744675", "deleted": true, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“师父..我好害怕..那个坏人说要把我变成原来的样子...我不想那样”在莉夏耳边小声的说"}
{"time": 1756289679, "type": "recv", "message_id": "1501051476", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=80122366]\"有点意思...那就先这样吧，小伊芙 ，如果面对我是这种态度...那...\"她停了停，\"我允许哦～"}
{"time": 1756289979, "type": "recv", "message_id": "1425620496", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1363744675](你不是不记得吗)"}
{"time": 1756289996, "type": "recv", "message_id": "60414907", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（那段全不记得了吗）"}
{"time": 1756289997, "type": "recv", "message_id": "295002861", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（好的）"}
{"time": 1756290011, "type": "recv", "message_id": "2019611432", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...我会乖乖听话的，师父”"}
{"time": 1756290069, "type": "recv", "message_id": "147843930", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“差一点我就要良心不安了”*抿了抿嘴“虽说和你做交易不太会亏，但总觉得让人高兴不起来”"}
{"time": 1756290361, "type": "recv", "message_id": "1527809164", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“好了，我得去找炼金学科的资料了”"}
{"time": 1756291080, "type": "recv", "message_id": "2013346809", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1527809164]\"那就尽管威胁我吧。\"她倒是无所谓的语气，\"反正...我的容忍也是有限的，对不对?\""}
{"time": 1756291649, "type": "recv", "message_id": "716213519", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“蜜姆姐姐，还有什么要问的吗...”"}
{"time": 1756291809, "type": "recv", "message_id": "995132282", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*总之，下去去炼金科的图书馆呗"}
{"time": 1756292139, "type": "recv", "message_id": "1131163065", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(摸一会)"}
