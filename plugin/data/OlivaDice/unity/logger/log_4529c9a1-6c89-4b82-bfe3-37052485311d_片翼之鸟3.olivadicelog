{"time": 1758511960, "type": "recv", "message_id": "550405268", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*默默把剩下半粒补品放回去。等把肉餐吃完，就打算扶着墙单脚跳着去楼下"}
