{"time": 1759832260, "type": "recv", "message_id": "1965624325", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我不记得我咬她了啊）"}
{"time": 1759832263, "type": "recv", "message_id": "34694899", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好了，我自愿的。反正也没什么大事。\"她摸摸你的脑袋，\"为什么要道歉?\""}
{"time": 1759832270, "type": "recv", "message_id": "47183554", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我只记得我咬西莉丝了）"}
