{"time": 1756476956, "type": "recv", "message_id": "71996826", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“已经没有了....关心我的人都死了....”"}
