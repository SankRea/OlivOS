{"time": 1756923312, "type": "recv", "message_id": "1553037522", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（死了才知道真不真吧（）"}
{"time": 1756923320, "type": "recv", "message_id": "1027020929", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（应该是蛮真的）"}
