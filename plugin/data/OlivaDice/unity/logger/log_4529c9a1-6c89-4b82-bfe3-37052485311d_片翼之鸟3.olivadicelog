{"time": 1756472658, "type": "recv", "message_id": "1066744405", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(别想了，待会要搜身的)"}
