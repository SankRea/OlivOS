{"time": 1759059589, "type": "recv", "message_id": "2010562392", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不过那些液体是什么，看着好恶心”"}
