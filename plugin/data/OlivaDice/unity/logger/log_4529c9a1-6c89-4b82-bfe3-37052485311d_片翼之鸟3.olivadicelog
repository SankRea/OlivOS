{"time": 1760292446, "type": "recv", "message_id": "108274238", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“也许她的衣服是血做的？等会我也试试”"}
{"time": 1760292476, "type": "recv", "message_id": "1829413370", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（那我的剑怎么拿呢，好麻烦）"}
