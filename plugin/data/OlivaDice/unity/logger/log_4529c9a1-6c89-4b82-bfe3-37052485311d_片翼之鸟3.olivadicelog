{"time": 1756408250, "type": "recv", "message_id": "429403374", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我记得..但你怎么确定她还在那”"}
