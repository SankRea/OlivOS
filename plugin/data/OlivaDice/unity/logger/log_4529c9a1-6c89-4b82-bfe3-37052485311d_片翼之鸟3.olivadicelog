{"time": 1757303157, "type": "recv", "message_id": "824817494", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（粉毛没点什么吗）"}
