{"time": 1756405952, "type": "recv", "message_id": "1600895312", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“中环的收敛办事厅...好像这里有坏人..”"}
{"time": 1756405976, "type": "recv", "message_id": "910866494", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "回想起来还稍微有些头痛“不行，想不起来了...为什么我又会在这里”"}
{"time": 1756406050, "type": "recv", "message_id": "870432001", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……你的武器在那边，西莉丝小姐也在。我们先找到门”*松开她，给她指明方向"}
{"time": 1756406070, "type": "recv", "message_id": "1113315886", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“为什么你要帮我......”"}
{"time": 1756406091, "type": "recv", "message_id": "1862981767", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“？”"}
{"time": 1756406118, "type": "recv", "message_id": "2134266917", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“你为什么会觉得我在帮你？”*站起来，循着墙边找门"}
{"time": 1756406162, "type": "recv", "message_id": "406944612", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "黑色的门和灰白的墙壁格格不入，你很快就摸到它"}
{"time": 1756406183, "type": "recv", "message_id": "1377206951", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "去把西莉丝姐姐背起来“我要找你复仇，刚刚不是很好的永绝后患的机会么...”寻找记忆中门的位置，顺便带上自己的武器“怎么...会是这两把剑..”"}
{"time": 1756406221, "type": "recv", "message_id": "1793965946", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……参谋出现在这里，你还不明白意味着什么吗？”*靠在门上听听外面的动静"}
{"time": 1756406348, "type": "recv", "message_id": "2035203526", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "门的密封性很好，听不清外面的动静"}
{"time": 1756406371, "type": "recv", "message_id": "68215203", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不过...我之后可能不会找你报仇了...等把西莉丝姐姐治好，我也差不多该走了...”"}
{"time": 1756406379, "type": "recv", "message_id": "1748957428", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*那只能看看门上有没有能开门的把手了"}
{"time": 1756406402, "type": "recv", "message_id": "23343298", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "研究一下门锁，能不能用剑直接劈开"}
{"time": 1756406612, "type": "recv", "message_id": "995296779", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "没有门锁这样的东西"}
{"time": 1756406635, "type": "recv", "message_id": "1148816747", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*那……直接推？拉？"}
