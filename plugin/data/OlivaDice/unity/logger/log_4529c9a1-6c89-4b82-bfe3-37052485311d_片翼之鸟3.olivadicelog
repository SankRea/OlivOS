{"time": 1760292044, "type": "recv", "message_id": "1162826265", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=264050843]\"真的吗？\""}
