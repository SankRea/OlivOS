{"time": 1758788668, "type": "recv", "message_id": "1501663086", "deleted": true, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=742789026]“”"}
{"time": 1758788731, "type": "recv", "message_id": "699098484", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=742789026] “……今天倒是早早就能看见你，早上好”"}
{"time": 1758788901, "type": "recv", "message_id": "253126990", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=699098484]\"毕竟今天有事要做，对不对?\"她开口，\"换言之，今天就是所谓的工作日。\""}
{"time": 1758788910, "type": "recv", "message_id": "735924301", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1450909115]无动于衷"}
