{"time": 1756780647, "type": "recv", "message_id": "528839421", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（是那种意思）"}
{"time": 1756780772, "type": "recv", "message_id": "1476868817", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“从来没有离开是什么意思...”"}
{"time": 1756780789, "type": "recv", "message_id": "1405465012", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……从那时候就开始了？”"}
{"time": 1756780816, "type": "recv", "message_id": "839142414", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "(那时候是什么时候？第一次进入中环的时候？)"}
{"time": 1756780841, "type": "recv", "message_id": "40773905", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（是你去吃饭不给钱的时候）"}
{"time": 1756780945, "type": "recv", "message_id": "1515998070", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（对你来说呢，从图书馆出来？）"}
{"time": 1756780963, "type": "recv", "message_id": "2057332390", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我是真的一直在中环）"}
{"time": 1756780990, "type": "recv", "message_id": "1752047038", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“意思是，他们特地把你们，留在中环，还派我去救你们？”"}
{"time": 1756781033, "type": "recv", "message_id": "2014886431", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“那很明白了，最重要的两个问题”"}
{"time": 1756781045, "type": "recv", "message_id": "1593488404", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“为什么是我们？为什么是收敛办事厅？”"}
{"time": 1756781109, "type": "recv", "message_id": "2116593409", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“有没有什么恢复记忆的办法...我之前去过一次那里，但是那里的见闻全部忘记了”"}
{"time": 1756781182, "type": "recv", "message_id": "1095270517", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“...”门内不再传出声响，灰白色的法阵出现在门上，想必连你说的话里面也不会听见了。"}
{"time": 1756781349, "type": "recv", "message_id": "194941932", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“啧……什么时候了，还把一点情报当成宝”*忍着在门上踢一脚的冲动"}
{"time": 1756781505, "type": "recv", "message_id": "1186066930", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（行动吧，free time）"}
{"time": 1756781529, "type": "recv", "message_id": "2023638083", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我想起一件很地狱的事）"}
{"time": 1756781539, "type": "recv", "message_id": "1133329010", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（现在确实可以怀疑西丽丝了.jpg）"}
{"time": 1756781613, "type": "recv", "message_id": "617694128", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“算了……西丽丝小姐知道收敛办事厅的事情吗？”*平复一下心情，理一理头发"}
{"time": 1756781753, "type": "recv", "message_id": "464745933", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我只知道那里是突发事件处理机关。”她抱着手臂，“具体是做什么用的，我也是第一次进去。”"}
{"time": 1756781777, "type": "recv", "message_id": "951719469", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那里管事的人是谁啊”"}
{"time": 1756781871, "type": "recv", "message_id": "222673009", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“听起来和名字好没有关系”"}
{"time": 1756781894, "type": "recv", "message_id": "1705574525", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（说起来天色是？）"}
{"time": 1756781918, "type": "recv", "message_id": "1721889040", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（有一说一，伊芙还是没能睡上觉）不免有些恍惚"}
{"time": 1756782050, "type": "recv", "message_id": "1954864565", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "晨光微熹"}
{"time": 1756782106, "type": "recv", "message_id": "1225191381", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“不行了……我真的好困……”"}
{"time": 1756782185, "type": "recv", "message_id": "357403062", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“你大可直接睡觉....我暂时不会动你的”"}
