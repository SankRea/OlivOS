{"time": 1759125835, "type": "recv", "message_id": "1671772644", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*总之，那就，再榨一榨魔力，注入黄色戒指试试"}
