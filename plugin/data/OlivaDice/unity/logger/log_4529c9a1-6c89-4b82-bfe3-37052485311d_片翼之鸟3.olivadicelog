{"time": 1758988384, "type": "recv", "message_id": "2106097708", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(你觉得他厉害吗)"}
