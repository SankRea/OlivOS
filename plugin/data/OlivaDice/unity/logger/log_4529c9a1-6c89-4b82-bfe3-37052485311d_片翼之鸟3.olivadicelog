{"time": 1757588064, "type": "recv", "message_id": "27342788", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "(龙哥上次和我力量对抗，出了好几个15以上的)"}
