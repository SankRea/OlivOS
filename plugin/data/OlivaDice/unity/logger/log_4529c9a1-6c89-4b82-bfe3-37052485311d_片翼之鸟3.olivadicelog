{"time": 1756407194, "type": "recv", "message_id": "39706778", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "用西莉丝姐姐的手触碰门试试"}
{"time": 1756407211, "type": "recv", "message_id": "1621104631", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（给字刮了也不行吗）"}
