{"time": 1759995153, "type": "recv", "message_id": "1344850906", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "把艾璃西雅和妃花护在身后，至于诺薇菈就不管她了"}
{"time": 1759995299, "type": "recv", "message_id": "49308925", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(?)"}
{"time": 1759995302, "type": "recv", "message_id": "1706290486", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(那是什么画面)"}
{"time": 1759995328, "type": "recv", "message_id": "2018830498", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我两大概是并排站吧）"}
{"time": 1759995338, "type": "recv", "message_id": "1243742556", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我好想将你护至身前）"}
{"time": 1759995403, "type": "recv", "message_id": "709532413", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“斑比酱...斑比大人，再等一会好吗，就一会，11点前我会带着血液回来的...”"}
{"time": 1759995483, "type": "recv", "message_id": "1480488959", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"这里的两人不行?\"你听见起身的声音，\"呵呵...你要替我做决定?\""}
{"time": 1759995523, "type": "recv", "message_id": "1518217755", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“没有没有....我不是那个意思”"}
{"time": 1759995548, "type": "recv", "message_id": "1567105541", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“但是她们两个身体都不是很好...”"}
{"time": 1759996003, "type": "recv", "message_id": "139454135", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那与我，有什么关系?\""}
{"time": 1759996075, "type": "recv", "message_id": "1472891186", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“主人...求你了，我会帮你找其他血液的”"}
{"time": 1759996344, "type": "recv", "message_id": "1678032865", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我说大陆酒店内不能有流血事件（））"}
{"time": 1759996369, "type": "recv", "message_id": "1688441708", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*暂且看她打算整出什么名堂来"}
{"time": 1759996433, "type": "recv", "message_id": "288672474", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"真是...有点不快了。\"她还没有走过来门边"}
{"time": 1759996475, "type": "recv", "message_id": "1544317545", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“对不起..对不起...对不起...”"}
{"time": 1759996571, "type": "recv", "message_id": "1280100427", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（道歉有什么用（）"}
{"time": 1759996601, "type": "recv", "message_id": "1474951584", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（你怎么不能带着剩下两个人直接逃跑）"}
{"time": 1759996646, "type": "recv", "message_id": "1894259278", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（因为人tm在你背上）"}
{"time": 1759996684, "type": "recv", "message_id": "981364120", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（但是我肯定跑不掉的）"}
{"time": 1759996692, "type": "recv", "message_id": "33285763", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（而且真跑的掉吗）"}
{"time": 1759996802, "type": "recv", "message_id": "1705144440", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "慢慢把妃花放下来，小声说道“艾璃西雅姐姐，带着妃花跑，我..想办法...拦住她”"}
{"time": 1759997168, "type": "recv", "message_id": "1384124119", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "室内燃起一盏孤灯，\"...\"你听见她的呼吸，\"我知道你在想什么\""}
{"time": 1759997177, "type": "recv", "message_id": "1826486653", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"你要忤逆我吗？\""}
{"time": 1759997188, "type": "recv", "message_id": "1383549242", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不..不敢...”"}
{"time": 1759997226, "type": "recv", "message_id": "1290107703", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“但是我也不想让斑比酱伤害她们...”"}
{"time": 1759997514, "type": "recv", "message_id": "1475992044", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"说着不敢，却在做着这样的事呢...\"房间里的气息愈加冰冷，\"斑比酱快要改变主意了...你们要不，都死在这里吧？\""}
{"time": 1759997646, "type": "recv", "message_id": "952971248", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“等…等等，这里是夏日酒店。流血事件和伤害他人是被禁止的吧”*眼看火马上就要烧到自己的眉毛，不得不发声"}
{"time": 1759997705, "type": "recv", "message_id": "853244170", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“血……只要血的话……”*皱了皱眉，摸出红色的血晶匕首"}
{"time": 1759997758, "type": "recv", "message_id": "648926531", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“这个，比我的，厉害些……而且无毒”"}
{"time": 1759997906, "type": "recv", "message_id": "1685720417", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...\"暗红色的血液从门后缓缓流出，蔓延到你们脚下停了下来"}
{"time": 1759998044, "type": "recv", "message_id": "902270215", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“别杀她们...”"}
{"time": 1759998105, "type": "recv", "message_id": "473712971", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（电脑qq丢消息了真没绷住）"}
