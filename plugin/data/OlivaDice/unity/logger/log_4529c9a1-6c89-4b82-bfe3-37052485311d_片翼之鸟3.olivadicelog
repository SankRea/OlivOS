{"time": 1757416864, "type": "recv", "message_id": "1850411959", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（什么叫）"}
{"time": 1757416866, "type": "recv", "message_id": "359925621", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（裂了）"}
{"time": 1757416901, "type": "recv", "message_id": "103764719", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“典狱长现在……呃，昨天，应该还不算1.0个泰坦”"}
{"time": 1757417015, "type": "recv", "message_id": "1290845764", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=359925621]（童言无忌）"}
{"time": 1757417067, "type": "recv", "message_id": "1108631385", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“总之，即便不找实证，也没人会当真吧？”"}
{"time": 1757417221, "type": "recv", "message_id": "1833560861", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"是吗？\"她收回手，\"其实，这个理论也有可取之处，并不是伟大的神一分为三，而是本属于什么的东西分成了三份。\""}
{"time": 1757417269, "type": "recv", "message_id": "907610210", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你要我说国吗）"}
{"time": 1757417286, "type": "recv", "message_id": "29383555", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“至少……象征意义都很强”"}
{"time": 1757417496, "type": "recv", "message_id": "1366658890", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“但是我真的只是来参会的……为什么要跟我说这些？”"}
{"time": 1757418045, "type": "recv", "message_id": "1630959647", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"不是你们找上门?\"她嘴角勾起，\"我也算顺水推舟。\""}
{"time": 1757418082, "type": "recv", "message_id": "641570267", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“至少，听起来，三位合一之后会稳定一些”"}
{"time": 1757418350, "type": "recv", "message_id": "1749650444", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好啦，有问题的话，请继续吧。\""}
{"time": 1757418382, "type": "recv", "message_id": "1723522081", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“所以要，怎么做？把三个人手牵手？”*一副地铁老人的表情"}
{"time": 1757418523, "type": "recv", "message_id": "470287479", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“？听起来怪怪的...”"}
{"time": 1757418574, "type": "recv", "message_id": "538001152", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“帮助一个泰坦把剩下两个泰坦击败然后吸收？”"}
{"time": 1757418603, "type": "recv", "message_id": "1918295074", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……对泰坦来说我们帮不帮有什么区别？”"}
{"time": 1757418861, "type": "recv", "message_id": "806294325", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“也是...”"}
{"time": 1757418876, "type": "recv", "message_id": "687027553", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那凭借我们也不能让泰坦手拉手做好朋友吧”"}
{"time": 1757419022, "type": "recv", "message_id": "748917692", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"听起来你们反而更想选边站?\""}
{"time": 1757419141, "type": "recv", "message_id": "345434344", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“他们自己总有一天会会面的，我也没什么拯救世界的爱好……”"}
{"time": 1757419461, "type": "recv", "message_id": "1058288594", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“emmm，感觉完全不知道该怎么办”"}
{"time": 1757419501, "type": "recv", "message_id": "1910349795", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"关于这一点，我不会干涉各位的选择。\"她打了个响指，身后的人偶顺从地拿起桌上的杯子递给她，\"我也只会说更多的内容，我也在猜测之中\""}
{"time": 1757419528, "type": "recv", "message_id": "1828778068", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“哦？”*摸了摸下巴“那你，猜猜我？”"}
{"time": 1757419805, "type": "recv", "message_id": "1085961012", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"你?\"她接过水杯，低头看了一眼杯里，\"立场没那么重要，对吗？\""}
{"time": 1757419890, "type": "recv", "message_id": "1383129499", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我确实看他们不爽。但是我也绝无可能是可靠的队友，可惜”*耸耸肩“我太弱了”"}
{"time": 1757420078, "type": "recv", "message_id": "1102829633", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我们几个人里面应该只有西莉丝姐姐算...”"}
{"time": 1757420226, "type": "recv", "message_id": "1936979847", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“不擅长武斗，他们也不太像能文斗的样子”"}
{"time": 1757420240, "type": "recv", "message_id": "1671266249", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“还不如想想办法怎么进学院……”"}
{"time": 1757420303, "type": "recv", "message_id": "1910089678", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我本身也没有指望你们能帮上忙。\"她起身，\"你们既然想和我谈谈现状，我不介意让更多人知道。\""}
{"time": 1757420420, "type": "recv", "message_id": "991225920", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“其实我一开始只是想谈谈价钱来着……不过感谢你的情报，龙芙小姐”"}
{"time": 1757420433, "type": "recv", "message_id": "1263708519", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“如果哪天我用上了会告诉你的”"}
{"time": 1757420437, "type": "recv", "message_id": "2056370675", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“谢谢龙芙姐姐”"}
{"time": 1757420559, "type": "recv", "message_id": "1888550913", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"价钱?\"她停下动作，露出了意味深长的笑，\"还要谈谈吗？\""}
{"time": 1757420643, "type": "recv", "message_id": "1180486125", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“当然，我相信小姐应该认黄金以外的筹码”"}
{"time": 1757420760, "type": "recv", "message_id": "707502035", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“钱我们应该也不是很缺..”"}
{"time": 1757420925, "type": "recv", "message_id": "1756081112", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那就从你们开始。\"她伸出一只手，示意你们可以开始了。"}
