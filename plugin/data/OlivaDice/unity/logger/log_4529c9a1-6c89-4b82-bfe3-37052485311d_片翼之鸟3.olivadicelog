{"time": 1757566205, "type": "recv", "message_id": "867728885", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（）"}
{"time": 1757566331, "type": "recv", "message_id": "325585210", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "不甘的带着黑色铁镯子跟着西莉丝姐姐一起进去"}
{"time": 1757566346, "type": "recv", "message_id": "2084883746", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "刚刚的那一剑不过是幻想罢了..."}
{"time": 1757567029, "type": "recv", "message_id": "1300628082", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "走进门，闯入眼帘的是一座燃烧的黄金魔窟。巨大的厅堂仿若战国天守，朱红梁柱缠绕金龙，无数水晶灯与金箔屏灯将空气染成迷醉的流金。骰子在象牙赌桌上清脆作响，穿十二单华服的荷官如人偶般精准发牌，而穹顶之上，仿若真正的云海翻涌，巨大的黑影在雷光中掠过，冷漠地俯视着下方沉溺于财富与欲望的芸芸众生。"}
{"time": 1757567069, "type": "recv", "message_id": "1147670556", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“赌场？”"}
{"time": 1757567163, "type": "recv", "message_id": "127934821", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "里面酒精味更甚，到处可见喝醉的衣着光鲜的人或是倒地不起的壮汉，脸上带着淤青和血渍，完全不知从何而来，散乱的酒，光怪陆离的光影...摇晃的人群，眼睛几乎有些疼了"}
{"time": 1757567194, "type": "recv", "message_id": "1495927939", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“.....我们下来怎么做，西莉丝姐姐”"}
{"time": 1757567373, "type": "recv", "message_id": "32467892", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（按照我看的傻雕小短剧，下来应该去发挥高超千术，赌上几把，然后把赌场钱赢光，引老板过来）"}
{"time": 1757567394, "type": "recv", "message_id": "710071006", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（但是我没有高超千术）"}
{"time": 1757567395, "type": "recv", "message_id": "1333144944", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（好的）"}
{"time": 1757571940, "type": "recv", "message_id": "1542375844", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1495927939]\"见机行事。\"她似乎也不怎么适应这种环境，用一只手遮着一侧的眼睛，半眯着琥珀色的瞳孔。"}
{"time": 1757571957, "type": "recv", "message_id": "582646401", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（睡醒了？）"}
{"time": 1757572045, "type": "recv", "message_id": "1279776551", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(没睡，开题报告还剩点尾巴不做了)"}
{"time": 1757572530, "type": "recv", "message_id": "1282391277", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...我们去人多的地方看看吧”"}
{"time": 1757573219, "type": "recv", "message_id": "1113550281", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "理所当然，赌博项目旁边总是围着很多人，另外一个人多的地点是酒吧台前"}
{"time": 1757573938, "type": "recv", "message_id": "930304216", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“感觉都好少儿不宜”不过对看打牌还是蛮敢兴趣的，看看最火的赌博项目是什么"}
{"time": 1757573942, "type": "recv", "message_id": "531101416", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（难道是德州扑克？）"}
