{"time": 1758825683, "type": "recv", "message_id": "1973449164", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“吸血鬼么……”*小声嘀咕"}
