{"time": 1760502611, "type": "recv", "message_id": "954017252", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=213100676](虽然也可以，但是太邪恶)"}
