{"time": 1756260076, "type": "recv", "message_id": "1378357335", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=79331624]"}
{"time": 1756261460, "type": "recv", "message_id": "1472269502", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "好安静……其实也没那么安静，风和充当不清脆风铃的树叶沙沙作响，但至少没有人声……也就没有人会看见完全失败的自己。眼皮好重，闭上的同时反倒看见了未来……第一次产生了想逃避这个世界的想法"}
{"time": 1756263130, "type": "recv", "message_id": "1552230832", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（）"}
