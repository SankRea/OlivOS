{"time": 1760125602, "type": "recv", "message_id": "1074768525", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（而且最近你帮的忙也挺多的）"}
{"time": 1760125637, "type": "recv", "message_id": "547512591", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“对啊..这里也没除了我们四个，这也没其他人了吧”"}
{"time": 1760125719, "type": "recv", "message_id": "1848485140", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（其实我比较好奇为什么态度转变这么大）"}
{"time": 1760125729, "type": "recv", "message_id": "997929910", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……我怎么安排都行，只是我得看着妃花”"}
{"time": 1760125733, "type": "recv", "message_id": "151758911", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(其实我也不知道，但是转都转了)"}
{"time": 1760125742, "type": "recv", "message_id": "660726441", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(就这样吧)"}
{"time": 1760125848, "type": "recv", "message_id": "1509372936", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（就当看在妃花的面子吧）"}
{"time": 1760125889, "type": "recv", "message_id": "1111509534", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那就这样..我们先回去吧”"}
{"time": 1760126004, "type": "recv", "message_id": "2062417205", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "推着轮椅回云台了"}
