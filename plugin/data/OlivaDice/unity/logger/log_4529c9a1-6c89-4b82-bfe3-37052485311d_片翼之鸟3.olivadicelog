{"time": 1756181453, "type": "recv", "message_id": "1499264904", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "语气低沉，带着诱导性的蛊惑"}
{"time": 1756181496, "type": "recv", "message_id": "1374427994", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“你是坏人..我不需要你帮忙”"}
