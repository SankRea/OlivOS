{"time": 1756924229, "type": "recv", "message_id": "1260400733", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“这是什么...”试图洗掉"}
{"time": 1756924407, "type": "recv", "message_id": "1365201282", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "触碰到的时候感觉有些痛感，你不由得缩回了手"}
{"time": 1756924498, "type": "recv", "message_id": "1848476594", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好痛...”小心换好衣服，然后去客厅坐着，等西莉丝姐姐醒来，看看她知不知道自己脖子的事情"}
{"time": 1756924524, "type": "recv", "message_id": "1522105319", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1895197118](梳子干嘛)"}
