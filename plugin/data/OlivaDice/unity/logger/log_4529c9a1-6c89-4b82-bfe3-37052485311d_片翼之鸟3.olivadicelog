{"time": 1759686133, "type": "recv", "message_id": "1102859419", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "稍微慢一点，出去找西莉丝"}
