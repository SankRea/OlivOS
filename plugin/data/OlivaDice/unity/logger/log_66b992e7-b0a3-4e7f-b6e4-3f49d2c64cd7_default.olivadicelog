{"time": 1753792260, "type": "recv", "message_id": "569193724", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（话说你家是不是住神社里）"}
