{"time": 1767029716, "type": "recv", "message_id": "1446172528", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“大家都出力了，那我也要上了！玛修基列莱特，出击！”"}
{"time": 1767029766, "type": "recv", "message_id": "879757537", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "玛修看到莉维娅拟似宝具稍稍疑惑了一下，但是为了守护住大家，决定在此解放宝具！"}
{"time": 1767029805, "type": "recv", "message_id": "358667387", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“Lord Camelot！”"}
