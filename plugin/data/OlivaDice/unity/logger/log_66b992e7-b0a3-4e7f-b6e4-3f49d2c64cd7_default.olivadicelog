{"time": 1720973737, "type": "recv", "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "两人又拉开了"}
{"time": 1720973774, "type": "recv", "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "念力控制短剑绕着身边飞行，抱着苏茜往后退"}
{"time": 1720973805, "type": "recv", "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“圣娅姐你没事吧，我看你刚才差点受伤了。”"}
{"time": 1720973813, "type": "recv", "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "苏茜在你怀里问到"}
{"time": 1720973838, "type": "recv", "dect": {"host_id": null, "group_id": "121735290", "user_id": "172216539"}, "sender": {"id": "172216539", "name": "离去之原"}, "message": "“没事，就这种程度我还处理得过来。”"}
{"time": 1720973853, "type": "recv", "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“没事，就这种程度我还处理得过来。”"}
{"time": 1720974097, "type": "recv", "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "圣娅和苏茜往下台楼梯方向撤去"}
