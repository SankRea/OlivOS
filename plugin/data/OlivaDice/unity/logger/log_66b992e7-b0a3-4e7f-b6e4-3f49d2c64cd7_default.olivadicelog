{"time": 1767029189, "type": "recv", "message_id": "1747111656", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯?\"莫名有点眼熟，\"这是?\""}
{"time": 1767029232, "type": "recv", "message_id": "2059177739", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "那么莉维娅认出，这是‘所罗门’的人理修正式系列魔术，是原本用来守护人理的力量。"}
{"time": 1767029254, "type": "recv", "message_id": "301192271", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"所罗门?\"眯着眼"}
{"time": 1767029353, "type": "recv", "message_id": "53846444", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "&#91;觉醒之时已至&#93;\n&#91;—人理烧却式·佛劳伦斯&#93;"}
{"time": 1767029373, "type": "recv", "message_id": "707068707", "deleted": false, "dect": {"host_id": null, "group_id": "121735290", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "抵挡难度500"}
