{"time": 1772524570, "type": "recv", "message_id": "1418032712", "deleted": false, "dect": {"host_id": null, "group_id": "1035799209", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "不过你想起来，鉴识科其实也有来，你可以通知他们过来"}
{"time": 1772524577, "type": "recv", "message_id": "839665733", "deleted": false, "dect": {"host_id": null, "group_id": "1035799209", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "打电话叫人了"}
{"time": 1772524592, "type": "recv", "message_id": "1149254716", "deleted": false, "dect": {"host_id": null, "group_id": "1035799209", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（你不是说只有我一个人出任务吗）"}
