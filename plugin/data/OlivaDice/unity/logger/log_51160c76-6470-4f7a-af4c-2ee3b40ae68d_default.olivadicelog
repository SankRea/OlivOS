{"time": 1772522412, "type": "recv", "message_id": "983199104", "deleted": false, "dect": {"host_id": null, "group_id": "1035799209", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（我以为是关键信息呢）"}
{"time": 1772522457, "type": "recv", "message_id": "1484852916", "deleted": false, "dect": {"host_id": null, "group_id": "1035799209", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "那还说啥了，直接抓他"}
{"time": 1772522476, "type": "recv", "message_id": "903683749", "deleted": false, "dect": {"host_id": null, "group_id": "1035799209", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "当你准备靠近他的时候，他开口了"}
{"time": 1772522491, "type": "recv", "message_id": "136652339", "deleted": false, "dect": {"host_id": null, "group_id": "1035799209", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“将死亡……敬献给伟大的神。”\n伴随沸水在水壶里烧开般的嗡鸣，周遭的一切暗了下来，这里仅存的生源只有你仍在跳动的心脏。"}
{"time": 1772522495, "type": "recv", "message_id": "1834861525", "deleted": false, "dect": {"host_id": null, "group_id": "1035799209", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（过个意志）"}
