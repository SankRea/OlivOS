{"time": 1772524448, "type": "recv", "message_id": "1961190121", "deleted": false, "dect": {"host_id": null, "group_id": "1035799209", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "看起来有很强的腐蚀性"}
