{"time": 1771829375, "type": "recv", "message_id": "124323136", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "（败犬大人该去乐器区了.jpg）"}
