{"time": 1771305926, "type": "recv", "message_id": "1669229376", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "（他身边有好友吗）"}
