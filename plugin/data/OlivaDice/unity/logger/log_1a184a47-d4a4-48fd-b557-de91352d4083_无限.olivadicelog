{"time": 1768283770, "type": "recv", "message_id": "1609223207", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(两个选择)"}
{"time": 1768283779, "type": "recv", "message_id": "1006408134", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（跟他们说计划提前了（）"}
{"time": 1768283786, "type": "recv", "message_id": "538625641", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（即日起兵！）"}
{"time": 1768283789, "type": "recv", "message_id": "1034847393", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(加入他们，或者把他们当投名状)"}
{"time": 1768283808, "type": "recv", "message_id": "557708962", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "（起兵说是）"}
{"time": 1768283819, "type": "recv", "message_id": "1435938707", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“你们一共有多少人？”"}
{"time": 1768283832, "type": "recv", "message_id": "1647623822", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（主要是明天不一定来得及啊）"}
{"time": 1768283846, "type": "recv", "message_id": "1590028150", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“胜算有多少？”"}
{"time": 1768283961, "type": "recv", "message_id": "1065260396", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "（我们为什么告诉你，你做的是哪家的鹰犬，事的又是哪家的贼？！.jpg"}
{"time": 1768283980, "type": "recv", "message_id": "974479817", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“234人”"}
{"time": 1768283983, "type": "recv", "message_id": "379027777", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(重要的是为之后的行动铺路)"}
{"time": 1768284002, "type": "recv", "message_id": "380926679", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“黑云明面上在这里不过几十人而已”"}
{"time": 1768284003, "type": "recv", "message_id": "326940257", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(可以预见的是，我们回来的时间线不会很长)"}
{"time": 1768284016, "type": "recv", "message_id": "356229742", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“我们只要f4，胜率就是100%”"}
{"time": 1768284028, "type": "recv", "message_id": "2132872780", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“那叫f2a”"}
{"time": 1768284035, "type": "recv", "message_id": "1132421157", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“什么f4”"}
{"time": 1768284043, "type": "recv", "message_id": "658944094", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“alt+f4吗”"}
{"time": 1768284051, "type": "recv", "message_id": "529094159", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“那不然呢”"}
{"time": 1768284081, "type": "recv", "message_id": "1386754491", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“还真不少……”思考“正面介入的话，我们好像也没什么便宜……什么f2a？”"}
{"time": 1768284089, "type": "recv", "message_id": "1893424551", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我知道什么是f2a（）"}
{"time": 1768284107, "type": "recv", "message_id": "771792938", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“嗯....星际争霸的快捷键操作。”"}
{"time": 1768284126, "type": "recv", "message_id": "1633492370", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“一个梗。”"}
{"time": 1768284144, "type": "recv", "message_id": "443819863", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“不管了，如果要拱火的话，把这两个带去找黑云的人？”"}
{"time": 1768284153, "type": "recv", "message_id": "2010365857", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“看你想怎么搞”"}
{"time": 1768284167, "type": "recv", "message_id": "1867072121", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“是想拉拢赤手还是黑云”"}
{"time": 1768284179, "type": "recv", "message_id": "2025420539", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“送黑云一个人情么”"}
{"time": 1768284188, "type": "recv", "message_id": "1045314243", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“就把这两个倒霉蛋丢给黑云”"}
{"time": 1768284202, "type": "recv", "message_id": "527726007", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“想挖黑云的秘密”"}
{"time": 1768284213, "type": "recv", "message_id": "888118248", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“就直接动手。”"}
{"time": 1768284233, "type": "recv", "message_id": "2037406846", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“我这次推荐前者。”"}
{"time": 1768284243, "type": "recv", "message_id": "1426517681", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我想把这两家都解决。黑云只是在这里人手不足吧”"}
{"time": 1768284245, "type": "recv", "message_id": "699512185", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“送黑云一个人情”"}
{"time": 1768284253, "type": "recv", "message_id": "1418677960", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“我没意见。”"}
{"time": 1768284260, "type": "recv", "message_id": "418632664", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“看你选择。”"}
{"time": 1768284266, "type": "recv", "message_id": "911132617", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“只是人生地不熟”"}
{"time": 1768284274, "type": "recv", "message_id": "769962381", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“最好不要选我全都要。”"}
{"time": 1768284278, "type": "recv", "message_id": "1515806593", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“给他们一个晚上，说不定能调集多一些。等他们打起来，就能把水搅浑”"}
{"time": 1768284314, "type": "recv", "message_id": "1950925267", "deleted": true, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“那样对我们虽然有利，但或许对这里的人已经我们想调查的就不好说了”"}
{"time": 1768284337, "type": "recv", "message_id": "2101075865", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“那样对我们虽然有利，但或许对这里的人和我们想调查的就不好说了”"}
{"time": 1768284362, "type": "recv", "message_id": "1866077818", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“赤手的人可不一定识货。”"}
{"time": 1768284374, "type": "recv", "message_id": "17065278", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“但黑云看中一定有它的道理。”"}
{"time": 1768284388, "type": "recv", "message_id": "1306532143", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(别忘了我有隐形)"}
{"time": 1768284417, "type": "recv", "message_id": "1397944739", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(主要是把水搅浑，我们能拿的东西就少了。)"}
{"time": 1768284427, "type": "recv", "message_id": "217829890", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯……疏散也一并做了吧。我只是觉得，比起漫无目的地找，不如，那什么来着，激浊扬清。不然藏在深处的东西我们都不知道去哪找”"}
{"time": 1768284454, "type": "recv", "message_id": "417694921", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "[CQ:image,summary=&#91;动画表情&#93;,file=369A1AFDC1ECE277A288D3AD1F306196.jpg,sub_type=1,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhTHWa0ja9aDXsoC0LA_WAQtrjBpbxiXnAog_woou82A9uyHkgMyBHByb2RQgL2jAVoQqp-LZ5cHvvjiruNM66dUtnoC60KCAQJneg&amp;rkey=CAQSMOOmo2TydvIjLRoinwEfzbHE4N01CG2G8VJrI6uxUwoLIHG8jvI946kuE7ixG3xe5Q,file_size=167447]"}
{"time": 1768284479, "type": "recv", "message_id": "1839706623", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“你也听到了”"}
{"time": 1768284482, "type": "recv", "message_id": "1342638191", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“234人”"}
{"time": 1768284488, "type": "recv", "message_id": "1486667641", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“你有能力解决吗。”"}
{"time": 1768284512, "type": "recv", "message_id": "67757800", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "[CQ:image,summary=&#91;动画表情&#93;,file=11DF10A2E401E8E2818ECF27E814E059.jpg,sub_type=1,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhQY-5LunQBjX6Hymf7ah1q6rAoRNRiPuAIg_wooqYvEke2HkgMyBHByb2RQgL2jAVoQSN6hbWbQhN-dcIvPDaDyMnoCmCeCAQJneg&amp;rkey=CAQSMOOmo2TydvIjLRoinwEfzbHE4N01CG2G8VJrI6uxUwoLIHG8jvI946kuE7ixG3xe5Q,file_size=39951]"}
{"time": 1768284546, "type": "recv", "message_id": "555138222", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“我子弹都没带这么多”"}
{"time": 1768284566, "type": "recv", "message_id": "687117308", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“啊？我们也不是来杀人的吧”"}
{"time": 1768284594, "type": "recv", "message_id": "1337447273", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“把消息透露给黑云，让他们调集人数打防御战，我们不参与”"}
{"time": 1768284617, "type": "recv", "message_id": "1797710337", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“只是借此机会看看双方老巢都在哪，到时候好做部署”"}
{"time": 1768284638, "type": "recv", "message_id": "1986448404", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“那就是我提出的卖人情。”"}
{"time": 1768284648, "type": "recv", "message_id": "693298173", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“就这么办吧。”"}
{"time": 1768284698, "type": "recv", "message_id": "411852524", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“....以及，我们不杀黑手也会杀，区别只是血沾在谁的手上。”"}
{"time": 1768284713, "type": "recv", "message_id": "1909459598", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯。如果动静闹得大的话……说不定不止两家下场呢。”点点头，对被操控的那一人下达指令，让他回去，假装无事发生。被问起另一个人去哪了，就说被警察带走了"}
{"time": 1768284781, "type": "recv", "message_id": "393299672", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“他们都玩黑帮了，都是把命别脑袋上的人。”"}
{"time": 1768284803, "type": "recv", "message_id": "1324455691", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“不杀只是为了好沟通。”"}
{"time": 1768284822, "type": "recv", "message_id": "1903147869", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "#玖茗意外的冷酷无情"}
{"time": 1768284864, "type": "recv", "message_id": "1617501484", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“不过黑帮倒也算这里普通百姓的保护伞”"}
{"time": 1768284880, "type": "recv", "message_id": "1213122999", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（难说.jpg）"}
{"time": 1768284893, "type": "recv", "message_id": "113742968", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“能不这么干尽量不这么干。”"}
{"time": 1768284899, "type": "recv", "message_id": "1062197806", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（取决于是哪种黑帮吧大概）"}
{"time": 1768284914, "type": "recv", "message_id": "1959818701", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“被公司吸血，和被黑帮缴保护费”"}
