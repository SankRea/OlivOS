{"time": 1771853489, "type": "recv", "message_id": "699661808", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "他跟着你们一起去到了河边的岸上"}
{"time": 1771853497, "type": "recv", "message_id": "206038687", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“你就是他们说的诺顿？我看这小孩似乎很看重你”"}
