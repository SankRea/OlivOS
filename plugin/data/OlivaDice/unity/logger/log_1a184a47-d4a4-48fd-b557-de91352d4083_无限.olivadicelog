{"time": 1766484703, "type": "recv", "message_id": "1945314066", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "（简而言之，是给未来公司擦屁股的）"}
{"time": 1766484709, "type": "recv", "message_id": "802276447", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"也就是说，动静越大越好?\""}
