{"time": 1771746275, "type": "recv", "message_id": "682147689", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“没关系的，保持这样才可以保持引导”"}
