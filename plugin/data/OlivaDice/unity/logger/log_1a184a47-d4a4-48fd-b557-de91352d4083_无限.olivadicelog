{"time": 1766389342, "type": "recv", "message_id": "31898604", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(你们有什么要问的吗)"}
{"time": 1766389346, "type": "recv", "message_id": "398494461", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(我没什么头绪)"}
