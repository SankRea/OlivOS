{"time": 1766390936, "type": "recv", "message_id": "446957116", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "#小声"}
{"time": 1766390989, "type": "recv", "message_id": "473428658", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“走吧，哥哥。我们下次再来看看”"}
{"time": 1766390995, "type": "recv", "message_id": "1327470403", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1664766713]“这是什么？根？”想到了什么，蹲下来看看夜鸦手里的东西，感受一下有没有生命？"}
{"time": 1766390997, "type": "recv", "message_id": "506853943", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "#汇合"}
