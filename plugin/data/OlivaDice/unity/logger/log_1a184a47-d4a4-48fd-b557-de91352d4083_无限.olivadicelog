{"time": 1766067297, "type": "recv", "message_id": "1236435833", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "#帕特森抖抖耳朵"}
