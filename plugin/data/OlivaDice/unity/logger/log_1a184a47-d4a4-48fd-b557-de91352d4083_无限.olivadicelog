{"time": 1770393291, "type": "recv", "message_id": "149268920", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "你可能理解错我的意思了"}
{"time": 1770393337, "type": "recv", "message_id": "1257568278", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "我的意思是我只是想要一个可以让我在萝莉体型和成女体型之间转化的天赋"}
{"time": 1770393338, "type": "recv", "message_id": "1498658232", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "我觉得一概而言之"}
{"time": 1770393345, "type": "recv", "message_id": "560337527", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "你就是想要符合自己的人设"}
{"time": 1770393352, "type": "recv", "message_id": "1306756090", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "但是它可以被包裹进化形"}
