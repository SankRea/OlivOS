{"time": 1772025895, "type": "recv", "message_id": "1646779509", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我呢?\"指了指自己，\"全力动手?感受一下?\""}
{"time": 1772025935, "type": "recv", "message_id": "69864839", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "五条五边走，这边和你们闲聊，走过的地方都格外的有日式风格“在国外，你们也经常有战斗的机会吗？”"}
{"time": 1772025938, "type": "recv", "message_id": "57540683", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“。。。仙仙，咱们是切磋，不是杀人”"}
{"time": 1772025962, "type": "recv", "message_id": "241811094", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“差不多吧，战斗不少就是了”"}
{"time": 1772026026, "type": "recv", "message_id": "430080671", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“不过也不算太危险”"}
{"time": 1772026041, "type": "recv", "message_id": "1893261856", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“只不过没想到来到日本，一眨眼就看见了恐怖分子”"}
{"time": 1772026043, "type": "recv", "message_id": "68863906", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“是吗.........”走在前头的五条悟忽然停了下来"}
{"time": 1772026248, "type": "recv", "message_id": "928916724", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“嗯？怎么了”"}
{"time": 1772026265, "type": "recv", "message_id": "858581352", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "#看见他停下来，歪歪头"}
{"time": 1772026273, "type": "recv", "message_id": "1668135033", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“你们，真的是来自国外吗？”他头也没回的问"}
{"time": 1772026285, "type": "recv", "message_id": "1767598698", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "#看了看有没有其他人"}
{"time": 1772026293, "type": "recv", "message_id": "429924176", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "周围看着没其他人"}
{"time": 1772026301, "type": "recv", "message_id": "1462430559", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“没错”#确实是国外，毕竟都不是这个国家，甚至不是世界，怎么不算是国外了"}
{"time": 1772026322, "type": "recv", "message_id": "710572876", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“那我有些问题可以问问吗？”"}
{"time": 1772026326, "type": "recv", "message_id": "80540143", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“国外的概念可宽泛了。”"}
{"time": 1772026407, "type": "recv", "message_id": "112441753", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“问吧”"}
{"time": 1772026477, "type": "recv", "message_id": "1524415578", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“比如你们的咒力，为什么会是这样的？”"}
{"time": 1772026555, "type": "recv", "message_id": "847984993", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"什么意思?\""}
{"time": 1772026584, "type": "recv", "message_id": "858961199", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“什么什么样，你是说大气中充满的负面咒力和我们身体内的咒力性质不同吗”"}
{"time": 1772026615, "type": "recv", "message_id": "325379278", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“看来稍微还是有点自觉的呢”"}
{"time": 1772026624, "type": "recv", "message_id": "2108916813", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“当然是因为，我们是来让世界和平的”#没有开玩笑，很认真的说着"}
{"time": 1772026659, "type": "recv", "message_id": "1496525374", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“不不不，现在是问原因，而不是目的吧，难道你们是外星人？异世界人？”"}
{"time": 1772026773, "type": "recv", "message_id": "156325498", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“这个问题有点意思，不过你相信异世界人或者外星人吗”"}
{"time": 1772026835, "type": "recv", "message_id": "1045404471", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "听到这个话题之后，他笑了笑“谁知道呢，如果有的话，不应该是大头小个子皮肤还是紫的，手里还能发射出光波吗？”"}
{"time": 1772026857, "type": "recv", "message_id": "1283091502", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "（这是什么角色）"}
{"time": 1772026862, "type": "recv", "message_id": "1847878510", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"别看我这样，其实我是，魔族，魔族啦。\""}
{"time": 1772026914, "type": "recv", "message_id": "819315221", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“那我是精灵哦，呵呵，不过有些事情就等结束了再说吧，我是有些好奇，为什么这里的咒力全是负面，正面不能产生咒力吗”"}
{"time": 1772026992, "type": "recv", "message_id": "510033882", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“原来如此，原来如此，那就不奇怪了，刚见面的时候还想着奇怪。”"}
{"time": 1772027040, "type": "recv", "message_id": "781298397", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“既然知道就好，好，接下来是五条悟的基础教学时间，这里的咒力都是由人产生的哦，人会源源不断的产生负面情绪来形成咒力”"}
{"time": 1772027146, "type": "recv", "message_id": "1770496981", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“开心之类的情绪无法产生吗。。。感觉这种咒力就想待在粪坑里面一样”"}
{"time": 1772027207, "type": "recv", "message_id": "806957324", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“是这样哦”"}
{"time": 1772027219, "type": "recv", "message_id": "357038246", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“顺便你们可能不知道”"}
{"time": 1772027301, "type": "recv", "message_id": "269273841", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“咒灵就是由溢散出去的咒力形成的，世界上大多数的人都不会使用重力，但不代表他们不会产生，同时他们既无法利用，也没有办法保留，因此也就源源不断的使咒力溢散出去了”"}
{"time": 1772027386, "type": "recv", "message_id": "770055761", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“既然人人都能产生咒力，那么是不是人人都有成为咒术师的资质？”"}
{"time": 1772027452, "type": "recv", "message_id": "1186683707", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“嗯.........理论确实如此，但是大多数人即便学习也没有可能成为够格的咒术师”"}
{"time": 1772027520, "type": "recv", "message_id": "866199311", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“只要抑制住咒力流失，也不需要太够格吧”"}
{"time": 1772027540, "type": "recv", "message_id": "690002726", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“不过这样子的话，那些天龙人们估计要有产业链了”"}
{"time": 1772027644, "type": "recv", "message_id": "71144855", "deleted": true, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "五条悟耸耸肩“谁知道呢，或许每个人都能在小学学会微积分”"}
{"time": 1772027657, "type": "recv", "message_id": "266937281", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "五条悟耸耸肩“谁知道呢，或许每个人都能在小学多费些时间学会微积分”"}
{"time": 1772027690, "type": "recv", "message_id": "1352621125", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "他似乎只是确认了几句话便继续开始带着你们走动了，不一会就到了几间房间先"}
{"time": 1772027703, "type": "recv", "message_id": "1551069155", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“就是这个了，一点的时候到刚刚的地点汇合”"}
{"time": 1772027712, "type": "recv", "message_id": "581457390", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"皱眉思考，但也没说什么"}
{"time": 1772027772, "type": "recv", "message_id": "532782861", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“行。。。”#看一下房间里面的布局，有钟表吗"}
