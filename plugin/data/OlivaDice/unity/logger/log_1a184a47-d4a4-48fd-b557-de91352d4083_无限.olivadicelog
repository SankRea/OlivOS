{"time": 1772025427, "type": "recv", "message_id": "1158129968", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "[CQ:image,summary=&#91;动画表情&#93;,file=5B5B457640FA6B29160CFE5603D1B978.jpg,sub_type=1,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhRdZQnKojT-jgYraySpBRWF2SALuBjvx3kg_wooje7AkN30kgMyBHByb2RQgL2jAVoQpyyGMXv6L3gl7fLJe_Jv-XoCbO-CAQJneg&amp;rkey=CAQSMDyfQt3O2yb8SnxKytyWYm-ky6HDHnA91YPT3uflj2XWxwl-qYDjHRSZrIvNv2JpDw,file_size=1991663]"}
{"time": 1772025533, "type": "recv", "message_id": "290911472", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“也就是没有后遗症的程度”"}
{"time": 1772025546, "type": "recv", "message_id": "958368035", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "（死了就没有后遗症了）"}
{"time": 1772025559, "type": "recv", "message_id": "1817366070", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“了解了，那么咱们什么时候开始”"}
