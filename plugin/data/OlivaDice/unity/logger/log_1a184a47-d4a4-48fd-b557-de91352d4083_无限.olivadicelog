{"time": 1766380475, "type": "recv", "message_id": "893587573", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "（更别说这是教会开的）"}
{"time": 1766380492, "type": "recv", "message_id": "1677091431", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "（行吧）"}
