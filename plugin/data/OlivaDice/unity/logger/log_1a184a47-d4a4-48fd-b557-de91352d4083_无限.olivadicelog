{"time": 1771817563, "type": "recv", "message_id": "2100023273", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“如果各位想要奖金的话，我凯撒也正好有不少”"}
{"time": 1771817597, "type": "recv", "message_id": "171635517", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那我可双手接过了。\"伸出双手，眯着眼睛嘴角上扬"}
{"time": 1771817630, "type": "recv", "message_id": "1992217709", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“不过凯撒你怎么第一时间知道我们回来了”"}
{"time": 1771817643, "type": "recv", "message_id": "1153022264", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“三峡的事情不会都知道了吧”"}
{"time": 1771817661, "type": "recv", "message_id": "1442611115", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“直播，直播”"}
