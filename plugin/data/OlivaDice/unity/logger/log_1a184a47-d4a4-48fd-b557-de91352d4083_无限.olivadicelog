{"time": 1771311820, "type": "recv", "message_id": "63627024", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“您对于王储的事情并不敢兴趣?”"}
