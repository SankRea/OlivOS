{"time": 1771571531, "type": "recv", "message_id": "1132630997", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "（我说的是团里的昨晚）"}
