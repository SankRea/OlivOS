{"time": 1766067250, "type": "recv", "message_id": "2087957842", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "[CQ:face,id=344,raw=&#91;object Object&#93;]"}
