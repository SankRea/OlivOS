{"time": 1771853227, "type": "recv", "message_id": "1544510484", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“先不论这个小孩”"}
