{"time": 1766381027, "type": "recv", "message_id": "525509863", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“教会的来历是?”"}
