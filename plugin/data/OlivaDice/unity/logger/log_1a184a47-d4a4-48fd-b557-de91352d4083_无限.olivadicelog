{"time": 1766389791, "type": "recv", "message_id": "603857157", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(啥)"}
