{"time": 1770383369, "type": "recv", "message_id": "1059371721", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "随后你们看到了位少年推开了间房门走来"}
{"time": 1770383373, "type": "recv", "message_id": "1655754074", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“怎么了？”"}
{"time": 1770383378, "type": "recv", "message_id": "213248554", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“那么这个先来的异世界同伴是哪个世界来的，地球？”"}
{"time": 1770383389, "type": "recv", "message_id": "124694501", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "【直接召唤来的.....打工人？】"}
{"time": 1770383498, "type": "recv", "message_id": "1385694431", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“地球？我对自己的世界认知很少，不过我来自德国，我是冯•诺依曼•雷内”"}
{"time": 1770383556, "type": "recv", "message_id": "2095721829", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（魔力感知？）"}
{"time": 1770383590, "type": "recv", "message_id": "2117799902", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“哦?也来自地球啊。”"}
{"time": 1770383616, "type": "recv", "message_id": "1229042186", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“你又是来自哪个时代的?”"}
{"time": 1770383647, "type": "recv", "message_id": "1881972799", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“冯....贵族?”"}
{"time": 1770383691, "type": "recv", "message_id": "603384150", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "（显然，中世纪的人不会称自己为中世纪）"}
{"time": 1770383708, "type": "recv", "message_id": "429523079", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（冯不是在中间吗）"}
