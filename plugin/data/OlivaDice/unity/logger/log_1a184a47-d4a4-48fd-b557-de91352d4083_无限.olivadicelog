{"time": 1771401895, "type": "recv", "message_id": "2003447197", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "（救天勇者）"}
