{"time": 1771306297, "type": "recv", "message_id": "1202906445", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "去找会长咯，毕竟自己也是冒险者"}
