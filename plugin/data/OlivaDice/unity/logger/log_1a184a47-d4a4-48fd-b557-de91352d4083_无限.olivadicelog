{"time": 1771852700, "type": "recv", "message_id": "1908956438", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“他......我不知道啊，！你看他现在不是挺人畜无害的，你砍他都没反应”"}
{"time": 1771852739, "type": "recv", "message_id": "1090321250", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“......”"}
{"time": 1771852751, "type": "recv", "message_id": "1860952328", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "#狐疑的看了眼这小屁孩"}
{"time": 1771852763, "type": "recv", "message_id": "731618260", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“他有反应就来不及了”再次举刀"}
{"time": 1771852820, "type": "recv", "message_id": "92703248", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "【还是先无害化处理再说】"}
{"time": 1771852878, "type": "recv", "message_id": "490135036", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“森原姐！”你们看到夜鸦突然中道杀出持剑架住了华砍出的刀，这并非她有什么惊为天人的技术说到底只是你们对她没有防范“我们先想办法交流决定再决定怎么样？”"}
{"time": 1771852927, "type": "recv", "message_id": "1609443549", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“......”"}
{"time": 1771852971, "type": "recv", "message_id": "804184895", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "\"啧。\""}
{"time": 1771853004, "type": "recv", "message_id": "743067119", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“其实只是想无害化，毕竟华还能让他手长回来。”"}
{"time": 1771853032, "type": "recv", "message_id": "1234931578", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "#拍拍华的肩"}
{"time": 1771853046, "type": "recv", "message_id": "746463940", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“啊.......怎么又是个小姑娘”男人显得有些看蒙头，不过看到这个场景也是感恩万分“小姑娘，谢谢你啊，还有你们啊，我们先上岸怎么样”"}
{"time": 1771853082, "type": "recv", "message_id": "1348118394", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“嗯，先上岸。”"}
{"time": 1771853125, "type": "recv", "message_id": "43717343", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“交流……这样怎么交流？你有没有想过他恢复了变卦我们怎么办？”有些烦躁，怎么这群人一点都不怕"}
{"time": 1771853140, "type": "recv", "message_id": "698401016", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "#有魔力专家，先把夜鸦拉起来。"}
