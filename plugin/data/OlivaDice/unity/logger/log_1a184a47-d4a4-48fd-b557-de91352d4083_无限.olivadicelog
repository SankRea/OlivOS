{"time": 1770384862, "type": "recv", "message_id": "47578182", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（这么看来渡星者也不是）"}
{"time": 1770384866, "type": "recv", "message_id": "1716050553", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "（你们也没几个是人啊）"}
{"time": 1770384871, "type": "recv", "message_id": "1530151241", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“的确存在许多世界。”"}
