{"time": 1766380554, "type": "recv", "message_id": "588140434", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "（没问题就行动）"}
{"time": 1766380571, "type": "recv", "message_id": "1591112211", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "（我吃个饭，跟随）"}
{"time": 1766380658, "type": "recv", "message_id": "441387604", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "没什么好说的，在这种魔力受限的地方，自己最擅长的事情也很难去做。因此有些无聊"}
{"time": 1766380688, "type": "recv", "message_id": "2112559656", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“除了未来公司，还有其他的强势公司吗”"}
{"time": 1766380698, "type": "recv", "message_id": "753273595", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“目前就是它一家独大?”"}
