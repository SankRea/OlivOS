{"time": 1766758461, "type": "recv", "message_id": "1303014308", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "[CQ:image,summary=&#91;动画表情&#93;,file=955BC6187DAD86A4E3BABEA0CE223B38.jpg,sub_type=1,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhQWuma41SBezAtzD2sojyXpBamYGBiV4k8g_wooq5_ik7jbkQMyBHByb2RQgL2jAVoQsw0R2z7LcOO69-_iRUu3fXoCuIGCAQJuag&amp;rkey=CAESMO1juddgrdteu5S7Mybbq2pQ7xqCFxfXBbPXPvQm_MYN3cfdQ4ynB1PUeKbznU1gAg,file_size=1306901]"}
{"time": 1766758506, "type": "recv", "message_id": "724310971", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“研究？是说公司正在进行的还是？”"}
{"time": 1766758533, "type": "recv", "message_id": "1991759642", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“我打算亲自研究研究”"}
{"time": 1766758551, "type": "recv", "message_id": "1034671015", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“姑且开刀之后的消毒以及包扎，我还是略知一二”"}
{"time": 1766758612, "type": "recv", "message_id": "1474672666", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“有劳亚大夫了。”"}
{"time": 1766758668, "type": "recv", "message_id": "464769491", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“诶，到了这个程度还有摘除的可能吗？”"}
{"time": 1766758725, "type": "recv", "message_id": "1577196127", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“她的心脏功能以及其他的身体内部结构似乎已经被代替了”"}
{"time": 1766758909, "type": "recv", "message_id": "895899373", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“血根和他是共生关系？”"}
{"time": 1766758916, "type": "recv", "message_id": "505085167", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“那就很麻烦了。”"}
{"time": 1766758961, "type": "recv", "message_id": "6470661", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“大概”"}
{"time": 1766759518, "type": "recv", "message_id": "1549809087", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“还需要我们做什么吗？”"}
{"time": 1766759589, "type": "recv", "message_id": "1451179582", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“不需要我们的话，我就下去吃东西了，医术方面我并不专业。”"}
{"time": 1766759599, "type": "recv", "message_id": "663541222", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "#看向一旁的森原华"}
{"time": 1766759607, "type": "recv", "message_id": "1988437899", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“她懂得大概更多吧。”"}
{"time": 1766759711, "type": "recv", "message_id": "478800235", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“嗯，不”亚麻似乎有着点自己的打算“我来就好”"}
{"time": 1766759836, "type": "recv", "message_id": "2055770561", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“麻烦你了。”"}
