{"time": 1771490558, "type": "recv", "message_id": "1755355582", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(撬开一个口子就好)"}
