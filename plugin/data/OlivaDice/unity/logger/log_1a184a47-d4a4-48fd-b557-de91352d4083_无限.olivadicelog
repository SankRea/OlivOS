{"time": 1766482359, "type": "recv", "message_id": "1962870076", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "#和变装术"}
{"time": 1766482364, "type": "recv", "message_id": "1391651300", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "手杖滑在手心，没说话"}
{"time": 1766482431, "type": "recv", "message_id": "242285201", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "那仙仙没感觉到什么"}
{"time": 1766482457, "type": "recv", "message_id": "2094573814", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“你们，都是同行的？”"}
{"time": 1766482472, "type": "recv", "message_id": "5980902", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "#点头"}
{"time": 1766482488, "type": "recv", "message_id": "983235271", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "[CQ:image,summary=&#91;动画表情&#93;,file=6BB72AF4154C8E66132B9F7CB3A722DA.jpg,sub_type=1,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhSRSBUFDzQrSoY8WV5tLKOdRhYhzhji-U8g_woo4MmnibTTkQMyBHByb2RQgL2jAVoQfN2o--lA0h2-cnVp3XbzhHoCTluCAQJuag&amp;rkey=CAISMArAKzGGwjzSnFxPDjKWmRrOZShr73NXcCURslWXXgY3G2iSrlhQq3V9BWyU8jnzMQ,file_size=1309922]"}
{"time": 1766482631, "type": "recv", "message_id": "619240588", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“你好，修女。”"}
{"time": 1766482644, "type": "recv", "message_id": "1410167521", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“你应该也是实验体吧。”"}
{"time": 1766482672, "type": "recv", "message_id": "1368859558", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“不是”她稍微摇了摇头“我们不是”"}
{"time": 1766482679, "type": "recv", "message_id": "1381195020", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“哦?”"}
{"time": 1766482707, "type": "recv", "message_id": "1250404268", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“你具备三根却不是实验体，那还真是奇特”"}
{"time": 1766482812, "type": "recv", "message_id": "2045547713", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“嗯........”她只是应了声，没有打算在这个话题上延伸"}
{"time": 1766482880, "type": "recv", "message_id": "1028509120", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“我们是来此寻找线索......有关真相。赤月的真相。”"}
{"time": 1766482885, "type": "recv", "message_id": "988107573", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“要合作吗？”冷不丁问出一句"}
{"time": 1766482913, "type": "recv", "message_id": "532849395", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"喂?这家伙是谁还不知道呢\""}
{"time": 1766482933, "type": "recv", "message_id": "1019470813", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "[CQ:reply,id=1368859558][CQ:at,qq=961142868] “我们？”"}
{"time": 1766482945, "type": "recv", "message_id": "1933171055", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“还有其他人吗”"}
{"time": 1766482973, "type": "recv", "message_id": "618174899", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“合作的话，就方便问更多了”"}
{"time": 1766483010, "type": "recv", "message_id": "360299512", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"最起码知道对方是谁，要做什么。\"摊手"}
{"time": 1766483049, "type": "recv", "message_id": "1103944901", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（大声密谋说是）"}
{"time": 1766483050, "type": "recv", "message_id": "713406623", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“这里只有我.....合作的话，可以，我只是来斩杀被放出来的赤蜘蛛的”"}
{"time": 1766483075, "type": "recv", "message_id": "200377157", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“赤蜘蛛?”"}
{"time": 1766483172, "type": "recv", "message_id": "1385256514", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“嗯，骑士团袭击过后被放出来的魔女，她的培养皿被扩到了这整片区域”"}
{"time": 1766483219, "type": "recv", "message_id": "707314380", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"这一片?\"歪着脑袋，\"多大范围。\""}
{"time": 1766483408, "type": "recv", "message_id": "919713186", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“未来公司的人包围范围以内，这里的瘴气很浓厚不是吗，死者会溶解随后挥发........”"}
{"time": 1766483490, "type": "recv", "message_id": "208162620", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“瘴气？”#思索一下她是不是说的魔力"}
{"time": 1766483513, "type": "recv", "message_id": "2129734834", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"半径一公里?\""}
{"time": 1766483573, "type": "recv", "message_id": "1637443054", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“不知道”"}
{"time": 1766483599, "type": "recv", "message_id": "2123982370", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "[CQ:reply,id=208162620]你觉得还挺高可能的，毕竟你们也没仔细观察过现在浓郁的魔力的性质"}
