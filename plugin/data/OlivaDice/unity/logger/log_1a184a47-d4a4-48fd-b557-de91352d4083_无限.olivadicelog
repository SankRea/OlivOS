{"time": 1766389757, "type": "recv", "message_id": "597895383", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“那耶稣大人会不会魔法啊”"}
{"time": 1766389772, "type": "recv", "message_id": "913880944", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“他为什么这么厉害啊”"}
