{"time": 1766480243, "type": "recv", "message_id": "382459337", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（以及可以感应魔力了）"}
{"time": 1766480273, "type": "recv", "message_id": "684893014", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "（那就说明可能我前文也没有提）"}
