{"time": 1771859112, "type": "recv", "message_id": "1389758733", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我不应该)"}
