{"time": 1766391272, "type": "recv", "message_id": "2122454386", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（奶不进去就说明没有生命力啊（））"}
{"time": 1766391315, "type": "recv", "message_id": "760415389", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "（话也不能完全那么说）"}
{"time": 1766391377, "type": "recv", "message_id": "563508782", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "那你随便扔了个治疗法术，种子上但是种子没有发出正常的金色光芒而是某种黑色的光，看起来有点萎了"}
