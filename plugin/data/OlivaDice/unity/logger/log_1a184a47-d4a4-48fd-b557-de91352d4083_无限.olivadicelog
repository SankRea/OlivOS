{"time": 1766067286, "type": "recv", "message_id": "477732821", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "仿佛是完全没有限制般的，不少跑车正在街道奔驰，引擎的咆哮冲击着所有人的耳朵"}
{"time": 1766067297, "type": "recv", "message_id": "1236435833", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "#帕特森抖抖耳朵"}
