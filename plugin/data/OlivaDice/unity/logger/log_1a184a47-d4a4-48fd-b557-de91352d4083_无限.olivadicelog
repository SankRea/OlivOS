{"time": 1771316196, "type": "recv", "message_id": "675104107", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "头有点晕晕"}
