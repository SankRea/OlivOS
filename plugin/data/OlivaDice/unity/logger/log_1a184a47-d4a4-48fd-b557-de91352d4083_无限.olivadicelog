{"time": 1766067507, "type": "recv", "message_id": "341252043", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "#猫眼在月光下凝成细线"}
