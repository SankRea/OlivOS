{"time": 1770383813, "type": "recv", "message_id": "2028214492", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（不过问时代确实是问不出来）"}
{"time": 1770383821, "type": "recv", "message_id": "1988093005", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(也的确)"}
{"time": 1770383827, "type": "recv", "message_id": "756732942", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(算了不重要，只是寒暄)"}
{"time": 1770383851, "type": "recv", "message_id": "108143654", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“时代？嗯.........那个时候，我的家附近还有罗马的教堂”"}
{"time": 1770383899, "type": "recv", "message_id": "1163106046", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“所以，你们也是穿越者？”"}
{"time": 1770383938, "type": "recv", "message_id": "501258212", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“不完全是。”"}
{"time": 1770383973, "type": "recv", "message_id": "2044721134", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“但确实是‘穿越’过来的”"}
{"time": 1770384020, "type": "recv", "message_id": "1205222767", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“也？”咳了咳，认真了一些，重新转向渡星者“至少应该不来自这个世界，虽然理论上也有相连的可能……我叫森原华，原本所在的国家叫做日本”"}
{"time": 1770384075, "type": "recv", "message_id": "884450177", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我有些疑问，不知您愿不愿意为我解惑？”"}
{"time": 1770384131, "type": "recv", "message_id": "1134730523", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我倒是更奇怪一点哦？”笑着开口，“我来自更平和的世界，吗？好吧，其实魔族很多啦。”"}
{"time": 1770384133, "type": "recv", "message_id": "1865972334", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“嗯，说吧，如果是想在我这里打下手的话也可以”"}
{"time": 1770384243, "type": "recv", "message_id": "1757774428", "deleted": true, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“阁下最初为什么会认为异界存在呢？我自己在亲历穿越之前，从来没想过这种事情……别的世界，什么事”"}
{"time": 1770384251, "type": "recv", "message_id": "199755477", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“阁下最初为什么会认为异界存在呢？我自己在亲历穿越之前，从来没想过这种事情……别的世界，什么的”"}
{"time": 1770384312, "type": "recv", "message_id": "1412231237", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“嗯.........哦，你们还不知道？”"}
{"time": 1770384342, "type": "recv", "message_id": "574116451", "deleted": true, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“很久以前，其就存在的魔族就是从异世界来访的魔神所创造的子民”"}
{"time": 1770384352, "type": "recv", "message_id": "1905077114", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“很久以前起就存在的魔族就是从异世界来访的魔神所创造的子民”"}
{"time": 1770384368, "type": "recv", "message_id": "1974977416", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“所以我相信一定有个属于神明的世界”"}
{"time": 1770384523, "type": "recv", "message_id": "1492841380", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "[CQ:image,summary=&#91;吼吼&#93;,file=1b-1b4602e6937318881fec6ad824d1df94.gif,url=https://gxh.vip.qq.com/club/item/parcel/item/1b/1b4602e6937318881fec6ad824d1df94/raw300.gif,key=398625738c6b011a,emoji_id=1b4602e6937318881fec6ad824d1df94,emoji_package_id=209658]"}
{"time": 1770384584, "type": "recv", "message_id": "248907078", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“原来如此……不知那些魔族长什么样子？如果我没见过的话，我应该并不来自那个世界”"}
{"time": 1770384612, "type": "recv", "message_id": "681979884", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“不过，我听闻阁下成名已久……没想到居然是这副模样”"}
{"time": 1770384689, "type": "recv", "message_id": "1805918248", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“永驻青春其实不是什么难事。”"}
{"time": 1770384721, "type": "recv", "message_id": "2064215957", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“嗯..........我想你们应该都不是”渡星者看了下你们“我只是寿命与他人相较更长久些而已”"}
{"time": 1770384792, "type": "recv", "message_id": "388536069", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“看起来我们不是同个世界”雷内看着你们，也点了点头“这样也就能证明是存在许多世界了”"}
{"time": 1770384802, "type": "recv", "message_id": "1257085421", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“诶诶？我就是魔族，魔族啦。”指着自己，“红魔族哦？”"}
{"time": 1770384837, "type": "recv", "message_id": "1421355799", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(什么)"}
{"time": 1770384840, "type": "recv", "message_id": "1731519949", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(你是红魔)"}
