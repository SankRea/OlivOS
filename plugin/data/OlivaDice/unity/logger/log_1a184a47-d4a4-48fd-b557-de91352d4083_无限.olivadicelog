{"time": 1771401760, "type": "recv", "message_id": "994855686", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "第八王子不知道去哪了，你们要怎么找"}
