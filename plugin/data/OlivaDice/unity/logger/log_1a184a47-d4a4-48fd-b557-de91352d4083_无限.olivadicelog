{"time": 1772200528, "type": "recv", "message_id": "1465775142", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你在另一边啊（）"}
{"time": 1772200534, "type": "recv", "message_id": "1325843102", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“天道和神明不是一个东西”"}
{"time": 1772200551, "type": "recv", "message_id": "2105041331", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "（铸币）"}
