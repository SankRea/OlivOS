{"time": 1771401967, "type": "recv", "message_id": "1334333555", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "那么第二天凌晨你可以得到人魔战争或者旧天勇者其中的一个在皇家图书馆的信息"}
{"time": 1771402004, "type": "recv", "message_id": "6249313", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(那没老八我还能干什么)"}
