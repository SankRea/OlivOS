{"time": 1771817680, "type": "recv", "message_id": "1591029894", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“那也不会全学校直播吧”"}
