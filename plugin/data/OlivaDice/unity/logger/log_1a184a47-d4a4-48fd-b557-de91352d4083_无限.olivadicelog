{"time": 1771402138, "type": "recv", "message_id": "247546", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（反正我情报同步给你们了）"}
