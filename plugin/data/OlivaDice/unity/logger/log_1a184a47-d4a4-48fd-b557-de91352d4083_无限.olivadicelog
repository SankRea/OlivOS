{"time": 1770388663, "type": "recv", "message_id": "2010231303", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "（你又没问他）"}
{"time": 1770388674, "type": "recv", "message_id": "66352762", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "（不过我在想，要是有人被召唤过来了，她还有办法送回去吗）"}
{"time": 1770388674, "type": "recv", "message_id": "1316409601", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "（他是外人）"}
