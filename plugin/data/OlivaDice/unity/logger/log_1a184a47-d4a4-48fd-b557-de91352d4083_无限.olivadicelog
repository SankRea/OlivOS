{"time": 1771490621, "type": "recv", "message_id": "1238028269", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "（六王子是直接获得部分贵族的支持，魔法学院本身既没钱也没物，除开六王子以个人名义挖到的矿）"}
{"time": 1771490636, "type": "recv", "message_id": "474803480", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(原来都是一帮废物.jpg)"}
{"time": 1771490655, "type": "recv", "message_id": "733331585", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(没事了，贵族怎么爆米就是贵族的事情了。)"}
{"time": 1771490662, "type": "recv", "message_id": "2032081721", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(与我们无关)"}
{"time": 1771490681, "type": "recv", "message_id": "2113488847", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(那么接下来要做的事情是联系八王子和刷技能)"}
{"time": 1771490701, "type": "recv", "message_id": "1051580179", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(仙仙能去的话，我就去图书馆了)"}
