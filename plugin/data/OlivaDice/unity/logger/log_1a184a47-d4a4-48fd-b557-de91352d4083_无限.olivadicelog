{"time": 1766389572, "type": "recv", "message_id": "922527181", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“姐姐，那天父有现身过吗”"}
