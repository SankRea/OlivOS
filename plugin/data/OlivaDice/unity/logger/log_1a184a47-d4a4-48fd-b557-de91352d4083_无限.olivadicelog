{"time": 1768219157, "type": "recv", "message_id": "281481896", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“她居然是悬赏目标?”"}
{"time": 1768219225, "type": "recv", "message_id": "918372895", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“希望不会遇到她吧，不然可能要被攻击”"}
{"time": 1768219276, "type": "recv", "message_id": "2027396185", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"反正可以摸鱼不上工不是吗？随便走走就好。\""}
{"time": 1768219310, "type": "recv", "message_id": "1052552283", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“不……她没说过吧”"}
{"time": 1768219358, "type": "recv", "message_id": "1213616781", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“如果她是清道夫，怎么都不该对身为可疑人员还扬言要炸了试验所的我们那么友善”"}
{"time": 1768219369, "type": "recv", "message_id": "4602985", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“哦，看来我记错了”"}
{"time": 1768219379, "type": "recv", "message_id": "667161411", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“她说的是她的师傅在骑士团”"}
{"time": 1768219407, "type": "recv", "message_id": "1653659937", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“不会就是这个教官吧”"}
{"time": 1768219428, "type": "recv", "message_id": "225574943", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“看来是了”"}
{"time": 1768219432, "type": "recv", "message_id": "1483927694", "deleted": true, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“可能就是这个骑士长……碰到了再说吧。不过我不介意和这些首领直接开战……被黑白两道夹在中间怎么都不对吧”"}
{"time": 1768219440, "type": "recv", "message_id": "751836249", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“可能就是这个骑士长……碰到了再说吧。不过我不建议和这些首领直接开战……被黑白两道夹在中间怎么都不对吧”"}
{"time": 1768219446, "type": "recv", "message_id": "312955032", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“我在想我们能从这些黑帮身上获得什么信息”"}
{"time": 1768219458, "type": "recv", "message_id": "1203040419", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“也没说要直接开战”"}
{"time": 1768219481, "type": "recv", "message_id": "573410092", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“法外之地自有法外之地的用处....”"}
{"time": 1768219488, "type": "recv", "message_id": "1106931355", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“你们说是吧。”"}
{"time": 1768219521, "type": "recv", "message_id": "1683733103", "deleted": true, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "但是无论如何，不先立个牌坊也不便于行动。"}
{"time": 1768219528, "type": "recv", "message_id": "992049754", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“但是无论如何，不先立个牌坊也不便于行动。”"}
