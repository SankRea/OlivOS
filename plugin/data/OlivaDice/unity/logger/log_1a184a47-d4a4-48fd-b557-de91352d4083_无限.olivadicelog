{"time": 1771853169, "type": "recv", "message_id": "14206145", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "（虽然你们也不赖）"}
