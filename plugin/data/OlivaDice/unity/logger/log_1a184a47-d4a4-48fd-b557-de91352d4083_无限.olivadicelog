{"time": 1770386151, "type": "recv", "message_id": "1968318323", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“是什么让他犹豫？”"}
