{"time": 1772208858, "type": "recv", "message_id": "673625686", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "（概念性的指向要用额外的效果了）"}
{"time": 1772208868, "type": "recv", "message_id": "1210648838", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(彳亍)"}
