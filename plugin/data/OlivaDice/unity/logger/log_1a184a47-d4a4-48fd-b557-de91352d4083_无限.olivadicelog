{"time": 1771817478, "type": "recv", "message_id": "1673353468", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“我也没想到才一天，不过这场晚宴是特意给我们接风洗尘的吗”"}
{"time": 1771817515, "type": "recv", "message_id": "569334976", "deleted": true, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“呵呵，”"}
