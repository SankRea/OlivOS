{"time": 1766067318, "type": "recv", "message_id": "720653520", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“不过我们都是俊男靓女，真的不会被盯上吗”"}
