{"time": 1766389310, "type": "recv", "message_id": "535438266", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "（老资历这一块）"}
