{"time": 1772202817, "type": "recv", "message_id": "532740777", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“这次见面我也会去”"}
{"time": 1772202902, "type": "recv", "message_id": "877989116", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“我们应该先回去报告”伏黑开口说"}
{"time": 1772202924, "type": "recv", "message_id": "715878796", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“啊.........我觉得没关系”虎杖左看看右看看，随后开口说“我一个人去”"}
{"time": 1772202955, "type": "recv", "message_id": "1971290691", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“你一个人？开什么玩笑！”伏黑皱着眉头说"}
{"time": 1772202988, "type": "recv", "message_id": "67781362", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“放心吧，我也会一起的，或者你们返回需要多久”"}
{"time": 1772202999, "type": "recv", "message_id": "1780386984", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“没事，我相信帕特森他们，你们先回去吧，我们不在这里见他们不会知道在这里的”虎杖摆了摆手"}
{"time": 1772203016, "type": "recv", "message_id": "2118562789", "deleted": true, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“他们进来的时候没有隐身”伏黑说道"}
{"time": 1772203053, "type": "recv", "message_id": "363129799", "deleted": true, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“啊.......”虎杖露出有些尴尬的神情，随后说“反正我们找到不难，再换个新地方吧”"}
