{"time": 1771490326, "type": "recv", "message_id": "1952697605", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(感觉冒险者协会可以做到武装本地土著)"}
{"time": 1771490332, "type": "recv", "message_id": "6213532", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(是吧)"}
{"time": 1771490334, "type": "recv", "message_id": "401887649", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(但是会长完全没这个意思)"}
{"time": 1771490345, "type": "recv", "message_id": "1678500471", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(因为他没有脑子)"}
{"time": 1771490368, "type": "recv", "message_id": "103848073", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“不过我还是想提个醒。”"}
{"time": 1771490398, "type": "recv", "message_id": "2143570181", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "（纯粹一个莽夫）"}
