{"time": 1766067054, "type": "recv", "message_id": "1632031599", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "#帕特森习惯性伸手想要rua猫"}
