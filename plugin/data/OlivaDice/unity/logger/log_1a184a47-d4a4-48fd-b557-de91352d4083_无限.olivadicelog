{"time": 1766377152, "type": "recv", "message_id": "2086066239", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "（这个说的是那群袭击者）"}
{"time": 1766377154, "type": "recv", "message_id": "170753258", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "[CQ:reply,id=1934183627][CQ:at,qq=825734198] （这是回答我询问的问题）"}
{"time": 1766377158, "type": "recv", "message_id": "1814190492", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（公司对那个组织的官方命名？）"}
{"time": 1766377164, "type": "recv", "message_id": "984230461", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "（嗯）"}
