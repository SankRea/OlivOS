{"time": 1771946117, "type": "recv", "message_id": "498880881", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“我是五条悟哦”"}
{"time": 1771946151, "type": "recv", "message_id": "1051363", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“叫我帕特森就行，五条悟？先生，”"}
{"time": 1771946170, "type": "recv", "message_id": "1990481000", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“先生你就是那个高专的管理人吗”"}
{"time": 1771946194, "type": "recv", "message_id": "842194695", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“对对，嘛，我不是管理人，不过这么想也没问题啦，听说你们是来帮忙拯救世界的？”"}
{"time": 1771946229, "type": "recv", "message_id": "1289089759", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“对了对了，我们这边正在开交流会呢，要不要你们组个队过来啊”"}
{"time": 1771946232, "type": "recv", "message_id": "72899080", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "[CQ:image,summary=&#91;动画表情&#93;,file=11DF10A2E401E8E2818ECF27E814E059.jpg,sub_type=1,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhQY-5LunQBjX6Hymf7ah1q6rAoRNRiPuAIg_woo9PvxjbbykgMyBHByb2RQgL2jAVoQ6B8qzgm6cFF-eP8gzX5gCnoCemCCAQJneg&amp;rkey=CAISMBBFiYfU7ZN8fXzqhPzSoHig8PJLgRdov8OE5SyBYTc1edBE1OU-YJOEZYe3wPgSMg,file_size=39951]"}
{"time": 1771946290, "type": "recv", "message_id": "2014176527", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“交流会？组队？”"}
{"time": 1771946308, "type": "recv", "message_id": "231182049", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“我们也要参加吗，一般不是当观众吗”"}
{"time": 1771946317, "type": "recv", "message_id": "885689425", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“是这样啦，你们团建有几个人啊？够不够五个？”"}
{"time": 1771946326, "type": "recv", "message_id": "1551252142", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“玩玩而已啦，我听说你们了”"}
