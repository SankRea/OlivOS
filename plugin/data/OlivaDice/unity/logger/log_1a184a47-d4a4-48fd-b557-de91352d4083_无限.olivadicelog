{"time": 1770571857, "type": "recv", "message_id": "1288362311", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "辛苦了"}
