{"time": 1766378772, "type": "recv", "message_id": "1418489043", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "【回去找华处理一下】"}
{"time": 1766378782, "type": "recv", "message_id": "1024332962", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“同样由未来公司植入，我是最为特殊的研究体，与其他被抛弃的人不同，我是逃出来的”"}
{"time": 1766378800, "type": "recv", "message_id": "641721934", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“....你还真放心跟我们讲这个”"}
{"time": 1766378804, "type": "recv", "message_id": "137317427", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呃，什么?什么什么根，这不跟小说一样了吗？\""}
{"time": 1766378811, "type": "recv", "message_id": "2110255800", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“血根骑士团毫无疑问的只是血之根”"}
{"time": 1766378816, "type": "recv", "message_id": "267593613", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“不怕我们抖出去吗”"}
{"time": 1766378855, "type": "recv", "message_id": "816584007", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“还是说，其实你对他们没有利用价值了。”"}
{"time": 1766378881, "type": "recv", "message_id": "453374968", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“你们不一样，不了解未来公司，更不了解血根骑士团，还是别的组织”"}
{"time": 1766378908, "type": "recv", "message_id": "1759828870", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“你们不依托于三根其一来使用魔法是吗”"}
{"time": 1766378915, "type": "recv", "message_id": "314607903", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“你猜对了。”"}
{"time": 1766378950, "type": "recv", "message_id": "1028091409", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“你们是更诱人的靶子，所以我自然不怕”"}
{"time": 1766378954, "type": "recv", "message_id": "1752102502", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“是的，魔力算是我们与生俱来的，其实我们或许有办法治好你这个”"}
{"time": 1766378981, "type": "recv", "message_id": "1658412122", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我更好奇的是 这些所谓根的来由，还有具体种类。听起来应该不只有这三种？”"}
{"time": 1766378990, "type": "recv", "message_id": "1344943764", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（听起来像什么变身器（）"}
{"time": 1766378993, "type": "recv", "message_id": "433620651", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "#耸了耸肩"}
{"time": 1766379002, "type": "recv", "message_id": "384345737", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“你赢了喵。”"}
{"time": 1766379068, "type": "recv", "message_id": "114359214", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“谁知道呢”"}
{"time": 1766379086, "type": "recv", "message_id": "1285322723", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“我并非未来公司的内部成员”"}
{"time": 1766379114, "type": "recv", "message_id": "95820855", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“那，你有试过把这些……取出来吗？”"}
{"time": 1766379173, "type": "recv", "message_id": "570249511", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“华，你会断肢重生吗”"}
{"time": 1766379199, "type": "recv", "message_id": "1851035233", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"听着像什么小说啦，就是那个，灵根，灵根对吧？\""}
{"time": 1766379203, "type": "recv", "message_id": "1940866350", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“现在还不行啦……”"}
{"time": 1766379208, "type": "recv", "message_id": "774578523", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "#点头"}
{"time": 1766379218, "type": "recv", "message_id": "1458826245", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“应该就是灵根”"}
{"time": 1766379238, "type": "recv", "message_id": "737423199", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“但是如何溯源也是个问题”"}
{"time": 1766379256, "type": "recv", "message_id": "927919584", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我也想试试诶，这种...不过，感觉会很有风险。\""}
{"time": 1766379268, "type": "recv", "message_id": "600366531", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“要是亚麻你想摆脱这些的话，我们或许可以帮你”"}
{"time": 1766379275, "type": "recv", "message_id": "452026313", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“我当然不会那么干”她摇了摇头，也确实不像是有那个打算的样子"}
{"time": 1766379296, "type": "recv", "message_id": "1157391686", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "[CQ:forward,id=7586541309371564616]"}
{"time": 1766379348, "type": "recv", "message_id": "1932863601", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“行吧，咱们加个联系方式吧，有什么需要联系的也方便些”"}
{"time": 1766379567, "type": "recv", "message_id": "1351729600", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "那她给你们留了个dd的联系方式，似乎这人只在家用电脑这种终端，吃喝之类的全靠外卖的样子，完全不出门"}
{"time": 1766379602, "type": "recv", "message_id": "1520964409", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“外卖不贵吗”"}
