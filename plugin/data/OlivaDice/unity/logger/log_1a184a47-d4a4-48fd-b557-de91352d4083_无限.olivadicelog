{"time": 1772200523, "type": "recv", "message_id": "1495701114", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你是？）"}
