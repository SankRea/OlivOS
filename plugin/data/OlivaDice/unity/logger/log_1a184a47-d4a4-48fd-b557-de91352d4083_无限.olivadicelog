{"time": 1771397074, "type": "recv", "message_id": "1462308195", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "你很确定他是光张嘴没说话"}
