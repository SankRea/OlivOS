{"time": 1770381100, "type": "recv", "message_id": "1102900027", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "934419034"}, "sender": {"id": "934419034", "name": "永远的星辉守护"}, "message": "（）"}
{"time": 1770381123, "type": "recv", "message_id": "1984210738", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“异世界人，吗？”"}
{"time": 1770381131, "type": "recv", "message_id": "484057890", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "#拱手礼"}
{"time": 1770381141, "type": "recv", "message_id": "1129545692", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "（好，是老婆）"}
{"time": 1770381143, "type": "recv", "message_id": "2045029938", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“进来吧，不用讲究那么多”"}
{"time": 1770381167, "type": "recv", "message_id": "1454404872", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“是，渡星者阁下。”"}
{"time": 1770381184, "type": "recv", "message_id": "898343199", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "#那么进去"}
{"time": 1770381250, "type": "recv", "message_id": "1568241107", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“初次见面。”跟着进去，拉着安娜。"}
{"time": 1770381358, "type": "recv", "message_id": "1337417617", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“你好，我是安娜”安娜连忙行了个礼，跟在身后"}
{"time": 1770381371, "type": "recv", "message_id": "584528847", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“我是玖茗。”"}
{"time": 1770381415, "type": "recv", "message_id": "200149725", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“我听说你们是出现在皇宫庭院？”"}
{"time": 1770381489, "type": "recv", "message_id": "931738949", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“是的。”"}
{"time": 1770381602, "type": "recv", "message_id": "79318325", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“真是奇怪啊，对了，你们是有问题要问我？”"}
{"time": 1770381609, "type": "recv", "message_id": "1349439802", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“嗯，听说是阁下研究的召唤阵法。”观察着对方，“久疏介绍，我叫仙仙。”"}
{"time": 1770381767, "type": "recv", "message_id": "1442780869", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "[CQ:image,summary=&#91;动画表情&#93;,file=11DF10A2E401E8E2818ECF27E814E059.jpg,sub_type=1,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhQY-5LunQBjX6Hymf7ah1q6rAoRNRiPuAIg_woo2d--gvLEkgMyBHByb2RQgL2jAVoQNVvYHkThSzuP_Y0ExM21vHoC642CAQJneg&amp;rkey=CAMSMCkZSoGdn3KFyz9xuvTG8Vo9S2N-fYE_xX0hf1rFCSA0tEui_KjzX5OKRtzFRMUjrg,file_size=39951]"}
{"time": 1770381936, "type": "recv", "message_id": "958096459", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "（问题是？）"}
{"time": 1770381999, "type": "recv", "message_id": "2015895218", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "（问题是？）"}
{"time": 1770382092, "type": "recv", "message_id": "405594992", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（不是你们要问吗？）"}
{"time": 1770382138, "type": "recv", "message_id": "1882864004", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“容我冒昧，我想先确认——召唤的阵法有好好的发动过吗？”"}
{"time": 1770382194, "type": "recv", "message_id": "1716937884", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "[CQ:image,file=C68ED5FB4409097EC6910C9DF0B24B86.jpg,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhTOuBNPnXlAabbgwyupcL4K7blRFRiiuQQg_woo-ru_zvPEkgMyBHByb2RQgL2jAVoQU-18WIiSdztX9vrkfyd5G3oCxfeCAQJneg&amp;rkey=CAMSMCkZSoGdn3KFyz9xuvTG8Vo9S2N-fYE_xX0hf1rFCSA0tEui_KjzX5OKRtzFRMUjrg,file_size=72866]"}
{"time": 1770382296, "type": "recv", "message_id": "1663329207", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“因为是新的魔法，我想应该是有，不过珈奇斯大人不久前刚来说教了我一顿，应该不会再研究了”渡星者捋了捋满地的材料，正在画着其他法阵"}
{"time": 1770382414, "type": "recv", "message_id": "1521692887", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "[CQ:image,summary=&#91;吼吼&#93;,file=1b-1b4602e6937318881fec6ad824d1df94.gif,url=https://gxh.vip.qq.com/club/item/parcel/item/1b/1b4602e6937318881fec6ad824d1df94/raw300.gif,key=398625738c6b011a,emoji_id=1b4602e6937318881fec6ad824d1df94,emoji_package_id=209658]"}
{"time": 1770382417, "type": "recv", "message_id": "1227823841", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "#猫猫思考"}
{"time": 1770382442, "type": "recv", "message_id": "2021460007", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“实验阶段的魔法吗，这种魔法就没有失控的风险吗”"}
{"time": 1770382451, "type": "recv", "message_id": "236577618", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“这样。”捉摸不透她的态度，不过在这种时候也不好说什么，关于更敏感的话题也不是这种场合可以开口的，停下花头"}
{"time": 1770382453, "type": "recv", "message_id": "864793893", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "话头"}
{"time": 1770382531, "type": "recv", "message_id": "780644060", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“确实，比如你们不就是在皇宫庭院被召唤过来的，讲究的来说我不清楚到底有没有成功发动”"}
{"time": 1770382582, "type": "recv", "message_id": "847378834", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(我们要说实话吗)"}
{"time": 1770382602, "type": "recv", "message_id": "1186366507", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(还是演一下)"}
{"time": 1770382658, "type": "recv", "message_id": "1942371456", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“理论上……再尝试一次就知道了？”"}
