{"time": 1771859122, "type": "recv", "message_id": "472780575", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(师兄给我打解药吗？)"}
