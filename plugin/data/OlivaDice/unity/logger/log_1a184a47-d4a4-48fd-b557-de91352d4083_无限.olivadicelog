{"time": 1772184611, "type": "recv", "message_id": "1350852368", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(我现在最怕的事情)"}
{"time": 1772184620, "type": "recv", "message_id": "132773817", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(是宿傩和龙王合伙)"}
{"time": 1772184630, "type": "recv", "message_id": "719061642", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“仙仙知道的魔法理论和君焰很搭配，现在极限温度已经高达3k摄氏度，在学院的测量仪器被我烧爆了”"}
{"time": 1772184630, "type": "recv", "message_id": "1448863397", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(那人类玩完了)"}
{"time": 1772184638, "type": "recv", "message_id": "1134052848", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（吸赛博龙脉吧可能）"}
{"time": 1772184699, "type": "recv", "message_id": "1914315940", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(我烧的还不错)"}
{"time": 1772184701, "type": "recv", "message_id": "1232395799", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(挺好吃)"}
{"time": 1772184708, "type": "recv", "message_id": "831549946", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"点点头，\"师兄确实天赋异禀。\"随后看向路明非，\"路同学?你学了哪些?\""}
{"time": 1772184715, "type": "recv", "message_id": "474344971", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“学院现在会按每个人不同的言灵来分配学习的魔法理论。路明非.........”"}
{"time": 1772184734, "type": "recv", "message_id": "293415085", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“我全都要学”路明非有些尴尬的刮了刮自己的脸颊“我能正常使用魔法”"}
{"time": 1772184761, "type": "recv", "message_id": "795540305", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（厉害）"}
{"time": 1772184776, "type": "recv", "message_id": "1438193499", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“?”"}
{"time": 1772184779, "type": "recv", "message_id": "755091995", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“有趣”"}
{"time": 1772184788, "type": "recv", "message_id": "1879387520", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“你不受体制限制的话......”"}
{"time": 1772184795, "type": "recv", "message_id": "816094866", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "【龙王么】"}
{"time": 1772184817, "type": "recv", "message_id": "1732108308", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶?S级的话确实比我还要厉害。\"指了指自己，\"我只能掌握一小部分。\""}
{"time": 1772184828, "type": "recv", "message_id": "1019955370", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "楚子航在旁边说道“但是他这个学期的五系魔法理论全挂了”"}
{"time": 1772184831, "type": "recv", "message_id": "948764234", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "【或者大概率，是个纯血】"}
{"time": 1772184840, "type": "recv", "message_id": "479397084", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“学徒级别只到了开头”"}
{"time": 1772184848, "type": "recv", "message_id": "872164037", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(应该没有我的理论吧？我没公开)"}
{"time": 1772184851, "type": "recv", "message_id": "1641710328", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“哈，那可有的要补”"}
{"time": 1772184867, "type": "recv", "message_id": "654565944", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“会用，但是理论不通关？”"}
{"time": 1772184887, "type": "recv", "message_id": "1769951525", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“本来我的成绩就不怎么好，挂也是很正常的吧！”路明非骂道似乎很不甘心“我以前可是文科的...........这个不就是理科”"}
{"time": 1772184888, "type": "recv", "message_id": "907066031", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"耸耸肩，\"不过路同学的话，应该没问题。\""}
{"time": 1772184925, "type": "recv", "message_id": "881762345", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "#自己和他们两个不熟，干脆登陆论坛看一下情况，我们离开的这段时间发生了什么，反对我们的声音有多少"}
{"time": 1772184948, "type": "recv", "message_id": "1469747049", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“哎，以前我明明是个吃竹子混日子的熊猫，今天怎么就变成要自己去抓田鼠的老鹰了”路明非叹了一口气"}
{"time": 1772184963, "type": "recv", "message_id": "720187144", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "[CQ:image,file=6793BE467C2BC8C7A50571A18D652CFE.jpg,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhTjwM-lvvJui61iwzbcTFkjFuBJWRiBuAEg_woo6Nenua_5kgMyBHByb2RQgL2jAVoQbKMMGFjvzTxCbAdvR40cGnoC4PKCAQJuag&amp;rkey=CAESMH0ndsx3T-nbL_J8tns4xv4IbYFV2aIOsgCuaVamWsZsVMSR11eRh-LSglDqy3kFnA,file_size=23553]"}
{"time": 1772185001, "type": "recv", "message_id": "1544598185", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“至少能用这一点，就足以证明S级的特殊性吧”笑了笑“一年过去，师兄的桃花运如何？”"}
{"time": 1772185019, "type": "recv", "message_id": "1987671678", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "[CQ:reply,id=881762345]似乎反对你们声音大概是四成，本来按常理而言，反对你们的声音应该才是大多数，但看来魔法理论潜移默化的改变了大多数人对你们的看法"}
{"time": 1772185049, "type": "recv", "message_id": "1791340096", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "自己就不说话了，坐在一边，低头看看手机。一边撩起垂下的头发，\"我们什么时候去上海?\""}
{"time": 1772185088, "type": "recv", "message_id": "920164444", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "[CQ:reply,id=1544598185]楚子航沉默着，随后干脆直接说“无”"}
{"time": 1772185149, "type": "recv", "message_id": "1940173946", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "[CQ:reply,id=1791340096]路明非靠到了你的旁边嚷嚷道“校长到了之后我们就可以离开了，啊.....说起来仙仙你们在异世界是不是经常屠龙斩妖除魔，然后拿到大堆财宝？”"}
{"time": 1772185218, "type": "recv", "message_id": "942815318", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "#自己有些想要联系拉洁娜，但是这次有些危险，按捺住了，倒是在和自己人偶玩拳击"}
{"time": 1772185225, "type": "recv", "message_id": "1914649438", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "摇头，\"屠龙，斩妖，除魔。\"继续摇头，\"都没有，反而是惹了不少麻烦。\"揉揉眉心，\"话说去上海要做什么?\""}
{"time": 1772185269, "type": "recv", "message_id": "1272249133", "deleted": true, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(好像这次，法伽蒂没说是什么人物吧)"}
{"time": 1772185275, "type": "recv", "message_id": "452365282", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(好像这次，法伽蒂没说是什么任务吧)"}
{"time": 1772185298, "type": "recv", "message_id": "1209925026", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "路明非被梗了下接一下这个话题“我不太清楚，不过听师兄说是SS级的任务，老危险了”"}
{"time": 1772185305, "type": "recv", "message_id": "1662694709", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "（说了和上次一样）"}
