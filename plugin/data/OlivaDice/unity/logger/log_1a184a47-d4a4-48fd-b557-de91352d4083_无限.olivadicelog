{"time": 1766067459, "type": "recv", "message_id": "1190547092", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(差不多)"}
{"time": 1766067482, "type": "recv", "message_id": "769725998", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "“白色的月亮，这还是第一次见，原本我还以为是红色月亮呢。。。不过我们现在也要行动起来了，咱们找谁比较好”"}
{"time": 1766067489, "type": "recv", "message_id": "2104466578", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "#有卫星或者近地轨道之类的异常悬浮物体吗"}
