{"time": 1766484153, "type": "recv", "message_id": "1940431344", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "修女沉默着没有接你们两个的话茬"}
{"time": 1766484230, "type": "recv", "message_id": "405116674", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“既然要打算干掉她，那也没什么说不得的吧？”"}
{"time": 1766484333, "type": "recv", "message_id": "1953655691", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“..........祂是三月女神其一”"}
{"time": 1766484375, "type": "recv", "message_id": "1015002341", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“赤月，白月，暗月中，赤月的化身其一”"}
{"time": 1766484407, "type": "recv", "message_id": "1144871282", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好的，那我知道是什么个玩意了。\"叹口气，\"为了杀掉她，你可以付出什么代价。\""}
{"time": 1766484447, "type": "recv", "message_id": "1830405168", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你说的好理所当然（）"}
