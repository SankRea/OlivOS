{"time": 1772025651, "type": "recv", "message_id": "1245628115", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“下午，各位休息片刻之后就可以入场了”"}
{"time": 1772025680, "type": "recv", "message_id": "1709170108", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“啊，我来带你们过去吧”五条悟伸手示意你们跟上"}
