{"time": 1766067110, "type": "recv", "message_id": "1213522066", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "背着包，手上什么也没拿。先靠近巷口听听外面的动静"}
{"time": 1766067137, "type": "recv", "message_id": "1710126860", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“瘾君子....”"}
