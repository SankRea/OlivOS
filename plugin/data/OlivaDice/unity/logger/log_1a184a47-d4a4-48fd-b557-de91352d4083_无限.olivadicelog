{"time": 1766485229, "type": "recv", "message_id": "1744144198", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "（人家是要打化身）"}
{"time": 1766485270, "type": "recv", "message_id": "1637206499", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“如果引爆地下的炸弹，地下会炸的只剩下玻璃”"}
{"time": 1766485427, "type": "recv", "message_id": "1885024026", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"地下埋着炸药，对吧？\"表情逐渐染上些笑容"}
{"time": 1766485485, "type": "recv", "message_id": "1003203434", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“呜啊，要不我们先走吧。”看到仙仙的表情就知道她在想什么“沾到一点都很麻烦的”"}
{"time": 1766485580, "type": "recv", "message_id": "1370129546", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“嗯”对方只是静静的回应了，没有太大的反应"}
{"time": 1766485667, "type": "recv", "message_id": "276642869", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哼哼，先去地上吧。\""}
{"time": 1766485673, "type": "recv", "message_id": "1891134280", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“别急，先别急啦……炸这一下也会死不少人的吧？”"}
{"time": 1766485683, "type": "recv", "message_id": "1263215943", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（说起来跟在她后面走没收到魂吗）"}
{"time": 1766485708, "type": "recv", "message_id": "913405287", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "手心滑出另一只增幅威力的魔杖，\"半径一公里，连锁引爆地下的炸药，足够吗？\""}
{"time": 1766485879, "type": "recv", "message_id": "824544186", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“会有警示的”"}
{"time": 1766485883, "type": "recv", "message_id": "133415118", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "（无）"}
