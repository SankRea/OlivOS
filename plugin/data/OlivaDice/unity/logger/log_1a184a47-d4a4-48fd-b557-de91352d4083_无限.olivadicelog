{"time": 1766389838, "type": "recv", "message_id": "478526031", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(耶稣跟天父不是一个人吗)"}
