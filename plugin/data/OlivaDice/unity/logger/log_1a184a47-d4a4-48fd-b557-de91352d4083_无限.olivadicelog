{"time": 1766390041, "type": "recv", "message_id": "1009674404", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(嗯，理解)"}
