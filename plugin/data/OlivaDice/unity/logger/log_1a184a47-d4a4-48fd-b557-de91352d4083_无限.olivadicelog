{"time": 1772184051, "type": "recv", "message_id": "1186179870", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“那是自然”"}
