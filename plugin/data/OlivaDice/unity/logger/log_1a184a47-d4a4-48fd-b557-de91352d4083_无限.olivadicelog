{"time": 1766377129, "type": "recv", "message_id": "1041808726", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "1085444390"}, "sender": {"id": "1085444390", "name": "Accelerator"}, "message": "（骑士团是袭击未来公司的组织）"}
{"time": 1766377131, "type": "recv", "message_id": "1396401565", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“嗯，要说起来，我确实是渐冻症患者，和魔法无关”"}
