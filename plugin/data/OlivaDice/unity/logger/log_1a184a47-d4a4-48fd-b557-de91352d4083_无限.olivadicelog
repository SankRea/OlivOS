{"time": 1770556773, "type": "recv", "message_id": "847735395", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“是。”"}
{"time": 1770556796, "type": "recv", "message_id": "808006427", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“看来我们已经在宫廷里广为人知了。”"}
{"time": 1770556893, "type": "recv", "message_id": "529884614", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“虽不知我的同伴与你们交谈如何”"}
{"time": 1770556905, "type": "recv", "message_id": "1225912679", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“不过我也有些许疑问想要请教”"}
{"time": 1770556933, "type": "recv", "message_id": "993911155", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“大臣在如此敏感的时期和八王子私会，不会有什么不妥吗”"}
{"time": 1770556971, "type": "recv", "message_id": "2078898306", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“如果说是恰是这个时候才应该呢”"}
{"time": 1770557021, "type": "recv", "message_id": "1128714523", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“哦?大臣不怕被其他人讴病？”"}
{"time": 1770557047, "type": "recv", "message_id": "298419136", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“如果是我，至少是在遗嘱公布之后”"}
{"time": 1770557079, "type": "recv", "message_id": "599950572", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "“谁知道呢”时臣露出了些许无奈的神情，晃了晃手中的酒杯"}
{"time": 1770557107, "type": "recv", "message_id": "921269000", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(嘴很严)"}
{"time": 1770557124, "type": "recv", "message_id": "1384951972", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "961142868"}, "sender": {"id": "961142868", "name": "不会在的人"}, "message": "（算已经漏信了）"}
{"time": 1770557174, "type": "recv", "message_id": "1563103783", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "(已经漏给八王子了是吧)"}
{"time": 1770557200, "type": "recv", "message_id": "1885427464", "deleted": false, "dect": {"host_id": null, "group_id": "1141869747", "user_id": "2275904091"}, "sender": {"id": "2275904091", "name": "冰黎曦"}, "message": "“那么大臣如何看待当今各个王储?”"}
