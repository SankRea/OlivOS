{"time": 1755672771, "type": "recv", "message_id": "259776985", "deleted": false, "dect": {"host_id": null, "group_id": "1056564993", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "（我觉得我说的挺明白了）"}
