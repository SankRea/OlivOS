{"time": 1770646289, "type": "recv", "message_id": "1275083231", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "光屏上干干净净，没有什么像"}
{"time": 1770646579, "type": "recv", "message_id": "368584395", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "老师讲到实虚的时候，你注意到班长直愣愣地转过了一些身子，直直看向星野鶫的位置"}
