{"time": 1770638410, "type": "recv", "message_id": "1288013627", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "#观察老师的动作，趁其不注意去拿纸团"}
{"time": 1770638520, "type": "recv", "message_id": "1153980244", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "老师似乎没刻意关照你，你把纸团捡了起来"}
{"time": 1770638592, "type": "recv", "message_id": "204391051", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "#隐蔽地在课本的遮挡下打开纸团看看"}
{"time": 1770638748, "type": "recv", "message_id": "529563703", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“嗨~新同学，总感觉以前见过你呢？来自哪里？叫什么？嗯，哦，矢吹绫对吧~”隔着纸张你似乎都能听到女生的咯咯笑声"}
{"time": 1770638838, "type": "recv", "message_id": "1958297520", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "#倒是留个名字啊喂"}
{"time": 1770638850, "type": "recv", "message_id": "454789635", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "#四周观察"}
{"time": 1770638859, "type": "recv", "message_id": "868233804", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "就在你这么想着的时候，紧接着第二个纸条扔到了你的脚下"}
{"time": 1770638973, "type": "recv", "message_id": "635183301", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "#如法炮制，打开纸团"}
{"time": 1770639221, "type": "recv", "message_id": "454345331", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“很好奇我叫什么吧？”她的字迹俏皮，“不想告诉你呢~保持神秘是女孩子的魅力之一吧？但是要是想和我聊聊天，要和我聊哦？人家好无聊的~把纸条递到后座的桌子底下就好啦。”"}
{"time": 1770639279, "type": "recv", "message_id": "1044515719", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "#后座、后座是谁来着？"}
{"time": 1770639355, "type": "recv", "message_id": "3302849", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "后座，你似乎没有和ta交谈过"}
{"time": 1770639428, "type": "recv", "message_id": "825742665", "deleted": true, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "#不管了，画朵花递过去“我以前见鬼你吗？”"}
{"time": 1770639462, "type": "recv", "message_id": "1993239637", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "#不管了，画朵花递过去“我以前见过你吗？”"}
{"time": 1770639692, "type": "recv", "message_id": "1249446925", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "这次稍微等了一会，老师正在点起班长回答问题，纸条才洛到你的脚下"}
{"time": 1770639695, "type": "recv", "message_id": "1636286995", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（落）"}
{"time": 1770639791, "type": "recv", "message_id": "553663763", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "#即使是第三次，也贯彻第一次的谨慎，打开纸团"}
{"time": 1770640059, "type": "recv", "message_id": "1411158243", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“见过？不如说终于被你找到了？”字迹活泼，“当然啦，开个玩笑~能不能说点有意思的话题啦~绫是东京来的吧~”"}
{"time": 1770640064, "type": "recv", "message_id": "910596928", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "可以灵感一下"}
