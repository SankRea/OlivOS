{"time": 1772355612, "type": "recv", "message_id": "1379937542", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "甚至称得上说，有些奇怪。"}
{"time": 1772355637, "type": "recv", "message_id": "1652527562", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "暴雨冲刷着周围的一切。"}
