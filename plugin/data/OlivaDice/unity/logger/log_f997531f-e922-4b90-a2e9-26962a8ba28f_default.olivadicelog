{"time": 1770810949, "type": "recv", "message_id": "1147325071", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "一片静默，只剩下水声"}
