{"time": 1770810800, "type": "recv", "message_id": "695992283", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "#开窗看看"}
