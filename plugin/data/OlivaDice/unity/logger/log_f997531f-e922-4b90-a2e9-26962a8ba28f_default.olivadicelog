{"type": "log_total_duration", "total_time": 0}
{"time": 1770198108, "type": "reply", "message_id": "2073237353", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "开始记录乐谱"}
{"time": 1770198244, "type": "recv", "message_id": "300873187", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "十月的一天，如果要说日历的话，也许是第二个木曜日，你通过了入学的申请，并在这一天正式加入三年三班，教务处的走廊飘着旧木头和消毒水混合的味道，插花大多死气沉沉，本该秋高气爽的时节硬是压着些夏日未去的沉闷感，你和你的班主任见了面。"}
{"time": 1770198307, "type": "recv", "message_id": "1294036310", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "#看着班主任"}
{"time": 1770198381, "type": "recv", "message_id": "1388030931", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "这是一个打理得一丝不苟，或者说略有些刻意的中年男子，有着很深的眼袋，板正的眼镜下有一双满是疲态的双眼，只是简单扫视了你一下，就继续看自己手里的纸质文件了，“听说，你是从东京都来？”"}
{"time": 1770198471, "type": "recv", "message_id": "1359883580", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“是，是的”"}
{"time": 1770198489, "type": "recv", "message_id": "1105530969", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "#低着头，用刘海挡住老师的目光"}
{"time": 1770198764, "type": "recv", "message_id": "1383151889", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“怎么在这个时候转学。”他的语气轻描淡写，似乎只是简单地询问，“当然我知道校方已经通过了你的申请，不过...这个时候放弃东京的教育，来这里...”他放下文件，“从我个人角度，比较好奇。”"}
{"time": 1770198805, "type": "recv", "message_id": "487750513", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“是”"}
{"time": 1770198814, "type": "recv", "message_id": "337898220", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“身体方面的原因……”"}
{"time": 1770199269, "type": "recv", "message_id": "2018965658", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“身体方面？”他似乎觉得有些失礼，没有继续开口追问，“嘛，来到新的环境总是有些不适应的，如果是这方面的话，午休快过去了，下午的介绍上，我会让班里的同学注意一下。”他点了点自己的眉头，“只要安心学习，考上合适的大学，不会出什么事。”"}
{"time": 1770199308, "type": "recv", "message_id": "554619261", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“嗯”"}
