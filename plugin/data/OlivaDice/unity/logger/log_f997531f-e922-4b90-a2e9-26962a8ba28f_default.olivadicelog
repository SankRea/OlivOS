{"time": 1770809389, "type": "recv", "message_id": "601030626", "deleted": false, "dect": {"host_id": null, "group_id": "1036106955", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "#关上窗户，继续复习"}
