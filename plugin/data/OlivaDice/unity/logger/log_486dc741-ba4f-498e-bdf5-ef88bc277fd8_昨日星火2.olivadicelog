{"time": 1757336903, "type": "recv", "message_id": "18915126", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "（其实也不太算原创，不过是试用一下）"}
