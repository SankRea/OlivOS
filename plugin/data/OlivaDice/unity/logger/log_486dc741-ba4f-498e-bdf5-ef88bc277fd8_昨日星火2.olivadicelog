{"time": 1757512797, "type": "recv", "message_id": "306268147", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "[CQ:reply,id=1872079498]（）"}
{"time": 1757512837, "type": "recv", "message_id": "2039301873", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "你记得，这个告示台的作用，是升起一个直达三楼柱子"}
{"time": 1757512872, "type": "recv", "message_id": "45328594", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "#静心向那个蓝色的少女祈祷"}
{"time": 1757512892, "type": "recv", "message_id": "163863355", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "铃看着这个告示台，散发光芒的瞳孔似乎看穿了一切"}
{"time": 1757512915, "type": "recv", "message_id": "621407837", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”之前看不出来，但是现在的我能够看到。“"}
{"time": 1757512933, "type": "recv", "message_id": "1086533431", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”这个柱子上，似乎有大量的魔力萦绕“"}
{"time": 1757512992, "type": "recv", "message_id": "1330995233", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "“这些魔力来源于哪里？”"}
{"time": 1757513009, "type": "recv", "message_id": "565930777", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”应该，是大厅里面的那些尸体“"}
{"time": 1757513028, "type": "recv", "message_id": "2076469968", "deleted": true, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”这里，是情深仪式的残余“"}
{"time": 1757513047, "type": "recv", "message_id": "1558784661", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "“但看起来他们还没有成功？”"}
{"time": 1757513062, "type": "recv", "message_id": "1735400965", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”不，他们已经成功了“"}
{"time": 1757513071, "type": "recv", "message_id": "1928335127", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”我就是仪式的结果“"}
{"time": 1757513089, "type": "recv", "message_id": "1028675472", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”这里，是请神仪式的残余“"}
{"time": 1757513093, "type": "recv", "message_id": "35728917", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "（这里回溯一下）"}
{"time": 1757513101, "type": "recv", "message_id": "1637145245", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "（打错字了）"}
{"time": 1757513141, "type": "recv", "message_id": "138082241", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”我所获得的知识，应该来自于那位神明“"}
{"time": 1757513229, "type": "recv", "message_id": "1450852652", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“而现在，我们恐怕得请他离开了”"}
{"time": 1757513244, "type": "recv", "message_id": "759044779", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "“我可不可以利用这些剩下的魔力，然后念出刚刚的那个咒语，请ta离开？”"}
{"time": 1757513272, "type": "recv", "message_id": "682381757", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "[CQ:reply,id=759044779]“我也是这么想的”"}
{"time": 1757513321, "type": "recv", "message_id": "1892941499", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "“事不宜迟，我们开始吧”"}
{"time": 1757513364, "type": "recv", "message_id": "1025824440", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "＃先利用自己随身携带的仪式物品，进行一个简单的准备"}
{"time": 1757513384, "type": "recv", "message_id": "413711787", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "铃缓缓走上了柱状平台"}
{"time": 1757513392, "type": "recv", "message_id": "1577868872", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“说实话，我不确定进行仪式后还能活下来……”"}
{"time": 1757513414, "type": "recv", "message_id": "1870240419", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“不管结果如何，枫，你一定要活着离开这里”"}
{"time": 1757513417, "type": "recv", "message_id": "313051318", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "“铃一定会活下去的”"}
{"time": 1757513422, "type": "recv", "message_id": "1954857725", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“答应我，好吗？”"}
{"time": 1757513423, "type": "recv", "message_id": "712498842", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "“不要说这种话”"}
