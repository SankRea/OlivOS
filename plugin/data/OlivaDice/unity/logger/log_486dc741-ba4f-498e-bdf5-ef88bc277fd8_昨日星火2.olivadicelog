{"time": 1757513471, "type": "recv", "message_id": "1119974870", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "她苦笑道：”枫果然是枫呢，无论何时都不会离开我“"}
{"time": 1757513495, "type": "recv", "message_id": "1965846121", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”好吧，我答应枫，我会活着回来的”"}
{"time": 1757513516, "type": "recv", "message_id": "1253380172", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "随后，她按下上升的按钮"}
{"time": 1757513525, "type": "recv", "message_id": "1769125970", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "“我相信你，铃是不会骗我的”＃但是声音有所颤抖"}
{"time": 1757513544, "type": "recv", "message_id": "140518295", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”哦对了，枫，有一件特别重要的事，你一定要听我的“"}
