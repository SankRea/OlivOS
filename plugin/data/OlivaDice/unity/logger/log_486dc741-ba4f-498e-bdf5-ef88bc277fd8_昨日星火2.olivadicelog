{"time": 1757513579, "type": "recv", "message_id": "1140139676", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "“好”"}
