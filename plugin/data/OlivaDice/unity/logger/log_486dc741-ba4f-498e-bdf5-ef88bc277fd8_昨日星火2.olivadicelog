{"time": 1757337078, "type": "recv", "message_id": "4044681", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“谢谢枫，枫最好啦”"}
