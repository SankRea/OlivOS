{"time": 1757504915, "type": "recv", "message_id": "1786463535", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "“当年到底发生了什么……你愿意告诉我嘛…”"}
{"time": 1757504924, "type": "recv", "message_id": "1425191910", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "“我可以帮你”"}
{"time": 1757504974, "type": "recv", "message_id": "1269798751", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "顿了一会，铃将过去的事情娓娓道来："}
{"time": 1757505011, "type": "recv", "message_id": "295109905", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "某一天，家里来了奇怪的客人"}
{"time": 1757505054, "type": "recv", "message_id": "289366056", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“他们看起来像是父母的挚友，现在看来应该是这个组织的人员”"}
{"time": 1757505108, "type": "recv", "message_id": "1828915917", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”后来，父母俩人一起去外地出差，一直没有回来“"}
{"time": 1757505150, "type": "recv", "message_id": "372730054", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”我觉得不太对劲，于是外出寻找他们“"}
{"time": 1757505175, "type": "recv", "message_id": "1799461364", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”那天，雨下得很大“"}
{"time": 1757505201, "type": "recv", "message_id": "2130597943", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”我被雨水蒙蔽了视线，再没能找到他们“"}
{"time": 1757505243, "type": "recv", "message_id": "1547618941", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”不过好在，辛奈阿姨找到了我。“"}
{"time": 1757505287, "type": "recv", "message_id": "250318503", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”他说，我的父母有一个十分重要的秘密工作要完成，会有很长的时间不会回来“"}
{"time": 1757505311, "type": "recv", "message_id": "28874741", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "（她？）"}
{"time": 1757505340, "type": "recv", "message_id": "1927862785", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”但我看着辛奈阿姨悲伤的脸，知道父母大概永远不会回来了吧“"}
{"time": 1757505346, "type": "recv", "message_id": "230740930", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "[CQ:reply,id=28874741]（小问题）"}
