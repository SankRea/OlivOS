{"time": 1757512723, "type": "recv", "message_id": "1289655327", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（wc，泡泡来了）"}
