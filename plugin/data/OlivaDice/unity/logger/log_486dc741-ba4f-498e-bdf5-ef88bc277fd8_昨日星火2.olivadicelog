{"time": 1757505428, "type": "recv", "message_id": "63106733", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "说完，她顿了顿，继续说到："}
