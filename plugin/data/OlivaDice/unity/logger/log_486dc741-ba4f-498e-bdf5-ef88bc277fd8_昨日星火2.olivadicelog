{"time": 1757336617, "type": "recv", "message_id": "880094996", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "这张简历被铃丢在一旁，似乎不是她想找的那一份"}
