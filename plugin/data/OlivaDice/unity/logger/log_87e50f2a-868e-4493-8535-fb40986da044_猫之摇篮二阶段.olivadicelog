{"time": 1774168869, "type": "recv", "message_id": "2116433546", "deleted": false, "dect": {"host_id": null, "group_id": "938830904", "user_id": "3166982250"}, "sender": {"id": "3166982250", "name": "一一"}, "message": "*疲惫的从床上起来收拾好书包"}
