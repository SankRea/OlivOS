{"time": 1774769839, "type": "recv", "message_id": "2118184349", "deleted": false, "dect": {"host_id": null, "group_id": "938830904", "user_id": "3222503301"}, "sender": {"id": "3222503301", "name": "劇場愛歌"}, "message": "（kp这么问我害怕了）"}
{"time": 1774769883, "type": "recv", "message_id": "1472398618", "deleted": false, "dect": {"host_id": null, "group_id": "938830904", "user_id": "3166982250"}, "sender": {"id": "3166982250", "name": "一一"}, "message": "（又没说要抓我们，他无视我们走进去了，我们要在原地等他们吗？）"}
{"time": 1774769886, "type": "recv", "message_id": "260264825", "deleted": false, "dect": {"host_id": null, "group_id": "938830904", "user_id": "2037978956"}, "sender": {"id": "2037978956", "name": "en"}, "message": "（走啊）"}
{"time": 1774769895, "type": "recv", "message_id": "44694420", "deleted": false, "dect": {"host_id": null, "group_id": "938830904", "user_id": "3362422751"}, "sender": {"id": "3362422751", "name": "维兹"}, "message": "不远处先前门口的警察注视着你们，手放在腰间"}
{"time": 1774769900, "type": "recv", "message_id": "619930861", "deleted": false, "dect": {"host_id": null, "group_id": "938830904", "user_id": "2037978956"}, "sender": {"id": "2037978956", "name": "en"}, "message": "（他也没说我们被逮捕了对吧）"}
{"time": 1774769913, "type": "recv", "message_id": "1370867499", "deleted": false, "dect": {"host_id": null, "group_id": "938830904", "user_id": "3091099280"}, "sender": {"id": "3091099280", "name": "诶呀"}, "message": "（算了吧，等一下他觉得我们心虚就直接抓我们了呢）"}
{"time": 1774769961, "type": "recv", "message_id": "2040238534", "deleted": false, "dect": {"host_id": null, "group_id": "938830904", "user_id": "3362422751"}, "sender": {"id": "3362422751", "name": "维兹"}, "message": "另外还有两位警察也在皱眉盯着你们"}
