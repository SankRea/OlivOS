{"time": 1775893157, "type": "recv", "message_id": "763321562", "deleted": false, "dect": {"host_id": null, "group_id": "938830904", "user_id": "3166982250"}, "sender": {"id": "3166982250", "name": "一一"}, "message": "“应该是托马斯的信徒吧”"}
