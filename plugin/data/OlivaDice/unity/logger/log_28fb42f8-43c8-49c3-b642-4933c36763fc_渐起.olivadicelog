{"time": 1761302548, "type": "recv", "message_id": "261651565", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我就在外面等着）"}
