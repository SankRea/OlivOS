{"time": 1761213521, "type": "recv", "message_id": "275047108", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（现在又没有路灯的说法）"}
{"time": 1761213543, "type": "recv", "message_id": "1767065331", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“好啦好啦，我不会有事的。快走吧。”"}
{"time": 1761213553, "type": "recv", "message_id": "147001828", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（好的，你是对的）"}
{"time": 1761213605, "type": "recv", "message_id": "169422939", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯哼，去吧去吧”"}
{"time": 1761213655, "type": "recv", "message_id": "1681289505", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "推着伊恩出门，“真的要去那么贵的地方吗？”出了门才开口，“我们去吃点炖菜也挺好吧...暖和一点。”"}
{"time": 1761213658, "type": "recv", "message_id": "1145301026", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“阿姨再见”出发，前往衫云寨!"}
{"time": 1761213681, "type": "recv", "message_id": "493876119", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好不容易请舒茉吃一顿饭，当然要吃点好的啦”"}
{"time": 1761213848, "type": "recv", "message_id": "1236549442", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“好吧...”事已至此也不好再说扫兴的话，“那就出发吧”"}
{"time": 1761213862, "type": "recv", "message_id": "1015826258", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯嗯，走吧走吧”"}
{"time": 1761213890, "type": "recv", "message_id": "778587159", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "和舒茉并排走着，吹着晚风，有种很惬意的感觉"}
{"time": 1761214054, "type": "recv", "message_id": "2105897835", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“舒茉明天第一次出远门呢...”看着暗下来的天色，说话声音很轻，“有些...期待...”"}
{"time": 1761214061, "type": "recv", "message_id": "446608304", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（吃个饭）"}
{"time": 1761214323, "type": "recv", "message_id": "2077587727", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "衫云栈位于镇南，临近的只有一个建筑，看起来就是新的招待所。它是镇里为数不多的三层建筑之一，入夜之后它也是最亮堂的。入口处的拱门不是在柱子上雕出花纹，而是直接雕成了精灵与衫树的模样"}
{"time": 1761214477, "type": "recv", "message_id": "1748159121", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"说起来，每年都会来这里吃一次饭呢...”站在门口，等待身边的人先进去。"}
{"time": 1761214553, "type": "recv", "message_id": "738258726", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（对一个没有生日的人说这个是不是有点地狱）"}
