{"time": 1761212724, "type": "recv", "message_id": "1256783082", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "自己还有200银币，怎么来说应该也够用了吧，之后再去打几天零工好了"}
{"time": 1761212771, "type": "recv", "message_id": "368702102", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那我们就去衫云寨吧”"}
{"time": 1761213016, "type": "recv", "message_id": "1208136258", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（那我的衣服呢）"}
