{"time": 1760898573, "type": "recv", "message_id": "1361418223", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶...\"突然被问起懂不懂矿石，\"呃..啊...可能...懂吧。\"接着妈妈手里拎着的肉，\"咳咳..回家。\""}
{"time": 1760898597, "type": "recv", "message_id": "1038451241", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“行啊，谢谢你。今天晚上要不就来我们家吃晚饭？”"}
{"time": 1760898620, "type": "recv", "message_id": "1427506543", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（怎么和我抢）"}
