{"time": 1761899860, "type": "recv", "message_id": "1272083248", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（怎么感觉像睡着了）"}
