{"time": 1761895628, "type": "recv", "message_id": "666182704", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（哎哎，女追男隔层纱）"}
{"time": 1761895712, "type": "recv", "message_id": "713745314", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我会永远支持舒茉的”大声说道"}
{"time": 1761895760, "type": "recv", "message_id": "264996678", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（哎，棒读）"}
{"time": 1761895791, "type": "recv", "message_id": "688261506", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"不行不行，要换一句，就像你以前偷偷说过的。\"摇头，头发像波浪一般流动。"}
{"time": 1761895924, "type": "recv", "message_id": "1525072979", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "看了眼叔叔阿姨，然后凑到舒茉耳边小声说道“以这片星空为誓，我要和舒茉永远在一起”"}
{"time": 1761896251, "type": "recv", "message_id": "1626998918", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哼哼...\"伸出自己的右手，\"伊恩之前也这么说，但是...没有遵守说过的话。\"停了一会，\"这一次呢...?\""}
{"time": 1761896293, "type": "recv", "message_id": "1891243421", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“既然这次我都已经在这里了.....以后也没什么能分开我们了”"}
{"time": 1761896347, "type": "recv", "message_id": "1263161092", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“这是在说什么呢？”舒蕾在前面不远处回过头来“好像有人在说悄悄话”"}
{"time": 1761896518, "type": "recv", "message_id": "829919066", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "缩回手抚弄耳畔垂下的发丝，有些脸红，\"妈妈是不是都听见了？\""}
{"time": 1761896768, "type": "recv", "message_id": "87110521", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“以后会有更好的机会...”"}
{"time": 1761896774, "type": "recv", "message_id": "1540315056", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“怎么，有我不能听的内容吗？”她似笑非笑"}
{"time": 1761896841, "type": "recv", "message_id": "51608016", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没有啦没有啦...\"快步跟上妈妈的脚步，自然地抱着她的手臂，\"只是在想未来的日子嘛。\""}
{"time": 1761897055, "type": "recv", "message_id": "317733983", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“是嘛……那之后要找时间再说给我听”她看上去颇为认真"}
{"time": 1761897283, "type": "recv", "message_id": "103473346", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "乖巧地点点脑袋，\"得赶快到合适的地方，休息了。\""}
{"time": 1761897310, "type": "recv", "message_id": "1532749076", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "离舒蕾一段距离，害怕被她打"}
{"time": 1761897376, "type": "recv", "message_id": "1049506030", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（是这样的，如果你怕最爱她的人）"}
{"time": 1761897387, "type": "recv", "message_id": "955880206", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那就说明还不够格）"}
{"time": 1761897403, "type": "recv", "message_id": "1721532727", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（还没准备好）"}
{"time": 1761897614, "type": "recv", "message_id": "564046280", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "她看见你的瑟缩，似乎有些失望，没说什么“……嗯，走吧。希望能吃上早饭”"}
{"time": 1761898398, "type": "recv", "message_id": "560910822", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "沿途都没什么意外再发生。草地尽头是一片黑珍珠般的湖泊。沿着湖泊边缘，总算走上了干燥平坦的大路"}
{"time": 1761898628, "type": "recv", "message_id": "1948332304", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“呼，到这里就……马车的动静会很大，听见了再躲起来也来得及。”舒蕾松了口气，把舒茉扯到身前，帮你拍着裙角沾上的草叶和小虫子"}
{"time": 1761899167, "type": "recv", "message_id": "1722177892", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（）"}
