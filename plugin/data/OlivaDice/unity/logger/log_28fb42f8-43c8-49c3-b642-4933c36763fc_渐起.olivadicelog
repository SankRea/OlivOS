{"time": 1761041030, "type": "recv", "message_id": "588508584", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"看在今天保护我受伤的份上...\"松开妈妈的手臂，走到伊恩身边伸出手"}
{"time": 1761041350, "type": "recv", "message_id": "1245416338", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“谢谢...”低着头，有一点点开心"}
{"time": 1761041389, "type": "recv", "message_id": "1500810911", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=2047194965]（幻想你第一个想到的那个）"}
{"time": 1761041417, "type": "recv", "message_id": "2139902276", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(别忙着开心，动起来喵)"}
{"time": 1761041463, "type": "recv", "message_id": "665698067", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "然后在舒茉的搀扶下慢慢的走着，故意走的慢一点"}
{"time": 1761041532, "type": "recv", "message_id": "194617628", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（哪有那么虚）"}
{"time": 1761041537, "type": "recv", "message_id": "595221444", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...\"察觉到了他的动作，但是也没点破"}
{"time": 1761041609, "type": "recv", "message_id": "1556217449", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=194617628]（故意的啊（）"}
{"time": 1761041636, "type": "recv", "message_id": "359381537", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"真是的...神官小姐明明都治疗过你了吧。\"小声喃喃"}
{"time": 1761041713, "type": "recv", "message_id": "380334335", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那个药...让人感觉..没什么力气...”说出了比较拙劣的谎言，药效很早就过去了，以至于没什么底气"}
{"time": 1761041981, "type": "recv", "message_id": "441168303", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"真的吗？\"撇撇手，搀扶的手掐着他身上的软肉，\"算了，就当是这样吧。\""}
{"time": 1761042042, "type": "recv", "message_id": "1330467185", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "好痛，但是忍过去了，装作没什么感觉的样子“是啊，你掐我，我都没什么感觉...”"}
{"time": 1761042085, "type": "recv", "message_id": "1336282784", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "舒蕾偶尔扭过头来看你们一眼，倒是没说什么。走在你们前面一点点"}
{"time": 1761042294, "type": "recv", "message_id": "786192348", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没感觉?\"笑得有些僵硬，\"真的吗？撒谎的孩子要吞一千根针。\""}
{"time": 1761042426, "type": "recv", "message_id": "343020909", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "被拆除了有点不好意思“对不起..我只是...想和舒茉..在一起多待一会...和舒茉在一起，很开心...”"}
{"time": 1761042531, "type": "recv", "message_id": "1966731012", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶...\"这下轮到自己脸红了，\"说...说什么！?\"下意识想推开他，好在克制住了，\"不要突然说这种话...\""}
{"time": 1761042541, "type": "recv", "message_id": "1154905970", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=343020909]（穿）"}
{"time": 1761042573, "type": "recv", "message_id": "820533219", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（好快的攻防转换）"}
{"time": 1761042631, "type": "recv", "message_id": "1035750314", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...”不在多说什么，静静的走着，不过步伐稍微快了一点点，毕竟舒蕾阿姨偶尔还会回头看一下，哪怕什么都不说，光现在这样已经很好了"}
{"time": 1761042807, "type": "recv", "message_id": "1833801546", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "感觉有点别扭，偏着头，也不说什么"}
{"time": 1761042972, "type": "recv", "message_id": "1619636759", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "路当然也没多远，日渐西沉，虽然还没落山，但林木也遮挡了不少热力。你们很快回到了舒茉家"}
{"time": 1761043091, "type": "recv", "message_id": "1033739988", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "松开搀扶的手，感觉身体比平常热一些，拉开一些自己的领口，\"妈...我去洗澡...\""}
{"time": 1761043106, "type": "recv", "message_id": "542034587", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“谢谢...”"}
