{"time": 1761304546, "type": "recv", "message_id": "1213138635", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你在人家门口跑步问隔音差吗）"}
{"time": 1761304571, "type": "recv", "message_id": "674095714", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那就没听见）"}
{"time": 1761304598, "type": "recv", "message_id": "252818309", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "在玄关整理一下衣服的褶皱，深吸一口气准备开门"}
{"time": 1761304645, "type": "recv", "message_id": "559482463", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“拜拜~”"}
{"time": 1761304708, "type": "recv", "message_id": "1729452006", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "盯着门看"}
{"time": 1761304714, "type": "recv", "message_id": "1409414742", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"拜拜～\"推开门"}
{"time": 1761304754, "type": "recv", "message_id": "1696597323", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“早上好啊，舒茉”看见舒茉出来给她打招呼"}
{"time": 1761304886, "type": "recv", "message_id": "1295901356", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"早上好～\"挥舞手臂，\"诶，怎么这么早就在这。\""}
{"time": 1761304917, "type": "recv", "message_id": "314380623", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"不会伊恩一直等在门口吧?\"秋日的冷风吹过，双手捂住嘴巴呼气"}
{"time": 1761304931, "type": "recv", "message_id": "1716349612", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“运气...比较好吧...我也是刚...来”稍微有点喘"}
{"time": 1761304955, "type": "recv", "message_id": "111886217", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "同时也有一点点心虚"}
{"time": 1761305119, "type": "recv", "message_id": "254394312", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "提着小手提包，今天的头发扎成了两束，看上去清爽了不少。\"嗯哼?\"露肩针织羊毛衣配上白色的风衣加上特意戴着的腰带，显得很是轻快活泼，\"是吗？就当是这样好了～\""}
{"time": 1761305156, "type": "recv", "message_id": "562865728", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我来帮舒茉拿吧”朝她手上的包把手伸过去"}
{"time": 1761305352, "type": "recv", "message_id": "117733392", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"既然这么自觉的话～\"把包递给他，双手背在身后，呼吸着秋天清新的空气，心情大好，哼着自创的小调子，\"哼哼...哼...哼哼～\""}
{"time": 1761305527, "type": "recv", "message_id": "1297556597", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "很开心的跟在舒茉后面“走喽，话说，我们这应该算出门旅游吧”"}
{"time": 1761305595, "type": "recv", "message_id": "1769909525", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"算是?不过，我可是带着目的呢。\""}
{"time": 1761305629, "type": "recv", "message_id": "1271207980", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“？什么目的呢”有些好奇，自己的目的大概就是和舒茉一起出去玩吧"}
{"time": 1761305772, "type": "recv", "message_id": "889813544", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"考察一下前线的样子，然后把伊恩都在那里。\"语气软绵绵地"}
{"time": 1761305862, "type": "recv", "message_id": "1811443630", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哎？不要这么说啦”"}
{"time": 1761305911, "type": "recv", "message_id": "911420554", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(丢)"}
{"time": 1761305959, "type": "recv", "message_id": "70254229", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哼哼，这才是我的主要目的。\"走快一点，没拿东西一身轻松"}
{"time": 1761306098, "type": "recv", "message_id": "2003486383", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "不过也许去前线也对吧...自己现在的全部身家太少了，根本无法负担起两人的未来"}
{"time": 1761306125, "type": "recv", "message_id": "683390877", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "沉默的跟在后面，安静的思考...."}
{"time": 1761306201, "type": "recv", "message_id": "346515021", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我会认真考虑一下的...不过不只是为了我的未来”"}
{"time": 1761306206, "type": "recv", "message_id": "964511135", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(该上路了说是)"}
{"time": 1761306271, "type": "recv", "message_id": "203806088", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶...\"难得他改口，抬抬眉毛，顺着话说，\"能想清楚就再好不过了。\""}
{"time": 1761306378, "type": "recv", "message_id": "171436025", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（好困）"}
{"time": 1761306389, "type": "recv", "message_id": "509778994", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "(然后半夜起来猛攻？"}
{"time": 1761306448, "type": "recv", "message_id": "569357883", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(龙哥不是要下班了?)"}
{"time": 1761306465, "type": "recv", "message_id": "49000016", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(到九点要自动断章了)"}
{"time": 1761306522, "type": "recv", "message_id": "920151504", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（）"}
{"time": 1761306641, "type": "recv", "message_id": "488542985", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "今天没有继续降温，与昨日一般，但由于是清晨，因此仍有些寒意。商队上，两辆不大的马车在村口等待"}
{"time": 1761306692, "type": "recv", "message_id": "877869856", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "看看负责的人在哪，大方地走上前"}
{"time": 1761306793, "type": "recv", "message_id": "958536132", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "紧随其后"}
{"time": 1761306910, "type": "recv", "message_id": "2037233380", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "没有专门设立，马夫就是售票员"}
{"time": 1761306952, "type": "recv", "message_id": "530205488", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“大叔，去前线的票，两张”"}
{"time": 1761306980, "type": "recv", "message_id": "862180600", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "既然伊恩开了口，那索性只是点点头"}
