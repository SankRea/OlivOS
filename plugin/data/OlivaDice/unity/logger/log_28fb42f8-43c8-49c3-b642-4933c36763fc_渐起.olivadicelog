{"time": 1762308816, "type": "recv", "message_id": "1970083439", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你那个做了好多年的梦）"}
{"time": 1762308817, "type": "recv", "message_id": "502072378", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（要是我有尖尖耳朵，我还能猜猜我是魔界人（）"}
{"time": 1762308821, "type": "recv", "message_id": "151002402", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（oh）"}
{"time": 1762309029, "type": "recv", "message_id": "1392029755", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "\"不过我好像经常会做一个梦，梦见自己在一片水域，看不到底，也看不到岸....\""}
{"time": 1762309108, "type": "recv", "message_id": "1774736593", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“当然，你现在也沉浮着。不过抓住了些东西”她把水晶球前推“把手放上来吧”"}
{"time": 1762309125, "type": "recv", "message_id": "251826642", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "把手放在水晶球上"}
{"time": 1762309346, "type": "recv", "message_id": "1137304276", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "水晶球里像是装满了水，此时晶莹的反光扭曲旋转了起来，像个漩涡。水晶球没有随着你的手掌变暖起来"}
{"time": 1762309362, "type": "recv", "message_id": "1448849725", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "她的眉头不着痕迹地跳了跳"}
{"time": 1762309437, "type": "recv", "message_id": "1207998805", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "抬头期待的看向她"}
{"time": 1762309454, "type": "recv", "message_id": "290641058", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“真稀奇……尽管夜空之下无新事。”"}
{"time": 1762309657, "type": "recv", "message_id": "1591511864", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"咦...\"这和自己那时倒是不太一样..."}
{"time": 1762309797, "type": "recv", "message_id": "2053149194", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“你的过去，在混沌之中，水面之下。只有你自己能看见”她叹了口气“我没法说你自己知道的东西，但看起来不安稳”"}
{"time": 1762309826, "type": "recv", "message_id": "565629405", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“？”不太懂什么意思"}
{"time": 1762309863, "type": "recv", "message_id": "1017031710", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（听得懂就不是神棍了）"}
{"time": 1762310068, "type": "recv", "message_id": "781335960", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“但是我感觉我什么都不知道啊”"}
{"time": 1762310157, "type": "recv", "message_id": "1549266101", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“你什么都知道，只不过忘了而已”"}
{"time": 1762310192, "type": "recv", "message_id": "1504272374", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那我有办法想起来吗”"}
{"time": 1762310211, "type": "recv", "message_id": "1980036285", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“看在我们都是漂泊命的份上，给你……”她的话说到一半，突然停下了。噼啪的裂声介入了对话"}
{"time": 1762310222, "type": "recv", "message_id": "1441231734", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“呃...?”"}
{"time": 1762310386, "type": "recv", "message_id": "1390100057", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "水晶球发出了你听过一遍的声音。不过面上看不见裂纹。似乎裂口在被压在底座上的部分"}
{"time": 1762310414, "type": "recv", "message_id": "1215480557", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“(⊙o⊙)…不会需要我赔钱吧...”"}
{"time": 1762310736, "type": "recv", "message_id": "1460196658", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"厄运?\""}
{"time": 1762310790, "type": "recv", "message_id": "965658507", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "随后水晶球变得污浊起来，比夜色更深沉，像深渊的喉咙。噼啪声停了下来，但是似乎漆黑的液体在从水晶球与底座相接的部分溢出。她瞳孔紧缩，腾地站起后退，椅子也被带倒。小小的篷子内一下混乱了起来"}
{"time": 1762310987, "type": "recv", "message_id": "1770999162", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"啊...?\"下意识伸手把伊恩的手从水晶球上拉开"}
{"time": 1762311018, "type": "recv", "message_id": "999945931", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“？什么意思....”"}
{"time": 1762311154, "type": "recv", "message_id": "1443917329", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "有点被她的反应吓到了"}
{"time": 1762311264, "type": "recv", "message_id": "565711895", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "看起来她比你怕得多，离那水晶球远远的。那黑色液体没打算停下，浸透了大片桌布"}
{"time": 1762311323, "type": "recv", "message_id": "420109648", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"伊恩...退开一些。\"看着眼前的情况，自己也有些害怕，不过下意识挡在前面一些，伸手去触碰那水晶球，想把它捡起来扔掉"}
{"time": 1762311485, "type": "recv", "message_id": "1643675231", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“你……你藏着的东西，可不是什么普通的悲剧”她过了会才平静下来，不过还是离得远远的。“这水晶球，已经没法再用了”"}
{"time": 1762311677, "type": "recv", "message_id": "1016752634", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我藏什么了，藏在哪....”还是不懂"}
{"time": 1762311694, "type": "recv", "message_id": "1714648421", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "好像没出什么问题?水晶球还在自己手里，不过既然没事，把它重新放下。"}
{"time": 1762311703, "type": "recv", "message_id": "1158632877", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=420109648]摸起来倒是没什么特别的"}
{"time": 1762311725, "type": "recv", "message_id": "808838943", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "但是水晶球底部裂开了道两寸长的缝，扎眼得很"}
{"time": 1762311737, "type": "recv", "message_id": "146083762", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "松了口气，\"阿姨能说得更明白一些吗？\""}
{"time": 1762311844, "type": "recv", "message_id": "1750038016", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“说到这些就是全部了。我说过，你们知道的东西，我没法说出来”她摇头“更多的，我能力有限，帮不了你”"}
{"time": 1762311904, "type": "recv", "message_id": "122274860", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好吧....既然我的过去看上去很危险的样子，那我就这样忘掉也挺好的.....”"}
{"time": 1762311943, "type": "recv", "message_id": "458868418", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“不过……”她看起来有些犹豫"}
{"time": 1762311952, "type": "recv", "message_id": "413653532", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...我还知道什么吗？\"确认她的答案，\"我应该知道什么...\""}
{"time": 1762311986, "type": "recv", "message_id": "1630113457", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=413653532]（和你有什么关系.jpg）"}
{"time": 1762312014, "type": "recv", "message_id": "2136165974", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(那她说你们)"}
{"time": 1762312028, "type": "recv", "message_id": "1892209997", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你刚刚才来过啊）"}
{"time": 1762312041, "type": "recv", "message_id": "825907390", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（复述一遍而已）"}
{"time": 1762312045, "type": "recv", "message_id": "1072442516", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(哦)"}
{"time": 1762312059, "type": "recv", "message_id": "1885704811", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(那我也要问啊，我应该知道什么吗)"}
{"time": 1762312069, "type": "recv", "message_id": "100904929", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……我帮不了，也许先祖之魂可以。夜空之下无新事”"}
{"time": 1762312113, "type": "recv", "message_id": "135697782", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=413653532]“我不知道。”她摇头"}
{"time": 1762312243, "type": "recv", "message_id": "1500499738", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那我们怎么去向先祖之魂寻求帮助....”"}
{"time": 1762312276, "type": "recv", "message_id": "1484755112", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（喜闻乐见的带货时间）"}
{"time": 1762312406, "type": "recv", "message_id": "1856330354", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“你不是暗精灵，一般来说祂们不会回应你……不过”她拿出另一个小瓶子“这是传袭多年的酒方，每个英魂都喜爱它”"}
{"time": 1762312460, "type": "recv", "message_id": "2111257235", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "有一种要买酒的感觉“算了....现在这样就挺好的，过去的事情既然很危险，那就忘记吧....”"}
{"time": 1762312469, "type": "recv", "message_id": "1324496572", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...多少钱?\""}
{"time": 1762312636, "type": "recv", "message_id": "857537505", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“酒不贵，49银。但是水晶球和这桌布……”她皱皱眉“也不全让你们赔。收你们一半成本价，75银，然后你们带走吧。我可不敢留”"}
{"time": 1762312756, "type": "recv", "message_id": "1906452636", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“酒真没什么必要吧...至于水晶球”"}
{"time": 1762312774, "type": "recv", "message_id": "1112756150", "deleted": true, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...\"自己的300银币已经花了两百多，眼下还真凑不出这么多钱..."}
{"time": 1762312788, "type": "recv", "message_id": "1141296792", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你哪只300银）"}
{"time": 1762312793, "type": "recv", "message_id": "1664441127", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呃...能便宜一些吗...\""}
{"time": 1762312799, "type": "recv", "message_id": "447938103", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（你不是600银来着么）"}
{"time": 1762312804, "type": "recv", "message_id": "1325579702", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我自己信用的钱)"}
{"time": 1762312814, "type": "recv", "message_id": "173806492", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你之前去防线，舒蕾还给了你300）"}
{"time": 1762312815, "type": "recv", "message_id": "480294844", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(还有300是家里的钱)"}
{"time": 1762312830, "type": "recv", "message_id": "1635315678", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:image,file=661EA67DBCAB0A8C9982E54FBB424A79.jpg,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhSOe7Yzf2aJNblrNs6BZmHvmfOVIBir7gMg_wooj6SN8YbakAMyBHByb2RQgL2jAVoQQFoykBC_hwG2F2L4WcfYeXoChDeCAQJuag&amp;rkey=CAISMIQRb82UQ7edTi_1coYWRBrKeWZZITSW7_46xyELYLAlCNxxgkpoDPgmZmU765PIiA,file_size=63275]"}
{"time": 1762312966, "type": "recv", "message_id": "1184281623", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你不是600？）"}
{"time": 1762312966, "type": "recv", "message_id": "1819672409", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(哦，那我居然有900)"}
{"time": 1762312981, "type": "recv", "message_id": "1844478952", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（虽然砍价也正常吧）"}
{"time": 1762312987, "type": "recv", "message_id": "1448853025", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...能便宜一些吗...我们身上也没有很多钱...\""}
{"time": 1762313021, "type": "recv", "message_id": "1735498210", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（吃个饭）"}
{"time": 1762313031, "type": "recv", "message_id": "924288694", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（[CQ:at,qq=1252219916] 你在家吗）"}
{"time": 1762313038, "type": "recv", "message_id": "66840249", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（在的话帮我取个快递）"}
{"time": 1762313199, "type": "recv", "message_id": "511180046", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……算你们一共110吧，我得收摊了”"}
{"time": 1762313257, "type": "recv", "message_id": "1043610071", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"一个金币吧...\"犹豫"}
{"time": 1762313440, "type": "recv", "message_id": "1378597734", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“哎，好吧好吧，破财消灾……”她看起来比你们还急着走"}
{"time": 1762313494, "type": "recv", "message_id": "191097989", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"所以...这个到底是什么...\"摸索出一个金币，捏在指尖"}
{"time": 1762313534, "type": "recv", "message_id": "1801528805", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“是你们在问的东西”她言简意赅"}
{"time": 1762313633, "type": "recv", "message_id": "441419322", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好吧...不能说更多的吗？阿姨为什么有点怕的样子...\""}
{"time": 1762313857, "type": "recv", "message_id": "24461414", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=191097989]“我来吧，毕竟水晶球是我弄坏的...”"}
{"time": 1762313880, "type": "recv", "message_id": "456565022", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我知道的都说了”她叹气“我也是第一次见这种情况”"}
{"time": 1762313957, "type": "recv", "message_id": "2129766538", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好吧...\"把指尖的金币放在桌上，\"破损的水晶球...呃...伊恩要带着吗？\"低头看一下桌面的黑水"}
{"time": 1762313989, "type": "recv", "message_id": "859465837", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“看起来好不吉利的样子，扔了吧”"}
{"time": 1762314003, "type": "recv", "message_id": "682757814", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "把桌上的金币拿回来塞舒茉手里"}
{"time": 1762314006, "type": "recv", "message_id": "240963355", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（交了钱随你们处理咯）"}
{"time": 1762314020, "type": "recv", "message_id": "2092111334", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“酒也不要了，50银赔偿你的损失”"}
{"time": 1762314050, "type": "recv", "message_id": "547984598", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "掏出50枚银币放在桌子上"}
