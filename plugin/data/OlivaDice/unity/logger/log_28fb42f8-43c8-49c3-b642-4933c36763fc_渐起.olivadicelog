{"time": 1761133351, "type": "recv", "message_id": "1713385000", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "回来之后看看舒茉在干什么"}
