{"time": 1761916943, "type": "recv", "message_id": "1405302408", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(这一定是?)"}
