{"time": 1761357666, "type": "recv", "message_id": "626206314", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "往前线大致的方向，搀扶着伊恩"}
{"time": 1761358217, "type": "recv", "message_id": "158247342", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "伊恩的状态现在看起来相当吓人，侧肋有一个可以看见骨头的伤口。先前吃下的那一鞭似乎还造成了骨裂。看出血量的话他现在怎么都不像还能站着的样子"}
{"time": 1761358408, "type": "recv", "message_id": "332668767", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（[CQ:at,qq=1040972910] ）"}
{"time": 1761358410, "type": "recv", "message_id": "541896179", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "自己完全没有治疗的办法，手头的药物也随着手提箱消失在马车上，\"伊恩...不要睡过去...坚持住...\"只能说些话让伊恩保持清醒，咬着牙让他把身体靠在自己身上。等...等救援到这里。"}
{"time": 1761358763, "type": "recv", "message_id": "480095970", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（感觉翔哥睡着了）"}
{"time": 1761358801, "type": "recv", "message_id": "1834755933", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（没）"}
