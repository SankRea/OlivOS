{"time": 1760898762, "type": "recv", "message_id": "1419927477", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=1594476627]（）"}
{"time": 1760898961, "type": "recv", "message_id": "1562821804", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"啧，行吧。\"递给他，自己空着手走在前面，时不时踢几颗小石子"}
{"time": 1760898999, "type": "recv", "message_id": "519744574", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你的书呢.jpg）"}
{"time": 1760899050, "type": "recv", "message_id": "897862924", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "看她好像不是很开心的样子“要不..我们一起提着？”"}
{"time": 1760899128, "type": "recv", "message_id": "1294492026", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“那你们先回去吧？记得把肉放在水盆里泡着”母亲摇摇头，慢你们一步“我把这些石头送到琼斯那边去加工……舒茉，哪些木材有用没用你分的出来的吧？”"}
{"time": 1760899181, "type": "recv", "message_id": "1513517182", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯嗯。\"点头，\"不会把家里弄得一团糟啦。\""}
