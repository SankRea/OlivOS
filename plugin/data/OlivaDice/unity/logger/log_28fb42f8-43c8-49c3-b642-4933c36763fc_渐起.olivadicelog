{"time": 1761268047, "type": "recv", "message_id": "897588463", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（60版本最有画风的40技能）"}
{"time": 1761268051, "type": "recv", "message_id": "1289158486", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（鬼影闪！）"}
