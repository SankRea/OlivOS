{"time": 1760983923, "type": "recv", "message_id": "1915385822", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(?)"}
{"time": 1760983964, "type": "recv", "message_id": "1567644191", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（无妨，睡了便是，晚安💤）"}
{"time": 1760983976, "type": "recv", "message_id": "159111638", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(人呢)"}
{"time": 1760983978, "type": "recv", "message_id": "266995640", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(别睡)"}
{"time": 1760984021, "type": "recv", "message_id": "1299292677", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“应该不会遇到什么危险吧....”"}
{"time": 1760984068, "type": "recv", "message_id": "537738930", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不过不管怎么样，我不会让舒茉受到伤害的”"}
{"time": 1760984090, "type": "recv", "message_id": "1513949293", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"不会的啦，这种靠近城市的地方。\"拍拍脸，\"乌鸦嘴乌鸦嘴，伊恩不要说坏事\""}
{"time": 1760984158, "type": "recv", "message_id": "1511117022", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“舒茉说的也对,是我多虑了”"}
{"time": 1760984251, "type": "recv", "message_id": "1402379613", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"而且商队刚刚才过来，应该没事的。\""}
{"time": 1760984366, "type": "recv", "message_id": "406188012", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯，防线内还是很安全的，多亏那些卫兵”她点点头"}
{"time": 1760984429, "type": "recv", "message_id": "1631312197", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那就先吃午饭吧。\"打个哈欠，\"我去漱口。\""}
{"time": 1760984485, "type": "recv", "message_id": "902610003", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯”慢慢吃眼前的午饭“好吃，阿姨的手艺还是那么好啊”"}
{"time": 1760984721, "type": "recv", "message_id": "1068070538", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"毕竟是妈的手艺，诶，不过我要问你一件事，伊恩。\"笑眯眯地，\"这么多年吃了大家的手艺，我妈妈做的是不是最好的?\""}
{"time": 1760984883, "type": "recv", "message_id": "2119485722", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“大家能给我一口吃的我已经很感激了，哪有什么心思去排名谁做的最好吃.....”"}
{"time": 1760984901, "type": "recv", "message_id": "697190291", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“一般一般啦，你们应该都去过嘉妮家吃过吧？”她撑着下巴“说起来，自打伊恩你来这应该也……七八年了，记得自己多少岁吗？”"}
{"time": 1760985023, "type": "recv", "message_id": "384519649", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“不准搪塞...”刚说出来，听见妈妈打圆场，叉起腰，但也没接着说下去，瞪着伊恩"}
{"time": 1760985063, "type": "recv", "message_id": "1402802932", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "摇摇头“当初我醒来的时候，除了名字，剩下的都记得不是很清了，不过我感觉我年龄应该跟舒茉差不多一样大吧”"}
{"time": 1760985176, "type": "recv", "message_id": "1803010259", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我不知道啦，就算你比我大很多我也看不出来吧？”依然用眼睛去瞪，抬起手理了理自己零散的长发，“感觉就一副三十岁的样子。”"}
{"time": 1760985204, "type": "recv", "message_id": "864928317", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=697190291]（但是这种事情为什么要现在问，我是黑户吗（）"}
{"time": 1760985269, "type": "recv", "message_id": "1139259816", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哎？有那么老吗”"}
{"time": 1760985331, "type": "recv", "message_id": "1527814144", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "看起来她只是单纯好奇，没有发表评价，顺着往下说“那就是说，差不多也快成年了？”"}
{"time": 1760985438, "type": "recv", "message_id": "512017027", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“应该吧....村长爷爷当时帮我登记身份的时候，年龄好像填的和舒茉一样”"}
{"time": 1760985510, "type": "recv", "message_id": "1717999305", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯……怎么样，还没有做点什么的想法吗？会魔法的孩子可不多哦”"}
{"time": 1760985592, "type": "recv", "message_id": "1621479965", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"对...对吧？伊恩想做什么?\"涉及这个话题，强迫自己打起精神。"}
{"time": 1760985672, "type": "recv", "message_id": "1103570060", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“可能会像肯特一样，也许会去四处冒险，或者就留下来保护村子也有可能，我也不知道，舒茉呢，有什么想干的事情吗”"}
{"time": 1760985726, "type": "recv", "message_id": "2071618972", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（哎，我突然发现）"}
{"time": 1760985737, "type": "recv", "message_id": "1219469577", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（翔哥的卡好像，孤儿比例也不小）"}
{"time": 1760985768, "type": "recv", "message_id": "663852041", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(不小?)"}
{"time": 1760985771, "type": "recv", "message_id": "757467706", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(全是！)"}
{"time": 1760985789, "type": "recv", "message_id": "172924039", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "(不至于吧)"}
{"time": 1760985826, "type": "recv", "message_id": "583393098", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（至少在这边是吧）"}
{"time": 1760985861, "type": "recv", "message_id": "711308379", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我吗？\"抿了抿嘴唇，看向妈妈，挤出笑容，\"应该会留下来帮家里做生意吧。\""}
{"time": 1760985927, "type": "recv", "message_id": "813338387", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（至少在这边是吧）"}
{"time": 1760985942, "type": "recv", "message_id": "1126800430", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(其他的我没细数，但是比例感觉不小)"}
{"time": 1760985971, "type": "recv", "message_id": "2025000917", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（硬说的话，诺薇拉不算孤儿吧，虽然养父母死了）"}
{"time": 1760985980, "type": "recv", "message_id": "1933105915", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（但亲生父母不一定死了）"}
{"time": 1760985984, "type": "recv", "message_id": "1493472485", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(死了不就是)"}
{"time": 1760985999, "type": "recv", "message_id": "966305364", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那我问你孤儿院的孩子难道全是父母双亡吗）"}
{"time": 1760986008, "type": "recv", "message_id": "862648866", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（弃婴难道不算孤儿？）"}
{"time": 1760986078, "type": "recv", "message_id": "1358066018", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（那这样说，露儿应该不算孤儿（）"}
{"time": 1760986103, "type": "recv", "message_id": "628105367", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=711308379]“哎呀，舒茉这么聪明，不觉得有点浪费吗？”*她揉揉你的脑袋“当个作家？或者模特？”"}
{"time": 1760986118, "type": "recv", "message_id": "662255066", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1358066018]（这位更是没有🐴）"}
{"time": 1760986147, "type": "recv", "message_id": "1150155889", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（模特和智力有什么关系（）"}
{"time": 1760986148, "type": "recv", "message_id": "129151436", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（自打记事起就没见过亲生父母还不算孤儿吗）"}
{"time": 1760986162, "type": "recv", "message_id": "2094700935", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(确实)"}
{"time": 1760986164, "type": "recv", "message_id": "341601792", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（演艺圈当然要脑子啊）"}
{"time": 1760986271, "type": "recv", "message_id": "1467358609", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那种事...\"被说得有些脸红，\"舒茉待在妈妈和爸爸身边就好了...模特什么的，好遥远。作家，嗯...我会考虑的。\"吞吞吐吐"}
{"time": 1760986371, "type": "recv", "message_id": "587220292", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“年轻人嘛，有条件还是可以多试试”她依旧是微笑，起身收拾碗碟"}
{"time": 1760986400, "type": "recv", "message_id": "2045944006", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "也去帮忙“我来洗吧，阿姨”"}
{"time": 1760986560, "type": "recv", "message_id": "1925001645", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "跟着母亲的动作，等桌上收拾好了从身后抱住她，脸蹭蹭，\"妈也可以去试试啦，又年轻又好看。\""}
{"time": 1760986678, "type": "recv", "message_id": "1843630907", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“哎呀，我都快奔四的人了”*她有些无奈“前半辈子没静下心来好好学过什么，现在已经习惯平淡的日子咯”"}
{"time": 1760986698, "type": "recv", "message_id": "442858299", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=2045944006]厨房还算容得下两三个人。她倒也没有拒绝你，安排你把洗好的碗擦干。末了她擦擦手，打了个哈欠“今天起了个大早，我也要去补个觉了”"}
{"time": 1760986739, "type": "recv", "message_id": "444795525", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那我们出门吧，舒茉”"}
{"time": 1760986802, "type": "recv", "message_id": "553942898", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "点点头，\"那我出门啦。\"跟妈妈打个招呼跟着伊恩一起出门。"}
{"time": 1760986856, "type": "recv", "message_id": "1527194896", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"伊恩带路，不能去太远...\"想起日记还丢在房间的地上，懒得再回去拿。"}
{"time": 1760986906, "type": "recv", "message_id": "680507427", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯，舒茉要跟紧我哦”朝着树林前进"}
