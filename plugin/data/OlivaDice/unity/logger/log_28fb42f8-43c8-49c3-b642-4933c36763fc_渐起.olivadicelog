{"time": 1761715099, "type": "recv", "message_id": "1512177885", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“阿姨，我可以进去在客厅坐会，等舒茉吗”"}
{"time": 1761715264, "type": "recv", "message_id": "185247492", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“喔……行，进来吧。早饭吃过了？”"}
{"time": 1761715495, "type": "recv", "message_id": "725885019", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯..早上吃了点面包，谢谢阿姨”"}
{"time": 1761715630, "type": "recv", "message_id": "1022176782", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“哈啊，那我就不管你了……”她打着哈欠，又走进了舒茉的房间"}
