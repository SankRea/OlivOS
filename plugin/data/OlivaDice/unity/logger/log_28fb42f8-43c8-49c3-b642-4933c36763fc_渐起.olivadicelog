{"time": 1761877627, "type": "recv", "message_id": "2022282789", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:image,file={EE65AC00-9BC1-770C-CF27-83E86D4C6FA1}.png,sub_type=0,url=https://gchat.qpic.cn/gchatpic_new/0/0-0-EE65AC009BC1770CCF2783E86D4C6FA1/0,file_size=29341]"}
{"time": 1761877639, "type": "recv", "message_id": "1055210724", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（敏锐嗅觉和黑暗视觉都来了）"}
