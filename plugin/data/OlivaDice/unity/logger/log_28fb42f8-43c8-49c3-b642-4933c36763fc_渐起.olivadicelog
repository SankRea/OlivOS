{"time": 1762338630, "type": "recv", "message_id": "1472912216", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"睁开眼，\"好快....感觉没有睡多久...\""}
{"time": 1762338723, "type": "recv", "message_id": "130791031", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我们到那个银色马车了吗？\""}
