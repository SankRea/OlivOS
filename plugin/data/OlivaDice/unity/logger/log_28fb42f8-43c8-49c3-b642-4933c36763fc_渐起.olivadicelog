{"time": 1761912292, "type": "recv", "message_id": "594660153", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（哎，父母爱情）"}
{"time": 1761912312, "type": "recv", "message_id": "1232325116", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（一般来说会说这么多吗？）"}
