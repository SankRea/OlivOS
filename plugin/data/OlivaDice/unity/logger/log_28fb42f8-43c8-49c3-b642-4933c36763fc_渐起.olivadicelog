{"time": 1761046942, "type": "recv", "message_id": "538913684", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（理论上她洗完应该比你回来晚）"}
{"time": 1761046950, "type": "recv", "message_id": "2131046877", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那你再待会，笑）"}
{"time": 1761047024, "type": "recv", "message_id": "1035241886", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "你回到舒茉家，房门还是开的。这个点还没开灯，阳光把木门拉出长长的影子。"}
