{"time": 1761213431, "type": "recv", "message_id": "2001298082", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（呃，晚上夜路可能会危险啊）"}
{"time": 1761213441, "type": "recv", "message_id": "682545849", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我会送她回家，阿姨就不用担心了）"}
