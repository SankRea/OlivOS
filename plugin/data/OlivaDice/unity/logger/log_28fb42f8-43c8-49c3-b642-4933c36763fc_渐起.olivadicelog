{"time": 1761268569, "type": "recv", "message_id": "1108146859", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（觉得有嘛）"}
{"time": 1761268692, "type": "recv", "message_id": "1703317271", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“没关系的....我只想陪着舒茉”"}
{"time": 1761268710, "type": "recv", "message_id": "1492548826", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（除非我忽然记忆觉醒了（）"}
