{"time": 1762108199, "type": "recv", "message_id": "1660940868", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（好的）"}
{"time": 1762108325, "type": "recv", "message_id": "1735147135", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“不过赫顿玛尔附近，对魔法有研究的……嘛，阿法利亚倒是有一群暗精灵”"}
{"time": 1762108360, "type": "recv", "message_id": "796961187", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“暗精灵我记得书上说很排外好像”"}
{"time": 1762108383, "type": "recv", "message_id": "1169636659", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“就是这样，所以也很麻烦”"}
{"time": 1762108394, "type": "recv", "message_id": "655183033", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"唔...或者舒茉自己过去协会那边。就当是求学。\""}
{"time": 1762108420, "type": "recv", "message_id": "1128014582", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“？”"}
{"time": 1762108510, "type": "recv", "message_id": "2101446104", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“你自己……”她一时有些说不出话“刚刚还在说不让我去哦？”"}
{"time": 1762108547, "type": "recv", "message_id": "1491964630", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“不是口口声声说离不开妈妈？而且你们两个最近出门的运气……”"}
{"time": 1762108591, "type": "recv", "message_id": "611802230", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"妈妈当然不能去啦。\"扶了扶不存在的眼镜，\"但是他们又不认得舒茉，肯定想不到啦，怎么样，是不是很聪明。\""}
{"time": 1762108639, "type": "recv", "message_id": "898677734", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“但是舒茉不是不想和叔叔阿姨分开么”有些疑惑“不是说，怎样都要一起么..”"}
{"time": 1762108715, "type": "recv", "message_id": "1017148990", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"去战场这种地方当然是这样。\"抱着妈妈脖颈撒娇，\"但是暂时分开上学又是另一回事吧？不要把舒茉想的那么脆弱好不好嘛。\""}
{"time": 1762109031, "type": "recv", "message_id": "1352877382", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嘛，西海岸附近的房子应该比赫顿玛尔的稍微好找一点……而且我早就改过名了喔？”她笑了笑“只是在附近的话，没问题的”"}
{"time": 1762109201, "type": "recv", "message_id": "122790734", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我想的是...等舒茉很厉害的时候，我带着妈妈找上门把他们全揍一顿。\"声音慢慢低下来，\"现在的舒茉...什么也做不到...\""}
{"time": 1762109241, "type": "recv", "message_id": "1109139028", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（哎好暴力（）"}
{"time": 1762109244, "type": "recv", "message_id": "935071721", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那..把我也算上，我们一起去教训那群家伙”"}
{"time": 1762109286, "type": "recv", "message_id": "1596318064", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（就有没有可能，舒蕾才是违约方（）"}
{"time": 1762109307, "type": "recv", "message_id": "1052141291", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（让别人打假赛本来就不对（）"}
{"time": 1762109331, "type": "recv", "message_id": "1573975406", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你在说什么）"}
{"time": 1762109342, "type": "recv", "message_id": "2014463638", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(温柔是分对象的，这是私心)"}
{"time": 1762109363, "type": "recv", "message_id": "488185817", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(舒茉又不是真的无私的神。)"}
{"time": 1762109402, "type": "recv", "message_id": "1276813105", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“哎，要我怎么说才好呢……舒茉的爱妈妈收到了，不过找回去的话，麻烦只会越来越多喔？”"}
{"time": 1762109501, "type": "recv", "message_id": "947304127", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（困了💤，明早继续吧）"}
{"time": 1762109508, "type": "recv", "message_id": "2093876988", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"当然不会随随便便就找上门，首先以能随便操纵天气为目标吧。\""}
