{"time": 1761650975, "type": "recv", "message_id": "1295304096", "deleted": true, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“阿姨快来尝尝这个南瓜，好好吃”"}
{"time": 1761651051, "type": "recv", "message_id": "943848058", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:image,file={11CDDDEF-7410-A806-EC4C-ADC8EDCE9BC3}.gif,sub_type=1,url=https://gchat.qpic.cn/gchatpic_new/0/0-0-11CDDDEF7410A806EC4CADC8EDCE9BC3/0,file_size=23270]"}
{"time": 1761651250, "type": "recv", "message_id": "443414155", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（对厨子说尝尝吗）"}
{"time": 1761651281, "type": "recv", "message_id": "1527458426", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“阿姨，这个南瓜好好吃，有机会可以教教我吗”"}
{"time": 1761651646, "type": "recv", "message_id": "2130652868", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯？行啊，想学做菜的话……”她看起来倒是全然不受果酒影响“书架上有本烹饪入门，我已经翻遍了。你感兴趣的话，可以先借着”"}
{"time": 1761651660, "type": "recv", "message_id": "1945652924", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“谢谢阿姨”"}
{"time": 1761651729, "type": "recv", "message_id": "660568025", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "少女安眠中"}
{"time": 1761651788, "type": "recv", "message_id": "1414454211", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我吃的差不多了，可以先去看会么，等下叔叔阿姨吃完了叫我一声我可以帮着一起收拾”"}
{"time": 1761651956, "type": "recv", "message_id": "1692535767", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我们也差不多了。那本书，你可以直接拿回去。”舒蕾快速解决最后几串，看起来当然没有在舒茉面前那么少女"}
{"time": 1761652325, "type": "recv", "message_id": "247001785", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(and?)"}
