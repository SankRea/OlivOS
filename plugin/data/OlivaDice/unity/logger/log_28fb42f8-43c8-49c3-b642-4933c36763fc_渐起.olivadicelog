{"time": 1761912391, "type": "recv", "message_id": "1496180390", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:image,file=0A857C9C2426E5FA9071FEEFB47C1FB4.jpg,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhSxU3ErbMvZl4ldFlX6KjAZpOtSyRie5Qkg_woo1_3_kLPOkAMyBHByb2RQgL2jAVoQTrDDPdaO81nTTHuDAaO7XHoCkueCAQJneg&amp;rkey=CAQSMNVfPf91yEWXfBx3wzDA5ml_4vsmvMY3hyBbv0Em429_dCRbjo2z7F8ALG2KB5dd4w,file_size=160414]"}
