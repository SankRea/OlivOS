{"time": 1761050404, "type": "recv", "message_id": "1388614506", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "他坐在沙发上，看你进来，对你点点头"}
