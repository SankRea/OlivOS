{"time": 1762338554, "type": "recv", "message_id": "1353072559", "deleted": true, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "继续走了，不过目标就在眼前，也更有干劲了一些"}
{"time": 1762338581, "type": "recv", "message_id": "1190525625", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（说的是山离村子有点距离）"}
