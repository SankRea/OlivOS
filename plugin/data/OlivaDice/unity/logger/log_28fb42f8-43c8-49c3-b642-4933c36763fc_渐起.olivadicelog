{"time": 1761716121, "type": "recv", "message_id": "480391097", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（但是今天舒蕾可能不太会叫舒茉）"}
