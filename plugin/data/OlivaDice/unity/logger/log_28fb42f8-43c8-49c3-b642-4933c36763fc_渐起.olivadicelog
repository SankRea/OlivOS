{"time": 1760961287, "type": "recv", "message_id": "1590789670", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我看是太久没挨过打了）"}
{"time": 1760961338, "type": "recv", "message_id": "559479409", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "总之确认火彻底熄灭后，乘好一碗粥，拿上一个勺子，给舒茉端去"}
{"time": 1760961361, "type": "recv", "message_id": "1447731165", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "放在她的面前“快点趁热吃吧”"}
{"time": 1760961469, "type": "recv", "message_id": "165224546", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"身体有些瑟缩，像极楚楚可怜的小兽，伸手拿起勺子，一勺一勺小口喝起来。"}
{"time": 1760961564, "type": "recv", "message_id": "1607728413", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "16岁的人大概也不会被烫到。热过一道的粥更浓稠也更鲜，有一种平凡的幸福感"}
{"time": 1760961647, "type": "recv", "message_id": "537272037", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "此外自然是暖意十足，加上夏天刚过去不久……微微有些催人发汗"}
{"time": 1760961681, "type": "recv", "message_id": "206300086", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"麻烦伊恩了...还要你照顾我...\"有些含混不清，自己也不想说得太清楚，额头凝着些小颗的汗珠"}
{"time": 1760961732, "type": "recv", "message_id": "125044179", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "拿点纸递给舒茉“等下舒茉再去睡一会吧，睡醒了身子应该彻底就好了”"}
{"time": 1760962057, "type": "recv", "message_id": "126689924", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"不想睡...\"接过纸擦擦额头的汗，\"刚起床诶..\""}
{"time": 1760962212, "type": "recv", "message_id": "1841436747", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“也对...不过今天舒茉还是不要外出了，在家看会书吧”"}
{"time": 1760962233, "type": "recv", "message_id": "809178609", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"伊恩待会要做什么?\"喝了一半感觉胃里装得差不多了，\"我们一起吧。\""}
{"time": 1760962300, "type": "recv", "message_id": "1427325900", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“也没什么特别想做的事情，那我就留下来照顾舒茉吧”"}
{"time": 1760962335, "type": "recv", "message_id": "1649868689", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（哎，女法里果然还是喜欢斗萝）"}
{"time": 1760962385, "type": "recv", "message_id": "1082542228", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（战场双马尾.jpg）"}
{"time": 1760962401, "type": "recv", "message_id": "273041520", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（少女就该配大刀！）"}
{"time": 1760962419, "type": "recv", "message_id": "1527152071", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我比较喜欢魔道)"}
{"time": 1760962447, "type": "recv", "message_id": "442402004", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶...\"最后点点头"}
{"time": 1760962465, "type": "recv", "message_id": "628882763", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你们在这里窝着吗）"}
{"time": 1760962493, "type": "recv", "message_id": "972093224", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（她身体不好（bushi）"}
{"time": 1760962521, "type": "recv", "message_id": "227228717", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"带我进房间吧..伊恩。\""}
{"time": 1760962546, "type": "recv", "message_id": "347312546", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哎？可以吗，会不会不太好”有些犹豫"}
{"time": 1760962624, "type": "recv", "message_id": "1548750127", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"难道我要在沙发上休息?\"翻个白眼，伸出手"}
{"time": 1760962685, "type": "recv", "message_id": "583531972", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“对不起”尴尬的笑笑，重新背起舒茉，带她回房间"}
{"time": 1760962790, "type": "recv", "message_id": "824165813", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "房间还没来得及收拾，被子睡衣堆在床沿，房顶垂着一些大概是旨在模拟星河的蓝色琉璃珠子"}
{"time": 1760962839, "type": "recv", "message_id": "575699532", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"不准偷看。\"伸手捂住他的眼睛"}
{"time": 1760962842, "type": "recv", "message_id": "1768555427", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我什么都没看见”抢先开口说道"}
{"time": 1760962916, "type": "recv", "message_id": "170063980", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "视线被遮挡，这下真的什么都看不见，只能凭感觉到床的位置"}
{"time": 1760962948, "type": "recv", "message_id": "312236184", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"明明就看见了，啊啊，反正不准看。\"死死捂着他的眼睛，\"往前...再前一点。\""}
{"time": 1760962979, "type": "recv", "message_id": "368771315", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "慢慢向前挪动，小心翼翼的，害怕摔了"}
{"time": 1760963059, "type": "recv", "message_id": "863089403", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那你要赌你会不会踩到东西吗（）"}
{"time": 1760963107, "type": "recv", "message_id": "1489055084", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"别踩到我的玩偶。\"看着地面，小心指挥他，\"绕开\""}
{"time": 1760963190, "type": "recv", "message_id": "1694060766", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“玩偶为什么在地上啊”忍不住想吐槽，比起转弯，平移应该很简单点，往右稍微移一些，然后继续慢慢向前走"}
{"time": 1760963257, "type": "recv", "message_id": "2023149709", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "明明没有到走不动路的地步——你们意识到这就是某人在领着人进闺房，简直就是引狼入室"}
{"time": 1760963308, "type": "recv", "message_id": "723095145", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（但是我说dnf最好看的立绘还是花花）"}
{"time": 1760963316, "type": "recv", "message_id": "559605442", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好了，到了到了。自己老实把眼睛闭上。\"挪开手"}
{"time": 1760963369, "type": "recv", "message_id": "25454323", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"放我下来...\"感觉自己有些冒失，还有些不理智，\"嗯...\""}
{"time": 1760963394, "type": "recv", "message_id": "2005735766", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "你的腿大概是蹭到了床沿，应该到了.jpg"}
{"time": 1760963486, "type": "recv", "message_id": "547032016", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "小心翼翼的转个身，把她放下去，幸好自己平衡感还不错“那我先出去了？有事叫我就好”"}
{"time": 1760963552, "type": "recv", "message_id": "1684851459", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"安心了一些，躺在床上懒得动弹，只是淡淡回应一下"}
{"time": 1760963639, "type": "recv", "message_id": "78033468", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那你怎么出去呢.jpg）"}
{"time": 1760963642, "type": "recv", "message_id": "1214624541", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "睁开眼睛，然后快点出去，感觉待在这里有一种说不上来的感觉"}
{"time": 1760963700, "type": "recv", "message_id": "1373020557", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"啧...\"忍不住有些呲牙，\"真是...\"但是明明是自己要求的...\"算了，走快点啦\""}
{"time": 1760963794, "type": "recv", "message_id": "310236240", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...”逃跑似的离开，不过有好好带上门，然后坐在客厅里发呆"}
{"time": 1760963809, "type": "recv", "message_id": "366926455", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（发呆）"}
{"time": 1760963830, "type": "recv", "message_id": "392530030", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "想想自己可以做些什么"}
{"time": 1760963836, "type": "recv", "message_id": "519538009", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那你想）"}
{"time": 1760963843, "type": "recv", "message_id": "995046740", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "要不帮忙打扫一下客厅的卫生吧"}
{"time": 1760963965, "type": "recv", "message_id": "1515561368", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "地板上也许？可能？确实有些薄灰"}
{"time": 1760963992, "type": "recv", "message_id": "1531987193", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "看着门被关好，把日记本扔到地上，小心翼翼地开始换睡衣"}
{"time": 1760964023, "type": "recv", "message_id": "1333243589", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "好惨一日记本，总之外面有扫把扫来扫去的声音"}
{"time": 1760964036, "type": "recv", "message_id": "2140600120", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "忠实地反映着某人的位置"}
{"time": 1760964107, "type": "recv", "message_id": "1299877741", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "松了口气，换好衣服。把换下的衣服整理一下，关上窗拉上窗帘，抖了抖刚整理的被子给自己盖上。"}
{"time": 1760964123, "type": "recv", "message_id": "1916417729", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "这不是元气满满吗.jpg"}
{"time": 1760964182, "type": "recv", "message_id": "699674903", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(难道还能不是吗？笑了，刚刚才吃的奶)"}
{"time": 1760964197, "type": "recv", "message_id": "471934521", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（有人完全不懂哦.jpg）"}
