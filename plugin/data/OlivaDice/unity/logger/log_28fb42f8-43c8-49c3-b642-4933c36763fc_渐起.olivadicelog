{"time": 1762132313, "type": "recv", "message_id": "147962859", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（一人灭一城的描述听起来还不吓人吗（））"}
{"time": 1762132325, "type": "recv", "message_id": "1832455905", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我就是说他在干嘛）"}
