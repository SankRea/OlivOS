{"time": 1761885740, "type": "recv", "message_id": "253436262", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（不是初恋？）"}
{"time": 1761885772, "type": "recv", "message_id": "1854557235", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "\"我不知道.....我感觉怎么做都是错的...阿姨帮我做了决定，那我就一条路走到黑吧..\""}
