{"time": 1760898638, "type": "recv", "message_id": "79711792", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(掩饰尴尬)"}
{"time": 1760898657, "type": "recv", "message_id": "1032013719", "deleted": true, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哎？那太麻烦阿姨了吧”想从舒茉书中接过肉"}
{"time": 1760898685, "type": "recv", "message_id": "195848928", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你都吃百家饭了）"}
{"time": 1760898692, "type": "recv", "message_id": "1254522771", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（每次吃饭前都要说这个吗（）"}
{"time": 1760898697, "type": "recv", "message_id": "1594476627", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"还是我来吧。\"呼吸逐渐平稳，扬起笑容，\"想留在我家吃晚饭，乖乖听我的话。\""}
{"time": 1760898728, "type": "recv", "message_id": "720933144", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“谢谢阿姨”"}
