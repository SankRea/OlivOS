{"time": 1761301350, "type": "recv", "message_id": "1231023932", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"什么?\"一边穿衣服一边接过话"}
{"time": 1761301542, "type": "recv", "message_id": "1299835653", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“千万记得，分开住两个房间”她的声音莫名严肃"}
{"time": 1761301626, "type": "recv", "message_id": "1956244379", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...\"被其中蕴含的信息量冲击了一下，摸了摸自己的额头，\"爸爸在想什么...啊哈哈...\""}
{"time": 1761302493, "type": "recv", "message_id": "1841203620", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（翔哥要不要过个聆听看看听没听见（））"}
