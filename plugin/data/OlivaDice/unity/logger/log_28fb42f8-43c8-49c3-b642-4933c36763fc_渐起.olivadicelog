{"time": 1761334704, "type": "recv", "message_id": "2112164875", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(翔哥把我拉下来了)"}
