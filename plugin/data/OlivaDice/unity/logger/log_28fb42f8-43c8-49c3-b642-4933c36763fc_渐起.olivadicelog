{"time": 1761886633, "type": "recv", "message_id": "546343147", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“那是什么？我看错了吗？树枝怎么自己会动？”"}
{"time": 1761886640, "type": "recv", "message_id": "1367333738", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（树树的精啊）"}
