{"time": 1760987900, "type": "recv", "message_id": "25091042", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "也摘一点尝尝“带回去点给叔叔阿姨也尝尝吧”"}
