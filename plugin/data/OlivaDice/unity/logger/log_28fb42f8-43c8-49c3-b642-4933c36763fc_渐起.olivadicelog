{"time": 1761105911, "type": "recv", "message_id": "685867916", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "总之天亮了。似乎入秋得很快，伊恩在仓库里感觉有点冷"}
{"time": 1761106186, "type": "recv", "message_id": "110001341", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "没有做什么奇怪的梦，睡得很安心，jpg"}
{"time": 1761106219, "type": "recv", "message_id": "267545205", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“明明昨天还挺暖和的....”起床去河边洗漱一下"}
{"time": 1761106270, "type": "recv", "message_id": "118159943", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（公用水井应该还是有的）"}
