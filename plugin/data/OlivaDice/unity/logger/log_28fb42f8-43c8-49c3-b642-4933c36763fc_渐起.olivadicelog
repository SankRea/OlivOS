{"time": 1761206093, "type": "recv", "message_id": "1760891689", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "乖巧的等待下一步的指示"}
{"time": 1761206199, "type": "recv", "message_id": "1419465240", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“换清水，下锅……然后捣碎加糖”"}
{"time": 1761206280, "type": "recv", "message_id": "1831691978", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "跟着母亲的指示做，\"感觉也不复杂嘛。\""}
{"time": 1761206366, "type": "recv", "message_id": "1839402988", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“比起工序确实更考验原材料就是咯……不够，再多放。要很多糖才够”"}
{"time": 1761206570, "type": "recv", "message_id": "3946924", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "倒好多好多糖"}
{"time": 1761206588, "type": "recv", "message_id": "26764260", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"是不是太多了？\"想阻止却来不及了"}
{"time": 1761206611, "type": "recv", "message_id": "648738233", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "急忙停止“多..多了吗”"}
{"time": 1761206756, "type": "recv", "message_id": "1104500486", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“差不多差不多”她点点头，糖块压在果肉上，堆出了水面。她拿出两个木杵“捣吧，得捣得碎碎的”"}
{"time": 1761207004, "type": "recv", "message_id": "630001443", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"感觉会很甜诶...\""}
{"time": 1761207384, "type": "recv", "message_id": "490152544", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“果酱当然要甜，不够甜会坏的很快的”"}
{"time": 1761207412, "type": "recv", "message_id": "1690130201", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“甜点好啊，舒茉不爱吃甜的吗”开捣"}
{"time": 1761207480, "type": "recv", "message_id": "121579222", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“除了果子，还能加点其他的辅料添加点层次感……有什么感兴趣的吗？”"}
{"time": 1761207588, "type": "recv", "message_id": "876477548", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "把木杵递给伊恩，\"伊恩左右开弓吧，感觉会好累诶...\"接过妈妈的话，\"加点奶油?"}
{"time": 1761207637, "type": "recv", "message_id": "393510546", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“额，舒茉把木杵放下来吧，一个应该就够用了”"}
{"time": 1761207648, "type": "recv", "message_id": "914633123", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“奶油听起来怪怪的，真的可以吗？”"}
{"time": 1761207670, "type": "recv", "message_id": "195383547", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“不，奶油不行……那个可以和成品一起吃，但是不能加进来的”"}
{"time": 1761207699, "type": "recv", "message_id": "90035534", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“一般都会加些什么呢，阿姨”"}
{"time": 1761207803, "type": "recv", "message_id": "1383277323", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶...奶油不行吗？那...总不能再加水果进去吧。\""}
{"time": 1761207853, "type": "recv", "message_id": "186514822", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“一般来说，花啦，别的种类的果子啦……总之动物成分不行。也许蜂蜜可以？我没试过”"}
{"time": 1761207983, "type": "recv", "message_id": "1711238073", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"花的话...也没有现成的...嘛，伊恩有什么想法吗？\""}
{"time": 1761208031, "type": "recv", "message_id": "330204930", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“蜂蜜可能就挺好的吧....不过估计会更甜了”"}
{"time": 1761208065, "type": "recv", "message_id": "1109685009", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“听说有的地方为了凸显甜味，会往甜的东西里面加酱油...”"}
{"time": 1761208085, "type": "recv", "message_id": "162065433", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"吃太甜的会蛀牙诶...不过蜂蜜好像能杀菌?\"眨眨眼"}
{"time": 1761208140, "type": "recv", "message_id": "885856616", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（西瓜沾酱油？）"}
