{"time": 1761716334, "type": "recv", "message_id": "1872347997", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "睁开眼睛，抬手捂着脑袋，总觉得脑子里带着些神经性的刺痛，不知道妈妈还在不在自己旁边"}
{"time": 1761716419, "type": "recv", "message_id": "760026625", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "你手胡乱摸索，确实摸到了个人"}
{"time": 1761716523, "type": "recv", "message_id": "2001719427", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "习惯性地往她身上蹭，\"妈...头痛...\""}
{"time": 1761716685, "type": "recv", "message_id": "288579691", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（哎，哪有这么严重）"}
{"time": 1761716750, "type": "recv", "message_id": "925640613", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(没那么严重，但是撒娇是无所谓严重不严重的)"}
{"time": 1761716783, "type": "recv", "message_id": "290863878", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“昨天晚上喝多了？明明没多少嘛……”她摸了摸你的额头，确认不是发烧“嘛，不能喝就该早点停杯的。不过这样还怎么去图书馆？”"}
{"time": 1761716906, "type": "recv", "message_id": "68803663", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...妈妈怎么知道的?\"眯着眼享受抚摸"}
{"time": 1761717001, "type": "recv", "message_id": "119140350", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嘛，毕竟最近天天有人来找你呢？”"}
{"time": 1761717106, "type": "recv", "message_id": "1140489567", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶...\"睁开眼看向妈妈，\"他在哪?\""}
{"time": 1761717227, "type": "recv", "message_id": "130155489", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“一大早就来等着了，就在客厅”她似是有些无奈"}
{"time": 1761717396, "type": "recv", "message_id": "1242730907", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"本来还想再赖会床的，从床上起身，\"我去洗漱一下...\"一边打着哈欠一边去洗漱。\n换好衣服离开房间去客厅。"}
{"time": 1761717423, "type": "recv", "message_id": "833343470", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（显然你的卧室不连着卫生间）"}
{"time": 1761717548, "type": "recv", "message_id": "987757585", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(呃好的)"}
{"time": 1761717618, "type": "recv", "message_id": "1830139486", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "那就打着哈欠，抱着要换的衣服推开房门，伸个懒腰出门，\"嗯嗯...\""}
{"time": 1761717720, "type": "recv", "message_id": "1992059657", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“你等等等等……”舒蕾在你拉开门前抓住你“你要穿着睡衣出去？”"}
{"time": 1761717931, "type": "recv", "message_id": "1573876220", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...\"一时没感觉到哪里不对劲，过了一会脑子才转过来，把衣服塞到妈妈怀里，\"啊...\"拍拍自己的脸，在房间里先把衣服换了。"}
{"time": 1761717972, "type": "recv", "message_id": "609696617", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "这下倒是精神了不少，推开门出去看看"}
{"time": 1761718093, "type": "recv", "message_id": "687994186", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "听到门开的声音，转头正好看见出来的舒茉“早上好啊”"}
{"time": 1761718197, "type": "recv", "message_id": "948518527", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"早上好。\"揉揉眼眶，\"唔...好困的...\""}
{"time": 1761718266, "type": "recv", "message_id": "998020954", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "头发完全没打理，零散地披在脑后，整个人也没什么精神，一边揉着眼睛，一边频频打哈欠"}
{"time": 1761718299, "type": "recv", "message_id": "1261847804", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那舒茉要不在睡一会吧”看她确实好困的样子，不过按理来说她昨晚睡得挺早的“我也不是很急”"}
{"time": 1761718493, "type": "recv", "message_id": "1106088979", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"唔唔...伊恩都到了...\"捂着一只眼睛，\"我先去洗漱一下啦...伊恩再等我一会...\""}
{"time": 1761718525, "type": "recv", "message_id": "1234238572", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好吧。不过不用急，时间还很早呢”"}
{"time": 1761718573, "type": "recv", "message_id": "422888136", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "转身走进洗手间，看着镜子里的自己"}
{"time": 1761718585, "type": "recv", "message_id": "823076757", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我被酒色所伤，竟如此憔悴)"}
{"time": 1761718611, "type": "recv", "message_id": "1190443590", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "头发大概已经是阿罗拉同款了吧（）"}
{"time": 1761718759, "type": "recv", "message_id": "1543629662", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "接水洗漱，用梳子仔仔细细打理好头发再出门，\"呼...感觉现在清醒多了。\"今天穿着一身立领白色毛衣，简单搭配了一个米色的外套，\"伊恩吃过了吗？\""}
{"time": 1761718763, "type": "recv", "message_id": "1286930910", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（伊恩难道没有别家的饭蹭了吗（）"}
