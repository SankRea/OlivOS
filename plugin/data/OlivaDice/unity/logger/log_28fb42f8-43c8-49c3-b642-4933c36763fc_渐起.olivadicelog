{"time": 1761719832, "type": "recv", "message_id": "55571383", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（10吧）"}
{"time": 1761719921, "type": "recv", "message_id": "511518064", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（10是-几）"}
