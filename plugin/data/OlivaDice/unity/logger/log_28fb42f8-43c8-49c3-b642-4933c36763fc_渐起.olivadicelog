{"time": 1760964264, "type": "recv", "message_id": "1267567154", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "过去开下门"}
{"time": 1760964266, "type": "recv", "message_id": "369179914", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"谁...?\"轻咳两声才开口"}
{"time": 1760964285, "type": "recv", "message_id": "500095116", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（？你在卧室也能听到吗）"}
