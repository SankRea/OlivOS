{"time": 1761334719, "type": "recv", "message_id": "64414928", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(突然一转，荒野求生)"}
