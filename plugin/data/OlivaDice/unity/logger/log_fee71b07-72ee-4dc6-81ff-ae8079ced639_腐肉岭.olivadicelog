{"time": 1761742662, "type": "recv", "message_id": "1787072733", "deleted": false, "dect": {"host_id": null, "group_id": "1033334080", "user_id": "3362422751"}, "sender": {"id": "3362422751", "name": "维兹"}, "message": "[CQ:reply,id=43344763]（我在宿舍"}
