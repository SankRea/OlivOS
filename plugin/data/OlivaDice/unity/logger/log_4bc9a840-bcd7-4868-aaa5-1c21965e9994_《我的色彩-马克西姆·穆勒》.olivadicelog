{"time": 1760538660, "type": "recv", "message_id": "1034064952", "deleted": false, "dect": {"host_id": null, "group_id": "628159892", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "（好，开始做梦！）"}
{"time": 1760538700, "type": "recv", "message_id": "872712035", "deleted": false, "dect": {"host_id": null, "group_id": "628159892", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "你艰难的迫使自己入眠。恍惚之间，你再次进入梦境中。"}
{"time": 1760538784, "type": "recv", "message_id": "1248250531", "deleted": false, "dect": {"host_id": null, "group_id": "628159892", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "你又看到了那位少女，离开山洞后，在暴风雪中艰难地前进。"}
{"time": 1760538874, "type": "recv", "message_id": "961621241", "deleted": false, "dect": {"host_id": null, "group_id": "628159892", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*试着跟上她"}
{"time": 1760538898, "type": "recv", "message_id": "1066810176", "deleted": false, "dect": {"host_id": null, "group_id": "628159892", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "你看着她一步一步地向风雪冲锋着，燃烧着自己的身体，以生命为代价，一点点靠近艾格峰山顶。"}
