{"time": 1758699861, "type": "recv", "message_id": "1519699039", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“以及哲学”"}
{"time": 1758699970, "type": "recv", "message_id": "22899182", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“真是新奇”"}
{"time": 1758700014, "type": "recv", "message_id": "409213234", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“那其他修格斯，尤其是被吃掉的那位对此完全不知情吗”"}
{"time": 1758700017, "type": "recv", "message_id": "2098598464", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "246376731"}, "sender": {"id": "246376731", "name": "ㅤᅠㅤㅤᅠㅤㅤᅠㅤᅠ"}, "message": "“我的确赞同我们不该在一起的观点，”"}
