{"time": 1760256378, "type": "recv", "message_id": "1567957366", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "（思考中"}
{"time": 1760256429, "type": "recv", "message_id": "322143952", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "\"对的，我也想多了解了解修格斯\""}
{"time": 1760256460, "type": "recv", "message_id": "1622710524", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "等你们走近后，他们反复看了你们几眼，忽然大叫“哦，这不是安农律师和狱卒检察官吗！”"}
{"time": 1760256472, "type": "recv", "message_id": "1045707294", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "（何意味）"}
{"time": 1760256474, "type": "recv", "message_id": "1358595531", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "（我靠）"}
{"time": 1760256484, "type": "recv", "message_id": "314328439", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "（我信用太高了）"}
{"time": 1760256494, "type": "recv", "message_id": "1886151867", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“我们看了今天早上的记者直播了，你们是来调查案件的吗？”"}
{"time": 1760256515, "type": "recv", "message_id": "1341908066", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“低调低调”"}
{"time": 1760256529, "type": "recv", "message_id": "1967879785", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“你知道的，我一直很喜欢修格斯”"}
{"time": 1760256584, "type": "recv", "message_id": "236344959", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“wooooooooo！！！！！！！先生们！！！那你们是要找徐川会长吗？他现在在哦！！！！”"}
{"time": 1760256598, "type": "recv", "message_id": "274328572", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“麻烦你们带路了”"}
{"time": 1760256599, "type": "recv", "message_id": "1818968832", "deleted": true, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "吧台后面的崇拜会员见状对玩家们非常沉静地点了点头—— “我是徐川，你们好。”"}
{"time": 1760256612, "type": "recv", "message_id": "1649153307", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "吧台后面的崇拜会员见状对你们非常沉静地点了点头—— “我是徐川，你们好。”"}
{"time": 1760256650, "type": "recv", "message_id": "833940026", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "眼前的徐川，他身上的修格斯皮肤十分平滑自然，黑色的肌体分着条，上面有栩栩如生的眼睛！！！和外面会员们的衣服完全不一样！看上去.....看上去就像是真的修格斯皮肤一样！或者说！你们面前这不就是一个修格斯吗！！"}
{"time": 1760256650, "type": "recv", "message_id": "518049333", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "[CQ:reply,id=1622710524]（好难绷）"}
