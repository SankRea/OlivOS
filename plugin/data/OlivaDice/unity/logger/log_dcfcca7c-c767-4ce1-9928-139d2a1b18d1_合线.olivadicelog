{"time": 1758699211, "type": "recv", "message_id": "1111831996", "deleted": true, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（修哥特其实不是很近，就算他过来了吧）"}
