{"time": 1760256691, "type": "recv", "message_id": "972591744", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "（我嘞个修格斯）"}
{"time": 1760256706, "type": "recv", "message_id": "1580570438", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“我怎么感觉这边和邪神社区反着来人都变得和修格斯一样了”小声吐槽"}
{"time": 1760256716, "type": "recv", "message_id": "2122493724", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“徐会长你好”"}
{"time": 1760256728, "type": "recv", "message_id": "758114658", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "[CQ:reply,id=1580570438]*点点头"}
{"time": 1760256729, "type": "recv", "message_id": "1114923689", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“哈哈！尊敬的朋友，您一定是也把我当成修格斯大人了，对不对？"}
{"time": 1760256743, "type": "recv", "message_id": "831397019", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“真是栩栩如生惟妙惟肖”"}
{"time": 1760256752, "type": "recv", "message_id": "1906855481", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "徐川抄起一把刀，猛地把刀刺向了自己的胳膊——鲜红的血液流淌了下来，毫无疑问，这是人类的证明！"}
{"time": 1760256761, "type": "recv", "message_id": "351084620", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“哈哈，哈哈，朋友，真遗憾，我并不是修格斯大人。”"}
{"time": 1760256761, "type": "recv", "message_id": "1740887603", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“诶，还真是。徐会长的伪装简直天衣无缝”"}
{"time": 1760256763, "type": "recv", "message_id": "1752102595", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“何意味”"}
{"time": 1760256764, "type": "recv", "message_id": "1735375623", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“佩服”"}
{"time": 1760256775, "type": "recv", "message_id": "745385207", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“我去做了整形手术！去把自己变成了修格斯大人的模样！！！”\n “这都是为了让我自己更加接近修格斯大人！！！”\n说完，徐川咕嘟咕嘟喝起了酒"}
{"time": 1760256793, "type": "recv", "message_id": "1573964103", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“傻逼吧”*心想"}
{"time": 1760256818, "type": "recv", "message_id": "773415254", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“不愧是会长，真有魄力”"}
{"time": 1760256819, "type": "recv", "message_id": "148248190", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "（神人）"}
{"time": 1760256951, "type": "recv", "message_id": "1242294940", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“会长大人对这起案件怎么看”"}
{"time": 1760257091, "type": "recv", "message_id": "1865988172", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“我认为人类社会实际上污染了邪神大人们的精神！！！我们应该让修格斯大人们尽快离开逆转市！”"}
