{"time": 1757679213, "type": "recv", "message_id": "573846895", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“嗯，我相信案件事有隐情”"}
