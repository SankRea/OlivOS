{"time": 1757911020, "type": "recv", "message_id": "627417719", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "[CQ:reply,id=1236854132]“具体喜欢什么文化，可以说下吗”"}
{"time": 1757911081, "type": "recv", "message_id": "1734535719", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“我最喜欢你们人类的跳舞艺术哦哦哦哦哦哦”"}
{"time": 1757911097, "type": "recv", "message_id": "2136852675", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“要我给你表演霹雳舞吗啊啊啊啊啊”"}
{"time": 1757911131, "type": "recv", "message_id": "153696032", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“好呀，我很期待”*露出期待的眼神"}
