{"time": 1757676535, "type": "recv", "message_id": "720108977", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "246376731"}, "sender": {"id": "246376731", "name": "ㅤᅠㅤㅤᅠㅤㅤᅠㅤᅠ"}, "message": "“按目前调查出的情况看 这是一起过失杀人案”"}
{"time": 1757676553, "type": "recv", "message_id": "1239820776", "deleted": false, "dect": {"host_id": null, "group_id": "264175027", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "“嗯”"}
