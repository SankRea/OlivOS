{"time": 1756220732, "type": "recv", "message_id": "1454290845", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "[CQ:reply,id=1159574234]“原来是他”"}
