{"time": 1756218021, "type": "recv", "message_id": "216139961", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "*保持沉默"}
{"time": 1756218061, "type": "recv", "message_id": "163318331", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"您好啊...罗小黑同学，又见面了？\""}
{"time": 1756218114, "type": "recv", "message_id": "1558021261", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "“这次你们又带了几个人呢”*叹口气"}
{"time": 1756218166, "type": "recv", "message_id": "14576259", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"啊..?\"有些疑惑，\"不就是我们两个人吗？\"看看另一个魔力源"}
{"time": 1756218299, "type": "recv", "message_id": "2137856046", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“周围还有其他从者吗，姐姐？”"}
{"time": 1756218306, "type": "recv", "message_id": "801495208", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "“那就是还有几位在路上，也挺近了”*继续观察工艺品"}
{"time": 1756218311, "type": "recv", "message_id": "1633163453", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "*扭头看看金发姐姐"}
{"time": 1756218401, "type": "recv", "message_id": "756478045", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“先别管那么多了，你能请我们吃冰淇淋吗，我们没有钱。”"}
{"time": 1756218456, "type": "recv", "message_id": "574485093", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "“可以是可以，但是不是现在。或者说，你们用什么来交换呢”*保持警戒"}
{"time": 1756218480, "type": "recv", "message_id": "1618957510", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶...还有人在路上吗？\"看向他，\"嗯...在哪里?\""}
{"time": 1756218538, "type": "recv", "message_id": "605224204", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "“给你们一个小小的建议，监管者大人就在里面”*朝里面努努嘴“不信的话可以自己去看”"}
{"time": 1756218579, "type": "recv", "message_id": "1960741863", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我知道啊...所以安安只是来，见见你。嗯...还有人?在哪里\""}
{"time": 1756218665, "type": "recv", "message_id": "827652799", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "“我又不是从者，感知能力哪有你们那么厉害呢”"}
{"time": 1756218700, "type": "recv", "message_id": "2112696814", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“那看来吃不了冰淇淋了…”"}
