{"time": 1756220306, "type": "recv", "message_id": "1533187366", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "“嗯哼，祝你们和监管者大人聊的愉快”"}
{"time": 1756220363, "type": "recv", "message_id": "1044264195", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"所以，只是问问姐姐去没去过天文台啦\""}
{"time": 1756220425, "type": "recv", "message_id": "1889600107", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "“你可以 揣摩一下”"}
{"time": 1756220450, "type": "recv", "message_id": "1228094626", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶...我明明带着善意来的嘛，要不要交换一些情报?\""}
{"time": 1756220487, "type": "recv", "message_id": "1417393919", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "*歪头看“我以为冰淇淋已经算我的善意了呢”"}
{"time": 1756220554, "type": "recv", "message_id": "2036342356", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "（我可怜的从者到现在连口水都没喝）"}
{"time": 1756220586, "type": "recv", "message_id": "594824421", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"交换啦，交换。\"摊摊手"}
{"time": 1756220633, "type": "recv", "message_id": "440045121", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "“你想要什么”"}
{"time": 1756220654, "type": "recv", "message_id": "1560415304", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“姐姐你想要情报吗？”"}
{"time": 1756220673, "type": "recv", "message_id": "1159574234", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“我在剧场看到一个吃起来应该会很腻的御主。”"}
