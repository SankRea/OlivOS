{"time": 1756219698, "type": "recv", "message_id": "209054720", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“太好了！”"}
