{"time": 1756390792, "type": "recv", "message_id": "2011864616", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "（我都听虚幻的喵）"}
{"time": 1756390797, "type": "recv", "message_id": "1234225840", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1067041556"}, "sender": {"id": "1067041556", "name": "虚幻过往"}, "message": "（从者死过一次了，不就失败了）"}
{"time": 1756390802, "type": "recv", "message_id": "1686873771", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(你每个回合不崩血我就骂你)"}
{"time": 1756390805, "type": "recv", "message_id": "259765450", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1067041556"}, "sender": {"id": "1067041556", "name": "虚幻过往"}, "message": "（那怎么，你想看我使命成功？）"}
{"time": 1756390809, "type": "recv", "message_id": "513466165", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(一血换两牌)"}
{"time": 1756390862, "type": "recv", "message_id": "1497477600", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "()"}
{"time": 1756390869, "type": "recv", "message_id": "2078049746", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(有点难绷)"}
{"time": 1756390884, "type": "recv", "message_id": "1983056684", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1067041556"}, "sender": {"id": "1067041556", "name": "虚幻过往"}, "message": "（难蚌在娜）"}
{"time": 1756390926, "type": "recv", "message_id": "2119394535", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1568784671]\"嗯哼...那么接下来我们慢慢谈谈吧。\"找到游客用的座位坐下，\"既然两位都知道我的来意，请开始吧。\""}
{"time": 1756390985, "type": "recv", "message_id": "389816833", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1067041556"}, "sender": {"id": "1067041556", "name": "虚幻过往"}, "message": "“所以，你们能提供什么”"}
{"time": 1756391006, "type": "recv", "message_id": "1466407315", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "“喔，刚刚你们进去，有个渡鸦在外面鬼鬼祟祟，被我一刀捅了”"}
{"time": 1756391006, "type": "recv", "message_id": "659117901", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"现阶段我所有的情报。\"靠着自己的手杖"}
{"time": 1756391066, "type": "recv", "message_id": "768842379", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "“但说实话，你怎么知道你的情报是不是对我们有效的”"}
{"time": 1756391095, "type": "recv", "message_id": "1404929965", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "（那谁怎么不见了）"}
{"time": 1756391104, "type": "recv", "message_id": "1069752141", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"当然，也包括我们之后的方针。\"坐在椅子上开口，\"唔...我知道你们会有疑问啦，不过故事还才第一卷，可不能心急。\""}
{"time": 1756391133, "type": "recv", "message_id": "927167580", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "“跟你一起进来的从者呢，不一起聊聊吗”"}
{"time": 1756391267, "type": "recv", "message_id": "297470866", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“不了，她有别的事要做。接下来的话不听比较好。”摇摇头，“请问吧，我一定知无不言...”"}
{"time": 1756391400, "type": "recv", "message_id": "1960744348", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "“你怎么说服另一位御主让他出借他的从者”"}
{"time": 1756391509, "type": "recv", "message_id": "223553411", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“并没有说服，我们只是因为必要的理由，一起行动到这里。”摊摊手，“毕竟西边的疯子们，又要剪人耳朵，又要捅人窟窿的。”"}
{"time": 1756391652, "type": "recv", "message_id": "1630590279", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1067041556"}, "sender": {"id": "1067041556", "name": "虚幻过往"}, "message": "“他们和你有仇是你的事，为什么找上我们”"}
{"time": 1756391718, "type": "recv", "message_id": "1968731869", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“如果他们联合起来了呢？”测过脑袋看着，“我想，我们也应该合理地聚在一起。”"}
{"time": 1756391775, "type": "recv", "message_id": "2122721288", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "“你不是已经有一位合作伙伴了吗，必要的理由可不是让从者共行的必要条件”"}
{"time": 1756391850, "type": "recv", "message_id": "954159326", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "“再者，请拿出他们联合的证据，而不是用假设来试图形成一个真实的联盟”"}
{"time": 1756391861, "type": "recv", "message_id": "494313194", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“为表诚意，我就先声明我的职介吧。”换出正式的衣服站起身，“本次圣杯战争的caster，是我。”摊摊手，“与其相信我和她的合作，不妨先在职介上做做文章？罗小黑姐姐，还是说，并不是真正的名字。”"}
{"time": 1756391894, "type": "recv", "message_id": "742541421", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "“你的假设不无道理，但是联盟是一个慎之又慎的事情”"}
{"time": 1756391968, "type": "recv", "message_id": "434014591", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "“名字只是一个代号而已，你愿意的话，当然可以这样喊我，我知道喊的是我”"}
{"time": 1756391984, "type": "recv", "message_id": "642131881", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我的冀望简单明了，作为caster，我需要阁下或者这位从者，帮我看守修建中的阵地，为此，我可以付出已有的情报交换。我已声明诚意。”等待答复"}
{"time": 1756392112, "type": "recv", "message_id": "1411036295", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "（我听虚幻的喵）"}
{"time": 1756392118, "type": "recv", "message_id": "1293959607", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "（你等他动）"}
{"time": 1756392127, "type": "recv", "message_id": "2039454595", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:image,file={E8A9A976-8FE7-5E75-F691-7203BAD47A2E}.png,sub_type=0,url=https://gchat.qpic.cn/gchatpic_new/0/0-0-E8A9A9768FE75E75F6917203BAD47A2E/0,file_size=16153]"}
{"time": 1756392130, "type": "recv", "message_id": "1527670735", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（邪恶）"}
{"time": 1756392133, "type": "recv", "message_id": "1060785336", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1067041556"}, "sender": {"id": "1067041556", "name": "虚幻过往"}, "message": "（你们谈吧）"}
{"time": 1756392140, "type": "recv", "message_id": "1354465774", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "（唉看我小窗）"}
{"time": 1756392249, "type": "recv", "message_id": "1886904575", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1067041556"}, "sender": {"id": "1067041556", "name": "虚幻过往"}, "message": "[CQ:reply,id=642131881]“只有情报未免太过空洞了吧”"}
{"time": 1756392284, "type": "recv", "message_id": "833202574", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1067041556"}, "sender": {"id": "1067041556", "name": "虚幻过往"}, "message": "“情报的价值需要我们建立信任，在此之前，你至少该拿出基本的诚意吧”"}
{"time": 1756392311, "type": "recv", "message_id": "556096285", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“诚意？我觉得你们应当会感兴趣。”手里的杖敲敲地板，“唯一的六级灵脉的位置。”"}
{"time": 1756392335, "type": "recv", "message_id": "847579008", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "“谢谢，这个不感兴趣”"}
{"time": 1756392368, "type": "recv", "message_id": "727466127", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“好吧，那还真是...”摊摊手，“你们想要怎样的诚意呢？”"}
{"time": 1756392370, "type": "recv", "message_id": "353017695", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1067041556"}, "sender": {"id": "1067041556", "name": "虚幻过往"}, "message": "“那你觉得，我们脚下这一块是几级灵脉呢”"}
{"time": 1756392642, "type": "recv", "message_id": "1268036764", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=727466127]“两位在此倒是待了很久。”不置可否。"}
{"time": 1756392780, "type": "recv", "message_id": "1120330491", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "2039502134"}, "sender": {"id": "2039502134", "name": "清词"}, "message": "*保持沉默，继续把玩手里的镜子"}
{"time": 1756392991, "type": "recv", "message_id": "754717920", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "3625185457"}, "sender": {"id": "3625185457", "name": "多拉贡"}, "message": "（感觉虚幻国王要睡了啊）"}
{"time": 1756393088, "type": "recv", "message_id": "1720929015", "deleted": false, "dect": {"host_id": null, "group_id": "1057832383", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(别急，在文明)"}
