{"time": 1757944032, "type": "recv", "message_id": "1184115571", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "（调查伦敦的杀人案？）"}
{"time": 1757944042, "type": "recv", "message_id": "1301526987", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "（我不是在伦敦？）"}
{"time": 1757944050, "type": "recv", "message_id": "1854720596", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "（阿卡姆）"}
{"time": 1757944052, "type": "recv", "message_id": "834586830", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "（阿卡姆）"}
{"time": 1757944054, "type": "recv", "message_id": "108209335", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2801086039"}, "sender": {"id": "2801086039", "name": "百分之八十三φ(._.)爬山虎"}, "message": "（雾）"}
