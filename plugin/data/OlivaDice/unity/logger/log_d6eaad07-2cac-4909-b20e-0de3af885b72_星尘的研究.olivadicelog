{"time": 1758633649, "type": "recv", "message_id": "1219928805", "deleted": false, "dect": {"host_id": null, "group_id": "1055214585", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "（典型的理科思维）"}
