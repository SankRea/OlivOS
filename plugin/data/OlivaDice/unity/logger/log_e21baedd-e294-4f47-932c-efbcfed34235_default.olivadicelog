{"time": 1770569505, "type": "recv", "message_id": "57763588", "deleted": false, "dect": {"host_id": null, "group_id": "1083423302", "user_id": "1257856112"}, "sender": {"id": "1257856112", "name": "09"}, "message": "战斗轮结束。"}
