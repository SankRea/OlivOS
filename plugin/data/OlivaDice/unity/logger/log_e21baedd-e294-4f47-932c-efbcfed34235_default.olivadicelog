{"time": 1770567091, "type": "recv", "message_id": "436017072", "deleted": false, "dect": {"host_id": null, "group_id": "1083423302", "user_id": "1486497852"}, "sender": {"id": "1486497852", "name": "海阔凭鱼跃"}, "message": "“谢谢！＞＜”"}
