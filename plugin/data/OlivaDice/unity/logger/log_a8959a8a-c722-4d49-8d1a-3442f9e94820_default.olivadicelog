{"time": 1751289890, "type": "recv", "message_id": "242063709", "deleted": true, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（300发没出是人类啊）"}
{"time": 1751289928, "type": "recv", "message_id": "690345019", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（300不出是人类啊）"}
{"time": 1751289942, "type": "recv", "message_id": "669605845", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（我好像挤不出来其他的了）"}
{"time": 1751290043, "type": "recv", "message_id": "559296928", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "[CQ:reply,id=343021909]“你们……就是为了什么？”"}
{"time": 1751290051, "type": "recv", "message_id": "1008796904", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "[CQ:reply,id=559296928]（究竟）"}
{"time": 1751290147, "type": "recv", "message_id": "219766498", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“啊，没什么，就是觉得你好没用。”打着哈欠，“你这种人，坐在这种位置，浪费大家的时间”"}
{"time": 1751290209, "type": "recv", "message_id": "158126417", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“我没用？我辛辛苦苦建立起如今的黄王教，我没用？”"}
{"time": 1751290324, "type": "recv", "message_id": "624906899", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "摊摊手，\"黄衣老爷，你也觉得他没什么价值了吧？\"看着蜡像，\"被手下背叛，作为祭司被人侮辱，而且，当甩手掌柜，笑，有考虑过让其他人代替他吗？\""}
{"time": 1751290324, "type": "recv", "message_id": "659445656", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“这么块小石头都要拖半天……很难说服人你有用啊”"}
{"time": 1751290447, "type": "recv", "message_id": "253631440", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“你们！……”"}
{"time": 1751290501, "type": "recv", "message_id": "1420060280", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（我在想，法术是能口口相传的东西吗）"}
{"time": 1751290512, "type": "recv", "message_id": "361608072", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“看起来祭司大人不打算好好配合？”"}
{"time": 1751290517, "type": "recv", "message_id": "393421228", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（像这种请神术"}
{"time": 1751290535, "type": "recv", "message_id": "1286615362", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（应该要看书学到吧"}
{"time": 1751290550, "type": "recv", "message_id": "1831688052", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（他是怎么学到的）"}
{"time": 1751290558, "type": "recv", "message_id": "1412918731", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（就不能记下来吗（））"}
{"time": 1751290561, "type": "recv", "message_id": "1212920373", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（看书）"}
{"time": 1751290589, "type": "recv", "message_id": "2046379657", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那书呢）"}
{"time": 1751290596, "type": "recv", "message_id": "999631646", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（你是对的"}
{"time": 1751290619, "type": "recv", "message_id": "301875666", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"无聊的家伙，你有什么用?自己的东西都看不好，坐在这种地方也是浪费。\"打个哈欠，把几个蜡像拼起来看看，\"黄衣老爷知道吗？\""}
{"time": 1751290682, "type": "recv", "message_id": "785954777", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“祂可是给我降下了神谕，要我领导你们执行祂降临的神圣任务”"}
{"time": 1751290780, "type": "recv", "message_id": "652519643", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“你把咒文交出来就好了，我们会办好的。你在下面看着就行了”"}
{"time": 1751290839, "type": "recv", "message_id": "1460959172", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“……我可以把请神术的咒文给你们，但是你们得放过我”"}
{"time": 1751290883, "type": "recv", "message_id": "689942723", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"你不死，我心难安。\""}
{"time": 1751290915, "type": "recv", "message_id": "580552438", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“哎，你这么说，他就不想交了”"}
{"time": 1751290922, "type": "recv", "message_id": "1274064019", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“这样吧，我换个说法”"}
{"time": 1751290958, "type": "recv", "message_id": "1562641608", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“你呢，肯定是活不了了。但是你要是不把请神术传给我们，那黄衣之王不能现世，你就是头号罪人了”"}
{"time": 1751291189, "type": "recv", "message_id": "1444188717", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "祭司沉默了一会，终于开口，然而从他口中传出的却是晦涩的语句，顾幼龄一听就知道，那是哈斯塔之歌的前置咏唱词"}
{"time": 1751291205, "type": "recv", "message_id": "2118716032", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "封住他的嘴巴"}
{"time": 1751291210, "type": "recv", "message_id": "1767517575", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "顺手扇一巴掌"}
{"time": 1751291223, "type": "recv", "message_id": "1892458426", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我又不是不懂，你又是何必呢，\""}
{"time": 1751291232, "type": "recv", "message_id": "1650532606", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"肖哥啊，上刀吧。\""}
{"time": 1751291255, "type": "recv", "message_id": "1258723483", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*把刀伸进他的嘴巴里，把舌头割下来"}
{"time": 1751291274, "type": "recv", "message_id": "1204436409", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "鲜血从他口中涌出"}
{"time": 1751291442, "type": "recv", "message_id": "702141860", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“看起来，祭司大人比起对主的虔诚，终归还是更爱自己啊……没有指摘您的意思，但是对主教来说，有点不够称职了”*摇摇头，把舌头挑出来包好"}
{"time": 1751291874, "type": "recv", "message_id": "1630416600", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（所以后面呢）"}
{"time": 1751291906, "type": "recv", "message_id": "1598529680", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（呃）"}
{"time": 1751291911, "type": "recv", "message_id": "502262526", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（他不动了吗）"}
{"time": 1751291951, "type": "recv", "message_id": "814124658", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“邓可欣，你知道我们的祭司大人有什么地窖、密室、仪式台之类的地方吗？”"}
