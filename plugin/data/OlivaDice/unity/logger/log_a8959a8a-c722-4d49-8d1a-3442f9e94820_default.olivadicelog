{"time": 1752502041, "type": "recv", "message_id": "1389756022", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"只能先等等看咯\""}
{"time": 1752502051, "type": "recv", "message_id": "899217489", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"这里，我也不好便宜行事\""}
{"time": 1752502260, "type": "recv", "message_id": "275497687", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“给他们灌酒吧，酒精会帮他们回忆的”*耸肩"}
{"time": 1752502359, "type": "recv", "message_id": "960998713", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“叫服务员上点烈酒吧”"}
{"time": 1752502374, "type": "recv", "message_id": "493800861", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"真麻烦，是不是?\"听完，\"不会是你要喝吧？\""}
{"time": 1752502399, "type": "recv", "message_id": "445074484", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"但是呢....他们来这里，我可没对他们之外的人说自己是谁\""}
{"time": 1752502429, "type": "recv", "message_id": "1521096517", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“啊呀，被发现了。不过根据我的经验，酒精能帮人往大事化小，小事化了的方向自圆其说”"}
{"time": 1752502467, "type": "recv", "message_id": "1927929280", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“要不你和你的那个号前辈试试能不能吃完？”"}
{"time": 1752502481, "type": "recv", "message_id": "1495777571", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"感觉问题也不大?\"坐在席位上，\"既然他们要来，不如等等也行\""}
{"time": 1752502483, "type": "recv", "message_id": "207025446", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……？”"}
{"time": 1752502533, "type": "recv", "message_id": "1123769912", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“至少240公斤，两头老虎都吃不下，更别提现场处理”"}
{"time": 1752502559, "type": "recv", "message_id": "1949322911", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“我觉得你小看老虎了。”"}
{"time": 1752502574, "type": "recv", "message_id": "56828138", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“或者拜亚基也许能吃完？”"}
{"time": 1752502612, "type": "recv", "message_id": "261416625", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那倒是不错的想法。\""}
{"time": 1752502673, "type": "recv", "message_id": "835773663", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "拿出哨子，\"怎么说?\""}
{"time": 1752502715, "type": "recv", "message_id": "1677341070", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“白天能喊的出来吗？如果能的话，那应该确实不错”"}
{"time": 1752502732, "type": "recv", "message_id": "818251484", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（上次砍祭司不就是白天叫的）"}
{"time": 1752502742, "type": "recv", "message_id": "1125287114", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“但我先叫点酒水，到时候把邢森扛走也方便找借口”"}
