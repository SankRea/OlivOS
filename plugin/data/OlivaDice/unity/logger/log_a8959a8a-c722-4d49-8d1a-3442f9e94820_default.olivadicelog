{"time": 1750343000, "type": "recv", "message_id": "1807514693", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（5月19有一场舞台剧说是"}
