{"time": 1750256738, "type": "recv", "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。ra侦查"}
{"time": 1750256738, "type": "reply", "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[顾幼龄]进行技能[侦查:60]检定: 1D100=84 失败，人面不知何处去，桃花依旧笑春风"}
