{"time": 1752335386, "type": "recv", "message_id": "1441683097", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哦?我不可以进吗？\""}
