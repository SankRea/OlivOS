{"time": 1752335528, "type": "recv", "message_id": "1394263382", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（上来就来一句我不能进吗？是何意）"}
