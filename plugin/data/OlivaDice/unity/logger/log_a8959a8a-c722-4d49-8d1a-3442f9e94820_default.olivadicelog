{"time": 1750351269, "type": "recv", "message_id": "1512465491", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（冰毒可以拿来当致幻剂）"}
