{"time": 1750610683, "type": "recv", "message_id": "1974960714", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（三男一女是吧）"}
