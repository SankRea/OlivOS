{"time": 1750262886, "type": "recv", "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“毕竟这里还有其他不是我这边的人”"}
