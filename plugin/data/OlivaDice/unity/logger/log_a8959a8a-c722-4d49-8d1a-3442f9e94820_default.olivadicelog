{"time": 1750256333, "type": "recv", "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我是邓文，他舅舅”"}
{"time": 1750256333, "type": "recv", "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“这位是我妹妹，她还未成年没有办身份证。”"}
