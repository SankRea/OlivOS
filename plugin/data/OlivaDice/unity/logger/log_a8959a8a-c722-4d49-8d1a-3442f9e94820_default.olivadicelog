{"time": 1752335600, "type": "recv", "message_id": "1247904035", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（三个高尔夫球场的员工？）"}
