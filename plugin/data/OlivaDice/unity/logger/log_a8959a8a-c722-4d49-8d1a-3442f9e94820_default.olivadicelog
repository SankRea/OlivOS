{"time": 1750610238, "type": "recv", "message_id": "2041270662", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“你先不要着急，我们一定会帮你把她找出来的”"}
