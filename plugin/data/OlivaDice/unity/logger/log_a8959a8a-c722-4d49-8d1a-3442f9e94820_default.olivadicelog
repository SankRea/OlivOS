{"time": 1752335811, "type": "recv", "message_id": "1057919475", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"啧，你管我的事干嘛，我就是来找里面的人。\""}
