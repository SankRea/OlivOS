{"time": 1750256177, "type": "recv", "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“我是邓可欣的表哥”"}
{"time": 1750256187, "type": "recv", "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“这两位呢？”"}
{"time": 1750256236, "type": "recv", "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我是邓幽灵\""}
{"time": 1750256243, "type": "recv", "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（？）"}
