{"time": 1752074017, "type": "recv", "message_id": "1386853492", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "你刚好看见摔倒的护士爬起来，两个队友跑掉了"}
{"time": 1752074085, "type": "recv", "message_id": "1540687395", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "[CQ:image,file=1DFE89DEDB15B7C66A2AC271AA1C4DDD.jpg,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhQAH1cKmbkw2RixUAlMmrYjnr8ZSRjrnAIg_woootjBy4iwjgMyBHByb2RQgL2jAVoQuTfd5ovqmHK_aKDmrgduA3oCQ8E&amp;rkey=CAMSMEEpZ2tdCeP1DG7VnomfUvrnTf_aCADaWYx0nWeYAZE64r_J5fWOCHBfgPbmYhbL9w,file_size=36459]"}
{"time": 1752074135, "type": "recv", "message_id": "1919261523", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:image,file=1DFE89DEDB15B7C66A2AC271AA1C4DDD.jpg,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhQAH1cKmbkw2RixUAlMmrYjnr8ZSRjrnAIg_woonLbJ44iwjgMyBHByb2RQgL2jAVoQD9AvIqgiIyyv27ECjEsKz3oCVZg&amp;rkey=CAMSMEEpZ2tdCeP1DG7VnomfUvrnTf_aCADaWYx0nWeYAZE64r_J5fWOCHBfgPbmYhbL9w,file_size=36459]"}
{"time": 1752074144, "type": "recv", "message_id": "2127410076", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:image,file={46B19B03-7AEB-448E-7397-F12F7939E21F}.jpg,sub_type=0,url=https://gchat.qpic.cn/gchatpic_new/0/0-0-46B19B037AEB448E7397F12F7939E21F/0,file_size=32188]"}
{"time": 1752074264, "type": "recv", "message_id": "1158581525", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "*上前扶起护士询问发生了什么"}
{"time": 1752074291, "type": "recv", "message_id": "33501877", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“病人精神病复发了，快去把他追回来”"}
{"time": 1752074327, "type": "recv", "message_id": "597618773", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“好的，你没有哪里受伤吧，先回车里处理一下伤口。”"}
{"time": 1752074330, "type": "recv", "message_id": "269496387", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“我去追人。”"}
{"time": 1752074347, "type": "recv", "message_id": "818772288", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“嗯，快去吧”"}
{"time": 1752074363, "type": "recv", "message_id": "63783234", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "*然后跟上去找个没有摄像头的地方和他们碰头"}
{"time": 1752074423, "type": "recv", "message_id": "1490992758", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "几经周折汇合了"}
{"time": 1752074464, "type": "recv", "message_id": "698676312", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“那么成功逃出来了，没有什么事我先回去了，就说我没追上。”"}
{"time": 1752074468, "type": "recv", "message_id": "1804713097", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“真是一个，很有喜剧色彩的计划呢”沈群说道"}
{"time": 1752074500, "type": "recv", "message_id": "1908255180", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好了，秃鹫先生，能出来就行。不过你好像还不知道\""}
{"time": 1752074501, "type": "recv", "message_id": "544504103", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“你们尽量绕路回据点，走摄像头少的小路。”"}
{"time": 1752074508, "type": "recv", "message_id": "701862850", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"教内已经易主了。\""}
{"time": 1752074530, "type": "recv", "message_id": "1218178519", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“嗯？”"}
{"time": 1752074560, "type": "recv", "message_id": "1733240228", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“那你前两天怎么没说”"}
{"time": 1752074571, "type": "recv", "message_id": "1140257145", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“今天才发生的事，我们干的”"}
{"time": 1752074573, "type": "recv", "message_id": "465924843", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"今天早上的事情。\""}
{"time": 1752074585, "type": "recv", "message_id": "168979529", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“现在你可以是副教主了”"}
{"time": 1752074594, "type": "recv", "message_id": "1313816998", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“………”"}
{"time": 1752074609, "type": "recv", "message_id": "1025954734", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“那你们确实挺厉害的”"}
{"time": 1752074634, "type": "recv", "message_id": "1127810189", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我也不想的，只是没忍住”"}
{"time": 1752074666, "type": "recv", "message_id": "1096789723", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“说起来前任教主和他的两个倒霉手下好像还没死，你要不要尝尝？”"}
{"time": 1752074701, "type": "recv", "message_id": "419728187", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“啊呀，这么亵渎吗？”"}
{"time": 1752074712, "type": "recv", "message_id": "2085868221", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“不过我喜欢”舔嘴唇"}
{"time": 1752074750, "type": "recv", "message_id": "771796570", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"教主还是要留活的，毕竟是新鲜的祭品。\""}
{"time": 1752074766, "type": "recv", "message_id": "1989673134", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“食物的问题先谈到这里，我先回去了，没有我的什么事了吧，我得回去给个交代。”"}
{"time": 1752074786, "type": "recv", "message_id": "619574417", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“你可以摔一跤，什么的”"}
{"time": 1752074798, "type": "recv", "message_id": "1531711294", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"剩下的目标好像只剩下三个叛徒了，有什么想法吗？\""}
{"time": 1752074912, "type": "recv", "message_id": "1054063624", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“找到他们在哪，然后把他们抓住，不就好了”"}
{"time": 1752074931, "type": "recv", "message_id": "1827217323", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“我们只要抓活的就行，不必在意他们是否意识清醒是吧，我可以做点致幻剂试试。”"}
{"time": 1752074950, "type": "recv", "message_id": "1415067628", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“你们只用考虑如何让他们吃下药物就行了。”"}
{"time": 1752074955, "type": "recv", "message_id": "533516861", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"时间上倒还是来得及。\""}
{"time": 1752075050, "type": "recv", "message_id": "1285500327", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "*往自己白大褂上抹点灰假装摔倒了。"}
{"time": 1752075081, "type": "recv", "message_id": "2138591795", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“好了，晚上见”"}
{"time": 1752075155, "type": "recv", "message_id": "1681863747", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "*回去救护车上"}
{"time": 1752075175, "type": "recv", "message_id": "1529928383", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“我跟丢了，这地方小巷太多了，不知道他们往哪跑了，我还摔了一跤。”"}
{"time": 1752075183, "type": "recv", "message_id": "84436930", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“怎么样？怎么没有追到患者”"}
{"time": 1752075196, "type": "recv", "message_id": "1416084229", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“前辈，这下怎么办啊？我的实习是不是完蛋了。”"}
{"time": 1752075238, "type": "recv", "message_id": "1034599283", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“唉，实习遇到这种事也是难办”"}
{"time": 1752075258, "type": "recv", "message_id": "28904289", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“放轻松吧，这种也算不可抗力了”"}
{"time": 1752075295, "type": "recv", "message_id": "1464128341", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“但是精神病人出逃了可不妙，还是报警先吧”"}
{"time": 1752075336, "type": "recv", "message_id": "87212947", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“也许可以先打电话问问那两名家属，说不定他们追上了。”"}
{"time": 1752075398, "type": "recv", "message_id": "376688690", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "医生向医院那边要到了电话号码，打给了肖"}
{"time": 1752075401, "type": "recv", "message_id": "528186775", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "[CQ:at,qq=825734198]"}
{"time": 1752075483, "type": "recv", "message_id": "1590506262", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（打我的吗）"}
{"time": 1752075487, "type": "recv", "message_id": "863183172", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我在想）"}
{"time": 1752075507, "type": "recv", "message_id": "499207950", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（不接会怎么样，但是他们真报警会怎么样呢）"}
{"time": 1752075511, "type": "recv", "message_id": "977399415", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（好像也不会怎么样）"}
{"time": 1752075513, "type": "recv", "message_id": "511498039", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*不管！"}
{"time": 1752075531, "type": "recv", "message_id": "1454579532", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*然后把号码和手机处理掉"}
{"time": 1752075533, "type": "recv", "message_id": "458086165", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（难道不能说已经找到了，恢复神智了）"}
{"time": 1752075535, "type": "recv", "message_id": "1980789029", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“………打不通”"}
{"time": 1752075554, "type": "recv", "message_id": "196167178", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（恢复神智也会回精神病院吧）"}
{"time": 1752075594, "type": "recv", "message_id": "861291443", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好啦。\"卸掉伪装，\"今天没什么事的话，那就明天再见吧。\""}
{"time": 1752075631, "type": "recv", "message_id": "1663718109", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“明天去找那三个人里面哪个？”"}
{"time": 1752075635, "type": "recv", "message_id": "1468263453", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "沈群说"}
{"time": 1752075655, "type": "recv", "message_id": "1060843282", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "[CQ:reply,id=1980789029]“只能先报警了”医生叹口气"}
{"time": 1752075668, "type": "recv", "message_id": "1337018244", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（感觉我应该拿那两个小弟的手机的）"}
{"time": 1752075678, "type": "recv", "message_id": "1104037920", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（没想到这里，sign）"}
{"time": 1752075679, "type": "recv", "message_id": "1331650350", "deleted": false, "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"都不是什么善茬，但是先后...先从公共影响力最小的人。\""}
