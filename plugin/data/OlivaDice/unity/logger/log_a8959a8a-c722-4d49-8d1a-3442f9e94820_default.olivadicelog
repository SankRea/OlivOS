{"time": 1749735696, "type": "recv", "dect": {"host_id": null, "group_id": "1050565807", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“这儿的监控是坏的……天助我也”"}
{"time": 1749735797, "type": "recv", "dect": {"host_id": null, "group_id": "1050565807", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...有点意思。\""}
