{"time": 1770643205, "type": "recv", "message_id": "1980826923", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "两人离开之后"}
{"time": 1770643264, "type": "recv", "message_id": "1941495667", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯，找负责人填表申请就好了。有声望的社员也可以直接举荐。不过我可能不在此列”"}
{"time": 1770643286, "type": "recv", "message_id": "268117826", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”负责人，是谁啊？“"}
{"time": 1770643297, "type": "recv", "message_id": "2108679658", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”每个社团的负责人嘛？“"}
{"time": 1770643331, "type": "recv", "message_id": "594269494", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯”"}
{"time": 1770643377, "type": "recv", "message_id": "1867095001", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”巫山，你认识将棋社的负责人吗？“"}
{"time": 1770643423, "type": "recv", "message_id": "706308159", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*摇头"}
{"time": 1770643492, "type": "recv", "message_id": "2096955930", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”好吧，那我自己去找找将棋社。应该是在教学楼的某间教室里吧“"}
{"time": 1770643600, "type": "recv", "message_id": "753028921", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我觉得我可能可以知道）"}
