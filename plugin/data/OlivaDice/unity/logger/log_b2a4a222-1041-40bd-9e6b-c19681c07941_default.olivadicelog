{"time": 1773412078, "type": "recv", "message_id": "630735197", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(就成现在这样了)"}
