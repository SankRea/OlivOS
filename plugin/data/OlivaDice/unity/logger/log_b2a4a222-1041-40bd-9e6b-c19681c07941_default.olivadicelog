{"time": 1770643656, "type": "recv", "message_id": "713317347", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（何意味）"}
{"time": 1770643696, "type": "recv", "message_id": "1791648859", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“将棋社我记得在图书馆对门的样子”"}
