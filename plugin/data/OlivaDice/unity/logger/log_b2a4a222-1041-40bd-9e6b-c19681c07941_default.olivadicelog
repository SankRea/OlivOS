{"time": 1772437990, "type": "recv", "message_id": "571701743", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“不知道……先回学校吧”越来越不安"}
{"time": 1772438059, "type": "recv", "message_id": "199948720", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "”好吧……“"}
{"time": 1772438148, "type": "recv", "message_id": "627948927", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“那个，矢吹同学是不是没去过后山的神社？”"}
{"time": 1772438294, "type": "recv", "message_id": "709746190", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“没有”"}
