{"time": 1772437929, "type": "recv", "message_id": "838875141", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1677989820]依旧无人应答"}
