{"time": 1772356698, "type": "recv", "message_id": "47515096", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "教师办公室里静悄悄地，除了窗外回荡的雨声...和你们的谈话声。"}
{"time": 1772356720, "type": "recv", "message_id": "989057174", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（何意味）"}
{"time": 1772356739, "type": "recv", "message_id": "368276743", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“为什么是神山同学？”看着手机“我也联系不上她”"}
{"time": 1772356754, "type": "recv", "message_id": "320229413", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“因为在这个时间点，刚好她消失了”"}
{"time": 1772356832, "type": "recv", "message_id": "276383147", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“她……”忍着内心的恐惧，走上前去看看老师的死因"}
{"time": 1772356963, "type": "recv", "message_id": "1439867724", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我不清楚死因”"}
{"time": 1772356973, "type": "recv", "message_id": "888589992", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(因为没点医学)"}
{"time": 1772356991, "type": "recv", "message_id": "816434623", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“但是看样子，死亡并不是一件轻松的事情”"}
{"time": 1772356993, "type": "recv", "message_id": "1304864761", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "（没正经高中生点这个把）"}
{"time": 1772357075, "type": "recv", "message_id": "1638922351", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（主要是看看有没有外伤）"}
{"time": 1772357077, "type": "recv", "message_id": "730859527", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（而已）"}
{"time": 1772357096, "type": "recv", "message_id": "1354953153", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（毕竟有血腥味）"}
{"time": 1772357105, "type": "recv", "message_id": "501293752", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(你去)"}
{"time": 1772357110, "type": "recv", "message_id": "1266996763", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(我是可怜高中生)"}
{"time": 1772357121, "type": "recv", "message_id": "1794146614", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(这样吧)"}
{"time": 1772357124, "type": "recv", "message_id": "2099267570", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(申请侦查)"}
{"time": 1772357141, "type": "recv", "message_id": "593749802", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(你们两个骰子挺有意思的)"}
{"time": 1772357142, "type": "recv", "message_id": "683048098", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*仔细检查老师身上的伤口有没有"}
{"time": 1772357147, "type": "recv", "message_id": "1519771939", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(你要侦查什么)"}
{"time": 1772357477, "type": "recv", "message_id": "1968075467", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“哪里漏水了吗？”顿住，抬头看看“好像有人在唱歌，像是……神弃川 is falling down”"}
{"time": 1772357493, "type": "recv", "message_id": "2118179099", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“有吗？”"}
{"time": 1772357497, "type": "recv", "message_id": "925990982", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*看向四周"}
{"time": 1772357543, "type": "recv", "message_id": "1756451160", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我只能听到雨水的声音”"}
{"time": 1772357561, "type": "recv", "message_id": "1238517464", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“无论如何，已经没有更多的时间分析了，我们必须要找到神山露”"}
{"time": 1772357561, "type": "recv", "message_id": "1556711760", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "雨幕无声无息"}
{"time": 1772357606, "type": "recv", "message_id": "1224504291", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "#不由自主地干呕起来"}
{"time": 1772357647, "type": "recv", "message_id": "910918525", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "以及，看见尸体sc1/1d3"}
{"time": 1772357734, "type": "recv", "message_id": "1118307807", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=276383147]腹部破了个口子，这么说或许不明确，但如你所见，整个人的腹部的衣物被鲜红色浸透，液滴顺着衣衫一滴一滴落到地上，发出滴答的声音。有些在意的是，衣物本身没有破。"}
{"time": 1772357790, "type": "recv", "message_id": "1118957814", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“这是从内部破开的？”"}
{"time": 1772357800, "type": "recv", "message_id": "1721178072", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*干呕"}
{"time": 1772357842, "type": "recv", "message_id": "1386767936", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“咿呀……！”只看了一眼就不敢继续看下去，闭着眼睛后退直到碰壁"}
{"time": 1772357900, "type": "recv", "message_id": "1874946139", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“不能让尸体留在这里”"}
{"time": 1772357918, "type": "recv", "message_id": "573421802", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“等下课了，一切都会被公布”"}
{"time": 1772357939, "type": "recv", "message_id": "411283655", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你是赵高？）"}
{"time": 1772357977, "type": "recv", "message_id": "1523282149", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“如果诅咒开始的消息被公布，恐怕慌乱只是更大”"}
{"time": 1772357989, "type": "recv", "message_id": "949514492", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我的意见还是如同一开始，报警”"}
{"time": 1772358048, "type": "recv", "message_id": "252540625", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“这……这怎么处理？”有些慌神“马上别的老师也快下课了”"}
{"time": 1772358113, "type": "recv", "message_id": "1367104937", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*拿出手机"}
{"time": 1772358116, "type": "recv", "message_id": "792176148", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*报警"}
{"time": 1772358168, "type": "recv", "message_id": "1680254508", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*把现场的情况描述一下，希望警察能够迅速赶到现场"}
{"time": 1772358288, "type": "recv", "message_id": "749933544", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "#战战兢兢起身，拉扯雨纪的裙角"}
{"time": 1772358293, "type": "recv", "message_id": "187948191", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“神山同学，是不是也……”"}
{"time": 1772358300, "type": "recv", "message_id": "861297683", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“或许没有”"}
{"time": 1772358305, "type": "recv", "message_id": "2083194175", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“希望没有”"}
{"time": 1772358431, "type": "recv", "message_id": "1520812489", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“我，我想去找找她”"}
{"time": 1772358444, "type": "recv", "message_id": "1277393901", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“班长，你知道她住在哪儿嘛？”"}
{"time": 1772358483, "type": "recv", "message_id": "843957962", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“现在吗？实话说，我们应该等等警察然后把神山同学的事情也汇报一下”"}
{"time": 1772358523, "type": "recv", "message_id": "539443441", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“另外一方面是，我们得找出为什么诅咒开始了”"}
{"time": 1772358560, "type": "recv", "message_id": "816102010", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“她今天早上还给我打了电话”摇摇头“太早了，我没接到。不过……事到如今，怎么开始的还有意义吗？”"}
{"time": 1772358583, "type": "recv", "message_id": "14256395", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我也早上有神山同学打来的电话，也是没接到”"}
{"time": 1772358615, "type": "recv", "message_id": "1411416961", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“事情怎么开始的，我们得了解，兴许，兴许我们有方案补救”"}
{"time": 1772358635, "type": "recv", "message_id": "149341038", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯……怎么结束才是重点”"}
{"time": 1772358648, "type": "recv", "message_id": "1820630520", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我不想死……”"}
{"time": 1772358656, "type": "recv", "message_id": "231772693", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我有个主意，虽然这么说可能不太好”"}
{"time": 1772358669, "type": "recv", "message_id": "477776003", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“诅咒大概率是因为有人和她接触了”"}
{"time": 1772358691, "type": "recv", "message_id": "1632028625", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“如果我们把接触的那个人也给不存在化是不是”"}
{"time": 1772358696, "type": "recv", "message_id": "963363451", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“是不是可以”"}
{"time": 1772358700, "type": "recv", "message_id": "1006047977", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*叹气"}
{"time": 1772358720, "type": "recv", "message_id": "820800126", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "“以前，也发生过这样的事吗？”"}
{"time": 1772358726, "type": "recv", "message_id": "376605361", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（时点不对（）"}
{"time": 1772358736, "type": "recv", "message_id": "440493916", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“是的，以前发生过这样的事情”"}
{"time": 1772358738, "type": "recv", "message_id": "1885905765", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（讨论出人选这件事本身）"}
{"time": 1772358746, "type": "recv", "message_id": "907929226", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（就绕不开提及那个人）"}
{"time": 1772358757, "type": "recv", "message_id": "1521452389", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(所以重新开始屏蔽掉)"}
{"time": 1772358766, "type": "recv", "message_id": "1954383082", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（没法重新吧）"}
{"time": 1772358773, "type": "recv", "message_id": "746245482", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(只能试试了)"}
{"time": 1772358775, "type": "recv", "message_id": "900578989", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(还是说)"}
{"time": 1772358781, "type": "recv", "message_id": "2099859324", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(你有其他馊主意)"}
{"time": 1772358781, "type": "recv", "message_id": "164567113", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那得在今年开始前）"}
{"time": 1772358787, "type": "recv", "message_id": "1450279527", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我确实有其他馊主意）"}
