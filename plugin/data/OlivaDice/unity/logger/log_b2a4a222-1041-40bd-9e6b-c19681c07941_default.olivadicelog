{"time": 1772512963, "type": "recv", "message_id": "590889655", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(顶针?)"}
{"time": 1772513078, "type": "recv", "message_id": "618441971", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "SV"}
{"time": 1773408124, "type": "recv", "message_id": "260127294", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "()"}
{"time": 1773408144, "type": "recv", "message_id": "2001461590", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪章如梦"}, "message": "#去神社"}
{"time": 1773408223, "type": "recv", "message_id": "1881870791", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "通往后山的道路，虽然昨天雨纪已经走过一回，但再走一次仍然不轻松。"}
{"time": 1773408300, "type": "recv", "message_id": "1090397789", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“有点冷……”"}
{"time": 1773408346, "type": "recv", "message_id": "1164757591", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "“嗯……”"}
{"time": 1773408396, "type": "recv", "message_id": "56864966", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "前人开辟的小径几近荒废，杂草肆意蔓延在脚踝左右，花了点时间，你们顺利抵达了一个褪色的鸟居附近。"}
{"time": 1773408456, "type": "recv", "message_id": "1848283764", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "风声拂过，生锈的风铃发出不清脆的响动。不过从这里再往上走的路似乎好走了很多，至少明显经过了好好的维修"}
{"time": 1773408480, "type": "recv", "message_id": "1294311392", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "抵达鸟居的时候，手机消息铃响了"}
{"time": 1773408495, "type": "recv", "message_id": "602030234", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "#看看手机"}
{"time": 1773408513, "type": "recv", "message_id": "1552591642", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "#看看手机"}
{"time": 1773408572, "type": "recv", "message_id": "207230362", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*皱眉"}
{"time": 1773408618, "type": "recv", "message_id": "1460635728", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "“是雨纪的消息呢。医院那边发生什么了吗？”"}
{"time": 1773408700, "type": "recv", "message_id": "2059346776", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯，折原同学说神山同学暂时没事”"}
{"time": 1773408734, "type": "recv", "message_id": "156068", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“以及说是神山同学的家人接触过了”"}
{"time": 1773408737, "type": "recv", "message_id": "1308493499", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（伏地魔）"}
{"time": 1773408804, "type": "recv", "message_id": "1918410831", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "#又看了看手机，脸色骤变"}
{"time": 1773408808, "type": "recv", "message_id": "319206634", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "“呐，那个，雨纪……”"}
{"time": 1773408833, "type": "recv", "message_id": "1866121977", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“怎么了？”"}
{"time": 1773408861, "type": "recv", "message_id": "1871498199", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "“可以，现在下山吗？”"}
{"time": 1773408912, "type": "recv", "message_id": "1741496257", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“怎么了，这才刚上来”有些疑惑“发生什么了？”"}
{"time": 1773408986, "type": "recv", "message_id": "1821814318", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "“解释起来有点复杂……请相信我，我没有恶意的”"}
{"time": 1773409026, "type": "recv", "message_id": "569667852", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "“你看，神山同学也是，很可能在神社遭遇了什么，我们还是先问问他的情况吧”"}
{"time": 1773409032, "type": "recv", "message_id": "514190895", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "（她）"}
{"time": 1773409072, "type": "recv", "message_id": "136219531", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……好吧”没多说什么“先问问她也好”"}
{"time": 1773409116, "type": "recv", "message_id": "1876809135", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "“嗯，谢谢”"}
{"time": 1773409146, "type": "recv", "message_id": "431303948", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "#最后看了看神社，然后向山下走去"}
{"time": 1773409308, "type": "recv", "message_id": "1500441550", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "#最后看了看神社，然后向山下走去"}
{"time": 1773409378, "type": "recv", "message_id": "2112606173", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "从这里自然看不见神社，大概还有半程的路没有走。"}
{"time": 1773409409, "type": "recv", "message_id": "1466028631", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "你们只能看见褪色的鸟居耸立在半山腰，生锈的风铃一摇一摇"}
{"time": 1773409618, "type": "recv", "message_id": "1092925618", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "下山的路这次走得快了些，几乎没有发生什么意外的事情。不过可以过个侦查。"}
{"time": 1773409809, "type": "recv", "message_id": "685041831", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(要说什么吗？没什么就下山了)"}
{"time": 1773409833, "type": "recv", "message_id": "387727858", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "（no）"}
{"time": 1773409852, "type": "recv", "message_id": "94349798", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（no）"}
{"time": 1773409886, "type": "recv", "message_id": "1844229602", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "那么你们顺利下了山，从这里往西是去学校，往东是去医院"}
{"time": 1773409958, "type": "recv", "message_id": "329908275", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "*先回学校吧"}
{"time": 1773410009, "type": "recv", "message_id": "1588040544", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "#跟随"}
{"time": 1773410266, "type": "recv", "message_id": "416295653", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "你们抵达学校附近的时候就看见，在校门口的檐下，班长正等在那里"}
{"time": 1773410281, "type": "recv", "message_id": "1897478201", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "一看见你们，他就迫不及待开口，“怎么样，你们有什么发现吗”"}
{"time": 1773410335, "type": "recv", "message_id": "1657249909", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“非要说的话，也是有的”"}
{"time": 1773410369, "type": "recv", "message_id": "423121387", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“神山家里，似乎已经有一阵子没人住过了”"}
{"time": 1773410463, "type": "recv", "message_id": "1910910992", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "班长似乎有些疑惑，“可是她刚刚和我说。”停顿，“她早上出门的时候她妈妈还因为交谈破坏了诅咒？”"}
{"time": 1773410534, "type": "recv", "message_id": "2049581283", "deleted": true, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "[CQ:forward,id=7616740246777971802]"}
{"time": 1773410548, "type": "recv", "message_id": "473512158", "deleted": true, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "（好像，是不能说明什么）"}
{"time": 1773410549, "type": "recv", "message_id": "1576591669", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯。很奇怪对吧？”扶额，语气低落“她在电话里和你说的吗？”"}
{"time": 1773410571, "type": "recv", "message_id": "2001632115", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "（我的）"}
{"time": 1773410603, "type": "recv", "message_id": "745595676", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "（才想起来是秘密团）"}
{"time": 1773410633, "type": "recv", "message_id": "1929432837", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（）"}
{"time": 1773410641, "type": "recv", "message_id": "1016881310", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(发了啥)"}
{"time": 1773410657, "type": "recv", "message_id": "1580898859", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "（没什么（）"}
{"time": 1773410758, "type": "recv", "message_id": "973924283", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“是，她本来应该用不了多久就要来学校了?”班长皱眉，\"奇怪。\""}
{"time": 1773410790, "type": "recv", "message_id": "681114472", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯，她家就住商业街，不远”"}
{"time": 1773410922, "type": "recv", "message_id": "1053800007", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我还是不太明白，如果说她家里根本没人住，那她又是怎么...”"}
{"time": 1773410967, "type": "recv", "message_id": "1475012553", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“重要的是她今天早上去了哪里……甚至昨天晚上”摇头“你怎么知道她在医院的？”"}
{"time": 1773411044, "type": "recv", "message_id": "792172030", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“她给我打电话说的”"}
{"time": 1773411095, "type": "recv", "message_id": "446627169", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“那……晚点要不要一起去医院看看她”"}
{"time": 1773411113, "type": "recv", "message_id": "984838682", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我其实有个事情想和你们说”"}
{"time": 1773411125, "type": "recv", "message_id": "1167334215", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我刚刚了解到学校怪谈的事情”"}
{"time": 1773411129, "type": "recv", "message_id": "2011865350", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“关于这个诅咒”"}
{"time": 1773411241, "type": "recv", "message_id": "1314351803", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“二十六年前，在三年三班有一个学生叫做神齐川由纪，他在毕业前意外死去了”"}
{"time": 1773411263, "type": "recv", "message_id": "2105615466", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“全班同学无法接受这样友好善良的同学死去”"}
{"time": 1773411272, "type": "recv", "message_id": "521835392", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“于是他们做了一件事”"}
{"time": 1773411278, "type": "recv", "message_id": "1371647541", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“假装他还活着”"}
{"time": 1773411305, "type": "recv", "message_id": "1559537383", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“保留了他的座位，明天甚至会对着他的座位打招呼，甚至学校在后面也默许了这个事情”"}
{"time": 1773411315, "type": "recv", "message_id": "1986877781", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“毕业典礼都为他预留了位置”"}
{"time": 1773411335, "type": "recv", "message_id": "1514681871", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“但是现在完全相反了”"}
{"time": 1773411336, "type": "recv", "message_id": "389178301", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“但是最后在毕业照时，他的身影却出现在了毕业照上”"}
{"time": 1773411385, "type": "recv", "message_id": "1514447045", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“这个传说，可能就是诅咒的来源？”"}
{"time": 1773411479, "type": "recv", "message_id": "54337692", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "”是这样吗……“"}
{"time": 1773411481, "type": "recv", "message_id": "958991561", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“为什么会演变成这个样子？如果传说是真的，那应该是个温馨的故事才对”"}
{"time": 1773411501, "type": "recv", "message_id": "1064092070", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“如果”"}
{"time": 1773411508, "type": "recv", "message_id": "1614834707", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“如果他从未离开呢”"}
{"time": 1773411520, "type": "recv", "message_id": "2038489246", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“难道，因为当时留住了一个现世的鬼魂……”"}
{"time": 1773411538, "type": "recv", "message_id": "501721299", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我其实一开始甚至想反着想这个怪谈”"}
{"time": 1773411543, "type": "recv", "message_id": "611523021", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“会不会只有”"}
{"time": 1773411554, "type": "recv", "message_id": "1843766320", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "“因为人们多预留了一个人的存在，所以卡密才会减少一个人吗”"}
{"time": 1773411559, "type": "recv", "message_id": "469494107", "deleted": true, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“神弃川岬活下来了”"}
{"time": 1773411565, "type": "recv", "message_id": "940599219", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“故事是相反的”"}
{"time": 1773411584, "type": "recv", "message_id": "1355929387", "deleted": true, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "“神弃川岬是谁？”"}
{"time": 1773411599, "type": "recv", "message_id": "1763756207", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(打错了)"}
{"time": 1773411601, "type": "recv", "message_id": "1643816236", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(哈哈)"}
{"time": 1773411611, "type": "recv", "message_id": "1673998421", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "（好的）"}
{"time": 1773411614, "type": "recv", "message_id": "1309410336", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（穿山甲都来了）"}
{"time": 1773411614, "type": "recv", "message_id": "232369081", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“神弃川由纪活下来了”"}
{"time": 1773411648, "type": "recv", "message_id": "334968303", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“那么大的事，我们不可能不知道”摇头"}
{"time": 1773411660, "type": "recv", "message_id": "1994345572", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "”这样吗？“"}
{"time": 1773411660, "type": "recv", "message_id": "1125508684", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“除非我们才是幽灵，那也太可怕”"}
{"time": 1773411669, "type": "recv", "message_id": "954594405", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“怪谈本身也没什么逻辑”"}
{"time": 1773411688, "type": "recv", "message_id": "1892278186", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我现在很想联系一下以前的学长”"}
{"time": 1773411692, "type": "recv", "message_id": "379938030", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你们有认识的吗”"}
{"time": 1773411703, "type": "recv", "message_id": "1835779561", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“事情还是要从源头开始找”"}
{"time": 1773411748, "type": "recv", "message_id": "1786605089", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "#尝试回忆有没有这样一个人"}
{"time": 1773411757, "type": "recv", "message_id": "411459795", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“没有。我不知道神明到底存不存在，既然这里叫神弃川……”顿了顿“但是山上确实有个神社”"}
{"time": 1773411766, "type": "recv", "message_id": "228506737", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "（估计是没有）"}
{"time": 1773411780, "type": "recv", "message_id": "866355573", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“二十六年”"}
{"time": 1773411785, "type": "recv", "message_id": "730650444", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“其实也不算久远对吗”"}
{"time": 1773411796, "type": "recv", "message_id": "1271823122", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“如果我们能找到当事人呢”"}
{"time": 1773411801, "type": "recv", "message_id": "378249601", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我只怕找不到当事人”"}
{"time": 1773411815, "type": "recv", "message_id": "1383043256", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“那得去找父辈们问了”"}
{"time": 1773411832, "type": "recv", "message_id": "1577621779", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我希望有些事情先对神山同学保密吧”"}
{"time": 1773411842, "type": "recv", "message_id": "2137898066", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我....”"}
{"time": 1773411854, "type": "recv", "message_id": "2139926078", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“实话实说就是，神山同学的情况有点复杂”"}
{"time": 1773411880, "type": "recv", "message_id": "312171352", "deleted": true, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "[CQ:reply,id=730650444]“班长，你知道神弃川名字的由来吗”"}
{"time": 1773411882, "type": "recv", "message_id": "2090494021", "deleted": true, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "“是先有神弃川地名，还是先有神弃川同学呢？”"}
{"time": 1773411892, "type": "recv", "message_id": "190987455", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "（你先说）"}
{"time": 1773411896, "type": "recv", "message_id": "2002353912", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(？)"}
{"time": 1773411900, "type": "recv", "message_id": "1087049896", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(没了)"}
{"time": 1773411902, "type": "recv", "message_id": "1835976632", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我也觉得……说起来，昨天我和她一起去神社的时候”"}
{"time": 1773411922, "type": "recv", "message_id": "423420615", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "“我其实在想一个问题”"}
{"time": 1773411941, "type": "recv", "message_id": "83325745", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "“是先有神弃川地名，还是先有神弃川同学呢？她、和这片土地，有什么联系？”"}
{"time": 1773411941, "type": "recv", "message_id": "603588768", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“她好像踩到了什么东西，好像是黄黄的。当时我在想是不是什么毛毛虫”"}
{"time": 1773411958, "type": "recv", "message_id": "1058918399", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“现在想来，可能是……什么东西的蛋”"}
{"time": 1773411969, "type": "recv", "message_id": "106903602", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "[CQ:reply,id=83325745]“对于日本历史来说，肯定是先有地名”"}
{"time": 1773411977, "type": "recv", "message_id": "283726327", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(例如什么山上松下的)"}
