{"time": 1773412054, "type": "recv", "message_id": "2109634114", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(因为姓在日本古代是王室专属，后面因为进入到近代)"}
{"time": 1773412055, "type": "recv", "message_id": "388789297", "deleted": false, "dect": {"host_id": null, "group_id": "1084084150", "user_id": "2086118349"}, "sender": {"id": "2086118349", "name": "S&G绪言梦语"}, "message": "（确实）"}
