{"time": 1763899264, "type": "recv", "message_id": "1618939508", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“今天岛上不是过节么...看到了好多鸢尾花，早上大卡就搬来了很多”"}
{"time": 1763899276, "type": "recv", "message_id": "842965173", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“旅馆里也有？”"}
{"time": 1763899281, "type": "recv", "message_id": "2057987932", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“放在什么地方”"}
