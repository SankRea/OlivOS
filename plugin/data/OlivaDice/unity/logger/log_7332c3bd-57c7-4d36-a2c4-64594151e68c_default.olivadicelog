{"time": 1763898497, "type": "recv", "message_id": "330947036", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我其实更想知道是什么阻拦他们让他们不敢进来”"}
{"time": 1763898527, "type": "recv", "message_id": "116063753", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我知道，是锁死的门”开个玩笑"}
{"time": 1763898561, "type": "recv", "message_id": "1678879980", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(哈哈)"}
{"time": 1763898569, "type": "recv", "message_id": "521064510", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(我听到呼噜声了)"}
{"time": 1763898575, "type": "recv", "message_id": "1949830149", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(猜猜是谁的)"}
{"time": 1763898581, "type": "recv", "message_id": "19317736", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（yln？）"}
{"time": 1763898674, "type": "recv", "message_id": "1640828271", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“不管怎样，现在我们就干等着吗，等外面的怪物良心发现离开，或者等我们全部饿死在这里？”"}
{"time": 1763898694, "type": "recv", "message_id": "117640617", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“外面也不安稳……有好多恶心的声音……”卡提西亚在门边听了听，开口"}
{"time": 1763898711, "type": "recv", "message_id": "602446620", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“那现在出去不就是立刻死吗？”"}
{"time": 1763898717, "type": "recv", "message_id": "1384968065", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“总归要计划一下”"}
{"time": 1763898734, "type": "recv", "message_id": "1524917766", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“先看看是什么东西能够让那群怪物忌惮”"}
{"time": 1763898744, "type": "recv", "message_id": "2110005482", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（伊神假寐，智斗巅峰）"}
{"time": 1763898757, "type": "recv", "message_id": "348946689", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“旅馆里还有多少吃的，小卡”"}
{"time": 1763898798, "type": "recv", "message_id": "1002302690", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=1524917766]（所以是谁睡着了，我看这两个人不都活着的么）"}
{"time": 1763898808, "type": "recv", "message_id": "191628022", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(消失了)"}
