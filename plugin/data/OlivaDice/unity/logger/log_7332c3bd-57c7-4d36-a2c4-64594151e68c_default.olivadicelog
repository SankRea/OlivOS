{"time": 1751030846, "type": "recv", "message_id": "653921528", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“....”"}
{"time": 1751030852, "type": "recv", "message_id": "678465133", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“你们能不能说一下，现在是什么情况”"}
{"time": 1751030862, "type": "recv", "message_id": "1048571531", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我比你们还不知道是什么情况”"}
{"time": 1751030870, "type": "recv", "message_id": "181022209", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“在路上被这群怪物追”"}
{"time": 1751030876, "type": "recv", "message_id": "938492004", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*叹气"}
{"time": 1751030881, "type": "recv", "message_id": "1187027607", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“是不是今天有点太倒霉了”"}
{"time": 1751030901, "type": "recv", "message_id": "1176745187", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“我的猜测是这里有吸引它们前来的事物”"}
{"time": 1751030915, "type": "recv", "message_id": "761625981", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“这里？”"}
{"time": 1751030924, "type": "recv", "message_id": "1672178059", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“或者说我们几人聚在一起就会出事”"}
{"time": 1751030924, "type": "recv", "message_id": "1408719530", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "那群怪物已经涌到了门口，你们注意到小卡脸色苍白，径直跑进了后房不出来了"}
{"time": 1751030935, "type": "recv", "message_id": "1663862096", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“小卡？”"}
{"time": 1751030942, "type": "recv", "message_id": "2063664845", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（要变身了）"}
{"time": 1751030943, "type": "recv", "message_id": "1227312267", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“这个时候就不要单独行动了吧”"}
{"time": 1751030953, "type": "recv", "message_id": "639204126", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(要么变身迪迦)"}
{"time": 1751030953, "type": "recv", "message_id": "1490252897", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "没有理会你门"}
{"time": 1751030956, "type": "recv", "message_id": "820462636", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "你们"}
{"time": 1751030963, "type": "recv", "message_id": "1694341562", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我也害怕..”"}
{"time": 1751030965, "type": "recv", "message_id": "889281894", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(要么变超大巨了)"}
{"time": 1751030977, "type": "recv", "message_id": "1535137160", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（变大雷）"}
{"time": 1751031027, "type": "recv", "message_id": "147630255", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“然后现在也这么巧，整个旅馆只有我们？”"}
{"time": 1751031082, "type": "recv", "message_id": "302012615", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我不知道你在怀疑什么，但是能不能先想办法抵御一下外面的东西，我只是一个医生，有些无能为力”"}
{"time": 1751031094, "type": "recv", "message_id": "1362275053", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "(瑟瑟发抖)"}
{"time": 1751031105, "type": "recv", "message_id": "1524530103", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“怎...怎么抵御呢”"}
{"time": 1751031116, "type": "recv", "message_id": "150041681", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "外面的东西似乎已经包围了旅馆"}
{"time": 1751031142, "type": "recv", "message_id": "1502182475", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "但目前除了液体滴落的密集滴答声和怪异的呼吸音，并没有其他动静"}
{"time": 1751031157, "type": "recv", "message_id": "621852726", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我……得躲起来，去哪才……”小卡抛下这句话就跑了"}
{"time": 1751031160, "type": "recv", "message_id": "868943892", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“这东西...你们有什么好方法吗”"}
{"time": 1751031172, "type": "recv", "message_id": "372017466", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "*去找小卡"}
{"time": 1751031188, "type": "recv", "message_id": "1175357734", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不行...”#上楼"}
{"time": 1751031222, "type": "recv", "message_id": "1470745836", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“奇怪”"}
{"time": 1751031228, "type": "recv", "message_id": "230522538", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*尝试看看外面的情况"}
{"time": 1751031234, "type": "recv", "message_id": "289350145", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“它们不破门而入吗”"}
{"time": 1751031254, "type": "recv", "message_id": "616236630", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "你发现里面似乎看不清外面"}
{"time": 1751031279, "type": "recv", "message_id": "1841389277", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“不会是他们只能追杀看得见他们的人吧”"}
{"time": 1751031286, "type": "recv", "message_id": "849846784", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*提出猜想"}
{"time": 1751031337, "type": "recv", "message_id": "1516837113", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "找个地方坐下“进来了就杀掉，太多就等死”"}
{"time": 1751031353, "type": "recv", "message_id": "573887375", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“还真是”"}
{"time": 1751031357, "type": "recv", "message_id": "595050384", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“有点豁达”"}
{"time": 1751031372, "type": "recv", "message_id": "2142591128", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“这位医生，问你个事情”"}
{"time": 1751031386, "type": "recv", "message_id": "515773864", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“你助手怎么了”"}
{"time": 1751031396, "type": "recv", "message_id": "1996070636", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "你们正说着，看见露儿火急火燎地上了楼"}
{"time": 1751031406, "type": "recv", "message_id": "1583947458", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:at,qq=1040972910].bot off"}
{"time": 1751031408, "type": "recv", "message_id": "2126944932", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“她有些低血糖，天生就是这样”"}
{"time": 1751031423, "type": "recv", "message_id": "629485306", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*打算拉着助手跟着露儿去楼上"}
{"time": 1751031429, "type": "recv", "message_id": "2076556724", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（你怎么知道我是人机）"}
{"time": 1751031436, "type": "recv", "message_id": "596153633", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“低血糖会长鳞片，是嘛”*拦住医生"}
{"time": 1751031468, "type": "recv", "message_id": "903858587", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“鳞片啊，和外面的怪物是不是有点像”*拔剑"}
{"time": 1751031511, "type": "recv", "message_id": "1400322720", "deleted": true, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“别着急啊，希望我们还会被追？”"}
{"time": 1751031512, "type": "recv", "message_id": "1722186155", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你是否有些激动了，我要是想害人会跑进来当着你的面，什么也不遮掩，不带枪这么狼狈进来？”"}
{"time": 1751031530, "type": "recv", "message_id": "472430994", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“别着急啊，如果是那样我们还会被追？”"}
{"time": 1751031545, "type": "recv", "message_id": "1823014041", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“露儿去看的那个人是我的病人！”"}
{"time": 1751031560, "type": "recv", "message_id": "476878279", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我上楼的目的和露儿一样，查看她的情况”"}
{"time": 1751031569, "type": "recv", "message_id": "189503215", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“你在说什么”"}
{"time": 1751031583, "type": "recv", "message_id": "414425374", "deleted": true, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "我说你助手为什么会长鳞片"}
{"time": 1751031591, "type": "recv", "message_id": "721556040", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“我说你助手为什么会长鳞片”"}
{"time": 1751031622, "type": "recv", "message_id": "1679693568", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“因为这是她的病，我带着她在这个小镇就是为了治好这个病症”"}
{"time": 1751031640, "type": "recv", "message_id": "1969130479", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“楼上也是这个病？”"}
{"time": 1751031648, "type": "recv", "message_id": "1594989368", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“不”"}
{"time": 1751031658, "type": "recv", "message_id": "1142099351", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“你不如上去看看不就知道了”"}
{"time": 1751031735, "type": "recv", "message_id": "229079079", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“不必了，暂时先信任你们”"}
{"time": 1751031763, "type": "recv", "message_id": "1627741135", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "408119794"}, "sender": {"id": "408119794", "name": "森の月"}, "message": "“这位兄弟，我们来聊一聊吧，反正怪物也一时半会不进来”"}
{"time": 1751031766, "type": "recv", "message_id": "982304770", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*上去"}
{"time": 1751031789, "type": "recv", "message_id": "1803149159", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我推荐我们抱团走，不要分离”"}
{"time": 1751031797, "type": "recv", "message_id": "120749977", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“外面的怪物只是看着不会进来”"}
{"time": 1751031804, "type": "recv", "message_id": "1203346090", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“谁知道它们会不会抽疯”"}
{"time": 1751031808, "type": "recv", "message_id": "1615581410", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“一起上去吧”"}
