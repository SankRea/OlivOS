{"time": 1763898880, "type": "recv", "message_id": "1612755407", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=348946689]（[CQ:at,qq=1252219916] ）"}
