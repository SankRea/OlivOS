{"time": 1763899393, "type": "recv", "message_id": "1734833201", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（感觉卡西奥佩娅更像小卡的姐姐）"}
{"time": 1763899397, "type": "recv", "message_id": "206931836", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“店长安排的，要布置在各个房间门口……”小卡开口"}
{"time": 1763899430, "type": "recv", "message_id": "1061871119", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“对了...店长是谁..怎么感觉没见他的样子”"}
{"time": 1763899459, "type": "recv", "message_id": "89669105", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=1061871119]（在哪）"}
{"time": 1763899493, "type": "recv", "message_id": "71207412", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“花能阻挡住这群怪物？”"}
{"time": 1763899503, "type": "recv", "message_id": "594454873", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我觉得值得一试”"}
{"time": 1763899510, "type": "recv", "message_id": "1155561179", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“确实不能坐以待毙了”"}
{"time": 1763899518, "type": "recv", "message_id": "1558389811", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（在哪替换是谁）"}
{"time": 1763899536, "type": "recv", "message_id": "1277921034", "deleted": false, "dect": {"host_id": null, "group_id": "1049942510", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“把花丢出去试试？”"}
