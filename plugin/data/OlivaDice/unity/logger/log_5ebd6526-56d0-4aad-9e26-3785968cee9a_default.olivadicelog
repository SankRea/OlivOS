{"time": 1764813163, "type": "recv", "message_id": "279443333", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你下没下战双（）"}
{"time": 1764813164, "type": "recv", "message_id": "2080135621", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那走去看看，可以告诉我是什么地方吗”牵起舒茉的手，朝教堂走去"}
