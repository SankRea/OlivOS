{"time": 1764849599, "type": "recv", "message_id": "1279938889", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（给舒蕾展示过了）"}
