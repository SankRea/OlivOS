{"time": 1764664526, "type": "recv", "message_id": "697463629", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（起码听见了敲门吧）"}
{"time": 1764664552, "type": "recv", "message_id": "2025589150", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "随后很快沉寂下去。敲门声只响了一轮"}
