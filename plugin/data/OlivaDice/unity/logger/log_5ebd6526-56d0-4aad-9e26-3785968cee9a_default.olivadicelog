{"time": 1764784771, "type": "recv", "message_id": "84346590", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "大概确实有引导魔力更加集中的作用，但也就一点点"}
{"time": 1764784782, "type": "recv", "message_id": "12506675", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那就有点可惜...没有什么压箱底的宝贝么？\""}
