{"time": 1763762394, "type": "recv", "message_id": "581579307", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（后来倒是不同转职专门做了个小图，还带剧情）"}
