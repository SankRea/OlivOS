{"time": 1764470708, "type": "recv", "message_id": "1156060435", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（嘻嘻）"}
{"time": 1764470899, "type": "recv", "message_id": "1049692205", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(对吧，所以其实没什么问题)"}
