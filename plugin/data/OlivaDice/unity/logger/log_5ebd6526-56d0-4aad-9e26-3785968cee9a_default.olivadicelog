{"time": 1764561501, "type": "recv", "message_id": "1651294027", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（哎，不喜欢这种扭捏的家庭情景剧（）"}
