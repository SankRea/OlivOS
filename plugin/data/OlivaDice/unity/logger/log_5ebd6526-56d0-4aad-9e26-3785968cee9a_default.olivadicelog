{"time": 1763701738, "type": "recv", "message_id": "317878354", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（确认在哪）"}
