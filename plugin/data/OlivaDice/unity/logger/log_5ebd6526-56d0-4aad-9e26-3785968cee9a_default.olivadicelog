{"time": 1764125945, "type": "recv", "message_id": "794383920", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（还有空在外面吃点说是）"}
