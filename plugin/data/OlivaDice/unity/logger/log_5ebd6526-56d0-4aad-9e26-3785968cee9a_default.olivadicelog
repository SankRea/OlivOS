{"time": 1764907255, "type": "recv", "message_id": "1949681289", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1573588220]\"做到相反的事情——\""}
{"time": 1764907423, "type": "recv", "message_id": "1364520865", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我之前确实没想过这样的事情....”沉思“舒茉说的对...我们直接离开好了”感觉心情也好了一些“不过...算了，没什么”"}
{"time": 1764907435, "type": "recv", "message_id": "1940223510", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“走吧..我们去找那个哥布林去”"}
