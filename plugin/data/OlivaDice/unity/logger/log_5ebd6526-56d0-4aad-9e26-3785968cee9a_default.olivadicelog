{"time": 1763728034, "type": "recv", "message_id": "967999851", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哼...\"轻哼一声，\"我不要，玛瑙的话，自己戴。\""}
