{"time": 1764565386, "type": "recv", "message_id": "1674590595", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（而且我点酒的主要原因是）"}
{"time": 1764565413, "type": "recv", "message_id": "197297496", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我要问人家问题总得点点什么才好继续对话啊）"}
{"time": 1764565426, "type": "recv", "message_id": "1195162511", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那你点牛奶）"}
{"time": 1764565451, "type": "recv", "message_id": "1415490110", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我虽然是个牛仔？）"}
{"time": 1764565465, "type": "recv", "message_id": "893437400", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...从明天开始吧。\"刚说完就听见伊恩的话，\"而且我明明一口气喝了一杯——\"摇摇脑袋，\"今天舒茉想和妈妈一起。\"看向爸爸，这件事还是需要爸爸的首肯。"}
{"time": 1764565487, "type": "recv", "message_id": "177700811", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“阿姨这状态也喝不下去了吧”"}
{"time": 1764565501, "type": "recv", "message_id": "1701814525", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“吃完饭就回去休息吧”"}
{"time": 1764565596, "type": "recv", "message_id": "1512658810", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我倒是赞成这么做”汉斯点点头“不过我拽不过她……所以点了两份醒酒汤”"}
{"time": 1764565651, "type": "recv", "message_id": "529162850", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "想说点什么，但有个大的酒蒙子在这，感觉说什么都不对"}
{"time": 1764565732, "type": "recv", "message_id": "1670116499", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你不如说喝酒伤身（）"}
{"time": 1764565736, "type": "recv", "message_id": "1977293676", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"所以...\"目光转向母亲，\"妈妈喝什么，舒茉也跟着喝什么!\""}
{"time": 1764565758, "type": "recv", "message_id": "1001265948", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(虽然这么说，但舒茉能撑到第三杯吗)"}
