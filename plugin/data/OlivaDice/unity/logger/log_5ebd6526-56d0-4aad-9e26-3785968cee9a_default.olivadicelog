{"time": 1764293663, "type": "recv", "message_id": "43892258", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我一直好会听)"}
{"time": 1764293736, "type": "recv", "message_id": "1814760214", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "扭动门把手，推开门，身体快于思考，先从后面抱住他，\"...\""}
{"time": 1764294051, "type": "recv", "message_id": "1778053034", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "听到门响的声音，还没来得及回头，就感觉到身上有一种温暖的感觉...收起那些魔力，害怕伤到舒茉...“我...没事”，不过由于之前魔力的外泄，头上甚至有些许冰霜“谢...谢....”眼泪仍然还在继续流着，不想让舒茉看见自己这么软弱的样子，但怎么样都止不住，试图回想开心的事情，但发现至今为止，自己的快乐都离不开舒茉......有点泣不成声"}
{"time": 1764294104, "type": "recv", "message_id": "1593654031", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（好的，封人之战）"}
{"time": 1764294272, "type": "recv", "message_id": "579381937", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（“不过，现在我知道答案啦……”）"}
{"time": 1764294281, "type": "recv", "message_id": "1613902666", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...\"轻轻呼吸，脑袋靠在他的背上，\"明明说...要好好休息了，结果...还是让人不能不担心...\"声音很低，\"哭出来会好一些的话...我陪着你...\""}
{"time": 1764294292, "type": "recv", "message_id": "1292857260", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（“原来，真的会结成冰呀♪~”）"}
{"time": 1764294319, "type": "recv", "message_id": "1975889655", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(TruE?)"}
{"time": 1764294329, "type": "recv", "message_id": "398252896", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（哈哈）"}
{"time": 1764294690, "type": "recv", "message_id": "781657411", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我...果然...完全..离不开....舒茉”抽噎的说道，已经这样了，自己也没有什么故作坚强的理由了"}
{"time": 1764294710, "type": "recv", "message_id": "1257711027", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（感觉在走廊放声大哭怪怪的，会不会引人过来（）"}
{"time": 1764294743, "type": "recv", "message_id": "689553004", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（其实不太会）"}
{"time": 1764294912, "type": "recv", "message_id": "768603709", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "脑海里一直回荡着舒茉一直以来对自己的关心，情绪彻底抑制不住，千言万语化为哭声回荡在走廊中"}
{"time": 1764295047, "type": "recv", "message_id": "656572407", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "明明这次自己都没哭...不过依然只是在身后抱着他，没有开口"}
{"time": 1764295494, "type": "recv", "message_id": "1488010490", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "哭了一会，总算稍微缓过来了些，感受着舒茉传来的温暖，心情也不自觉的变好了一些“稍微....松一下...”"}
{"time": 1764295541, "type": "recv", "message_id": "809115585", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "松开，\"好了吗？嗯...伊恩要不去睡一会吧？\""}
{"time": 1764295599, "type": "recv", "message_id": "1002572962", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "转过身来，抱住舒茉“嗯...一小下就好...就一小下”"}
{"time": 1764295819, "type": "recv", "message_id": "710917287", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(你刚买的衣服+项链你是看都不看)"}
{"time": 1764295850, "type": "recv", "message_id": "1923118435", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（可能，倒也不急）"}
{"time": 1764295895, "type": "recv", "message_id": "210978809", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（速度很快啊，来不及看衣服）"}
{"time": 1764295922, "type": "recv", "message_id": "1568221105", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "手搭在他抱着自己的手臂上，颇有些由着他的意思，\"好好，抱好了就要去好好休息。\""}
{"time": 1764295931, "type": "recv", "message_id": "1585732684", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（话说伊恩穿着啥）"}
{"time": 1764295985, "type": "recv", "message_id": "826527632", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "闭上眼睛，不希望自己的眼泪，弄脏舒茉的衣服，静静的享受着片刻安宁“嗯....”轻声"}
{"time": 1764296166, "type": "recv", "message_id": "1549950319", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“最喜欢舒茉了.....”小声说道"}
{"time": 1764296274, "type": "recv", "message_id": "2021759340", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "伸手轻柔地抚摸他的脑袋，\"嗯...我是如此相信...乖...\""}
{"time": 1764296313, "type": "recv", "message_id": "239151222", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“叮——”走廊尽头的升降梯顶端响起清脆的铃声，金属器的余韵在走廊里回荡。门马上就要开了"}
{"time": 1764296373, "type": "recv", "message_id": "921072606", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "虽然不知道是谁...但这次自己不会再逃跑了"}
{"time": 1764296542, "type": "recv", "message_id": "724063213", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（什么叫有背景故事的wiki没有技能描述）"}
{"time": 1764296576, "type": "recv", "message_id": "1308383608", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(雾小妹?)"}
{"time": 1764296590, "type": "recv", "message_id": "824420664", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（那个背景故事的wiki好像有点古老，没有三觉的技能）"}
{"time": 1764296636, "type": "recv", "message_id": "2074264059", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "感觉应该是牧师要到了，\"伊恩，先松开啦，客人到了。\""}
{"time": 1764296724, "type": "recv", "message_id": "424574010", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“ohoh....那我先去洗把脸...现在的样子有些丢人”"}
{"time": 1764296864, "type": "recv", "message_id": "17186825", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "慢慢的不舍的松开舒茉，此刻才发现，原来她已经换上了自己给她买的新衣服“和我..预想的...差不多，很..适合舒茉...”说话还是有点断断续续“感觉..像...精灵一样”"}
{"time": 1764296987, "type": "recv", "message_id": "809779003", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好啦好啦。\"话虽如此，心情还是美丽了不少，尽管依然称不上完全恢复，\"呼...我来招待就好，伊恩，好好休息。听到了吗？\""}
{"time": 1764297169, "type": "recv", "message_id": "377571342", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我洗个脸就好了...不会很久，我也..不是很累”"}
{"time": 1764297215, "type": "recv", "message_id": "198654275", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "再多看几眼舒茉，随后回房间清洗一下"}
{"time": 1764297249, "type": "recv", "message_id": "1937598851", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "金属格栅门向一边拉开，精致的小皮鞋踏出。来者穿着素白的过膝长裙和绣着十字纹样的短披风，腰间垂下的两条坠着金属十字的系带压住裙摆，同时也制止非礼的视线。此外，背后还背着半人多高、用白漆涂过的带柄木质十字架。黑发棕瞳，带着安抚人心的微笑"}
{"time": 1764297348, "type": "recv", "message_id": "562343174", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "转过身，只是简单洗漱过，没有化过妆，担心有些不够庄重...毕竟算是自己第一次单独处理...深呼吸，看向来人，\"您...您好...\""}
{"time": 1764297540, "type": "recv", "message_id": "1793511322", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "感觉好受多了，心情也不像之前那么沉重了，把脸认真的洗一洗，擦干，确定自己看起来没什么事之后，深呼吸，然后出门"}
{"time": 1764297733, "type": "recv", "message_id": "419969730", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“你们好~”她的语调偏高，但听起来不觉得尖细，反倒有些婉转。她靠近了些，和你们平视着。不知道是不是其他感官带来的错觉，你们觉得她身上散发着轻微的光晕，连带着走廊的光线都柔和了些“有人需要我的帮助吗？”"}
{"time": 1764297779, "type": "recv", "message_id": "1522383440", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（cv：早见沙织）"}
{"time": 1764297797, "type": "recv", "message_id": "1298655741", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我在想立绘怎么找）"}
{"time": 1764297799, "type": "recv", "message_id": "1191311738", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“有的有的，姐姐这边走，谢谢姐姐”"}
{"time": 1764297858, "type": "recv", "message_id": "1018543194", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "不自觉点点头，敲了敲莫辛的房门，\"莫辛?阿姨?神官姐姐来了，我能开门吗？\""}
{"time": 1764297913, "type": "recv", "message_id": "152799523", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（沟槽的二次元黑发黑瞳还是太难找了）"}
{"time": 1764297947, "type": "recv", "message_id": "1367384183", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（可以过个侦查先）"}
