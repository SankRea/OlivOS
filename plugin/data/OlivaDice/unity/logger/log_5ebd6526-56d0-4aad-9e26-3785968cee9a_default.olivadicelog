{"time": 1764522513, "type": "recv", "message_id": "1926978744", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=304448761]\"不要...\"另一只手尝试推开她，几滴泪水在眼眶里打转，\"让我...让我自己走...\"抓着胸口的手抓得更紧，呼吸有些急促起来"}
{"time": 1764522572, "type": "recv", "message_id": "562043346", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我觉得酒后物理降温……）"}
{"time": 1764522576, "type": "recv", "message_id": "612984847", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（挺危险的）"}
{"time": 1764522608, "type": "recv", "message_id": "880092637", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(就是挺危险啊)"}
{"time": 1764522610, "type": "recv", "message_id": "1251641391", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“怎么了....”自然是不会走的，仍然在她身旁，有节奏的拍拍背"}
{"time": 1764522757, "type": "recv", "message_id": "1230339832", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=562043346]（你当我温度控制合适（"}
{"time": 1764522823, "type": "recv", "message_id": "183889371", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（他妈温度0度以下）"}
{"time": 1764522830, "type": "recv", "message_id": "1901367583", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（冰还能比0度高吗）"}
{"time": 1764522849, "type": "recv", "message_id": "1347331892", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呜呜...\"几滴眼泪顺着脸颊流了下来，\"好冰...难受...\"外冷内热，更不舒服了"}
{"time": 1764522851, "type": "recv", "message_id": "651176654", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（并非，只是让我的手温度降下去（）"}
{"time": 1764522872, "type": "recv", "message_id": "1500325874", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（所以37度的手，变成了30度左右的手，正好合适（））"}
{"time": 1764522999, "type": "recv", "message_id": "1617893517", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "收回魔力，这种情况还是去找专业的人吧“稍微在忍一下，马上就没事了”背起舒茉，带她去找露莉亚姐姐"}
{"time": 1764523435, "type": "recv", "message_id": "831183944", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"干嘛...\"眼泪一滴一滴掉，\"放我下来...\""}
{"time": 1764523505, "type": "recv", "message_id": "1759560222", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我带你去找露利亚姐姐，她肯定可以一下就让你不难受了”"}
{"time": 1764524409, "type": "recv", "message_id": "1967428338", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"不要...我不想见其他人...\"死死皱着眉，\"呜呜...\"伸手掐着他的肩膀，\"不要...\""}
{"time": 1764524470, "type": "recv", "message_id": "662497874", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“抱歉....我不能继续由着舒茉了...之前舒茉喝酒的时候我就该强硬一点....”"}
{"time": 1764524558, "type": "recv", "message_id": "1334316470", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "背着她朝教会走"}
{"time": 1764524702, "type": "recv", "message_id": "1381120134", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呜呜呜...你还说，要听我的话...\"眼泪成条流下，打湿他的肩膀"}
{"time": 1764524829, "type": "recv", "message_id": "301524618", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“....”最见不得舒茉哭了“那我们回旅馆吧...”停下了脚步"}
{"time": 1764525024, "type": "recv", "message_id": "210615820", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"再...再走走...\"想要从他身上下来，\"我自己走...\"酒气冲入大脑，顿感天旋地转，但还是嘴硬地开口"}
{"time": 1764525249, "type": "recv", "message_id": "833649988", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哎....”叹口气，舒茉的要求自己果然很难拒绝“好吧...”把舒茉放下来，然后小心的搀扶着"}
{"time": 1764525847, "type": "recv", "message_id": "1308589404", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "靠着他，左摇右晃，完全走不动路其实"}
{"time": 1764525907, "type": "recv", "message_id": "775118404", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "一只手绕着舒茉的后背拖着她，防止她摔倒“舒茉现在有想去的地方吗”"}
{"time": 1764525942, "type": "recv", "message_id": "1935883814", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...伊恩之前去哪了?\""}
{"time": 1764526143, "type": "recv", "message_id": "236787223", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我之前去找露莉亚姐姐了”"}
{"time": 1764526227, "type": "recv", "message_id": "1687435039", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"什么...什么...?\"瞪着他，此刻自己完全没有掩藏的感觉。"}
{"time": 1764526327, "type": "recv", "message_id": "920104416", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"为什么?\"咬着嘴唇，\"哼...\""}
{"time": 1764526411, "type": "recv", "message_id": "788566825", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我去问她怎么变强啦...我对舒茉的心意日月可鉴，不会做对不起舒茉的事情啦”"}
{"time": 1764526750, "type": "recv", "message_id": "1875480915", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "急忙表态"}
{"time": 1764526784, "type": "recv", "message_id": "315254603", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...真是的...\"虽然自己已经迷糊得天旋地转，\"我才不管...\""}
{"time": 1764526948, "type": "recv", "message_id": "164968492", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "紧紧抓着他，力度可能相当之大，\"带我走...去哪里都行...\"自己的脚下像是在打绊子，走得很踉跄。"}
{"time": 1764527171, "type": "recv", "message_id": "1507699464", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "。r"}
