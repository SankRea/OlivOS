{"time": 1763808514, "type": "recv", "message_id": "1600087487", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...虽然这么说，但是我们见得到她吗？\""}
{"time": 1763808609, "type": "recv", "message_id": "1629529229", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“啊……圣职者”莫辛有些被吸引“要是……啊……说的也是……这种地方的大人物应该有更重要的事要做吧……”"}
{"time": 1763808716, "type": "recv", "message_id": "1547244238", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...\"睁开眼扫了一眼莫辛，摇摇头，\"嗯...既然威黎叔提出来，应该有办法拜访?\""}
{"time": 1763808752, "type": "recv", "message_id": "854828554", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "期待的看着威黎"}
{"time": 1763808897, "type": "recv", "message_id": "194901495", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“见到本人应该确实不容易”威黎点头“但受她的影响，本地圣职者据说格外博爱而富有同情心”"}
{"time": 1763808980, "type": "recv", "message_id": "1949678303", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那太好了...那我们稍微停留补给一下，然后顺便去拜访一下当地的圣职者”看向舒蕾"}
{"time": 1763809027, "type": "recv", "message_id": "423062918", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...是时候...\"自己想说的话被说完，把后半段咽了回去。"}
{"time": 1763809066, "type": "recv", "message_id": "2026250823", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯，也好。正好我也有想去看看的地方……”舒蕾点头“这些年，教会应该没搬迁过吧”"}
{"time": 1763809104, "type": "recv", "message_id": "827659325", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“阿姨以前也来过赫顿玛尔吗”"}
