{"time": 1764122562, "type": "recv", "message_id": "1952322395", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（等我想想）"}
{"time": 1764122731, "type": "recv", "message_id": "125823076", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“之前去哪了？”她开口，似乎还压抑着感情"}
{"time": 1764122846, "type": "recv", "message_id": "1715678455", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“去....换衣服了.....”"}
{"time": 1764122982, "type": "recv", "message_id": "2110709126", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...\"觉得自己站在这边好像不太对，但是这个气氛好像也不能随便动...低着头看自己的脚尖。"}
{"time": 1764123195, "type": "recv", "message_id": "11017516", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“哈，‘去换衣服了’”她冷笑一声，复述了一遍你的话“你自己知道为什么吗？”"}
{"time": 1764123446, "type": "recv", "message_id": "556956085", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "想说什么帮着解释但是不敢抬头，更怕现在自己帮忙说话会让妈妈更生气，还是站着没动"}
{"time": 1764123466, "type": "recv", "message_id": "17107539", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“......嗯.....我...”不知道该怎么说“我对不起舒茉....”"}
{"time": 1764123542, "type": "recv", "message_id": "1497525724", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“哦”逆光中她抱起胳膊“没看出来”"}
{"time": 1764123701, "type": "recv", "message_id": "1865255742", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我...本来想找个机会给舒茉道歉....但吃饭的时候..我以为她生气了，不想见我....”"}
{"time": 1764123935, "type": "recv", "message_id": "321893322", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“哦，所以你就顺理成章地也不说话了？”"}
{"time": 1764123956, "type": "recv", "message_id": "222734833", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我就想着....我要是不在的话，舒茉还能吃点热乎的....”"}
{"time": 1764123973, "type": "recv", "message_id": "823051528", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“就....提前走了....”"}
{"time": 1764124051, "type": "recv", "message_id": "801939793", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……那你呢？”舒蕾突然转向舒茉“当时你在想什么？”"}
{"time": 1764124420, "type": "recv", "message_id": "1436916048", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（[CQ:at,qq=1252219916] ）"}
