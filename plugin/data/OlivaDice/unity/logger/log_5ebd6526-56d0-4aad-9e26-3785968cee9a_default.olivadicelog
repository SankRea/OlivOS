{"time": 1764994761, "type": "recv", "message_id": "1562318251", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（记得帮我拿充电宝）"}
