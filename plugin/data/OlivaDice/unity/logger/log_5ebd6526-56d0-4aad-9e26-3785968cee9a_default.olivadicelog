{"time": 1764848791, "type": "recv", "message_id": "628691282", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=216601545]“没....舒茉也没吃...”"}
{"time": 1764848794, "type": "recv", "message_id": "1313181066", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(就吐了两次啊)"}
