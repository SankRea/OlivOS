{"time": 1764849574, "type": "recv", "message_id": "1307719826", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（汉斯知道舒茉能看别人记忆吗（）"}
