{"time": 1764125865, "type": "recv", "message_id": "1296383863", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那你要不要从舒蕾角度想一想）"}
