{"time": 1764845910, "type": "recv", "message_id": "50476193", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(至少，进展有的啦。)"}
