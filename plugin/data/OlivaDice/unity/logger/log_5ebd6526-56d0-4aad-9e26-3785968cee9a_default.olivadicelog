{"time": 1763696793, "type": "recv", "message_id": "519709835", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "披"}
{"time": 1763697006, "type": "recv", "message_id": "1547018397", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“诶...”接着裹紧披在身上的外套，“呼...回去吧。”"}
{"time": 1763697374, "type": "recv", "message_id": "838636952", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯....”自己倒不是很怕冷，毕竟天天和冰元素打交道，不过还是稍微和舒茉更贴近一些，希望她可以更暖和一点“回去吧”搂着她的肩膀，往回走"}
{"time": 1763697451, "type": "recv", "message_id": "273662954", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "总之到了，路上没什么特别的，旅店里也没有"}
{"time": 1763697551, "type": "recv", "message_id": "1220469861", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "进了室内，外套脱下来递给伊恩，“晚上没什么安排吧？我先回去咯？”"}
{"time": 1763698129, "type": "recv", "message_id": "1467266093", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "推开自己房间的门，探头看看妈妈在不在里面。"}
