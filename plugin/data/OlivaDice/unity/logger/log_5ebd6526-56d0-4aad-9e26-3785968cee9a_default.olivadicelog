{"time": 1764552465, "type": "recv", "message_id": "1957301657", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "摸摸舒茉的头“舒茉有什么想吃的吗”"}
{"time": 1764552564, "type": "recv", "message_id": "818550652", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "虽然说是感觉饿了，但其实提不起胃口，\"不想吃...\"想着刚刚的事，\"回去...睡觉，当做什么都不知道。\""}
{"time": 1764552622, "type": "recv", "message_id": "2059402509", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“稍微吃点什么垫垫肚子吧，比如说喝点粥之类的...”"}
{"time": 1764552686, "type": "recv", "message_id": "90475700", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（什么时候学做醒酒汤）"}
{"time": 1764552700, "type": "recv", "message_id": "1138331961", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（以后再也不让她喝了（）"}
{"time": 1764552758, "type": "recv", "message_id": "1766217607", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...真的要吃吗...\"手压着胸口，有些犹豫的神色，\"唔...\""}
{"time": 1764552874, "type": "recv", "message_id": "684881264", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哪怕会吐出来，也比什么都没有好....”"}
{"time": 1764553060, "type": "recv", "message_id": "422305652", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"最后点了点头，\"那...伊恩决定吧。\"虽然症状消了很多，但四肢上的感觉仍有残留，说话也软软的。"}
{"time": 1764553087, "type": "recv", "message_id": "962671562", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...舒茉要自己走吗，还是我背着你”"}
{"time": 1764553224, "type": "recv", "message_id": "1615425561", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...\"喝醉了的人应该享有些照顾吧?抬头看着他，\"背我...\""}
{"time": 1764553305, "type": "recv", "message_id": "1480312240", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯..”欣然接受，不如说这才是自己期待的情况，在舒茉面前半蹲下来“上来吧”"}
{"time": 1764553359, "type": "recv", "message_id": "2051886571", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（是不是该有触感描写了）"}
{"time": 1764553369, "type": "recv", "message_id": "1883022131", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(确实)"}
{"time": 1764553409, "type": "recv", "message_id": "1064335684", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "弯下腰轻轻靠在他背上，\"嗯...\""}
{"time": 1764553694, "type": "recv", "message_id": "146993350", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“走吧....”背起舒茉，看看有没有什么卖粥的餐馆，在路上，由于和舒茉紧紧相依，感觉背似乎碰到了什么很软的东西，不敢细想，只能说幸好舒茉看不见自己的表情，脸不可控制的红了，虽然努力用魔力压制，但没什么作用"}
{"time": 1764553815, "type": "recv", "message_id": "861301335", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（实际上并不会（））"}
{"time": 1764553834, "type": "recv", "message_id": "123831789", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（不知道）"}
{"time": 1764553855, "type": "recv", "message_id": "1069656154", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（可能舒茉抱得很紧呢）"}
{"time": 1764553858, "type": "recv", "message_id": "1263971885", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（就，不大的话，隔着衣服会觉得整片都有柔软的压力）"}
