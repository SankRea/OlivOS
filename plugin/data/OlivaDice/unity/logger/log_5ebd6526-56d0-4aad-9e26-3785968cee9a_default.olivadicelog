{"time": 1764095679, "type": "recv", "message_id": "2120509384", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……他知道吗？”"}
