{"time": 1764654044, "type": "recv", "message_id": "854740609", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(厉害)"}
{"time": 1764654163, "type": "recv", "message_id": "1681792055", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(很轻快地说出了要见一见地区最高长官的话呢)"}
{"time": 1764654254, "type": "recv", "message_id": "1588090045", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“去教会？”汉斯摸了摸下巴“如果要谈私事，人少一些比较好吧……而且我还要给舒茉舒蕾带饭”"}
{"time": 1764654656, "type": "recv", "message_id": "2065294554", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好的...那我们暂且分开吧，叔叔再见”"}
