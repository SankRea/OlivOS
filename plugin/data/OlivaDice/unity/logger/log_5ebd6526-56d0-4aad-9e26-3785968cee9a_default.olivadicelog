{"time": 1764580843, "type": "recv", "message_id": "892684118", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "点点头，\"好的呢——\"心情也跟着好起来，也许自己只是太敏感了而已"}
{"time": 1764580927, "type": "recv", "message_id": "418414937", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（实际上讲完为什么喜欢之后就释怀一半了）"}
