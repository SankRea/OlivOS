{"time": 1764521313, "type": "recv", "message_id": "164466818", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(那你买了你不喂吗)"}
