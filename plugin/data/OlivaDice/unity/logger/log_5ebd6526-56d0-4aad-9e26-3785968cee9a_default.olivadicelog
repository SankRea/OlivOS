{"time": 1763610717, "type": "recv", "message_id": "902785799", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（和韩国人没什么好说的）"}
{"time": 1763610743, "type": "recv", "message_id": "1908069092", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=954417485]\"笨，收到礼物这件事，本身就值得开心啊。\"伸出手点点伊恩的额头，\"好啦，现在有好好记住吗？\""}
{"time": 1763610779, "type": "recv", "message_id": "732214979", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...记住啦”用力的点点头"}
{"time": 1763611102, "type": "recv", "message_id": "261240094", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"回去吧。\"看着渐渐下沉的天色，\"再晚点妈妈该担心了。\""}
{"time": 1763611137, "type": "recv", "message_id": "848572060", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...在晚点夜路估计也不太好走”起身准备下山“舒茉小心一点..”"}
{"time": 1763611263, "type": "recv", "message_id": "2080502999", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呼呼...\"心情舒畅，连带着下山都走得快了一些，\"没事没事，这种路舒茉驾轻就熟。\""}
{"time": 1763611276, "type": "recv", "message_id": "1122413455", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（真的吗）"}
