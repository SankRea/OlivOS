{"time": 1764872867, "type": "recv", "message_id": "692790904", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...而且我在想一件事...”"}
{"time": 1764872869, "type": "recv", "message_id": "1589214174", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（忘了拿钱了）"}
{"time": 1764872895, "type": "recv", "message_id": "341126107", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我以为舒茉不准备买图腾了）"}
{"time": 1764872964, "type": "recv", "message_id": "74050320", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(哦)"}
{"time": 1764872972, "type": "recv", "message_id": "1193282578", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(但是不好意思开口找老妈要)"}
{"time": 1764872984, "type": "recv", "message_id": "917453573", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(能不能当我要过了)"}
{"time": 1764872990, "type": "recv", "message_id": "283306080", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“等下问问索西亚姐姐露莉亚姐姐喜欢什么吧，然后我们偷偷放她门口....虽然这估计也杯水车薪，不过直接走了心里还是很不踏实...”跟舒茉分享想法"}
{"time": 1764872999, "type": "recv", "message_id": "1961381206", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=917453573]（？[CQ:at,qq=1252219916]）"}
