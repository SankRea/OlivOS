{"time": 1764765686, "type": "recv", "message_id": "1185047638", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "起身跟着舒茉离开"}
{"time": 1764765960, "type": "recv", "message_id": "1327066679", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（然后去哪）"}
{"time": 1764765999, "type": "recv", "message_id": "311391467", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（舒茉决定）"}
{"time": 1764766144, "type": "recv", "message_id": "767365336", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"走在前面一点，\"离天黑还有一段时间，我有一个地方想去看看，伊恩陪陪我?\""}
{"time": 1764766186, "type": "recv", "message_id": "1940344865", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“可以啊，去哪里呢，能陪着舒茉我很开心的”擦擦脸上之前抹的奶油"}
{"time": 1764766379, "type": "recv", "message_id": "1213984696", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（要去哪里）"}
{"time": 1764766388, "type": "recv", "message_id": "1800225057", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我怎么不知道还有哪里能去.jpg）"}
{"time": 1764766532, "type": "recv", "message_id": "707681086", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1940344865]\"唉...\"把自己的手帕递给伊恩，语气倒是藏着些隐含的笑意，\"下次记得帮我擦干净，知道了吗？\""}
{"time": 1764766556, "type": "recv", "message_id": "1382037795", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（哦，礼堂？）"}
{"time": 1764766623, "type": "recv", "message_id": "2057767683", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...下次舒茉想事情的时候也不会打扰你了”擦一下，把手帕还给舒茉“所以是要去哪里？”"}
{"time": 1764766719, "type": "recv", "message_id": "786532866", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"有两个地方，一个很好看，一个很一般——\"收下手帕，\"伊恩选一选?\""}
{"time": 1764766743, "type": "recv", "message_id": "2112981730", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“oh？那一般的那个是有什么特别的地方吗”"}
{"time": 1764766767, "type": "recv", "message_id": "324750440", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"有一只魔物。\"故作姿态，夸张地开口"}
{"time": 1764766902, "type": "recv", "message_id": "310704010", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“魔物？怎么会”有点难以置信“赫顿玛尔怎么会有魔物呢”"}
{"time": 1764766910, "type": "recv", "message_id": "1648269765", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（原来是后街？）"}
{"time": 1764766925, "type": "recv", "message_id": "914462170", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（还真有，很多年前有个怪物攻城的活动）"}
{"time": 1764767025, "type": "recv", "message_id": "668852311", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"对吧，我也很奇怪。不过...伊恩想去哪边?\""}
{"time": 1764767074, "type": "recv", "message_id": "1985805835", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（那个我还真知道）"}
{"time": 1764767085, "type": "recv", "message_id": "812254432", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（前几天我还在b站看到了失败的结算画面）"}
{"time": 1764767111, "type": "recv", "message_id": "982298201", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=812254432](那是什么)"}
{"time": 1764767136, "type": "recv", "message_id": "687632299", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（每周六的活动，在城镇里挂机打怪）"}
{"time": 1764767146, "type": "recv", "message_id": "618996984", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（打完获得一些变身道具）"}
{"time": 1764767155, "type": "recv", "message_id": "590564792", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“emmm，让我想想”思考“舒茉想去那个普通的地方应该不只是因为魔物吧，应该是还有什么值得去看的地方？那就去普通的看看吧”"}
{"time": 1764767181, "type": "recv", "message_id": "1759756369", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（有人拿了变成强化装备npc的道具，在npc旁边摆一个分解店）"}
{"time": 1764767194, "type": "recv", "message_id": "1461040190", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(好的)"}
{"time": 1764767209, "type": "recv", "message_id": "661200409", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“但是时间其实也不是很不够用吧，我们两个地方都去看看也可以吧”"}
{"time": 1764767309, "type": "recv", "message_id": "1863974921", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"稍作思考点点头，\"那就先去后街吧。\"递出手，\"其实我比较好奇...那个魔物摆的摊子。\""}
{"time": 1764767396, "type": "recv", "message_id": "881180623", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（其实它有一个仓库.jpg）"}
{"time": 1764767396, "type": "recv", "message_id": "1716082850", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "自然而然的牵上“听起来好像很有趣的样子”"}
{"time": 1764767446, "type": "recv", "message_id": "1473017205", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“舒茉带路吧”"}
{"time": 1764767489, "type": "recv", "message_id": "1629579713", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（浪漫一点）"}
{"time": 1764767493, "type": "recv", "message_id": "662010051", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（就是带我走吧）"}
{"time": 1764767628, "type": "recv", "message_id": "1223663260", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...之前我曾经看过那片土地的记忆...\"轻轻握着手，言笑晏晏地开口\"待会我打算再仔细看看，可能会呆住一段时间...伊恩记得保护好我哦?\""}
{"time": 1764767777, "type": "recv", "message_id": "573012551", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“这种事情还用说吗...我不想让舒茉收到任何伤害”脚步轻快，感觉和舒茉在一起的这一小段时间就让这两天的阴郁一扫而空"}
{"time": 1764768078, "type": "recv", "message_id": "1461309955", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "总之，七拐八绕，最终绕进一条阴暗的小巷，即便楼不高，在日渐西沉的现在也有些昏暗"}
{"time": 1764768090, "type": "recv", "message_id": "1185013393", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯，那就麻烦伊恩咯?\"停了一下，\"好啦，既然现在只有我们两个人，之前和露莉亚姐姐说了什么?\""}
{"time": 1764768349, "type": "recv", "message_id": "1718645470", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯....我问她每天都戴着一副假面活着不累吗”"}
{"time": 1764768381, "type": "recv", "message_id": "1591434817", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“主要明天就走了....所以稍微激进了一些，然后就被赶走了”"}
{"time": 1764768964, "type": "recv", "message_id": "1931224829", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1591434817]\"啊?为什么...她戴着面具?发生什么了?\"有点一头雾水，\"能仔细说说吗？\""}
{"time": 1764769126, "type": "recv", "message_id": "59161373", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "\"索西雅姐姐说...露莉亚之所以现在还是见习，是因为大家认为她对神明不够虔诚，露莉亚姐姐的治疗魔法似乎不是来源于神明，而是自己本身的魔法....而且我感觉露莉亚姐姐平常露出的笑容，都是她装出来的\"把知道的一股脑的说了出来"}
{"time": 1764769187, "type": "recv", "message_id": "901455267", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“之前露莉亚姐姐查看我的魔法的时候，露出了看起来很生气的表情，还有今天她赶我走的时候，我觉得她这才真正的表露了自己的感情..”"}
{"time": 1764769415, "type": "recv", "message_id": "1141515092", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（并非似乎）"}
{"time": 1764769431, "type": "recv", "message_id": "1060702437", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"点点头，\"伊恩觉得，她知道些什么?\""}
{"time": 1764769662, "type": "recv", "message_id": "1100945203", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "挠挠头“我找她只是想知道为什么那天她突然就生气了..也许我能帮到她...不过如今来看，反而让她更难受了”"}
{"time": 1764769866, "type": "recv", "message_id": "121951794", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...那天?\""}
{"time": 1764769870, "type": "recv", "message_id": "1876556781", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"那天又发生什么了\""}
{"time": 1764770180, "type": "recv", "message_id": "1285687066", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“其实就是昨天啦...我不是去问她关于我魔法的事情..她看完之后脸色突然就黑了，问我是先天还是后天获得的魔法...我说我失忆了，她说了一句‘失忆真让人羡慕’，没头没脑的，就又把我赶出去了”"}
{"time": 1764770192, "type": "recv", "message_id": "2040491148", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "事无巨细的讲给舒茉"}
{"time": 1764770776, "type": "recv", "message_id": "1472993803", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1285687066]\"嗯...她是不是...知道些你的过去?\""}
{"time": 1764770794, "type": "recv", "message_id": "1894735457", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "端着手，\"嗯...要不舒茉去问问她?\""}
{"time": 1764770836, "type": "recv", "message_id": "107534972", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“？......好像还真有这种可能...”后知后觉的反应过来“不过我都已经和她那样了..她真的还会见你吗”"}
{"time": 1764771303, "type": "recv", "message_id": "244559811", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...或许我去的话，会好一点吧？\"摇摇头，\"有空的话，我去看看吧。\""}
