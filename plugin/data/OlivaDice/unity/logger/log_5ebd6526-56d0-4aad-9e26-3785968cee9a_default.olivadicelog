{"time": 1763756035, "type": "recv", "message_id": "759513302", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "晚安安"}
