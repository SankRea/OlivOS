{"time": 1764563853, "type": "recv", "message_id": "650498410", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(我想了想，好像该说的话已经全部说了)"}
