{"time": 1764651828, "type": "recv", "message_id": "521502602", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "\"这样啊....\"按这个情况的话，自己估计也帮不到露莉亚"}
{"time": 1764651938, "type": "recv", "message_id": "1023479743", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "喝一口牛奶“谢谢索西雅姐姐和我说这些”"}
{"time": 1764651986, "type": "recv", "message_id": "1577291135", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我看她也不是很需要你帮啊.jpg）"}
{"time": 1764651998, "type": "recv", "message_id": "1489457259", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（可能吧）"}
{"time": 1764652029, "type": "recv", "message_id": "1373010997", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“如果你有什么故事能当做回报就好了。不过在那之前，我倒是好奇，为什么问这些？”"}
{"time": 1764652092, "type": "recv", "message_id": "43292636", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯....我只是想想看看有什么能为露莉亚姐姐做的，毕竟她人很好...”"}
{"time": 1764652173, "type": "recv", "message_id": "1832429123", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（不是想知道为什么只对你摆臭脸？）"}
{"time": 1764652264, "type": "recv", "message_id": "1660184632", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“而且...有些好奇，为什么她昨天生气.了..”"}
{"time": 1764652325, "type": "recv", "message_id": "1159631481", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“哦？”反倒是索西雅来了兴趣“生气了？发生了什么？”"}
{"time": 1764652378, "type": "recv", "message_id": "305072624", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=1470513814]（不是问过了（））"}
{"time": 1764652496, "type": "recv", "message_id": "811746868", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“就是在我告诉她我失忆了之后...她就说很羡慕我，然后就赶我走了”"}
{"time": 1764652522, "type": "recv", "message_id": "1865770094", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（可能是我忘了）"}
{"time": 1764652527, "type": "recv", "message_id": "749288014", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（但是你当时也没说清楚啊）"}
{"time": 1764652724, "type": "recv", "message_id": "1193514662", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“对你生气？嘛，那还真是……你对原因有猜测么？从生气的标准而言，她倒确实是个怪人。”"}
{"time": 1764652847, "type": "recv", "message_id": "1326072604", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我也不太清楚.....可能是露莉亚姐姐想要忘掉什么吧”"}
{"time": 1764653007, "type": "recv", "message_id": "1704785568", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯……”她顿了顿“据我所知，自法兰斯教宗离世后，还是第一次听说她生气……或者说失态。说不定……她想忘记的部分，与你有关？”"}
{"time": 1764653091, "type": "recv", "message_id": "945952826", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "喝一口牛奶沉思"}
{"time": 1764653138, "type": "recv", "message_id": "319763692", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“会是什么呢，总不能去问格兰蒂斯大人吧”"}
{"time": 1764653196, "type": "recv", "message_id": "1720205179", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“她还问了我魔力是先天的还是后天的，会不会跟这个有关”提出猜想"}
{"time": 1764653286, "type": "recv", "message_id": "523382514", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“那我就不清楚了”她摇摇头“她的过去，没人提起过”"}
{"time": 1764653534, "type": "recv", "message_id": "257281106", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“感觉去问她本人估计也问不出什么....那好像只能去拜访格兰蒂斯大人了”"}
{"time": 1764653630, "type": "recv", "message_id": "1990656118", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“不论如何，事情有了进展之后，希望还能在这看见你”"}
{"time": 1764653643, "type": "recv", "message_id": "1349645869", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...谢谢索西雅姐姐”"}
{"time": 1764653661, "type": "recv", "message_id": "733595825", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "将剩下的牛奶一饮而尽“多少钱”"}
