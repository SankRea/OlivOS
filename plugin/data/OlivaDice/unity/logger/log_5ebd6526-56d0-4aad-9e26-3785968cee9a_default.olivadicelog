{"time": 1764561576, "type": "recv", "message_id": "804826186", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（但是伊恩的性格是这样吗，我看平时直球那么多）"}
