{"time": 1764872198, "type": "recv", "message_id": "1503002899", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1659583441]\"总之，现在出发?\"手撑着脑袋，\"路上还要记得买早餐。\""}
{"time": 1764872287, "type": "recv", "message_id": "2129871585", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...”拍拍脸，让自己清醒过来“走吧...在赫顿玛尔的最后半天了...”"}
{"time": 1764872528, "type": "recv", "message_id": "1783522344", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嘛。\"走出门，\"还有什么要做的事，也一并处理了吧。\""}
{"time": 1764872712, "type": "recv", "message_id": "2011222508", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "总之先去酒馆看看，\"待会，伊恩自己问吧?\""}
