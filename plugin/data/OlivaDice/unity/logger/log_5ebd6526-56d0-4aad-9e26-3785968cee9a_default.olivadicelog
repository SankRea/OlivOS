{"time": 1764565778, "type": "recv", "message_id": "1344509060", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（第三杯？第一杯!）"}
