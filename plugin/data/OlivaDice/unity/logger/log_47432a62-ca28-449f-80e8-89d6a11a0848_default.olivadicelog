{"time": 1763737904, "type": "recv", "message_id": "440651682", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（那没事了）"}
{"time": 1763737915, "type": "recv", "message_id": "1674066092", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（这飞机太牛了，不愧是泰拉材料学）"}
