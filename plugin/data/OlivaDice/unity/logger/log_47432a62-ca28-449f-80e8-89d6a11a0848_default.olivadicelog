{"time": 1762956748, "type": "recv", "message_id": "2104479326", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "*上飞机"}
{"time": 1762956783, "type": "recv", "message_id": "322420371", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“昨天缪尔赛思主任说坐飞机过去只要半天。”"}
{"time": 1762956801, "type": "recv", "message_id": "309310321", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“我们应该中午就能到。”"}
{"time": 1762956849, "type": "recv", "message_id": "856230244", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "”那我们先休息一下吧，我昨天晚上没有睡好，被这个突然的任务吓得做噩梦了“"}
{"time": 1762956874, "type": "recv", "message_id": "1411677793", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(要是卡塞尔的飞机你们不是炸了)"}
{"time": 1762956915, "type": "recv", "message_id": "2005671164", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“那菲拉前辈你先睡觉吧，我得看着点飞机防止出问题。”"}
{"time": 1762956918, "type": "recv", "message_id": "569792798", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "总之飞机平稳地升空，这片土地上真正登上高空的人总是少之又少，对于你们中的大多数而言，都是新奇的体验。"}
{"time": 1762956970, "type": "recv", "message_id": "889096061", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*先观察四周的情况，确定一下暂住点的方位"}
