{"time": 1763044349, "type": "recv", "message_id": "41077872", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“好惨....”"}
