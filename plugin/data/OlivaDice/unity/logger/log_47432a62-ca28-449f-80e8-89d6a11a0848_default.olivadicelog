{"time": 1764250631, "type": "recv", "message_id": "268131377", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "“开玩笑的。回去再说吧！”"}
{"time": 1764250650, "type": "recv", "message_id": "254378615", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“菲拉酱....”感动的看着她"}
{"time": 1764250689, "type": "recv", "message_id": "1583097507", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“我这边还有治疗的针剂，拿过去吧”"}
{"time": 1764250691, "type": "recv", "message_id": "704929772", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "斯薇塔把冰层凿开，可以很清晰地看见那个宝石，透明清澈，闪耀着贵重宝石的光泽"}
{"time": 1764250692, "type": "recv", "message_id": "1844726524", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "“好像是队友的伤害比较严重呢！一会你在队伍后面小心一点吧。”"}
{"time": 1764250700, "type": "recv", "message_id": "1972026730", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "但是，水很深"}
{"time": 1764250704, "type": "recv", "message_id": "160547064", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“谢谢你，阿尔忒弥斯酱”"}
