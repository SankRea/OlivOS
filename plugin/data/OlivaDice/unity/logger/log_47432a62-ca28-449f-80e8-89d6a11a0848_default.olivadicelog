{"time": 1764250755, "type": "recv", "message_id": "1706510855", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "\"斯薇塔,把那个宝石给我看看把，我是可是地质学的。\""}
{"time": 1764250818, "type": "recv", "message_id": "1686986354", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“为什么在雪原有宝石？感觉不太像吧”"}
{"time": 1764250834, "type": "recv", "message_id": "771060158", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“这水很深，你们有什么能捞的道具吗？”"}
{"time": 1764250863, "type": "recv", "message_id": "628563219", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我有根钩锁箭头，但是也没法拿来干这个吧”"}
{"time": 1764250875, "type": "recv", "message_id": "699339967", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“有小型机器人吗”"}
{"time": 1764250886, "type": "recv", "message_id": "934801598", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“最好是用机器人去探一下”"}
{"time": 1764250899, "type": "recv", "message_id": "1929977080", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "“东西先给我吧！你能把这水都冻住，然后我们再挖开？”"}
{"time": 1764250920, "type": "recv", "message_id": "726380590", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“也可以试试。”"}
{"time": 1764250932, "type": "recv", "message_id": "1579239464", "deleted": true, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "“宝石先给我拿着？”"}
{"time": 1764250974, "type": "recv", "message_id": "1326245021", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "“这水多深啊？”"}
{"time": 1764250998, "type": "recv", "message_id": "633415020", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "“如果麦姐在就好了，她不怕冷！”"}
{"time": 1764251019, "type": "recv", "message_id": "839935260", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "水深最少十五尺"}
{"time": 1764251067, "type": "recv", "message_id": "1568620682", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“我有一根很长的绳子，你们谁水性好下去拿？”"}
{"time": 1764251081, "type": "recv", "message_id": "1244173341", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“在附近加上标记吧，后续我们拿到探索设备再来吧”"}
{"time": 1764251086, "type": "recv", "message_id": "102209162", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“这种环境不能下去”"}
