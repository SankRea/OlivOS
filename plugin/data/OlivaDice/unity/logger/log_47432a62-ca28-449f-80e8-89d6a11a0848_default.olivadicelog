{"time": 1762960451, "type": "recv", "message_id": "514555548", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“我是实习生斯薇塔，擅长冰系源石技艺和野外求生，老家是萨米的所以会萨米语。”"}
{"time": 1762960457, "type": "recv", "message_id": "1729321129", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（excuse）"}
{"time": 1762960489, "type": "recv", "message_id": "1902394924", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“这次的行动虽然在这边是我负责接应，不过具体的事项还是要各位去负责。”"}
{"time": 1762960500, "type": "recv", "message_id": "1572893775", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我不能离开这里...各位也看得出来。”"}
{"time": 1762960658, "type": "recv", "message_id": "930185287", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "“所以这次行动，还是我们五个人是吧”"}
{"time": 1762960695, "type": "recv", "message_id": "1796958799", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "“要不我来看守这里，您带队出去考察？这样的遗迹您一定不想错过吧”"}
{"time": 1762960711, "type": "recv", "message_id": "1001628799", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"少来，你会控制无人机吗？\""}
{"time": 1762960728, "type": "recv", "message_id": "1631255651", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "“会了”"}
{"time": 1762960746, "type": "recv", "message_id": "612119291", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "*拿出刚刚拆好的无人机给麦哲伦看"}
{"time": 1762960751, "type": "recv", "message_id": "1772370383", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“不得不说”"}
{"time": 1762960763, "type": "recv", "message_id": "870308170", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“她学会的过程并不是非常安全”"}
{"time": 1762960764, "type": "recv", "message_id": "1097499165", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"只要在那边布置好接收器，我这边可以提供给各位无人机的支援。\""}
{"time": 1762960791, "type": "recv", "message_id": "1034339397", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我想也是。\"她扶了扶额头，\"这家伙一直这样，各位不要见怪。\""}
{"time": 1762960802, "type": "recv", "message_id": "1123852426", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "“那这个多主任给我的无人机，也能接入您的系统吗”"}
{"time": 1762960815, "type": "recv", "message_id": "1096493800", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "*拿出另外两个"}
{"time": 1762960985, "type": "recv", "message_id": "1722394214", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"倒是没什么问题。\"她接过无人机，\"嗯...好了，我们该讨论一下之后的方针和前线的情报了。\""}
{"time": 1762961037, "type": "recv", "message_id": "631239713", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“嗯，听说那个遗迹是源石风暴之后出现的，是这样吗麦哲伦前辈？”"}
{"time": 1762961053, "type": "recv", "message_id": "812387343", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“那么遗迹周边是不是源石浓度比较高啊？”"}
{"time": 1762961521, "type": "recv", "message_id": "2016273128", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(感觉可以off)"}
{"time": 1762961527, "type": "recv", "message_id": "1400466983", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": ".log off"}
{"time": 1763037068, "type": "reply", "message_id": "2055268935", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "继续记录乐谱"}
{"time": 1763037079, "type": "recv", "message_id": "1250306989", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "（我说123要一边跑对方的团一边给对方带团"}
{"time": 1763037082, "type": "recv", "message_id": "1039594739", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "（真是一对苦命鸳鸯）"}
{"time": 1763037087, "type": "recv", "message_id": "1865197430", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（真是一对苦命鸳鸯）"}
{"time": 1763037093, "type": "recv", "message_id": "488649710", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（真是一对苦命鸳鸯）"}
{"time": 1763037116, "type": "recv", "message_id": "34427477", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=812387343]（）"}
{"time": 1763037170, "type": "recv", "message_id": "846220796", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=812387343]\"之前是这样没错啦。\"她伸手在终端上比划了一下，调出一组数据给你们，\"前面的是一个月前那附近周边的源石浓度。\"你们可以看见整体的水平高居不下，完全达到了天灾的水平"}
{"time": 1763037171, "type": "recv", "message_id": "551108027", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "（真是一对苦命羽兽）"}
{"time": 1763037214, "type": "recv", "message_id": "1535141116", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "到了一周前，能量浓度则直转直下，\"你们看...到了这里，简直比谢拉格的源石浓度都要低。\""}
{"time": 1763037221, "type": "recv", "message_id": "1903348525", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "\"好奇怪，这是为什么\""}
{"time": 1763037252, "type": "recv", "message_id": "679159815", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“发生了什么事件？”"}
{"time": 1763037277, "type": "recv", "message_id": "1064063607", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "麦哲伦摇了摇脑袋，低头啜饮了一口咖啡，\"关键是，我观察到了城镇。\""}
{"time": 1763037310, "type": "recv", "message_id": "1715831865", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“假的吧，海市蜃楼什么的”*完全没觉得有可能，靠在门口搭一句"}
{"time": 1763037326, "type": "recv", "message_id": "749993392", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:image,file=DCB8EC773A867B57D954CF6984834C04.jpg,sub_type=0,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhS3bXOpcrfup7zUNgFiX8rm-x8oOxjx_QIg_woooPD-65HvkAMyBHByb2RQgL2jAVoQUL5eTvf4BD-5NaLMG8Pnr3oCxtaCAQJneg&amp;rkey=CAISMBxivVvTn6zJFhxlxtz2LEDv5n9KRmRgnov1SlZH49pHSXLWtrSMnNSiFdhZeC0tfQ,file_size=48881]"}
{"time": 1763037340, "type": "recv", "message_id": "1859421085", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“城镇？”想到了之前自己做的梦，感觉有些心惊"}
{"time": 1763037347, "type": "recv", "message_id": "602591865", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“这种源石浓度下…城镇里也不可能有存活的生物吧…”"}
{"time": 1763037365, "type": "recv", "message_id": "51875416", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "“理论上来说 低温低湿度 不会容易观察到海市蜃楼的”"}
{"time": 1763037391, "type": "recv", "message_id": "405269890", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "“不管怎么样，都是要去一趟了”"}
{"time": 1763037394, "type": "recv", "message_id": "218719040", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“而且萨米怎么可能有这么大的未记录城镇。”"}
{"time": 1763037425, "type": "recv", "message_id": "1681654373", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "她调出影像，和之前在莱茵本部看过的投影大差不差，\"虽然有些模糊，海市蜃楼也不可能存在那么久，对不对。\""}
{"time": 1763037449, "type": "recv", "message_id": "959710994", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“问题是，为什么之前没有探测到”"}
{"time": 1763037452, "type": "recv", "message_id": "967655490", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“源石风暴之后突然出现的？是第一次观测这儿吗？”"}
{"time": 1763037459, "type": "recv", "message_id": "838394036", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“有放出任何探测器进入吗”"}
{"time": 1763037474, "type": "recv", "message_id": "414041779", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "“城市遗迹真假不定，那就是真的”"}
{"time": 1763037503, "type": "recv", "message_id": "614711472", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“真假不定，说明就是假的”"}
{"time": 1763037512, "type": "recv", "message_id": "1916388551", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“？”"}
{"time": 1763037513, "type": "recv", "message_id": "2030158271", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"自从莱茵在此处建立科考站到现在，那里一直存在着不散的源石风暴。\""}
{"time": 1763037536, "type": "recv", "message_id": "959835432", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "麦哲伦没有回应两个人的刷宝，\"不如说，建在这里的主要原因就是为了这个。\""}
{"time": 1763037558, "type": "recv", "message_id": "557382172", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“那麦哲伦前辈，这些天有在城镇周围观测到生命活动迹象吗？”"}
{"time": 1763037636, "type": "recv", "message_id": "1198868602", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我出发前做了个梦，梦里也有个繁荣的城镇，而且似乎也在北境...”"}
{"time": 1763037643, "type": "recv", "message_id": "1331725492", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "她轻轻摇摇头，\"我的无人机到不了那里，至少没有铺设信号的话...不行。\""}
{"time": 1763037670, "type": "recv", "message_id": "2089685588", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "“这么说我昨天也做了一个梦，好像还看到你来着？”"}
{"time": 1763037682, "type": "recv", "message_id": "852410304", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"梦?\"她看上去不是很感兴趣，但还是耐心回答了，\"梦到了什么?我?\""}
{"time": 1763037686, "type": "recv", "message_id": "1503264469", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“哇哦，一见钟情”"}
{"time": 1763037722, "type": "recv", "message_id": "1963437351", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "“马主任拿着一朵花跟我说：\"恭喜菲姐可以做总辖啦。\"然后我就被吓醒了”"}
{"time": 1763037743, "type": "recv", "message_id": "715131436", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（是不是串了）"}
{"time": 1763037755, "type": "recv", "message_id": "67360605", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "2628755988"}, "sender": {"id": "2628755988", "name": "柒乔阪"}, "message": "（再让我听到新三国的台词，我就扎聋自己的耳朵）"}
{"time": 1763037764, "type": "recv", "message_id": "1331437679", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "”不对，醒之前好像还有一棵树。“"}
{"time": 1763037786, "type": "recv", "message_id": "43316710", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好啦，一见钟情也太夸张了。\"她皱了皱眉，\"主任?花?树?\"看上去她没怎么听明白，\"好了好了，菲拉是不是出外勤太累了。\""}
{"time": 1763037819, "type": "recv", "message_id": "398203210", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（🐏是回翔的）"}
{"time": 1763037824, "type": "recv", "message_id": "1377558032", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（你是不是漏看一句）"}
{"time": 1763037824, "type": "recv", "message_id": "47228041", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“只能人工进入其中观察情况吗、”"}
{"time": 1763037847, "type": "recv", "message_id": "1530515955", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“看样子通信设备在里面的干扰下多半也没什么作用”"}
{"time": 1763037873, "type": "recv", "message_id": "545695904", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(呃，好像串了，但是差不多吧)"}
{"time": 1763037877, "type": "recv", "message_id": "253232152", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我梦里那个人说我到了感染者的天堂”"}
{"time": 1763037883, "type": "recv", "message_id": "283566847", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“什么预言之地....”"}
{"time": 1763037909, "type": "recv", "message_id": "981473798", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“天堂我家那边就有十几个”*耸肩"}
{"time": 1763037924, "type": "recv", "message_id": "926508149", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"只要各位能在内部布置好信号中继的话，有些轻型无人机应该可以支援各位。\""}
{"time": 1763037971, "type": "recv", "message_id": "1475515673", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"不过探索的初期，就不能指望我这边帮上忙了。\"她看上去有些疲惫，手指略过终端，那些数据和图像归于沉寂"}
{"time": 1763037986, "type": "recv", "message_id": "1421219718", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "“中继的间隔距离是多少”"}
{"time": 1763038075, "type": "recv", "message_id": "1733748626", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"最多五千米，考虑到天气...我建议各位带上两位数的装置。\""}
{"time": 1763038111, "type": "recv", "message_id": "1873548320", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "“这城镇有这么大吗？”"}
