{"time": 1764595129, "type": "recv", "message_id": "1957670022", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "“这里好像不太妙啊。”"}
