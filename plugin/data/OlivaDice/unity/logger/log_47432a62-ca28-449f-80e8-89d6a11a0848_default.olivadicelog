{"time": 1762956717, "type": "recv", "message_id": "517472128", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "1370316409"}, "sender": {"id": "1370316409", "name": "折木"}, "message": "*上飞机"}
