{"time": 1762959017, "type": "recv", "message_id": "1236734360", "deleted": false, "dect": {"host_id": null, "group_id": "1021302580", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "（有围巾应该是友）"}
