{"time": 1766747938, "type": "recv", "message_id": "695409656", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "大概早上十点左右，卡提西亚先醒了过来"}
{"time": 1766748017, "type": "recv", "message_id": "1109431440", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "伸个懒腰，看见陌生的天花板一时有些没反应过来，下意识勒住了梅梅"}
{"time": 1766748025, "type": "recv", "message_id": "52049076", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(紧紧)"}
{"time": 1766748068, "type": "recv", "message_id": "1850444785", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“呜呜.....呜呜...”梅梅有点痛苦了“要..要喘不过...气了”"}
{"time": 1766748305, "type": "recv", "message_id": "1006354935", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哦...\"不太记得梅梅为什么在自己的怀里，松开手，\"唔...这是哪？\""}
{"time": 1766748464, "type": "recv", "message_id": "546487727", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“呼呼呼...”她大口大口的喘了喘气“小卡真是的...这里不是小格的家么”"}
{"time": 1766748604, "type": "recv", "message_id": "561486102", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"哦....\"记忆稍微有点回巢，\"想起来了...\"捂着脑袋，\"头好疼\""}
{"time": 1766748639, "type": "recv", "message_id": "372823293", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我也好痛...”她用小爪子拍了拍胸口"}
