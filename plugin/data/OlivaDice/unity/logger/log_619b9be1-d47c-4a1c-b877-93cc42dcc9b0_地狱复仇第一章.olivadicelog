{"time": 1766664160, "type": "reply", "message_id": "1139075506", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[顾时汐]演奏出: 1D20+11={15}+11=26"}
{"time": 1766664226, "type": "recv", "message_id": "1929612235", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "你能看出来他只说了一部分...并没有全说出来"}
{"time": 1766664292, "type": "recv", "message_id": "2050228377", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"呵呵...\"匕首毫不留情地滑过他的侧脸，完全无关心深浅，\"还有呢？\""}
{"time": 1766664332, "type": "recv", "message_id": "643045827", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“啊...啊..”惨叫“我...我真的不知道了...”"}
{"time": 1766664340, "type": "recv", "message_id": "1110586084", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（过威吓）"}
{"time": 1766664354, "type": "recv", "message_id": "1541083583", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（这个我真有.jpg）"}
{"time": 1766664377, "type": "recv", "message_id": "94481213", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "。rd20+9"}
{"time": 1766664377, "type": "reply", "message_id": "94481213", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[顾时汐]演奏出: 1D20+9={15}+9=24"}
{"time": 1766664412, "type": "recv", "message_id": "1656507550", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "找六根筷子，穿插着夹住他的手指，随后用丝线缠住延伸出来的部分"}
{"time": 1766664458, "type": "recv", "message_id": "2125861306", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "然后缓缓收紧，看起来没什么想拷问的意思"}
{"time": 1766664475, "type": "recv", "message_id": "1758076090", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“啊............”他疼晕了过去"}
{"time": 1766664485, "type": "recv", "message_id": "573084900", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(?)"}
{"time": 1766664487, "type": "recv", "message_id": "275474891", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=1758076090]也可能是心里作用"}
{"time": 1766664539, "type": "recv", "message_id": "1741807762", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "本想找盆水泼醒，走了一半停下来，\"某人好像很喜欢按头啊?\"语气有些不善，\"那就试试?\""}
{"time": 1766664575, "type": "recv", "message_id": "886613442", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“怎么就晕了，这还一根没断呢。”看了看筷子，随手丢到一旁“算了，带回去也一样的”"}
{"time": 1766664805, "type": "recv", "message_id": "157036330", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我觉得应该是对西姆莉说吧）"}
{"time": 1766664842, "type": "recv", "message_id": "1149620607", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我觉得让你试试也无妨”"}
{"time": 1766665032, "type": "recv", "message_id": "327869148", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"很恶心。\"直抒胸臆，\"你想试试吗？姐姐。\"转向格蕾西亚"}
{"time": 1766665238, "type": "recv", "message_id": "1444926307", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“啊……”还是不太习惯这样的称呼“不……我把不好分寸。反正送去监狱里会有人负责这些的”"}
{"time": 1766665437, "type": "recv", "message_id": "141596070", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“不过可以试试辣椒酱，之后再说吧”去后厨翻瓶辣椒酱出来"}
{"time": 1766665521, "type": "recv", "message_id": "1202571713", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "挂着有些奇怪的笑容，\"还没有问完，不是吗？\""}
{"time": 1766665529, "type": "recv", "message_id": "679851351", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我不好说...监狱会不会有其他工作人员，最坏的情况就是只有我们三个了...”"}
{"time": 1766665623, "type": "recv", "message_id": "1704018027", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（什么辣椒水老虎凳夹指板都上一遍是吧）"}
{"time": 1766665772, "type": "recv", "message_id": "222863237", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“……你说得对，那还是在这里解决吧，问完了明天直接游街”站起身来，去接盆水"}
{"time": 1766665788, "type": "recv", "message_id": "252173025", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（我说把湿纸巾盖在口鼻上也有说法）"}
{"time": 1766665933, "type": "recv", "message_id": "1850263247", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"啧。\"脑袋偏向另一侧，感觉有些无趣，抱着手臂"}
{"time": 1766666610, "type": "recv", "message_id": "1242233499", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "第一次干这种事，多少有点生疏，一手薅住诗人的头发，胡乱按进水中。水盆倾斜，漏出来一小片"}
{"time": 1766666687, "type": "recv", "message_id": "1427973259", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“呜呜呜.....”咕噜咕噜的声音过了一会便是更距离的咕噜咕噜"}
{"time": 1766666721, "type": "recv", "message_id": "1560828017", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "感觉差不多了就拎起来，顺便抖两下"}
{"time": 1766666733, "type": "recv", "message_id": "1985607806", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“刚刚说到哪了？”"}
{"time": 1766666768, "type": "recv", "message_id": "2095530992", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我...我说，我都说...别折磨我了，大人...”"}
{"time": 1766666833, "type": "recv", "message_id": "1389010433", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“最后的机会，不说完就给你的眼睛开个孔往里头倒卡根的辣椒酱”"}
{"time": 1766667031, "type": "recv", "message_id": "2072959418", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“呼呼....”他大口大口的喘了就口气"}
{"time": 1766667143, "type": "recv", "message_id": "686802591", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"你瞒着什么？\""}
{"time": 1766667199, "type": "recv", "message_id": "244789048", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“前几天，在镇子外两公里的山崗上，我遇到了一個穿著有翼盔甲的女人...她看起来像天使一样，我就跪了下来，她把我扶了起来，说让我别害怕....她自称是伦西亚·维瑟伦....然后就走了，我以此为灵感，就写了那首歌...”"}
{"time": 1766667240, "type": "recv", "message_id": "475641002", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“哪个方向。”有些不快"}
{"time": 1766667384, "type": "recv", "message_id": "1999147188", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "耸耸肩，反正要问的已经问完了，\"那你们继续，我走了。\""}
{"time": 1766667407, "type": "recv", "message_id": "930787887", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“西...西边”"}
{"time": 1766667490, "type": "recv", "message_id": "2083937160", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "出门离开，收拾东西去监狱办公室新的据点里，同时挑个好房间"}
{"time": 1766667518, "type": "recv", "message_id": "515506975", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“哦，那你现在害怕吗？”冷笑一声，晃晃他的脑袋，中间顿了一下，回头喊住“等会，卡提西亚。你去哪？”"}
{"time": 1766667585, "type": "recv", "message_id": "1030253713", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“别...别杀我...”"}
{"time": 1766667592, "type": "recv", "message_id": "94602782", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"回去休息。\"站定，一副还有我的事?的表情，\"怎么了姐姐大人。\""}
{"time": 1766667689, "type": "recv", "message_id": "71682533", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "犹豫一会，还是努力平静地开口“……等会一起吧”"}
{"time": 1766667739, "type": "recv", "message_id": "168444570", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...有话要说?\"脸上挂上笑容"}
{"time": 1766667790, "type": "recv", "message_id": "328016500", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "那西姆莉也不打扰你们，识趣的背起二人走了"}
{"time": 1766667808, "type": "recv", "message_id": "1726575688", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“未必，不过可以有酒喝。”"}
{"time": 1766667943, "type": "recv", "message_id": "546851107", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"我还没成年。\"原地找个椅子坐下，招呼梅梅坐在一旁，看向格雷西亚"}
{"time": 1766667982, "type": "recv", "message_id": "1592104530", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“小卡...要不我也先走吧，去把我们东西收拾收拾”"}
{"time": 1766668371, "type": "recv", "message_id": "290485889", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...?\"稍微偏了偏脑袋看着她，最后点了点头，\"路上小心。\""}
{"time": 1766668445, "type": "recv", "message_id": "1971744204", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯嗯...”梅梅也离开了"}
{"time": 1766668456, "type": "recv", "message_id": "1501660730", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“前两天不也喝了。”直接无视这个理由“而且我没打算在这”"}
{"time": 1766668559, "type": "recv", "message_id": "499282260", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"诶...那要去哪?\"站起身，自己的感情也谈得上复杂，深吸一口气，\"行吧。\""}
{"time": 1766668613, "type": "recv", "message_id": "398619426", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“我家，上次我带了一瓶回去，还记得吗？”感觉自己也是疯了"}
{"time": 1766668788, "type": "recv", "message_id": "1364816853", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯，不让我去歇息的那天晚上。\""}
{"time": 1766668880, "type": "recv", "message_id": "578845578", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“嗯，去不去？”"}
{"time": 1766668911, "type": "recv", "message_id": "916495096", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"姐姐都这么说了。\"嘴角轻轻勾起，\"不是很怕我吗？\""}
{"time": 1766669052, "type": "recv", "message_id": "1510924606", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“希望你没对我说谎。”显然是指之前说不杀自己的事情，去后厨再拿些香肠肉干烤饼，还有葡萄酒，一瓶显然不太够喝"}
{"time": 1766669263, "type": "recv", "message_id": "120991241", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:reply,id=1510924606]\"嗯。\"点头，\"我不会说谎。\"静静跟着"}
{"time": 1766669272, "type": "recv", "message_id": "1300063755", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（save,晚上继续吧）"}
{"time": 1766669388, "type": "recv", "message_id": "209823657", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(咦，其实还好?)"}
{"time": 1766677552, "type": "recv", "message_id": "1396431067", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（嗓子好痛）"}
{"time": 1766677578, "type": "recv", "message_id": "1272336993", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（等下有1吗，没有我去体验新游戏了[CQ:at,qq=1252219916] [CQ:at,qq=825734198] ）"}
