{"time": 1766663451, "type": "reply", "message_id": "271081922", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "开始记录乐谱"}
{"time": 1766663451, "type": "recv", "message_id": "981131196", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "两天一end不好说对不对"}
{"time": 1766663585, "type": "recv", "message_id": "1839467607", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=1612055505]（）"}
{"time": 1766663692, "type": "recv", "message_id": "790912020", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"...\"虽然说上去自己很想杀了这家伙，但是...不行...忍耐着杀人的欲望，收起匕首"}
{"time": 1766663736, "type": "recv", "message_id": "805933457", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“看起来把这家伙带回去，就可以休息了”西姆莉打个哈欠"}
{"time": 1766663857, "type": "recv", "message_id": "435984861", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "抽出一根钩锁，把诗人的上半身也捆个结实，这才有空喘口气“贴封条的事也不用我们干吧。”"}
{"time": 1766663888, "type": "recv", "message_id": "878920714", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“关酒馆吗？格蕾西亚你来决定吧”"}
{"time": 1766663934, "type": "recv", "message_id": "935024112", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"不知道...哦...\"走近诗人，\"你那首没什么品味，又有些难听的歌，是怎么编的?\"重新抽出匕首，架在这家伙的脸颊上"}
{"time": 1766664020, "type": "recv", "message_id": "1722702872", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“别..别杀我，我都说。我都说....”"}
{"time": 1766664071, "type": "recv", "message_id": "2021496445", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“厨子都不在了，还开着干嘛。”看了看几个侍者“一个月几十个银币玩什么命啊”"}
{"time": 1766664114, "type": "recv", "message_id": "1419915683", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"敢说慌你就死定了。\"语气平淡，像是诉说一件微不足道之事"}
{"time": 1766664139, "type": "recv", "message_id": "43767935", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“那首歌的内容我是受阿尔玛布道的启发....才创作出来的..更详细的事情..我就不知道了..”"}
{"time": 1766664141, "type": "recv", "message_id": "238096873", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": ".rh"}
{"time": 1766664141, "type": "reply", "message_id": "238096873", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[伊恩]试图在黑暗中窥见岁月史书"}
{"time": 1766664141, "type": "reply_private", "message_id": "238096873", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "在演奏厅中[伊恩]演奏出: 1D20=6"}
{"time": 1766664152, "type": "recv", "message_id": "1254284493", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(察言观色)"}
