{"time": 1766739208, "type": "recv", "message_id": "1439659061", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"唔...\"有一搭没一搭地点头，\"反正...不舒服!\""}
{"time": 1766739223, "type": "recv", "message_id": "72430461", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“温水...温水在哪..我们走快点吧”"}
{"time": 1766739412, "type": "recv", "message_id": "1905908921", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "[CQ:reply,id=1058480232]（）"}
{"time": 1766739522, "type": "recv", "message_id": "971322413", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（没事就到了吧）"}
{"time": 1766739549, "type": "recv", "message_id": "688783744", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "很快你们便回到了格蕾西亚的房子里"}
{"time": 1766739633, "type": "recv", "message_id": "1337447391", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"捂着肚子，\"要睡着了..\""}
{"time": 1766739659, "type": "recv", "message_id": "1199666223", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“喝点温水再睡...”"}
{"time": 1766739806, "type": "recv", "message_id": "275551902", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "点上灯，把出门前烧上的水兑上凉水，泡上两片枣干“我就知道……”"}
{"time": 1766739843, "type": "recv", "message_id": "831978223", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "梅梅则小心把卡提希娅放在了沙发上"}
{"time": 1766739847, "type": "recv", "message_id": "311934202", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那不就能看见她怎么拎行李的了）"}
{"time": 1766739869, "type": "recv", "message_id": "13652969", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"好啦....不要紧...\""}
{"time": 1766739889, "type": "recv", "message_id": "256811712", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "格蕾西亚看到梅丹佐居然是用尾巴提着行李的"}
{"time": 1766740114, "type": "recv", "message_id": "911640524", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "摸了摸梅梅的脑袋，\"睡觉吧——\""}
{"time": 1766740114, "type": "recv", "message_id": "444350803", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“？”揉揉眼睛，感觉自己是不是眼花了“啊……？”"}
{"time": 1766740147, "type": "recv", "message_id": "140997155", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "梅梅放下了行李，你也确实没在看见尾巴了"}
{"time": 1766740339, "type": "recv", "message_id": "1651577290", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“不，不对……”后退一步，感觉多少有些猎奇“尾巴？”"}
{"time": 1766740546, "type": "recv", "message_id": "1223616636", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"唔?\""}
{"time": 1766740559, "type": "recv", "message_id": "1945697212", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（蜥蜴人来袭（不是））"}
{"time": 1766740591, "type": "recv", "message_id": "1116924449", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“？小格看到了啊...emmm”她思索了一下“看来我得把你灭口了”"}
{"time": 1766740708, "type": "recv", "message_id": "102509391", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "拉着梅梅，摇头"}
{"time": 1766740741, "type": "recv", "message_id": "1536518981", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "看起来奶凶奶凶的"}
{"time": 1766740841, "type": "recv", "message_id": "1609019022", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“你……你到底是什么？”就算现在看起来再怎么可爱，再像虚张声势，自己也绝不敢怠慢，酒都化作冷汗发了出来，又拉开点距离“一直待在卡提西亚旁边，想做什么？”"}
{"time": 1766740922, "type": "recv", "message_id": "2037406326", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“开个玩笑啦...小格怎么这么紧张啊”她挠了挠头笑笑“我怎么可能真的打你啊”"}
{"time": 1766741006, "type": "recv", "message_id": "1421175304", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（感觉这个更是精神分裂（））"}
{"time": 1766741087, "type": "recv", "message_id": "1747762305", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "松开手，\"...\"捂着自己的肚子闭上眼"}
{"time": 1766741186, "type": "recv", "message_id": "1214516793", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“水..小格..小卡还难受着呢，不和你开玩笑啦”"}
{"time": 1766741334, "type": "recv", "message_id": "440227128", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“这不好笑，你是什么？”把水杯放在桌上，警戒着她的动作"}
{"time": 1766741393, "type": "recv", "message_id": "1065306656", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "她撇了撇嘴，自己把水杯拿了过来，然后坐到卡缇希亚旁边“小卡..先..喝水，喝完水再睡”又忍不住打了个哈欠"}
{"time": 1766741438, "type": "recv", "message_id": "308491933", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（感觉该趁她一只手上拿着东西突袭进战（））"}
{"time": 1766741473, "type": "recv", "message_id": "1676824969", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"微张着唇，小口小口喝水，倒是没有立刻就好转，\"啊...\"伸手箍着她，\"梅梅也睡...\""}
{"time": 1766741518, "type": "recv", "message_id": "257617713", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“就睡这吗...好吧...”她顺势变回原形，趴在小卡的肚子上，睡!"}
{"time": 1766741798, "type": "recv", "message_id": "800251279", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"嗯...\"抱住她，闭上眼"}
{"time": 1766741853, "type": "recv", "message_id": "1758461459", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（闭上眼~才算醒来~）"}
{"time": 1766741981, "type": "recv", "message_id": "361501243", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "“这是……龙？”看到那对小翅膀，不知为何恐惧消退了一点，身形没那么紧绷，大概是因为来历不明的尾巴会让人想到一些不妙的冷血动物，拼在人身上总有一种异质感"}
{"time": 1766742015, "type": "recv", "message_id": "780894568", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（原来，你也是龙（bushi））"}
{"time": 1766742220, "type": "recv", "message_id": "1954148525", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（那就不奇怪了，那就不奇怪了）"}
{"time": 1766742321, "type": "recv", "message_id": "1503134154", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "还剩下一点点意识，朦胧着眼睛看着格雷西亚"}
{"time": 1766742359, "type": "recv", "message_id": "1476238767", "deleted": false, "dect": {"host_id": null, "group_id": "1020481325", "user_id": "825734198"}, "sender": {"id": "825734198", "name": "草食龙"}, "message": "（哎，怎么没有人回答我）"}
