{"time": 1758723266, "type": "recv", "message_id": "835662045", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "（我认识吗）"}
{"time": 1758723362, "type": "recv", "message_id": "901881876", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我认识吗）"}
{"time": 1758723364, "type": "recv", "message_id": "2057476819", "deleted": true, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "你们的另一个小学同学，据你们，没有和你们一起升入中学。"}
{"time": 1758723371, "type": "recv", "message_id": "1248065689", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "你们的另一个小学同学，据你们所知，没有和你们一起升入中学。"}
{"time": 1758723389, "type": "recv", "message_id": "1630829763", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“不见了重新买吧”"}
{"time": 1758723391, "type": "recv", "message_id": "674716234", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "[CQ:image,summary=&#91;动画表情&#93;,file=063F166285F5EAD571A4DE8B7470FD2C.jpg,sub_type=1,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhTG1mneol9KZXZF2Rnp9Md-Jxi64Rii1gQg_woo2fPpl8vxjwMyBHByb2RQgL2jAVoQcJ772ejlvFZzcvMTO3D1ynoCc_GCAQJneg&amp;rkey=CAQSMNVZorbwt_8rU9MxzKoD6hOfMPJ4tyXwEKdMskKJ5k6jDRUeVRu4L1cgXPEuvRG28Q,file_size=76578]"}
{"time": 1758723427, "type": "recv", "message_id": "482777046", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“所以为什么你会把戒指遗失在那里，你去那里干啥”"}
{"time": 1758723429, "type": "recv", "message_id": "986497675", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "emmm，但毕竟是汀田君的一片心意”有些纠结"}
{"time": 1758723537, "type": "recv", "message_id": "1456766696", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“那我先提前祝贺你们了，既然是求婚戒指这么重要的东西……”似乎经历了很大的思想挣扎，点了点头"}
{"time": 1758723546, "type": "recv", "message_id": "1392720054", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“我可以帮忙……”"}
{"time": 1758723603, "type": "recv", "message_id": "1842176065", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“老实说...”他有些难以启齿，“有个人偶和羊宫很像，连手指都一样诶...我就想试一试..”"}
{"time": 1758723676, "type": "recv", "message_id": "1972096068", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "（有点变态）"}
{"time": 1758723838, "type": "recv", "message_id": "1587850088", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“诶，那真是谢谢你们了。”他开心地笑，然后收了收表情，“咳咳...那么，散场之后，我在门口等你们。”"}
{"time": 1758723841, "type": "recv", "message_id": "95752505", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“你要怎么试”"}
{"time": 1758724024, "type": "recv", "message_id": "622705526", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“嗯...”最后还是心软同意了“汀田君不会觉得我是来添乱的就好..”"}
{"time": 1758724028, "type": "recv", "message_id": "1915566301", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“当时已经试过了啦...”他有些脸红，拿着手上的杯子走开了。"}
{"time": 1758724289, "type": "recv", "message_id": "1161854818", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "[CQ:image,summary=&#91;动画表情&#93;,file=BE05C5741B2F75779E295FE4B1BAC4BE.jpg,sub_type=1,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhQzcmZwgEiNNPp5Wz6S27XsJp67cxijFiD_CijFhujDzvGPAzIEcHJvZFCAvaMBWhD3ZfusnbC12u9kLa4X6egeegK_d4IBAmd6&amp;rkey=CAQSMNVZorbwt_8rU9MxzKoD6hOfMPJ4tyXwEKdMskKJ5k6jDRUeVRu4L1cgXPEuvRG28Q,file_size=2851]"}
{"time": 1758724304, "type": "recv", "message_id": "20995136", "deleted": true, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“”"}
{"time": 1758724329, "type": "recv", "message_id": "263047027", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“真好啊………汀田君都要结婚了”"}
{"time": 1758724374, "type": "recv", "message_id": "882422783", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“是啊...感觉有点羡慕”"}
{"time": 1758724401, "type": "recv", "message_id": "735989430", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“不好评价”"}
{"time": 1758724437, "type": "recv", "message_id": "443442825", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“买未婚妻同款娃娃”"}
{"time": 1758724509, "type": "recv", "message_id": "447792958", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“会不会是羊宫变成娃娃了”忽然想讲点吓人的"}
{"time": 1758724600, "type": "recv", "message_id": "846832195", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“七海你不要说这种……”捂住耳朵"}
{"time": 1758724650, "type": "recv", "message_id": "1025513585", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“吓人”"}
{"time": 1758724680, "type": "recv", "message_id": "1662289871", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“对不起..对不起”自己说的话甚至连自己都有点吓到了"}
{"time": 1758724819, "type": "recv", "message_id": "729728579", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "所幸夏夜总是温馨且温暖，这种沉重的话题一触即散。"}
{"time": 1758724841, "type": "recv", "message_id": "1156440444", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "其乐融融的宴会将你们拉入席中，直到散场。"}
