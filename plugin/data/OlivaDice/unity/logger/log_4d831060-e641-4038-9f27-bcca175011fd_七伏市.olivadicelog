{"time": 1758721686, "type": "recv", "message_id": "908099832", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "[CQ:image,summary=&#91;动画表情&#93;,file=6A7754A4711A6E69FDD2EE70E3CE1DFF.jpg,sub_type=1,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhSIaZTO536Xv2BNYaM8N5T30h7jFhjImgEg_woooqXC6sTxjwMyBHByb2RQgL2jAVoQ5-n0OUjynlxLq8WtezdI_noCA8GCAQJneg&amp;rkey=CAESMNwtalp-UQi87eZ76JFhsl4WZ2GzgCmMNi6MgnUcAt25hP4zsY4x7Vl3y_FxhfwYuQ,file_size=19784]"}
{"time": 1758721689, "type": "recv", "message_id": "1089225103", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我还赚大钱？”他摇头，“好啦好啦，这种沉闷的话题不适合在重逢的时候说。”"}
{"time": 1758721718, "type": "recv", "message_id": "1595412452", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“还是说些过去的故事吧？我来开个头，嗯...”他沉思了一下，“你们还记得小时候自己最怕什么吗？”"}
{"time": 1758721764, "type": "recv", "message_id": "1480804961", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“不记得”"}
{"time": 1758721811, "type": "recv", "message_id": "1488887216", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“我好多怕的东西，你们也知道的，我老是做噩梦……”"}
{"time": 1758721816, "type": "recv", "message_id": "28807408", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我最怕一些神神鬼鬼的东西了”"}
{"time": 1758721868, "type": "recv", "message_id": "893551588", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“也许怕老师”"}
{"time": 1758721900, "type": "recv", "message_id": "1795091760", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "他一边听一边点头，“要是我说的话....嘿。”"}
{"time": 1758721911, "type": "recv", "message_id": "641551340", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“你们还记得‘黄昏的人偶馆’吗？”"}
{"time": 1758721998, "type": "recv", "message_id": "883957929", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“不知道\n”"}
{"time": 1758722001, "type": "recv", "message_id": "214714431", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（可以过灵感。）"}
{"time": 1758722128, "type": "recv", "message_id": "1138995218", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": ".ra灵感"}
{"time": 1758722128, "type": "reply", "message_id": "1138995218", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[喜多蓓蕾]进行技能[灵感:65]检定: 1D100=42 成功，春风得意马蹄急，一日看尽长安花"}
{"time": 1758722131, "type": "recv", "message_id": "1555186236", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": ".ra灵感"}
{"time": 1758722131, "type": "reply", "message_id": "1555186236", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "[sio2]进行技能[灵感:90]检定: 1D100=10 极难成功，流水落花春去也，天上人间"}
{"time": 1758722215, "type": "recv", "message_id": "450969238", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "你们想起，黄昏的人偶馆是一个位于市郊的人偶展馆，真名叫人偶艺术展览馆。之所以叫黄昏，是因为传言在黄昏时分，那里的人偶会自己活过来，在黄昏时踏入之人也无法见到第二天的清晨，如此云云。"}
{"time": 1758722268, "type": "recv", "message_id": "1004004390", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“貌似有点印象了”"}
{"time": 1758722278, "type": "recv", "message_id": "148621101", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“小时候我怕人偶，根本不敢靠近，但回到这里之后，我突然有了兴趣，就去看了看。”他有点不好意思地挠挠头“那里展示了从世界各地收集来的奇妙又妖异的人偶。虽然有点不寒而栗，但比起那种感觉，我更多的是觉得它们...很美。可惜的是，最近馆主身体不好，人偶馆一直关闭⋯⋯应该是这样吧？不过，最近有个奇怪的‘传闻’流传开来。”"}
{"time": 1758722298, "type": "recv", "message_id": "968469113", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“你细说”"}
{"time": 1758722300, "type": "recv", "message_id": "208046548", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“传闻？”"}
{"time": 1758722308, "type": "recv", "message_id": "531128273", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我最怕这些了...别吓我”"}
{"time": 1758722329, "type": "recv", "message_id": "950238204", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "向来害怕这种故事，用手抓紧身边的包包"}
{"time": 1758722492, "type": "recv", "message_id": "870382471", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“深夜的时候，不知道为什么，原本闭馆的人偶馆会开门。进去的人会据说都会被人偶带走，然后失踪⋯⋯”夏夜里平白多了一丝凉爽，他笑眯眯地开口，“既然如此，要不要在回去的路上去黄昏的人偶馆看看？我们没准可以揭开真相！”"}
{"time": 1758722518, "type": "recv", "message_id": "247565387", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "[CQ:image,summary=&#91;动画表情&#93;,file=BE05C5741B2F75779E295FE4B1BAC4BE.jpg,sub_type=1,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhQzcmZwgEiNNPp5Wz6S27XsJp67cxijFiD_CiicyNX3x_GPAzIEcHJvZFCAvaMBWhDbD50HL8J4b6vQPu54VipSegJUNYIBAmd6&amp;rkey=CAQSMNVZorbwt_8rU9MxzKoD6hOfMPJ4tyXwEKdMskKJ5k6jDRUeVRu4L1cgXPEuvRG28Q,file_size=2851]"}
{"time": 1758722529, "type": "recv", "message_id": "1616161299", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "（像害人精）"}
{"time": 1758722534, "type": "recv", "message_id": "1521319875", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“啊？可以不去吗...”"}
{"time": 1758722547, "type": "recv", "message_id": "851966688", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我会拖大家后腿的啦”"}
{"time": 1758722548, "type": "recv", "message_id": "128863224", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“我……我还是不去了吧”"}
{"time": 1758722559, "type": "recv", "message_id": "1447301239", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“我怕晚上又做噩梦了”"}
{"time": 1758722639, "type": "recv", "message_id": "942042031", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“有点诡异了，感觉还是不要冒险”"}
{"time": 1758722739, "type": "recv", "message_id": "2072154376", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“诶，你们不感兴趣吗？”"}
{"time": 1758722762, "type": "recv", "message_id": "2106266923", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“嗯...这样吧，我再组织一些人，大家一起去，怎么样？也算人多壮胆。”"}
{"time": 1758722771, "type": "recv", "message_id": "10962988", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“我身体不太好，汀田君不记得了吗”"}
{"time": 1758722794, "type": "recv", "message_id": "1770592890", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "[CQ:image,summary=&#91;动画表情&#93;,file=2A5EAC118CE03408DC3B24D88D80D68D.jpg,sub_type=1,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhQ_8zM_cY-abfZdSvWrdqcDHZfEjxiCiAYg_wookbeC-8jxjwMyBHByb2RQgL2jAVoQcCeLnP59WOquuAewMgbnpHoCru2CAQJneg&amp;rkey=CAQSMNVZorbwt_8rU9MxzKoD6hOfMPJ4tyXwEKdMskKJ5k6jDRUeVRu4L1cgXPEuvRG28Q,file_size=99330]"}
{"time": 1758722814, "type": "recv", "message_id": "973002530", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“lpy，为啥你执念这么深”"}
{"time": 1758722818, "type": "recv", "message_id": "1866825976", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“发生了什么事”"}
{"time": 1758722851, "type": "recv", "message_id": "586498072", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“我丢了一个东西。”他压低声音，显得神秘兮兮的，“我猜就在里面。”"}
{"time": 1758723003, "type": "recv", "message_id": "1782155067", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“很重要吗...”"}
{"time": 1758723021, "type": "recv", "message_id": "1936906697", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“什么东西”"}
{"time": 1758723118, "type": "recv", "message_id": "1025157875", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“虽然很想说是秘密...”他叹口气，“好吧，是我的求婚戒指。”"}
{"time": 1758723146, "type": "recv", "message_id": "1837282063", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“哇哦，求婚戒指，和谁”"}
{"time": 1758723149, "type": "recv", "message_id": "1433359190", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "(我怎么有种他已经变成人偶 想把我们骗过去杀的感觉)"}
{"time": 1758723151, "type": "recv", "message_id": "349196309", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“上次去人偶馆参观，回来就不见了...但是明天就要求婚，帮帮我吧。”"}
{"time": 1758723151, "type": "recv", "message_id": "376248783", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“诶？！求婚戒指？”捂住嘴"}
{"time": 1758723161, "type": "recv", "message_id": "1615488054", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "[CQ:reply,id=1433359190][CQ:at,qq=1040972910] （包包的）"}
{"time": 1758723173, "type": "recv", "message_id": "1677469708", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“汀田君要结婚了吗”有些惊讶"}
{"time": 1758723174, "type": "recv", "message_id": "252563805", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（一眼坏逼）"}
{"time": 1758723190, "type": "recv", "message_id": "1938833053", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“是啊，和羊宫小姐。”"}
{"time": 1758723205, "type": "recv", "message_id": "2108571742", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（？）"}
