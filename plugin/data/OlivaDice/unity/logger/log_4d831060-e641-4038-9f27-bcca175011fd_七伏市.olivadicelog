{"time": 1759244546, "type": "recv", "message_id": "51088159", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "总之，当你们依次抵达时"}
{"time": 1759244564, "type": "recv", "message_id": "887743111", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "会看见已经到了的乃琳"}
{"time": 1759244581, "type": "recv", "message_id": "1106661738", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“哎？乃琳？你怎么也在这里”"}
{"time": 1759244590, "type": "recv", "message_id": "64401222", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“你是？”"}
{"time": 1759244619, "type": "recv", "message_id": "1845174101", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“这是我的同事，八幡乃琳”"}
{"time": 1759244680, "type": "recv", "message_id": "457868096", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "一把将小矮子抱住拎起来：”王嘉然！你怎么也来了！！“"}
{"time": 1759244681, "type": "recv", "message_id": "211493105", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“😯”"}
{"time": 1759244707, "type": "recv", "message_id": "1563043601", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我明明姓七海（））"}
{"time": 1759244744, "type": "recv", "message_id": "967501880", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "（这里要榛名play吗）"}
{"time": 1759244763, "type": "recv", "message_id": "721565502", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“这话我应该问乃琳才对吧...”"}
{"time": 1759244839, "type": "recv", "message_id": "381207876", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "小声问七海嘉然”这些是你的朋友吗？我应该怎么称呼你，二玖吗？还是七海？“"}
{"time": 1759244890, "type": "recv", "message_id": "894083740", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "有点怕生地回应“你好”"}
{"time": 1759244908, "type": "recv", "message_id": "2064841904", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "”你好！这位小朋友也很可爱啊！！“"}
{"time": 1759244925, "type": "recv", "message_id": "1536222459", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（小朋友吗）"}
{"time": 1759244958, "type": "recv", "message_id": "2090880593", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“你好，我叫龙崎阳羽，是嘉然的同学”"}
{"time": 1759244960, "type": "recv", "message_id": "1202434508", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "[CQ:image,summary=&#91;动画表情&#93;,file=063F166285F5EAD571A4DE8B7470FD2C.jpg,sub_type=1,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhTG1mneol9KZXZF2Rnp9Md-Jxi64Rii1gQg_woohpTwluKAkAMyBHByb2RQgL2jAVoQHJOCvvR38c40KjZ2AfMRHHoCeL6CAQJneg&amp;rkey=CAISMNdW7Leiq9Pe8XHWbYeDtOE4EkIGit75smWeuJ3CXaCjxsOMrg6z3TJAsuXYmUUPNQ,file_size=76578]"}
{"time": 1759245075, "type": "recv", "message_id": "259641484", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "”你好你好！“感觉这个小孩子有点怕生，忍住了摸头的冲动"}
{"time": 1759245096, "type": "recv", "message_id": "1618180519", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（其实都是小学同学）"}
{"time": 1759245112, "type": "recv", "message_id": "1765623755", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（所以年龄大概是一样的"}
{"time": 1759245124, "type": "recv", "message_id": "29297489", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（大家不都是20 21岁）"}
{"time": 1759245182, "type": "recv", "message_id": "703505716", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "（乃琳喜欢自称大姐姐）"}
{"time": 1759245364, "type": "recv", "message_id": "1857740198", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "约定你们来的人还没有来"}
{"time": 1759245387, "type": "recv", "message_id": "1114698628", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（叫啥来着）"}
{"time": 1759245518, "type": "recv", "message_id": "1922944213", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“汀田君怎么还没到？还不会出什么事了吧”"}
{"time": 1759245532, "type": "recv", "message_id": "77545314", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "”汀田君是？“"}
{"time": 1759245546, "type": "recv", "message_id": "2141956634", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“怎么约了我们来，还没到，要不打电话联系一下吧，你们有联系方式吗”"}
{"time": 1759245714, "type": "recv", "message_id": "2107739698", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“额，我好像没有，毕竟好久没见过了”"}
{"time": 1759245733, "type": "recv", "message_id": "2134068416", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=77545314][CQ:at,qq=376030837] “汀田君就是约我们过来的人”"}
{"time": 1759245836, "type": "recv", "message_id": "1016198017", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "过了一会，他气喘吁吁地从马路另一边过来"}
{"time": 1759245852, "type": "recv", "message_id": "123135649", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "（好像看到以为是恶作剧，没有留意发件人名字）"}
{"time": 1759245903, "type": "recv", "message_id": "327540552", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“哇，肾虚吗，怎么喘起来了”"}
{"time": 1759245924, "type": "recv", "message_id": "508304526", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"没事...路上被事情耽误了。\""}
{"time": 1759245961, "type": "recv", "message_id": "1290080967", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "即使在阳光下，人偶馆也显得有些冷飕飕的，周围遍布杂草，门口挂着close"}
{"time": 1759246099, "type": "recv", "message_id": "707553639", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“关门了喔，要不下次”"}
{"time": 1759246163, "type": "recv", "message_id": "1556281389", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（不是今天结婚了）"}
{"time": 1759246178, "type": "recv", "message_id": "1849422607", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"啊...?\"他看着门口，\"不会啊，前几天还有人\""}
{"time": 1759246181, "type": "recv", "message_id": "1933917658", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "376030837"}, "sender": {"id": "376030837", "name": "熊木"}, "message": "”那我们走吧 回去喝茶去！“"}
{"time": 1759246260, "type": "recv", "message_id": "997938621", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“那是前几天”"}
{"time": 1759246323, "type": "recv", "message_id": "1028802894", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "(save吧，明天下午再开。)"}
{"time": 1759246328, "type": "recv", "message_id": "2100776134", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（好的）"}
{"time": 1759246332, "type": "recv", "message_id": "1112154275", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "[CQ:image,summary=&#91;动画表情&#93;,file=BEA12089A8F12096314064CF7C9C3F21.jpg,sub_type=1,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhQ00eJumMOa7sDxC68xS5MuE-scShiW7wEg_woo05umpeeAkAMyBHByb2RQgL2jAVoQ22TmplKxGEvmiKewZE6lcXoCZQeCAQJneg&amp;rkey=CAISMNdW7Leiq9Pe8XHWbYeDtOE4EkIGit75smWeuJ3CXaCjxsOMrg6z3TJAsuXYmUUPNQ,file_size=30614]"}
