{"time": 1758720188, "type": "recv", "message_id": "1621369548", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "某年的夏天"}
{"time": 1758720278, "type": "recv", "message_id": "143065643", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "正值盂兰盆节假期。在七伏市内的酒店里举行的中学同学聚会中，你们偶然相遇，自上一次别离已过数年。"}
{"time": 1758720401, "type": "recv", "message_id": "262335297", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“喜多酱，龙崎君”看见他们二人有点惊喜"}
{"time": 1758720404, "type": "recv", "message_id": "387429704", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": ".sn"}
{"time": 1758720404, "type": "reply", "message_id": "387429704", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": 2875548981, "name": "小雅"}, "message": "已将[划船不靠桨の233]的群名片修改为[七海嘉然 hp8/8 san30/30 dex80]"}
