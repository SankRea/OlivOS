{"time": 1758720428, "type": "recv", "message_id": "1323190914", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "[CQ:image,summary=&#91;动画表情&#93;,file=063F166285F5EAD571A4DE8B7470FD2C.jpg,sub_type=1,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhTG1mneol9KZXZF2Rnp9Md-Jxi64Rii1gQg_woots6Pk8DxjwMyBHByb2RQgL2jAVoQ7KUvqSmsgAl4ZYYtyag8aXoCAJGCAQJneg&amp;rkey=CAESMNwtalp-UQi87eZ76JFhsl4WZ2GzgCmMNi6MgnUcAt25hP4zsY4x7Vl3y_FxhfwYuQ,file_size=76578]"}
{"time": 1758720452, "type": "recv", "message_id": "269025512", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“宝子，现在在哪里高就”"}
{"time": 1758720509, "type": "recv", "message_id": "633345438", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“嗯……好久不见”轻微点头"}
{"time": 1758720514, "type": "recv", "message_id": "468164330", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "附近的同学三三两两交谈，现场显然很热闹。有个服务生手捧着碟盘，上面摆着几杯清亮的鸡尾酒，走到你们身边问询。"}
{"time": 1758720631, "type": "recv", "message_id": "52135531", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "（问了什么）"}
{"time": 1758720662, "type": "recv", "message_id": "1754694999", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（要不要酒）"}
{"time": 1758720672, "type": "recv", "message_id": "42343809", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“几位，需要吗？”"}
{"time": 1758720678, "type": "recv", "message_id": "718839108", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "摇头表示不要"}
{"time": 1758720695, "type": "recv", "message_id": "623150738", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "摇摇手“暂时不需要”"}
{"time": 1758720744, "type": "recv", "message_id": "951828366", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=269025512][CQ:at,qq=786921597] “秘密哦”wink"}
{"time": 1758720776, "type": "recv", "message_id": "822783275", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "也摇摇头拒绝了，自己身体有点不太好，不能接受酒精的刺激"}
{"time": 1758720864, "type": "recv", "message_id": "96602749", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "他点点头，端着盘子往前离开，去问其他人。现场弥漫着酒精的味道和早就点燃的熏香。"}
{"time": 1758721022, "type": "recv", "message_id": "239850799", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "（还有什么要说的吗你们之间）"}
{"time": 1758721043, "type": "recv", "message_id": "503189697", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "（我猜没有）"}
{"time": 1758721052, "type": "recv", "message_id": "85700393", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（我猜没有）"}
{"time": 1758721054, "type": "recv", "message_id": "770057791", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（我猜没有）"}
{"time": 1758721075, "type": "recv", "message_id": "94925635", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（我猜没有）"}
{"time": 1758721142, "type": "recv", "message_id": "275473939", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不过都过了这么多年，还能见到二位真是让人感到惊喜啊”"}
{"time": 1758721145, "type": "recv", "message_id": "1819167865", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "你们正说着话，町田友昭走近，自然地和你们打个招呼，“哟，你们好。”"}
{"time": 1758721157, "type": "recv", "message_id": "117959780", "deleted": true, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“先生你是？”"}
{"time": 1758721166, "type": "recv", "message_id": "2012510374", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "町田在升上中学时就搬到了东京，因此这次是各位久违的重逢。"}
{"time": 1758721181, "type": "recv", "message_id": "782446872", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“lpy啊，好久不见”"}
{"time": 1758721190, "type": "recv", "message_id": "969427476", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "（原来也是同学）"}
{"time": 1758721204, "type": "recv", "message_id": "1446373037", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "（老朋友）"}
{"time": 1758721234, "type": "recv", "message_id": "1995954224", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“许久不见，小时候我们还一起掏过鸟蛋。”他眨眨眼，“唉，现状可真不怎么样，是不是。我现在都回来做各种跑腿工了”"}
{"time": 1758721235, "type": "recv", "message_id": "1893763168", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "努力去回忆这个人是谁“..町田..君？”试探性的询问"}
{"time": 1758721257, "type": "recv", "message_id": "385557647", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“跑啥腿”"}
{"time": 1758721272, "type": "recv", "message_id": "89438543", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“掏过鸟蛋？………”疑惑"}
{"time": 1758721288, "type": "recv", "message_id": "1633683086", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "回想一下是谁"}
{"time": 1758721302, "type": "recv", "message_id": "610485908", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“送外卖啦，或者给人做零时工，唉，最麻烦的是，经常还没活做。”"}
{"time": 1758721345, "type": "recv", "message_id": "1145396787", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "町田是你们从小学时代就一直延续到中学的旧友，但是他搬去东京之后，你们之间的联系就逐渐变淡。"}
{"time": 1758721381, "type": "recv", "message_id": "895145479", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“都好久以前了，我已经不是很记得了”有些尴尬"}
{"time": 1758721419, "type": "recv", "message_id": "1804805031", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“这次还真是来对了啊，能遇到你们，好开心...”"}
{"time": 1758721453, "type": "recv", "message_id": "1293312265", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "*观察一下lpy外貌app"}
{"time": 1758721478, "type": "recv", "message_id": "1530709048", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "[CQ:image,file={367DB54F-2379-BBF7-BCB5-ACCED8F2EE7C}.jpg,sub_type=0,url=https://gchat.qpic.cn/gchatpic_new/0/0-0-367DB54F2379BBF7BCB5ACCED8F2EE7C/0,file_size=51080]"}
