{"time": 1758721510, "type": "recv", "message_id": "65518537", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2388921818"}, "sender": {"id": "2388921818", "name": "我叫五个五"}, "message": "（还真是lpy）"}
{"time": 1758721515, "type": "recv", "message_id": "1100764618", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“可不是，我也没想到还能再见到你们，唉。”"}
{"time": 1758721528, "type": "recv", "message_id": "226486847", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "他叹口气，“不知道几位都在做什么？肯定比我有前途吧？”"}
{"time": 1758721555, "type": "recv", "message_id": "1836459795", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“我……我在便利店当服务生”"}
{"time": 1758721562, "type": "recv", "message_id": "779912816", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“还在上学呢，宝子，哪像你赚大钱”"}
{"time": 1758721565, "type": "recv", "message_id": "742578658", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "[CQ:image,summary=&#91;动画表情&#93;,file=063F166285F5EAD571A4DE8B7470FD2C.jpg,sub_type=1,url=https://multimedia.nt.qq.com.cn/download?appid=1407&amp;fileid=EhTG1mneol9KZXZF2Rnp9Md-Jxi64Rii1gQg_wootbP0sMTxjwMyBHByb2RQgL2jAVoQ_of1E3woH1dsnVt4GKMerXoCB92CAQJneg&amp;rkey=CAESMNwtalp-UQi87eZ76JFhsl4WZ2GzgCmMNi6MgnUcAt25hP4zsY4x7Vl3y_FxhfwYuQ,file_size=76578]"}
{"time": 1758721601, "type": "recv", "message_id": "74695364", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“秘密哦秘密，美少女的事情就不要多问了”"}
{"time": 1758721605, "type": "recv", "message_id": "194277515", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": ".st app"}
