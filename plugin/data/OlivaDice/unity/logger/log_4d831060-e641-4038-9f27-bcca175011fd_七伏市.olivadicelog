{"time": 1758725307, "type": "recv", "message_id": "134313203", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "果然，町田正等在这里。"}
{"time": 1758725372, "type": "recv", "message_id": "2053295414", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "朝他挥挥手“我们来了，町田君”看眼时间"}
{"time": 1758725375, "type": "recv", "message_id": "1076807821", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "看见你们来，他松了口气，“这边这边。”"}
{"time": 1758725379, "type": "recv", "message_id": "35784294", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "现在是晚上九点"}
{"time": 1758725406, "type": "recv", "message_id": "320098027", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不会要现在直接过去吧....”"}
{"time": 1758725441, "type": "recv", "message_id": "139852791", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“现在不会关门了吗？”"}
{"time": 1758725453, "type": "recv", "message_id": "422964469", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“夜袭？”"}
{"time": 1758725461, "type": "recv", "message_id": "1962208099", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“Nightraid”"}
{"time": 1758725463, "type": "recv", "message_id": "1400717768", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“就算没有关门我也不会去的...”"}
{"time": 1758725476, "type": "recv", "message_id": "300826964", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“晚上加人偶，太恐怖片标配了吧”"}
{"time": 1758725477, "type": "recv", "message_id": "1415637470", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“总不能那个传言是真的吧……”一阵哆嗦"}
{"time": 1758725507, "type": "recv", "message_id": "846746148", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“现在过去吧？”他拿出手机，“我来打车。”"}
{"time": 1758725538, "type": "recv", "message_id": "1549454531", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不行...明天白天去好不好”"}
{"time": 1758725583, "type": "recv", "message_id": "951481169", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“所以为什么要晚上去”"}
{"time": 1758725660, "type": "recv", "message_id": "1967238664", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“嗯..明天也可以啦，那我们在哪里集合？”"}
{"time": 1758725687, "type": "recv", "message_id": "1564924739", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“明天中午，人偶馆旁边？”"}
{"time": 1758725698, "type": "recv", "message_id": "848148578", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "“不过要早一点，明天下午就准备求婚了...”他递给你们一人一封烫漆的红色请柬"}
