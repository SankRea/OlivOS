{"time": 1758725307, "type": "recv", "message_id": "134313203", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "果然，町田正等在这里。"}
{"time": 1758725372, "type": "recv", "message_id": "2053295414", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "朝他挥挥手“我们来了，町田君”看眼时间"}
{"time": 1758725375, "type": "recv", "message_id": "1076807821", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "看见你们来，他松了口气，“这边这边。”"}
{"time": 1758725379, "type": "recv", "message_id": "35784294", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "现在是晚上九点"}
{"time": 1758725406, "type": "recv", "message_id": "320098027", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "“不会要现在直接过去吧....”"}
{"time": 1758725441, "type": "recv", "message_id": "139852791", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "“现在不会关门了吗？”"}
{"time": 1758725453, "type": "recv", "message_id": "422964469", "deleted": false, "dect": {"host_id": null, "group_id": "921676951", "user_id": "786921597"}, "sender": {"id": "786921597", "name": "sio2"}, "message": "“夜袭？”"}
