{"time": 1772634688, "type": "recv", "message_id": "2115779698", "deleted": false, "dect": {"host_id": null, "group_id": "588162808", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"还是别说给我听。\"皱眉，\"我只想当个普通人。\""}
