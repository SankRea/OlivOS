{"time": 1772634112, "type": "recv", "message_id": "1351668278", "deleted": false, "dect": {"host_id": null, "group_id": "588162808", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（但是䌷不像个男人名字）"}
{"time": 1772634172, "type": "recv", "message_id": "1212914356", "deleted": false, "dect": {"host_id": null, "group_id": "588162808", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"就是这样，只是普通人。不是普通人的话，一般不是我经手。\"趴在桌子上，没什么力气的样子。"}
{"time": 1772634173, "type": "recv", "message_id": "263569802", "deleted": false, "dect": {"host_id": null, "group_id": "588162808", "user_id": "1040972910"}, "sender": {"id": "1040972910", "name": "划船不靠桨の233"}, "message": "[CQ:reply,id=1351668278]（是男的[CQ:at,qq=2468514664]"}
