{"time": 1772634963, "type": "recv", "message_id": "333776154", "deleted": false, "dect": {"host_id": null, "group_id": "588162808", "user_id": "2468514664"}, "sender": {"id": "2468514664", "name": "夜鹿夜游真夜中"}, "message": "（我也想知道）"}
