{"time": 1772634397, "type": "recv", "message_id": "1059625942", "deleted": false, "dect": {"host_id": null, "group_id": "588162808", "user_id": "1252219916"}, "sender": {"id": "1252219916", "name": "千成之愿"}, "message": "\"不过呢。\"耸耸肩，\"反正过段时间会平息的吧。\""}
